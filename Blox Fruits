local function equipHaki(item)
	runAction(function()
		modificationRemote:InvokeServer({ Type = "SetEquip", ItemId = item.id, IsEquipped = true })
		settings.lastHaki = item.id
		saveSettings()
		setStatus("Haki set to " .. item.name .. ".", THEME.good)
	end)
