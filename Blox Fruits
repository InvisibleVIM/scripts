	settings.expanded[self.name] = state or nil

	local index = table.find(settings.openOrder, self.name)
	if index then
		table.remove(settings.openOrder, index)
	end

	if state then
		table.insert(settings.openOrder, 1, self.name)
		contentList.CanvasPosition = Vector2.zero
	end

	applySectionOrder()
	saveSettings()
end

