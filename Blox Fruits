	end)

	-- FishingClient is a Script, so its controller is reached through the shared state.
	withGameIdentity(function()
		fishingComponents = require(replicatedStorage.FishReplicated.FishingClient.Components)
	end)

	withGameIdentity(function()
		dialogueController = require(replicatedStorage.DialogueController)
		jobsReplicated = require(replicatedStorage.JobsReplicated)
		craftRemote = require(replicatedStorage.Modules.Net):RemoteFunction("Craft")
	end)
end

---Resolve and cache item config data.
---@param itemId number
---@return table?
local function getItemData(itemId)
	if itemDataCache[itemId] ~= nil then
		return itemDataCache[itemId] or nil
	end

	local ok, result = pcall(itemConfig.tryGet, itemId)
	if ok and typeof(result) == "table" and result.unwrap then
		ok, result = pcall(result.unwrap, result)
	end

	local data = ok and typeof(result) == "table" and result.Index and result or false
	itemDataCache[itemId] = data
	return data or nil
end

---Fetch owned permanent fruits in shop order.
local function fetchOwnedFruits()
	local fruits = commF:InvokeServer("GetFruits", false)
	if typeof(fruits) ~= "table" then
		return
	end

	table.clear(ownedFruits)

	for shopIndex, fruit in ipairs(fruits) do
		if fruit.HasPermanent then
			table.insert(ownedFruits, { name = fruit.Name, rarity = fruit.Rarity, shopIndex = shopIndex })
		end
	end

	dragonType = commF:InvokeServer("DragonType")
end

---Sort items alphabetically by display name.
local function sortByName(list)
	table.sort(list, function(a, b)
		return a.name < b.name
	end)
end

---Read haki colors, mutations and game-favorited items from item replication.
local function fetchInventory()
	if not itemReplication then
		return
	end

	withGameIdentity(function()
		local entries = itemReplication:GetItems()
		if typeof(entries) ~= "table" then
			return
		end

		local favorited, equipped, preferred, owned, uids, seen = {}, {}, {}, {}, {}, {}
		local haki, swords, guns, wardrobe, mutations = {}, {}, {}, {}, {}

		for _, entry in pairs(entries) do
			if entry.NetworkedUID and not uids[entry.ItemId] then
				uids[entry.ItemId] = entry.NetworkedUID
			end

			if entry.Value == true then
				if entry.Key == "IsFavorited" then
					favorited[entry.ItemId] = true
				elseif entry.Key == "IsEquipped" then
					equipped[entry.ItemId] = true
				elseif entry.Key == "IsPreferred" then
					preferred[entry.ItemId] = true
				elseif entry.Key == "IsOwned" then
					owned[entry.ItemId] = true
				end
			end
		end

		for _, entry in pairs(entries) do
			local itemId = entry.ItemId
			if not itemId or seen[itemId] then
				continue
			end
			seen[itemId] = true

			local data = getItemData(itemId)
			if not data then
				continue
			end

			local index, inventoryData = data.Index, data.Inventory or {}
			local bracket = inventoryData.Brackets and inventoryData.Brackets[1]
			local groups = inventoryData.Groups or {}

			-- Owned fruit mutations, looked up by storage key.
			if index.IdType == "Mutation" then
				if owned[itemId] then
					mutations[index.StorageKey] = itemId
				end
				continue
			end

			-- Aura skins are the haki colors.
			if index.IdType == "Skin" and inventoryData.StackKey == "Aura" then
				local isDefault = index.StorageKey == DEFAULT_AURA_KEY
				table.insert(haki, {
					id = itemId,
					name = isDefault and "Default" or (data.Display and data.Display.Name) or index.StorageKey,
					isDefault = isDefault,
				})
				continue
			end

			if not favorited[itemId] then
				continue
			end

			local item = { id = itemId, uid = uids[itemId], name = index.StorageKey, bracket = bracket }

			if index.IdType == "Moveset" and bracket == "Swords" then
				table.insert(swords, item)
			elseif index.IdType == "Moveset" and bracket == "Guns" then
				table.insert(guns, item)
			elseif table.find(groups, "Wardrobe") then
				table.insert(wardrobe, item)
			end
		end

		sortByName(swords)
		sortByName(guns)
		sortByName(wardrobe)

		-- Default color first, the rest alphabetical.
		table.sort(haki, function(a, b)
			if a.isDefault ~= b.isDefault then
				return a.isDefault
			end
			return a.name < b.name
		end)

		inventory.haki = haki
		inventory.swords = swords
		inventory.guns = guns
		inventory.wardrobe = wardrobe
		inventory.equipped = equipped
		inventory.preferred = preferred
		inventory.mutations = mutations
	end)
end

---Current server time in whole seconds; the cooldown end comes from the server clock.
---@return number
local function serverNow()
	return math.floor(workspace:GetServerTimeNow())
end

---Poll the random fruit cooldown.
local function checkRollCooldown()
	local ok, result = pcall(gachaRemote.InvokeServer, gachaRemote, { Context = "Check", BoxName = GACHA.BOX })
	if not ok or typeof(result) ~= "table" or typeof(result.Cooldown) ~= "table" then
		return
	end

	local cooldown = result.Cooldown
	local timeEnds = tonumber(cooldown.TimeEnds) or 0

	-- The server can say "not yet" after the timestamp passes; show that instead of Ready.
	rollBlocked = cooldown.RequirementMet == false and timeEnds <= serverNow()
	rollReadyConfirmed = timeEnds <= serverNow() and not rollBlocked
	rollCooldownEnds = timeEnds
	rollCooldownKnown = true
end

---Get the currently equipped fruit.
---@return string?
local function getCurrentFruit()
	local data = localPlayer:FindFirstChild("Data")
	local devilFruit = data and data:FindFirstChild("DevilFruit")
	return devilFruit and devilFruit.Value
end

---Return a readable fruit name ("T-Rex-T-Rex" -> "T-Rex").
---@param name string
---@return string
local function prettyName(name)
	local half = (#name - 1) / 2
	if half % 1 == 0 and name:sub(1, half) == name:sub(half + 2) then
		return name:sub(1, half)
	end
	return name
end

---Expand a fruit into its selectable entries (variants for Dragon / Kitsune).
---@param fruit table
---@return table
local function expandFruit(fruit)
	local variants = FRUIT_VARIANTS[fruit.name]
	if not variants then
		return { { key = fruit.name, name = fruit.name, label = prettyName(fruit.name), rarity = fruit.rarity } }
	end

	local entries = {}
	for _, variant in ipairs(variants) do
		-- Hide a mutation variant the player doesn't own.
		if variant.mutationEquipped and not inventory.mutations[variant.mutationKey] then
			continue
		end

		table.insert(entries, {
			key = fruit.name .. "|" .. variant.key,
			name = fruit.name,
			label = variant.label,
			rarity = fruit.rarity,
			dragonType = variant.dragonType,
			mutationKey = variant.mutationKey,
			mutationEquipped = variant.mutationEquipped,
		})
	end

	return entries
end

---Check whether a fruit entry matches what's equipped right now.
---@param entry table
---@return boolean
local function isCurrentEntry(entry)
	if getCurrentFruit() ~= entry.name then
		return false
	end

	if entry.dragonType then
		return dragonType == entry.dragonType
	end

	if entry.mutationKey then
		local mutationId = inventory.mutations[entry.mutationKey]
		local isEquipped = mutationId ~= nil and inventory.preferred[mutationId] == true
		return isEquipped == entry.mutationEquipped
	end

	return true
end

---Return the label for the equipped fruit, including its variant.
---@return string
local function getCurrentFruitLabel()
	local current = getCurrentFruit()
	if not current or current == "" then
		return "None"
	end

	for _, fruit in ipairs(ownedFruits) do
		if fruit.name == current then
			for _, entry in ipairs(expandFruit(fruit)) do
				if isCurrentEntry(entry) then
					return entry.label
				end
			end
		end
	end

	return prettyName(current)
end

---Format seconds as m:ss or h:mm:ss.
---@param seconds number
---@return string
local function formatTime(seconds)
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor(seconds % 3600 / 60)
	local secs = seconds % 60

	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end

	return string.format("%d:%02d", minutes, secs)
end

---Create an instance with properties.
---@param className string
---@param properties table
---@return Instance
local function create(className, properties)
	local instance = Instance.new(className)
	for key, value in pairs(properties) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	instance.Parent = properties.Parent
	return instance
end

