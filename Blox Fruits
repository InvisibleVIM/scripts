---Run a server action without overlapping others.
---@param callback function
---@param refetch function?
local function runAction(callback, refetch)
	if busy then
		return setStatus("Busy, wait a moment…", THEME.subText)
	end

	busy = true
	task.spawn(function()
		local ok, err = pcall(callback)
		if not ok then
			setStatus("Error: " .. tostring(err), THEME.bad)
		end

		if refetch then
			task.wait(0.3)
			pcall(refetch)
		end

		busy = false
		renderAll()
	end)
end

---Re-read dragon type and mutation state after a fruit switch.
local function refetchFruitState()
	dragonType = commF:InvokeServer("DragonType")
	fetchInventory()
end

---Switch to a permanent fruit entry, applying its dragon form or mutation.
---@param entry table
local function switchFruit(entry)
	if isCurrentEntry(entry) then
		return
	end

	local character = localPlayer.Character
	if character and character:GetAttribute("TransparencyMode") ~= nil then
		return setStatus("Can't switch fruits while transformed.", THEME.bad)
	end

	runAction(function()
		-- Dragon re-switches even when equipped, since the form is part of the switch.
		if getCurrentFruit() ~= entry.name or entry.dragonType then
			local success, err = commF:InvokeServer("SwitchFruit", entry.name, entry.dragonType or dragonType)
			if success == false then
				return setStatus(err or "Switch failed.", THEME.bad)
			end
		end

		-- Mutations can only change while the fruit is equipped, so apply after switching.
		if entry.mutationKey then
			local mutationId = inventory.mutations[entry.mutationKey]
			if mutationId then
				local result = modificationRemote:InvokeServer({
					Type = "SetEquip",
					ItemId = mutationId,
					IsEquipped = entry.mutationEquipped,
				})

				if typeof(result) == "table" and result.Success == false then
					return setStatus("Couldn't change mutation for " .. entry.label .. ".", THEME.bad)
				end
			end
		end

		setStatus("Switched to " .. entry.label .. ".", THEME.good)
	end, refetchFruitState)
end

---Equip a stored sword, gun, or wardrobe item through the game's inventory action.
---@param item table
local function equipItem(item)
	if not inventoryRemoteUtil then
		return setStatus("Inventory module not loaded.", THEME.bad)
	end

	runAction(function()
		local result = withGameIdentity(function()
			local response = inventoryRemoteUtil.invokeAction("EquipItem", item.id, item.uid, inventory.equipped[item.id] == true)
			if typeof(response) == "table" and response.await then
				response = response:await()
			end
			return response
		end)

		if result == nil or tostring(result):find("^Err") then
			setStatus("Couldn't equip " .. item.name .. ".", THEME.bad)
		else
			setStatus("Equipped " .. item.name .. ".", THEME.good)
		end
	end, fetchInventory)
end

---Equip a haki color.
