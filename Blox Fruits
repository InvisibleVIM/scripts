---Handle keybinds, including capturing a new key from the Settings tab.
---@param input InputObject
---@param gameProcessed boolean
local function onInputBegan(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	if rebindTarget then
		-- Typing in chat or a text box shouldn't become the new key.
		if gameProcessed and input.KeyCode ~= Enum.KeyCode.Escape then
			return
		end

		if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
			settings.keybinds[rebindTarget] = input.KeyCode.Name
			saveSettings()
			setStatus("Keybind set to " .. input.KeyCode.Name .. ".", THEME.good)
		end

		rebindTarget = nil
		renderHub()
		return
	end

	-- Ignore keys typed into chat or text boxes.
	if gameProcessed then
		return
	end

	if input.KeyCode == getKeybind("quick") then
		setHidden(not settings.hidden)
	end
end

---Remove the UI and stop loops.
function Potent.detach()
	alive = false
	pcall(Repair.stopAutoRepair)
	pcall(Boat.restoreBoatSpeeds)
	pcall(Weather.restoreWeather)
	pcall(Fishing.uninstallFishingHooks)
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	screenGui:Destroy()
end

---Main entry point.
local function initializeScript()
	loadSettings()
	loadGameModules()

	mainFrame.Position = toUDim2(settings.position)
	hub.frame.Position = toUDim2(settings.hubPosition)
	toggleButton.Position = toUDim2(settings.togglePosition)
	screenGui.Parent = gethui()

	clampToScreen(toggleButton, Vector2.new(TOGGLE.SIZE, TOGGLE.SIZE))
	setHidden(settings.hidden)
	updateToggleButton()
	rebuildQuickSections()

	refreshButton.MouseButton1Click:Connect(refreshAll)
	hub.refreshButton.MouseButton1Click:Connect(refreshAll)
	rollButton.MouseButton1Click:Connect(rollFruit)

	bindConfirm(refundButton, function()
		blackbeardTrade("Refund", "Stat refund")
	end)

	bindConfirm(rerollButton, function()
		blackbeardTrade("Reroll", "Race reroll")
	end)

	table.insert(connections, userInputService.InputBegan:Connect(onInputBegan))

	-- Keep the equipped fruit in sync when it changes elsewhere.
	local devilFruit = localPlayer:WaitForChild("Data"):WaitForChild("DevilFruit")
	table.insert(connections, devilFruit.Changed:Connect(renderAll))

	-- Check the repair bar every frame so the release lands inside the goal.
	table.insert(connections, runService.RenderStepped:Connect(function()
		local ok, err = pcall(Repair.updateAutoRepair)
		if not ok then
			warn("Auto repair error: " .. tostring(err))
		end
	end))

	-- Re-apply boat speed every physics step in case the game resets it.
	table.insert(connections, runService.Heartbeat:Connect(function()
		local ok, err = pcall(Boat.updateBoatSpeed)
		if not ok then
			warn("Boat speed error: " .. tostring(err))
		end

		local weatherOk, weatherErr = pcall(Weather.updateWeather)
		if not weatherOk then
			warn("Weather error: " .. tostring(weatherErr))
		end

		local fishOk, fishErr = pcall(Fishing.updateAutoFish)
		if not fishOk then
			warn("Fishing error: " .. tostring(fishErr))
		end
	end))

	Fishing.installFishingHooks()

	-- Keep the hub and P button on screen if the Roblox window is resized.
	table.insert(connections, screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if hub.frame.Visible then
			clampToScreen(hub.frame, Vector2.new(HUB_LAYOUT.WIDTH, HUB_LAYOUT.HEIGHT))
		end
		clampToScreen(toggleButton, Vector2.new(TOGGLE.SIZE, TOGGLE.SIZE))
	end))

	-- Tick the roll countdown and re-sync it with the server periodically.
	task.spawn(function()
		local lastPoll = -math.huge
		while alive do
			-- Poll on the interval, and again right when the countdown hits zero
			-- (or every few seconds while the server still says "not yet").
			local dueAtZero = rollCooldownKnown and not rollReadyConfirmed and rollCooldownEnds <= serverNow()
			if os.clock() - lastPoll >= GACHA.POLL_INTERVAL or (dueAtZero and os.clock() - lastPoll >= 5) then
				lastPoll = os.clock()
				task.spawn(checkRollCooldown)
			end

			updateRollTimer()
			task.wait(1)
		end
	end)

	refreshAll()
	updateWindowSize(false)
end

---This is called when initialization errors.
