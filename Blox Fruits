---Convert a set into a list for saving.
---@param set table
---@return table
local function setToList(set)
	local list = {}
	for key in pairs(set) do
		table.insert(list, key)
	end
	return list
end

---Check that a saved value is a list of strings.
---@param value any
---@return boolean
local function isStringList(value)
	if typeof(value) ~= "table" then
		return false
	end

	for _, entry in ipairs(value) do
		if typeof(entry) ~= "string" then
			return false
		end
	end

	return true
end

---Load settings from disk.
local function loadSettings()
	if not isfolder(SETTINGS_FOLDER) then
		makefolder(SETTINGS_FOLDER)
	end

	if not isfile(SETTINGS_PATH) then
		return
	end

	local ok, decoded = pcall(httpService.JSONDecode, httpService, readfile(SETTINGS_PATH))
	if not ok or typeof(decoded) ~= "table" then
		return
	end

	if typeof(decoded.position) == "table" and #decoded.position == 4 then
		settings.position = decoded.position
	end

	if typeof(decoded.expanded) == "table" then
		settings.expanded = decoded.expanded
	end

	-- Keep open order consistent with what's actually expanded.
	local openOrder = {}
	for _, name in ipairs(typeof(decoded.openOrder) == "table" and decoded.openOrder or {}) do
		if settings.expanded[name] and not table.find(openOrder, name) then
			table.insert(openOrder, name)
		end
	end
	for name, isOpen in pairs(settings.expanded) do
		if isOpen and not table.find(openOrder, name) then
			table.insert(openOrder, name)
		end
	end
	settings.openOrder = openOrder

	settings.lastHaki = decoded.lastHaki
	settings.autoRepair = decoded.autoRepair == true
	settings.hidden = decoded.hidden == true
	settings.boatSpeedEnabled = decoded.boatSpeedEnabled == true
	settings.disableWeather = decoded.disableWeather == true
	settings.autoBuyBait = decoded.autoBuyBait == true
	settings.instantCatch = decoded.instantCatch == true

	-- Fishing mode: Off, Assist (you cast) or Auto (fully hands-free).
	if decoded.fishMode == "Assist" or decoded.fishMode == "Auto" then
		settings.fishMode = decoded.fishMode
	elseif decoded.autoFish == true then
		settings.fishMode = "Assist"
	end

	if typeof(decoded.togglePosition) == "table" and #decoded.togglePosition == 4 then
		settings.togglePosition = decoded.togglePosition
	end

	if typeof(decoded.hubPosition) == "table" and #decoded.hubPosition == 4 then
		settings.hubPosition = decoded.hubPosition
	end

	if typeof(decoded.hubTab) == "string" then
		settings.hubTab = decoded.hubTab
	end

	if isStringList(decoded.quickSections) then
		settings.quickSections = decoded.quickSections
	end

	if typeof(decoded.keybinds) == "table" then
		for action in pairs(DEFAULT_KEYBINDS) do
			if typeof(decoded.keybinds[action]) == "string" then
				settings.keybinds[action] = decoded.keybinds[action]
			end
		end
	end

	if typeof(decoded.boatSpeed) == "number" then
		settings.boatSpeed = math.clamp(math.floor(decoded.boatSpeed + 0.5), BOAT.SPEED_MIN, BOAT.SPEED_MAX)
	end

	for _, name in ipairs(decoded.favorites or {}) do
		fruitFavorites[name] = true
	end

	-- Carry an old whole-fruit favorite over to each of its variants.
	for fruitName, variants in pairs(FRUIT_VARIANTS) do
		if fruitFavorites[fruitName] then
			fruitFavorites[fruitName] = nil
			for _, variant in ipairs(variants) do
				fruitFavorites[fruitName .. "|" .. variant.key] = true
			end
		end
	end

	for _, id in ipairs(decoded.hakiFavorites or {}) do
		hakiFavorites[id] = true
	end
end

---Persist settings to disk. An unloaded instance must never overwrite a newer one.
local function saveSettings()
	if not alive then
		return
	end

	settings.favorites = setToList(fruitFavorites)
	settings.hakiFavorites = setToList(hakiFavorites)
	writefile(SETTINGS_PATH, httpService:JSONEncode(settings))
end

---Resolve a keybind setting to a KeyCode, falling back to the default.
---@param action string
---@return EnumItem
local function getKeybind(action)
	local ok, keyCode = pcall(function()
		return Enum.KeyCode[settings.keybinds[action]]
	end)

	if ok and keyCode then
		return keyCode
	end

	return Enum.KeyCode[DEFAULT_KEYBINDS[action]]
end

---Run a function at game identity so required modules can't see our env.
---@return any
local function withGameIdentity(callback)
	setthreadidentity(2)
	local results = table.pack(pcall(callback))
	setthreadidentity(8)

	if not results[1] then
		warn("Game call failed: " .. tostring(results[2]))
		return nil
	end

	return table.unpack(results, 2, results.n)
end

---Load the game's modules once.
local function loadGameModules()
	withGameIdentity(function()
		itemReplication = require(replicatedStorage.ItemReplicationService)
		itemConfig = require(replicatedStorage.ItemConfig)
		inventoryRemoteUtil = require(replicatedStorage.Controllers.UI.Inventory.RemoteUtil)
		repairShip = require(replicatedStorage.Controllers.UI.RepairShip)
	end)

	-- Separate calls so a weather or fishing failure can't block the other modules.
	withGameIdentity(function()
