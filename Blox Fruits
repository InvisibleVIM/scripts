---Build the fruit rows: favorites on top, both groups in shop order.
---@param canvas table
local function populateFruits(canvas)
	local favorites, others = {}, {}
	local total = 0

	for _, fruit in ipairs(ownedFruits) do
		for _, entry in ipairs(expandFruit(fruit)) do
			total += 1
			table.insert(fruitFavorites[entry.key] and favorites or others, entry)
		end
	end

	if total == 0 then
		createEmpty(canvas.body, "No permanent fruits found yet. Press ↻ to refresh.", nextOrder(canvas))
		return 0
	end

	local function addRow(container, entry)
		createRow(container, nextOrder(canvas), {
			text = entry.label,
			dotColor = RARITY_COLORS[entry.rarity],
			highlighted = isCurrentEntry(entry),
			starred = fruitFavorites[entry.key] == true,
			onClick = function()
				switchFruit(entry)
			end,
			onStar = function()
				fruitFavorites[entry.key] = not fruitFavorites[entry.key] or nil
				saveSettings()
				renderAll()
			end,
		})
	end

	if #favorites > 0 then
		createDivider(canvas.body, "FAVORITES", nextOrder(canvas))
		local group = canvasGroup(canvas)
		for _, entry in ipairs(favorites) do
			addRow(group, entry)
		end
		createDivider(canvas.body, "ALL FRUITS", nextOrder(canvas))
	end

	local group = canvasGroup(canvas)
	for _, entry in ipairs(others) do
		addRow(group, entry)
	end

	return total
end

