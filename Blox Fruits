---Check whether a feature is pinned to the quick panel.
---@param id string
---@return boolean
local function isPinned(id)
	return table.find(settings.quickSections, id) ~= nil
end

---Pin or unpin a feature on the quick panel.
---@param id string
local function togglePin(id)
	local index = table.find(settings.quickSections, id)
	if index then
		table.remove(settings.quickSections, index)
	else
		table.insert(settings.quickSections, id)
	end

	saveSettings()
	rebuildQuickSections()
	renderAll()
end

---Move a pinned feature up or down in the quick panel.
---@param id string
---@param delta number
local function movePin(id, delta)
	local list = settings.quickSections
	local index = table.find(list, id)
	local target = index and index + delta
	if not target or target < 1 or target > #list then
		return
	end

	list[index], list[target] = list[target], list[index]
	saveSettings()
	rebuildQuickSections()
	renderAll()
end

