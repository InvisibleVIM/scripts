---Open or close the hub window.
---@param state boolean
function setHubOpen(state)
	hub.frame.Visible = state
	updateToggleButton()

	-- A pending rebind must not capture keys once the hub is gone.
	if not state then
		rebindTarget = nil
	end

	if state then
		clampToScreen(hub.frame, Vector2.new(HUB_LAYOUT.WIDTH, HUB_LAYOUT.HEIGHT))
		renderHub()
	end
end

do
	local pressStart, startPosition, dragged

	toggleButton.InputBegan:Connect(function(input)
		if not isPointerPress(input) then
			return
		end

		pressStart = input.Position
		startPosition = toggleButton.Position
		dragged = false

		input.Changed:Connect(function()
			if input.UserInputState ~= Enum.UserInputState.End or not pressStart then
				return
			end

			pressStart = nil

			if dragged then
				clampToScreen(toggleButton, Vector2.new(TOGGLE.SIZE, TOGGLE.SIZE))
				settings.togglePosition = fromUDim2(toggleButton.Position)
				saveSettings()
			else
				setHubOpen(not hub.frame.Visible)
			end
		end)
	end)

	table.insert(connections, userInputService.InputChanged:Connect(function(input)
		if not pressStart or not isPointerMove(input) then
			return
		end

		local delta = input.Position - pressStart
		if not dragged and delta.Magnitude < TOGGLE.DRAG_THRESHOLD then
			return
		end

		dragged = true
		toggleButton.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
	end))
end

-- Status messages fade back to empty.
local statusToken = 0

---Show a short status message in both windows.
---@param text string
---@param color Color3?
local function setStatus(text, color)
	statusToken += 1
	local token = statusToken

	for _, label in ipairs(statusLabels) do
		label.Text = text
		label.TextColor3 = color or THEME.subText
	end

	task.delay(4, function()
		if statusToken ~= token then
			return
		end

		for _, label in ipairs(statusLabels) do
			label.Text = ""
		end
	end)
end

---Require a second click within the confirm window.
---@param button TextButton
---@param action function
local function bindConfirm(button, action)
	local originalText = button.Text
	local armedAt = 0

	button.MouseButton1Click:Connect(function()
		if os.clock() - armedAt > UI.CONFIRM_WINDOW then
			armedAt = os.clock()
			button.Text = "Click to confirm"
			button.TextColor3 = THEME.star

			task.delay(UI.CONFIRM_WINDOW, function()
				if os.clock() - armedAt >= UI.CONFIRM_WINDOW then
					button.Text = originalText
					button.TextColor3 = THEME.text
				end
			end)
			return
		end

		armedAt = 0
		button.Text = originalText
		button.TextColor3 = THEME.text
		action()
	end)
end

---Start a render pass into a container; grid canvases lay rows out in columns.
---@param body Instance
---@param grid boolean
---@return table
local function newCanvas(body, grid)
	return { body = body, grid = grid == true, order = 0 }
end

---Next layout order within a canvas.
---@param canvas table
---@return number
local function nextOrder(canvas)
	canvas.order += 1
	return canvas.order
end

---Get a container for a run of rows: the body itself, or a grid block.
---@param canvas table
---@return Instance
local function canvasGroup(canvas)
	if not canvas.grid then
		return canvas.body
	end

	local group = create("Frame", {
		LayoutOrder = nextOrder(canvas),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = canvas.body,
	})
	create("UIGridLayout", {
		CellSize = UDim2.new(1 / HUB_LAYOUT.GRID_COLUMNS, -6, 0, UI.ROW_HEIGHT + 2),
		CellPadding = UDim2.fromOffset(8, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = group,
	})

	return group
end

