---Redraw the hub's sidebar state and active tab.
function renderHub()
	if not hub.frame.Visible then
		return
	end

	local tab = TAB_BY_ID[settings.hubTab]
	if not tab then
		settings.hubTab = "Home"
		tab = TAB_BY_ID.Home
	end

	for id, widgets in pairs(hub.tabButtons) do
		local active = id == tab.id
		widgets.button.BackgroundTransparency = active and 0 or 1
		widgets.indicator.Visible = active
		widgets.name.TextColor3 = active and THEME.text or THEME.subText
		widgets.name.Font = active and Enum.Font.GothamBold or Enum.Font.GothamMedium
		widgets.pinDot.Visible = isPinned(id)
	end

	hub.title.Text = tab.icon .. "  " .. tab.title
	hub.description.Text = tab.description or ""
	hub.keyHint.Text = ("%s  ·  Quick panel\nP button  ·  Hub"):format(settings.keybinds.quick)

	hub.pinButton.Visible = tab.pinnable == true
	if tab.pinnable then
		local pinned = isPinned(tab.id)
		hub.pinButton.Text = pinned and "📌  On quick panel" or "＋  Add to quick panel"
		hub.pinButton.BackgroundColor3 = pinned and THEME.rowEquipped or THEME.row
		hub.pinStroke.Transparency = pinned and 0.1 or 0.5
	end

	for _, child in ipairs(hub.content:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	tab.populate(newCanvas(hub.content, tab.grid))
end

---Recreate the quick panel sections from the pinned list.
function rebuildQuickSections()
	-- Drop unknown or repeated ids so indexes match what's actually shown.
	local cleaned, seen = {}, {}
	for _, id in ipairs(settings.quickSections) do
		if FEATURE_BY_ID[id] and not seen[id] then
			seen[id] = true
			table.insert(cleaned, id)
		end
	end
	settings.quickSections = cleaned

	for _, section in ipairs(sections) do
		section:destroy()
	end
	table.clear(sections)

	for index, id in ipairs(settings.quickSections) do
		local feature = FEATURE_BY_ID[id]
		if feature then
			table.insert(sections, Section.new(feature, index))
		end
	end

	quickEmptyLabel.Visible = #sections == 0
	applySectionOrder()
end

---Re-render every quick section and the hub.
function renderAll()
	-- Late server replies can land after Unload or a re-run.
	if not alive then
		return
	end

	local fruitLabel = getCurrentFruitLabel()
	currentLabel.Text = "Fruit: " .. fruitLabel
	hub.fruitLabel.Text = "Equipped  ·  " .. fruitLabel

	for _, section in ipairs(sections) do
		section:render()
	end

	renderHub()
end

