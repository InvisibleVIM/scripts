---Build the Quick Panel tab: choose sections and their order.
---@param canvas table
local function populateQuickPanel(canvas)
	createDivider(canvas.body, "PINNED  (TOP TO BOTTOM)", nextOrder(canvas))

	if #settings.quickSections == 0 then
		createEmpty(canvas.body, "Nothing pinned yet. Switch a section on below.", nextOrder(canvas))
	end

	for index, id in ipairs(settings.quickSections) do
		local feature = FEATURE_BY_ID[id]
		if not feature then
			continue
		end

		local row = createSwitchRow(canvas.body, nextOrder(canvas), {
			text = feature.icon .. "  " .. feature.title,
			enabled = true,
			rightInset = 60,
			onToggle = function()
				togglePin(id)
			end,
		})

		-- Up / down arrows reorder the quick panel.
		for slot, arrow in ipairs({ { "▲", -1 }, { "▼", 1 } }) do
			local canMove = (arrow[2] < 0 and index > 1) or (arrow[2] > 0 and index < #settings.quickSections)
			local arrowButton = create("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -60 - (2 - slot) * 28, 0.5, 0),
				Size = UDim2.fromOffset(24, 22),
				BackgroundColor3 = THEME.section,
				AutoButtonColor = canMove,
				Font = Enum.Font.GothamBold,
				Text = arrow[1],
				TextColor3 = canMove and THEME.text or THEME.stroke,
				TextSize = 11,
				Parent = row,
			})
			corner(arrowButton, 5)

			if canMove then
				arrowButton.MouseButton1Click:Connect(function()
					movePin(id, arrow[2])
				end)
			end
		end
	end

	createDivider(canvas.body, "AVAILABLE", nextOrder(canvas))

	local available = 0
	for _, feature in ipairs(FEATURES) do
		if isPinned(feature.id) then
			continue
		end

		available += 1
		createSwitchRow(canvas.body, nextOrder(canvas), {
			text = feature.icon .. "  " .. feature.title,
			subtitle = feature.description,
			enabled = false,
			onToggle = function()
				togglePin(feature.id)
			end,
		})
	end

	if available == 0 then
		createEmpty(canvas.body, "Everything is already pinned.", nextOrder(canvas))
	end

	local reset = actionButton(canvas.body, "Reset quick panel to default", UDim2.new(), UDim2.new(1, 0, 0, 32), THEME.stroke)
	reset.LayoutOrder = nextOrder(canvas)
	reset.MouseButton1Click:Connect(function()
		settings.quickSections = table.clone(DEFAULT_QUICK_SECTIONS)
		saveSettings()
		rebuildQuickSections()
		renderAll()
	end)

	return nil
end

