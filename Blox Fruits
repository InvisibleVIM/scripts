---Create a styled action button.
---@param parent Instance
---@param text string
---@param position UDim2
---@param size UDim2
---@param accentColor Color3
---@return TextButton
local function actionButton(parent, text, position, size, accentColor)
	local button = create("TextButton", {
		Position = position,
		Size = size,
		BackgroundColor3 = THEME.row,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = text,
		TextColor3 = THEME.text,
		TextSize = 12,
		Parent = parent,
	})
	corner(button, 8)
	local stroke = create("UIStroke", {
		Color = accentColor,
		Transparency = 0.55,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = button,
	})

	button.MouseEnter:Connect(function()
		tween(button, { BackgroundColor3 = THEME.rowHover })
		tween(stroke, { Transparency = 0.1 })
	end)
	button.MouseLeave:Connect(function()
		tween(button, { BackgroundColor3 = THEME.row })
		tween(stroke, { Transparency = 0.55 })
	end)

	return button
end

