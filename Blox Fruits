---Pull a GUI object back on screen if it hangs past an edge.
---@param object GuiObject
---@param size Vector2
local function clampToScreen(object, size)
	local screenSize = object.Parent and object.Parent.AbsoluteSize
	if not screenSize or screenSize.X <= 0 or screenSize.Y <= 0 then
		return
	end

	local position = object.Position
	local anchor = object.AnchorPoint
	local anchorX = position.X.Scale * screenSize.X + position.X.Offset
	local anchorY = position.Y.Scale * screenSize.Y + position.Y.Offset

	-- Keep the whole box inside the screen given where it's anchored.
	local minX, maxX = size.X * anchor.X, screenSize.X - size.X * (1 - anchor.X)
	local minY, maxY = size.Y * anchor.Y, screenSize.Y - size.Y * (1 - anchor.Y)
	local clampedX = math.clamp(anchorX, minX, math.max(minX, maxX))
	local clampedY = math.clamp(anchorY, minY, math.max(minY, maxY))

	if clampedX == anchorX and clampedY == anchorY then
		return
	end

	object.Position = UDim2.new(
		position.X.Scale,
		position.X.Offset + (clampedX - anchorX),
		position.Y.Scale,
		position.Y.Offset + (clampedY - anchorY)
	)
end

---Convert a saved {xs, xo, ys, yo} table into a UDim2.
---@param values table
---@return UDim2
local function toUDim2(values)
	return UDim2.new(values[1], values[2], values[3], values[4])
end

---Convert a UDim2 into a saveable table.
---@param value UDim2
---@return table
local function fromUDim2(value)
	return { value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset }
end

---Make a frame draggable by a handle, saving its position on release.
---@param handle GuiObject
---@param object GuiObject
---@param onReleased function
---@param onMoved function?
local function makeDraggable(handle, object, onReleased, onMoved)
	local dragging, dragStart, startPosition

	handle.InputBegan:Connect(function(input)
		if not isPointerPress(input) then
			return
		end

		dragging = true
		dragStart = input.Position
		startPosition = object.Position

		input.Changed:Connect(function()
			if input.UserInputState ~= Enum.UserInputState.End or not dragging then
				return
			end

			dragging = false
			onReleased()
		end)
	end)

	table.insert(connections, userInputService.InputChanged:Connect(function(input)
		if not dragging or not isPointerMove(input) then
			return
		end

		local delta = input.Position - dragStart
		object.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)

		if onMoved then
			onMoved()
		end
	end))
end

