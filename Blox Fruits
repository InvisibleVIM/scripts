---@module Repair
local Repair = {}

---Find the live RepairHammer component for our equipped hammer.
---@return table?
function Repair.findRepairHammer()
	local character = localPlayer.Character
	local hammerInstance = character and character:FindFirstChild(REPAIR.HAMMER_NAME)

	if not hammerInstance then
		repairState.hammer = nil
		repairState.searchedInstance = nil
		return nil
	end

	local cached = repairState.hammer
	if cached and cached.Instance == hammerInstance and not cached.destroyed then
		return cached
	end

	-- Don't walk the GC every frame if the component isn't constructed yet.
	if repairState.searchedInstance == hammerInstance and os.clock() - repairState.lastSearch < REPAIR.SEARCH_INTERVAL then
		return nil
	end

	repairState.searchedInstance = hammerInstance
	repairState.lastSearch = os.clock()
	repairState.hammer = nil

	for _, value in ipairs(getgc(true)) do
		if typeof(value) == "table" and rawget(value, "Instance") == hammerInstance and rawget(value, "markerInVoid") ~= nil then
			repairState.hammer = value
			break
		end
	end

	return repairState.hammer
end

---Begin a swing the same way the hammer's InputBegan handler does.
---@param hammer table
function Repair.startRepairSwing(hammer)
	repairState.swinging = true
	repairState.ownsSwing = true

	task.spawn(function()
		hammer.holding = true

		local elapsed = 0
		local minSwingTime = hammer.data and hammer.data.MinSwingTime or 0
		while elapsed < minSwingTime and hammer.holding do
			elapsed += task.wait()
		end

		if hammer.holding and not hammer.destroyed and hammer.mode == "Minigame" then
			hammer.down = true
			hammer.Instance.M1Down:FireServer(hammer.mode)
		else
			hammer.holding = false
		end

		repairState.swinging = false
	end)
end

---Release a swing the same way the hammer's InputEnded handler does.
---@param hammer table
function Repair.releaseRepairSwing(hammer)
	repairState.ownsSwing = false

	withGameIdentity(function()
		hammer.holding = false
		hammer:Freeze(false)

		if not hammer.down then
			return
		end

		hammer.down = false
		repairShip:M1Up()
	end)
end

---Check whether the fill bar sits inside the goal zone right now.
---@return boolean
function Repair.isFillInGoal()
	local bar = repairShip.bar
	if not bar or not bar:FindFirstChild("Goal") or not bar:FindFirstChild("Fill") then
		return false
	end

	local goalCenter = bar.Goal.Position.X.Scale
	local halfWidth = (bar.Goal.Size.X.Scale + REPAIR.GOAL_PADDING) * 0.5
	local fill = bar.Fill.Size.X.Scale

	return math.abs(fill - goalCenter) <= halfWidth * REPAIR.GOAL_TOLERANCE
end

---Drive the repair minigame: swing, then release dead-center in the goal.
function Repair.updateAutoRepair()
	if not settings.autoRepair or not repairShip then
		return
	end

	local hammer = Repair.findRepairHammer()
	if not hammer or hammer.destroyed then
		return
	end

	-- Left the repair spot mid-swing: let go so the hammer isn't stuck down.
	if hammer.mode ~= "Minigame" then
		if repairState.ownsSwing and not repairState.swinging then
			Repair.releaseRepairSwing(hammer)
		end
		return
	end

	if os.clock() < repairState.nextActionAt then
		return
	end

	if not hammer.down then
		if not repairState.swinging and not hammer.holding then
			Repair.startRepairSwing(hammer)
		end
		return
	end

	-- Only judge the bar once the fill is running and the goal has settled.
	if repairShip.mode ~= "Minigame" or not repairShip.fillTween or repairShip.goalTween then
		return
	end

	if Repair.isFillInGoal() then
		Repair.releaseRepairSwing(hammer)
		repairState.nextActionAt = os.clock() + REPAIR.RESWING_DELAY
		repairState.perfectCount += 1
		setStatus(("Perfect repair x%d"):format(repairState.perfectCount), THEME.good)
	end
end

---Stop auto repair and release any swing we started.
function Repair.stopAutoRepair()
	local hammer = repairState.hammer
	if hammer and repairState.ownsSwing and not hammer.destroyed then
		Repair.releaseRepairSwing(hammer)
	end

	repairState.ownsSwing = false
	repairState.swinging = false
end

---@module Boat
local Boat = {}

---Get the VehicleSeat we're currently driving.
---@return VehicleSeat?
function Boat.getDrivenSeat()
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart

	if seat and seat:IsA("VehicleSeat") then
		return seat
	end

	return nil
end

---Put every boat we touched back to its original speed.
function Boat.restoreBoatSpeeds()
	for seat, original in pairs(boatState.originals) do
		if seat.Parent then
			seat.MaxSpeed = original
		end
	end

	table.clear(boatState.originals)
end

---Clamp and store a new boat speed.
---@param value number
function Boat.setBoatSpeed(value)
	settings.boatSpeed = math.clamp(math.floor(value + 0.5), BOAT.SPEED_MIN, BOAT.SPEED_MAX)
end

---Refresh the hint under each boat slider with the current boat's speeds.
function Boat.updateBoatHint()
	local seat = Boat.getDrivenSeat()
	local text = "Sit in your boat's driver seat to apply."

	if seat then
		local original = boatState.originals[seat] or seat.MaxSpeed
		text = ("Boat default: %d  •  Current: %d"):format(math.floor(original + 0.5), math.floor(seat.MaxSpeed + 0.5))
	end

	for label in pairs(boatState.hintLabels) do
		if not label.Parent then
			boatState.hintLabels[label] = nil
			continue
		end

		label.Text = text
	end
end

---Apply the custom speed to the seat we're driving.
function Boat.updateBoatSpeed()
	if os.clock() - boatState.lastHint >= BOAT.HINT_INTERVAL then
		boatState.lastHint = os.clock()
		Boat.updateBoatHint()
	end

	if not settings.boatSpeedEnabled then
		return
	end

	local seat = Boat.getDrivenSeat()
	if not seat then
		return
	end

	-- Forget boats that despawned so the table can't grow forever.
	for knownSeat in pairs(boatState.originals) do
		if not knownSeat.Parent then
			boatState.originals[knownSeat] = nil
		end
	end

	-- Remember the boat's own speed the first time we drive it.
	if boatState.originals[seat] == nil then
		boatState.originals[seat] = seat.MaxSpeed
	end

	if seat.MaxSpeed ~= settings.boatSpeed then
		seat.MaxSpeed = settings.boatSpeed
	end
end

---@module Weather
local Weather = {}

---Lock or unlock every weather type through the game's own weather locks.
---@param state boolean
function Weather.setWeatherLocks(state)
	if not weatherUtil or weatherState.locked == state then
		return
	end

	-- Lock callbacks run the game's enable/disable code, so keep game identity.
	withGameIdentity(function()
		for name, lock in pairs(weatherUtil.locks) do
			if name ~= "Global" then
				if state then
					lock:Lock(WEATHER.LOCK_KEY)
				else
					lock:Unlock(WEATHER.LOCK_KEY)
				end
			end
		end
	end)

	weatherState.locked = state
end

---Hide the dark-sea fog, theme and camera sway while suppression is on.
function Weather.applyWeatherSuppression()
	Weather.setWeatherLocks(true)

	local layers = game:GetService("Lighting"):FindFirstChild("LightingLayers")
	if layers then
		for _, layer in ipairs(layers:GetChildren()) do
			if WEATHER.FOG_LAYERS[layer.Name] and layer:GetAttribute("Enabled") ~= false then
				weatherState.hiddenLayers[layer] = true
				layer:SetAttribute("Enabled", false)
			end
		end
	end

	if workspace.Terrain:GetAttribute("SeaTheme") == "Dark" then
		workspace.Terrain:SetAttribute("SeaTheme", "Default")
		weatherState.changedSeaTheme = true
	end

	-- The game scales its sea camera sway by (1 - TerrorReducer); 1 removes it.
	local character = localPlayer.Character
	if character and character:GetAttribute("TerrorReducer") ~= 1 then
		if weatherState.reducerCharacter ~= character then
			weatherState.reducerCharacter = character
			weatherState.reducerOriginal = character:GetAttribute("TerrorReducer")
		end
		character:SetAttribute("TerrorReducer", 1)
	end
end

---Put every weather change back the way the game had it.
function Weather.restoreWeather()
	Weather.setWeatherLocks(false)

	for layer in pairs(weatherState.hiddenLayers) do
		if layer.Parent then
			layer:SetAttribute("Enabled", nil)
		end
	end
	table.clear(weatherState.hiddenLayers)

	-- Only restore the dark theme if we're still in the dark sea.
	local danger = localPlayer:GetAttribute("DangerLevel") or 0
	if weatherState.changedSeaTheme and danger >= WEATHER.DARK_SEA_DANGER and workspace.Terrain:GetAttribute("SeaTheme") == "Default" then
		workspace.Terrain:SetAttribute("SeaTheme", "Dark")
	end
	weatherState.changedSeaTheme = false

	local character = weatherState.reducerCharacter
	if character and character.Parent then
		character:SetAttribute("TerrorReducer", weatherState.reducerOriginal)
	end
	weatherState.reducerCharacter = nil
	weatherState.reducerOriginal = nil
end

---Re-apply suppression on an interval, since the game re-enables effects as you move.
function Weather.updateWeather()
	if not settings.disableWeather then
		return
	end

	if os.clock() - weatherState.lastUpdate < WEATHER.UPDATE_INTERVAL then
		return
	end

	weatherState.lastUpdate = os.clock()
	Weather.applyWeatherSuppression()
end

---@module Fishing
local Fishing = {}

---Get the game's shared fishing state table.
---@return table?
function Fishing.getFishingState()
	return fishingComponents and fishingComponents.state
end

---Get the game's fishing controller (the FishingClient's own table).
---@return table?
function Fishing.getFishingController()
	local state = Fishing.getFishingState()
	local controller = state and state.Controller
	return typeof(controller) == "table" and controller or nil
end

---Whether any fishing mode is on.
---@return boolean
function Fishing.isFishingOn()
	return settings.fishMode == "Assist" or settings.fishMode == "Auto"
end

---Decide whether to reel this frame, or nil to defer to the real input.
---Leads the fish: predicts both bars a short time ahead and pushes toward the fish.
---@return boolean?
function Fishing.getReelDecision()
	local state = Fishing.getFishingState()
	if not Fishing.isFishingOn() or not state then
		return nil
	end

	-- The reel is won but `playing` stays true until the catch dialogue closes.
	local reelFinished = state.playing and (state.progress or 0) >= 1

	if not state.playing or reelFinished then
		fishState.lastFishPos = nil
		fishState.fishVelocity = 0

		-- Full Auto: answer the game's "tap to continue" wait right after a catch.
		if settings.fishMode == "Auto" and os.clock() - fishState.lastCatchAt < FISHING.SKIP_TAP_WINDOW then
			return true
		end

		return nil
	end

	local now = os.clock()
	local fishPos = state.fishPos or 0.5

	-- The game may ask more than once per frame; only sample when time moved.
	if fishState.lastFishPos and fishState.lastClock then
		local dt = now - fishState.lastClock
		if dt > 0.001 and dt < 0.5 then
			local rawVelocity = (fishPos - fishState.lastFishPos) / dt
			fishState.fishVelocity += (rawVelocity - fishState.fishVelocity) * FISHING.VELOCITY_SMOOTHING
		end
	end

	fishState.lastFishPos = fishPos
	fishState.lastClock = now

	-- playerPos moves by velocity * dt * 30 in the game's loop.
	local predictedFish = fishPos + fishState.fishVelocity * FISHING.LOOKAHEAD
	local predictedPlayer = (state.playerPos or 0.5) + (state.velocity or 0) * 30 * FISHING.LOOKAHEAD

	return predictedFish > predictedPlayer
end

---Route the controller's reel check and bite reaction through the helpers.
---Re-runs safely; it hooks whichever controller instance is current.
function Fishing.installFishingHooks()
	local controller = Fishing.getFishingController()
	if not controller or fishState.hookedController == controller then
		return
	end

	local originalIsReeling = controller.IsReeling
	local originalOnPrimaryAction = controller.OnPrimaryAction
	if typeof(originalIsReeling) ~= "function" or typeof(originalOnPrimaryAction) ~= "function" then
		return
	end

	fishState.hookedController = controller
	fishState.originalIsReeling = originalIsReeling
	fishState.originalOnPrimaryAction = originalOnPrimaryAction

	controller.IsReeling = function(self, ...)
		local ok, decision = pcall(Fishing.getReelDecision)
		if ok and decision ~= nil then
			return decision
		end

		return originalIsReeling(self, ...)
	end

	-- The bite waits on a click; answer it after a short, human-like delay.
	controller.OnPrimaryAction = function(self, callback, ...)
		if Fishing.isFishingOn() and typeof(callback) == "function" then
			local delay = FISHING.REACTION_MIN + math.random() * (FISHING.REACTION_MAX - FISHING.REACTION_MIN)
			task.delay(delay, function()
				if Fishing.isFishingOn() then
					pcall(callback)
				end
			end)
		end

		return originalOnPrimaryAction(self, callback, ...)
	end
end

---Put the game's own fishing functions back.
function Fishing.uninstallFishingHooks()
	local controller = fishState.hookedController
	if controller then
		if fishState.originalIsReeling then
			controller.IsReeling = fishState.originalIsReeling
		end
		if fishState.originalOnPrimaryAction then
			controller.OnPrimaryAction = fishState.originalOnPrimaryAction
		end
	end

	fishState.hookedController = nil
	fishState.originalIsReeling = nil
	fishState.originalOnPrimaryAction = nil
end

---Ask the server how much of the equipped bait is left.
---@return number?, string?
function Fishing.getBaitInfo()
	if not jobsReplicated then
		return nil, nil
	end

	local info = withGameIdentity(function()
		return jobsReplicated.InvokeServer("FishingNPC", "Bait", "Check", "Fisherman")
	end)

	if typeof(info) ~= "table" then
		return nil, nil
	end

	return tonumber(info.Total), info.Equipped
end

---Craft Basic Bait from anywhere; the Fisherman doesn't need to be nearby.
---@param crafts number
---@return boolean
function Fishing.buyBait(crafts)
	if not craftRemote then
		return false
	end

	local result = withGameIdentity(function()
		return craftRemote:InvokeServer("Craft", FISHING.BAIT_RECIPE, crafts, {})
	end)

	return typeof(result) == "table" and typeof(result.Result) == "table" and result.Result.Could ~= false
end

---Top up Basic Bait in the background when Full Auto runs low.
function Fishing.checkBaitSupply()
	if fishState.buyingBait or not settings.autoBuyBait or os.clock() - fishState.lastBaitCheck < FISHING.BAIT_CHECK_INTERVAL then
		return
	end

	fishState.lastBaitCheck = os.clock()
	fishState.buyingBait = true

	task.spawn(function()
		local total, equipped = Fishing.getBaitInfo()

		-- Only Basic Bait can be bought with Beli; other bait needs crafting materials.
		if total and total < FISHING.BAIT_LOW_THRESHOLD and (equipped == FISHING.BAIT_RECIPE or equipped == nil or equipped == "None") then
			if Fishing.buyBait(1) then
				setStatus(("Bought %d Basic Bait."):format(FISHING.BAIT_PER_CRAFT), THEME.good)
			else
				setStatus("Couldn't buy bait.", THEME.bad)
			end
		end

		fishState.buyingBait = false
	end)
end

---Let go of a cast the moment the bar is perfect, through the game's own release.
---@param state table
---@param controller table
function Fishing.releaseAtPerfect(state, controller)
	if not state.holding or state.isThrowing or state.playing then
		fishState.castStartedAt = nil
		return
	end

	fishState.castStartedAt = fishState.castStartedAt or os.clock()

	local castBar = fishingComponents.Objects and fishingComponents.Objects.LineCastBar
	if not castBar or not castBar.Modal then
		return
	end

	-- Full Auto: give up on a cast that never points at water so it can't hang.
	local validSurface = state.surfaceData and state.surfaceData.Valid
	if settings.fishMode == "Auto" and not validSurface and os.clock() - fishState.castStartedAt > FISHING.AIM_TIMEOUT then
		fishState.castStartedAt = nil
		fishState.nextCastAt = os.clock() + FISHING.RECAST_DELAY * 2
		setStatus("Face the water (and point at it) to auto fish.", THEME.bad)
		task.spawn(function()
			withGameIdentity(function()
				controller:Cleanup()
			end)
		end)
		return
	end

	if (castBar.CastStrength or 0) < FISHING.PERFECT_CAST or not validSurface then
		return
	end

	-- The game rejects releases in the first 0.2s of a cast.
	if tick() - (state.StartedCastingAt or tick()) < 0.2 or os.clock() - fishState.lastRelease < FISHING.RELEASE_COOLDOWN then
		return
	end

	fishState.lastRelease = os.clock()
	fishState.castStartedAt = nil
	fishState.perfectCasts += 1
	setStatus(("Perfect cast x%d"):format(fishState.perfectCasts), THEME.good)

	-- The release yields on the server call, so keep it off the frame loop.
	task.spawn(function()
		withGameIdentity(function()
			controller:Deactivated()
		end)
	end)
end

---Full Auto: close the catch dialogue and start the next cast.
---@param state table
---@param controller table
function Fishing.runFullAuto(state, controller)
	Fishing.checkBaitSupply()

	-- Close only the dialogue a catch just opened, never one you started.
	if dialogueController and dialogueController.Active then
		if os.clock() - fishState.lastCatchAt < FISHING.CATCH_DIALOGUE_WINDOW then
			withGameIdentity(function()
				dialogueController.close()
			end)
			fishState.nextCastAt = os.clock() + FISHING.RECAST_DELAY
		end
		return
	end

	if os.clock() < fishState.nextCastAt or not state.currentFishingRod then
		return
	end

	local idle = withGameIdentity(function()
		return controller:IsIdle()
	end)
	if not idle or state.bobber then
		return
	end

	fishState.nextCastAt = os.clock() + FISHING.RECAST_DELAY

	-- Activated is the same entry point a mouse press uses; it yields while casting.
	task.spawn(function()
		withGameIdentity(function()
			controller:Activated()
		end)
	end)
end

---Instant catch: fill the reel shortly after the minigame really starts playing.
---The short wait keeps the reported reel time from being a single frame.
---@param state table
function Fishing.applyInstantCatch(state)
	if not settings.instantCatch or not state.playing then
		return
	end

	local minigame = fishingComponents.Objects and fishingComponents.Objects.CatchingMinigame
	if not minigame or not minigame.FinallyPlaying then
		return
	end

	fishState.reelStartedAt = fishState.reelStartedAt or os.clock()
	if os.clock() - fishState.reelStartedAt < FISHING.INSTANT_CATCH_DELAY then
		return
	end

	local maxProgress = state.currentFish and tonumber(state.currentFish.MaxProgress) or 1
	if (state.progress or 0) < maxProgress then
		state.progress = maxProgress
	end
end

---Per-frame fishing driver for both modes.
function Fishing.updateAutoFish()
	local state = Fishing.getFishingState()
	local controller = Fishing.getFishingController()
	if not state or not controller then
		return
	end

	-- The controller can be rebuilt by the game; keep hooks on the live one.
	Fishing.installFishingHooks()

	-- A won reel keeps `playing` true until its dialogue closes, so mark the catch
	-- as soon as progress fills; that's what lets Full Auto close the dialogue.
	if state.playing and (state.progress or 0) >= 1 then
		if not fishState.catchCounted then
			fishState.catchCounted = true
			fishState.catches += 1
			if Fishing.isFishingOn() then
				setStatus(("Caught x%d"):format(fishState.catches), THEME.good)
			end
		end
		fishState.lastCatchAt = os.clock()
	end

	if fishState.wasPlaying and not state.playing then
		fishState.catchCounted = false
		fishState.reelStartedAt = nil
		fishState.nextCastAt = os.clock() + FISHING.RECAST_DELAY
	end
	fishState.wasPlaying = state.playing == true

	if not Fishing.isFishingOn() then
		return
	end

	Fishing.applyInstantCatch(state)

	Fishing.releaseAtPerfect(state, controller)

	if settings.fishMode == "Auto" then
		Fishing.runFullAuto(state, controller)
	end
end

---Switch fishing modes; turning one on turns the other off.
