---Fit the quick panel to its content, growing upward from the anchor.
---The quick panel is allowed off screen, so it is never clamped.
local function updateWindowSize(animate)
	local height = minimized and UI.HEADER_HEIGHT
		or UI.HEADER_HEIGHT + UI.ACTIONS_HEIGHT + math.min(contentLayout.AbsoluteContentSize.Y, UI.MAX_CONTENT_HEIGHT) + 8
	local goal = UDim2.fromOffset(UI.WINDOW_WIDTH, height)

	if animate then
		tween(mainFrame, { Size = goal }, 0.2)
	else
		mainFrame.Size = goal
	end
end

