---Build the boat speed toggle, slider and number box.
---@param canvas table
local function populateBoat(canvas)
	local enabled = settings.boatSpeedEnabled

	createSwitchRow(canvas.body, nextOrder(canvas), {
		text = "Custom Boat Speed",
		subtitle = "Applies to the boat you're driving.",
		enabled = enabled,
		onToggle = function()
			settings.boatSpeedEnabled = not settings.boatSpeedEnabled
			if not settings.boatSpeedEnabled then
				Boat.restoreBoatSpeeds()
			end
			saveSettings()
			renderAll()
		end,
	})

	local holder = create("Frame", {
		LayoutOrder = nextOrder(canvas),
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = THEME.row,
		BorderSizePixel = 0,
		Parent = canvas.body,
	})
	corner(holder, 8)

	create("TextLabel", {
		Position = UDim2.fromOffset(12, 5),
		Size = UDim2.new(1, -90, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = "Speed",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.text,
		TextSize = 12,
		Parent = holder,
	})

	local valueBox = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 5),
		Size = UDim2.fromOffset(56, 18),
		BackgroundColor3 = THEME.section,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = THEME.accent,
		TextSize = 12,
		Parent = holder,
	})
	corner(valueBox, 5)

	local track = create("TextButton", {
		Position = UDim2.new(0, 12, 0, 31),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = THEME.section,
		AutoButtonColor = false,
		Text = "",
		Parent = holder,
	})
	corner(track, 3)

	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	})
	corner(fill, 3)
	create("UIGradient", { Color = ColorSequence.new(THEME.accent, THEME.accentAlt), Parent = fill })

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = THEME.text,
		BorderSizePixel = 0,
		Parent = track,
	})
	corner(knob, 6)

	---Sync the slider and box to the stored speed.
	local function display()
		local alpha = (settings.boatSpeed - BOAT.SPEED_MIN) / (BOAT.SPEED_MAX - BOAT.SPEED_MIN)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueBox.Text = tostring(settings.boatSpeed)
	end

	---Set speed from a screen X position on the track.
	local function setFromX(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end

		local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		Boat.setBoatSpeed(BOAT.SPEED_MIN + alpha * (BOAT.SPEED_MAX - BOAT.SPEED_MIN))
		display()
	end

	-- Drag connections live only for the duration of one drag.
	track.InputBegan:Connect(function(input)
		if not isPointerPress(input) then
			return
		end

		setFromX(input.Position.X)

		local moveConnection, endConnection
		moveConnection = userInputService.InputChanged:Connect(function(moveInput)
			-- A re-render destroyed the slider mid-drag; keep the speed it reached.
			if not track.Parent then
				moveConnection:Disconnect()
				endConnection:Disconnect()
				saveSettings()
				return
			end

			if isPointerMove(moveInput) then
				setFromX(moveInput.Position.X)
			end
		end)

		endConnection = userInputService.InputEnded:Connect(function(endInput)
			if endInput.UserInputType ~= input.UserInputType then
				return
			end

			moveConnection:Disconnect()
			endConnection:Disconnect()
			saveSettings()
			renderAll()
		end)
	end)

	valueBox.FocusLost:Connect(function()
		local value = tonumber(valueBox.Text)
		if value then
			Boat.setBoatSpeed(value)
			saveSettings()
		end
		renderAll()
	end)

	display()

	boatState.hintLabels[createEmpty(canvas.body, "", nextOrder(canvas))] = true
	Boat.updateBoatHint()

	return enabled and "ON" or "OFF"
end

