	-- (Own function scope: the scripts sit close to Luau's 200-local limit.)
	;(function()
	-- My songs: your own files in Potent/music/<Playlist>/ (shared by every Potent script).
	-- One player for every game: playlist filter, search, shuffle, and the playing song lit up.
	local MUSIC_ROOT = "Potent/music"
	local Player = { queue = {}, index = 0, rows = {}, cache = {} }
	UI.player = Player

	local function fileName(path)
		return tostring(path):match("([^/\\]+)$") or tostring(path)
	end

	function Player.playlists()
		local names = {}
		pcall(function()
			if not isfolder(MUSIC_ROOT) then
				makefolder(MUSIC_ROOT)
			end
			for _, path in ipairs(listfiles(MUSIC_ROOT)) do
				if isfolder(path) then
					table.insert(names, fileName(path))
				end
			end
		end)
		table.sort(names)
		return names
	end

	---Songs in one playlist (or "All", duplicates dropped). "Artist - Title.mp3" splits into both.
	function Player.songs(playlist, refresh)
		if playlist ~= "All" and Player.cache[playlist] and not refresh then
			return Player.cache[playlist]
		end
		if playlist == "All" then
			local list, seen = {}, {}
			for _, name in ipairs(Player.playlists()) do
				for _, song in ipairs(Player.songs(name, refresh)) do
					local key = (song.artist .. "|" .. song.title):lower()
					if not seen[key] then
						seen[key] = true
						table.insert(list, song)
					end
				end
			end
			table.sort(list, function(a, b)
				return a.label:lower() < b.label:lower()
			end)
			return list
		end
		local list = {}
		pcall(function()
			for _, path in ipairs(listfiles(MUSIC_ROOT .. "/" .. playlist)) do
				local file = fileName(path)
				local base, ext = file:match("^(.+)%.(%w+)$")
				ext = ext and ext:lower()
				if base and (ext == "mp3" or ext == "ogg" or ext == "wav" or ext == "flac") then
					local artist, title = base:match("^(.-) %- (.+)$")
					table.insert(list, {
						path = MUSIC_ROOT .. "/" .. playlist .. "/" .. file,
						title = title or base,
						artist = artist or "",
						playlist = playlist,
						label = title and (title .. "  -  " .. artist) or base,
					})
				end
			end
		end)
		table.sort(list, function(a, b)
			return a.label:lower() < b.label:lower()
		end)
		Player.cache[playlist] = list
		return list
	end

	---What the list shows: the picked playlist, narrowed by the search text.
	function Player.visible()
		local list = Player.songs(Config.MyMusicPlaylist or "All")
		local query = (Player.query or ""):lower()
		if query == "" then
			return list
		end
		local found = {}
		for _, song in ipairs(list) do
			if song.label:lower():find(query, 1, true) then
				table.insert(found, song)
			end
		end
		return found
	end

	local function shuffled(list, first)
		local copy = table.clone(list)
		for i = #copy, 2, -1 do
			local j = math.random(i)
			copy[i], copy[j] = copy[j], copy[i]
		end
		if first then
			for i, song in ipairs(copy) do
				if song.path == first.path then
					table.remove(copy, i)
					break
				end
			end
			table.insert(copy, 1, first)
		end
		return copy
	end

	local function soundObject()
		if not (Player.sound and Player.sound.Parent) then
			Player.sound = create("Sound", { Name = "PotentMyMusic", Looped = false, Parent = game:GetService("SoundService") })
			Player.sound.Ended:Connect(function()
				task.defer(Player.next, 1)
			end)
		end
		return Player.sound
	end

	function Player.play(song)
		if not song then
			return
		end
		local ok, asset = pcall(getcustomasset, song.path)
		if not ok then
			Player.status = "Can't open " .. song.title
			return
		end
		local sound = soundObject()
		Player.current = song
		Player.paused = false
		sound.SoundId = asset
		sound.Volume = (Config.MyMusicVolume or 50) / 100
		sound.TimePosition = 0
		sound:Play()
		Player.startedAt = os.clock()
		Player.highlight()
	end

	---Start a queue from a list; with shuffle on it's shuffled (the clicked song still plays first).
	function Player.start(list, song)
		if #list == 0 then
			return
		end
		if Config.MyMusicShuffle then
			Player.queue = shuffled(list, song)
			Player.index = 1
		else
			Player.queue, Player.index = list, 1
			for i, entry in ipairs(list) do
				if song and entry.path == song.path then
					Player.index = i
				end
			end
		end
		Config.MyMusicOn = true
		Player.play(Player.queue[Player.index])
	end

	function Player.next(step)
		if not Config.MyMusicOn then
			return
		end
		if #Player.queue == 0 then
			Player.start(Player.visible())
			return
		end
		Player.index = (Player.index - 1 + (step or 1)) % #Player.queue + 1
		if Player.index == 1 and (step or 1) > 0 and Config.MyMusicShuffle then
			Player.queue = shuffled(Player.queue)
		end
		Player.play(Player.queue[Player.index])
	end

	function Player.togglePause()
		local sound = Player.sound
		if not (sound and Player.current) then
			Player.start(Player.visible())
			return "Playing"
		end
		if Player.paused then
			sound:Resume()
			Player.paused = false
			return "Playing"
		end
		sound:Pause()
		Player.paused = true
		return "Paused"
	end

	function Player.stop()
		if Player.sound then
			Player.sound:Stop()
		end
		Player.current, Player.paused = nil, false
		Player.highlight()
	end

	---Quiet the game's own long tracks while your song plays (effects stay).
	-- Quiet the game's own long tracks while our music plays (effects stay). Lobby/map music
	-- scripts fade their volume back up, so each muted track is held at 0 by a Volume watcher
	-- (the game's latest volume is kept for when it's given back). One muter per music engine.
	function UI.makeMuter()
		local muted, groupVolume, scanAt = {}, nil, 0
		local function check(sound)
			if sound:IsA("Sound") and sound.Name ~= "PotentMusic" and sound.Name ~= "PotentMyMusic" and sound.Name ~= "PotentClassicTheme"
				and sound.TimeLength > 40 and not muted[sound] and (sound.IsPlaying or sound.Volume > 0) then
				local record = { volume = sound.Volume }
				record.connection = sound:GetPropertyChangedSignal("Volume"):Connect(function()
					if sound.Volume > 0 then
						record.volume = sound.Volume
						sound.Volume = 0
					end
				end)
				muted[sound] = record
				sound.Volume = 0
			end
		end
		return function(mute)
			local group = game:GetService("SoundService"):FindFirstChild("Music")
			group = group and group:IsA("SoundGroup") and group or nil
			if not mute then
				for sound, record in pairs(muted) do
					record.connection:Disconnect()
					pcall(function()
						sound.Volume = record.volume
					end)
				end
				table.clear(muted)
				if group and groupVolume then
					group.Volume = groupVolume
				end
				groupVolume, scanAt = nil, 0
				return
			end
			if group then
				groupVolume = groupVolume or group.Volume
				group.Volume = 0
			end
			if os.clock() - scanAt < 3 then
				return
			end
			scanAt = os.clock()
			for _, sound in ipairs(game:GetService("SoundService"):GetDescendants()) do
				check(sound)
			end
			for _, child in ipairs(workspace:GetChildren()) do
				if child:IsA("Sound") then
					check(child)
				elseif child:IsA("Folder") or child:IsA("Configuration") then
					for _, sound in ipairs(child:GetDescendants()) do
						check(sound)
					end
				end
			end
			local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
			for _, sound in ipairs(playerGui and playerGui:GetDescendants() or {}) do
				check(sound)
			end
			for sound, record in pairs(muted) do
				if not sound.Parent then
					record.connection:Disconnect()
					muted[sound] = nil
				end
			end
		end
	end
	Player.muteGame = UI.makeMuter()

	local function clock(seconds)
		seconds = math.max(0, math.floor(seconds or 0))
		return string.format("%d:%02d", seconds // 60, seconds % 60)
	end

	-- The playing song's row: accent bar on the left, accent text, "> " in front.
	function Player.highlight()
		for _, row in ipairs(Player.rows) do
			local playing = Player.current ~= nil and row.song.path == Player.current.path
			row.button.BackgroundColor3 = playing and UI.roles.Accent or UI.roles.Main
			row.button.BackgroundTransparency = playing and 0.82 or 1
			row.button.TextColor3 = playing and UI.roles.Accent or UI.roles.Font
			row.button.Text = (playing and (Player.paused and "  || " or "  > ") or "    ") .. row.song.label
			row.bar.Visible = playing
			row.bar.BackgroundColor3 = UI.roles.Accent
		end
	end
	table.insert(UI.colorRefreshers, function()
		Player.highlight()
	end)

	function UI.musicSection(page)
		UI.heading(page, "My songs", "left", "Your own files, shared by every Potent script.")
		UI.toggle(page, "Play my songs", "MyMusicOn")
		UI.toggle(page, "Shuffle", "MyMusicShuffle")
		UI.toggle(page, "Mute the game's music", "MyMusicMuteGame")
		UI.slider(page, "Volume", "MyMusicVolume", 0, 100, 5, function(v)
			return v .. "%"
		end)
		local nowLine = UI.infoLine(page, 36)
		UI.buttonPair(page, "Previous", function()
			Player.next(-1)
		end, "Next", function()
			Player.next(1)
		end)
		UI.buttonPair(page, "Shuffle all", function()
			Config.MyMusicShuffle = true
			for _, refresh in ipairs(UI.refreshers) do
				pcall(refresh)
			end
			Player.start(Player.visible())
			return "Shuffled"
		end, "Pause or play", function()
			return Player.togglePause()
		end)
		UI.button(page, "Play in order", function()
			local was = Config.MyMusicShuffle
			Config.MyMusicShuffle = false
			Player.start(Player.visible())
			Config.MyMusicShuffle = was
			return "Playing"
		end)
		UI.note(page, "To add songs, put files in workspace/" .. MUSIC_ROOT .. "/<playlist name>/ and press Rescan files.")

		UI.heading(page, "Song list", "left")
		local fillList
		UI.dropdown(page, "Playlist", function()
			local options = { "All" }
			for _, name in ipairs(Player.playlists()) do
				table.insert(options, name)
			end
			return options
		end, function()
			return Config.MyMusicPlaylist
		end, function(name)
			Config.MyMusicPlaylist = name
			fillList()
		end)
		local search = UI.textbox(page, "Search", "Song or artist")
		search:GetPropertyChangedSignal("Text"):Connect(function()
			Player.query = search.Text
			fillList()
		end)
		local countLine = UI.infoLine(page, 16)
		countLine.TextColor3 = UI.roles.Muted
		local scroller = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 300),
			BackgroundColor3 = UI.roles.Background,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = UI.roles.Outline,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			LayoutOrder = UI.nextOrder(),
			Parent = slot(page, 300),
		}, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
			create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 8) }),
			UI.corner(7),
		})
		stroke(scroller, "Outline")
		UI.button(page, "Rescan files", function()
			table.clear(Player.cache)
			fillList()
			return #Player.visible() .. " songs"
		end)

		fillList = function()
			for _, row in ipairs(Player.rows) do
				row.button:Destroy()
			end
			table.clear(Player.rows)
			local list = Player.visible()
			countLine.Text = #list .. " songs" .. ((Config.MyMusicPlaylist or "All") ~= "All" and (" in " .. Config.MyMusicPlaylist) or "")
			for index, song in ipairs(list) do
				local button = create("TextButton", {
					Size = UDim2.new(1, 0, 0, 26),
					BackgroundColor3 = UI.roles.Main,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					FontFace = CODE,
					Text = "    " .. song.label,
					TextSize = px(14),
					TextColor3 = UI.roles.Font,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					AutoButtonColor = false,
					LayoutOrder = index,
					Parent = scroller,
				})
				button:SetAttribute("NoTheme", true)
				UI.corner(5).Parent = button
				local bar = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.fromOffset(3, 14), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, Visible = false, Parent = button }, { UI.corner(2) })
				bar:SetAttribute("NoTheme", true)
				local row = { button = button, bar = bar, song = song }
				button.MouseEnter:Connect(function()
					if not (Player.current and Player.current.path == song.path) then
						button.BackgroundTransparency = 0.6
					end
				end)
				button.MouseLeave:Connect(function()
					Player.highlight()
				end)
				button.MouseButton1Click:Connect(function()
					Player.start(Player.visible(), song)
					for _, refresh in ipairs(UI.refreshers) do
						pcall(refresh)
					end
				end)
				table.insert(Player.rows, row)
			end
			Player.highlight()
		end
		task.defer(fillList)

		-- Player loop: next song at the end, skip files that won't load, keep the game's music
		-- quiet, and give way to the script's own music mode (if it has one).
		task.spawn(function()
			local wasOn, otherWas = false, Config.MusicOn
			-- The window is parented at the end of finish(); wait for it before watching it.
			local waited = os.clock()
			while not screenGui.Parent and os.clock() - waited < 15 do
				task.wait(0.2)
			end
			while screenGui.Parent do
				pcall(function()
					if Config.MusicOn ~= nil and Config.MusicOn ~= otherWas then
						otherWas = Config.MusicOn
						if Config.MusicOn and Config.MyMusicOn then
							Config.MyMusicOn = false
							for _, refresh in ipairs(UI.refreshers) do
								pcall(refresh)
							end
						end
					end
					if Config.MyMusicOn and not wasOn and Config.MusicOn then
						Config.MusicOn, otherWas = false, false
						for _, refresh in ipairs(UI.refreshers) do
							pcall(refresh)
						end
					end
					local sound = Player.sound
					if Config.MyMusicOn then
						if not wasOn then
							wasOn = true
							if not Player.current then
								Player.start(Player.visible())
							elseif sound and Player.paused == false then
								sound:Resume()
							end
						end
						if sound then
							sound.Volume = (Config.MyMusicVolume or 50) / 100
							if not Player.paused and not sound.IsLoaded and os.clock() - (Player.startedAt or 0) > 12 then
								Player.next(1)
							elseif not Player.paused and sound.IsLoaded and not sound.IsPlaying and os.clock() - (Player.startedAt or 0) > 3 then
								Player.next(1)
							end
						end
						Player.muteGame(Config.MyMusicMuteGame and sound ~= nil and sound.IsPlaying)
						local current = Player.current
						if current and sound then
							nowLine.Text = (Player.paused and "Paused: " or "Now: ") .. current.title .. (current.artist ~= "" and (" - " .. current.artist) or "") .. "\n" .. clock(sound.TimePosition) .. " of " .. clock(sound.TimeLength) .. ", " .. current.playlist .. ((Config.MyMusicShuffle and ", shuffled") or "")
						else
							nowLine.Text = Player.status or "No songs found."
						end
					else
						if wasOn then
							wasOn = false
							if sound then
								sound:Pause()
							end
							Player.muteGame(false)
							Player.highlight()
						end
						nowLine.Text = Player.current and ("Off. Last played: " .. Player.current.title) or "Off."
					end
				end)
				task.wait(0.5)
			end
			Player.muteGame(false)
			if Player.sound then
				Player.sound:Destroy()
			end
		end)
	end
	end)()

	---Last step: the list of pages, the menu key, and showing the window.
	function UI.finish(firstTab)
		local order = 0
		for _, group in ipairs({ "Universal", "Menu" }) do
			local opened = false
			for _, name in ipairs(UI.order) do
				if UI.groups[name] == group then
					if not opened then
						opened = true
						order += 1
						UI.makeGroup(group, order)
					end
					order += 1
					UI.makeTab(name, order)
				end
			end
		end
		screenGui.Parent = guiParent
		for _, object in ipairs(screenGui:GetDescendants()) do
			pcall(UI.fitText, object)
			pcall(UI.classify, object)
		end
		UI.selectTab(pages[firstTab] and firstTab or UI.order[1])
		panel.Visible = not Config.HideOnExecute

		table.insert(BeyRivals.connections, userInputService.InputBegan:Connect(function(input)
			if UI.capturing or userInputService:GetFocusedTextBox() then
				return
			end
			if input.KeyCode.Name == Config.MenuKey then
				panel.Visible = not panel.Visible
				UI.showTip(nil)
			end
		end))
		if Config.HideOnExecute then
			UI.toast("Potent Universal is running", (SHORT_KEYS[Config.MenuKey] or tostring(Config.MenuKey)) .. " opens the menu.", 6)
		end
	end
end)()
