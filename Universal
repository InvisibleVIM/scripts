					for index = 2, #WEIGHTS do
						width(candidate[2], WEIGHTS[index], 4)
					end
					Type.own, Type.name, Type.family = true, candidate[1], candidate[2]
					break
				end
			end
		end
		if not Type.own then
			local measured = width(Type.family, WEIGHTS[1], 3)
			Type.tried.builtIn = measured or "no answer"
			Type.scale = measured and math.clamp(CANDIDATES[1][3] / measured, 0.72, 1) or 1
		end
	end
	local CODE = Font.new(Type.family, Enum.FontWeight.Regular)
	local CODE_MEDIUM = Font.new(Type.family, Enum.FontWeight.Medium)
	local CODE_BOLD = Font.new(Type.family, Enum.FontWeight.SemiBold)
	---A text size from the scale below, shrunk when the fallback font is wider than the design.
	local function px(size)
		return math.max(math.floor(size * Type.scale + 0.5), 9)
	end
	-- Type scale: 12 small print, 13 notes, 14 values, 15 names, 16 card titles, 19 status,
	-- 22 page titles, 24 figures. Notes and wrapped text sit at a line height of 1.2.
	local TEXT_SIZE = px(15)
	-- Spacing (px): 4 inside a control, 8 between a name and its control, 12 between rows,
	-- 16 inside a card, 20 around the page. Corners: 14 window, 10 cards, 7 controls.
	local WINDOW_WIDTH, WINDOW_HEIGHT, SIDEBAR, HEADER, GUTTER = 900, 640, 172, 70, 20

	local function readColor(key, default)
		local ok, color = pcall(Color3.fromHex, tostring(Config[key] or default))
		if not ok then
			Config[key] = default
			return Color3.fromHex(default)
		end
		return color
	end

	local function computeRoles()
		local roles = {}
		for _, entry in ipairs(THEME) do
			roles[entry.role] = readColor(entry.key, entry.default)
		end
		roles.Control = roles.Main:Lerp(roles.Font, 0.07)
		roles.Raised = roles.Main:Lerp(roles.Font, 0.13)
		roles.Muted = roles.Font:Lerp(roles.Main, 0.42)
		return roles
	end
	UI.roles = computeRoles()
	---Text / knob color that reads on top of the accent, whatever accent the theme picks.
	function UI.onAccent()
		local accent = UI.roles.Accent
		return (0.299 * accent.R + 0.587 * accent.G + 0.114 * accent.B) > 0.5 and UI.roles.Background or UI.roles.Font
	end

	-- The scripts' own custom rows use the palette constants: point them at the theme.
	local function syncConstants()
		local roles = UI.roles
		STEEL, PANEL, RAISED, LINE, TEXT, MUTED, GOLD = roles.Background, roles.Main, roles.Control, roles.Outline, roles.Font, roles.Muted, roles.Accent
		DISPLAY_FONT, TAB_FONT, BODY_FONT, BODY_BOLD = CODE_BOLD, CODE_MEDIUM, CODE, CODE_BOLD
	end

	-- Start on the shared default theme unless this script's colors were changed by hand.
	if Config.UseDefaultTheme ~= false then
		pcall(function()
			if isfile("PotentHub/default_theme.json") then
				local theme = httpService:JSONDecode(readfile("PotentHub/default_theme.json"))
				for _, entry in ipairs(THEME) do
					if type(theme[entry.key]) == "string" and pcall(Color3.fromHex, theme[entry.key]) then
						Config[entry.key] = theme[entry.key]
					end
				end
				UI.roles = computeRoles()
			end
		end)
	end
	syncConstants()

	local function create(class, props, children)
		local instance = Instance.new(class)
		for key, value in pairs(props or {}) do
			instance[key] = value
		end
		for _, child in ipairs(children or {}) do
			child.Parent = instance
		end
		return instance
	end
	UI.create = create

	UI.corner = function(radius)
		return create("UICorner", { CornerRadius = UDim.new(0, radius or 7) })
	end
	local function round(parent, radius)
		return create("UICorner", { CornerRadius = UDim.new(0, radius or 7), Parent = parent })
	end

	local function tween(instance, props, duration)
		tweenService:Create(instance, TweenInfo.new(duration or 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
	end
	UI.tween = tween

	local function stroke(parent, role)
		return create("UIStroke", { Color = UI.roles[role or "Outline"], Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
	end

	local function label(props)
		props.BackgroundTransparency = 1
		props.FontFace = props.FontFace or CODE
		props.TextSize = props.TextSize or TEXT_SIZE
		props.TextColor3 = props.TextColor3 or UI.roles.Font
		props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
		return create("TextLabel", props)
	end
	UI.label, UI.px = label, px
	---Text that wraps and grows downwards instead of being cut off.
	local function wrapped(props)
		props.AutomaticSize = Enum.AutomaticSize.Y
		props.TextWrapped = true
		props.LineHeight = props.LineHeight or 1.2
		props.TextYAlignment = Enum.TextYAlignment.Top
		return label(props)
	end
	UI.wrapped = wrapped

	-- Only with the fallback font (a custom one may be much wider than the design): one-line
	-- text that doesn't fit its box scales down instead of being cut.
	function UI.fitText(object)
		if Type.own or not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
			return
		end
		if object.AutomaticSize ~= Enum.AutomaticSize.None or object.TextScaled or object.TextWrapped or object:FindFirstChildOfClass("UITextSizeConstraint") then
			return
		end
		local designed = object.TextSize
		object.TextScaled = true
		create("UITextSizeConstraint", { MaxTextSize = designed, MinTextSize = 8, Parent = object })
	end

	-- Small marks drawn from bars, so no glyph depends on what a font happens to carry.
	---kind: "down", "up", "cross", "check". Returns the holder; recolor with UI.tint(holder, color).
	local function icon(parent, kind, size, color, props)
		local holder = create("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Parent = parent })
		for key, value in pairs(props or {}) do
			holder[key] = value
		end
		local function bar(length, angle, x, y)
			local line = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(x, y),
				Size = UDim2.fromOffset(math.floor(length * size + 0.5), 2),
				Rotation = angle,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Parent = holder,
			})
			round(line, 1)
		end
		if kind == "cross" then
			bar(0.8, 45, 0.5, 0.5)
			bar(0.8, -45, 0.5, 0.5)
		elseif kind == "down" then
			bar(0.5, 45, 0.34, 0.5)
			bar(0.5, -45, 0.66, 0.5)
		elseif kind == "up" then
			bar(0.5, -45, 0.34, 0.5)
			bar(0.5, 45, 0.66, 0.5)
		elseif kind == "check" then
			bar(0.38, 45, 0.3, 0.62)
			bar(0.7, -50, 0.62, 0.48)
		end
		return holder
	end
	UI.icon = icon
	function UI.tint(holder, color)
		for _, child in ipairs(holder:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = color
			end
		end
	end

	local guiParent = (gethui and gethui()) or game:GetService("CoreGui")
	do
		local old = guiParent:FindFirstChild("PotentUniversalUI")
		if old then
			old:Destroy()
		end
	end
	local screenGui = create("ScreenGui", {
		Name = "PotentUniversalUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 50,
	})
	UI.screenGui, UI.guiParent = screenGui, guiParent
	BeyRivals.gui = screenGui
	table.insert(BeyRivals.connections, screenGui.DescendantAdded:Connect(function(object)
		task.defer(function()
			pcall(UI.fitText, object)
			pcall(UI.classify, object)
		end)
	end))

	local panel, tabBar, content
	do
		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
		-- Small screens: the whole window scales down instead of hanging off the edge.
		local windowScale = math.clamp(math.min((viewport.X - 24) / WINDOW_WIDTH, (viewport.Y - 24) / WINDOW_HEIGHT), 0.6, 1)
		-- First run: centered. After that: wherever it was last dragged to (kept on screen).
		local position = UDim2.new(0.5, -WINDOW_WIDTH * windowScale / 2, 0.5, -WINDOW_HEIGHT * windowScale / 2)
		if type(Config.WindowX) == "number" and type(Config.WindowY) == "number" and Config.WindowX >= 0 and Config.WindowY >= 0 then
			position = UDim2.fromOffset(math.clamp(Config.WindowX, 0, math.max(viewport.X - 160, 0)), math.clamp(Config.WindowY, 0, math.max(viewport.Y - 80, 0)))
		end
		panel = create("Frame", {
			Name = "Panel",
			Position = position,
			Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT),
			BackgroundColor3 = UI.roles.Background,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = screenGui,
		}, { create("UIScale", { Scale = windowScale }) })
		round(panel, 14)
		stroke(panel, "Outline")
		UI.panel = panel
		BeyRivals.panel = panel
		-- Old spinning marks are gone; scripts that still rotate one get an invisible frame.
		UI.mark = create("Frame", { Visible = false, Parent = panel })

		-- Left side: what this is, then the pages in three groups.
		local side = create("Frame", { Name = "Side", Size = UDim2.new(0, SIDEBAR, 1, 0), BackgroundTransparency = 1, Parent = panel })
		create("Frame", { Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = UI.roles.Outline, BorderSizePixel = 0, Parent = side })
		local brand = create("Frame", { Size = UDim2.new(1, 0, 0, HEADER), BackgroundTransparency = 1, Parent = side })
		label({ Position = UDim2.fromOffset(GUTTER, 17), Size = UDim2.new(1, -GUTTER - 8, 0, 20), Text = "Potent Universal", FontFace = CODE_BOLD, TextSize = px(16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = brand })
		label({ Position = UDim2.fromOffset(GUTTER, 38), Size = UDim2.new(1, -GUTTER - 8, 0, 16), Text = "Potent Hub " .. tostring(BeyRivals.VERSION), TextSize = px(12), TextColor3 = UI.roles.Muted, TextTruncate = Enum.TextTruncate.AtEnd, Parent = brand })
		tabBar = create("Frame", {
			Position = UDim2.fromOffset(10, HEADER),
			Size = UDim2.new(1, -20, 1, -HEADER - 44),
			BackgroundTransparency = 1,
			Parent = side,
		}, { create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }) })
		UI.keyHint = label({
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, GUTTER, 1, -14),
			Size = UDim2.new(1, -GUTTER - 8, 0, 16),
			Text = "",
			TextSize = px(12),
			TextColor3 = UI.roles.Muted,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = side,
		})

		-- Top strip: the one place that answers "what is it doing?". Big line = the script's
		-- status; under it the level and wave (or what it will join next); on the right two
		-- figures for the session; along its bottom edge the base's health during a match.
		local now = create("Frame", {
			Name = "Now",
			Position = UDim2.fromOffset(SIDEBAR + 1, 0),
			Size = UDim2.new(1, -SIDEBAR - 1, 0, HEADER),
			BackgroundTransparency = 1,
			Parent = panel,
		})
		create("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = UI.roles.Outline, BorderSizePixel = 0, Parent = now })
		local nowDot = create("Frame", { Position = UDim2.fromOffset(GUTTER, 22), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = UI.roles.Muted, BorderSizePixel = 0, Parent = now })
		round(nowDot, 4)
		UI.statusLabel = label({
			Position = UDim2.fromOffset(GUTTER + 18, 13),
			Size = UDim2.new(1, -GUTTER - 18 - 250, 0, 26),
			Text = "",
			FontFace = CODE_BOLD,
			TextSize = px(19),
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = now,
		})
		local nowSub = label({
			Position = UDim2.fromOffset(GUTTER + 18, 39),
			Size = UDim2.new(1, -GUTTER - 18 - 250, 0, 18),
			Text = "",
			TextSize = px(13),
			TextColor3 = UI.roles.Muted,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = now,
		})
		local function nowStat(offset)
			local value = label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -offset, 0, 13),
				Size = UDim2.fromOffset(110, 26),
				Text = "0",
				FontFace = CODE_BOLD,
				TextSize = px(19),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = now,
			})
			local caption = label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -offset, 0, 39),
				Size = UDim2.fromOffset(110, 18),
				Text = "",
				TextSize = px(13),
				TextColor3 = UI.roles.Muted,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = now,
			})
			return value, caption
		end
		local statB, captionB = nowStat(GUTTER)
		local statA, captionA = nowStat(GUTTER + 120)
		local healthTrack = create("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = UI.roles.Control, BorderSizePixel = 0, Visible = false, Parent = now })
		local healthFill = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, Parent = healthTrack })
		---Feed the strip. info: sub, busy, health (base health fraction, nil outside a match),
		---figures = { { value, caption }, { value, caption } }.
		function UI.setNow(info)
			nowSub.Text = info.sub or ""
			nowDot.BackgroundColor3 = info.busy and UI.roles.Accent or UI.roles.Muted
			local figures = info.figures or {}
			statA.Text, captionA.Text = tostring(figures[1] and figures[1][1] or ""), tostring(figures[1] and figures[1][2] or "")
			statB.Text, captionB.Text = tostring(figures[2] and figures[2][1] or ""), tostring(figures[2] and figures[2][2] or "")
			healthTrack.Visible = info.health ~= nil
			if info.health then
				healthFill.Size = UDim2.fromScale(math.clamp(info.health, 0, 1), 1)
			end
		end

		-- The window moves by its top strip or by the name in the corner.
		do
			local dragging, dragStart, startPosition = false, nil, nil
			for _, handle in ipairs({ now, brand }) do
				handle.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging, dragStart, startPosition = true, input.Position, panel.Position
					end
				end)
			end
			table.insert(BeyRivals.connections, userInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local delta = input.Position - dragStart
					panel.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
				end
			end))
			table.insert(BeyRivals.connections, userInputService.InputEnded:Connect(function(input)
				if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
					dragging = false
					-- AbsolutePosition is measured under the top bar; the window ignores the inset.
					local inset = game:GetService("GuiService"):GetGuiInset()
					Config.WindowX = math.floor(panel.AbsolutePosition.X + inset.X)
					Config.WindowY = math.floor(panel.AbsolutePosition.Y + inset.Y)
				end
			end))
		end

		content = create("Frame", {
			Position = UDim2.fromOffset(SIDEBAR + 1, HEADER),
			Size = UDim2.new(1, -SIDEBAR - 1, 1, -HEADER),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = panel,
		})
	end

	local pages, tabButtons = {}, {}
	UI.pages, UI.tabButtons = pages, tabButtons

	local layoutOrder = 0
	function UI.nextOrder()
		layoutOrder += 1
		return layoutOrder
	end

	function UI.refreshAll()
		for _, refresh in ipairs(UI.refreshers) do
			pcall(refresh)
		end
	end

	---A card. side: "left", "right", "full" (above the columns) or "bottom" (under them).
	---note: one muted line under the title.
	local function newBox(page, title, side, note)
		local columns = UI.columns[page]
		if side ~= "left" and side ~= "right" and side ~= "full" and side ~= "bottom" then
			side = columns.height.left <= columns.height.right and "left" or "right"
		end
		local box = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = UI.roles.Main,
			BorderSizePixel = 0,
			LayoutOrder = UI.nextOrder(),
			Parent = columns[side],
		})
		round(box, 10)
		stroke(box, "Outline")
		local body = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Parent = box,
		}, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 12) }),
			create("UIPadding", { PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 16), PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }),
		})
		if columns.height[side] then
			columns.height[side] += 44
		end
		UI.current[page] = { body = body, side = side, box = box }
		if title and title ~= "" then
			-- (No list layout here: a "?" may be put beside the title.)
			local head = create("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = UI.nextOrder(), Parent = body })
			label({ Name = "Title", Size = UDim2.new(1, 0, 0, 20), Text = title, FontFace = CODE_BOLD, TextSize = px(16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = head })
			if note and note ~= "" then
				wrapped({ Position = UDim2.fromOffset(0, 23), Size = UDim2.new(1, 0, 0, 16), Text = note, TextSize = px(13), TextColor3 = UI.roles.Muted, Parent = head })
			end
			if columns.height[side] then
				columns.height[side] += 30
			end
		end
		return body
	end

	---Where the next control on this page goes (a new untitled card if none is open).
	local function slot(page, height)
		local current = UI.current[page] or { body = newBox(page) }
		current = UI.current[page]
		if UI.columns[page].height[current.side] then
			UI.columns[page].height[current.side] += (height or 24) + 12
		end
		return current.body
	end
	UI.slot = slot

	---A page. about: one or two sentences under its title. group: its heading in the page list.
	function UI.makePage(name, about, group)
		local page = create("ScrollingFrame", {
			Name = name,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = UI.roles.Outline,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = false,
			Parent = content,
		}, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 14) }),
			create("UIPadding", { PaddingTop = UDim.new(0, 18), PaddingBottom = UDim.new(0, GUTTER), PaddingLeft = UDim.new(0, GUTTER), PaddingRight = UDim.new(0, GUTTER) }),
		})
		local intro = create("Frame", { Name = "Intro", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = page }, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
		})
		label({ Size = UDim2.new(1, 0, 0, 28), Text = name, FontFace = CODE_BOLD, TextSize = px(22), LayoutOrder = 1, Parent = intro })
		if about and about ~= "" then
			wrapped({ Size = UDim2.new(1, 0, 0, 18), Text = about, TextSize = px(14), TextColor3 = UI.roles.Muted, LayoutOrder = 2, Parent = intro })
		end
		local full = create("Frame", { Name = "Full", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, Visible = false, Parent = page }, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 14) }),
		})
		full.ChildAdded:Connect(function()
			full.Visible = true
		end)
		local holder = create("Frame", { Name = "Columns", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = page })
		local function column(x)
			return create("Frame", {
				Position = UDim2.new(x, x == 0 and 0 or 7, 0, 0),
				Size = UDim2.new(0.5, -7, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Parent = holder,
			}, {
				create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 14) }),
				create("UIPadding", { PaddingBottom = UDim.new(0, 2), PaddingLeft = UDim.new(0, 1), PaddingRight = UDim.new(0, 1), PaddingTop = UDim.new(0, 1) }),
			})
		end
		local left, right = column(0), column(0.5)
		local bottom = create("Frame", { Name = "Bottom", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 4, Visible = false, Parent = page }, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 14) }),
		})
		bottom.ChildAdded:Connect(function()
			bottom.Visible = true
		end)
		UI.columns[page] = { left = left, right = right, full = full, bottom = bottom, intro = intro, height = { left = 0, right = 0 } }
		-- Custom rows that a script parents straight to the page land in the open card.
		page.ChildAdded:Connect(function(child)
			if child ~= intro and child ~= full and child ~= holder and child ~= bottom and child:IsA("GuiObject") then
				task.defer(function()
					if child.Parent == page then
						child.Parent = slot(page, child.AbsoluteSize.Y > 0 and child.AbsoluteSize.Y or 24)
					end
				end)
			end
		end)
		pages[name] = page
		table.insert(UI.order, name)
		UI.groups[name] = group or "More"
		return page
	end

	function UI.selectTab(name)
		if not pages[name] then
			return
		end
		for pageName, page in pairs(pages) do
			page.Visible = pageName == name
		end
		for buttonName, tabButton in pairs(tabButtons) do
			local active = buttonName == name
			tabButton.BackgroundColor3 = UI.roles.Main
			tabButton.BackgroundTransparency = active and 0 or 1
			tabButton.TextColor3 = active and UI.roles.Font or UI.roles.Muted
			tabButton.FontFace = active and CODE_BOLD or CODE_MEDIUM
			local bar = tabButton:FindFirstChild("Bar")
			if bar then
				bar.BackgroundColor3 = UI.roles.Accent
				bar.Visible = active
			end
		end
		UI.activeTab = name
		UI.showTip(nil)
	end

	function UI.makeTab(name, order)
		local tabButton = create("TextButton", {
			Name = name,
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = UI.roles.Main,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			FontFace = CODE_MEDIUM,
			Text = name,
			TextSize = px(15),
			TextColor3 = UI.roles.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			LayoutOrder = order or 0,
			Parent = tabBar,
		}, { create("UIPadding", { PaddingLeft = UDim.new(0, 14) }) })
		round(tabButton, 7)
		local bar = create("Frame", { Name = "Bar", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -8, 0.5, 0), Size = UDim2.fromOffset(3, 14), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, Visible = false, Parent = tabButton })
		round(bar, 2)
		tabButtons[name] = tabButton
		tabButton.MouseEnter:Connect(function()
			if UI.activeTab ~= name then
				tabButton.TextColor3 = UI.roles.Font
			end
		end)
		tabButton.MouseLeave:Connect(function()
			if UI.activeTab ~= name then
				tabButton.TextColor3 = UI.roles.Muted
