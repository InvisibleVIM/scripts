---Discord webhook: one embed per finished match, built from the parts switched on in Misc.
---The URL is the user's own; nothing but the match and session numbers below is sent.
function AA.sendWebhook(entry, test)
	local url = Config.Webhook
	if not test and not Config.WebhookOn then
		return false, "Webhooks are off"
	end
	if type(url) ~= "string" or not url:match("^https://[%w%.]*discord[%w%.]*/api/webhooks/") then
		return false, "Paste a Discord webhook URL"
	end
	if not request then
		return false, "This executor has no request()"
	end
	local session = AA.session()
	local fields = {}
	local function field(name, value)
		table.insert(fields, { name = name, value = tostring(value), inline = true })
	end
	if Config.WhMap then
		local level = entry.level and Levels and Levels[entry.level]
		local world = level and level.world and Worlds and Worlds[level.world]
		field("Map", world and world.name or entry.level or "?")
	end
	if Config.WhMode then
		field("Mode", entry.mode or "?")
	end
	if Config.WhAct then
		field("Act and difficulty", tostring(entry.name or "?") .. ", " .. tostring(entry.difficulty or "no difficulty"))
	end
	if Config.WhTime then
		field("Completion time", AA.clock(entry.time or 0))
	end
	if Config.WhRecord then
		field("Wins and losses", session.wins .. " wins, " .. session.losses .. " losses")
	end
	if Config.WhSession then
		field("Session time", AA.clock(session.seconds))
	end
	if Config.WhModeRecord then
		local record = session.modes[tostring(entry.mode or "?")] or { w = 0, l = 0 }
		field(tostring(entry.mode or "Mode") .. " record", record.w .. " wins, " .. record.l .. " losses")
	end
	if Config.WhChallengeRecord then
		field("Challenge record", session.challenge.w .. " wins, " .. session.challenge.l .. " losses")
	end
	if Config.WhTimers then
		local half, daily = AA.challengeTimers()
		field("Next challenge", AA.clock(half))
		field("Next Daily", AA.clock(daily))
	end
	local id = tostring(Config.DiscordId or ""):match("^%d+$")
	local body = {
		content = (Config.WebhookPing and id) and ("<@" .. id .. ">") or nil,
		embeds = { {
			title = test and "Test message" or ((entry.won and "Win" or (entry.left and "Left" or "Loss")) .. (entry.wave and (" at wave " .. tostring(entry.wave)) or "")),
			description = entry.gems and ("+" .. entry.gems .. " gems") or nil,
			color = test and 15905597 or (entry.won and 4637822 or 15026253),
			fields = fields,
			footer = { text = "Potent Hub, Anime Adventures" },
		} },
	}
	task.spawn(pcall, request, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = httpService:JSONEncode(body) })
	return true, "Sent"
end

local function logMatch(entry)
	table.insert(MatchLog, entry)
