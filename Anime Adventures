---Gems earned and gems per hour over the last 30 logged matches (the script restarts with every
---teleport, so the running numbers come from the log).
function AA.refreshRates()
	local total, first, last, count = 0, nil, nil, 0
	for index = #MatchLog, math.max(1, #MatchLog - 29), -1 do
		local entry = MatchLog[index]
		if type(entry) == "table" and entry.gems and entry.at then
			total += entry.gems
			count += 1
			last = last or entry.at
			first = entry.at - (entry.time or 0)
		end
	end
	Stats.gems, Stats.rateMatches = total, count
	Stats.gemRate = (count > 0 and last - first > 120) and math.floor(total / ((last - first) / 3600)) or nil
end
