	---Pick one of a few big options, each with a line of what it does and three gauges.
	---choices: { { value, title, text, gauges = { { name, level 1-3 }, ... } } }.
	function UI.choiceCards(page, key, choices, onChange)
		local row = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = UI.nextOrder(), Parent = slot(page, 150) }, {
			create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), HorizontalFlex = Enum.UIFlexAlignment.Fill, ItemLineAlignment = Enum.ItemLineAlignment.Stretch }),
		})
		UI.lastRow[page] = nil
		local cards = {}
		local function refresh()
			for value, card in pairs(cards) do
				local active = Config[key] == value
				card.ring.Color = active and UI.roles.Accent or UI.roles.Outline
				card.ring.Thickness = active and 2 or 1
				card.frame.BackgroundColor3 = active and UI.roles.Control or UI.roles.Main
				card.title.TextColor3 = UI.roles.Font
				card.text.TextColor3 = active and UI.roles.Font or UI.roles.Muted
				card.tag.Visible = active
				card.tag.BackgroundColor3, card.tag.TextColor3 = UI.roles.Accent, UI.onAccent()
				for _, pip in ipairs(card.pips) do
					pip.frame.BackgroundColor3 = pip.on and (active and UI.roles.Accent or UI.roles.Muted) or UI.roles.Raised
				end
			end
		end
		for index, choice in ipairs(choices) do
			local frame = create("TextButton", { Size = UDim2.new(0, 100, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UI.roles.Main, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = index, Parent = row }, {
				create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
				create("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }),
			})
			frame:SetAttribute("NoTheme", true)
			round(frame, 10)
			local ring = create("UIStroke", { Color = UI.roles.Outline, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame })
			ring:SetAttribute("NoTheme", true)
			local head = create("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = 1, Parent = frame })
			local title = label({ Size = UDim2.new(1, -58, 1, 0), Text = choice.title, FontFace = CODE_BOLD, TextSize = px(17), TextTruncate = Enum.TextTruncate.AtEnd, Parent = head })
			local tag = label({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(52, 20), Text = "Active", FontFace = CODE_BOLD, TextSize = px(12), TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0, Visible = false, Parent = head })
			tag.BackgroundTransparency = 0
			tag:SetAttribute("NoTheme", true)
			round(tag, 10)
			local text = wrapped({ Size = UDim2.new(1, 0, 0, px(13) * 1.2 * 3 + 1), Text = choice.text, TextSize = px(13), TextColor3 = UI.roles.Muted, LayoutOrder = 2, Parent = frame })
			text:SetAttribute("NoTheme", true)
			local pips = {}
			local gauges = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = frame }, {
				create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5) }),
			})
			for gaugeIndex, gauge in ipairs(choice.gauges or {}) do
				local line = create("Frame", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, LayoutOrder = gaugeIndex, Parent = gauges })
				label({ Size = UDim2.new(1, -86, 1, 0), Text = gauge[1], TextSize = px(13), TextColor3 = UI.roles.Muted, TextTruncate = Enum.TextTruncate.AtEnd, Parent = line })
				for step = 1, 3 do
					local pip = create("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -(3 - step) * 27, 0.5, 0), Size = UDim2.fromOffset(23, 5), BackgroundColor3 = UI.roles.Raised, BorderSizePixel = 0, Parent = line })
					pip:SetAttribute("NoTheme", true)
					round(pip, 3)
					table.insert(pips, { frame = pip, on = step <= gauge[2] })
				end
			end
			cards[choice.value] = { frame = frame, ring = ring, title = title, text = text, tag = tag, pips = pips }
			frame.MouseEnter:Connect(function()
				if Config[key] ~= choice.value then
					ring.Color = UI.roles.Muted
				end
			end)
			frame.MouseLeave:Connect(function()
				refresh()
			end)
			frame.MouseButton1Click:Connect(function()
				Config[key] = choice.value
				if onChange then
					pcall(onChange, choice.value)
				end
				UI.refreshAll()
			end)
		end
		table.insert(UI.refreshers, refresh)
		table.insert(UI.colorRefreshers, refresh)
		refresh()
		return row
	end

	---A list the user edits: one row per entry with a remove button, and an up arrow when the
	---order matters. options:
	---  get() -> names           remove(index, name)        moveUp(index)      ordered, empty
	---  marks(name, index) -> a muted word at the right; a second result of true paints it in the accent
	---  tag(name, index) -> text, tone ("bad" | "good" | "accent"): a small label before the buttons
	---  detail(name, index) -> a wrapped line under the name
	---  maxHeight -> past this height the list scrolls inside its own frame
	function UI.editList(page, options)
		local scrolls = options.maxHeight ~= nil
		local holder = create(scrolls and "ScrollingFrame" or "Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = scrolls and Enum.AutomaticSize.None or Enum.AutomaticSize.Y, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = UI.nextOrder(), Parent = slot(page, 60) })
		local layout = create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = holder })
		if scrolls then
			holder.ScrollBarThickness = 4
			holder.ScrollBarImageColor3 = UI.roles.Outline
			holder.ScrollingDirection = Enum.ScrollingDirection.Y
			holder.CanvasSize = UDim2.new()
			local pad = create("UIPadding", { Parent = holder })
			local function fit()
				local content = layout.AbsoluteContentSize.Y
				holder.Size = UDim2.new(1, 0, 0, math.min(content, options.maxHeight))
				holder.CanvasSize = UDim2.fromOffset(0, content)
				pad.PaddingRight = UDim.new(0, content > options.maxHeight and 8 or 0)
			end
			layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fit)
			fit()
		end
		UI.lastRow[page] = nil
		local signature
		local function smallButton(parent, kind, order, action)
			local button = create("TextButton", { Size = UDim2.fromOffset(24, 24), BackgroundColor3 = UI.roles.Raised, BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = order, Parent = parent })
			round(button, 6)
			local mark = icon(button, kind, 10, UI.roles.Muted, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
			button.MouseEnter:Connect(function()
				button.BackgroundTransparency = 0
				UI.tint(mark, UI.roles.Font)
			end)
			button.MouseLeave:Connect(function()
				button.BackgroundTransparency = 1
				UI.tint(mark, UI.roles.Muted)
			end)
			button.MouseButton1Click:Connect(action)
			return button
		end
		local function refresh()
			local names = options.get()
			local rows, parts = {}, { UI.roles.Accent:ToHex(), UI.roles.Font:ToHex() }
			for index, name in ipairs(names) do
				local row = { name = name }
				if options.marks then
					row.mark, row.markAccent = options.marks(name, index)
				end
				if options.tag then
					row.tag, row.tone = options.tag(name, index)
				end
				if options.detail then
					row.detail = options.detail(name, index)
				end
				rows[index] = row
				table.insert(parts, table.concat({ name, tostring(row.mark), tostring(row.markAccent), tostring(row.tag), tostring(row.detail) }, "~"))
			end
			local now = table.concat(parts, "|")
			if now == signature then
				return
			end
			signature = now
			for _, child in ipairs(holder:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			if #names == 0 then
				wrapped({ Size = UDim2.new(1, 0, 0, 16), Text = options.empty or "Nothing here yet.", TextSize = px(13), TextColor3 = UI.roles.Muted, LayoutOrder = 1, Parent = holder })
				return
			end
			for index, row in ipairs(rows) do
				local line = create("Frame", { Size = UDim2.new(1, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UI.roles.Control, BorderSizePixel = 0, LayoutOrder = index, Parent = holder }, {
					create("UICorner", { CornerRadius = UDim.new(0, 6) }),
					create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
				})
				local top = create("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = 1, Parent = line }, {
					create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 3) }),
					create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
				})
				if options.ordered then
					label({ Size = UDim2.fromOffset(18, 30), Text = tostring(index), FontFace = CODE_BOLD, TextSize = px(13), TextColor3 = UI.roles.Accent, LayoutOrder = 1, Parent = top })
				end
				local nameLabel = label({ Size = UDim2.new(0, 0, 1, 0), Text = row.name, TextSize = px(14), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 2, Parent = top })
				create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = nameLabel })
				if row.tag and row.tag ~= "" then
					-- Red for a curse, green for a blessing, pulled toward the text color so it
					-- reads on any theme. The word says it too.
					local tone = row.tone == "bad" and Color3.fromRGB(235, 87, 87) or row.tone == "good" and Color3.fromRGB(72, 199, 142) or row.tone == "accent" and UI.roles.Accent or UI.roles.Muted
					local pill = create("Frame", { Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = UI.roles.Raised, BorderSizePixel = 0, LayoutOrder = 3, Parent = top }, {
						create("UICorner", { CornerRadius = UDim.new(0, 5) }),
						create("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }),
					})
					pill:SetAttribute("NoTheme", true)
					label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = row.tag, FontFace = CODE_BOLD, TextSize = px(12), TextColor3 = (row.tone == "bad" or row.tone == "good") and tone:Lerp(UI.roles.Font, 0.2) or tone, Parent = pill })
				end
				if row.mark and row.mark ~= "" then
					local markLabel = label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = row.mark, FontFace = row.markAccent and CODE_BOLD or CODE, TextSize = px(12), TextColor3 = row.markAccent and UI.roles.Accent or UI.roles.Muted, LayoutOrder = 4, Parent = top })
					if row.markAccent then
						markLabel:SetAttribute("NoTheme", true)
					end
				end
				if options.ordered and index > 1 then
					smallButton(top, "up", 5, function()
						options.moveUp(index)
						UI.refreshAll()
					end)
				end
				smallButton(top, "cross", 6, function()
					options.remove(index, row.name)
					UI.refreshAll()
				end)
				if row.detail and row.detail ~= "" then
					local under = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, Parent = line }, {
						create("UIPadding", { PaddingLeft = UDim.new(0, options.ordered and 34 or 10), PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 8) }),
					})
					wrapped({ Size = UDim2.new(1, 0, 0, 16), Text = row.detail, TextSize = px(13), TextColor3 = UI.roles.Muted, Parent = under })
				end
			end
		end
		table.insert(UI.refreshers, refresh)
		table.insert(UI.colorRefreshers, function()
			signature = nil
			refresh()
		end)
		refresh()
		return refresh, holder
	end

	-- The script's own notices, in the menu's typeface (Roblox's notification box uses the
	-- client's font). They stack in the bottom right corner and leave on their own.
	function UI.toast(title, text, seconds)
		if Config.MuteNotifications then
			return
		end
		local stack = UI.toastStack
		if not stack then
			stack = create("Frame", { Name = "PotentToasts", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 150, Parent = screenGui }, {
				create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Bottom }),
			})
			UI.toastStack = stack
		end
		local toast = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UI.roles.Main, BorderSizePixel = 0, LayoutOrder = UI.nextOrder(), ZIndex = 150, Parent = stack }, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }),
			create("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }),
		})
		round(toast, 10)
		stroke(toast, "Outline")
		label({ Size = UDim2.new(1, 0, 0, 20), Text = title, FontFace = CODE_BOLD, TextSize = px(15), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1, ZIndex = 151, Parent = toast })
		wrapped({ Size = UDim2.new(1, 0, 0, 16), Text = text, TextSize = px(14), TextColor3 = UI.roles.Muted, LayoutOrder = 2, ZIndex = 151, Parent = toast })
		task.delay(seconds or 5, function()
			toast:Destroy()
		end)
		return toast
	end

