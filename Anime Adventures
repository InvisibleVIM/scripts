			label({ Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -24, 0, 18), Text = name, TextSize = 13, TextColor3 = UI.roles.Muted, TextTruncate = Enum.TextTruncate.AtEnd, Parent = tile })
