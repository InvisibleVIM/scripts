				local name = nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
				if name == "" then
					return "Name it first"
				end
				if IS_LOBBY then
					return "Start it in a match"
				end
				AA.Macro.start(name)
				return "Recording"
			end)
			recordLine = UI.note(page, "Not recording.")
			heading(page, "Play a recording", "right", "The recorded steps replace the script's own placing and upgrading, each waiting for its wave and its cash. Buffs, targeting and cards still run.")
			UI.dropdown(page, "Recording", function()
				local names = AA.Macro.list()
