AA.bestSpot = bestSpot
AA.test = { copyPower = copyPower, planAction = planAction, unitPower = unitPower, claimRewards = claimRewards, summonStep = summonStep, joinGame = joinGame, chooseTarget = chooseTarget, equipBest = equipBest, useAbilities = useAbilities, invoke = invoke, scanField = scanField, spawnCost = spawnCost, upgradeCost = upgradeCost, statMul = statMul, enemyState = enemyState, pathProgress = pathProgress, equippedUnits = equippedUnits, matchKind = matchKind, gameCall = gameCall }
AA.Stats = Stats
