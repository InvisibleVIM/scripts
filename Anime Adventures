	-- Theme registry: every element remembers which theme role each of its colors belongs to
	-- (decided once, when it is created), so recoloring never confuses two roles that happen to
	-- share a color. Elements built by the scripts themselves are classified the same way.
	local PROPERTIES = { "BackgroundColor3", "TextColor3", "Color", "ScrollBarImageColor3", "PlaceholderColor3", "ImageColor3" }
	local ROLE_ORDER = { "Accent", "Font", "Muted", "Outline", "Raised", "Control", "Main", "Background" }
	-- Strong keys on purpose: Instance proxies in a weak table get collected while the
	-- instance still exists, which silently drops them from the theme.
	local painted = {}
	UI.painted = painted
	local function same(a, b)
		return math.abs(a.R - b.R) < 0.004 and math.abs(a.G - b.G) < 0.004 and math.abs(a.B - b.B) < 0.004
	end
	function UI.classify(object)
		if painted[object] ~= nil or object:GetAttribute("NoTheme") or (object.Parent and object.Parent:GetAttribute("NoTheme")) then
			return
		end
		local entry = nil
		for _, property in ipairs(PROPERTIES) do
			local ok, value = pcall(function()
				return object[property]
			end)
			if ok and typeof(value) == "Color3" then
				for _, role in ipairs(ROLE_ORDER) do
					if same(value, UI.roles[role]) then
						entry = entry or {}
						entry[property] = role
						break
					end
				end
			end
		end
		painted[object] = entry or false
	end

	function UI.applyTheme()
		UI.roles = computeRoles()
		syncConstants()
		for object, entry in pairs(painted) do
			if not object.Parent then
				painted[object] = nil
			elseif entry then
				for property, role in pairs(entry) do
					pcall(function()
						object[property] = UI.roles[role]
					end)
				end
			end
		end
		UI.refreshAll()
		for _, refresh in ipairs(UI.colorRefreshers) do
			pcall(refresh)
		end
		if UI.activeTab then
			UI.selectTab(UI.activeTab)
		end
	end

