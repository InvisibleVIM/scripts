							end
						end
					end
					for _, entry in ipairs(ok and list or {}) do
						local banner = type(Banners[entry.banner]) == "table" and Banners[entry.banner] or {}
						local cost = nil
						if type(banner.resource_cost) == "table" and banner.resource_cost.amount then
							cost = ("%s %s"):format(tostring(banner.resource_cost.amount), AA.spaced(banner.resource_cost.id))
