			do
				local function nameOf(id)
					return tostring(Units[id] and Units[id].name or id)
				end
				local function teamIds()
					local ids = {}
					for _, entry in ipairs(equippedUnits()) do
						table.insert(ids, entry.id)
					end
					return ids
				end
				local setupLine
				local showList = function() end
				---The steps as the list shows them.
				local function stepNames()
					local names = {}
					for _, step in ipairs(AA.Order.steps()) do
						table.insert(names, (step.kind == "place" and "Place " or "Upgrade ") .. nameOf(step.unit))
					end
					return names
				end
				---Why a list of steps cannot be followed, or nil: the first step places a unit, and a
				---unit is placed before it is upgraded.
				local function orderProblem(steps)
					local placed = {}
					for index, step in ipairs(steps) do
						if step.kind == "place" then
							placed[step.unit] = true
						elseif index == 1 then
							return "The first step has to place a unit."
						elseif not placed[step.unit] then
							return nameOf(step.unit) .. " has to be placed before it is upgraded."
						end
					end
					return nil
				end
				---Save an edited list, unless it could not be followed.
				local function applySteps(steps)
					local problem = orderProblem(steps)
					if problem then
						UI.toast("Build order", problem, 6)
						return false
					end
					AA.Order.set(steps)
					return true
				end
				heading(page, "Build order", "left", "The script does exactly the next step, saving up for it when it has to. After the last step it plays on by its own judgement.")
