		task.defer(fillList)

		-- Player loop: next song at the end, skip files that won't load, keep the game's music
		-- quiet, and give way to the script's own music mode (if it has one).
		task.spawn(function()
			local wasOn, otherWas = false, Config.MusicOn
			-- The window is parented at the end of finish(); wait for it before watching it.
			local waited = os.clock()
			while not screenGui.Parent and os.clock() - waited < 15 do
				task.wait(0.2)
			end
			while screenGui.Parent do
				pcall(function()
					if Config.MusicOn ~= nil and Config.MusicOn ~= otherWas then
						otherWas = Config.MusicOn
						if Config.MusicOn and Config.MyMusicOn then
							Config.MyMusicOn = false
							for _, refresh in ipairs(UI.refreshers) do
								pcall(refresh)
							end
						end
					end
					if Config.MyMusicOn and not wasOn and Config.MusicOn then
						Config.MusicOn, otherWas = false, false
						for _, refresh in ipairs(UI.refreshers) do
							pcall(refresh)
						end
					end
					local sound = Player.sound
					if Config.MyMusicOn then
						if not wasOn then
							wasOn = true
							if not Player.current then
								Player.start(Player.visible())
							elseif sound and Player.paused == false then
								sound:Resume()
							end
						end
						if sound then
							sound.Volume = (Config.MyMusicVolume or 50) / 100
							if not Player.paused and not sound.IsLoaded and os.clock() - (Player.startedAt or 0) > 12 then
								Player.next(1)
							elseif not Player.paused and sound.IsLoaded and not sound.IsPlaying and os.clock() - (Player.startedAt or 0) > 3 then
								Player.next(1)
							end
						end
						Player.muteGame(Config.MyMusicMuteGame and sound ~= nil and sound.IsPlaying)
						local current = Player.current
						if current and sound then
							nowLine.Text = (Player.paused and "Paused: " or "Now: ") .. current.title .. (current.artist ~= "" and (" - " .. current.artist) or "") .. "\n" .. clock(sound.TimePosition) .. " / " .. clock(sound.TimeLength) .. "   " .. current.playlist .. ((Config.MyMusicShuffle and "   shuffle") or "")
						else
							nowLine.Text = Player.status or "No songs found"
						end
					else
						if wasOn then
							wasOn = false
							if sound then
								sound:Pause()
							end
							Player.muteGame(false)
							Player.highlight()
						end
						nowLine.Text = Player.current and ("Off  (last: " .. Player.current.title .. ")") or "Off"
					end
				end)
				task.wait(0.5)
			end
			Player.muteGame(false)
			if Player.sound then
				Player.sound:Destroy()
			end
		end)
	end
	end)()

	---Last step of every script: Misc tab settings, tabs, menu key, anti-AFK, hide on execute.
	function UI.finish(firstTab)
		UI.musicSection(pages.Music or UI.makePage("Music"))
		local page = pages.Misc or UI.makePage("Misc")
		UI.heading(page, "Menu", "right")
		UI.current[page].body.Parent.LayoutOrder = -100 -- top of the right column
		UI.toggle(page, "Anti-AFK", "AntiAfk")
		UI.keybind(page, "Menu bind", "MenuKey")
		UI.toggle(page, "Hide UI when executed", "HideOnExecute")
		UI.toggle(page, "Mute notifications", "MuteNotifications")
		local unload = UI.button(page, "Unload", nil)
		UI.themeSection(pages.Themes or UI.makePage("Themes"))
		-- Misc goes last.
		for index, name in ipairs(UI.order) do
			if name == "Misc" then
				table.remove(UI.order, index)
				break
			end
		end
		table.insert(UI.order, "Misc")
		-- Fixed order: each tab's LayoutOrder is its place in the list (ties let the layout shuffle them).
		for index, name in ipairs(UI.order) do
			UI.makeTab(name, index)
		end

		screenGui.Parent = guiParent
		for _, object in ipairs(screenGui:GetDescendants()) do
			pcall(UI.fitText, object)
			pcall(UI.classify, object)
		end
		UI.selectTab(firstTab or UI.order[1])
		panel.Visible = not Config.HideOnExecute

		table.insert(AA.connections, userInputService.InputBegan:Connect(function(input)
			if UI.capturing or userInputService:GetFocusedTextBox() then
				return
			end
			if input.KeyCode.Name == Config.MenuKey then
				panel.Visible = not panel.Visible
			end
		end))
		if Config.HideOnExecute and not Config.MuteNotifications then
			pcall(function()
				game:GetService("StarterGui"):SetCore("SendNotification", {
					Title = "Potent Hub",
					Text = "Anime Adventures loaded. " .. tostring(Config.MenuKey) .. " opens the menu.",
					Duration = 5,
				})
			end)
		end
		return unload
	end
end

