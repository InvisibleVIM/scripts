			view.banners = UI.list(page)
			hint(page, "Beside each banner: what one pull costs. Beside each unit: the chance on a single pull, which is the banner's Mythic rate times that unit's share of Mythic pulls (1% x 25% = 1 in 400). The marked unit holds the banner's middle slot. A tick means you own it.")
			task.spawn(function()
				while AA.alive and page.Parent do
					local ok, list, at = pcall(AA.bannerFeatured)
					local rows = {}
					local owned = {}
					for _, unit in pairs(collectionData().owned_units or {}) do
						if type(unit) == "table" and unit.unit_id then
							owned[unit.unit_id] = true
