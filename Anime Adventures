---Run a loop forever: if it errors, note why and restart it.
local function supervise(name, loop)
	task.spawn(function()
		while AA.alive do
			local ok, err = pcall(loop)
			setthreadidentity(8)
			if not ok then
				AA.errors[name] = tostring(err)
