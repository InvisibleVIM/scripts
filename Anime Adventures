---The tower a summon belongs to (nil for anything that isn't a summon).
local function summonOwner(unit)
	local parent = unit._stats:FindFirstChild("parent_unit")
	local value = parent and parent.Value
	if typeof(value) == "Instance" then
		return value
	end
	-- Older builds only tag the owner's collection uuid: find my tower with the same one.
	local uuid = unit._stats:FindFirstChild("uuid")
	for _, tower in ipairs(scanField().towers) do
		local towerUuid = tower._stats:FindFirstChild("uuid")
		if uuid and towerUuid and towerUuid.Value == uuid.Value then
			return tower
		end
	end
	return nil
end

---Ground every tower stands on (mine and other players'), plus spots I asked for a moment ago.
local function placedUnitPositions()
	local list = {}
	local field = scanField()
	for _, group in ipairs({ field.towers, field.others }) do
		for _, unit in ipairs(group) do
			table.insert(list, unit:GetPivot().Position)
		end
	end
	for _, spot in ipairs(Match.recent or {}) do
		if os.clock() - spot.at < 4 then
			table.insert(list, spot.position)
		end
	end
	return list
end

---Stats of a unit at an upgrade level: upgrade entries override the base stats.
local function unitStatsAt(data, level)
	local result = {
		damage = data.damage or 0,
		cooldown = data.attack_cooldown or data.cooldown or 1,
		range = data.range or 0,
		farm = data.farm_amount or 0,
	}
	for i = 1, level do
		local up = data.upgrade and data.upgrade[i]
		if up then
			result.damage = up.damage or result.damage
			result.cooldown = up.attack_cooldown or up.cooldown or result.cooldown
			result.range = up.range or result.range
			result.farm = up.farm_amount or result.farm
		end
	end
	result.dps = result.damage / math.max(result.cooldown, 0.1)
	return result
end

-- The enemy path: every lane's numbered nodes under the pve base, sampled every stud.
local function buildPath()
	local points = {}
	local bases = workspace:FindFirstChild("_BASES")
	local lanes = bases and bases:FindFirstChild("pve") and bases.pve:FindFirstChild("LANES")
	local laneCount = 0
	local laneList = lanes and lanes:GetChildren() or {}
	table.sort(laneList, function(a, b)
		return (tonumber(a.Name) or math.huge) < (tonumber(b.Name) or math.huge)
	end)
	Match.laneNames = {}
	for _, lane in ipairs(laneList) do
		-- The game's own path (PathService._setup_lane): "spawn", then the numbered bends, then
		-- "final". Only the numbered bends used to be read, so every road was missing its first
		-- and last stretch, and on maps whose roads share only that last stretch (Sky Island:
		-- three roads, one base) an enemy at "99%" still had the walk to the base ahead of it.
		-- "boss1" is a mock lane the game hides.
		if lane.Name == "boss1" then
			continue
		end
		laneCount += 1
		Match.laneNames[laneCount] = lane.Name
		local nodes = {}
		for _, node in ipairs(lane:GetChildren()) do
			if tonumber(node.Name) and node:IsA("BasePart") then
				table.insert(nodes, node)
			end
		end
		table.sort(nodes, function(a, b)
			return tonumber(a.Name) < tonumber(b.Name)
		end)
		local first, last = lane:FindFirstChild("spawn"), lane:FindFirstChild("final")
		if first and first:IsA("BasePart") then
			table.insert(nodes, 1, first)
		end
		if last and last:IsA("BasePart") then
			table.insert(nodes, last)
		end
		local total = 0
		for i = 2, #nodes do
			total += (nodes[i].Position - nodes[i - 1].Position).Magnitude
		end
		local walked = 0
		for i = 2, #nodes do
			local a, b = nodes[i - 1].Position, nodes[i].Position
			local length = (b - a).Magnitude
			local steps = math.max(1, math.floor(length))
			for s = 0, steps - 1 do
				local t = s / steps
				table.insert(points, { position = a:Lerp(b, t), progress = (walked + length * t) / math.max(total, 1), lane = laneCount })
			end
			walked += length
		end
	end
	Match.pathPoints = points
	-- Grid index: "how far down the road is this position" is asked for every enemy on every tick.
	local grid = {}
	for index, point in ipairs(points) do
		local key = math.floor(point.position.X / 8) * 8192 + math.floor(point.position.Z / 8)
		local cell = grid[key]
		if not cell then
			cell = {}
			grid[key] = cell
		end
		table.insert(cell, index)
	end
	Match.pathGrid = grid
	-- Maps with two or three roads (Shibuya): the roads start apart, cross or run side by side
	-- on the way and share the last stretch to the base. A unit at one spawn never sees the
	-- other road's enemies, so the kill zone of such a map is the first place the roads meet.
	-- laneJunction[lane] = how far down that road it first comes within 12 studs of another one
	-- (nil when they only meet at the base end, or share their start).
	Match.laneCount = laneCount
	Match.laneJunction = {}
	if laneCount > 1 then
		for _, point in ipairs(points) do
			local known = Match.laneJunction[point.lane]
			if point.progress > 0.03 and point.progress < 0.7 and (not known or point.progress < known) then
				local px, pz = point.position.X, point.position.Z
				local met = false
				for cx = math.floor((px - 12) / 8), math.floor((px + 12) / 8) do
					for cz = math.floor((pz - 12) / 8), math.floor((pz + 12) / 8) do
						for _, index in ipairs(grid[cx * 8192 + cz] or {}) do
							local other = points[index]
							if other.lane ~= point.lane then
								local dx, dz = other.position.X - px, other.position.Z - pz
								if dx * dx + dz * dz <= 144 then
									met = true
								end
							end
						end
					end
				end
				if met then
					Match.laneJunction[point.lane] = point.progress
				end
			end
		end
	end
	return points
end
---The world whose daily kill mission is active and unfinished ("Defeat 2500 Curses": 500 gems
---and that world's evolution items every day). Returns the world id, kills done, kills needed.
function AA.dailyKillQuest(forLevel)
	local handler = profile().quest_handler
	local best
	local onlyWorld
	if forLevel then
		-- Only the mission of the world this level belongs to.
		for worldId, world in pairs(Worlds) do
			if type(world) == "table" then
				if world.infinite and world.infinite.id == forLevel then
					onlyWorld = worldId
				end
				for _, entry in pairs(type(world.levels) == "table" and world.levels or {}) do
					if type(entry) == "table" and entry.id == forLevel then
						onlyWorld = worldId
					end
				end
			end
		end
		if not onlyWorld then
			return nil
		end
	end
	for _, quest in pairs(type(handler) == "table" and type(handler.quests) == "table" and handler.quests or {}) do
		local info = type(quest) == "table" and quest.quest_info
		local id = type(info) == "table" and tostring(info.id or "") or ""
		local worldId = id:match("^(.-)_daily$")
		local class = type(info) == "table" and info.quest_class
		if worldId and type(class) == "table" and tostring(class.class):find("kill") then
			local need = tonumber(class.amount) or 2500
			local have = type(quest.quest_progress) == "table" and tonumber(quest.quest_progress.amount) or 0
			local world = Worlds[worldId]
			if have < need and world and world.infinite and world.infinite.id and (not onlyWorld or onlyWorld == worldId) then
				-- Several open at once: always the same one first (pairs order changes).
				if not best or worldId < best.world then
					best = { world = worldId, have = have, need = need, level = world.infinite.id }
				end
			end
		end
	end
	if best then
		return best.world, best.have, best.need, best.level
	end
	return nil
end

---Every portal item in the inventory: { uuid, id, name, tries, left, made }.
---Charms: one can be worn at a time (GameplaySettings.MAX_EQUIPPED_CHARMS = 1) and each rolls its
---own bonuses (_unique_charm_data._d = { { _t = "unit_damage", _d = 0.13 }, { _t = "reward_mul",
---_d = 0.16 } }, _e set while worn). Returns the best one for the chosen goal and the worn one.
function AA.charmBest()
	local unique = (profile().inventory or {}).unique_items
	local best, worn
	for _, item in pairs(type(unique) == "table" and unique or {}) do
		local charm = type(item) == "table" and type(item._unique_item_data) == "table" and item._unique_item_data._unique_charm_data
		if type(charm) == "table" and type(item.uuid) == "string" then
			local score = 0
			for _, bonus in pairs(type(charm._d) == "table" and charm._d or {}) do
				local kind, weight = tostring(type(bonus) == "table" and bonus._t or ""), 1
				if Config.CharmPick == "Damage" then
					weight = kind:find("damage", 1, true) and 1 or 0.01
				elseif Config.CharmPick == "Rewards" then
					weight = kind:find("reward", 1, true) and 1 or 0.01
				end
				score += (type(bonus) == "table" and tonumber(bonus._d) or 0) * weight
			end
			local entry = { uuid = item.uuid, id = tostring(item.item_id), score = score }
			if charm._e ~= nil then
				worn = entry
			end
			if not best or score > best.score then
				best = entry
			end
		end
	end
	return best, worn
end
---Wear the best charm owned (lobby). A new drop that beats the worn one replaces it.
function AA.charmStep()
	if Config.CharmPick == "Off" then
		return
	end
	local best, worn = AA.charmBest()
	if not best or (worn and best.score <= worn.score + 1e-6) then
		return
	end
	-- One try per charm every ten minutes, in case the server says no.
	if AA.charmTried == best.uuid and os.clock() - (AA.charmTriedAt or 0) < 600 then
		return
	end
	AA.charmTried, AA.charmTriedAt = best.uuid, os.clock()
	if worn then
		invoke("request_unequip_charm", worn.uuid)
		task.wait(0.5)
	end
	invoke("use_unique_item", best.uuid)
end

function AA.portalItems()
	local list = {}
	local unique = (profile().inventory or {}).unique_items
	for _, item in pairs(type(unique) == "table" and unique or {}) do
		local itemId = type(item) == "table" and tostring(item.item_id or "") or ""
		if itemId:lower():find("portal", 1, true) and type(item.uuid) == "string" then
			local extra = type(item._unique_item_data) == "table" and item._unique_item_data or {}
			local tries, max = tonumber(extra._portal_tries) or 0, tonumber(extra._portal_max_tries) or 1
			if not AA.portalNames then
				AA.portalNames = {}
			end
			if AA.portalNames[itemId] == nil then
				local ok, data = pcall(function()
					return gameRequire(replicatedStorage.src.Data.Items)[itemId]
				end)
				local static = ok and type(data) == "table" and data.static_portal_copy_to_level_params
				AA.portalNames[itemId] = { name = ok and type(data) == "table" and data.name or itemId, group = type(static) == "table" and static.portal_group or nil, level = type(static) == "table" and static.level_id or nil }
			end
			local known = AA.portalNames[itemId]
			local own = type(extra._unique_portal_data) == "table" and extra._unique_portal_data.level_id
			local group = known.group or (own and Levels[own] and Levels[own].portal_group) or nil
			local depth = type(extra._unique_portal_data) == "table" and tonumber(extra._unique_portal_data.portal_depth) or nil
			table.insert(list, { uuid = item.uuid, id = itemId, name = known.name, group = group, level = own or known.level, depth = depth, tries = tries, left = max - tries, made = tonumber(item._creation_time) or 0 })
		end
	end
	return list
end

---Every kind of portal this account has had, as far as the script has seen: the ones in the
---inventory now, plus the ones remembered from earlier (progress file, seeded once from the match
---log's drops). The game keeps no such record itself. Returns { { id, name } }.
function AA.portalKinds()
	local seen = AA.progress.portalsSeen
	if type(seen) ~= "table" then
		seen = {}
		AA.progress.portalsSeen = seen
	end
	local changed = false
	if not AA.progress.portalsSeeded then
		AA.progress.portalsSeeded = true
		changed = true
		pcall(function()
			local log = httpService:JSONDecode(readfile(SETTINGS_FOLDER .. "/matches.json"))
			for _, entry in ipairs(type(log) == "table" and log or {}) do
				for itemId in pairs(type(entry) == "table" and type(entry.items) == "table" and entry.items or {}) do
					if tostring(itemId):lower():find("portal", 1, true) and seen[itemId] == nil then
						seen[itemId] = true
					end
				end
			end
		end)
	end
	for _, item in ipairs(AA.portalItems()) do
		if seen[item.id] ~= item.name then
			seen[item.id] = item.name
			changed = true
		end
	end
	local list = {}
	for id, name in pairs(seen) do
		if name == true then
			-- Known from a drop log only: look its name up once.
			local ok, data = pcall(function()
				return gameRequire(replicatedStorage.src.Data.Items)[id]
			end)
			name = ok and type(data) == "table" and data.item_group == "Portals" and data.name or false
			seen[id] = name
			changed = true
		end
		if name then
			table.insert(list, { id = id, name = name })
		end
	end
	if changed then
		pcall(AA.saveProgress)
	end
	table.sort(list, function(a, b)
		return a.name < b.name
	end)
	return list
end

---The portal to open next: the picked kind (or any), one already started first, then the oldest.
---With a group (the running portal match's), only portals the game lets that match go on with.
function AA.portalChoose(group)
	local best
	pcall(AA.portalKinds)
	for _, item in ipairs(AA.portalItems()) do
		if (Config.PortalPick == "" or item.id == Config.PortalPick) and item.left > 0 and not (AA.portalTried and AA.portalTried[item.uuid]) and (not group or not item.group or item.group == group) then
			local started, bestStarted = item.tries > 0, best and best.tries > 0
			if not best or (started and not bestStarted) or (started == bestStarted and item.made < best.made) then
				best = item
			end
		end
	end
	return best
end

---Farm kills mode (takedowns for evolutions): everything at the very front on Weakest, the whole
---team placed before anything is upgraded, then the farm maxed, then upgrades by efficiency.
function AA.killsMode()
	-- (Also as the mode played between challenges.)
	local between = ((Config.Mode == "Challenge" or Config.Mode == "Daily") and Config.ChallengeFallback == "Kills") or Config.Otherwise == "Kills"
	if Config.Mode ~= "Kills" and not between then
		return false
	end
	if IS_LOBBY and between then
		return false
	end
	-- Only on the stage the mode farms: a portal or story match opened by hand with the mode
	-- still selected plays normally (seen live: a 15-wave portal got the farm maxed first).
	if IS_LOBBY then
		return true
	end
	-- And only in a match the script started in this mode itself.
	local session = AA.progress and AA.progress.session
	if type(session) ~= "table" or session.job ~= game.JobId or session.mode ~= "Kills" then
		return false
	end
	local id = AA.Match and AA.Match.levelId
	if not id then
		return false
	end
	id = tostring(id):lower()
	if Config.KillsStage == "Summer" then
		return id:find("summer") ~= nil
	end

	return id:find("^aot") ~= nil and id:find("infinite") ~= nil
end

---Our Holy Warlord, when one stands (Shadow Sorcerer (Ritual)'s summon; one at a time).
function AA.ownWarlord()
	local folder = workspace:FindFirstChild("_UNITS")
	for _, unit in ipairs(folder and folder:GetChildren() or {}) do
		local unitStats = unit:FindFirstChild("_stats")
		local id, owner = unitStats and unitStats:FindFirstChild("id"), unitStats and unitStats:FindFirstChild("player")
		if id and id.Value == "mahoraga" and owner and owner.Value == localPlayer then
			return unit
		end
	end
	return nil
end
---Does this unit end in the Ritual (its last upgrade unlocks the sacrifice for Holy Warlord)?
function AA.ritualUnit(data)
	local last = data and data.upgrade and data.upgrade[#data.upgrade]
	return last ~= nil and tostring(last.active_attack):find(":mahoraga", 1, true) ~= nil
end

---Can the rest of the match pay for the Ritual from this level on (cash now plus the income of
---80% of the waves left)? Long modes always can. level -1 = not placed yet.
function AA.ritualPayable(data, level, money, left)
	if Match.longHaul or Match.infinite then
		return true
	end
	local cost = level < 0 and (data.cost or 0) or 0
	for target = math.max(level, 0) + 1, data.upgrade and #data.upgrade or 0 do
		cost += data.upgrade[target].cost or 0
	end
	cost *= AA.costScale and AA.costScale() or 1
	local elapsed = os.clock() - (Match.startedAt or os.clock())
	local perWave = math.clamp(elapsed / math.max(currentWave(), 1), 15, 60)
	return (money or 0) + (Match.incomeRate or 0) * perWave * (left or 0) * 0.8 >= cost
end

---Build order: the user's own list of steps ({ kind = "place" | "upgrade", unit = id, times = n }),
---followed one step at a time instead of the planner's own choice. Kept in Config.OrderData
---(JSON), saved setups in <Game>/orders/<name>.json together with the placement style.
AA.Order = {}
function AA.Order.steps()
	if AA.Order.cacheText ~= Config.OrderData then
		local ok, data = pcall(function()
			return httpService:JSONDecode(Config.OrderData)
		end)
		local steps = {}
		for _, step in ipairs(ok and type(data) == "table" and data or {}) do
			if type(step) == "table" and type(step.unit) == "string" and (step.kind == "place" or step.kind == "upgrade") then
				table.insert(steps, { kind = step.kind, unit = step.unit, times = math.clamp(math.floor(tonumber(step.times) or 1), 1, 20) })
			end
		end
		AA.Order.cacheText, AA.Order.cache = Config.OrderData, steps
	end
	return AA.Order.cache
end
function AA.Order.set(steps)
	Config.OrderData = httpService:JSONEncode(steps)
end
function AA.Order.active()
	return Config.OrderOn and not IS_LOBBY and #AA.Order.steps() > 0 and not AA.killsMode()
end
---Front placement picked for the build order.
function AA.Order.front()
	return Config.OrderPlacement == "Front" and AA.Order.active()
end
function AA.Order.file(name)
	return SETTINGS_FOLDER .. "/orders/" .. tostring(name):gsub("[^%w%-_ ]", "_") .. ".json"
end
function AA.Order.list()
	local names = {}
	pcall(function()
		if isfolder(SETTINGS_FOLDER .. "/orders") then
			for _, path in ipairs(listfiles(SETTINGS_FOLDER .. "/orders")) do
				local name = tostring(path):match("([^/\\]+)%.json$")
				if name then
					table.insert(names, name)
				end
			end
		end
	end)
	table.sort(names)
	return names
end
function AA.Order.save(name)
	return pcall(function()
		if not isfolder(SETTINGS_FOLDER) then
			makefolder(SETTINGS_FOLDER)
		end
		if not isfolder(SETTINGS_FOLDER .. "/orders") then
			makefolder(SETTINGS_FOLDER .. "/orders")
		end
		writefile(AA.Order.file(name), httpService:JSONEncode({ placement = Config.OrderPlacement, steps = AA.Order.steps() }))
	end)
end
function AA.Order.load(name)
	local ok, data = pcall(function()
		return httpService:JSONDecode(readfile(AA.Order.file(name)))
	end)
	if ok and type(data) == "table" and type(data.steps) == "table" then
		Config.OrderPlacement = data.placement == "Front" and "Front" or "Smart"
		Config.OrderData = httpService:JSONEncode(data.steps)
		Config.OrderName = name
		return true
	end
	return false
end
---The step the match is on: the first one the field doesn't satisfy yet. Counted from the field
---(copies standing, upgrade levels bought), so a reload or a replay picks up where it is.
---Returns index, step, and what it needs ("place" / "upgrade"), or nil when the list is done.
function AA.Order.current(towers, capOf)
	local copies, levels = {}, {}
	for _, unit in ipairs(towers) do
		local id = unit._stats.id.Value
		copies[id] = (copies[id] or 0) + 1
		levels[id] = (levels[id] or 0) + unit._stats.upgrade.Value
	end
	local wantCopies, wantLevels = {}, {}
	Match.orderSkip = Match.orderSkip or {}
	for index, step in ipairs(AA.Order.steps()) do
		local id = step.unit
		if step.kind == "place" then
			wantCopies[id] = (wantCopies[id] or 0) + 1
			local cap = capOf and capOf(id)
			if (copies[id] or 0) < wantCopies[id] and not (cap and (copies[id] or 0) >= cap) and not Match.orderSkip[index] then
				return index, step
			end
		else
			wantLevels[id] = (wantLevels[id] or 0) + step.times
			if (levels[id] or 0) < wantLevels[id] and not Match.orderSkip[index] then
				return index, step
			end
		end
	end
	return nil
end

---Daily challenge with other players in the server: the whole team goes to the very front (the
---others hold the rest of the road). Decided once per match, so it stays when they leave.
function AA.frontForced()
	if IS_LOBBY or not Config.DailyFront then
		return false
	end
	if Match.frontForced == nil and Match.levelId and AA.matchKindName then
		local kind = AA.matchKindName()
		if kind ~= "Daily" then
			Match.frontForced = false
		elseif #playersService:GetPlayers() > 1 then
			Match.frontForced = true
			note("front", { players = #playersService:GetPlayers() })
		end
	end
	return Match.frontForced == true
end

---How far down the road enemies get on a typical wave of this stage: the 80th percentile of the
---per-wave depth, live once six waves are known, otherwise remembered from the last run here.
---(Summer Hunt, hxhant map: enemies died at 10-30% of the road for 38 of 42 waves while the whole
---team stood at 55-79%; a Water Goddess at 3% dealt 15M against 2-6M for the ones mid-road.)
function AA.fightBand()
	local list = {}
	for _, depth in pairs(Match.depthByWave or {}) do
		table.insert(list, depth)
	end
	if #list >= 6 then
		table.sort(list)
		return list[math.ceil(#list * 0.8)]
	end
	local saved = type(AA.progress.depths) == "table" and AA.progress.depths[AA.depthKey()]
	return tonumber(saved)
end
---Per stage AND map: Summer Hunt is played on a different map each run and the roads differ.
function AA.depthKey()
	return AA.leakKey() .. "@" .. tostring((Match.levelData or {}).map or "")
end
---Is this road in use right now? (Some maps open their extra roads during the match: the game
---keeps the closed ones in workspace._DATA "closed_lanes" as a list of lane names.)
function AA.laneOpen(lane)
	local data = workspace:FindFirstChild("_DATA")
	local closed = data and data:GetAttribute("closed_lanes")
	if type(closed) ~= "string" or closed == "" then
		return true
	end
	local name = tostring(Match.laneNames and Match.laneNames[lane] or lane)
	for entry in closed:gmatch("[^,]+") do
		if entry == name then
			return false
		end
	end
	return true
end
---How much a stretch of each road is worth to the next unit, on maps with two or three roads.
---A road counts for more the deeper its enemies have been getting (that is where the team, other
---players included, is short) and the fewer of my damage units already reach it; a closed road
---counts for little until it opens. Returns weights by lane and the number of open roads.
function AA.laneWeights(towers)
	local count = Match.laneCount or 1
	local weights, open = {}, 0
	if count <= 1 then
		return { 1 }, 1
	end
	local have, total = {}, 0
	for lane = 1, count do
		have[lane] = 0
	end
	for _, unit in ipairs(towers or {}) do
		local unitStats = unit:FindFirstChild("_stats")
		local range, damage = unitStats and unitStats:FindFirstChild("range"), unitStats and unitStats:FindFirstChild("damage")
		if range and damage and (AA.rv(damage) > 0 or AA.isSummoner(unitStats.id.Value)) then
			local position, reach = unit:GetPivot().Position, AA.rv(range)
			local seen = {}
			for _, point in ipairs(Match.pathPoints) do
				if not seen[point.lane] then
					local dx, dz = point.position.X - position.X, point.position.Z - position.Z
					if dx * dx + dz * dz <= reach * reach then
						seen[point.lane] = true
						have[point.lane] += 1
						total += 1
					end
				end
			end
		end
	end
	local wave = workspace:FindFirstChild("_wave_num") and workspace._wave_num.Value or 0
	for lane = 1, count do
		if AA.laneOpen(lane) then
			open += 1
			local depth = 0.4
			local seen = Match.laneDepth and Match.laneDepth[lane]
			if seen then
				depth = 0
				for w = wave - 2, wave do
					depth = math.max(depth, seen[w] or 0)
				end
			end
			weights[lane] = (0.5 + depth) * math.clamp((total / count + 1) / (have[lane] + 1), 0.5, 2.5)
		else
			-- (Closed for now. It opens later in the match, so it counts like the others.)
			weights[lane] = 1
		end
	end
	return weights, math.max(open, 1)
end
---The stretch of a road where enemies are meant to die in a fast match: from its spawn to where
---they have been dying, stretched to the first junction on maps with several roads.
local function killZone(lane)
	local zone = (Match.fightDepth or 0.1) + 0.06
	if AA.killsMode() or AA.frontForced() or AA.Order.front() then
		-- Kills mode: the fight is held at the spawn however deep later waves get.
		zone = 0.1
	end
	local junction = lane and Match.laneJunction and Match.laneJunction[lane]
	if junction then
		zone = math.max(zone, junction + 0.1)
	end
	return zone
end

---Road samples within `reach` studs of a spot, through the grid index: visit(point, dx, dz, d2).
local function pathWithin(px, pz, reach, visit)
	local points, grid = Match.pathPoints, Match.pathGrid
	if not grid then
		return
	end
	local reach2 = reach * reach
	for cx = math.floor((px - reach) / 8), math.floor((px + reach) / 8) do
		for cz = math.floor((pz - reach) / 8), math.floor((pz + reach) / 8) do
			local cell = grid[cx * 8192 + cz]
			if cell then
				for _, index in ipairs(cell) do
					local point = points[index]
					local dx, dz = point.position.X - px, point.position.Z - pz
					local d2 = dx * dx + dz * dz
					if d2 <= reach2 then
						visit(point, dx, dz, d2)
					end
				end
			end
		end
	end
end

---Closest sampled point of the road ({ position, progress }) and its distance. With `reach`,
---only looks that far and returns nil when the road is further away.
local function nearestPath(position, reach)
	local best, distance = nil, math.huge
	pathWithin(position.X, position.Z, reach or 8, function(point, _, _, d2)
		if d2 < distance then
			best, distance = point, d2
		end
	end)
	if not best and not reach then
		-- Further than a grid cell from the road (towers on far hills): plain scan.
		for _, point in ipairs(Match.pathPoints) do
			local px, pz = point.position.X - position.X, point.position.Z - position.Z
			local d = px * px + pz * pz
			if d < distance then
				best, distance = point, d
			end
		end
	end
	return best, math.sqrt(distance)
end

local function terrainFolders()
	local terrain = workspace:FindFirstChild("_terrain")
	return terrain, terrain and terrain:FindFirstChild("ground"), terrain and terrain:FindFirstChild("hill")
end

-- Candidate spots: a 1.6 stud grid around the path, raycast like the game's own placement
-- (ground / hill parts, never _donotplace, never the road).
local function buildSpots()
	local points = Match.pathPoints
	if #points == 0 then
		points = buildPath()
	end
	if #points == 0 then
		return nil
	end
	local terrain, ground, hill = terrainFolders()
	if not terrain then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	-- Only what the server looks at: the ground, the hills, the road and the no-build parts.
	-- Houses, trees and the other props don't count for it (tested: a unit sent to the ground
	-- under a building's upper floor was placed), so they must not hide the ground under them
	-- here either. Ground under a hill part is different: the server takes the hill, and a
	-- ground unit sent there is refused at any height.
	local filter = {}
	if ground then
		table.insert(filter, ground)
	end
	if hill then
		table.insert(filter, hill)
	end
	for _, part in ipairs(terrain:GetDescendants()) do
		if part.Name == "_donotplace" then
			table.insert(filter, part)
		end
	end
	if #filter == 0 then
		filter = { terrain }
	end
	local roadModel = workspace:FindFirstChild("_road")
	if roadModel then
		table.insert(filter, roadModel)
	end
	params.FilterDescendantsInstances = filter
	-- Under a prop the server still wants headroom: under a building's upper floor 4.7 studs
	-- up it placed the unit, under a rock mesh 0.9 studs up it refused. A covered spot counts
	-- only with 4 clear studs above it (and not when it sits inside the prop).
	local anything = RaycastParams.new()
	anything.FilterType = Enum.RaycastFilterType.Include
	anything.FilterDescendantsInstances = roadModel and { terrain, roadModel } or { terrain }

	local minX, maxX, minZ, maxZ, topY = math.huge, -math.huge, math.huge, -math.huge, -math.huge
	for _, point in ipairs(points) do
		local p = point.position
		minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
		minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
		topY = math.max(topY, p.Y)
	end
	-- Up to 36 studs from the road (was 18): long-ranged units cover far more from the inside of
	-- a bend than from its kerb, and those spots were not even on the list. Beyond 18 studs only
	-- every second row and column is kept, so big maps don't triple their spot count.
	local margin, step = 36, 1.62
	local spots = { ground = {}, hill = {} }
	local cluttered = {}
	local column = 0
	for x = minX - margin, maxX + margin, step do
		column += 1
		local row = 0
		for z = minZ - margin, maxZ + margin, step do
			row += 1
			-- Near the path at all?
			-- (The near band is looked up first with the short reach: the wide lookup is four
			-- times the work and only every fourth cell needs it.)
			local onRoad, nearest = nearestPath(Vector3.new(x, 0, z), 18)
			if not onRoad and column % 2 == 0 and row % 2 == 0 then
				onRoad, nearest = nearestPath(Vector3.new(x, 0, z), margin)
			end
			if onRoad and (nearest >= 1.4 or Config.RoadSpots) then
				local hit = workspace:Raycast(Vector3.new(x, topY + 80, z), Vector3.new(0, -200, 0), params)
				local roof, low
				if hit and hit.Normal.Y > 0.6 and hit.Instance.Name ~= "_donotplace" then
					-- Everything above the spot, from the top down: the lowest surface decides.
					-- (A building's foundation lies a tenth of a stud over the ground: the old
					-- check looked up from 0.2 studs and saw only the roof six studs higher, and
					-- nine placements in a row were refused there.)
					local origin, lowest = Vector3.new(x, topY + 80, z), nil
					for _ = 1, 6 do
						local over = workspace:Raycast(origin, Vector3.new(0, -200, 0), anything)
						if not over or over.Position.Y <= hit.Position.Y + 0.02 then
							break
						end
						lowest = over.Position.Y
						origin = over.Position - Vector3.new(0, 0.05, 0)
					end
					if lowest then
						roof = lowest - hit.Position.Y
						low = roof < 4
					end
				end
				if hit and hit.Normal.Y > 0.6 and hit.Instance.Name ~= "_donotplace" then
					local spot = { position = hit.Position, gap = nearest, progress = onRoad.progress, lane = onRoad.lane, roof = roof }
					if low then
						-- Something lies right on top of this ground: kept aside (see below).
						if (ground and hit.Instance:IsDescendantOf(ground)) or (hill and hit.Instance:IsDescendantOf(hill)) then
							table.insert(cluttered, { spot = spot, hill = hill ~= nil and hit.Instance:IsDescendantOf(hill) })
						end
					elseif ground and hit.Instance:IsDescendantOf(ground) then
						table.insert(spots.ground, spot)
					elseif hill and hit.Instance:IsDescendantOf(hill) then
						table.insert(spots.hill, spot)
					elseif Config.RoadSpots and roadModel and hit.Instance:IsDescendantOf(roadModel) then
						-- The road itself: the game's own placing won't offer it, the server takes
						-- it for ground units (tested: ground and hybrid units yes, hill-only no,
						-- inside another unit no).
						spot.road = true
						table.insert(spots.ground, spot)
					end
				end
			end
		end
		if x % 8 < step then
			task.wait()
		end
	end
	-- A map whose ground is covered nearly everywhere (a layer of grass or sand over the ground
	-- parts) would be left with no spots at all: there the covered ones are placeable after all.
	if #cluttered > (#spots.ground + #spots.hill) * 2 then
		for _, row in ipairs(cluttered) do
			table.insert(row.hill and spots.hill or spots.ground, row.spot)
		end
		cluttered = {}
	end
	Match.spots, Match.spotsRoad = spots, Config.RoadSpots
	Match.spotsCluttered = #cluttered
	return spots
end

local function spotKey(position)
	return string.format("%d,%d", math.floor(position.X * 2), math.floor(position.Z * 2))
end

---Attack shape a unit has at an upgrade level (upgrades can swap the attack, e.g. Zen's spin -> straight slashes).
local function attackShape(data, level)
	local attackId = data.primary_attack or data.primary_attack_no_upgrades
	for i = 1, level do
		local up = data.upgrade and data.upgrade[i]
		if up and up.primary_attack then
			attackId = up.primary_attack
		end
	end
	local range = unitStatsAt(data, level).range
	local attack = attackId and Attacks[attackId]
	local shape = { kind = "target", range = range }
	for _, entry in pairs(attack and type(attack.aoe) == "table" and attack.aoe or {}) do
		local aoe = type(entry) == "table" and entry.aoe_type
		if type(aoe) == "table" and aoe.type then
			if aoe.type == "full_aoe" then
				shape = { kind = "circle", range = aoe.radius or range }
			elseif aoe.type == "straight" then
				shape = { kind = "line", range = range, length = aoe.length or range, width = aoe.width or 4 }
			elseif aoe.type == "cone" then
				shape = { kind = "cone", range = range, half = math.rad((aoe.angle or 45) / 2) }
			else
				shape = { kind = "target", range = range, splash = aoe.radius or 0 }
			end
			break
		end
	end
	return shape
end

-- Unit strength. One copy's power at an upgrade level counts everything that changes its kills:
-- damage x hits per attack, this copy's level, Potency / Speed / Range rolls and traits, crit,
-- how many enemies the attack shape catches and how long enemies stay inside its range.
-- Stat multipliers of one owned copy, straight from the game's own formula: level, trait, stat
-- rolls, curses, limit breaks, artifacts, relics and (in a match) the level's modifiers.
local statCache = setmetatable({}, { __mode = "k" })
---The owned copy with its real stat rolls. The Visuals tab writes the shown ones into the profile
---copy, and the game's formula reads them from there: a +99,999,999,900% Damage shown on Elyssia
---made her next upgrade score 9.5 billion in the planner, weighted every card vote by her damage
---type alone and logged her as doing a billionth of her sheet damage.
function AA.realRecord(unit)
	local visual = AA.Visual
	local orig = visual and type(unit) == "table" and unit.uuid and visual.orig[tostring(unit.uuid)]
	if type(orig) ~= "table" or type(unit.trait_stats) ~= "table" then
		return unit
	end
	local copy
	for key, value in pairs(orig) do
		if unit.trait_stats[key] ~= value then
			if not copy then
				copy = table.clone(unit)
				copy.trait_stats = table.clone(unit.trait_stats)
			end
			copy.trait_stats[key] = value
		end
	end
	return copy or unit
end
local function statMul(unit, stat)
	if type(unit) ~= "table" then
		return 1
	end
	local xp = unit.xp or 0
	local entry = statCache[unit]
	if not entry or entry.xp ~= xp or os.clock() - entry.at > 20 then
		entry = { xp = xp, at = os.clock() }
		statCache[unit] = entry
	end
	local value = entry[stat]
	if value == nil then
		value = tonumber(gameCall(Core.Unit and Core.Unit.calculate_static_stat_multiplier, AA.realRecord(unit), xp, stat, session())) or false
		if not value and stat == "damage" then
			-- Formula missing: at least the level curve.
			value = tonumber(gameCall(Core.Unit and Core.Unit.calculate_level_base_multiplier, unit.unit_id, xp)) or false
		end
		entry[stat] = value
	end
	return value or 1
end
AA.statMul = statMul

---Does this owned copy carry a trait (unique, golden...)?
function AA.hasTrait(unit, trait)
	if type(unit) ~= "table" then
		return false
	end
	if gameCall(Core.Trait and Core.Trait.has_trait, unit, trait) then
		return true
	end
	for _, entry in pairs(type(unit.traits) == "table" and unit.traits or {}) do
		if (type(entry) == "table" and entry.trait or entry) == trait then
			return true
		end
	end
	return false
end

---What one use of an attack deals to one enemy, in multiples of the unit's damage:
---  aoe        every hit of the attack (hit.damage is its share of the damage);
---  aoe_dot    an area that lingers: time / interval ticks of hit.damage each (the game's own
---             tables add up to a whole hit this way: 3 s at 1 s x 0.333, 3 s at 0.6 s x 0.2);
---  spawn_unit a summon that blows up (death_attack) deals that attack once, at damage_ratio of
---             its owner's damage, times the amount summoned. A summon that keeps attacking
---             counts for one attack: how long it lives is the server's business.
function AA.attackHits(attack, depth)
	if type(attack) ~= "table" then
		return 1
	end
	local total = 0
	for _, entry in pairs(type(attack.aoe) == "table" and attack.aoe or {}) do
		local hit = type(entry) == "table" and entry.hit
		if type(hit) == "table" then
			total += tonumber(hit.damage) or 1
		end
	end
	for _, entry in pairs(type(attack.aoe_dot) == "table" and attack.aoe_dot or {}) do
		local inner = type(entry) == "table" and type(entry.aoe) == "table" and entry.aoe.hit
		local time, interval = type(entry) == "table" and tonumber(entry.time), type(entry) == "table" and tonumber(entry.interval)
		if type(inner) == "table" and time and interval and interval > 0 then
			total += (tonumber(inner.damage) or 1) * math.max(math.floor(time / interval + 0.5), 1)
		end
	end
	if (depth or 0) < 2 then
		for _, group in pairs(type(attack.spawn_unit) == "table" and attack.spawn_unit or {}) do
			for _, summon in pairs(type(group) == "table" and type(group.units_nonrandom) == "table" and group.units_nonrandom or {}) do
				local summonData = type(summon) == "table" and Units[summon.unit]
				if type(summonData) == "table" then
					local attackId = summonData.death_attack or summonData.primary_attack or summonData.primary_attack_no_upgrades or (type(summonData._attacks) == "table" and (summonData._attacks[1] or summonData._attacks["1"]))
					total += (tonumber(summon.amount) or 1) * (tonumber(summon.damage_ratio) or 1) * AA.attackHits(type(attackId) == "string" and Attacks[attackId] or nil, (depth or 0) + 1)
				end
			end
		end
	end
	return total > 0 and total or 1
end

---Crit chance of a copy from the game's own formula (unit, relic and artifact), and the size of
---its crits when the unit's table gives one (nil otherwise: the default lives on the server).
function AA.critOf(data, unit)
	local kind = data._base_damage_type == "magic" and "magic" or "physical"
	local chance = tonumber(data[kind .. "_crit_chance"]) or 0
	if type(unit) == "table" then
		statMul(unit, "damage")
		local entry = statCache[unit]
		if entry.crit == nil then
			entry.crit = tonumber(gameCall(Core.Unit and Core.Unit.calculate_static_crit_chance, AA.realRecord(unit), nil, kind, session())) or false
		end
		chance = entry.crit or chance
	end
	return math.clamp(chance, 0, 1), tonumber(data[kind .. "_crit_damage"])
end

local function hitsPerAttack(data, level)
	local attackId = data.primary_attack or data.primary_attack_no_upgrades
	for i = 1, level do
		local up = data.upgrade and data.upgrade[i]
		if up and up.primary_attack then
			attackId = up.primary_attack
		end
	end
	return AA.attackHits(attackId and Attacks[attackId], 0)
end

local function copyPower(data, unit, level)
	local base = unitStatsAt(data, level)
	if base.damage <= 0 then
		return 0
	end
	local damage = base.damage * hitsPerAttack(data, level) * statMul(unit, "damage")
	local cooldown = math.max(base.cooldown * statMul(unit, "attack_cooldown"), 0.1)
	local range = base.range * statMul(unit, "range")
	local chance, size = AA.critOf(data, unit)
	local crit = 1 + chance * (size or 0.5)
	local shape = attackShape(data, level)
	local targets = 1
	if shape.kind == "circle" then
		targets = 1 + math.min(shape.range, 30) / 4
	elseif shape.kind == "line" then
		targets = 1 + math.min(shape.length or range, 40) / 6
	elseif shape.kind == "cone" then
		targets = 1 + math.min(range, 30) * (shape.half or 0.4) / 3
	elseif (shape.splash or 0) > 0 then
		targets = 1 + math.min(shape.splash, 20) / 5
	end
	local uptime = math.clamp(range / 10, 0.35, 4) ^ 0.6
	return damage / cooldown * crit * targets * uptime
end

---How many copies the server lets you place: the unit's own cap, 5 when it has none, or whatever
-- the server told us this match ("Cannot place more than N of this unit!").
local learnedCaps = {}
local function placeCap(data)
	if AA.uniqueIds and AA.uniqueIds[data.id] then
		return 1
	end
	return math.min(learnedCaps[data.id] or data.spawn_cap or 5, Config.MaxPerUnit)
end

---The level's cost modifier (High Cost / Triple Cost challenges), read where the game reads it.
local function costScale()
	local data = mapData()
	local mods = data and data:FindFirstChild("GameModifiers")
	local value = mods and mods:FindFirstChild("player_cost_scale")
	return value and tonumber(value.Value) or 1
end
AA.costScale = costScale

---What placing this equipped copy costs right now.
local function spawnCost(entry)
	local scale = tonumber(gameCall(Core.Unit and Core.Unit.calculate_spawn_cost_multiplier, session(), entry.unit)) or costScale()
	return math.ceil((entry.data.cost or 0) * scale)
end

---What taking a placed tower from `level` to `level + 1` costs right now.
local function upgradeCost(unit, data, level)
	local step = data.upgrade and data.upgrade[level + 1]
	if not step then
		return math.huge
	end
	local scale = tonumber(gameCall(Core.Unit and Core.Unit.calculate_upgrade_cost_multiplier, unit, session()))
	if not scale then
		local own = unit._stats:FindFirstChild("upgrade_cost_multiplier")
		scale = costScale() * (own and own.Value or 1)
	end
	return math.ceil((step.cost or 0) * scale)
end

---The owned copy (collection entry) behind a placed tower.
local function ownedOf(unit)
	local uuid = unit._stats:FindFirstChild("uuid")
	local owned = collectionData().owned_units
	return uuid and owned and owned[uuid.Value] or nil
end

-- Buff units (Windsong, Commander, Elfy). Their active gives allies in the caster's own range
-- (15 studs, not the 999 the attack lists) +30% / +25% damage of one base type for 30 s on a 60 s
-- cooldown. Measured live:
--   * a unit that already carries the buff can't take another until it runs out;
--   * a caster that carries the buff itself passes on a stronger one: (1 + base) x (1 + its own)
--     - 1, so 30% -> 69% -> 100% (the cap).
-- That makes the "infinite 100% buff" possible with four copies standing in each other's range:
-- two mains buff everyone whenever the team's buff runs out, two supports re-buff the mains a
-- few seconds later, so each main is still buffed (and the team isn't) when its turn comes.
do
	local cache = {}
	function AA.buffInfo(data)
		if not data or not data.active_attack then
			return nil
		end
		if cache[data.id] ~= nil then
			return cache[data.id] or nil
		end
		local info = false
		local attack = Attacks[data.active_attack]
		if type(attack) == "table" then
			local buff, radius
			for _, entry in pairs(type(attack.aoe) == "table" and attack.aoe or {}) do
				if type(entry) == "table" and entry.hit_allies and type(entry.hit) == "table" and type(entry.hit.buffs) == "table" then
					for _, candidate in pairs(entry.hit.buffs) do
						if type(candidate) == "table" then
							buff = buff or candidate
						end
					end
					radius = type(entry.aoe_type) == "table" and tonumber(entry.aoe_type.radius) or radius
				end
			end
			if buff then
				local text = tostring(attack.active_description or "")
				local stats = data.active_attack_stats or {}
				local kind, rate
				for damageType, entry in pairs(type(buff.params) == "table" and type(buff.params.damage_types) == "table" and buff.params.damage_types or {}) do
					if type(entry) == "table" and tonumber(entry.rate) then
						kind, rate = damageType, tonumber(entry.rate)
					end
				end
				info = {
					name = type(buff.name) == "string" and buff.name or data.active_attack,
					pct = rate or (tonumber(text:match("%+(%d+)%%")) or 20) / 100,
					kind = kind or text:match("{(%a+)}") or "all",
					duration = tonumber(buff.time) or tonumber(text:match("for (%d+)s")) or 30,
					cooldown = tonumber(stats.attack_cooldown) or 60,
					radius = radius,
				}
			end
		end
		cache[data.id] = info
		return info or nil
	end
	---How far a buffer's cast reaches: its own range (rolls and traits included).
	function AA.buffRange(data, unit, buff)
		if buff and buff.radius then
			return buff.radius
		end
		return unitStatsAt(data, 0).range * statMul(unit, "range")
	end
	---Does this buff help a unit of this data? The buff asks for the unit's base damage type.
	function AA.buffMatches(buff, data)
		if not buff or not data then
			return false
		end
		if buff.kind == "all" or buff.kind == "damage" then
			return true
		end
		return (data._base_damage_type or "physical") == buff.kind
	end
	---Copies worth placing: four make the chain that holds the buff at 100%.
	function AA.buffCopies(buff, data)
		return math.max(1, math.min(4, data and (learnedCaps[data.id] or data.spawn_cap or 5) or 4))
	end
	---Average damage bonus the team gets from n copies in each other's range.
	-- 1: the base buff half the time; 2: the base buff all the time; 3 adds nothing a pair
	-- can't do; 4: the chain, 100% all the time.
	function AA.buffValue(buff, copies)
		if copies <= 0 then
			return 0
		elseif copies == 1 then
			return buff.pct * math.min(1, buff.duration / buff.cooldown)
		elseif copies < 4 then
			return buff.pct * math.min(1, 2 * buff.duration / buff.cooldown)
		end
		return 1
	end
end

-- Team synergies the sheet can't see (game data where it has them, guides where it doesn't):
-- Zombie buffs every summoned minion's attack +25%, stacking per Zombie placed (up to 8);
-- Water Goddess (hill) adds +50% damage to Water units in her range (guide value, server-side).
do
	function AA.isSummoner(id)
		local summoners = type(AA.progress.summoners) == "table" and AA.progress.summoners or {}
		if summoners[id] then
			return true
		end
		local data = Units[id]
		for _, attackId in ipairs({ data and data.primary_attack, data and data.primary_attack_no_upgrades }) do
			local attack = type(attackId) == "string" and Attacks[attackId]
			if type(attack) == "table" and type(attack.spawn_unit) == "table" then
				return true
			end
		end
		-- "Does not attack, but instead summons ..." (Elyssia (Abyssal)).
		for _, passive in pairs(data and type(data.passives) == "table" and data.passives or {}) do
			if type(passive) == "table" and type(passive.description) == "string" and passive.description:lower():find("summons") then
				return true
			end
		end
		-- Same unit, other form: Elyssia (Abyssal) summons like Elyssia does.
		local from = data and type(data.evolved) == "table" and data.evolved.from
		if type(from) == "string" and from ~= id and summoners[from] then
			return true
		end
		local into = data and type(data.evolve) == "table" and data.evolve.evolve_unit
		if type(into) == "string" and into ~= id and summoners[into] then
			return true
		end
		return false
	end
	---Base form's id: summons are named after it (elyssia_evolved -> elyssia_eel, elyssia_jellyfish).
	function AA.rootId(id)
		local data = Units[id]
		local from = data and type(data.evolved) == "table" and data.evolved.from
		return type(from) == "string" and from or id
	end
	local function water(data)
		return data and (data._base_damage_type == "water" or (type(data._secondary_damage_types) == "table" and data._secondary_damage_types.water_damage == true))
	end
	---{ pct, matches(id, data), coverage } for units whose value is what they add to others.
	---What the server says each equipped unit's passives and actives do (the same text the game
	---shows on the unit card), kept per unit id. This is the only place a unit's passive exists
	---on the client: the unit sheet has none of it. An unevolved unit whose passive is locked
	---comes back with no description at all (Water Goddess: { locked = "evolve" }).
	function AA.fetchPassives()
		local function clean(list)
			local out = {}
			for _, entry in ipairs(type(list) == "table" and list or {}) do
				if type(entry) == "table" and type(entry.description) == "string" then
					table.insert(out, (entry.description:gsub("<[^>]+>", "")))
				end
			end
			return out
		end
		AA.progress.passives = type(AA.progress.passives) == "table" and AA.progress.passives or {}
		local changed = false
		for _, entry in ipairs(equippedUnits()) do
			if not (AA.passivesAt and AA.passivesAt[entry.id]) then
				local ok, result = invoke("get_unit_passives", entry.uuid)
				if ok and type(result) == "table" and type(result.passives) == "table" then
					AA.passivesAt = AA.passivesAt or {}
					AA.passivesAt[entry.id] = true
					local fresh = { p = clean(result.passives), a = clean(result.actives) }
					local old = AA.progress.passives[entry.id]
					if type(old) ~= "table" or httpService:JSONEncode(old) ~= httpService:JSONEncode(fresh) then
						AA.progress.passives[entry.id] = fresh
						changed = true
						note("passives", { u = entry.id, p = table.concat(fresh.p, " / "):sub(1, 300), a = table.concat(fresh.a, " / "):sub(1, 200) })
					end
				end
			end
		end
		if changed then
			AA.saveProgress()
		end
	end
	function AA.synergyInfo(id)
		-- From the unit's own passive text, whatever unit it is.
		local known = type(AA.progress.passives) == "table" and AA.progress.passives[id]
		if type(known) == "table" then
			for _, text in ipairs(type(known.p) == "table" and known.p or {}) do
				local lower = tostring(text):lower()
				local pct = tonumber(lower:match("attack by (%d+)%%") or lower:match("damage by (%d+)%%"))
				if pct and lower:find("minion", 1, true) and lower:find("summon", 1, true) then
					-- "Whenever another minion is summoned, this unit buffs that minion's ... Attack by N%"
					return { pct = pct / 100, stacks = lower:find("stack", 1, true) ~= nil, coverage = 1, matches = function(otherId, otherData)
						return AA.isSummoner(otherId) or AA.ritualUnit(otherData or Units[otherId])
					end }
				end
				local auraPct, auraType = lower:match("%+(%d+)%% {?([%a_]*)}? ?damage")
				if tonumber(auraPct) and (lower:find("allies", 1, true) or lower:find("ally", 1, true)) and (lower:find("in range", 1, true) or lower:find("in its range", 1, true) or lower:find("nearby", 1, true)) and not lower:find(" for %d+ ?s") then
					-- "Allies in range deal +N% {type} damage" with no duration: a standing aura.
					local kind = auraType ~= "" and auraType or nil
					return { pct = tonumber(auraPct) / 100, coverage = 0.6, matches = function(_, otherData)
						if not kind or not otherData then
							return otherData ~= nil
						end
						return otherData._base_damage_type == kind or (type(otherData._secondary_damage_types) == "table" and (otherData._secondary_damage_types[kind] == true or otherData._secondary_damage_types[kind .. "_damage"] == true))
					end }
				end
			end
			return nil
		end
		if id == "giselle_evolved" then
			-- Undead Blessing (Zombie (Risen) only; plain Zombie has no passive): "Whenever another
			-- minion is summoned, this unit buffs that minion's Health and Attack by 25%, and Range
			-- by 10%. This effect stacks globally on the same minion up to 8 times." Global: where
			-- she stands doesn't matter, only that she is on the field when the minion appears.
			return { pct = 0.25, stacks = true, coverage = 1, matches = function(otherId, otherData)
				return AA.isSummoner(otherId) or AA.ritualUnit(otherData or Units[otherId])
			end }
		end
		-- (Water Goddess used to be given a +50% Water aura here from a guide. The server says
		-- the unevolved one has no passive at all, and Elyssia standing inside four of them never
		-- carried a water buff: she is a plain damage unit until evolved.)
		return nil
	end
end

-- Measured damage. Newer units (Elyssia, Shadow Sorcerer (Incident), Hakari, Toji, Zombie...) attack
-- through server scripts: the client has no attack data for them in the lobby, so the sheet formula
-- can only guess. In matches every placed max-level copy's real damage (_stats.total_damage, plus
-- the damage of its summons: Elyssia's own total stays 0, her jellyfish/eels deal it) is logged while
-- an enemy is in its range. Each match is put on the sheet's scale by the normal units fighting next
-- to it in that same match (raw damage depends on how much health the mode's enemies have).
do
	local file = SETTINGS_FOLDER .. "/unit_measured.json"
	AA.Measured = {}
	pcall(function()
		if isfile(file) then
			local data = httpService:JSONDecode(readfile(file))
			if type(data) == "table" and (data.v == 3 or data.v == 4 or data.v == 5 or data.v == 6) and type(data.units) == "table" then
				AA.Measured = data.units
				AA.measuredVersion = data.v
				if data.v < 5 then
					-- Older numbers used the in-range clock for everything but summoners: only the
					-- summoners' are on today's scale. The rest measure again.
					local summoners = type(AA.progress.summoners) == "table" and AA.progress.summoners or {}
					for id in pairs(AA.Measured) do
						if not summoners[id] then
							AA.Measured[id] = nil
						end
					end
				end
				-- Summons were once logged as units of their own.
				for id in pairs(AA.Measured) do
					if id:find("_eel$") or id:find("_jellyfish$") then
						AA.Measured[id] = nil
					end
				end
			end
		end
	end)
	function AA.saveMeasured()
		AA.measureStamp = (AA.measureStamp or 0) + 1
		pcall(function()
			writefile(file, httpService:JSONEncode({ v = AA.measuredVersion == 6 and 6 or 5, units = AA.Measured }))
		end)
	end
	function AA.scriptedUnit(data)
		return data ~= nil and not (data.primary_attack or data.primary_attack_no_upgrades) and not data.upgrade and (data.farm_amount or 0) == 0
	end
	AA.MEASURE_SECONDS = 120
	---How much harder a unit really hits than its sheet (with this copy's level and traits) says:
	---scripted attacks and summons don't show in the data tables. 1 until it has been measured.
	---Falls back to the unit's other form (Zombie <-> Zombie (Risen)).
	function AA.measureFactor(id, level)
		local data = Units[id]
		-- A freshly evolved unit borrows its base form's numbers sheet by sheet, until it has
		-- its own for that sheet (Shadow Sorcerer (Ritual) had a general number after one long
		-- run but nothing for crowd stages, where the Sorcerer is at his best).
		local from = data and type(data.evolved) == "table" and data.evolved.from
		local function own(unitId)
			local entry = AA.Measured[unitId]
			if type(entry) == "table" and (entry.gsecs or 0) >= AA.MEASURE_SECONDS and (entry.g or 0) > 0 then
				return entry.g / entry.gsecs
			end
			if type(from) == "string" and unitId:sub(1, #id) == id then
				entry = AA.Measured[from .. unitId:sub(#id + 1)]
				if type(entry) == "table" and (entry.gsecs or 0) >= AA.MEASURE_SECONDS and (entry.g or 0) > 0 then
					return entry.g / entry.gsecs
				end
			end
			return nil
		end
		-- Two sheets: stages where weak enemies come in crowds (area damage shines: Shadow
		-- Sorcerer did 26% of a legend stage's damage for 19k cash) and stages with strong
		-- enemies (single-target damage shines: Elyssia did 10x his damage over a long infinite
		-- run). A match reads the sheet of its own kind first.
		local crowd = not IS_LOBBY and Match.pace == "speed"
		if level and level <= 1 then
			-- A fresh copy has its own sheet: Water Goddess measured 5.6x her paper damage, nearly
			-- all of it at level 4-5, and that number put four level-0 copies down before Elyssia
			-- in a Daily that was lost at wave 6. Unmeasured at low level: the general number,
			-- kept close to the paper.
			local low = own(crowd and (id .. "#lo@speed") or (id .. "#lo")) or own(id .. "#lo") or own(id .. "#lo@speed")
			if low then
				return math.clamp(low, 0.25, 20), true
			end
			local general = own(crowd and (id .. "@speed") or id) or own(id) or own(id .. "@speed")
			if general then
				return math.clamp(general, 0.6, 1.6), true
			end
		end
		local value = own(crowd and (id .. "@speed") or id) or own(id) or own(id .. "@speed")
		if not value and data then
			local from = type(data.evolved) == "table" and data.evolved.from
			local into = type(data.evolve) == "table" and data.evolve.evolve_unit
			value = (type(from) == "string" and own(from)) or (type(into) == "string" and own(into)) or nil
		end
		return value and math.clamp(value, 0.25, 20) or 1, value ~= nil
	end
	---Has this unit (or its other form) been measured in a real match?
	function AA.isMeasured(id)
		return select(2, AA.measureFactor(id)) == true
	end
end

---Shields on this match's enemies (Shield Enemies challenges: 3 / 6 / 9, Steel-Plated: 20). Each
---shield eats one hit whatever its damage, so slow single hits lose most of their worth.
function AA.shieldCount()
	if Match.shieldAt and os.clock() - Match.shieldAt < 3 then
		return Match.shieldHits or 0
	end
	Match.shieldAt = os.clock()
	local count = 0
	local challenge = tostring((Match.levelData or {})._challenge or "")
	if challenge == "hyper_shield_enemies" then
		count = 20
	elseif challenge:find("^shield_enemies") then
		count = 3 * (tonumber(challenge:match("_(%d)$")) or 1)
	end
	for _, enemy in ipairs(scanField().enemies) do
		local shield = enemy:FindFirstChild("_stats") and enemy._stats:FindFirstChild("max_shield")
		if shield and shield.Value > count and shield.Value < 100 then
			count = shield.Value
		end
	end
	Match.shieldHits = math.max(Match.shieldHits or 0, count)
	return Match.shieldHits
end
---Are the shields the real health of this match's enemies? Each shield eats one hit whatever
---its damage, so when stripping them takes more hits than the health behind them does, what
---counts is hits per second: many units, fast attackers, and upgrades are nearly worthless.
---(A Shield Enemies challenge on Walled City Act 6 was lost twice at wave 6 with one upgraded
---Zombie, 7 s between her hits, against enemies the user describes as very weak under the
---shields. The Daily with 3 shields on 200k+ enemies is the other kind: there damage counts.)
function AA.shieldMode(towers)
	local count = AA.shieldCount()
	if count < 3 then
		return false
	end
	local median = Match.enemyMedian
	-- The usual hit of the team: the middle one, not the average. (One Zombie hitting for 4.7M
	-- among fifteen units hitting for 30k-120k made the average 430k: "two hits kill, five
	-- shields decide", against enemies that took a dozen hits each. From wave 30 of a Summer
	-- Hunt every upgrade scored the same, and the cheap ones, Elfy's, were bought first while
	-- two Shadow Sorcerers stayed at level 3 and 5.)
	local hits = {}
	for _, unit in ipairs(towers or {}) do
		local damage = unit._stats:FindFirstChild("damage")
		local data = Units[unit._stats.id.Value]
		if damage and AA.rv(damage) > 0 and not AA.buffInfo(data) then
			table.insert(hits, AA.rv(damage))
		end
	end
	table.sort(hits)
	local n = #hits
	local total = n > 0 and hits[math.ceil(n / 2)] * n or 0
	if not median or n == 0 then
		-- Nothing measured yet: a shield challenge is treated as one until the numbers say otherwise.
		return true
	end
	-- Latched: the reading sits right on the line in some matches (five shields against enemies
	-- worth five hits) and the planner was switched between its two ways of scoring every second.
	local ratio = count / math.max(median / (total / n), 1e-6)
	if Match.shieldOn == nil then
		Match.shieldOn = ratio >= 1
	elseif Match.shieldOn and ratio < 0.7 then
		Match.shieldOn = false
	elseif not Match.shieldOn and ratio > 1.4 then
		Match.shieldOn = true
	end
	return Match.shieldOn
end
local function unitPower(id, unit)
	local data = Units[id]
	if not data then
		return 0
	end
	local maxLevel = data.upgrade and #data.upgrade or 0
	local factor, measured = AA.measureFactor(id)
	if not (AA.scriptedUnit(data) or data._fromCache or AA.isSummoner(id)) then
		-- Units with plain attack data: the sheet is close, measurements only nudge it.
		factor = math.clamp(factor, 0.6, 1.6)
	end
	local perCopy = copyPower(data, unit, maxLevel) * factor
	if perCopy <= 0 then
		return 0
	end
	local copies = placeCap(data)
	if AA.hasTrait(unit, "unique") then
		copies = 1
	end
	-- What the full set costs: a line-up you can't afford in a match isn't worth its sheet numbers.
	local cost = data.cost or 0
	for i = 1, maxLevel do
		cost += data.upgrade[i].cost or 0
	end
	local affordability = (20000 / math.max(cost * copies, 2000)) ^ 0.2
	-- Flying rework: every unit reaches flyers, but only hill placements hit them at full damage
	-- and reach Soaring enemies at all.
	local antiAir = (data.hill_unit or data.hybrid_placement) and 1.1 or 1
	-- Units the level favours (event bonuses, matching skins) hit harder there.
	local favoured = (1 + (tonumber(AA.levelBonus and AA.levelBonus(unit)) or 0)) * (AA.typeFactor and AA.typeFactor(data) or 1)
	return perCopy * copies * affordability * antiAir * favoured, measured
end

-- Unit ratings. What a copy is worth is worked out from the game's own tables, in two steps:
--   on paper:  damage x hits per attack x the game's stat multipliers / attack cooldown, with
--              crits where the data gives their size. One copy against one enemy that never
--              leaves its range. (The game's own measure of a unit is the same damage /
--              attack_cooldown: UnitServiceCore.get_static_dps_ratio.)
--   in play:   the paper number x how many enemies the attack shape catches x time in range x
--              copies you can place x what a full set costs. This is the number teams are
--              picked by (unitPower).
-- Some damage never reaches the client's tables: passives are text plus a server script, burn
-- and bleed tick on the server's clock, some attacks are scripted outright. Those parts are
-- named, not guessed: such a unit is rated on what can be calculated ("at least") until a
-- match has measured it, and then on the measured number.
do
	local Eval = { cache = {}, stamp = 0 }
	AA.Eval = Eval
	local STATUS = { fire = "Burn", black_fire = "Black fire", bleed = "Bleed", power_bleed = "Bleed", decay = "Decay", aki_curse = "Curse", cursed = "Curse", merlin_cursed = "Curse" }

	---Every attack a unit uses between level 0 and its last upgrade.
	local function attacksOf(data)
		local ids, seen = {}, {}
		local function add(id)
			if type(id) == "string" and not seen[id] then
				seen[id] = true
				table.insert(ids, id)
			end
		end
		add(data.primary_attack)
		add(data.primary_attack_no_upgrades)
		for _, up in ipairs(type(data.upgrade) == "table" and data.upgrade or {}) do
			add(type(up) == "table" and up.primary_attack)
		end
		return ids
	end
	---Parts of a unit's damage the client has no numbers for, as short phrases.
	function Eval.gaps(data)
		local list, seen = {}, {}
		local function add(text)
			if not seen[text] then
				seen[text] = true
				table.insert(list, text)
			end
		end
		for _, passive in pairs(type(data.passives) == "table" and data.passives or {}) do
			if type(passive) == "table" then
				add('passive "' .. tostring(passive.name or passive.id or "?") .. '"')
			end
		end
		if data.active_attack then
			add("its ability")
		end
		if data.on_attack_script then
			add("a server script on each attack")
		end
		if data.upgrade_script then
			add("a server script on upgrades")
		end
		if data.spawn_script then
			add("a server script on placing")
		end
		for _, attackId in ipairs(attacksOf(data)) do
			local attack = Attacks[attackId]
			for _, group in ipairs({ type(attack) == "table" and attack.aoe or false, type(attack) == "table" and attack.aoe_dot or false }) do
				for _, entry in pairs(type(group) == "table" and group or {}) do
					local hit = type(entry) == "table" and (entry.hit or (type(entry.aoe) == "table" and entry.aoe.hit))
					for _, buff in pairs(type(hit) == "table" and type(hit.buffs) == "table" and hit.buffs or {}) do
						local rate = type(buff) == "table" and type(buff.params) == "table" and tonumber(buff.params.damage_rate)
						if rate then
							add(string.format("%s (%s%% of a hit for %ss, ticks on the server's clock)", STATUS[buff.name] or tostring(buff.name), tostring(math.floor(rate * 1000 + 0.5) / 10), tostring(buff.time or "?")))
						elseif type(buff) == "table" and STATUS[buff.name] then
							add(STATUS[buff.name] .. " on hit")
						end
					end
				end
			end
			for _, group in pairs(type(attack) == "table" and type(attack.spawn_unit) == "table" and attack.spawn_unit or {}) do
				for _, summon in pairs(type(group) == "table" and type(group.units_nonrandom) == "table" and group.units_nonrandom or {}) do
					local summonData = type(summon) == "table" and Units[summon.unit]
					if not summonData then
						add("its summons (no numbers here)")
					elseif not summonData.death_attack then
						add("how long its summons stay alive")
					end
				end
			end
		end
		local kind = data._base_damage_type == "magic" and "magic" or "physical"
		if (tonumber(data[kind .. "_crit_chance"]) or 0) > 0 and not data[kind .. "_crit_damage"] then
			add("the size of its critical hits")
		end
		return list
	end

	local function traitSig(unit)
		local parts = {}
		for slot, entry in pairs(type(unit.traits) == "table" and unit.traits or {}) do
			table.insert(parts, tostring(slot) .. (type(entry) == "table" and (tostring(entry.trait) .. tostring(entry.tier)) or tostring(entry)))
		end
		table.sort(parts)
		return table.concat(parts, ",")
	end
	---Everything a rating depends on. A rating is kept until this string changes.
	local function signature(unit)
		local real = AA.realRecord(unit)
		local stats = type(real.trait_stats) == "table" and real.trait_stats or {}
		local level = AA.targetLevel
		return table.concat({
			tostring(unit.unit_id),
			tostring(unit.xp or 0),
			traitSig(unit),
			tostring(stats.potency_stat), tostring(stats.speed_stat), tostring(stats.range_stat),
			tostring(unit._equipped_relic),
			tostring(unit.shiny),
			tostring(AA.measureStamp or 0),
			tostring(Eval.stamp),
			tostring(type(level) == "table" and level.id or Match.levelId or ""),
			tostring(Config.MaxPerUnit),
			tostring(Match.pace or ""),
			tostring(math.floor(os.clock() / 120)),
		}, "|")
	end
	---Drop what is kept for one copy (its traits or stats changed), or for every copy.
	function Eval.forget(uuid)
		if uuid == nil then
			Eval.stamp += 1
			Eval.cache = {}
			return
		end
		Eval.cache[tostring(uuid)] = nil
		local owned = collectionData().owned_units
		local unit = type(owned) == "table" and owned[tostring(uuid)]
		if unit then
			statCache[unit] = nil
		end
	end

	---The rating of one owned copy:
	---  kind      "calculated" | "measured" | "partial" | "unknown" | "support" | "farm"
	---  paper     damage a second on paper (one copy, one enemy)
	---  play      the ranking number (unitPower)
	---  hit, cooldown, range, hits, crit   what the paper number is made of
	---  factor    measured damage / paper damage, when a match has measured it
	---  gaps      what could not be calculated
	function Eval.of(unit)
		if type(unit) ~= "table" then
			return { kind = "unknown", paper = 0, play = 0, gaps = {}, name = "?" }
		end
		local uuid = tostring(unit.uuid)
		local sig = signature(unit)
		local kept = Eval.cache[uuid]
		if kept and kept.sig == sig then
			return kept.value
		end
		local data = Units[unit.unit_id]
		local value = { id = unit.unit_id, name = tostring(data and data.name or unit.unit_id), kind = "unknown", paper = 0, play = 0, factor = 1, gaps = {} }
		if data then
			local level = data.upgrade and #data.upgrade or 0
			local base = unitStatsAt(data, level)
			value.level = level
			if base.farm > 0 then
				value.kind = "farm"
				value.income = base.farm * statMul(unit, "farm_amount")
			elseif base.damage <= 0 then
				if AA.buffInfo(data) or data._NO_ATTACKS_UNIT or AA.synergyInfo(unit.unit_id) then
					value.kind = "support"
				else
					value.why = IS_LOBBY and "The lobby does not carry this unit's numbers. They are saved the next time you are in a match." or "The game data has no damage for this unit."
				end
			else
				local hits = hitsPerAttack(data, level)
				local chance, size = AA.critOf(data, unit)
				value.hits = hits
				value.hit = base.damage * hits * statMul(unit, "damage")
				value.cooldown = math.max(base.cooldown * statMul(unit, "attack_cooldown"), 0.1)
				value.range = base.range * statMul(unit, "range")
				value.crit = chance
				value.paper = value.hit / value.cooldown * (1 + chance * (size or 0))
				local play, measured = unitPower(unit.unit_id, unit)
				value.play = play
				value.gaps = Eval.gaps(data)
				if measured then
					value.kind = "measured"
					value.factor = AA.measureFactor(unit.unit_id)
					if not (AA.scriptedUnit(data) or data._fromCache or AA.isSummoner(unit.unit_id)) then
						-- (The same limits unitPower puts on a unit with plain attack data.)
						value.factor = math.clamp(value.factor, 0.6, 1.6)
					end
				else
					value.kind = #value.gaps > 0 and "partial" or "calculated"
				end
			end
		end
		Eval.cache[uuid] = { sig = sig, value = value }
		return value
	end

	function Eval.short(number)
		number = tonumber(number) or 0
		if number >= 1e9 then
			return string.format("%.2fB", number / 1e9)
		elseif number >= 1e6 then
			return string.format("%.2fM", number / 1e6)
		elseif number >= 1e4 then
			return (string.format("%.1fk", number / 1e3):gsub("%.0k$", "k"))
		end
		return tostring(math.floor(number + 0.5))
	end
	---How the number was arrived at, in a few words.
	function Eval.basis(value)
		if value.kind == "measured" then
			return string.format("measured, %sx the calculation", tostring(math.floor(value.factor * 10 + 0.5) / 10))
		elseif value.kind == "calculated" then
			return "calculated"
		elseif value.kind == "partial" then
			return "at least"
		elseif value.kind == "farm" then
			return "income"
		elseif value.kind == "support" then
			return "support"
		end
		return "no numbers yet"
	end
	---The equipped team and the strongest copies left out, rated: { team = {...}, bench = {...} }.
	---Each row: { uuid, value, slot }.
	function Eval.report(benchSize)
		local data = collectionData()
		local owned = data.owned_units or {}
		local team, on = {}, {}
		for slot, uuid in pairs(data.equipped_units or {}) do
			local unit = owned[uuid]
			if unit then
				on[uuid] = true
				table.insert(team, { uuid = uuid, slot = tonumber(slot) or 99, value = Eval.of(unit) })
			end
		end
		table.sort(team, function(a, b)
			return a.slot < b.slot
		end)
		local best = {}
		for uuid, unit in pairs(owned) do
			if not on[uuid] then
				local value = Eval.of(unit)
				local shown = best[unit.unit_id]
				if value.play > 0 and (not shown or value.play > shown.value.play) then
					best[unit.unit_id] = { uuid = uuid, value = value }
				end
			end
		end
		local bench = {}
		for id, row in pairs(best) do
			local equippedTwin = false
			for _, member in ipairs(team) do
				equippedTwin = equippedTwin or member.value.id == id
			end
			if not equippedTwin then
				table.insert(bench, row)
			end
		end
		table.sort(bench, function(a, b)
			return a.value.play > b.value.play
		end)
		for index = #bench, (benchSize or 3) + 1, -1 do
			bench[index] = nil
		end
		return { team = team, bench = bench }
	end

	-- Measured numbers from before the sheet counted lingering areas (aoe_dot): the factor of a
	-- unit with one was measured against a smaller paper number and would now count it twice.
	if AA.measuredVersion ~= 6 then
		for key in pairs(AA.Measured) do
			local data = Units[(key:gsub("[#@].*$", ""))]
			local lingering = false
			for _, attackId in ipairs(data and attacksOf(data) or {}) do
				local attack = Attacks[attackId]
				lingering = lingering or (type(attack) == "table" and type(attack.aoe_dot) == "table" and next(attack.aoe_dot) ~= nil)
			end
			if lingering then
				AA.Measured[key] = nil
			end
		end
		AA.measuredVersion = 6
		AA.saveMeasured()
	end
end

---How much of the path one attack from this spot hits, and the best way to face.
-- Circles / targeted splash: path inside range. Lines and cones aim at an enemy in range and hit
-- everything along that direction, so they score best at the end of a straight stretch, facing up it.
local function shapeScore(position, shape, nearby)
	local px, pz = position.X, position.Z
	if shape.kind == "circle" or shape.kind == "target" then
		local reach = shape.range + (shape.kind == "target" and (shape.splash or 0) * 0.3 or 0)
		local reach2 = reach * reach
		local score = 0
		for _, point in ipairs(nearby) do
			if point.d2 <= reach2 then
				score += point.weight
			end
		end
		return score, nil
	end
	local range2 = shape.range * shape.range
	local best, bestDirection = 0, nil
	-- Every aim against every road sample is n squared per spot: on a big map with a dense road
	-- (The Holy Warlord: 3,200 samples, 6,600 spots) one unit took 19 s to place and the game
	-- crawled for the whole opening. At most 16 aims and 96 samples per spot, weights scaled up.
	local count = #nearby
	local aimStep = math.max(2, math.ceil(count / 16))
	local pointStep = math.max(1, math.ceil(count / 96))
	local isLine, halfWidth, cosHalf = shape.kind == "line", (shape.width or 0) / 2, math.cos(shape.half or 0)
	for i = 1, count, aimStep do
		local aim = nearby[i]
		if aim.d2 <= range2 and aim.d2 > 0.25 then
			local length = math.sqrt(aim.d2)
			local ux, uz = aim.dx / length, aim.dz / length
			local score = 0
			for j = 1, count, pointStep do
				local point = nearby[j]
				local along = point.dx * ux + point.dz * uz
				if isLine then
					if along >= 0 and along <= shape.length and math.abs(point.dx * uz - point.dz * ux) <= halfWidth then
						score += point.weight
					end
				elseif along > 0 and point.d2 <= range2 and along >= cosHalf * math.sqrt(point.d2) then
					score += point.weight
				end
			end
			score *= pointStep
			if score > best then
				best, bestDirection = score, Vector3.new(ux, 0, uz)
			end
		end
	end
	return best, bestDirection
end

---Best free spot for a unit, judged by the attack it has now and the one it will have when maxed.
local function countPlacedId(unitId)
	local n = 0
	for _, unit in ipairs(myUnits()) do
		if unit._stats.id.Value == unitId then
			n += 1
		end
	end
	return n
end

---Where a damage unit has to stand so the team's buff chain (Windsong, Commander) reaches it.
---Chain down: inside every copy's range. Before it: close to the densest group of units of the
---boosted type, tight enough that a chain built in the middle of the group still covers all of it.
---(Logs: Shadow Sorcerers 70 studs from the Windsongs, which only covered Elyssia.)
---Returns a list of { position, radius } circles a spot must be inside (nil = no buffer for this
---unit), and the widest gap to the road the group's shortest-ranged member can live with.
local function buffHub(data)
	if not data or not data.id or AA.buffInfo(data) then
		return nil
	end
	local buffer, buff
	for _, entry in ipairs(equippedUnits()) do
		local info = AA.buffInfo(entry.data)
		if info and AA.buffMatches(info, data) then
			buffer, buff = entry, info
		end
	end
	if not buffer then
		return nil
	end
	local reach = AA.buffRange(buffer.data, buffer.unit, buff) - 0.7
	local chain, friends = {}, {}
	local placedIds = {}
	for _, entry in ipairs(equippedUnits()) do
		placedIds[entry.id] = true
	end
	for _, unit in ipairs(myUnits()) do
		local allyId = unit._stats.id.Value
		local allyData = Units[allyId]
		if allyId == buffer.id then
			-- (The range it has in this match can be wider than the sheet says: cards.)
			local live = unit._stats:FindFirstChild("range")
			table.insert(chain, { position = unit:GetPivot().Position, radius = reach, live = live and AA.rv(live) or 0 })
		elseif placedIds[allyId] and allyData and AA.buffMatches(buff, allyData) and not AA.buffInfo(allyData) and (unitStatsAt(allyData, 0).damage > 0 or AA.isSummoner(allyId)) then
			table.insert(friends, unit:GetPivot().Position)
		end
	end
	if #chain > 0 then
		-- Copies that reach none of the damage are the feeders (they buff the casting copies,
		-- see Conductor.step): a damage unit inside a feeder's range would take the feed and
		-- then ignore the full cast, so it stands inside the casting copies' range and clear
		-- of the feeders'.
		local hub, clear = {}, {}
		for _, circle in ipairs(chain) do
			local reaches = false
			for _, friend in ipairs(friends) do
				local dx, dz = friend.X - circle.position.X, friend.Z - circle.position.Z
				if dx * dx + dz * dz + (friend.Y - circle.position.Y) ^ 2 <= (reach + 1.7) ^ 2 then
					reaches = true
					break
				end
			end
			if reaches then
				table.insert(hub, circle)
			else
				table.insert(clear, { position = circle.position, radius = math.max(reach + 3.2, circle.live + 2.5), avoid = true })
			end
		end
		if #hub == 0 then
			return chain
		end
		for _, circle in ipairs(clear) do
			table.insert(hub, circle)
		end
		return hub
	end
	local shortest = math.huge
	for _, entry in ipairs(equippedUnits()) do
		if entry.id ~= buffer.id and AA.buffMatches(buff, entry.data) and not AA.buffInfo(entry.data) then
			local range = unitStatsAt(entry.data, 0).range
			if range > 0 and (unitStatsAt(entry.data, 0).damage > 0 or AA.isSummoner(entry.id)) then
				shortest = math.min(shortest, range)
			end
		end
	end
	if #friends == 0 then
		-- The first of the group picks the place: close enough to the road for all of them.
		return {}, shortest < math.huge and math.max(shortest * 0.6, 4) or nil
	end
	local radius = reach * 0.55
	local anchor, most = friends[1], -1
	for _, a in ipairs(friends) do
		local close = 0
		for _, b in ipairs(friends) do
			if (a - b).Magnitude <= radius then
				close += 1
			end
		end
		if close > most then
			anchor, most = a, close
		end
	end
	return { { position = anchor, radius = radius } }
end
---The best-scoring spot among those that see, at the range the unit starts with, at least 80%
---of what the best spot sees at that range. (Scored mostly on her final range, the Zombie went
---17 studs back: 36 road points at level 0 against 70. She dealt 1.6M, the cash rule read that
---as a weak unit and left her at level 1 for the whole run; the run before she dealt 149M.)
function AA.pickCovered(found)
	local most = 0
	for _, row in ipairs(found) do
		most = math.max(most, row.early)
	end
	local best, bestScore = nil, -math.huge
	for _, row in ipairs(found) do
		if row.early >= most * 0.8 and row.score > bestScore then
			best, bestScore = row.spot, row.score
		end
	end
	return best
end
---`loose`: the circles to keep clear of (feeders) don't count.
local function insideHub(p, circles, loose)
	for _, circle in ipairs(circles) do
		local dx, dz = circle.position.X - p.X, circle.position.Z - p.Z
		if circle.avoid then
			if not loose and dx * dx + dz * dz < circle.radius * circle.radius then
				return false
			end
		elseif dx * dx + dz * dz + (circle.position.Y - p.Y - 1.3) ^ 2 > circle.radius * circle.radius then
			-- (3D: a buffer up on a hill reaches less of the ground than its circle on the map.)
			return false
		end
	end
	return true
end

---Maps with two or three roads: a spot is worth the square of the share of the roads it reaches
---(a road counts as reached with a dozen studs of it in range; a road that is still closed
---counts too, it opens later). On Sky Island the three roads start a hundred studs apart and
---only run together for the last stretch before the base: a team placed at the front of one
---road, which is where the single-road rules put it, never touched what came down the others,
---and the wave-20 boss walked to the base past units that had held their own road all match.
function AA.laneShare(hits)
	local count = Match.laneCount or 1
	if count <= 1 then
		return 1
	end
	local reached = 0
	for lane = 1, count do
		if (hits[lane] or 0) >= 12 then
			reached += 1
		end
	end
	return math.max(reached / count, 0.2) ^ 2
end

---What a unit's damage is worth against this match's enemies in the air. "Flying enemies take
---50% less damage from ground attacks without Anti-Air": a unit on a hill, or one whose attack
---has Anti-Air at that level, loses nothing; any other loses half of what it deals to the share
---of the enemies that fly. `unit` is the placed tower (nil for a unit still in the hand).
function AA.airFactor(data, unit, level)
	local share = Match.flyShare or 0
	if share < 0.1 or not data then
		return 1
	end
	if data.hill_unit or data.hybrid_placement then
		return 1
	end
	if unit then
		if unit:GetAttribute("_on_hill") == true then
			return 1
		end
		local unlocks = tostring(unit:GetAttribute("_anti_air_upgrades") or "")
		for entry in unlocks:gmatch("%d+") do
			if tonumber(entry) <= (level or 0) then
				return 1
			end
		end
		if unit:GetAttribute("_anti_air") == true and (level or 0) <= unit._stats.upgrade.Value then
			return 1
		end
	end
	return 1 - 0.5 * share
end

---Are there Soaring enemies in this match? ("Soaring enemies only take damage from Hill
---units": Sky Portals, and weather cards that turn flyers into soaring ones.)
function AA.soaringMatch()
	if Match.soaring then
		return true
	end
	local level = (tostring(Match.levelId or "") .. " " .. tostring((Match.levelData or {}).name or "")):lower()
	return level:find("sky", 1, true) ~= nil
end

local function bestSpot(data, focus, only)
	if Match.spots and Match.spotsRoad ~= Config.RoadSpots then
		Match.spots = nil
	end
	local spots = Match.spots or buildSpots()
	if not spots then
		return nil
	end
	if data.hybrid_placement and not data.hill_unit and not only and not focus then
		-- Units that can stand on both (Dark Mage, Phoenix, Illusionist (Transcended), Elfy):
		-- the best hill spot. A unit on a hill reaches Soaring enemies, which nothing on the
		-- ground can touch, hits flyers at full damage, and leaves the ground by the road to
		-- the units that have no choice. With Soaring enemies in the match the hill always
		-- wins; without them it wins unless it sees less than half the road the best ground
		-- spot does (a buffer: unless it covers noticeably less of the team).
		local hillSpot, hillDirection = bestSpot(data, focus, "hill")
		local hillScore, hillKind = Match.spotScore, Match.spotKind
		if hillSpot then
			if AA.soaringMatch() and not AA.buffInfo(data) then
				return hillSpot, hillDirection
			end
			local groundSpot, groundDirection = bestSpot(data, focus, "ground")
			local groundScore = Match.spotScore
			if groundSpot and Match.spotKind == "feeder" and hillKind ~= "feeder" then
				-- A feeding spot (in reach of the casting copies, clear of the damage) exists
				-- on the ground and not on the hill: that is worth more than the hill. (All
				-- four Elfys went up one hill together and the full buff took 150 s to start.)
				return groundSpot, groundDirection
			end
			local need = (AA.buffInfo(data) or (data.id and AA.synergyInfo(data.id))) and 0.9 or 0.5
			if not groundSpot or not hillScore or not groundScore or hillScore >= groundScore * need then
				return hillSpot, hillDirection
			end
			return groundSpot, groundDirection
		end
		only = "ground"
	end
	Match.spotScore, Match.spotKind = nil, nil
	local pool
	if data.hill_unit or only == "hill" then
		pool = { spots.hill }
	elseif data.hybrid_placement and only ~= "ground" then
		pool = { spots.ground, spots.hill }
	else
		pool = { spots.ground }
	end
	local maxLevel = data.upgrade and #data.upgrade or 0
	local taken = placedUnitPositions()
	-- The range my copy really has: the sheet's range times its trait and stat bonuses. (The
	-- sheet alone says 30 for a maxed Shadow Sorcerer that reaches 39, and every unit was
	-- scored, and kept close to the road, as if it had the smaller circle.)
	local rangeMul = 1
	for _, entry in ipairs(equippedUnits()) do
		if entry.id == data.id then
			local mul = statMul(entry.unit, "range")
			if type(mul) == "number" and mul == mul then
				rangeMul = math.clamp(mul, 1, 2)
			end
		end
	end
	-- Units that never attack (farms like C.E.O.) go on the sidelines: as far from the road as the
	-- map allows, packed together, so road-side spots stay free for damage units.
	local attacks = false
	for level = 0, maxLevel do
		if unitStatsAt(data, level).dps > 0 then
			attacks = true
		end
	end
	local activeBuff = AA.buffInfo(data)
	local aura = data.id and AA.synergyInfo(data.id)
	if aura and (aura.stacks or countPlacedId(data.id) > 0) then
		aura = nil
	end
	if not focus and (activeBuff or aura or (not attacks and (data.aura_buff or data.buffs))) then
		-- Buffers: where the most damage of the type they boost sits inside their range, and
		-- (for the chain) inside the range of every copy that is already down.
		local mine
		for _, entry in ipairs(equippedUnits()) do
			if entry.id == data.id then
				mine = entry.unit
			end
		end
		local range = activeBuff and AA.buffRange(data, mine, activeBuff) - 0.7 or aura and math.max(unitStatsAt(data, 0).range * 0.9, 6) or math.max(unitStatsAt(data, maxLevel).range, 6)
		local allies, partners, anchors = {}, {}, {}
		local liveRange, liveLow = 0, math.huge
		local placedIds = {}
		for _, entry in ipairs(equippedUnits()) do
			placedIds[entry.id] = true
		end
		for _, unit in ipairs(myUnits()) do
			local allyId = unit._stats.id.Value
			local allyData = Units[allyId]
			if activeBuff and allyId == data.id then
				table.insert(partners, unit:GetPivot().Position)
				local live = unit._stats:FindFirstChild("range")
				liveRange = math.max(liveRange, live and AA.rv(live) or 0)
				liveLow = math.min(liveLow, live and AA.rv(live) or math.huge)
			elseif allyData and (unitStatsAt(allyData, 0).damage > 0 or activeBuff and placedIds[allyId] and AA.isSummoner(allyId)) and (not activeBuff or AA.buffMatches(activeBuff, allyData))
				and (not aura or (allyId ~= data.id and aura.matches(allyId, allyData))) then
				local weight = activeBuff and math.max(copyPower(allyData, ownedOf(unit), unit._stats.upgrade.Value) * AA.measureFactor(allyId), 1) or 1
				table.insert(allies, { position = unit:GetPivot().Position, weight = weight })
				if activeBuff and placedIds[allyId] and not AA.buffInfo(allyData) then
					table.insert(anchors, unit:GetPivot().Position)
				end
			end
		end
		if activeBuff and liveLow < math.huge then
			-- The copies already down show the range the buff has in THIS match (cards move
			-- it both ways): never plan with more than the shortest of them.
			range = math.min(range, liveLow - 0.7)
		end
		if activeBuff and #partners > 0 then
			for _, ally in ipairs(allies) do
				local reachedBy = 0
				for _, partner in ipairs(partners) do
					if (ally.position - partner).Magnitude <= range + 0.7 then
						reachedBy += 1
					end
				end
				ally.need = reachedBy == 0 and 1 or reachedBy == 1 and 0.6 or 0.15
			end
		end
		-- (Not while a damage unit stands outside every copy's reach: covering it comes first.)
		local uncovered = false
		for _, anchor in ipairs(anchors) do
			local reached = false
			for _, partner in ipairs(partners) do
				if (anchor - partner).Magnitude <= math.max(range + 0.7, liveRange) then
					reached = true
					break
				end
			end
			if not reached then
				uncovered = true
				break
			end
		end
		if activeBuff and #partners > 0 and #anchors > 0 and not uncovered and math.min(AA.buffCopies(activeBuff, data), placeCap(data)) >= 3 then
			-- The full buff needs a copy that buffs the casting copy without touching the damage
			-- (see Conductor.step). Every second copy therefore goes where it reaches the casting
			-- copies and none of the damage units: then the full buff starts a second after the
			-- pair is down instead of 30 s later. No such ground: it joins the others inside.
			-- (The copies already down show the range the buff really has in this match.)
			local full = math.max(range + 0.7, liveRange)
			local mains, feedersDown = {}, 0
			for _, partner in ipairs(partners) do
				local reaches = false
				for _, anchor in ipairs(anchors) do
					local dx, dz = anchor.X - partner.X, anchor.Z - partner.Z
					if dx * dx + dz * dz + (anchor.Y - partner.Y) ^ 2 <= (full + 1) ^ 2 then
						reaches = true
						break
					end
				end
				if reaches then
					table.insert(mains, partner)
				else
					feedersDown += 1
				end
			end
			if #mains > feedersDown then
				local best, bestScore = nil, -math.huge
				local near, far = (range - 1.5) ^ 2, (full + 2.5) ^ 2
				for _, list in ipairs(pool) do
					for _, spot in ipairs(list) do
						local p = spot.position
						if not Match.badSpots[spotKey(p)] then
							local free = true
							for _, other in ipairs(taken) do
								local dx, dz = other.X - p.X, other.Z - p.Z
								if dx * dx + dz * dz < 4.4 then
									free = false
									break
								end
							end
							local spread = 0
							if free then
								for _, main in ipairs(mains) do
									local dx, dz = main.X - p.X, main.Z - p.Z
									local d2 = dx * dx + dz * dz + (main.Y - p.Y - 1.3) ^ 2
									if d2 > near then
										free = false
										break
									end
									spread += math.sqrt(d2)
								end
							end
							local nearest = math.huge
							if free then
								for _, anchor in ipairs(anchors) do
									local dx, dz = anchor.X - p.X, anchor.Z - p.Z
									local d2 = dx * dx + dz * dz
									if d2 < far then
										free = false
										break
									end
									nearest = math.min(nearest, d2)
								end
							end
							if free then
								-- Well clear of the damage (room for the units still to come inside the
								-- casting copies' range), off the kerb, close to the casting copies.
								local score = math.min(math.sqrt(nearest) - full, 14) + math.min(spot.gap, 20) * 0.02 - spread / #mains * 0.03
								for _, ally in ipairs(allies) do
									local dx, dz = ally.position.X - p.X, ally.position.Z - p.Z
									if dx * dx + dz * dz <= full * full then
										-- A summon in reach (an eel, a Warlord) would take the feed too.
										score -= 3
									end
								end
								if score > bestScore then
									best, bestScore = spot, score
								end
							end
						end
					end
				end
				if best then
					Match.feederSpots = (Match.feederSpots or 0) + 1
					Match.spotKind = "feeder"
					return best
				end
			end
		end
		local total = 0
		for _, ally in ipairs(allies) do
			total += ally.weight
		end
		-- Other players' units of the boosted type count too (the cast hits every ally in range):
		-- they never outweigh my own team, they decide between spots that cover mine equally.
		local guests, guestTotal = {}, 0
		if activeBuff then
			for _, unit in ipairs(scanField().others) do
				local guestStats = unit:FindFirstChild("_stats")
				local guestData = guestStats and guestStats:FindFirstChild("id") and Units[guestStats.id.Value]
				if guestData and AA.buffMatches(activeBuff, guestData) and not AA.buffInfo(guestData) and unitStatsAt(guestData, 0).damage > 0 then
					local level = guestStats:FindFirstChild("upgrade") and guestStats.upgrade.Value or 0
					local weight = math.max(copyPower(guestData, nil, level), 1)
					table.insert(guests, { position = unit:GetPivot().Position, weight = weight })
					guestTotal += weight
				end
			end
		end
		local best, bestScore = nil, 0
		for _, list in ipairs(pool) do
			for _, spot in ipairs(list) do
				local p = spot.position
				if not Match.badSpots[spotKey(p)] then
					local free, score = true, 0
					for _, other in ipairs(taken) do
						local dx, dz = other.X - p.X, other.Z - p.Z
						if dx * dx + dz * dz < 4.4 then
							free = false
							break
						end
					end
					-- In reach of at least one other copy (they feed each other), the closer to all
					-- of them the better. (It had to be in reach of EVERY copy: after a card
					-- shrank the range, two copies stood out of everyone's reach and nothing
					-- could be placed any more, because no spot reached them and the rest.)
					local spread, linked = 0, #partners == 0
					for _, partner in ipairs(partners) do
						local dx, dz = partner.X - p.X, partner.Z - p.Z
						local d2 = dx * dx + dz * dz + (partner.Y - p.Y - 1.3) ^ 2
						if d2 <= range * range then
							linked = true
						end
						spread += math.min(math.sqrt(d2), range * 2)
					end
					if not linked then
						free = false
					end
					if free then
						for _, ally in ipairs(allies) do
							local dx, dz = ally.position.X - p.X, ally.position.Z - p.Z
							local d2 = dx * dx + dz * dz + (ally.position.Y - p.Y - 1.3) ^ 2
							if d2 <= range * range then
								-- (A unit at the very edge of the range drops out with the first
								-- card that costs range: comfortably inside counts for more. And a
								-- unit no copy reaches yet counts in full, one a single copy reaches
								-- for most, since it only gets every second cast, one that two
								-- reach already for little.)
								score += ally.weight / math.max(total, 1) * (d2 <= (range * 0.85) ^ 2 and 1 or 0.6) * (ally.need or 1)
							end
						end
						for _, guest in ipairs(guests) do
							local dx, dz = guest.position.X - p.X, guest.position.Z - p.Z
							if dx * dx + dz * dz + (guest.position.Y - p.Y - 1.3) ^ 2 <= range * range then
								score += 0.3 * guest.weight / math.max(guestTotal, 1)
							end
						end
						if #partners > 0 then
							-- Copies of the chain only need each other: tight together, so the
							-- same allies stay inside every copy's range.
							score += 0.5 + 0.12 * math.max(1 - spread / #partners / range, -1)
						end
						score += spot.gap * 0.0001
						if score > bestScore then
							best, bestScore = spot, score
						end
					end
				end
			end
		end
		if best and (activeBuff and (bestScore >= 0.2 or #partners > 0) or aura and bestScore >= 0.99 or not (activeBuff or aura)) then
			Match.spotScore = bestScore
			return best
		end
		if activeBuff and #partners > 0 then
			-- No free ground inside the chain's range: better no copy than one that can't link up.
			return nil
		end
	end
	if not attacks and not focus and not data.aura_buff and not data.buffs and not data.spawn_unit and not activeBuff then
		local best, bestScore = nil, -math.huge
		for _, list in ipairs(pool) do
			for _, spot in ipairs(list) do
				local p = spot.position
				if not Match.badSpots[spotKey(p)] then
					local free, nearest = true, math.huge
					for _, other in ipairs(taken) do
						local dx, dz = other.X - p.X, other.Z - p.Z
						local d2 = dx * dx + dz * dz
						if d2 < 4.4 then
							free = false
							break
						end
						nearest = math.min(nearest, d2)
					end
					if free then
						-- Far from the road first; among equals, tuck in next to what's already placed.
						local score = spot.gap * 10 - (nearest < math.huge and math.sqrt(nearest) * 0.05 or 0)
						if score > bestScore then
							best, bestScore = spot, score
						end
					end
				end
			end
		end
		return best
	end
	if not focus and data.id and AA.isSummoner(data.id) then
		-- A summoner whose damage type a team buffer boosts stands inside the buff chain: her
		-- explosions take their damage from her, and the eels she calls appear next to her.
		-- With the chain down: inside every copy's range. Before it: next to the damage units
		-- of that type, which is where the chain will be built.
		local circles = buffHub(data)
		if circles then
			if #circles > 0 then
				-- Inside the buff, the spot that sees the most road: her own range is what her
				-- explosions and attacks reach. (She used to go to the middle of the buffers, the
				-- spot closest to all of them. On Summer Hunt's first map that was 109 of the
				-- road's 303 points for the Zombie and 137 for the Shadow Sorcerers, with 120
				-- and 159 on offer a few studs further back, still inside every buffer's range.)
				-- Scored at the range she starts with and the range she ends with, like every other
				-- unit (one in-between circle misses a road that lies right at its edge).
				local own = math.max(unitStatsAt(data, 0).range, unitStatsAt(data, maxLevel).range, 6) * rangeMul
				local early2 = (unitStatsAt(data, 0).range * rangeMul) ^ 2
				local hubLanes = (Match.laneCount or 1) > 1 and AA.laneWeights(myUnits()) or nil
				local hubBand = Match.pace ~= "speed" and not hubLanes and AA.fightBand() or nil
				for attempt = 1, 2 do
					local found = {}
					local seen, sliceAt = 0, os.clock()
					for _, list in ipairs(pool) do
						for _, spot in ipairs(list) do
							local p = spot.position
							if not Match.badSpots[spotKey(p)] and insideHub(p, circles, attempt == 2) then
								seen += 1
								if seen % 25 == 0 and os.clock() - sliceAt > 0.006 then
									task.wait()
									sliceAt = os.clock()
								end
								local free = true
								for _, other in ipairs(taken) do
									local dx, dz = other.X - p.X, other.Z - p.Z
									if dx * dx + dz * dz < 4.4 then
										free = false
										break
									end
								end
								if free then
									local total, count = 0, 0
									for _, circle in ipairs(circles) do
										if not circle.avoid then
											total += (Vector3.new(circle.position.X, p.Y, circle.position.Z) - p).Magnitude
											count += 1
										end
									end
									local sum, early = 0, 0
									local laneHits = {}
									pathWithin(p.X, p.Z, own, function(point, _, _, d2)
										-- (Range is measured in 3D: a unit on a tall hill reaches less road.)
										d2 += (point.position.Y - p.Y) ^ 2
										if d2 > own * own then
											return
										end
										local weight
										laneHits[point.lane] = (laneHits[point.lane] or 0) + 1
										if Match.pace == "speed" and not hubLanes then
											local zone = killZone(point.lane)
											weight = point.progress <= zone and 4 * (1 - point.progress / zone * 0.8) or 0.1
										else
											weight = 1 + (1 - point.progress) * 0.25
											if hubBand and point.progress > hubBand + 0.05 then
												weight *= math.max(0.15, math.exp(-(point.progress - hubBand - 0.05) / 0.2))
											end
										end
										if hubLanes then
											weight *= hubLanes[point.lane] or 1
										end
										if d2 <= early2 then
											early += weight
											sum += weight
										else
											sum += weight * 0.65
										end
									end)
									if hubLanes then
										local share = AA.laneShare(laneHits)
										sum, early = sum * share, early * share
									end
									table.insert(found, { spot = spot, early = early, score = sum - total / math.max(count, 1) * 0.05 - spot.gap * 0.02 })
								end
							end
						end
					end
					local best = AA.pickCovered(found)
					if best then
						return best
					end
					local anyAvoid = false
					for _, circle in ipairs(circles) do
						anyAvoid = anyAvoid or circle.avoid
					end
					if not anyAvoid then
						break
					end
				end
			end
		end
		-- Summoners: their summons walk the road from the base no matter where the unit stands, so
		-- they never take a front spot. Road still inside their range, as far down the path as it goes.
		local range = math.max(unitStatsAt(data, 0).range * rangeMul * 0.8, 6)
		local best, bestScore = nil, -math.huge
		local summonLanes = (Match.laneCount or 1) > 1 and AA.laneWeights(myUnits()) or nil
		local band = Match.pace ~= "speed" and not summonLanes and AA.fightBand() or nil
		-- How far her summons reach (eels: 71 studs, measured in the match and remembered); three
		-- times her own range until one has been seen.
		-- Never seen one that stands still (the Zombie's walk the road from the base, wherever
		-- she is): then only her own attack's reach counts, and she goes where that sees the
		-- most road. (Guessing three times her range put her where a 60-stud circle saw the
		-- most, with her own 32 studs on 109 of the road's 303 points and 126 free nearby.)
		local knownReach = type(AA.progress.summonRange) == "table" and tonumber(AA.progress.summonRange[data.id]) or nil
		local ownLater = math.max(unitStatsAt(data, 0).range, unitStatsAt(data, maxLevel).range) * rangeMul
		local summonReach = math.max(knownReach and math.clamp(knownReach, range, 75) or 0, ownLater, range)
		local ownReach2 = (unitStatsAt(data, 0).range * rangeMul) ^ 2
		local seenSpots, sliceAt = 0, os.clock()
		local found = {}
		for _, list in ipairs(pool) do
			for _, spot in ipairs(list) do
				local p = spot.position
				seenSpots += 1
				if seenSpots % 25 == 0 and os.clock() - sliceAt > 0.006 then
					task.wait()
					sliceAt = os.clock()
				end
				if spot.gap <= range and not Match.badSpots[spotKey(p)] then
					local free = true
					for _, other in ipairs(taken) do
						local dx, dz = other.X - p.X, other.Z - p.Z
						if dx * dx + dz * dz < 4.4 then
							free = false
							break
						end
					end
					if free then
						local progress = spot.progress or 0
						-- Strong enemies: middle of the road (clear of the kill zone and of the base guard
						-- spots), off the kerb. Weak enemies: the very front, like everything else. A
						-- summoner at 70% took the whole buff group with her, and Shadow Sorcerers at
						-- the far end of the road did no damage at all while everything died at the spawn.
						-- In long matches: just past where enemies usually die (never past 60%).
						local aim = Match.pace == "speed" and (Match.laneJunction and Match.laneJunction[spot.lane] or 0.02) or (band and math.clamp(band + 0.1, 0.3, 0.6) or 0.6)
						local score = -math.abs(progress - aim) * 10 + math.min(spot.gap, range) * (Match.pace == "speed" and -0.05 or 0.1)
						local early = 0
						if summonLanes then
							-- Her summons work the road she stands on: the road that needs it most,
							-- never one that is still closed.
							score += ((summonLanes[spot.lane] or 1) - 1) * 3
						end
						if Match.pace ~= "speed" or summonLanes then
							-- Strong enemies: where she and her summons reach the most road that
							-- enemies actually walk. She is the first unit down and the buffers and
							-- the rest of the damage follow her, so her spot decides what the whole
							-- team can hit. (The old rule put her at a fixed share of the way down
							-- the road: on Summer Hunt's city map that was an outside corner where
							-- a 55-stud reach saw 110 of the road's 271 studs. The inside of the bend
							-- 50 studs away, where the user was standing, sees 219.)
							local sum = 0
							local reach2 = summonReach * summonReach
							local laneHits = {}
							pathWithin(p.X, p.Z, summonReach, function(point, _, _, d2)
								d2 += (point.position.Y - p.Y) ^ 2
								if d2 <= reach2 then
									laneHits[point.lane] = (laneHits[point.lane] or 0) + 1
									local weight = 1 + (1 - point.progress) * 0.25
									if band and point.progress > band + 0.05 then
										weight *= math.max(0.15, math.exp(-(point.progress - band - 0.05) / 0.2))
									end
									if summonLanes then
										weight *= summonLanes[point.lane] or 1
									end
									if knownReach then
										if d2 <= ownReach2 then
											weight *= 1.5
										end
									elseif d2 > ownReach2 then
										-- Road only her upgraded range reaches.
										weight *= 0.65
									else
										early += weight
									end
									sum += weight
								end
							end)
							if summonLanes then
								local share = AA.laneShare(laneHits)
								sum, early = sum * share, early * share
							end
							score = sum - spot.gap * 0.05
						end
						table.insert(found, { spot = spot, early = early, score = score })
					end
				end
			end
		end
		best = AA.pickCovered(found)
		if best then
			return best
		end
	end
	local now, later = attackShape(data, 0), attackShape(data, maxLevel)
	if rangeMul > 1 then
		for _, shape in ipairs(now == later and { now } or { now, later }) do
			if shape.kind ~= "circle" then
				shape.range *= rangeMul
			end
		end
	end
	local reach = math.max(now.range, later.range, later.length or 0, now.length or 0, 2.5)
	local minReach = math.max(math.min(now.range, later.range) * 0.92, 2.5)
	local best, bestScore, bestDirection = nil, 0, nil
	local clusterAt
	if Match.longHaul and not focus then
		clusterAt = {}
		for _, unit in ipairs(myUnits()) do
			local allyData = Units[unit._stats.id.Value]
			if allyData and (unitStatsAt(allyData, 0).damage > 0 or AA.buffInfo(allyData)) and not AA.isSummoner(unit._stats.id.Value) then
				table.insert(clusterAt, unit:GetPivot().Position)
			end
		end
	end
	local circles, firstGap
	if not focus then
		circles, firstGap = buffHub(data)
		if circles and #circles == 0 then
			circles = nil
		end
	end
	-- Road that enemies rarely reach is worth little, whatever the pace: a Zombie placed at 48% of
	-- the road for its bends dealt nothing for eleven waves while everything died before 31%.
	-- (Known after six waves, or from the last run on this stage and map; nil = no idea yet.)
	local multi = (Match.laneCount or 1) > 1
	local reachBand = not focus and Match.pace ~= "speed" and not multi and AA.fightBand() or nil
	local laneWeight, openLanes = nil, Match.laneCount or 1
	if (Match.laneCount or 1) > 1 then
		laneWeight, openLanes = AA.laneWeights(myUnits())
	end
	local checked, sliceStart = 0, os.clock()
	-- Big maps (thousands of spots): every third spot first, then every spot around the best
	-- one. (The Holy Warlord has 6,600 ground spots; scoring all of them stalled the opening.)
	local total = 0
	for _, list in ipairs(pool) do
		total += #list
	end
	local stride = total > 2400 and 3 or 1
	for round = 1, 2 do
	local center = round == 2 and best and best.position or nil
	if round == 2 and (stride == 1 or not center) then
		break
	end
	for pass = 1, 3 do
	-- Pass 1 keeps the unit inside the buff group and clear of the feeding copies; pass 2
	-- (nothing free there) only inside the group; pass 3 takes any spot.
	local hub, gapLimit = pass < 3 and circles or nil, pass < 3 and firstGap or nil
	if pass > 1 and (best or not (circles or firstGap)) then
		break
	end
	for _, list in ipairs(pool) do
		for index, spot in ipairs(list) do
			local p = spot.position
			checked += 1
			if checked % 20 == 0 and os.clock() - sliceStart > 0.006 then
				task.wait()
				sliceStart = os.clock()
			end
			local take
			if center then
				local dx, dz = p.X - center.X, p.Z - center.Z
				take = dx * dx + dz * dz <= 100 and index % stride ~= 0
			else
				take = index % stride == 0
			end
			if take and spot.gap <= minReach and (not gapLimit or spot.gap <= gapLimit) and (not hub or insideHub(p, hub, pass == 2)) and not Match.badSpots[spotKey(p)] then
				local free = true
				for _, other in ipairs(taken) do
					local dx, dz = other.X - p.X, other.Z - p.Z
					if dx * dx + dz * dz < 4.4 then
						free = false
						break
					end
				end
				if free then
					local nearby = {}
					local laneHits = {}
					pathWithin(p.X, p.Z, reach, function(point, dx, dz, d2)
						-- Range is measured in 3D (an Elfy on a hill 16 studs above the team reached
						-- one unit of five that were inside her circle on the map).
						d2 += (point.position.Y - p.Y) ^ 2
						if point.lane and d2 <= minReach * minReach then
							laneHits[point.lane] = (laneHits[point.lane] or 0) + 1
						end
						do
							local weight
							if focus then
								weight = point.progress >= focus and 1 or 0
							elseif multi then
								-- Several roads: plain coverage. Where enemies died in earlier
								-- runs says where the team stood then, not where it should stand.
								weight = 1 + (1 - point.progress) * 0.25
							elseif Match.pace == "speed" then
								-- Weak waves die right at the spawn: put the damage there so each one
								-- dies the moment it appears. Road past the kill zone is nearly worthless.
								local zone = killZone(point.lane)
								weight = point.progress <= zone and 4 * (1 - point.progress / zone * 0.8) or 0.1
							elseif Match.longHaul then
								-- Long modes: plain road coverage (bends, loops), a little earlier is better.
								weight = 1 + (1 - point.progress) * 0.25
							elseif Config.PlaceStart then
								-- Kill them early: waves clear (and auto-skip) faster.
								weight = 1 + (1 - point.progress) * 0.6
							else
								weight = 1 + point.progress * 0.6
							end
							if laneWeight and not focus then
								weight *= laneWeight[point.lane] or 1
							end
							if reachBand and point.progress > reachBand + 0.05 then
								-- Later waves do get deeper, so it fades instead of cutting off:
								-- half at 14% of the road past the usual depth, never under 0.15.
								weight *= math.max(0.15, math.exp(-(point.progress - reachBand - 0.05) / 0.2))
							end
							table.insert(nearby, { dx = dx, dz = dz, d2 = d2, weight = weight })
						end
					end)
					local scoreNow, directionNow = shapeScore(p, now, nearby)
					local score, direction = scoreNow, directionNow
					if later ~= now and (later.kind ~= now.kind or later.range ~= now.range) then
						local scoreLater, directionLater = shapeScore(p, later, nearby)
						score = scoreNow * 0.35 + scoreLater * 0.65
						direction = directionLater or directionNow
					end
					score -= spot.gap * 0.05
					if (AA.killsMode() or AA.frontForced() or AA.Order.front()) and not focus and score > 0 then
						-- Kills mode: the spot nearest the spawn that still reaches the road, nothing
						-- else. (Coverage scoring settled the team at 11-31% of the road with two
						-- hundred free spots in the first 5%.)
						score = 1000 * (1 - (spot.progress or 0)) - spot.gap
					end
					if multi and score > 0 and not focus then
						-- Several roads: a spot that reaches all of them is worth far more than one
						-- that leaves a road's enemies to walk past untouched.
						score *= AA.laneShare(laneHits)
					end
					if clusterAt and score > 0 then
						-- Long modes: keep damage units together so one buffer / aura covers them all.
						local close = 0
						for _, ally in ipairs(clusterAt) do
							local dx, dz = ally.X - p.X, ally.Z - p.Z
							if dx * dx + dz * dz <= 196 then
								close += 1
							end
						end
						score *= 1 + 0.07 * math.min(close, 5)
					end
					if score > bestScore then
						best, bestScore, bestDirection = spot, score, direction
					end
				end
			end
		end
	end
	end
	end
	Match.spotScore = best and bestScore or nil
	return best, bestDirection
end

local function nearestPathPoint(position)
	local point = nearestPath(position)
	return point and point.position
end

local function countPlaced(unitId)
	local n = 0
	for _, unit in ipairs(myUnits()) do
		local id = unit._stats:FindFirstChild("id")
		if id and id.Value == unitId then
			n += 1
		end
	end
	return n
end

local function pathProgress(position)
	local point = nearestPath(position)
	return point and point.progress or 0
end

local function placeUnit(entry, focus)
	local spot, direction = bestSpot(entry.data, focus)
	if not spot then
		-- (Not for a base-guard placement: no free spot near the base says nothing about the
		-- rest of the map, and the unit was blocked everywhere for the wave.)
		if not focus then
			Match.capped[entry.uuid] = currentWave()
		end
		return false
	end
	local before = countPlaced(entry.id)
	local look = direction and (spot.position + direction) or nearestPathPoint(spot.position)
	local cf = look and CFrame.lookAt(spot.position, Vector3.new(look.X, spot.position.Y, look.Z)) or CFrame.new(spot.position)
	Match.lastSpawn = { id = entry.id, uuid = entry.uuid, at = os.clock() }
	AA.lastMessage = nil
	invoke("spawn_unit", entry.uuid, cf)
	Match.recent = Match.recent or {}
	table.insert(Match.recent, { position = spot.position, at = os.clock() })
	local deadline = os.clock() + 1.5
	while os.clock() < deadline and countPlaced(entry.id) <= before do
		task.wait(0.1)
	end
	if countPlaced(entry.id) > before then
		Match.failStreak[entry.uuid] = 0
		Stats.placed += 1
		Match.firstPlaceAt = Match.firstPlaceAt or (os.clock() - Match.startedAt)
		note("place", { u = entry.id, cash = math.floor(stats.resource.Value), p = math.floor(pathProgress(spot.position) * 100), guard = focus and true or nil })
		return true
	end
	note("placefail", { u = entry.id, msg = AA.lastMessage, x = math.floor(spot.position.X), z = math.floor(spot.position.Z), roof = spot.roof and math.floor(spot.roof * 10) / 10 or nil })
	if tostring(AA.lastMessage or ""):find("(Global)", 1, true) then
		-- A cap shared by every player in the server ("Cannot place more than 6 of this unit!
		-- (Global)"): the others hold the rest. Nothing wrong with the spot, and asking again
		-- every wave cost three tries and three good spots each time. Look again in four waves
		-- in case somebody sold theirs.
		Match.capped[entry.uuid] = currentWave() + 3
		Match.failStreak[entry.uuid] = 0
		return false
	end
	if learnedCaps[entry.id] and before >= learnedCaps[entry.id] then
		-- The server just told us this unit's real cap: nothing wrong with the spot.
		return false
	end
	if tostring(AA.lastMessage or ""):lower():find("money", 1, true) then
		-- Short on cash (a price we couldn't read): the spot is fine, try again when richer.
		Match.shortUntil = os.clock() + 3
		return false
	end
	Match.badSpots[spotKey(spot.position)] = true
	if Match.spots and tostring(AA.lastMessage or ""):find("Cannot place unit here", 1, true) then
		-- Whatever is wrong with the ground here is wrong next to it too: the spots within six
		-- studs go with it, so the next try is somewhere else.
		for _, list in pairs(Match.spots) do
			for _, other in ipairs(type(list) == "table" and list or {}) do
				local dx, dz = other.position.X - spot.position.X, other.position.Z - spot.position.Z
				if dx * dx + dz * dz <= 36 and math.abs(other.position.Y - spot.position.Y) < 3 then
					Match.badSpots[spotKey(other.position)] = true
				end
			end
		end
	end
	if spot.roof and Match.spots then
		-- Refused under a roof: every covered spot with no more headroom than this one goes
		-- with it. (Where the server draws that line is a guess between one spot it took, 4.7
		-- studs of headroom, and one it refused, 0.9; one match logged 32 refusals in a row.)
		for _, list in pairs(Match.spots) do
			for _, other in ipairs(type(list) == "table" and list or {}) do
				if other.roof and other.roof <= spot.roof + 0.25 then
					Match.badSpots[spotKey(other.position)] = true
				end
			end
		end
	end
	Match.failStreak[entry.uuid] = (Match.failStreak[entry.uuid] or 0) + 1
	if Match.failStreak[entry.uuid] >= 3 then
		-- Server keeps refusing: unit cap (or no room). Retry next wave.
		Match.capped[entry.uuid] = currentWave()
		Match.failStreak[entry.uuid] = 0
	end
	return false
end

local function upgradeUnit(unit)
	local level = unit._stats.upgrade.Value
	invoke("upgrade_unit_ingame", unit)
	local deadline = os.clock() + 1.2
	while os.clock() < deadline and unit.Parent and unit._stats.upgrade.Value <= level do
		task.wait(0.1)
	end
	if unit.Parent and unit._stats.upgrade.Value > level then
		Stats.upgrades += 1
		note("up", { u = unit._stats.id.Value, to = unit._stats.upgrade.Value, cash = math.floor(stats.resource.Value) })
		return true
	end
	Match.maxed[unit] = os.clock() + 8
	return false
end

local function isLastWave()
	local flag = workspace:FindFirstChild("_is_last_wave")
	return flag ~= nil and flag.Value == true
end

local function wavesLeft()
	if isLastWave() then
		return 0
	end
	local total = Match.totalWaves
	if total == nil then
		local data = Match.levelData or {}
		local infinite = data.infinite or data._gamemode == "infinite" or data._gamemode == "infinite_tower" or (type(data._override_waves) == "table" and data._override_waves.infinite)
		if infinite and not tonumber(data._override_infinite_bound_waves) then
			total = false
			Match.infinite = true
		else
			local waves = gameRequire(replicatedStorage.src.Data.Waves)
			local set = waves and data.waves and waves[data.waves]
			local count = 0
			for _ = 1, 4 do
				for _ in pairs(set and set.waves or {}) do
					count += 1
				end
				local template = set and type(set.template) == "string" and waves[set.template]
				if count > 0 or not template then
					break
				end
				set = template
			end
			-- Story acts are 15 waves when the wave list can't be read.
			total = tonumber(data._override_infinite_bound_waves) or (count > 0 and count) or (data._gamemode == "story" and 15) or false
		end
		Match.totalWaves = total
	end
	if not total then
		return 25
	end
	return math.max(total - currentWave(), 0)
end

---Enemy snapshot for this tick: deepest point any enemy has reached and what is out there.
local function enemyState()
	local state = { threat = 0, count = 0, boss = false, flying = false, soaring = false }
	for _, enemy in ipairs(scanField().enemies) do
		local enemyStats = enemy._stats
		state.count += 1
		state.threat = math.max(state.threat, pathProgress(enemy:GetPivot().Position))
		local id = enemyStats:FindFirstChild("id") and enemyStats.id.Value or enemy.Name
		local data = Units[id]
		if (data and data.boss) or (tostring(id):find("boss") and not tostring(id):find("miniboss")) then
			state.boss = true
		end
		local flying, soaring = enemyStats:FindFirstChild("Flying"), enemyStats:FindFirstChild("Soaring")
		state.flying = state.flying or (flying ~= nil and flying.Value > 0)
		state.soaring = state.soaring or (soaring ~= nil and soaring.Value > 0)
	end
	if state.soaring and not Match.soaring then
		Match.soaring = true
		note("soaring", {})
	end
	-- Share of the enemies that fly, smoothed over the match (Sky Island: half of them).
	if state.count >= 5 then
		local flying = 0
		for _, enemy in ipairs(scanField().enemies) do
			local flag = enemy._stats:FindFirstChild("Flying")
			if flag and flag.Value > 0 then
				flying += 1
			end
		end
		Match.flyShare = (Match.flyShare or flying / state.count) * 0.9 + flying / state.count * 0.1
	end
	-- A tank: one enemy with at least five times the health of the usual one on this wave
	-- (Mineral Elemental: 4.2M among 600k bandits, walked to the base at full health behind them
	-- while every unit shot the bandits). Not "can it kill the base": past the first waves they all can.
	local healths, list = {}, {}
	for _, enemy in ipairs(scanField().enemies) do
		local humanoid = enemy:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.MaxHealth > 0 then
			table.insert(healths, humanoid.MaxHealth)
			table.insert(list, { max = humanoid.MaxHealth, progress = pathProgress(enemy:GetPivot().Position) })
		end
	end
	-- The usual enemy of this wave: the median over every enemy seen in it, not over whoever is
	-- alive this instant (with two kinds on the road it jumped between them tick by tick, and
	-- everything that reads it flipped with it).
	do
		local wave = currentWave()
		if Match.seenWave ~= wave then
			Match.seenWave, Match.seenEnemies, Match.seenHealths = wave, setmetatable({}, { __mode = "k" }), {}
		end
		local added = false
		for _, enemy in ipairs(scanField().enemies) do
			if not Match.seenEnemies[enemy] then
				local humanoid = enemy:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.MaxHealth > 0 then
					Match.seenEnemies[enemy] = true
					table.insert(Match.seenHealths, humanoid.MaxHealth)
					added = true
				end
			end
		end
		if added and #Match.seenHealths >= 3 then
			local sorted = table.clone(Match.seenHealths)
			table.sort(sorted)
			Match.enemyMedian = sorted[math.ceil(#sorted / 2)]
		end
	end
	local usual = Match.enemyMedian
	if usual then
		for _, entry in ipairs(list) do
			if entry.max >= usual * 5 then
				state.tank = true
				state.tankProgress = math.max(state.tankProgress or 0, entry.progress)
			end
		end
		if state.tank then
			-- A small one about to leak ahead of the tank comes first.
			for _, entry in ipairs(list) do
				if entry.max < usual * 5 and entry.progress >= 0.8 and entry.progress > state.tankProgress + 0.05 then
					state.smallAhead = true
				end
			end
		end
	end
	return state
end

---Pick the next purchase.
-- Damage: best kill power gained per cash, looking down each unit's whole upgrade path (so a unit
-- whose strength comes at upgrade 3 still gets bought). Farms: only when the income pays itself
-- back within the waves left, the lane is held and nothing is threatening the base.
-- Every price comes from the game's own cost function (High Cost challenges used to be planned at
-- normal prices: 71 "Not enough money!" refusals in the logs).
local function planAction()
	local money = stats.resource.Value
	local wave = currentWave()
	local equipped = equippedUnits()
	local placed, damagePlaced = {}, 0
	local powerUnits = {}
	local units = myUnits()
	local byId = {}
	for _, entry in ipairs(equipped) do
		byId[entry.id] = entry
	end
	for _, unit in ipairs(units) do
		local id = unit._stats.id.Value
		placed[id] = (placed[id] or 0) + 1
		local entry = byId[id]
		if entry then
			local power = copyPower(entry.data, entry.unit, unit._stats.upgrade.Value) * AA.measureFactor(id, unit._stats.upgrade.Value)
			if power > 0 then
				damagePlaced += 1
				table.insert(powerUnits, { data = entry.data, power = power, id = id, unit = unit })
			end
		end
	end

	-- Threat: the deepest living enemy and whether the base is bleeding.
	local threat = enemyState().threat
	local health, maxHealth = baseHealth()
	if Match.lastHealth and health < Match.lastHealth - 0.01 then
		Match.bleedAt = os.clock()
	end
	Match.lastHealth = health
	local bleeding = Match.bleedAt and os.clock() - Match.bleedAt < 25
	-- Leaks are fine as long as the base can afford them: only real danger changes the plan.
	local fraction = maxHealth > 0 and health / maxHealth or 1
	local danger = fraction < 0.5 or (bleeding and fraction < 0.75) or (Match.leakRisk or 0) >= 0.4
	-- Enemies getting within a fifth of the road from the base, this wave or the last, is danger
	-- too, full health or not: on hard stages one enemy through ends the match. (A Daily was lost
	-- with 27000 banked for an upgrade 100 s away while waves 10-12 reached 86-93%.)
	-- Pressure: the health still walking in the last fifth of the road against what the team
	-- deals in 5 s (its own recent peak, from the game's damage counter). How deep an enemy gets
	-- says little by itself: one that arrives there nearly dead is no threat, one that arrives
	-- full is. At 1 or more the line is about to break; that holds for 30 s.
	local deep = false
	do
		local now = os.clock()
		local dealt = stats:FindFirstChild("damage_dealt")
		local sample = Match.dpsSample
		if dealt and not sample then
			Match.dpsSample = { at = now, value = dealt.Value }
		elseif dealt and now - sample.at >= 4 then
			local rate = math.max(dealt.Value - sample.value, 0) / (now - sample.at)
			-- (No fading while the road is empty: after a quiet minute the peak read a fifth of
			-- the team's real damage and the next wave looked like pressure.)
			local fade = #scanField().enemies > 0 and 0.9 or 1
			Match.peakDps = math.max(rate, (Match.peakDps or 0) * fade)
			Match.dpsSample = { at = now, value = dealt.Value }
		end
		local remaining = 0
		for _, enemy in ipairs(scanField().enemies) do
			local humanoid = enemy:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 and pathProgress(enemy:GetPivot().Position) >= 0.8 then
				remaining += humanoid.Health
			end
		end
		local pressure = (Match.peakDps or 0) > 0 and remaining / (Match.peakDps * 5) or (remaining > 0 and 1 or 0)
		Match.pressure = pressure
		Match.pressByWave = Match.pressByWave or {}
		Match.pressByWave[wave] = math.max(Match.pressByWave[wave] or 0, pressure)
		if pressure >= 1 then
			if not Match.pressAt or now - Match.pressAt > 30 then
				note("press", { x = math.floor(pressure * 10) / 10, dps = math.floor(Match.peakDps or 0) })
			end
			Match.pressAt = now
		end
		deep = Match.pressAt ~= nil and now - Match.pressAt < 30
	end
	-- Farms never outrun the defence: money in farms stays at or below money in damage units, and
	-- nothing goes to farms for a while after an enemy gets most of the way down the road.
	-- (Logs showed a full-health base dying in 15 s at wave 8 with 2 un-upgraded units and 3 maxed farms.)
	local farmSpent, damageSpent = 0, 0
	for _, unit in ipairs(units) do
		local spent = unit._stats:FindFirstChild("total_spent")
		local data = Units[unit._stats.id.Value]
		if spent and data then
			if unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm > 0 then
				farmSpent += spent.Value
			else
				damageSpent += spent.Value
			end
		end
	end
	if threat >= 0.6 then
		Match.threatAt = os.clock()
	end
	local pressed = Match.threatAt and os.clock() - Match.threatAt < 20
	-- Farms wait while the line is strained: by pressure (health alive in the last fifth of the
	-- road against the team's damage), not by how far enemies walk. On a short road everything
	-- "gets deep", and a farm held back for that costs the whole match its income.
	do
		local byWave = Match.pressByWave or {}
		pressed = math.max(byWave[wave] or 0, byWave[wave - 1] or 0) >= 0.6
	end
	-- (Letting the farm cost twice the damage units was tried in v99: same final wave, but the
	-- second Elyssia came 13 s later and wave 6 nearly leaked. The cap stays.)
	-- "Two damage units down first", or as many as the team can field if that is fewer (a
	-- Unique carry with a buffer and a farm never got past the carry).
	local damageCap = 0
	for _, entry in ipairs(equipped) do
		if entry.data.cost and not AA.buffInfo(entry.data) and (unitStatsAt(entry.data, 0).dps > 0 or AA.isSummoner(entry.id)) then
			damageCap += placeCap(entry.data)
		end
	end
	local damageNeed = math.clamp(damageCap, 1, 2)
	local safe = damagePlaced >= damageNeed and not danger and not pressed and farmSpent < damageSpent
	-- Only the three waves leading up to it: blocking farms from wave 1 starved the whole act
	-- (Shibuya: farm never upgraded, Elyssia still level 1 at the boss).
	local leakWave = AA.leakWave()
	if leakWave and currentWave() <= leakWave and currentWave() >= leakWave - 3 then
		safe = false
	end
	local left = wavesLeft()
	-- Infinite and other long modes (25+ waves): enemies keep scaling, so play for the late game
	-- from the start (coverage, clustering under buffs, farms) instead of racing the early waves.
	-- (An unknown wave count, like the Daily Challenge, is not "long": it gets no farm bias.)
	if AA.killsMode() or AA.frontForced() or AA.Order.front() then
		Match.longHaul = false
		Match.pace = "speed"
	elseif Match.infinite or (Match.totalWaves or 0) > 25 then
		Match.longHaul = true
		if Config.PlaceStyle ~= "Front" then
			Match.pace = "long"
		end
	else
		Match.longHaul = false
	end
	if not Match.totalWaves and not Match.infinite then
		left = math.min(left, 8)
	end
	-- Lost here before: until that wave is behind us everything goes into damage (no farms, no
	-- saving up), strongest units first.
	local lostAt, _, lostLow = AA.lostWave(Match.levelId)
	-- Getting ready for the wall: from three waves before the earliest wave this stage was lost at,
	-- cash goes into what helps within the minute and farms wait. (Difficulty jumps: pressure was
	-- 0 on waves 10-11 and 2.9 on wave 12, with 20000 just put into the farm.)
	-- (Around each remembered wall on its own, not the whole stretch between the earliest and the
	-- latest loss: losses at waves 6 and 16 would have switched farms off for waves 3-17.)
	local function nearWall(lostWave)
		return lostWave ~= nil and wave >= lostWave - 3 and wave <= lostWave + 1
	end
	if nearWall(lostLow) or nearWall(lostAt) then
		-- (Blocking only farms here and letting it save was tried in v97: it banked 30000 for
		-- Elyssia, the wall hit 17 s before it could pay, and the run ended three waves earlier.)
		deep = true
		safe = false
	end
	-- Only for an early loss. A loss to the last waves / the boss needs more economy, not less:
	-- the rush replay of a wave-15 boss loss played the whole act without its farm and lost again.
	-- Only around the wave it was lost at. (From wave 1 up to it, as before, meant a loss at wave
	-- 13 put the whole next run in rush: nothing saved for, no farm, Elyssia level 0 at wave 10.)
	-- Lost in the first waves (a challenge on a hard act: base of 228, dead at wave 6 with one
	-- upgraded Zombie and a fresh Sorcerer, twice the same way): until that wave is behind us
	-- more units come before upgrades, and the waves are not skipped (see AA.holdSkip).
	local wallOpening = lostLow ~= nil and lostLow <= 8 and wave <= lostLow + 1
	local rush = lostAt ~= nil and wave >= lostAt - 2 and wave <= lostAt + 1 and lostAt <= math.max((Match.totalWaves or 15) * 0.6, 5)
	if rush then
		safe = false
	end

	local shieldMode = AA.shieldMode(units)
	if shieldMode ~= Match.shieldMode then
		Match.shieldMode = shieldMode
		note("shieldMode", { on = shieldMode, shields = AA.shieldCount(), median = Match.enemyMedian and math.floor(Match.enemyMedian) })
	end
	local options = {}
	for _, entry in ipairs(equipped) do
		local data = entry.data
		local unit = entry.unit
		local cappedWave = Match.capped[entry.uuid]
		-- (With auto place off nothing is offered for placing: a place pick nobody acts on used to
		-- sit at the top of the list and block every upgrade.)
		if Config.AutoPlace and (placed[entry.id] or 0) < placeCap(data) and not (cappedWave and cappedWave >= wave) and data.cost then
			local cost = spawnCost(entry)
			local scale = cost / math.max(data.cost, 1)
			local maxLevel = data.upgrade and #data.upgrade or 0
			local base = unitStatsAt(data, 0)
			local farmTop = unitStatsAt(data, maxLevel).farm
			local factor = AA.measureFactor(entry.id, 0)
			local score = 0
			local buff = AA.buffInfo(data)
			if buff and damagePlaced >= damageNeed and (placed[entry.id] or 0) < AA.buffCopies(buff, data) then
				-- Buffer: what the next copy adds to the damage it boosts, per cash (plus its own
				-- hits). One copy holds the base buff half the time, two all the time, four chain
				-- it to 100%; the third only pays off with the fourth, so those two are priced
				-- as a pair.
				local have = placed[entry.id] or 0
				local want = math.min(AA.buffCopies(buff, data), placeCap(data))
				-- What the chain boosts: every matching unit that some copy already reaches. (It
				-- was measured from the first copy found alone. When that one was the feeder,
				-- which stands clear of the damage on purpose, the chain "boosted nothing", the
				-- fourth copy was never worth its price, and with three copies every second
				-- cast is half strength: 100, 50, 100, 50 for five minutes.)
				local copies = {}
				for _, tower in ipairs(units) do
					if tower._stats.id.Value == entry.id then
						local range = tower._stats:FindFirstChild("range")
						table.insert(copies, { position = tower:GetPivot().Position, reach = range and AA.rv(range) or AA.buffRange(data, unit, buff) })
					end
				end
				local boosted = 0
				for _, ally in ipairs(powerUnits) do
					if ally.data ~= data and AA.buffMatches(buff, ally.data) then
						local reached = #copies == 0
						local position = ally.unit:GetPivot().Position
						for _, copy in ipairs(copies) do
							if (position - copy.position).Magnitude <= copy.reach then
								reached = true
								break
							end
						end
						if reached then
							boosted += ally.power
						end
					end
				end
				local nextCount = (have == 2 and want >= 4) and 4 or have + 1
				local gain = (AA.buffValue(buff, nextCount) - AA.buffValue(buff, have)) * boosted
				score = (gain / (nextCount - have) + copyPower(data, unit, 0)) / cost
			elseif buff and damagePlaced >= damageNeed then
				-- The chain is complete, but damage it should boost stands outside every copy's
				-- reach (a unit placed before the buffers, a card that cost range): one more
				-- copy next to it is worth most of the buff on that unit.
				local copies = {}
				for _, tower in ipairs(units) do
					if tower._stats.id.Value == entry.id then
						local range = tower._stats:FindFirstChild("range")
						table.insert(copies, { position = tower:GetPivot().Position, reach = range and AA.rv(range) or AA.buffRange(data, unit, buff) })
					end
				end
				local inside, outside = 0, 0
				for _, ally in ipairs(powerUnits) do
					if ally.data ~= data and AA.buffMatches(buff, ally.data) and not AA.buffInfo(ally.data) then
						-- (Reached by one copy only: it gets every second cast, half the buff.)
						local reachedBy = 0
						local position = ally.unit:GetPivot().Position
						for _, copy in ipairs(copies) do
							if (position - copy.position).Magnitude <= copy.reach then
								reachedBy += 1
							end
						end
						local missing = reachedBy == 0 and 1 or reachedBy == 1 and 0.5 or 0
						inside += ally.power * (1 - missing)
						outside += ally.power * missing
					end
				end
				if outside > (inside + outside) * 0.1 then
					score = (0.6 * outside + copyPower(data, unit, 0)) / cost
				end
			elseif buff then
				score = 0
			elseif farmTop > 0 then
				-- Income over the rest of the match against the price (first level only: upgrades compete separately).
				local income = math.max(base.farm, 0) * math.max(left - 1, 0)
				local path = farmTop * math.max(left - 3, 0)
				-- The opening: a farm that can be paid for on the spot goes down before anything
				-- else. It costs the first damage unit a few seconds at most (the first wave's
				-- payout lands about ten seconds in, long before its enemies are anywhere), and
				-- every step of a farm pays for itself in three to four waves (Bulby: 800 for
				-- 250 a wave, 1500 for +500, 3000 for +750 ...), so a wave earlier is a wave of
				-- income and every later step a wave sooner. It used to wait for two damage units
				-- and came down at wave 2.
				local opening = damagePlaced == 0 and wave <= 1 and threat < 0.25 and money >= cost and (placed[entry.id] or 0) == 0
				if Config.FarmFirst and (safe or opening) and not Match.farmsSold and (income > cost * 1.3 or path > cost * 4) then
					score = 1e6 + math.max(income, path) / cost
				end
			elseif copyPower(data, unit, maxLevel) > 0 then
				-- Best efficiency reachable down the upgrade path.
				local spend, best = cost, copyPower(data, unit, 0) / cost
				for level = 1, maxLevel do
					spend += math.ceil((data.upgrade[level].cost or 0) * scale)
					best = math.max(best, copyPower(data, unit, level) / spend * 0.9)
				end
				score = best * factor * AA.airFactor(data, nil, 0)
				-- Aura units (Water Goddess: +50% to Water units in range): worth what they add.
				local aura = AA.synergyInfo(entry.id)
				if aura and aura.stacks and (placed[entry.id] or 0) == 0 then
					-- (Zombie (Risen): every minion summoned while she stands gets +25% attack,
					-- wherever she is. Summoners' power counts through their summons; a Ritual
					-- Sorcerer counts for the Warlord he becomes.)
					local boosted = 0
					for _, ally in ipairs(powerUnits) do
						if aura.matches(ally.id, ally.data) then
							boosted += ally.power * (AA.ritualUnit(ally.data) and 3 or 1)
						end
					end
					-- (Measured with the Unique trait: her one copy put 4 stacks on every
					-- jellyfish and eel, the unit's normal cap, and a level 0 Elyssia's jellyfish
					-- hit for 2.1x her damage. So a Unique copy counts as a full set.)
					local copies = (AA.uniqueIds and AA.uniqueIds[data.id] and (tonumber(data.spawn_cap) or 1) > 1) and data.spawn_cap or 1
					score += boosted * aura.pct * copies / cost
				elseif aura and not aura.stacks and (placed[entry.id] or 0) == 0 then
					local boosted = 0
					for _, ally in ipairs(powerUnits) do
						if ally.id ~= entry.id and aura.matches(ally.id, ally.data) then
							boosted += ally.power
						end
					end
					score = math.max(score, aura.pct * boosted * aura.coverage / cost)
				end
				-- A unit whose worth is what it adds to others' summons (Zombie (Risen)) is not the
				-- first one down while the unit it feeds is still in the hand: alone she dealt
				-- next to nothing in the first waves (0.0M at level 2 on Sky Island against 20-30M
				-- for each Elyssia), and her blessing has nothing to bless.
				if aura and aura.stacks and damagePlaced == 0 then
					for _, other in ipairs(equipped) do
						if other.id ~= entry.id and other.data.cost and aura.matches(other.id, other.data) and (placed[other.id] or 0) == 0 then
							score *= 0.3
							break
						end
					end
				end
				-- Opening: the strongest-per-cash unit goes down first (waiting a few seconds for it
				-- beats wasting the cash on a cheap weak one). Only with enemies already half way
				-- down an empty road does the cheapest body go down instead.
				if damagePlaced == 0 and threat >= 0.45 then
					score = 1e7 / cost
				end
			elseif safe and (placed[entry.id] or 0) == 0 then
				-- Support / summoner: one copy once the lane is held.
				score = 1e5
			end
			if shieldMode and score < 1e5 and base.damage > 0 and farmTop <= 0 and (score > 0 or buff) then
				-- Shields decide: a body is worth its hits per second for the cash.
				score = 1e6 / math.max(base.cooldown, 0.5) / cost
			end
			if score > 0 then
				table.insert(options, { kind = "place", entry = entry, cost = cost, score = score })
			end
		end
	end
	-- Ritual: Shadow Sorcerer (Ritual) at max level is sacrificed for Holy Warlord, who hits for
	-- about seven times the Sorcerer's damage and adapts further (measured: 19M damage in his
	-- first two waves against 62M from the whole team in nineteen). While no Warlord stands and
	-- the match is long enough to pay for it (106k in all), the furthest-along copy is rushed.
	-- Only once the economy and the rest of the team stand: every farm unit maxed (or sold) and
	-- at least three damage units down. (Rushing from the first second put one Sorcerer on the
	-- field alone until wave 12: with a single damage unit the lane never counted as safe, so
	-- Bulby came at wave 14-18 and Elyssia at 12, and three infinite runs ended at 33, 15 and 24
	-- where the build-up-first runs reached 41 and 52.)
	local ritualReady = damagePlaced >= 3
	for _, entry in ipairs(equipped) do
		local top = entry.data.upgrade and #entry.data.upgrade or 0
		if unitStatsAt(entry.data, top).farm > 0 and not Match.farmsSold then
			local done = false
			for _, unit in ipairs(units) do
				if unit._stats.id.Value == entry.id and unit._stats.upgrade.Value >= top then
					done = true
				end
			end
			if not done then
				ritualReady = false
			end
		end
	end
	local ritualLead
	if ritualReady and left >= 5 and not AA.ownWarlord() then
		for _, unit in ipairs(units) do
			if AA.ritualUnit(Units[unit._stats.id.Value]) and (not ritualLead or unit._stats.upgrade.Value > ritualLead._stats.upgrade.Value) then
				ritualLead = unit
			end
		end
		if ritualLead and not AA.ritualPayable(Units[ritualLead._stats.id.Value], ritualLead._stats.upgrade.Value, money, left) then
			-- (A 15-wave challenge can't pay for it: the rush put three upgrades into the
			-- Sorcerer there while Elyssia wasn't even placed by wave 10.)
			ritualLead = nil
		end
	end
	if Config.AutoUpgrade then
		for _, unit in ipairs(units) do
			local unitStats = unit._stats
			local id = unitStats.id.Value
			local entry = byId[id]
			local data = entry and entry.data or Units[id]
			local record = ownedOf(unit) or (entry and entry.unit)
			local level = unitStats.upgrade.Value
			local maxLevel = unitStats:FindFirstChild("max_upgrade") and unitStats.max_upgrade.Value or (data and data.upgrade and #data.upgrade or 0)
			maxLevel = math.min(maxLevel, data and data.upgrade and #data.upgrade or 0)
			if data and level < maxLevel and not (Match.maxed[unit] and Match.maxed[unit] > os.clock()) then
				local cost = upgradeCost(unit, data, level)
				local scale = cost / math.max(data.upgrade[level + 1].cost or 1, 1)
				local nowFarm, nextFarm = unitStatsAt(data, level).farm, unitStatsAt(data, level + 1).farm
				local score = 0
				if unitStatsAt(data, maxLevel).farm > 0 then
					-- (Counted from the wave it can be paid for: saving three waves for an upgrade
					-- that no longer pays back by then held all spending for nothing.)
					local waitWaves = math.max(0, cost - money) / math.max(Match.incomeRate or 0, 1) / 25
					local income = (nextFarm - nowFarm) * math.max(left - 1 - waitWaves, 0)
					-- Speed pace (enemies die early on the road): only farms that pay back 3x.
					if Config.FarmFirst and safe and income > cost * (Match.pace == "speed" and 3 or 1.3) then
						score = 1e6 + income / math.max(cost, 1)
					end
				else
					local now = copyPower(data, record, level)
					local spend, best = 0, 0
					for target = level + 1, maxLevel do
						spend += math.ceil((data.upgrade[target].cost or 0) * scale)
						best = math.max(best, (copyPower(data, record, target) - now) / math.max(spend, 1) * (target == level + 1 and 1 or 0.9))
					end
					-- Units sitting where the fight is are worth more than ones enemies already passed.
					score = best * AA.measureFactor(id, level + 1)
					-- Enemies in the air: an upgrade that brings Anti-Air is worth the damage it
					-- stops losing as well; one on a unit that never gets it is worth less.
					local airNow, airNext = AA.airFactor(data, unit, level), AA.airFactor(data, unit, level + 1)
					if airNext > airNow then
						score = score * airNext + copyPower(data, record, level) * (airNext - airNow) / math.max(cost, 1) * AA.measureFactor(id, level + 1)
					else
						score *= airNext
					end
					if Match.pace == "speed" and not AA.buffInfo(data) and not AA.isSummoner(id) and not AA.reachesKillZone(unit, unitStatsAt(data, level + 1).range * statMul(record, "range") + 1) then
						score *= 0.25
					end
					if score <= 0 then
						score = 1e-6
					end
					if unit == ritualLead and Config.RitualRush then
						score *= 4
					end
					if wallOpening and damagePlaced < 3 then
						score *= 0.4
					end
					if shieldMode then
						-- Only a faster attack helps against shields.
						-- (Upgrades that add no speed keep their usual order among themselves: all at
						-- the same score, the cheapest was bought first whatever it was.)
						local faster = 1 / math.max(unitStatsAt(data, level + 1).cooldown, 0.5) - 1 / math.max(unitStatsAt(data, level).cooldown, 0.5)
						score = faster > 0 and math.max(1e6 * faster / math.max(cost, 1), 2e-6) or 1e-6 * (1 + score / (score + 10))
					end
				end
				if score > 0 then
					table.insert(options, { kind = "upgrade", unit = unit, cost = cost, score = score })
				end
			end
		end
	end
	if AA.Order.active() then
		-- The user's build order: exactly the next step on the list, saved for until it can be
		-- paid. Which spot (and which copy gets the upgrade) is still the planner's choice. When
		-- the list is finished the planner carries on by itself.
		local byId = {}
		for _, entry in ipairs(equippedUnits()) do
			byId[entry.id] = entry
		end
		local index, step = AA.Order.current(units, function(id)
			return byId[id] and placeCap(byId[id].data) or 0
		end)
		while index do
			local best
			for _, option in ipairs(options) do
				local id = option.kind == "place" and option.entry.id or option.unit._stats.id.Value
				if option.kind == step.kind and id == step.unit and (not best or option.score > best.score) then
					best = option
				end
			end
			if best then
				Match.lastOptions = { string.format("build order %d: %s %s %d", index, step.kind, step.unit, best.cost) }
				Match.orderStep = index
				return best, money
			end
			-- Nothing to buy for this step. Not on the team, nothing of it on the field to
			-- upgrade, already maxed, or the server keeps refusing the placement: skip it.
			-- Otherwise (waiting for a wave or a retry) hold the list here.
			local entry = byId[step.unit]
			local standing, open, lowest = 0, false, nil
			for _, unit in ipairs(units) do
				if unit._stats.id.Value == step.unit then
					standing += 1
					local data = Units[step.unit]
					if data and data.upgrade and unit._stats.upgrade.Value < #data.upgrade then
						open = true
						if not (Match.maxed[unit] and Match.maxed[unit] > os.clock()) and (not lowest or unit._stats.upgrade.Value < lowest._stats.upgrade.Value) then
							lowest = unit
						end
					end
				end
			end
			-- The step is the user's call even where the planner itself wouldn't offer it (a farm
			-- before any damage unit, a buffer before two are down, a farm upgrade that no longer
			-- pays back): the list used to stop on such a step for the rest of the match.
			local soldFarm = entry and Match.farmsSold and unitStatsAt(entry.data, entry.data.upgrade and #entry.data.upgrade or 0).farm > 0
			if entry and step.kind == "place" and Config.AutoPlace and entry.data.cost and not soldFarm and standing < placeCap(entry.data) and not Match.capped[entry.uuid] then
				Match.lastOptions = { string.format("build order %d: place %s", index, step.unit) }
				Match.orderStep = index
				return { kind = "place", entry = entry, cost = spawnCost(entry), score = 1 }, money
			elseif entry and step.kind == "upgrade" and Config.AutoUpgrade and lowest then
				Match.lastOptions = { string.format("build order %d: upgrade %s", index, step.unit) }
				Match.orderStep = index
				return { kind = "upgrade", unit = lowest, cost = upgradeCost(lowest, entry.data, lowest._stats.upgrade.Value), score = 1 }, money
			end
			local stuck = not entry or soldFarm or (step.kind == "upgrade" and (standing == 0 or not open or not Config.AutoUpgrade)) or (step.kind == "place" and (not Config.AutoPlace or Match.capped[entry.uuid] ~= nil or standing >= placeCap(entry.data)))
			if not stuck then
				Match.orderStep = index
				Match.lastOptions = { string.format("build order %d: waiting for %s %s", index, step.kind, step.unit) }
				return nil, money
			end
			Match.orderSkip[index] = true
			note("orderSkip", { i = index, k = step.kind, u = step.unit })
			index, step = AA.Order.current(units, function(id)
				return byId[id] and placeCap(byId[id].data) or 0
			end)
		end
		Match.orderStep = nil
	end
	if AA.killsMode() then
		-- Phase 1: every unit of the team down (the buff chain's four copies included), nothing
		-- upgraded. Phase 2: the farm placed and maxed. Phase 3: the normal list, which upgrades
		-- by damage per cash.
		local function isFarm(data)
			return unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm > 0
		end
		local existing = {}
		for _, option in ipairs(options) do
			if option.kind == "place" then
				existing[option.entry.uuid] = option
			else
				existing[option.unit] = option
			end
		end
		local phase = {}
		for _, entry in ipairs(equipped) do
			local data = entry.data
			local buff = AA.buffInfo(data)
			local want = buff and AA.buffCopies(buff, data) or placeCap(data)
			local cappedWave = Match.capped[entry.uuid]
			if data.cost and not isFarm(data) and (placed[entry.id] or 0) < want and not (cappedWave and cappedWave >= wave) then
				local option = existing[entry.uuid] or { kind = "place", entry = entry, cost = spawnCost(entry), score = 1 }
				table.insert(phase, option)
			end
		end
		Match.killsPhase = 1
		if #phase == 0 then
			Match.killsPhase = 2
			for _, entry in ipairs(equipped) do
				local data = entry.data
				if data.cost and isFarm(data) and not Match.farmsSold then
					local cappedWave = Match.capped[entry.uuid]
					if (placed[entry.id] or 0) < 1 and not (cappedWave and cappedWave >= wave) then
						table.insert(phase, existing[entry.uuid] or { kind = "place", entry = entry, cost = spawnCost(entry), score = 1 })
					end
				end
			end
			for _, unit in ipairs(units) do
				local data = Units[unit._stats.id.Value]
				if data and isFarm(data) then
					local level = unit._stats.upgrade.Value
					local maxLevel = unit._stats:FindFirstChild("max_upgrade") and unit._stats.max_upgrade.Value or #(data.upgrade or {})
					maxLevel = math.min(maxLevel, #(data.upgrade or {}))
					if level < maxLevel and not (Match.maxed[unit] and Match.maxed[unit] > os.clock()) then
						table.insert(phase, existing[unit] or { kind = "upgrade", unit = unit, cost = upgradeCost(unit, data, level), score = 1 })
					end
				end
			end
		end
		if #phase > 0 then
			-- One at a time, cheapest first: nothing here is worth holding cash back for. Units
			-- that deal the damage go down before the buff chain (four Elfys used to open every
			-- match with nothing on the field to buff).
			local function buffer(option)
				local optionData = option.kind == "place" and option.entry.data or Units[option.unit._stats.id.Value]
				return AA.buffInfo(optionData) ~= nil
			end
			table.sort(phase, function(x, y)
				local bx, by = buffer(x), buffer(y)
				if bx ~= by then
					return by
				end
				return x.cost < y.cost
			end)
			local first = phase[1]
			Match.lastOptions = { string.format("%s %s %d (kills phase %d)", first.kind, first.kind == "place" and first.entry.id or first.unit._stats.id.Value, first.cost, Match.killsPhase) }
			return first, money
		end
		Match.killsPhase = 3
	end
	if #options == 0 then
		return nil, money
	end
	-- What each unit is really doing in THIS match, whatever unit it is. A unit whose copies have
	-- stood for two minutes and dealt less than half the share of the team's damage that their
	-- numbers promised gets that much less of the next cash (down to a tenth). The numbers
	-- remembered from other matches can't see a bad map for a unit: three Water Goddess on Sky
	-- Island and four in a Summer Hunt dealt nothing at all (hill spots away from the fight)
	-- and were still upgraded, 60,000 cash in the Summer run, while Elyssia waited for hers.
	do
		local now = os.clock()
		if not Match.live or now - (Match.liveAt or 0) >= 5 then
			local rows, expectTotal, dealtTotal = {}, 0, 0
			for _, unit in ipairs(units) do
				local id = unit._stats.id.Value
				local data = Units[id]
				local born = unit:GetAttribute("AABorn")
				if data and not AA.buffInfo(data) and unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm <= 0 then
					local level = unit._stats.upgrade.Value
					local total = unit._stats:FindFirstChild("total_damage")
					local dealt = (total and total.Value or 0) + (Match.extraDamage and Match.extraDamage[unit] or 0)
					-- Counted from the moment this script first saw the unit, for every unit
					-- alike: after a reload the game's own counters go back to the start of the
					-- match but the damage credited from summons does not, and Zombie (all of
					-- hers comes through summons) read as dealing nothing.
					AA.liveBoot = AA.liveBoot or now
					if not born or born > now or born < AA.liveBoot then
						born = now
						unit:SetAttribute("AABorn", now)
						unit:SetAttribute("AABase", dealt)
					end
					dealt = math.max(dealt - (unit:GetAttribute("AABase") or 0), 0)
					local expect = copyPower(data, ownedOf(unit), level) * AA.measureFactor(id, level) * (now - born)
					local row = rows[id] or { expect = 0, dealt = 0, age = 0 }
					row.expect += expect
					row.dealt += dealt
					row.age = math.max(row.age, now - born)
					rows[id] = row
					expectTotal += expect
					dealtTotal += dealt
				end
			end
			local live = {}
			if dealtTotal > 0 and expectTotal > 0 then
				for id, row in pairs(rows) do
					if row.age >= 120 and row.expect > 0 then
						local ratio = (row.dealt / dealtTotal) / (row.expect / expectTotal)
						if ratio < 0.5 then
							live[id] = math.max(ratio * 2, 0.1)
							local was = Match.live and Match.live[id]
							if not was or math.abs(was - live[id]) >= 0.25 then
								note("live", { u = id, x = math.floor(live[id] * 100) / 100, share = math.floor(row.dealt / dealtTotal * 1000) / 10 })
							end
						end
					end
				end
			end
			Match.live, Match.liveAt = live, now
		end
		for _, option in ipairs(options) do
			local id = option.kind == "place" and option.entry.id or option.unit._stats.id.Value
			if option.score < 1e5 and Match.live[id] then
				option.score *= Match.live[id]
			end
		end
	end
	if Config.OpeningCore and Config.AutoPlace and not Match.openingDone and not danger and not deep and not AA.killsMode() then
		-- The opening: the farm and two copies of the team's strongest damage unit before
		-- anything else is placed or upgraded (user: "2 Elyssias and a Bulma first, after that
		-- whatever is best"). Which unit that is comes from the same power number the line-up
		-- is picked by, so another team opens with its own carry.
		local core, corePower
		for _, entry in ipairs(equipped) do
			local data = entry.data
			if data.cost and not AA.buffInfo(data) and unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm <= 0 then
				local power = unitPower(entry.id, entry.unit) or 0
				if power > (corePower or 0) then
					core, corePower = entry, power
				end
			end
		end
		local want = core and math.min(2, placeCap(core.data)) or 0
		local set = {}
		for _, option in ipairs(options) do
			if option.kind == "place" then
				local data = option.entry.data
				local farm = unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm > 0
				if (farm and (placed[option.entry.id] or 0) == 0) or (core and option.entry.id == core.id and (placed[core.id] or 0) < want) then
					table.insert(set, option)
				end
			end
		end
		if #set > 0 then
			options = set
		elseif not core or (placed[core.id] or 0) >= want then
			Match.openingDone = true
			note("openingDone", { core = core and core.id, cash = math.floor(money) })
		end
	end
	table.sort(options, function(x, y)
		return x.score > y.score
	end)
	local pick = options[1]
	Match.lastOptions = {}
	for i = 1, math.min(6, #options) do
		local option = options[i]
		table.insert(Match.lastOptions, string.format("%s %s %d %.3g", option.kind, option.kind == "place" and option.entry.id or option.unit._stats.id.Value, option.cost, option.score))
	end
	-- What to buy: the best damage per cash, saved for when it can't be paid yet. With a steady
	-- income that order gives the most damage over the rest of the match (a cheaper, weaker buy
	-- now only pushes the better one back). What changes it is the clock: an option is worth its
	-- score times the share of the remaining match it will be on the field for, so near the end
	-- the affordable one wins and anything the match ends before affording is out. (v81 halved a
	-- score for every 45 s of saving: Elyssia's 10000 upgrade topped the list for six waves of a
	-- Daily while cheaper upgrades half as good were bought instead, and the run was lost.)
	if pick.score < 1e5 then
		local income = math.max(Match.incomeRate or 0, 1)
		local elapsed = os.clock() - (Match.startedAt or os.clock())
		local perWave = math.clamp(elapsed / math.max(wave, 1), 15, 60)
		local horizon = math.clamp(math.max(left, 1) * perWave, 20, 600)
		if danger or deep then
			-- Under threat only the next half minute counts. (The old rule took the first
			-- affordable thing on the list: 6000 went into Elfy upgrades worth a tenth of the
			-- Water Goddess upgrade that was two seconds of income away.)
			horizon = math.min(horizon, 60)
		end
		local best, bestValue
		for _, option in ipairs(options) do
			local wait = math.max(0, option.cost - money) / income
			-- (No "never save while rushing" any more: the waves before a remembered loss went
			-- into three Shadow Sorcerers and Water Goddess upgrades at a third of the value of
			-- the Elyssia upgrade that was next on the list.)
			-- (While the base guard is firing only what can be paid now counts: the wait is
			-- worked out from the match's average income, which stops when the kills do.)
			if option.score < 1e5 and wait < ((Match.leakRisk or 0) >= 0.4 and 2 or horizon * 0.8) then
				local value = option.score * (1 - wait / horizon)
				if not bestValue or value > bestValue then
					best, bestValue = option, value
				end
			end
		end
		if best then
			pick = best
			Match.savingFor = money < pick.cost and string.format("%s %s", pick.kind, pick.kind == "place" and pick.entry.id or pick.unit._stats.id.Value) or nil
		end
	end
	-- Under threat, don't sit saving for something expensive: buy the best thing we can afford now.
	if danger and money < pick.cost and pick.score >= 1e5 then
		for _, option in ipairs(options) do
			if option.cost <= money and option.score < 1e5 then
				return option, money
			end
		end
	end
	return pick, money
end

---Can a tower (or a spot) reach the stretch of road where enemies currently die (spawn .. fight depth)?
function AA.reachesKillZone(unit, range)
	local position = typeof(unit) == "Vector3" and unit or unit:GetPivot().Position
	for _, point in ipairs(Match.pathPoints) do
		if point.progress <= killZone(point.lane) then
			local dx, dz = point.position.X - position.X, point.position.Z - position.Z
			if dx * dx + dz * dz <= range * range then
				return true
			end
		end
	end
	return false
end

---Units the server won't sell ("This unit cannot be sold!"): remembered so nothing plans around
---selling them and the error popup doesn't come back every match.
function AA.unsellable(id)
	return type(AA.progress.unsellable) == "table" and AA.progress.unsellable[id] == true
end

---Sell a tower; true once it is gone.
function AA.sellUnit(unit, why)
	local id = unit._stats.id.Value
	if AA.unsellable(id) or not unit.Parent then
		return false
	end
	note("sell", { u = id, lvl = unit._stats.upgrade.Value, why = why })
	AA.lastMessage = nil
	invoke("sell_unit_ingame", unit)
	local deadline = os.clock() + 1.2
	while os.clock() < deadline and unit.Parent do
		task.wait(0.1)
	end
	scanField(true)
	if not unit.Parent then
		-- (The refund is not income: it used to raise the income rate right when a sale meant
		-- real income had dropped.)
		Match.lastCash = stats.resource.Value
		return true
	end
	if tostring(AA.lastMessage or ""):lower():find("cannot be sold", 1, true) then
		AA.progress.unsellable = type(AA.progress.unsellable) == "table" and AA.progress.unsellable or {}
		AA.progress.unsellable[id] = true
		AA.saveProgress()
		note("unsellable", { u = id })
	end
	return false
end

-- Leak guard: an enemy deep down the path with nothing able to reach it gets a unit placed in
-- front of it; if we can't afford one, the furthest-back unit is sold (25% refund) and moved.
local LEAK_AT = 0.72
local function leakGuard()
	if not Config.LeakGuard or os.clock() - (Match.guardAt or 0) < 8 then
		return false
	end
	-- An enemy that reaches the base takes its remaining health off the base. Add up what is past
	-- the last defenders: small leaks are let through, ones that could lose the game are not.
	local field = scanField()
	local mine = field.towers
	local reach = {}
	for _, unit in ipairs(mine) do
		local range = unit._stats:FindFirstChild("range")
		local damage = unit._stats:FindFirstChild("damage")
		-- Only towers that actually hit things count as cover (farms and buffers stop nothing).
		if range and damage and AA.rv(damage) > 0 then
			table.insert(reach, { position = unit:GetPivot().Position, range = AA.rv(range) + 1.5 })
		end
	end
	-- Summons (eels, the Warlord) and other players' towers stop enemies too: without them an
	-- enemy being killed by an eel past the last tower counted as a leak, which blocks farms,
	-- shortens the planner's horizon and makes the card picker play safe.
	for _, group in ipairs({ field.summons, field.others }) do
		for _, unit in ipairs(group) do
			local unitStats = unit:FindFirstChild("_stats")
			local range, damage = unitStats and unitStats:FindFirstChild("range"), unitStats and unitStats:FindFirstChild("damage")
			if range and damage and AA.rv(damage) > 0 and AA.rv(range) > 0 then
				table.insert(reach, { position = unit:GetPivot().Position, range = AA.rv(range) + 1.5 })
			end
		end
	end
	local leak, leakHealth = nil, 0
	for _, enemy in ipairs(field.enemies) do
		local humanoid = enemy:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			local position = enemy:GetPivot().Position
			if pathProgress(position) >= LEAK_AT then
				local covered = false
				for _, tower in ipairs(reach) do
					if (tower.position - position).Magnitude <= tower.range then
						covered = true
						break
					end
				end
				if not covered then
					leak = leak or position
					leakHealth += humanoid.Health
				end
			end
		end
	end
	local health = baseHealth()
	Match.leakRisk = health > 0 and leakHealth / health or 0
	if not leak or Match.leakRisk < 0.4 then
		return false
	end
	local maySell = Config.LeakSell and Match.leakRisk >= 0.8
	note("guard", { risk = math.floor(Match.leakRisk * 100), hp = math.floor(health) })
	Match.guardAt = os.clock()
	-- Guard with the hardest hitter we can afford (a cheap opener can't stop what's leaking now:
	-- the Daily loss leaked 43k-health enemies past a level-0 Jane); cheapest only if nothing fits.
	local pick, pickPower, cheapest, cheapestCost = nil, 0, nil, math.huge
	local cash = stats.resource.Value
	for _, entry in ipairs(equippedUnits()) do
		-- Damage dealers only: a buffer (Windsong) dropped by the base stops nothing.
		if entry.data.cost and unitStatsAt(entry.data, 0).dps > 0 and not entry.data.hill_unit and not AA.buffInfo(entry.data) and countPlaced(entry.id) < placeCap(entry.data) then
			local power = copyPower(entry.data, entry.unit, 0) * AA.measureFactor(entry.id)
			local cost = spawnCost(entry)
			if cost <= cash and power > pickPower then
				pick, pickPower = entry, power
			end
			if cost < cheapestCost then
				cheapest, cheapestCost = entry, cost
			end
		end
	end
	pick = pick or cheapest
	if not pick then
		return false
	end
	if pickPower == 0 then
		pickPower = copyPower(pick.data, pick.unit, 0) * AA.measureFactor(pick.id)
	end
	local cost = spawnCost(pick)
	if stats.resource.Value < cost then
		if not maySell then
			return false
		end
		-- Free the cash: sell the weakest tower that sits furthest back up the road.
		local victim, victimProgress = nil, math.huge
		for _, unit in ipairs(mine) do
			local unitData = Units[unit._stats.id.Value]
			-- Never sell something that hits harder than what would replace it.
			local worth = unitData and copyPower(unitData, ownedOf(unit), unit._stats.upgrade.Value) * AA.measureFactor(unit._stats.id.Value) or 0
			-- Buffers stay: selling a Windsong breaks the chain for a refund that buys nothing
			-- (logs: one sold and re-placed five times in 40 s while the base died).
			-- ... and only if the refund (a quarter of what went into it) pays for the guard.
			local spent = unit._stats:FindFirstChild("total_spent")
			local covers = stats.resource.Value + 0.25 * (spent and spent.Value or 0) >= cost
			if covers and worth < pickPower and not AA.unsellable(unit._stats.id.Value) and not (unitData and AA.buffInfo(unitData)) then
				local progress = pathProgress(unit:GetPivot().Position)
				if progress < victimProgress and progress < LEAK_AT - 0.2 then
					victim, victimProgress = unit, progress
				end
			end
		end
		if not victim then
			return false
		end
		status = "Leak: moving a unit back"
		if not AA.sellUnit(victim, "leak") or stats.resource.Value < cost then
			return true
		end
	end
	status = "Leak: guarding the base"
	placeUnit(pick, LEAK_AT)
	return true
end

-- Targeting. Smart: units by the base always take First (nothing leaks); units further up burn the
-- boss (Strongest) while one is alive. Flying rework: every unit can hit flyers, but only towers
-- standing on a hill deal full damage to them and only they can reach Soaring enemies, so hill
-- towers take Soaring / Flying while those are out.
local function targetingStep()
	local mode = Config.Targeting
	if mode == "Off" or os.clock() - (Match.targetAt or 0) < 1 then
		return
	end
	Match.targetAt = os.clock()
	local enemies = mode == "Smart" and enemyState() or nil
	if enemies and enemies.tank and Match.tankNoted ~= currentWave() then
		-- (Once a wave: an infinite run logged it forty times in five minutes.)
		Match.tankNoted = currentWave()
		note("tank", { p = math.floor((enemies.tankProgress or 0) * 100) })
	end
	Match.towerProgress = Match.towerProgress or setmetatable({}, { __mode = "k" })
	for _, unit in ipairs(myUnits()) do
		local unitStats = unit._stats
		local priority = unitStats:FindFirstChild("priority")
		local data = Units[unitStats.id.Value]
		if priority and data then
			local want = mode:lower()
			if AA.killsMode() then
				-- Weakest: the most takedowns per hit, which is what this mode is for.
				want = "weakest"
				local valid = gameCall(Core.Unit and Core.Unit.get_valid_priorities, unit)
				if type(valid) == "table" and not valid[want] then
					want = "first"
				end
			elseif enemies then
				local progress = Match.towerProgress[unit]
				if not progress then
					progress = pathProgress(unit:GetPivot().Position)
					Match.towerProgress[unit] = progress
				end
				local shape = attackShape(data, unitStats.upgrade.Value)
				local onHill = unit:GetAttribute("_on_hill") == true
				-- (Focusing a tank with the units by the base was tried in v88: the Daily it was built
				-- for was lost three waves EARLIER, at the wave-10 boss. Tanks are only logged now.)
				if progress >= 0.7 then
					want = "first"
				elseif enemies.soaring and onHill then
					want = "soaring"
				elseif enemies.flying and (onHill or unit:GetAttribute("_anti_air") == true) then
					want = "flying"
				elseif enemies.boss and shape.kind ~= "circle" then
					want = "strongest"
				else
					want = "first"
				end
				-- Ask the game which priorities this tower may use (Soaring needs a hill).
				local valid = gameCall(Core.Unit and Core.Unit.get_valid_priorities, unit)
				if type(valid) == "table" and not valid[want] then
					want = "first"
				end
			end
			if priority.Value ~= want then
				task.spawn(invoke, "change_priority", unit, want)
			end
		end
	end
end


-- Macros: a recorded match (every placement, upgrade and sale with its wave and exact spot) saved
-- to <Game>/macros/<name>.json and played back step by step instead of the planner. Recording
-- watches the field, so it captures hand play, the planner's own play or anything else.
do
	local Macro = { steps = {}, known = setmetatable({}, { __mode = "k" }), counts = {}, labels = {}, index = 1, fails = 0 }
	AA.Macro = Macro
	local FOLDER = SETTINGS_FOLDER .. "/macros"

	local function fileOf(name)
		return FOLDER .. "/" .. tostring(name):gsub("[^%w%-_ ]", "_") .. ".json"
	end
	function Macro.list()
		local names = {}
		pcall(function()
			if isfolder(FOLDER) then
				for _, path in ipairs(listfiles(FOLDER)) do
					local name = tostring(path):match("([^/\\]+)%.json$")
					if name then
						table.insert(names, name)
					end
				end
			end
		end)
		table.sort(names)
		return names
	end
	function Macro.load(name)
		if not name or name == "" then
			return nil
		end
		if Macro.cache and Macro.cache.name == name then
			return Macro.cache
		end
		local ok, data = pcall(function()
			return httpService:JSONDecode(readfile(fileOf(name)))
		end)
		if ok and type(data) == "table" and type(data.steps) == "table" then
			data.name = name
			Macro.cache = data
			return data
		end
		return nil
	end
	function Macro.delete(name)
		Macro.cache = nil
		return pcall(function()
			delfile(fileOf(name))
		end)
	end

	-- Recording.
	local function push(step)
		-- (Units already out when recording starts are the opening: no wave to wait for.)
		step.w = Macro.opening and 0 or currentWave()
		step.t = math.floor((os.clock() - (Macro.recordedAt or os.clock())) * 10) / 10
		table.insert(Macro.steps, step)
	end
	function Macro.start(name)
		Macro.recording, Macro.recordName = true, name
		Macro.steps, Macro.counts, Macro.recordedAt = {}, {}, os.clock()
		Macro.known = setmetatable({}, { __mode = "k" })
		Macro.recordLevel = Match.levelId
		Macro.opening = true
	end
	function Macro.stop()
		if not Macro.recording then
			return false, 0
		end
		Macro.recording = false
		local count = #Macro.steps
		if count == 0 then
			return false, 0
		end
		local team = {}
		for _, entry in ipairs(equippedUnits()) do
			table.insert(team, entry.id)
		end
		local ok = pcall(function()
			if not isfolder(SETTINGS_FOLDER) then
				makefolder(SETTINGS_FOLDER)
			end
			if not isfolder(FOLDER) then
				makefolder(FOLDER)
			end
			writefile(fileOf(Macro.recordName), httpService:JSONEncode({ level = Macro.recordLevel, team = team, made = os.time(), steps = Macro.steps }))
		end)
		Macro.cache = nil
		return ok, count
	end
	function Macro.recordTick()
		if not Macro.recording or IS_LOBBY then
			return
		end
		if gameFinished() then
			Macro.stop()
			return
		end
		Macro.recordLevel = Macro.recordLevel or Match.levelId
		local seen = {}
		for _, unit in ipairs(myUnits()) do
			seen[unit] = true
			local id, level = unit._stats.id.Value, unit._stats.upgrade.Value
			local entry = Macro.known[unit]
			if not entry then
				Macro.counts[id] = (Macro.counts[id] or 0) + 1
				entry = { label = id .. "#" .. Macro.counts[id], level = 0 }
				Macro.known[unit] = entry
				local position = unit:GetPivot().Position
				push({ k = "place", id = id, u = entry.label, x = position.X, y = position.Y, z = position.Z })
			end
			while entry.level < level do
				entry.level += 1
				push({ k = "up", u = entry.label, to = entry.level })
			end
		end
		if Macro.opening and #Macro.steps > 0 then
			-- The opening is replayed in a sensible order: everything placed, then upgrades
			-- one level at a time across the field, farms first (not one unit to the top before the
			-- next is even down).
			local function isFarm(step)
				local unitData = Units[step.id or tostring(step.u):match("^(.-)#") or ""]
				return unitData ~= nil and unitStatsAt(unitData, unitData.upgrade and #unitData.upgrade or 0).farm > 0
			end
			for index, step in ipairs(Macro.steps) do
				step.order = index
			end
			table.sort(Macro.steps, function(a, b)
				local ka, kb = a.k == "place" and 0 or 1, b.k == "place" and 0 or 1
				if ka ~= kb then
					return ka < kb
				end
				if (a.to or 0) ~= (b.to or 0) then
					return (a.to or 0) < (b.to or 0)
				end
				local fa, fb = (ka == 1 and isFarm(a)) and 0 or 1, (kb == 1 and isFarm(b)) and 0 or 1
				if fa ~= fb then
					return fa < fb
				end
				return a.order < b.order
			end)
			for _, step in ipairs(Macro.steps) do
				step.order = nil
			end
		end
		Macro.opening = false
		for unit, entry in pairs(Macro.known) do
			if not seen[unit] and not entry.gone then
				entry.gone = true
				push({ k = "sell", u = entry.label })
			end
		end
	end

	-- Playback.
	function Macro.reset()
		Macro.index, Macro.fails, Macro.labels, Macro.doneFor = 1, 0, {}, nil
	end
	---The macro to play in this match (nil = let the planner play).
	function Macro.active()
		if not Config.MacroPlay or Macro.recording then
			return nil
		end
		local data = Macro.load(Config.MacroName)
		if not data or (data.level and Match.levelId and data.level ~= Match.levelId and not Config.MacroAnyMap) then
			return nil
		end
		return data
	end
	local function groundAt(step)
		local terrain = workspace:FindFirstChild("_terrain")
		local filter = { terrain }
		if workspace:FindFirstChild("_road") then
			table.insert(filter, workspace._road)
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = filter
		local hit = terrain and workspace:Raycast(Vector3.new(step.x, step.y + 12, step.z), Vector3.new(0, -60, 0), params)
		return hit and hit.Position or Vector3.new(step.x, step.y, step.z)
	end
	---One step per call; returns the line for the status strip.
	function Macro.step(data)
		local step = data.steps[Macro.index]
		if not step then
			return "Macro done (" .. #data.steps .. " steps)"
		end
		local function advance(skipped)
			if skipped then
				note("macroskip", { i = Macro.index, k = step.k, u = step.u })
			end
			Macro.index += 1
			Macro.fails = 0
		end
		local where = string.format("Macro %d/%d", Macro.index, #data.steps)
		if currentWave() < (step.w or 0) then
			return where .. ": waiting for wave " .. step.w
		end
		local money = stats.resource.Value
		if step.k == "place" then
			local entry
			for _, candidate in ipairs(equippedUnits()) do
				if candidate.id == step.id then
					entry = candidate
				end
			end
			if not entry then
				advance(true)
				return where .. ": " .. tostring(step.id) .. " not equipped"
			end
			local cost = spawnCost(entry)
			if money < cost then
				return string.format("%s: %s %d/%d", where, step.id, money, cost)
			end
			local before = {}
			for _, unit in ipairs(myUnits()) do
				before[unit] = true
			end
			local position = groundAt(step)
			local look = nearestPathPoint(position)
			invoke("spawn_unit", entry.uuid, look and CFrame.lookAt(position, Vector3.new(look.X, position.Y, look.Z)) or CFrame.new(position))
			local deadline = os.clock() + 1.5
			local placed
			while os.clock() < deadline and not placed do
				for _, unit in ipairs(myUnits()) do
					if not before[unit] and unit._stats.id.Value == step.id then
						placed = unit
					end
				end
				task.wait(0.1)
			end
			if placed then
				Macro.labels[step.u] = placed
				Stats.placed += 1
				note("place", { u = step.id, macro = true, cash = math.floor(stats.resource.Value) })
				advance()
			else
				Macro.fails += 1
				if Macro.fails >= 4 then
					advance(true)
				end
			end
		elseif step.k == "up" then
			local unit = Macro.labels[step.u]
			local unitData = unit and unit.Parent and Units[unit._stats.id.Value]
			if not unitData or unit._stats.upgrade.Value >= step.to then
				advance(not unitData)
				return where
			end
			local cost = upgradeCost(unit, unitData, unit._stats.upgrade.Value)
			if money < cost then
				return string.format("%s: upgrade %s %d/%d", where, step.u, money, cost)
			end
			if upgradeUnit(unit) then
				if unit._stats.upgrade.Value >= step.to then
					advance()
				end
			else
				Macro.fails += 1
				if Macro.fails >= 4 then
					advance(true)
				end
			end
		elseif step.k == "sell" then
			local unit = Macro.labels[step.u]
			if unit and unit.Parent then
				AA.sellUnit(unit, "macro")
			end
			advance()
		else
			advance(true)
		end
		return where
	end
end

local function matchStep()
	if not (Config.AutoPlace or Config.AutoUpgrade) or not gameStarted() then
		return
	end
	if AA.loadedMid == nil then
		-- Loaded into a match that is already running (a reload, or a late join)?
		AA.loadedMid = (currentWave() > 2 and #myUnits() > 0) and os.clock() or false
	end
	local macro = AA.Macro.active()
	if macro then
		-- A macro plays this match: its steps in its order, the planner stays out.
		status = AA.Macro.step(macro)
		return
	end
	if Config.AutoPlace and leakGuard() then
		return
	end
	-- Buffers that have stopped doing their job are sold, a few times a match at most, and the
	-- planner puts them back where the team is:
	--  * a copy that reaches no unit it could buff and no other copy (after a card that costs
	--    range, feeders 22 studs from the casters stood there for the rest of the run);
	--  * a copy standing alone that reaches under a third of the damage it is there for
	--    (placed before the team took shape, or on a hill too tall for its range).
	-- No copy is ever bought next to one like that, so the whole chain depends on it.
	if Config.AutoPlace and (Match.bufferMoves or 0) < 4 and os.clock() - (Match.bufferMoveAt or 0) > 20 and currentWave() >= 2 and wavesLeft() >= 3
		and os.clock() - (Match.startedAt or 0) > 45 and not (AA.loadedMid and os.clock() - AA.loadedMid < 30) then
		local towers = myUnits()
		local groups = {}
		for _, unit in ipairs(towers) do
			local id = unit._stats.id.Value
			local buff = AA.buffInfo(Units[id])
			if buff and not AA.unsellable(id) then
				groups[id] = groups[id] or { buff = buff, copies = {} }
				local range = unit._stats:FindFirstChild("range")
				table.insert(groups[id].copies, { unit = unit, position = unit:GetPivot().Position, reach = range and AA.rv(range) or AA.buffRange(Units[id], nil, buff) })
			end
		end
		for id, group in pairs(groups) do
			local total, count, outside = 0, 0, 0
			for _, copy in ipairs(group.copies) do
				copy.inside = 0
			end
			for _, other in ipairs(towers) do
				local otherId = other._stats.id.Value
				local otherData = Units[otherId]
				if otherData and not AA.buffInfo(otherData) and AA.buffMatches(group.buff, otherData) and (unitStatsAt(otherData, 0).damage > 0 or AA.isSummoner(otherId)) and unitStatsAt(otherData, 0).farm <= 0 then
					local damage, cooldown = other._stats:FindFirstChild("damage"), other._stats:FindFirstChild("attack_cooldown")
					local weight = math.max((damage and AA.rv(damage) or 1) / math.max(cooldown and AA.rv(cooldown) or 1, 0.1), 1)
					total += weight
					count += 1
					local reached = false
					local position = other:GetPivot().Position
					for _, copy in ipairs(group.copies) do
						if (position - copy.position).Magnitude <= copy.reach then
							copy.inside += weight
							reached = true
						end
					end
					if not reached then
						outside += weight
					end
				end
			end
			local victim, why
			if count >= 3 and #group.copies == 1 and group.copies[1].inside < total * 0.34 then
				victim, why = group.copies[1], "alone"
			elseif count >= 1 and #group.copies >= 2 then
				for _, copy in ipairs(group.copies) do
					if copy.inside <= 0 then
						-- Reaches no damage. Does it reach a copy that does (a feeder at work)?
						local linked = false
						for _, other in ipairs(group.copies) do
							if other ~= copy and other.inside > 0 and (other.position - copy.position).Magnitude <= copy.reach then
								linked = true
								break
							end
						end
						if not linked then
							victim, why = copy, "idle"
							break
						end
					end
				end
			end
			if victim then
				Match.bufferMoves = (Match.bufferMoves or 0) + 1
				Match.bufferMoveAt = os.clock()
				Match.bufferMoved = true
				note("bufferMove", { u = id, why = why, share = math.floor(victim.inside / math.max(total, 1) * 100), out = math.floor(outside / math.max(total, 1) * 100) })
				AA.sellUnit(victim.unit, "misplaced buffer")
				return
			end
		end
	end
	-- Last wave: farms have nothing left to earn. Sell them once and put the refund into damage
	-- (the planner already scores farms at 0 when there are no waves left to pay them back).
	if Config.AutoUpgrade and not Match.farmsSold and wavesLeft() == 0 and currentWave() > 1 then
		Match.farmsSold = true
		for _, unit in ipairs(myUnits()) do
			local data = Units[unit._stats.id.Value]
			if data and unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm > 0 then
				AA.sellUnit(unit, "last wave")
			end
		end
	end
	-- Weak enemies and the buff group stands where nothing reaches the fight: move the whole group
	-- once. Its Windsongs, the units they buff and the summoners among them are sold; the planner
	-- then rebuilds the group at the front (the first one back picks the spot by the spawn).
	-- (Never on a map with several roads: there the team stands where the roads run together,
	-- on purpose. And not in the first two minutes after the script was loaded into a running
	-- match: the pace starts out as "speed" until it has been measured again, and a reload at
	-- wave 12 of a Sky Portal sold ten placed and upgraded units "to move them to the front".)
	local settled = (Match.laneCount or 1) <= 1 and not (AA.loadedMid and os.clock() - AA.loadedMid < 120)
	if settled and Config.AutoPlace and Match.pace == "speed" and not Match.hubMoved and currentWave() >= 3 and wavesLeft() >= 3 and not (Match.bleedAt and os.clock() - Match.bleedAt < 60) and (Match.fightDepth or 1) < 0.3 then
		local buffer, buff
		for _, entry in ipairs(equippedUnits()) do
			local info = AA.buffInfo(entry.data)
			if info then
				buffer, buff = entry, info
			end
		end
		if buffer then
			local move, idle = {}, 0
			for _, unit in ipairs(myUnits()) do
				local id = unit._stats.id.Value
				local data = Units[id]
				local range = unit._stats:FindFirstChild("range")
				if data and (id == buffer.id or AA.buffMatches(buff, data)) and not AA.unsellable(id) and unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm <= 0 then
					local reach = id == buffer.id and (AA.buffRange(buffer.data, buffer.unit, buff) + 10) or ((range and AA.rv(range) or unitStatsAt(data, 0).range) + 1)
					if not AA.reachesKillZone(unit, reach) then
						table.insert(move, unit)
						if id ~= buffer.id and not AA.isSummoner(id) then
							idle += 1
						end
					end
				end
			end
			if idle >= 2 then
				Match.hubMoved = true
				note("hubMove", { n = #move })
				status = "Moving the team to the front"
				for _, unit in ipairs(move) do
					AA.sellUnit(unit, "front")
				end
				return
			end
		end
	end
	-- Speed pace: damage units that can't reach the kill zone (enemies die near the spawn) are idle.
	-- When cash covers rebuilding one at its current level, sell it and re-place it at the front.
	local frontAll = AA.frontForced()
	if (settled or frontAll) and Config.AutoPlace and Match.pace == "speed" and os.clock() - (Match.relocateAt or 0) > (frontAll and 3 or 15) and (frontAll or not (Match.bleedAt and os.clock() - Match.bleedAt < 60)) and wavesLeft() > 1 then
		local byId = {}
		for _, entry in ipairs(equippedUnits()) do
			byId[entry.id] = entry
		end
		local idle, idlePower = nil, 0
		local frontSpecial
		for _, unit in ipairs(myUnits()) do
			local id = unit._stats.id.Value
			local data, entry = Units[id], byId[id]
			local spent = unit._stats:FindFirstChild("total_spent")
			-- Buffers, auras (Water Goddess sits with the units she boosts) and summoners are
			-- placed by other rules: moving them "to the front" just sells and re-places them
			-- on the same spot (logs: Water Goddess sold three times in one match).
			Match.relocated = Match.relocated or {}
			-- (Front for everyone: buffers, auras and summoners move too, each copy once, after
			-- the damage units they stand with.)
			local special = AA.buffInfo(data) or AA.isSummoner(id) or AA.synergyInfo(id)
			if frontAll and special and entry and data and spent and spent.Value * (frontAll and 0.75 or 1) <= stats.resource.Value and not AA.unsellable(id) and (Match.relocated[id] or 0) < 8 and not idle and not unit:GetAttribute("AAFront") and unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm <= 0 then
				frontSpecial = frontSpecial or unit
			elseif entry and data and spent and spent.Value * (frontAll and 0.75 or 1) <= stats.resource.Value and not special and not AA.unsellable(id) and (Match.relocated[id] or 0) < (frontAll and 8 or 2) then
				local level = unit._stats.upgrade.Value
				local power = copyPower(data, entry.unit, level)
				local range = unit._stats:FindFirstChild("range")
				local reaches = AA.reachesKillZone(unit, (range and AA.rv(range) or unitStatsAt(data, level).range) + 1)
				if frontAll then
					-- Front for everyone: standing in the first stretch of the road, not just
					-- reaching it. Each copy is moved once.
					reaches = unit:GetAttribute("AAFront") or (reaches and pathProgress(unit:GetPivot().Position) <= 0.15)
				end
				if power > idlePower and not reaches and unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm <= 0 then
					idle, idlePower = unit, power
				end
			end
		end
		Match.relocateAt = os.clock()
		if not idle and frontSpecial then
			-- Its own placing rule decides the spot (next to the damage it works with); only
			-- worth a sale when that is somewhere else now.
			frontSpecial:SetAttribute("AAFront", true)
			local spot = bestSpot(Units[frontSpecial._stats.id.Value])
			local here = frontSpecial:GetPivot().Position
			if spot and frontSpecial.Parent and (Vector3.new(spot.position.X, here.Y, spot.position.Z) - here).Magnitude > 10 then
				local id, level = frontSpecial._stats.id.Value, frontSpecial._stats.upgrade.Value
				Match.relocated[id] = (Match.relocated[id] or 0) + 1
				local before = {}
				for _, unit in ipairs(myUnits()) do
					before[unit] = true
				end
				status = "Moving " .. id .. " to the front"
				if AA.sellUnit(frontSpecial, "front") and placeUnit(byId[id]) then
					for _, unit in ipairs(scanField(true).towers) do
						if not before[unit] and unit._stats.id.Value == id then
							unit:SetAttribute("AAFront", true)
							for _ = 1, level do
								if not upgradeUnit(unit) then
									break
								end
							end
						end
					end
				end
				return
			end
		end
		if idle then
			-- Only when the spot it would get actually reaches the fight.
			local idleData = Units[idle._stats.id.Value]
			local spot = bestSpot(idleData)
			local range = idle._stats:FindFirstChild("range")
			if not spot or not idle.Parent or not AA.reachesKillZone(spot.position, (range and AA.rv(range) or unitStatsAt(idleData, idle._stats.upgrade.Value).range) + 1) then
				Match.relocated[idle._stats.id.Value] = 2
				if idle.Parent then
					idle:SetAttribute("AAFront", true)
				end
				idle = nil
			end
		end
		if idle then
			local id, level = idle._stats.id.Value, idle._stats.upgrade.Value
			Match.relocated[id] = (Match.relocated[id] or 0) + 1
			local before = {}
			for _, unit in ipairs(myUnits()) do
				before[unit] = true
			end
			status = "Moving " .. id .. " to the front"
			if AA.sellUnit(idle, "front") and placeUnit(byId[id]) then
				for _, unit in ipairs(scanField(true).towers) do
					if not before[unit] and unit._stats.id.Value == id then
						unit:SetAttribute("AAFront", true)
						for _ = 1, level do
							if not upgradeUnit(unit) then
								break
							end
						end
					end
				end
			end
			return
		end
	end
	local cash = stats.resource.Value
	if Match.lastCash and cash > Match.lastCash then
		Match.earned = (Match.earned or 0) + (cash - Match.lastCash)
	end
	Match.lastCash = cash
	Match.incomeRate = (Match.earned or 0) / math.max(os.clock() - (Match.startedAt or os.clock()), 30)
	local action, money = planAction()
	if not action then
		status = "Waiting"
		return
	end
	if money < action.cost then
		status = string.format("Saving %d/%d", money, action.cost)
		return
	end
	if action.kind == "place" and (Match.shortUntil or 0) > os.clock() then
		return
	end
	if action.kind == "place" and Config.AutoPlace then
		status = "Placing " .. tostring(action.entry.data.name or action.entry.id)
		placeUnit(action.entry)
	elseif action.kind == "upgrade" then
		status = "Upgrading " .. tostring(action.unit._stats.id.Value)
		upgradeUnit(action.unit)
	end
end

-- Units with an active ability: fire it whenever it's off cooldown (the server rejects early casts).
-- (On AA, not as locals: the file sits at the 200-local limit of the game's compiler.)
AA.SpellData = gameRequire(replicatedStorage.src.Data.IngameSpells) or {}

---Astral spells: during a match the game drops a random spell into one of the unit slots
---(session.ingame_spells[slot] = id) and it is paid for in match cash, not real currency. Cast
---the worthwhile ones on the best unit once the opening is set and the cash is there to spare,
---so a spell never starves the build. Safe = buff / summon / clone (no unit lost); All adds
---Merge. Ritual, Gate and Refund are left for the player.
function AA.useSpells()
	if Config.SpellMode == "Off" then
		return
	end
	local sess = session()
	local slots = type(sess) == "table" and sess.ingame_spells
	if type(slots) ~= "table" or not next(slots) then
		return
	end
	local field = scanField()
	-- Don't touch spells until a couple of units are down: the opening matters more.
	if #field.towers < 2 then
		return
	end
	local cash = stats.resource.Value
	local now = os.clock()
	Match.spellAt = Match.spellAt or {}
	-- Best non-farm damage unit (what has dealt the most so far), for buff / clone / merge.
	local function bestUnit()
		local best, score = nil, -1
		for _, unit in ipairs(field.towers) do
			local data = Units[unit._stats.id.Value]
			local farm = data and unitStatsAt(data, unit._stats.upgrade.Value).farm > 0
			if not farm then
				local total = unit._stats:FindFirstChild("total_damage")
				local extra = Match.extraDamage and Match.extraDamage[unit] or 0
				local amount = (total and total.Value or 0) + extra
				-- Nothing has scored yet: fall back to the most-upgraded one.
				amount = amount + unit._stats.upgrade.Value
				if amount > score then
					best, score = unit, amount
				end
			end
		end
		return best
	end
	for slot, spellId in pairs(slots) do
		local def = AA.SpellData[spellId]
		if def and now - (Match.spellAt[slot] or 0) > 5 then
			local cost = tonumber(def.cost) or 0
			local use, target
			if cash >= cost + 1000 then
				if spellId == "random_buff" then
					target = bestUnit()
					use = target ~= nil
				elseif spellId == "summon" then
					use = cash >= cost + 3000
				elseif spellId == "clone" then
					target = bestUnit()
					use = target ~= nil and cash >= cost + 3000
				elseif spellId == "sacrifice" and Config.SpellMode == "All" then
					-- Merge only when the best unit has a same-id copy inside its range to fold in.
					local pick = bestUnit()
					if pick then
						local pos = pick:GetPivot().Position
						local rangeValue = pick._stats:FindFirstChild("range")
						local reach = (rangeValue and AA.rv(rangeValue) or 15) + 2
						local id = pick._stats.id.Value
						for _, other in ipairs(field.towers) do
							if other ~= pick and other._stats.id.Value == id and (other:GetPivot().Position - pos).Magnitude <= reach then
								target, use = pick, true
								break
							end
						end
					end
				end
			end
			if use then
				Match.spellAt[slot] = now
				note("spell", { id = spellId, slot = tostring(slot), cost = cost })
				if target then
					task.spawn(invoke, "use_ingame_spell", slot, target)
				else
					task.spawn(invoke, "use_ingame_spell", slot)
				end
				cash -= cost
			end
		end
	end
end

local function useAbilities()
	if not Config.AutoAbility then
		return
	end
	Match.abilityAt = Match.abilityAt or {}
	Match.buffUntil = Match.buffUntil or {}
	local now = os.clock()
	local field = scanField()
	local enemies, mine = field.enemies, field.towers
	-- The game's own ready check: cooldown minus time since the last cast.
	local function ready(unit)
		local unitStats = unit._stats
		local cooldown, last = unitStats:FindFirstChild("active_attack_cooldown"), unitStats:FindFirstChild("last_active_cast")
		if cooldown and last then
			return cooldown.Value - (tick() - last.Value) <= 0
		end
		return now - (Match.abilityAt[unit] or 0) > 4
	end
	for _, unit in ipairs(mine) do
		local data = Units[unit._stats.id.Value]
		-- Some actives only unlock at an upgrade: the tower's own value says whether it has one now.
		local live = unit._stats:FindFirstChild("active_attack")
		local hasActive = data and ((live and live.Value ~= "nil" and live.Value ~= "") or (not live and (data.active_attack or data.show_active_attack)))
		-- Ritual (Shadow Sorcerer (Ritual) at max level): the unit is sacrificed and Holy Warlord
		-- arrives 6 s later, one at a time. Cast as soon as it unlocks, but never while a
		-- Warlord of ours stands or another ritual is on its way (that would only lose the unit).
		if hasActive and live and tostring(live.Value):find(":mahoraga", 1, true) then
			local warlord = AA.ownWarlord() ~= nil or not Config.RitualAuto
			if not warlord then
				-- The Warlord is a summoned minion: with Zombie (Risen) on the team he is only
				-- called once she stands, so he arrives with her blessing.
				local risenOnTeam, risenPlaced = false, false
				for _, entry in ipairs(equippedUnits()) do
					local synergy = AA.synergyInfo(entry.id)
					if synergy and synergy.stacks then
						risenOnTeam, Match.blesserId = true, entry.id
					end
				end
				for _, tower in ipairs(field.towers) do
					risenPlaced = risenPlaced or tower._stats.id.Value == Match.blesserId
				end
				if risenOnTeam and not risenPlaced then
					-- (At most 45 s: if she can't be placed the Ritual still happens.)
					Match.ritualWait = Match.ritualWait or now
					if now - Match.ritualWait < 45 then
						warlord = true
					end
				end
			end
			if not warlord and now - (Match.ritualAt or 0) > 15 then
				Match.ritualAt = now
				Match.abilityAt[unit] = now
				note("ritual", { wave = currentWave() })
				task.spawn(invoke, "use_active_attack", unit)
			end
			continue
		end
		-- Holy Warlord's own button doesn't attack: it switches what he hunts. Handled with his
		-- adaptations (the conductor), never fired on a timer.
		if unit._stats.id.Value == "mahoraga" then
			continue
		end
		-- Buff actives are timed by the buff conductor below.
		if hasActive and not AA.buffInfo(data) and now - (Match.abilityAt[unit] or 0) > 1 and #enemies > 0 and ready(unit) then
			-- Damage actives: only when something is actually inside the unit's range (a cast
			-- into an empty lane is a full cooldown wasted), and always on a boss in range.
			local position = unit:GetPivot().Position
			local rangeValue = unit._stats:FindFirstChild("range")
			local reach = (rangeValue and AA.rv(rangeValue) or data.range or 15) + 4
			for _, enemy in ipairs(enemies) do
				if (enemy:GetPivot().Position - position).Magnitude <= reach then
					Match.abilityAt[unit] = now
					task.spawn(invoke, "use_active_attack", unit)
					break
				end
			end
		end
	end
end

-- Buff conductor: times every Windsong / Commander cast.
-- The server tells the client about each buff going on and off (who, from whom, how long), so
-- the conductor knows exactly who is buffed and how strongly, and casts on these rules:
--   mains (the first two copies): the moment the team's buff has run out, the ready main that
--     carries the strongest buff casts;
--   supports (copies three and four): a few seconds after a main cast, as soon as a main stands
--     unbuffed, a buffed support casts. Only the unbuffed mains take it, which keeps them on
--     their own clock, still buffed when the team's buff runs out.
-- From a cold start the team gets +30%, +30%, then +100% from the second minute on.
do
	local Conductor = { active = setmetatable({}, { __mode = "k" }), readyAt = setmetatable({}, { __mode = "k" }), pending = setmetatable({}, { __mode = "k" }), lastMain = {}, lastSupport = {}, casts = 0 }
	AA.Conductor = Conductor
	local SUPPORT_DELAY = 4

	---Buff a unit carries right now: rate and when it ends (0, 0 when none).
	function Conductor.rate(unit, name)
		local record = Conductor.active[unit] and Conductor.active[unit][name]
		if record and record.ends > os.clock() then
			return record.rate, record.ends
		end
		return 0, 0
	end

	---When the buff a unit carries began (0 when it carries none).
	function Conductor.since(unit, name)
		local record = Conductor.active[unit] and Conductor.active[unit][name]
		return record and record.ends > os.clock() and record.at or 0
	end

	function Conductor.onBuff(unit, buff, params)
		if typeof(unit) ~= "Instance" or typeof(buff) ~= "Instance" or type(params) ~= "table" or type(params.damage_types) ~= "table" then
			return
		end
		local base
		for _, entry in pairs(params.damage_types) do
			base = type(entry) == "table" and tonumber(entry.rate) or base
		end
		if not base then
			return
		end
		-- A buffed caster passes on a stronger buff (measured: 30% from a caster at 30% = 69%).
		if not Conductor.guestSeen then
			-- Proof for the logs that a cast reaches other players' units.
			local owner = unit:FindFirstChild("_stats") and unit._stats:FindFirstChild("player")
			if owner and owner.Value and owner.Value ~= localPlayer then
				Conductor.guestSeen = true
				note("buffguest", { u = unit._stats:FindFirstChild("id") and unit._stats.id.Value })
			end
		end
		local caster = params.attacker_unit
		local own = typeof(caster) == "Instance" and Conductor.rate(caster, buff.Name) or 0
		Conductor.active[unit] = Conductor.active[unit] or {}
		Conductor.active[unit][buff.Name] = {
			rate = math.min(1, (1 + base) * (1 + own) - 1),
			ends = os.clock() + (tonumber(params.buff_time) or 30),
			uuid = params.buff_uuid,
			at = os.clock(),
		}
	end

	---The game's own number for the buff a unit carries (`_dmg_buff_<type>` on its stats) wins
	---over my arithmetic: a cast that reached the server after the caster's buff ran out gives
	---+50% where I worked out +100%, and a buff can be stripped early.
	function Conductor.reconcile(unit, buff, now)
		local record = Conductor.active[unit] and Conductor.active[unit][buff.name]
		if not record or record.ends <= now or now - (record.at or 0) < 1 then
			return
		end
		local truth = unit._stats:GetAttribute("_dmg_buff_" .. tostring(buff.kind))
		if type(truth) ~= "number" then
			return
		end
		if truth <= 0.01 then
			-- Gone before its time: logged with the stun flag (does a stun strip the buff?).
			Conductor.losses = (Conductor.losses or 0) + 1
			if record.ends - now > 1.5 and Conductor.losses <= 40 then
				local flag = unit._stats:FindFirstChild("unit_stunned")
				note("bufflost", { u = unit._stats.id.Value, left = math.floor(record.ends - now), stun = flag ~= nil and (flag.Value == true or (tonumber(flag.Value) or 0) > 0) or nil })
			end
			Conductor.active[unit][buff.name] = nil
		elseif math.abs(record.rate - truth) > 0.05 and truth <= 1.01 then
			record.rate = truth
		end
	end

	function Conductor.offBuff(uuid, unit, buff)
		local records = typeof(unit) == "Instance" and Conductor.active[unit]
		local record = records and typeof(buff) == "Instance" and records[buff.Name]
		if record and (record.uuid == nil or record.uuid == uuid) then
			records[buff.Name] = nil
		end
	end

	local function isReady(unit)
		if Conductor.pending[unit] and os.clock() - Conductor.pending[unit] < 1 then
			return false
		end
		-- A stunned unit can't cast: the server refuses it. (Measured after Explosive Deaths III
		-- was picked at wave 47: twelve refused casts in three waves, every one on a stunned
		-- Elfy. The buffs units already carry are not touched by a stun.) Skipping it lets
		-- another buffed copy in the damage take the cast instead of asking again and again.
		local stunned = unit._stats:FindFirstChild("unit_stunned")
		if stunned and (stunned.Value == true or (tonumber(stunned.Value) or 0) > 0) then
			return false
		end
		local known = Conductor.readyAt[unit]
		if known then
			return os.clock() >= known
		end
		-- No cast of ours on record (fresh tower, or the script was reloaded): the game's own check.
		local cooldown, last = unit._stats:FindFirstChild("active_attack_cooldown"), unit._stats:FindFirstChild("last_active_cast")
		if cooldown and last then
			return cooldown.Value - (tick() - last.Value) <= 0
		end
		return true
	end

	local function cast(unit, role, name, rate)
		local lastMainBefore, stamp = Conductor.lastMain[name], os.clock()
		Conductor.pending[unit] = stamp
		if role == "main" then
			Conductor.lastMain[name] = stamp
		end
		task.spawn(function()
			local sent = os.clock()
			local ok, accepted = invoke("use_active_attack", unit)
			Conductor.pending[unit] = nil
			if ok and accepted and unit.Parent then
				-- The server started the cooldown somewhere between the request and its answer.
				local cooldown = unit._stats:FindFirstChild("active_attack_cooldown")
				Conductor.readyAt[unit] = (sent + os.clock()) / 2 + (cooldown and cooldown.Value or 60)
				Conductor.casts += 1
				if role == "main" then
					Conductor.lastMain[name] = os.clock()
				end
				note("buff", { u = unit._stats.id.Value, r = role, pct = math.floor(rate * 100 + 0.5) })
				local info = role == "main" and AA.buffInfo(Units[unit._stats.id.Value])
				if info then
					-- What the cast really gave, by the game's own numbers, for the logs.
					task.delay(1.5, function()
						if not AA.alive or not unit.Parent then
							return
						end
						local full, part, none = 0, 0, 0
						local position, radius = unit:GetPivot().Position, AA.rv(unit._stats.range)
						for _, other in ipairs(scanField().towers) do
							local data = Units[other._stats.id.Value]
							if other ~= unit and data and not AA.buffInfo(data) and AA.buffMatches(info, data) and (other:GetPivot().Position - position).Magnitude <= radius then
								local truth = other._stats:GetAttribute("_dmg_buff_" .. tostring(info.kind))
								if type(truth) == "number" then
									if truth >= 0.99 then
										full += 1
									elseif truth > 0.01 then
										part += 1
									else
										none += 1
									end
								end
							end
						end
						note("buffreal", { full = full, part = part, none = none })
					end)
				end
			else
				-- Refused (still cooling down on the server's clock): look again in a moment.
				-- (A late refusal of a doubled request must not wipe the cooldown of the cast that
				-- went through, and a main that didn't cast must not hold the supports back.)
				if (Conductor.readyAt[unit] or 0) < os.clock() + 0.3 then
					Conductor.readyAt[unit] = os.clock() + 0.3
				end
				-- (Logged with the stun flag: the user's reading is that Explosive Deaths stuns
				-- break the buff. A stunned caster that can't cast would show up here.)
				Conductor.refusals = (Conductor.refusals or 0) + 1
				if Conductor.refusals <= 40 and unit.Parent then
					local flag = unit._stats:FindFirstChild("unit_stunned")
					note("castfail", { u = unit._stats.id.Value, r = role, stun = flag ~= nil and (flag.Value == true or (tonumber(flag.Value) or 0) > 0) or nil })
				end
				if role == "main" and Conductor.lastMain[name] == stamp then
					Conductor.lastMain[name] = lastMainBefore
				end
			end
		end)
	end

	-- Holy Warlord (the summon of Shadow Sorcerer (Ritual)): every 50 takedowns the game offers an
	-- adaptation and waits for a click. Taken in this order: the extra attack, then reach on
	-- flying enemies, then knockback. (use_custom_unit_control is what its buttons send.)
	local ADAPTATIONS = { "_mahoraga_adaptation_third", "_mahoraga_adaptation_flying", "_mahoraga_adaptation_knockback" }
	local function adaptStep()
		local folder = workspace:FindFirstChild("_UNITS")
		for _, unit in ipairs(folder and folder:GetChildren() or {}) do
			local unitStats = unit:FindFirstChild("_stats")
			local id, owner = unitStats and unitStats:FindFirstChild("id"), unitStats and unitStats:FindFirstChild("player")
			if id and id.Value == "mahoraga" and owner and owner.Value == localPlayer and Config.WarlordMode ~= "Leave" then
				-- What he hunts (his button cycles 1 strongest "BOSS" -> 2 first "DEF" -> 3 range
				-- "ATK" -> 1). Auto, the user's rule: DEF all the time; when the enemy furthest down
				-- the road is a boss, BOSS until that boss is dead, then DEF again.
				local want = Config.WarlordMode == "Boss" and 1 or Config.WarlordMode == "Front" and 2 or Config.WarlordMode == "Range" and 3 or nil
				if not want then
					local locked = Conductor.bossTarget
					local lockedHumanoid = locked and locked.Parent and locked:FindFirstChildOfClass("Humanoid")
					if not (lockedHumanoid and lockedHumanoid.Health > 0) then
						Conductor.bossTarget = nil
						local front, frontProgress = nil, -1
						for _, enemy in ipairs(scanField().enemies) do
							local humanoid = enemy:FindFirstChildOfClass("Humanoid")
							if humanoid and humanoid.Health > 0 then
								local progress = pathProgress(enemy:GetPivot().Position)
								if progress > frontProgress then
									front, frontProgress = enemy, progress
								end
							end
						end
						if front then
							local enemyId = front._stats:FindFirstChild("id") and front._stats.id.Value or front.Name
							local enemyData = Units[enemyId]
							if (enemyData and enemyData.boss) or (tostring(enemyId):find("boss") and not tostring(enemyId):find("miniboss")) then
								Conductor.bossTarget = front
								note("warlordBoss", { id = enemyId })
							end
						end
					end
					want = Conductor.bossTarget and 1 or 2
				end
				-- One press per step of the cycle: the next only once the last one has shown up
				-- on the unit (or after 4 s), so a slow update is never pressed twice.
				local mode = unit:GetAttribute("_mahoragamode") or 1
				local since = os.clock() - (Conductor.modeAt or 0)
				if mode ~= want and (since > 4 or (mode ~= Conductor.modeSeen and since > 0.4)) then
					Conductor.modeAt, Conductor.modeSeen = os.clock(), mode
					note("warlordMode", { from = mode, to = want })
					task.spawn(invoke, "use_active_attack", unit)
				end
			end
			if id and id.Value == "mahoraga" and owner and owner.Value == localPlayer and not unit:GetAttribute("_mahoraga_completed")
				and (unit:GetAttribute("_mahoraga_takedowns") or 0) >= 50 and os.clock() - (Conductor.adaptAt or 0) > 2 then
				for _, name in ipairs(ADAPTATIONS) do
					if not unit:GetAttribute(name) then
						Conductor.adaptAt = os.clock()
						note("adapt", { a = name })
						task.spawn(invoke, "use_custom_unit_control", unit, name)
						break
					end
				end
			end
		end
	end

	function Conductor.step()
		if not Config.AutoAbility or not gameStarted() or gameFinished() then
			return
		end
		adaptStep()
		local now = os.clock()
		local towers = scanField().towers
		-- Buffers by buff, oldest first (placement order decides the roles).
		local groups = {}
		for _, unit in ipairs(towers) do
			local data = Units[unit._stats.id.Value]
			local buff = AA.buffInfo(data)
			local live = unit._stats:FindFirstChild("active_attack")
			if buff and not (live and (live.Value == "nil" or live.Value == "")) then
				groups[buff.name] = groups[buff.name] or { buff = buff, units = {} }
				table.insert(groups[buff.name].units, unit)
			end
		end
		for name, group in pairs(groups) do
			local buff = group.buff
			Conductor.seeded = Conductor.seeded or {}
			if not Conductor.seeded[name] then
				-- Loaded in the middle of a match: what the units carry right now, from the
				-- game's own numbers, so the first casts aren't thrown at units that would
				-- ignore them. When each buff ends isn't known: the reconcile below drops it
				-- the moment the game's number goes to zero.
				Conductor.seeded[name] = true
				for _, unit in ipairs(towers) do
					local truth = unit._stats:GetAttribute("_dmg_buff_" .. tostring(buff.kind))
					if type(truth) == "number" and truth > 0.01 and truth <= 1.01 and Conductor.rate(unit, name) <= 0 then
						Conductor.active[unit] = Conductor.active[unit] or {}
						Conductor.active[unit][name] = { rate = truth, ends = now + (buff.duration or 30), at = now - 10 }
					end
				end
			end
			for _, unit in ipairs(towers) do
				Conductor.reconcile(unit, buff, now)
			end
			table.sort(group.units, function(x, y)
				return (x:GetAttribute("_SPAWN_UNIT_UUID") or 0) < (y:GetAttribute("_SPAWN_UNIT_UUID") or 0)
			end)
			-- How the buff works (measured): a cast gives +50% to every ally in range that carries
			-- no buff of this kind; a unit that already has one ignores the cast. A caster that is
			-- buffed itself hands out more: (1 + 50%) x (1 + its own buff) - 1, so +50% on the
			-- caster makes it the full +100%. The full buff therefore needs two casts in a row:
			-- one copy buffs another (the feed), then that one casts on a team that is out of buff.
			-- The feed must not land on the damage, or the damage sits at +50% for 30 s and
			-- ignores the full cast. Two ways to keep it off: the feeding copy stands out of reach
			-- of the damage (then the full buff comes within a second of the copies being placed),
			-- or it feeds while the damage is still buffed from the cast before (full buff from
			-- the next opening on).
			local reachOf = {}
			local function reach(unit)
				local known = reachOf[unit]
				if not known then
					local range = unit._stats:FindFirstChild("range")
					known = range and AA.rv(range) or 15
					reachOf[unit] = known
				end
				return known
			end
			---The damage a copy's cast lands on: its weight, how much of it is out of buff, and
			---when the rest runs out.
			local function team(caster)
				local position, radius = caster:GetPivot().Position, reach(caster)
				local total, open, opensAt = 0, 0, 0
				local members, opened = {}, {}
				for _, unit in ipairs(towers) do
					local unitId = unit._stats.id.Value
					local data = Units[unitId]
					if unit ~= caster and data and not AA.buffInfo(data) and AA.buffMatches(buff, data) and (unitStatsAt(data, 0).damage > 0 or AA.isSummoner(unitId))
						and (unit:GetPivot().Position - position).Magnitude <= radius then
						local damage, cooldown = unit._stats:FindFirstChild("damage"), unit._stats:FindFirstChild("attack_cooldown")
						local weight = math.max((damage and AA.rv(damage) or 1) / math.max(cooldown and AA.rv(cooldown) or 1, 0.1), 1)
						total += weight
						local _, ends = Conductor.rate(unit, name)
						members[unit] = weight
						if ends <= now then
							open += weight
							opened[unit] = true
						else
							opensAt = math.max(opensAt, ends)
						end
					end
				end
				return { total = total, open = open, opensAt = opensAt, members = members, opened = opened }
			end
			-- A copy counts as standing in the damage when it reaches a real share of what the
			-- best-placed copy reaches (a stray summon in a feeder's range doesn't make it a main).
			local info, covering, most = {}, 0, 0
			for _, unit in ipairs(group.units) do
				info[unit] = team(unit)
				most = math.max(most, info[unit].total)
			end
			for _, unit in ipairs(group.units) do
				info[unit].inside = info[unit].total > 0 and info[unit].total >= most * 0.4
				if info[unit].inside then
					covering += 1
				end
			end
			-- Two copies cast on the damage (the mains: 60 s cooldown each, one cast every 30 s), the
			-- rest feed them. The mains are the two that reach the most damage, and they keep the
			-- job while they still do (roles that flip with every upgrade break the timing below).
			Conductor.roles = Conductor.roles or {}
			local held = Conductor.roles[name] or setmetatable({}, { __mode = "k" })
			Conductor.roles[name] = held
			local order, ranked = {}, {}
			for index, unit in ipairs(group.units) do
				order[unit] = index
				if info[unit].inside then
					table.insert(ranked, unit)
				end
			end
			table.sort(ranked, function(x, y)
				local a, b = info[x].total * (held[x] and 1.25 or 1), info[y].total * (held[y] and 1.25 or 1)
				if a ~= b then
					return a > b
				end
				return order[x] < order[y]
			end)
			local mains, feeders, isMain = {}, {}, {}
			for index, unit in ipairs(ranked) do
				if index <= 2 then
					table.insert(mains, unit)
					isMain[unit] = true
				end
			end
			for unit in pairs(held) do
				if not isMain[unit] then
					held[unit] = nil
				end
			end
			for _, unit in ipairs(group.units) do
				if isMain[unit] then
					held[unit] = true
				else
					table.insert(feeders, unit)
				end
			end
			-- What a feed at less than full strength would spoil: damage that is out of buff, in the
			-- feeder's range and in a main's too (it would take the feed and then ignore the main's
			-- full cast). Damage only the feeder reaches loses nothing by it.
			for _, feeder in ipairs(feeders) do
				local harm, shared = 0, 0
				for unit, weight in pairs(info[feeder].members) do
					for _, main in ipairs(mains) do
						if info[main].members[unit] then
							shared += weight
							if info[feeder].opened[unit] then
								harm += weight
							end
							break
						end
					end
				end
				info[feeder].harm, info[feeder].shared = harm, shared
			end
			-- (A feed at the opening may cost a minor share of the damage one cycle at +50%: it
			-- happens once, the cast that follows waits four seconds, and from then on the feeds
			-- come before the damage runs out. Three Shadow Sorcerers and four Water Goddesses
			-- sat at +50% for half a match when it happened at every opening.)
			local function clean(feeder, main)
				return info[feeder].harm <= info[main].total * 0.35
			end
			---A feeder that carries a buff hands out the full one: that spoils nothing.
			local function potent(feeder)
				local rate, ends = Conductor.rate(feeder, name)
				return rate >= 0.34 and ends - now > 0.3
			end
			local function reaches(feeder, main)
				return (feeder:GetPivot().Position - main:GetPivot().Position).Magnitude <= reach(feeder)
			end
			local function opening(row)
				return row.total > 0 and row.open >= row.total * 0.5
			end
			local function feed(feeder)
				Conductor.lastSupport[name] = now
				local own = Conductor.rate(feeder, name)
				cast(feeder, "support", name, math.min(1, (1 + buff.pct) * (1 + own) - 1))
			end
			Conductor.firstSeen = Conductor.firstSeen or setmetatable({}, { __mode = "k" })
			local newest = 0
			for _, unit in ipairs(group.units) do
				Conductor.firstSeen[unit] = Conductor.firstSeen[unit] or now
				newest = math.max(newest, Conductor.firstSeen[unit])
			end
			local lastMain, lastFeed = Conductor.lastMain[name] or -math.huge, Conductor.lastSupport[name] or -math.huge
			local acted = false
			-- 1. The full buff: the damage is out of buff and a main that carries a buff is ready.
			-- A main whose own buff is under four seconds old waits until it is: that keeps its
			-- buff ending four seconds BEFORE the damage's, every cycle. In that gap the mains are
			-- out of buff while the damage still carries one, which is the one moment a feed can
			-- land on them and on nothing else, wherever the feeder stands. (Without the gap a feed
			-- at the opening hit whatever damage stood near the feeder: fine while nothing did,
			-- then +50% on everything for a minute when a few upgrades changed the picture.)
			local hold = false
			if now - lastMain >= 1.5 then
				local best, bestRate, bestEnds = nil, 0, 0
				for _, unit in ipairs(mains) do
					local rate, ends = Conductor.rate(unit, name)
					if rate >= 0.3 and ends - now > 0.25 and opening(info[unit]) and isReady(unit) then
						-- (Not the very first cast of the match: the full buff a second after the
						-- first pair is down is worth more than the gap, which the second cast sets.)
						if Conductor.lastMain[name] and now - Conductor.since(unit, name) < 4 and ends - now > 1.5 then
							hold = true
						elseif rate > bestRate or rate == bestRate and ends > bestEnds then
							best, bestRate, bestEnds = unit, rate, ends
						end
					end
				end
				if best then
					hold = false
				end
				if not best then
					-- No main can: any other copy standing in the damage that happens to carry a
					-- buff (placed after the last cast and fed since) does it just as well.
					for _, unit in ipairs(feeders) do
						local rate, ends = Conductor.rate(unit, name)
						if info[unit].inside and info[unit].total >= most * 0.8 and rate >= 0.3 and ends - now > 0.25 and opening(info[unit]) and isReady(unit) and rate > bestRate then
							best, bestRate = unit, rate
						end
					end
				end
				if best then
					cast(best, "main", name, math.min(1, (1 + buff.pct) * (1 + bestRate) - 1))
					acted = true
				end
			end
			-- 2. The damage is out of buff and the ready main carries none: a feed first, but only
			-- one that can't spoil the damage (a feeder out of its reach, or one that is buffed
			-- itself). This is what gives the full buff a second after the first pair is down.
			local feedComing = hold
			if not acted and not hold and now - lastMain >= 1.5 then
				for _, main in ipairs(mains) do
					if opening(info[main]) and Conductor.rate(main, name) <= 0 and not Conductor.pending[main] and isReady(main) then
						for _, feeder in ipairs(feeders) do
							if reaches(feeder, main) and (clean(feeder, main) or potent(feeder)) then
								if isReady(feeder) then
									if now - lastFeed >= 1.2 then
										feed(feeder)
										acted = true
									end
									feedComing = true
									break
								elseif (Conductor.readyAt[feeder] or math.huge) - now < 1.5 then
									feedComing = true
								end
							end
						end
					end
					if acted or feedComing then
						break
					end
				end
			end
			-- 3. Between casts: keep the mains on a clock of their own. Everything a main's cast
			-- reaches runs out at the same moment 30 s later, the other main included, so the main
			-- due to cast then would be out of buff exactly when it is needed (and a feed at that
			-- moment lands on the damage too). A feed a few seconds AFTER a cast lands only on the
			-- mains: the one that just cast (its own cast never hits it) and the other, whose buff
			-- from the feed 30 s earlier has just run out. From then on the main due to cast always
			-- has about 5 s of buff left when the damage runs out. Getting there from a cold start
			-- takes one cast by each main.
			if not acted and not feedComing and #mains > 0 and now - lastMain >= 4.5 and now - lastFeed >= 3 then
				-- (Not while the damage is waiting for a main's cast. A unit placed since the last
				-- cast is out of buff too: a buffed feeder's cast gives it the full buff, which is
				-- all the better.)
				local nextOpening, quiet = math.huge, true
				for _, main in ipairs(mains) do
					local row = info[main]
					if opening(row) then
						quiet = false
					end
					if row.opensAt > now then
						nextOpening = math.min(nextOpening, row.opensAt)
					end
				end
				if quiet and nextOpening < math.huge and nextOpening - now > 1 then
					local open, wait = {}, false
					for _, main in ipairs(mains) do
						local rate, ends = Conductor.rate(main, name)
						if Conductor.pending[main] then
							wait = true
						elseif rate <= 0 then
							table.insert(open, main)
						elseif ends < nextOpening - 1 then
							-- Runs out before the damage does: one feed then catches both.
							wait = true
						end
					end
					-- The main that casts next. When it still carries a buff that ends with the
					-- damage's and a feeder standing clear of the damage can feed it at that
					-- moment, the feeders are kept for that (rule 2). Otherwise the mains that are
					-- out of buff are fed now, which is what gets a cluster onto its own clock.
					local nextCaster, nextReady = nil, math.huge
					for _, main in ipairs(mains) do
						local readyAt = isReady(main) and now or (Conductor.readyAt[main] or now)
						if readyAt < nextReady then
							nextCaster, nextReady = main, readyAt
						end
					end
					if #open > 0 and not wait and nextCaster and not table.find(open, nextCaster) then
						for _, feeder in ipairs(feeders) do
							if reaches(feeder, nextCaster) and info[feeder].shared <= info[nextCaster].total * 0.35 then
								wait = true
								break
							end
						end
					end
					if #open > 0 and not wait then
						local pick, pickScore = nil, 0
						for _, feeder in ipairs(feeders) do
							if isReady(feeder) then
								local count, fine = 0, true
								for _, main in ipairs(open) do
									if reaches(feeder, main) then
										count += 1
										if not (potent(feeder) or clean(feeder, main)) then
											fine = false
										end
									end
								end
								local score = count * 10 + (potent(feeder) and 1 or 0)
								if fine and count > 0 and score > pickScore then
									pick, pickScore = feeder, score
								end
							end
						end
						if pick then
							feed(pick)
							acted = true
						end
					end
				end
			end
			-- 4. The plain buff, when nothing can feed: better +50% now than nothing. A lone first
			-- copy waits a moment for the second (if that one lands out of reach of the damage,
			-- the full buff follows within a second; a first copy that has already cast would be
			-- on cooldown for it).
			if not acted and not feedComing and now - lastFeed >= 1.2 and now - lastMain >= 1.5 then
				local data = Units[group.units[1]._stats.id.Value]
				local wanted = math.min(AA.buffCopies(buff, data), placeCap(data))
				-- (Twelve seconds: the second copy came 8 s after the first when cash was short,
				-- the first had cast at 4 s, and the team sat at +50% for 30 s instead of waiting
				-- 4 s more for the full buff.)
				-- (And while the planner is saving for the second copy, up to 45 s: on a slow start
				-- it came 25 s later and the first three casts of the match were half strength.)
				local unitId = group.units[1]._stats.id.Value
				local saving = type(Match.savingFor) == "string" and Match.savingFor:find(unitId, 1, true) ~= nil
				local building = #group.units == 1 and wanted >= 2 and now - newest < (saving and 45 or 12)
				-- (Copies often land in a burst once the cash is there: three seconds for the
				-- next one, so the first cast is made with the feeders already standing.)
				building = building or (#group.units < wanted and now - newest < 3)
				if not building then
					local pick, soon = nil, false
					for _, unit in ipairs(mains) do
						if opening(info[unit]) and Conductor.rate(unit, name) <= 0 and isReady(unit) then
							pick = pick or unit
						end
						if (Conductor.readyAt[unit] or 0) - now < 5 then
							soon = true
						end
					end
					if not pick and not soon then
						-- No main can cast for a while: a feeder that stands in open damage does it.
						for _, unit in ipairs(feeders) do
							if opening(info[unit]) and isReady(unit) then
								pick = unit
								break
							end
						end
					end
					if pick then
						cast(pick, "main", name, math.min(1, (1 + buff.pct) * (1 + Conductor.rate(pick, name)) - 1))
					end
				end
			end
		end
	end

	---What the chain is doing, for the menu and the logs.
	---One line per buff: how many of the units it helps carry it right now, and how strong.
	---(It used to list the buff each buffer carries itself, which says nothing about the team:
	---feeders sit at +50% by design.)
	function Conductor.report()
		local lines, seen = {}, {}
		local towers = scanField().towers
		for _, unit in ipairs(towers) do
			local data = Units[unit._stats.id.Value]
			local buff = AA.buffInfo(data)
			if buff and not seen[buff.name] then
				seen[buff.name] = true
				local full, part, none, copies = 0, 0, 0, 0
				for _, other in ipairs(towers) do
					local otherId = other._stats.id.Value
					local otherData = Units[otherId]
					if otherData and AA.buffInfo(otherData) then
						if AA.buffInfo(otherData).name == buff.name then
							copies += 1
						end
					elseif otherData and AA.buffMatches(buff, otherData) and (unitStatsAt(otherData, 0).damage > 0 or AA.isSummoner(otherId)) and unitStatsAt(otherData, 0).farm <= 0 then
						local rate = Conductor.rate(other, buff.name)
						local truth = other._stats:GetAttribute("_dmg_buff_" .. tostring(buff.kind))
						if type(truth) == "number" and truth <= 1.01 then
							rate = truth
						end
						if rate >= 0.99 then
							full += 1
						elseif rate > 0.01 then
							part += 1
						else
							none += 1
						end
					end
				end
				local line = string.format("%s x%d: +%d%% on %d of %d", tostring(data.name or data.id), copies, math.floor(math.min(1, (1 + buff.pct) ^ 2 - 1) * 100 + 0.5), full, full + part + none)
				if part > 0 then
					line ..= string.format(", %d lower", part)
				end
				if none > 0 then
					line ..= string.format(", %d none", none)
				end
				table.insert(lines, line)
			end
		end
		return lines
	end

	if not IS_LOBBY then
		local events = replicatedStorage.endpoints:FindFirstChild("server_to_client")
		local on, off = events and events:FindFirstChild("buff_on"), events and events:FindFirstChild("buff_off")
		if on then
			table.insert(AA.connections, on.OnClientEvent:Connect(function(unit, buff, _, params)
				Conductor.onBuff(unit, buff, params)
			end))
		end
		if off then
			table.insert(AA.connections, off.OnClientEvent:Connect(function(uuid, unit, buff)
				Conductor.offBuff(uuid, unit, buff)
			end))
		end
	end
end

local function sellAll()
	for _, unit in ipairs(myUnits()) do
		invoke("sell_unit_ingame", unit)
	end
end

local function readLevelData()
	if Match.levelPushedAt and os.clock() - Match.levelPushedAt < 5 and Match.levelData then
		-- The server just pushed the level it switched to.
		return Match.levelData
	end
	-- The client already holds the level it is in (Loader.LevelData); the remote is the fallback.
	local data = Core.Loader and rawget(Core.Loader, "LevelData")
	if type(data) ~= "table" or not data.id then
		local config = workspace:FindFirstChild("_MAP_CONFIG")
		local remote = config and config:FindFirstChild("GetLevelData")
		if remote then
			local ok, result = pcall(remote.InvokeServer, remote)
			setthreadidentity(8)
			data = ok and result or nil
		end
	end
	if type(data) == "table" then
		Match.levelData = data
		Match.levelId = data.id or Match.levelId
	end
	return Match.levelData or {}
end

AA.readLevelData = readLevelData

---What kind of match this is, from the level itself (the picked mode may have fallen back).
local function matchKind()
	local data = Match.levelData or {}
	if data.id == "__DAILY_CHALLENGE" then
		return "Daily"
	elseif data._gamemode == "challenge" or data._challenge_uuid then
		return "Challenge"
	elseif data._gamemode == "infinite_tower" then
		return "Castle"
	elseif data._dungeon then
		return "Dungeon"
	elseif data.infinite or data._gamemode == "infinite" then
		return "Infinite"
	elseif data._is_map_or_portal_level or data._portal_only_level or data.portal_group then
		-- (Before the raid check: a Sky Portal is a raid by its game mode, was logged as one,
		-- and got a plain replay vote at the end instead of the portal handling.)
		return "Portal"
	elseif data._gamemode == "raid" or data.is_raid then
		return "Raid"
	elseif data._gamemode == "story" then
		return "Story"
	end
	return Config.Mode
end
AA.matchKindName = matchKind

local function saveCastle(floor, difficulty)
	local key = "Castle" .. (difficulty or "Normal")
	-- A Hard clear below room 100 also clears the room after it (the game's get_next_room is +2).
	local cleared = (difficulty == "Hard" and floor <= 100) and floor + 1 or floor
	if (AA.progress[key] or 0) < cleared then
		AA.progress[key] = cleared
		AA.saveProgress()
	end
end
---Castle difficulty from the Difficulty setting, and the next room to climb.
function AA.castleDifficulty(floor)
	-- Rooms past 100 only exist on Hard.
	return (Config.Difficulty == "Hard" or (floor or 0) > 100) and "Hard" or "Normal"
end
function AA.castleNext()
	if Config.CastleFloor > 0 then
		return Config.CastleFloor
	end
	local tower = profile().level_data and profile().level_data.infinite_tower
	local reached = math.max((type(tower) == "table" and tonumber(tower.floor_reached) or 1) - 1, 0)
	return math.max(reached, AA.progress.CastleNormal or 0, AA.progress.CastleHard or 0) + 1
end

---Challenge rotations are numbered by the half hour (the level's _challenge_uuid is that number,
---and the profile keeps the last one beaten), so "is there a challenge I haven't cleared yet" is
---a comparison of two numbers.
function AA.challengeRotation()
	local length = tonumber(Core.Settings.CHALLENGE_DURATION) or 1800
	return math.floor(os.time() / length)
end
function AA.challengeOpen()
	local key = "challengeBeat_" .. tostring(localPlayer.UserId)
	local beaten = math.max(tonumber(profile().last_completed_challenge_uuid) or 0, tonumber(AA.progress[key]) or 0)
	-- Lost twice this rotation: leave it be until the next one (it used to be retried every few
	-- minutes for the whole half hour, squeezing out the mode picked for in between).
	local lost = AA.progress["challengeLost_" .. tostring(localPlayer.UserId)]
	if type(lost) == "table" and lost.rotation == AA.challengeRotation() and (lost.n or 0) >= 2 then
		return false
	end
	return AA.challengeRotation() > beaten
end
---Challenge / Daily mode with something still to clear (the Daily first, then this rotation's
---challenge). False in every other mode.
function AA.challengePending()
	if Config.Mode ~= "Challenge" and Config.Mode ~= "Daily" then
		return false
	end
	if (Config.Mode == "Daily" or Config.DailyWithChallenges) and AA.dailyOpen() then
		return true
	end
	return Config.Mode == "Challenge" and AA.challengeOpen()
end
---A challenge opened while a "when challenges are done" match is running. With "leave at once"
---on, the match is dropped for it (its own rewards are lost); off, the match is finished first.
---Only something that opened during this match counts: a Daily nobody can join stays "open" all
---day and must not empty every match.
function AA.leaveForChallenge(kind)
	if Match.pendingAtStart == nil then
		Match.pendingAtStart = AA.challengePending()
		return false
	end
	if not Config.ChallengeLeave or not Config.AutoJoin or Match.ended or kind == "Challenge" or kind == "Daily" then
		return false
	end
	if os.clock() - (Match.pendingCheck or 0) < 2 then
		return false
	end
	Match.pendingCheck = os.clock()
	if not AA.challengePending() then
		Match.pendingAtStart = false
		return false
	end
	return not Match.pendingAtStart
end

---The act after this one in the story order.
function AA.nextStory(id)
	local order = Order.LEVEL_ORDER or {}
	local index = table.find(order, id)
	return index and order[index + 1] or nil
end

---"Next" was voted expecting this act on this difficulty: checked when the next match loads (in
---this server or after a teleport), so a surprise costs seconds instead of a whole match.
function AA.expectMatch(levelId, difficulty)
	AA.progress.expect = { level = levelId, difficulty = difficulty, at = os.time(), user = localPlayer.UserId }
	AA.saveProgress()
end
function AA.checkExpected()
	local expect = AA.progress.expect
	if type(expect) ~= "table" then
		return
	end
	AA.progress.expect = nil
	AA.saveProgress()
	local data = Match.levelData or {}
	if expect.user ~= localPlayer.UserId or os.time() - (expect.at or 0) > 240 or not data.id then
		return
	end
	-- A level switched inside the same server shows up a moment after the flags flip: give the
	-- new level data a few seconds before calling it a surprise.
	local deadline = os.clock() + 6
	while os.clock() < deadline do
		data = AA.readLevelData()
		if data.id == expect.level and data._difficulty == expect.difficulty then
			return
		end
		task.wait(0.5)
	end
	note("unexpected", { want = tostring(expect.level) .. "/" .. tostring(expect.difficulty), got = tostring(data.id) .. "/" .. tostring(data._difficulty) })
	if Config.AutoJoin and Config.AfterGame == "Auto" then
		status = "Wrong act: back to the lobby"
		invoke("teleport_back_to_lobby")
		task.wait(10)
	end
end

local function finishMatch()
	Match.ended = true
	if Match.startedAt and os.clock() - Match.startedAt < 12 and currentWave() >= 3 then
		-- The script was (re)started inside a match that had already ended: that result is
		-- in the log already. (A reload after a win counted it twice.)
		return
	end
	local health, maxHealth = baseHealth()
	-- Where every tower stood and what it did, for the log reviews.
	Detail.towers = {}
	for _, unit in ipairs(myUnits()) do
		local total = unit._stats:FindFirstChild("total_damage")
		-- Summoners (Elyssia) deal their damage through summons and hidden hits: add what was credited to them.
		local extra = Match.extraDamage and Match.extraDamage[unit] or 0
		table.insert(Detail.towers, { u = unit._stats.id.Value, l = unit._stats.upgrade.Value, d = math.floor((total and total.Value or 0) + extra), p = math.floor(pathProgress(unit:GetPivot().Position) * 100) })
	end
	local placedCount = #Detail.towers
	-- (Holy Warlord counts as a summon, so the list above never had him.)
	local warlord = AA.ownWarlord()
	if warlord then
		local total = warlord._stats:FindFirstChild("total_damage")
		table.insert(Detail.towers, { u = "mahoraga", l = 0, d = math.floor(total and total.Value or 0), p = math.floor(pathProgress(warlord:GetPivot().Position) * 100) })
	end
	local won = health > 0
	if Match.result and os.clock() - (Match.resultAt or 0) > 30 then
		-- Left over from an earlier match in this server.
		Match.result = nil
	end
	if type(Match.result) == "table" and Match.result.victory ~= nil then
		won = Match.result.victory == true
	end
	if won then
		Stats.wins += 1
	else
		Stats.losses += 1
	end
	local data = Match.levelData or {}
	local id = Match.levelId
	local kind = matchKind()
	local wave = currentWave()
	local castle = data._gamemode == "infinite_tower"
	local floor = tonumber(data.floor_num or data._infinite_tower_floor)
	if castle and won and floor then
		saveCastle(floor, data._difficulty)
	end
	-- The match server's copy of the profile doesn't get this clear until the next lobby, so the
	-- next/replay vote would replay an act that's already done. Remember clears ourselves.
	if won and tonumber(data._challenge_uuid) and kind == "Challenge" then
		AA.progress["challengeBeat_" .. tostring(localPlayer.UserId)] = tonumber(data._challenge_uuid)
	end
	if not won and kind == "Challenge" then
		local key = "challengeLost_" .. tostring(localPlayer.UserId)
		local rotation = tonumber(data._challenge_uuid) or AA.challengeRotation()
		local lost = AA.progress[key]
		AA.progress[key] = { rotation = rotation, n = (type(lost) == "table" and lost.rotation == rotation and lost.n or 0) + 1 }
	end
	if kind == "Daily" then
		local state = AA.dailyState()
		if won then
			state.won = true
		else
			state.losses = (state.losses or 0) + 1
		end
	end
	if won and id and data._difficulty then
		local cleared = AA.myClears()
		cleared[id] = type(cleared[id]) == "table" and cleared[id] or {}
		cleared[id][data._difficulty] = true
	end
	AA.noteResult(id, won, wave)
	if AA.leakKey() ~= "?" and Config.PlaceStyle == "Auto" then
		AA.progress.paces = type(AA.progress.paces) == "table" and AA.progress.paces or {}
		AA.progress.paces[AA.leakKey()] = (Match.everLong or not won) and "long" or "speed"
		local band = AA.fightBand()
		if band then
			AA.progress.depths = type(AA.progress.depths) == "table" and AA.progress.depths or {}
			AA.progress.depths[AA.depthKey()] = math.floor(band * 100) / 100
		end
	end
	AA.saveProgress()
	status = won and "Won" or "Lost"

	-- What next: decided and voted right away, so a rematch / next act loads while the server is
	-- still sending the rewards.
	local after = Config.AfterGame
	local level = id and Levels[id]
	local story = level and level.story_level_rank ~= nil and not level.infinite
	local challengeMode = Config.Mode == "Challenge" or Config.Mode == "Daily"
	local opened = challengeMode and kind ~= "Challenge" and kind ~= "Daily"
		and ((Config.Mode == "Challenge" and AA.challengeOpen()) or (AA.challengePending() and Match.pendingAtStart == false))
	if not Config.AutoJoin or kind == "Dungeon" then
		-- Not requeueing (or the dungeon controller picks the next room).
		after = "Stay"
	elseif opened and after == "Auto" then
		-- A challenge opened while the in-between mode was running: this match is done, go take it.
		after = "Lobby"
	elseif after == "Auto" and AA.betterWaiting() then
		-- The fallback was only for while nothing better could be played.
		after = "Lobby"
	elseif castle and after == "Auto" then
		-- The in-game "next room" keeps this match's difficulty (and a fixed room would climb):
		-- a different difficulty or a fixed room goes through the lobby.
		after = (data._difficulty ~= AA.castleDifficulty(floor) or Config.CastleFloor > 0) and "Lobby" or "Castle"
	elseif after == "Auto" then
		if kind == "Challenge" or kind == "Daily" then
			-- A challenge pays once per rotation: back to the lobby for the next one (or the
			-- fallback). A lost challenge gets one more try right away while it's still open.
			after = (not won and kind == "Challenge" and (select(2, AA.lostWave(id)) or 0) < 2) and "Replay" or "Lobby"
		elseif kind == "Story" and (Config.Mode == "Story" or (challengeMode and Config.ChallengeFallback == "Story")) then
			if not won then
				-- One more go with everything in damage; an act lost three times goes back to
				-- the lobby, which farms an easier one until the team has grown.
				after = AA.tooHard(id) and "Lobby" or "Replay"
			elseif challengeMode and AA.challengeOpen() then
				-- A new challenge rolled in while this act was running.
				after = "Lobby"
			else
				-- What the lobby would pick next decides it. Tested live: "next" loads the following
				-- act in this server in ~12 s but always on Normal, and a replay keeps its
				-- difficulty. Anything else (a Hard act, a world skip, an act further on) starts
				-- from the lobby. (Logs: "next" after Act 6 loaded the next world's Act 1, an act
				-- the world skip had already cleared.)
				local okPick, nextId, nextDifficulty, nextKind = pcall(function()
					return AA.chooseTarget("Story")
				end)
				if not story then
					after = "Replay"
				elseif okPick and nextKind == "story" and nextId == AA.nextStory(id) and nextDifficulty == "Normal" then
					after = "Next"
					AA.expectMatch(nextId, "Normal")
				elseif okPick and nextKind == "story" and nextId == id and nextDifficulty == data._difficulty then
					after = "Replay"
				else
					after = "Lobby"
				end
			end
		elseif Config.Mode == "Missions" and not story then
			-- Infinite for a mission: again while it is open; once it is complete, the lobby (the
			-- reward is claimed there and the next target picked).
			after = AA.dailyKillQuest(id) and "Replay" or "Lobby"
		elseif Config.Mode == "Missions" and won and story then
			-- An act of the mission's world, played because its infinite is still locked: climb
			-- (the next act loads here in seconds; kills count on every act), and after Act 6 go
			-- to the lobby, where infinite is open now.
			local nextId = AA.nextStory(id)
			if nextId and Levels[nextId] and Levels[nextId].world == level.world then
				after = "Next"
				AA.expectMatch(nextId, "Normal")
			else
				after = "Lobby"
			end
		else
			after = "Replay"
		end
	end
	if AA.playMode() == "Quests" and Config.AutoJoin then
		-- The lobby claims the quest and picks the next one.
		after = "Lobby"
	end
	local portalNext
	if kind == "Portal" and after ~= "Lobby" and Config.AutoJoin and AA.playMode() == "Portals" then
		-- The next portal straight from the result screen (the game's own "replay with another
		-- portal" button), no lobby in between. None left of the picked kind: the lobby.
		task.wait(1.5)
		portalNext = AA.portalChoose(data.portal_group)
		after = portalNext and "Replay" or "Lobby"
	elseif kind == "Portal" and after == "Replay" then
		-- A portal match is never replayed by a plain vote: that would spend another use of
		-- the portal without it having been picked (the mode was changed during the match).
		after = "Lobby"
	end
	note("end", { won = won, after = after, portal = portalNext and portalNext.id or nil })
	if after == "Castle" then
		task.spawn(invoke, "request_start_infinite_tower_from_game", (won and floor) and floor + 1 or floor or 1)
	elseif after == "Next" then
		task.spawn(invoke, "set_game_finished_vote", "next_story")
	elseif after == "Replay" and portalNext then
		task.spawn(invoke, "set_game_finished_vote", "replay", { item_uuid = portalNext.uuid })
	elseif after == "Replay" then
		task.spawn(invoke, "set_game_finished_vote", "replay")
	end

	-- The server's own result (gems, drops) arrives about three seconds after the finish flag.
	local deadline = os.clock() + 5
	while not Match.result and os.clock() < deadline and gameFinished() do
		task.wait(0.1)
	end
	local result = type(Match.result) == "table" and Match.result or {}
	local items = {}
	for _, item in pairs(type(result.new_items) == "table" and result.new_items or {}) do
		if type(item) == "table" and item.item_id then
			items[item.item_id] = (items[item.item_id] or 0) + (tonumber(item.amount) or 1)
		end
	end
	for itemId, amount in pairs(Match.dropLog or {}) do
		if not items[itemId] then
			items[itemId] = amount
		end
	end
	local units = {}
	for _, unit in pairs(type(result.new_units) == "table" and result.new_units or {}) do
		table.insert(units, type(unit) == "table" and tostring(unit.unit_id or unit.id) or tostring(unit))
	end
	local summary = {
		level = id,
		name = data.name,
		won = won,
		wave = wave,
		-- Event currency earned in the match itself (the balance at the last logged wave minus
		-- the one at the first): the clear bonus is paid after this and isn't in it.
		eventCash = AA.runEventCash(),
		waves = (type(result.stats) == "table" and tonumber(result.stats.num_waves)) or Match.totalWaves or nil,
		time = math.floor(os.clock() - Match.startedAt),
		at = os.time(),
		mode = kind,
		picked = Config.Mode,
		user = localPlayer.UserId,
		challenge = data._challenge,
		difficulty = data._difficulty,
		hp = math.floor(math.max(health, 0)),
		maxHp = math.floor(maxHealth),
		firstPlace = Match.firstPlaceAt and math.floor(Match.firstPlaceAt) or nil,
		placed = placedCount,
		gems = tonumber(result.gem_reward),
		gold = tonumber(result.gold_reward),
		xp = tonumber(result.xp_reward),
		first = result.first_completion or nil,
		items = next(items) and items or nil,
		units = #units > 0 and units or nil,
		after = after,
	}
	logMatch(summary)
	saveDetail(summary)
	pcall(AA.CardBrain.learnRun, id, won, wave)
	if won and id then
		AA.progress.cleared = type(AA.progress.cleared) == "table" and AA.progress.cleared or {}
		AA.progress.cleared[id] = true
	end
	-- What the run paid in event currency isn't in the result: the lobby works it out from the
	-- balance (before the match / on the way back) and adds it to this entry.
	AA.progress.resRun = { at = summary.at, runs = (type(AA.progress.resRun) == "table" and AA.progress.resRun.runs or 0) + 1 }
	AA.saveProgress()
	if after == "Stay" then
		return
	end
	-- A rematch restarts in this server; a next act teleports. If neither happens, go back to the lobby.
	deadline = os.clock() + (after == "Lobby" and 0 or 20)
	while AA.alive and os.clock() < deadline and gameFinished() do
		task.wait(0.5)
	end
	if AA.alive and gameFinished() then
		invoke("teleport_back_to_lobby")
	end
end

---Event currency (Summer Pearls) earned so far in this match, from the per-wave log.
function AA.runEventCash()
	local first, last
	for _, row in ipairs(Detail.waves) do
		if row.res then
			first = first or row.res
			last = row.res
		end
	end
	return first and last and (last - first) or nil
end

function AA.startDetail()
	table.clear(Detail.events)
	table.clear(Detail.waves)
	Detail.startedAt, Detail.lastHealth, Detail.lastWave = os.clock(), nil, nil
	Detail.team = {}
	local owned = collectionData().owned_units or {}
	for _, entry in ipairs(equippedUnits()) do
		local unit = owned[entry.uuid] or {}
		table.insert(Detail.team, { id = entry.id, xp = math.floor(unit.xp or 0), cost = entry.data.cost, cap = placeCap(entry.data) })
	end
	Detail.config = { PlaceStart = Config.PlaceStart, Targeting = Config.Targeting, FarmFirst = Config.FarmFirst, LeakGuard = Config.LeakGuard, LeakSell = Config.LeakSell, MaxPerUnit = Config.MaxPerUnit }
end

