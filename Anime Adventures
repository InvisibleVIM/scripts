-- One pass over workspace._UNITS per tick, shared by everything that needs the board: the towers
-- I placed, my summons (jellyfish, eels, titans... they carry their tower in _stats.parent_unit and
-- used to be counted as placed units), other players' towers, and the enemies.
local Field = { at = -1, towers = {}, summons = {}, enemies = {}, others = {} }
AA.Field = Field
local function scanField(fresh)
	local now = os.clock()
	if not fresh and now - Field.at < 0.1 then
		return Field
	end
	local towers, summons, enemies, others = {}, {}, {}, {}
	local folder = workspace:FindFirstChild("_UNITS")
	for _, unit in ipairs(folder and folder:GetChildren() or {}) do
		local unitStats = unit:FindFirstChild("_stats")
		local owner = unitStats and unitStats:FindFirstChild("player")
		if owner then
			local parent = unitStats:FindFirstChild("parent_unit")
			local parentValue = parent and parent.Value
			local summoned = parentValue ~= nil and parentValue ~= "nil" and parentValue ~= ""
			if owner.Value == localPlayer then
				if summoned then
					table.insert(summons, unit)
				elseif unitStats:FindFirstChild("id") and unitStats:FindFirstChild("upgrade") then
					table.insert(towers, unit)
				end
			elseif owner.Value then
				if not summoned then
					table.insert(others, unit)
				end
			else
				table.insert(enemies, unit)
			end
		end
	end
	Field.at, Field.towers, Field.summons, Field.enemies, Field.others = now, towers, summons, enemies, others
	return Field
end

---The towers I placed (never their summons).
local function myUnits()
	return scanField().towers
end
