	-- (Own function scope: the scripts sit close to Luau's 200-local limit.)
	;(function()
	-- My songs: your own files in Potent/music/<Playlist>/ (shared by every Potent script).
	-- One player for every game: playlist filter, search, shuffle, and the playing song lit up.
	local MUSIC_ROOT = "Potent/music"
	local Player = { queue = {}, index = 0, rows = {}, cache = {} }
	UI.player = Player

	local function fileName(path)
		return tostring(path):match("([^/\\]+)$") or tostring(path)
	end

	function Player.playlists()
		local names = {}
		pcall(function()
			if not isfolder(MUSIC_ROOT) then
				makefolder(MUSIC_ROOT)
			end
			for _, path in ipairs(listfiles(MUSIC_ROOT)) do
				if isfolder(path) then
					table.insert(names, fileName(path))
				end
			end
		end)
		table.sort(names)
		return names
	end

	---Songs in one playlist (or "All", duplicates dropped). "Artist - Title.mp3" splits into both.
	function Player.songs(playlist, refresh)
		if playlist ~= "All" and Player.cache[playlist] and not refresh then
			return Player.cache[playlist]
		end
		if playlist == "All" then
			local list, seen = {}, {}
			for _, name in ipairs(Player.playlists()) do
				for _, song in ipairs(Player.songs(name, refresh)) do
					local key = (song.artist .. "|" .. song.title):lower()
					if not seen[key] then
						seen[key] = true
						table.insert(list, song)
					end
				end
			end
			table.sort(list, function(a, b)
				return a.label:lower() < b.label:lower()
			end)
			return list
		end
		local list = {}
		pcall(function()
			for _, path in ipairs(listfiles(MUSIC_ROOT .. "/" .. playlist)) do
				local file = fileName(path)
				local base, ext = file:match("^(.+)%.(%w+)$")
				ext = ext and ext:lower()
				if base and (ext == "mp3" or ext == "ogg" or ext == "wav" or ext == "flac") then
					local artist, title = base:match("^(.-) %- (.+)$")
					table.insert(list, {
						path = MUSIC_ROOT .. "/" .. playlist .. "/" .. file,
						title = title or base,
						artist = artist or "",
						playlist = playlist,
						label = title and (title .. "  -  " .. artist) or base,
					})
				end
			end
		end)
		table.sort(list, function(a, b)
			return a.label:lower() < b.label:lower()
		end)
		Player.cache[playlist] = list
		return list
	end

	---What the list shows: the picked playlist, narrowed by the search text.
	function Player.visible()
		local list = Player.songs(Config.MyMusicPlaylist or "All")
		local query = (Player.query or ""):lower()
		if query == "" then
			return list
		end
		local found = {}
		for _, song in ipairs(list) do
			if song.label:lower():find(query, 1, true) then
				table.insert(found, song)
			end
		end
		return found
	end

	local function shuffled(list, first)
		local copy = table.clone(list)
		for i = #copy, 2, -1 do
			local j = math.random(i)
			copy[i], copy[j] = copy[j], copy[i]
		end
		if first then
			for i, song in ipairs(copy) do
				if song.path == first.path then
					table.remove(copy, i)
					break
				end
			end
			table.insert(copy, 1, first)
		end
		return copy
	end

	local function soundObject()
		if not (Player.sound and Player.sound.Parent) then
			Player.sound = create("Sound", { Name = "PotentMyMusic", Looped = false, Parent = game:GetService("SoundService") })
			Player.sound.Ended:Connect(function()
				task.defer(Player.next, 1)
			end)
		end
		return Player.sound
	end

	function Player.play(song)
		if not song then
			return
		end
		local ok, asset = pcall(getcustomasset, song.path)
		if not ok then
			Player.status = "Can't open " .. song.title
			return
		end
		local sound = soundObject()
		Player.current = song
		Player.paused = false
		sound.SoundId = asset
		sound.Volume = (Config.MyMusicVolume or 50) / 100
		sound.TimePosition = 0
		sound:Play()
		Player.startedAt = os.clock()
		Player.highlight()
	end

	---Start a queue from a list; with shuffle on it's shuffled (the clicked song still plays first).
	function Player.start(list, song)
		if #list == 0 then
			return
		end
		if Config.MyMusicShuffle then
			Player.queue = shuffled(list, song)
			Player.index = 1
		else
			Player.queue, Player.index = list, 1
			for i, entry in ipairs(list) do
				if song and entry.path == song.path then
					Player.index = i
				end
			end
		end
		Config.MyMusicOn = true
		Player.play(Player.queue[Player.index])
	end

	function Player.next(step)
		if not Config.MyMusicOn then
			return
		end
		if #Player.queue == 0 then
			Player.start(Player.visible())
			return
		end
		Player.index = (Player.index - 1 + (step or 1)) % #Player.queue + 1
		if Player.index == 1 and (step or 1) > 0 and Config.MyMusicShuffle then
			Player.queue = shuffled(Player.queue)
		end
		Player.play(Player.queue[Player.index])
	end

	function Player.togglePause()
		local sound = Player.sound
		if not (sound and Player.current) then
			Player.start(Player.visible())
			return "Playing"
		end
		if Player.paused then
			sound:Resume()
			Player.paused = false
			return "Playing"
		end
		sound:Pause()
		Player.paused = true
		return "Paused"
	end

	function Player.stop()
		if Player.sound then
			Player.sound:Stop()
		end
		Player.current, Player.paused = nil, false
		Player.highlight()
	end

	---Quiet the game's own long tracks while your song plays (effects stay).
	-- Quiet the game's own long tracks while our music plays (effects stay). Lobby/map music
	-- scripts fade their volume back up, so each muted track is held at 0 by a Volume watcher
	-- (the game's latest volume is kept for when it's given back). One muter per music engine.
	function UI.makeMuter()
		local muted, groupVolume, scanAt = {}, nil, 0
		local function check(sound)
			if sound:IsA("Sound") and sound.Name ~= "PotentMusic" and sound.Name ~= "PotentMyMusic" and sound.Name ~= "PotentClassicTheme"
				and sound.TimeLength > 40 and not muted[sound] and (sound.IsPlaying or sound.Volume > 0) then
				local record = { volume = sound.Volume }
				record.connection = sound:GetPropertyChangedSignal("Volume"):Connect(function()
					if sound.Volume > 0 then
						record.volume = sound.Volume
						sound.Volume = 0
					end
				end)
				muted[sound] = record
				sound.Volume = 0
			end
		end
		return function(mute)
			local group = game:GetService("SoundService"):FindFirstChild("Music")
			group = group and group:IsA("SoundGroup") and group or nil
			if not mute then
				for sound, record in pairs(muted) do
					record.connection:Disconnect()
					pcall(function()
						sound.Volume = record.volume
					end)
				end
				table.clear(muted)
				if group and groupVolume then
					group.Volume = groupVolume
				end
				groupVolume, scanAt = nil, 0
				return
			end
			if group then
				groupVolume = groupVolume or group.Volume
				group.Volume = 0
			end
			if os.clock() - scanAt < 3 then
				return
			end
			scanAt = os.clock()
			for _, sound in ipairs(game:GetService("SoundService"):GetDescendants()) do
				check(sound)
			end
			for _, child in ipairs(workspace:GetChildren()) do
				if child:IsA("Sound") then
					check(child)
				elseif child:IsA("Folder") or child:IsA("Configuration") then
					for _, sound in ipairs(child:GetDescendants()) do
						check(sound)
					end
				end
			end
			local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
			for _, sound in ipairs(playerGui and playerGui:GetDescendants() or {}) do
				check(sound)
			end
			for sound, record in pairs(muted) do
				if not sound.Parent then
					record.connection:Disconnect()
					muted[sound] = nil
				end
			end
		end
	end
	Player.muteGame = UI.makeMuter()

	local function clock(seconds)
		seconds = math.max(0, math.floor(seconds or 0))
		return string.format("%d:%02d", seconds // 60, seconds % 60)
	end

	-- The playing song's row: accent bar on the left, accent text, "> " in front.
