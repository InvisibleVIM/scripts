		end
		return color
	end

	local function computeRoles()
		local roles = {}
		for _, entry in ipairs(THEME) do
			roles[entry.role] = readColor(entry.key, entry.default)
		end
		roles.Control = roles.Main:Lerp(roles.Font, 0.07)
		roles.Raised = roles.Main:Lerp(roles.Font, 0.13)
		roles.Muted = roles.Font:Lerp(roles.Main, 0.42)
		return roles
	end
	UI.roles = computeRoles()
	---Text / knob color that reads on top of the accent, whatever accent the theme picks.
	function UI.onAccent()
		local accent = UI.roles.Accent
		return (0.299 * accent.R + 0.587 * accent.G + 0.114 * accent.B) > 0.5 and UI.roles.Background or UI.roles.Font
	end

	-- The scripts' own custom rows use the palette constants: point them at the theme.
	local function syncConstants()
		local roles = UI.roles
