	---A stack of rows that is rebuilt whenever its content changes (banner odds, drop tables).
	---Returns set(rows). A row is one of:
	---  { title = "Summer 2026", right = "150 Summer Pearls a pull" }   group heading
	---  { name = "Phoenix", value = "0.25%", extra = "1 in 400", accent = true, tick = true }
	---  { note = "..." }                                               wrapped small print
	---  { gap = true }
	function UI.list(page)
		local body = slot(page, 80)
		local holder = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = UI.nextOrder(),
			Parent = body,
		}, { create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }) })
		-- A hint() after the list becomes a "?" at the end of the card's title.
		local cardTitle = body:FindFirstChildWhichIsA("TextLabel")
		if cardTitle then
			UI.markRow(page, cardTitle, UDim2.new(1, 0, 0, 2))
		end
		local signature
		return function(rows)
			local now = httpService:JSONEncode(rows)
			if now == signature then
				return
			end
			signature = now
			for _, child in ipairs(holder:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			for index, row in ipairs(rows) do
				if row.gap then
					create("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundTransparency = 1, LayoutOrder = index, Parent = holder })
				elseif row.title then
					local head = create("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = index, Parent = holder }, {
						create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
					})
					label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = row.title, FontFace = CODE_BOLD, TextSize = 15, LayoutOrder = 1, Parent = head })
					create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = label({ Size = UDim2.new(0, 0, 1, 0), Text = row.right or "", TextSize = 13, TextColor3 = UI.roles.Muted, TextXAlignment = Enum.TextXAlignment.Right, LayoutOrder = 2, Parent = head }) })
				elseif row.note then
					label({ Size = UDim2.new(1, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.Y, Text = row.note, TextSize = 13, LineHeight = 1.15, TextColor3 = UI.roles.Muted, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = index, Parent = holder })
				else
					local line = create("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = UI.roles.Control, BorderSizePixel = 0, LayoutOrder = index, Parent = holder }, {
						create("UICorner", { CornerRadius = UDim.new(0, 6) }),
						create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 9) }),
						create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }),
					})
					if row.accent then
						create("Frame", { Size = UDim2.fromOffset(3, 14), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, LayoutOrder = 1, Parent = line }, { create("UICorner", { CornerRadius = UDim.new(0, 2) }) })
					end
					local name = label({ Size = UDim2.new(0, 0, 1, 0), Text = tostring(row.name) .. (row.tick and (' <font color="#%s">\u{2713}</font>'):format(WIN:ToHex()) or ""), RichText = true, TextSize = 14, FontFace = row.accent and CODE_MEDIUM or CODE, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 2, Parent = line })
					create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = name })
					if row.extra then
						label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = row.extra, TextSize = 13, TextColor3 = UI.roles.Muted, LayoutOrder = 3, Parent = line })
					end
					if row.value then
						label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = row.value, TextSize = 14, FontFace = CODE_MEDIUM, TextXAlignment = Enum.TextXAlignment.Right, LayoutOrder = 4, Parent = line })
					end
				end
			end
		end
	end
	---Theme presets as small pictures of the window in that theme; click one to wear it.
	function UI.themeGrid(page)
		local rows = math.ceil(#UI.PRESETS / 2)
		local grid = UI.rowBase(page, rows * 104 + (rows - 1) * 10, false)
		create("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 104), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
		local rings = {}
		local function paint(parent, props, color, radius)
			props.BackgroundColor3 = color
			props.BorderSizePixel = 0
			props.Parent = parent
			local frame = create("Frame", props, { create("UICorner", { CornerRadius = UDim.new(0, radius or 3) }) })
			frame:SetAttribute("NoTheme", true)
			return frame
		end
		local function refresh()
			for name, ring in pairs(rings) do
				local current = (Config.ThemeName or "") == name
				ring.Thickness = current and 2 or 1
				ring.Transparency = current and 0 or 0.4
			end
		end
		for index, preset in ipairs(UI.PRESETS) do
			local back, main, accent, outline, font = Color3.fromHex(preset[2]), Color3.fromHex(preset[3]), Color3.fromHex(preset[4]), Color3.fromHex(preset[5]), Color3.fromHex(preset[6])
			local card = create("TextButton", { BackgroundColor3 = back, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = index, Parent = grid }, { create("UICorner", { CornerRadius = UDim.new(0, 9) }) })
			card:SetAttribute("NoTheme", true)
			local ring = create("UIStroke", { Color = accent, Thickness = 1, Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = card })
			ring:SetAttribute("NoTheme", true)
			rings[preset[1]] = ring
			-- The window in miniature: side tabs, a headline, two lines of text, a button.
			paint(card, { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 56) }, main, 6)
			paint(card, { Position = UDim2.fromOffset(14, 16), Size = UDim2.fromOffset(4, 4) }, accent, 2)
			paint(card, { Position = UDim2.fromOffset(14, 26), Size = UDim2.fromOffset(14, 5) }, outline, 2)
			paint(card, { Position = UDim2.fromOffset(14, 36), Size = UDim2.fromOffset(14, 5) }, outline, 2)
			paint(card, { Position = UDim2.fromOffset(14, 46), Size = UDim2.fromOffset(14, 5) }, outline, 2)
			paint(card, { Position = UDim2.fromOffset(38, 17), Size = UDim2.new(0.5, -20, 0, 5) }, font, 2)
			paint(card, { Position = UDim2.fromOffset(38, 28), Size = UDim2.new(0.75, -30, 0, 4) }, font:Lerp(main, 0.55), 2)
			paint(card, { Position = UDim2.fromOffset(38, 37), Size = UDim2.new(0.6, -30, 0, 4) }, font:Lerp(main, 0.55), 2)
			paint(card, { Position = UDim2.fromOffset(38, 47), Size = UDim2.fromOffset(40, 10) }, accent, 3)
			local footer = paint(card, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 8, 1, -8), Size = UDim2.new(1, -16, 0, 26) }, accent, 6)
			local bright = (0.299 * accent.R + 0.587 * accent.G + 0.114 * accent.B) > 0.5
			local caption = label({ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = preset[1], FontFace = CODE_BOLD, TextSize = 14, TextColor3 = bright and Color3.fromHex("14161C") or Color3.new(1, 1, 1), Parent = footer })
			caption:SetAttribute("NoTheme", true)
			card.MouseButton1Click:Connect(function()
				Config.ThemeName = preset[1]
				Config.UseDefaultTheme = false
				UI.useTheme({ ThemeBackground = preset[2], ThemeMain = preset[3], ThemeAccent = preset[4], ThemeOutline = preset[5], ThemeFont = preset[6] })
				refresh()
			end)
		end
		table.insert(UI.refreshers, refresh)
		refresh()
	end

	-- Controls. Every builder takes the page; heading() opens a new card.
	function UI.heading(page, text, side)
		newBox(page, text, side)
		UI.lastRow[page] = nil
	end

	function UI.rowBase(page, height, clickable)
		local row = create(clickable and "TextButton" or "Frame", {
