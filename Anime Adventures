				local res = Traits.resources(unit)
				local remnants = res.limited + res.remnants
				ownLine.Text = string.format("You have %d reroll %s and %d Star %s%s.%s", res.tokens, res.tokens == 1 and "token" or "tokens", remnants, remnants == 1 and "Remnant" or "Remnants", res.limited > 0 and (" (" .. res.limited .. " limited)") or "", unit and (" A roll on " .. Traits.unitName(unit) .. " takes " .. res.per .. (res.per == 1 and " Remnant" or " Remnants") .. " or 1 token.") or "")
				if unit then
					local names = {}
					local _, map = Traits.options()
					for _, key in ipairs(Traits.wanted(uuid)) do
						table.insert(names, map[key] and map[key].name or key)
					end
					unitValue.Text = Traits.unitName(unit)
					nowValue.Text = Traits.label(unit)
					wantValue.Text = #names > 0 and table.concat(names, ", ") or "Nothing ticked yet"
					wantNote.Text = "Kept for " .. Traits.unitName(unit) .. " only. You can change the list while it rolls."
				else
					unitValue.Text, nowValue.Text, wantValue.Text = "None picked", "", ""
					wantNote.Text = "Pick a unit to choose its traits."
				end
				local chance = unit and Traits.chance(uuid) or 0
				local affordable = unit and Traits.rollsLeft(res, Config.TraitUse) or 0
				local shownRun = run or (Traits.ended and Traits.ended.uuid == uuid and Traits.ended) or nil
				tiles["Rolls this run"].Text = tostring(shownRun and shownRun.rolls or 0)
				tiles["Chance a roll"].Text = chance > 0 and percent(chance) or "n/a"
				tiles["Rolls you can pay for"].Text = unit and tostring(affordable) or "n/a"
				tiles["Chance with those"].Text = (chance > 0 and affordable > 0) and percent((1 - (1 - chance / 100) ^ affordable) * 100) or "n/a"
				local text = Traits.text
				if run and run.uuid ~= uuid then
					text = "Rolling for " .. Traits.unitName(Traits.unit(run.uuid)) .. ". " .. text
				elseif not run then
					if Traits.state == "idle" or text == "" or (Traits.ended and Traits.ended.uuid ~= uuid and Traits.state ~= "confirm") then
						local ok, reason = Traits.check(uuid, true)
						text = ok and (chance > 0 and string.format("Ready. One roll in %d lands a trait on the list.", math.max(math.floor(100 / chance + 0.5), 1)) or "Ready.") or reason
					end
				end
				if #Traits.recent > 0 and (run or Traits.state ~= "idle") then
					text = text .. "\nLast rolls: " .. table.concat(Traits.recent, ", ") .. "."
				end
				statusText.Text = text
				-- Ratings: every 3 seconds (they are kept between changes).
				if os.clock() - ratingsAt >= 3 then
					ratingsAt = os.clock()
					local ok, report = pcall(AA.Eval.report, 3)
					local rows, notes = {}, {}
					local function add(row)
						local value = row.value
						local figure = value.kind == "farm" and (AA.Eval.short(value.income) .. " a wave") or (value.paper > 0 and AA.Eval.short(value.paper) or "")
						local basis = AA.Eval.basis(value)
						if value.play > 0 then
							basis = basis .. ", team score " .. AA.Eval.short(value.play)
						end
						table.insert(rows, { name = value.name, value = figure, extra = basis, accent = row.slot ~= nil })
						if value.kind == "partial" and #value.gaps > 0 then
							table.insert(notes, value.name .. " is rated without " .. table.concat(value.gaps, ", ") .. ".")
						elseif value.kind == "unknown" and value.why then
							table.insert(notes, value.name .. ": " .. value.why)
						end
					end
					if ok and #report.team > 0 then
						table.insert(rows, { title = "Equipped", right = "damage a second on paper" })
						for _, row in ipairs(report.team) do
							add(row)
						end
						if #report.bench > 0 then
							table.insert(rows, { gap = true })
							table.insert(rows, { title = "Strongest not equipped" })
							for _, row in ipairs(report.bench) do
								add(row)
							end
						end
						local seen = {}
						for _, note in ipairs(notes) do
							if not seen[note] then
								seen[note] = true
								table.insert(rows, { note = note })
							end
						end
					else
						table.insert(rows, { note = "Your units are read once the game has loaded your collection." })
					end
					setRatings(rows)
				end
			end
			-- Fresh the moment the page opens or a control on it changes, not half a second later.
			table.insert(UI.refreshers, function()
				pcall(view.teamTick, true)
			end)
			page:GetPropertyChangedSignal("Visible"):Connect(function()
				if page.Visible then
					unitsAt, ratingsAt = 0, 0
					pcall(view.teamTick)
				end
			end)
			pcall(view.teamTick, true)
		end

