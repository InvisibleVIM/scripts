local function gameRequire(module)
	setthreadidentity(2)
	local ok, result = pcall(require, module)
	setthreadidentity(8)
	return ok and result or nil
end

---Loaded game data tables (Units, Levels, Worlds) live in the Loader's module environments.
local function findData(key, probe)
	local ok, list = pcall(filtergc, "table", { Keys = { key } }, false)
	if ok and list then
		for _, holder in ipairs(list) do
			local value = rawget(holder, key)
			if type(value) == "table" and value[probe] ~= nil then
				return value
			end
		end
	end
	return nil
end

