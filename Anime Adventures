-- Autosave whenever a setting changes.
do
	local lastSaved = encodeSettings()
	local elapsed = 0
	table.insert(AA.connections, runService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.5 then
			return
		end
		elapsed = 0
		local encoded = encodeSettings()
		if encoded ~= lastSaved then
			lastSaved = encoded
			saveSettings()
		end
	end))
end

-- Live status line and stats.
do
	local elapsed = 0
	table.insert(AA.connections, runService.RenderStepped:Connect(function(dt)
		local busy = Config.AutoJoin or (not IS_LOBBY and (Config.AutoPlace or Config.AutoUpgrade))
		if busy then
			mark.Rotation = (mark.Rotation + dt * 180) % 360
		end
		statusLabel.Text = (status == nil or status == "") and (busy and "Working" or "Idle") or status
		statusLabel.TextColor3 = busy and TEXT or MUTED
		elapsed += dt
		if elapsed < 0.5 then
			return
		end
		elapsed = 0
		local id, difficulty, kind = chooseTarget()
		local level = id and Levels[id]
		if kind == "castle" then
			targetLine.Text = "Next: Infinity Castle room " .. tostring(id) .. " (" .. tostring(difficulty) .. ")"
		elseif kind == "skip" then
			targetLine.Text = "Next: skip " .. tostring(worldName(id)) .. " to Act 6"
		elseif kind == "dungeon" or kind == "tournament" then
			targetLine.Text = "Next: " .. (kind == "dungeon" and "Dungeon run" or "Tournament")
		elseif not id then
			targetLine.Text = kind == "raid" and "Next: waiting for a raid to open" or ((kind == "artifact" or kind == "locked") and "Next: locked (clear the story acts before it)" or "Next: nothing open")
		else
			targetLine.Text = "Next: " .. (level and (tostring(worldName(level.world) or "Portal") .. " " .. tostring(level.name) .. (difficulty and (" on " .. tostring(difficulty)) or "")) or tostring(id))
		end
		if not IS_LOBBY then
			local health, maxHealth = baseHealth()
			local field = scanField()
			matchLine.Text = string.format("Level: %s (%s%s)\nWave %d%s   Cash %d   Base %d/%d\nTowers %d   Summons %d   Enemies %d   Pace %s", tostring(Match.levelId), matchKind(), (Match.levelData or {})._difficulty and (", " .. tostring(Match.levelData._difficulty)) or "", currentWave(), Match.totalWaves and ("/" .. Match.totalWaves) or "", stats.resource.Value, math.floor(health), math.floor(maxHealth), #field.towers, #field.summons, #field.enemies, tostring(Match.pace)) .. (#AA.Conductor.report() > 0 and ("\nBuffers: " .. table.concat(AA.Conductor.report(), "   ")) or "")
		else
			matchLine.Text = "In the lobby"
		end
		local pd = profile()
		local hours = math.max(os.time() - Stats.startedAt, 60) / 3600
		do
			-- The strip under the title: where it is and how the base is doing, or what comes next.
			local sub, healthFraction = targetLine.Text, nil
			if not IS_LOBBY then
				local health, maxHealth = baseHealth()
				local level = Match.levelId and Levels[Match.levelId]
				local place = level and ((worldName(level.world) and (worldName(level.world) .. " ") or "") .. tostring(level.name)) or ((Match.levelData or {}).name or matchKind())
				local total = Match.totalWaves
				sub = string.format("%s, wave %d%s, base %d%%", tostring(place), currentWave(), total and (" of " .. total) or "", maxHealth > 0 and math.floor(health / maxHealth * 100 + 0.5) or 0)
				healthFraction = maxHealth > 0 and health / maxHealth or 0
			elseif not Config.AutoJoin then
				sub = "Auto join is off. " .. sub
			end
			UI.setNow({ sub = sub, busy = busy, wins = Stats.wins, losses = Stats.losses, rate = Stats.gemRate or math.floor(Stats.gems / hours), health = healthFraction })
		end
		do
			local rows = UI.statRows
			rows["Wins"].Text = tostring(Stats.wins)
			rows["Losses"].Text = tostring(Stats.losses)
			rows["Gems from matches"].Text = string.format("%d (%d matches)", Stats.gems, Stats.rateMatches or 0)
			rows["Gems an hour"].Text = tostring(Stats.gemRate or math.floor(Stats.gems / hours))
			rows["Gems"].Text = tostring(stats:FindFirstChild("gem_amount") and stats.gem_amount.Value or pd.gem_amount)
			rows["Gold"].Text = tostring(stats:FindFirstChild("gold_amount") and stats.gold_amount.Value or pd.gold_amount)
			rows["Level XP"].Text = tostring(stats:FindFirstChild("player_xp") and stats.player_xp.Value or pd.player_xp)
			rows["Units placed"].Text = tostring(Stats.placed)
			rows["Upgrades"].Text = tostring(Stats.upgrades)
			rows["Summons"].Text = tostring(Stats.summons)
			rows["Codes redeemed"].Text = tostring(Stats.codes)
			local over = UI.over
			local dropKey = IS_LOBBY and tostring(id) or tostring(Match.levelId)
			if dropKey ~= UI.dropKey then
				UI.dropKey = dropKey
				local okDrops, text = pcall(AA.dropText, IS_LOBBY and id or Match.levelId, (not IS_LOBBY) and Match.levelData or nil)
				text = okDrops and text or "Could not read the drops."
				-- "Name: value" lines become rows, sentences stay small print.
				local rows = {}
				for line in tostring(text):gmatch("[^\n]+") do
					local name, value = line:match("^(.-): (.+)$")
					if line:sub(1, 2) == "# " then
						if #rows > 0 then
							table.insert(rows, { gap = true })
						end
						table.insert(rows, { title = line:sub(3) })
					elseif name and #name + #value <= 27 then
						table.insert(rows, { name = name, value = value })
					else
						table.insert(rows, { note = line })
					end
				end
				over.drops(rows)
				text = text:gsub("# ([^\n]+)", "%1:")
				UI.playDrops.Text = text
			end
			local session = AA.session()
			local level = Match.levelId and Levels[Match.levelId]
			over.mode.Text = IS_LOBBY and tostring(Config.Mode) or matchKind()
			over.map.Text = IS_LOBBY and (targetLine.Text:gsub("^Next: ", "")) or (level and ((worldName(level.world) and (worldName(level.world) .. ", ") or "") .. tostring(level.name)) or tostring((Match.levelData or {}).name or "?"))
			over.place.Text = IS_LOBBY and "Decided in the match" or (Match.pace == "speed" and "Front, enemies are weak" or "Normal, enemies are strong")
			over.tiles["Wins"].Text = tostring(session.wins)
			over.tiles["Losses"].Text = tostring(session.losses)
			over.rate.Text = (session.wins + session.losses) > 0 and string.format("%d%%", math.floor(session.wins / (session.wins + session.losses) * 100 + 0.5)) or "No matches yet"
			over.runs.Text = tostring(session.runs)
			over.time.Text = AA.clock(session.seconds)
			over.gems.Text = tostring(session.gems)
			local half, daily = AA.challengeTimers()
			over.half.Text = (AA.challengeOpen() and "Open, next in " or "Done, next in ") .. AA.clock(half)
			over.daily.Text = (AA.dailyOpen() and "Open, resets in " or "Done, resets in ") .. AA.clock(daily)
			for _, entry in ipairs(AA.TRACKED) do
				local gained = session.items[entry[2]] or 0
				over.items[entry[1]].Text = (gained > 0 and "+" or "") .. tostring(gained)
			end
		end
	end))
end

function AA.detach()
	AA.alive = false
	saveSettings()
	for _, connection in ipairs(AA.connections) do
		connection:Disconnect()
	end
	if AA.gui then
		AA.gui:Destroy()
	end
	pcall(function()
		AA.Music.muteGame(false)
		if AA.Music.sound then
			AA.Music.sound:Destroy()
		end
	end)
	if shared.AnimeAdventures == AA then
		shared.AnimeAdventures = nil
	end
end

