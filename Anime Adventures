-- What each card does, in the game's own words. The game sends a card's effects with the vote
-- and its card window builds the text from them (the format strings below are that window's),
-- so a card can be described once a vote has shown it: this session's votes plus the ones
-- logged in cards.json. Nothing is known about a card the game has not offered yet.
CardBrain.shown = {}
do
	local learn = CardBrain.learn
	function CardBrain.learn(options)
		for _, option in pairs(type(options) == "table" and options or {}) do
			if type(option) == "table" and type(option.title) == "string" and type(option.effects) == "table" then
				CardBrain.shown[option.title] = option
				CardBrain.catalogCache = nil
			end
		end
		return learn(options)
	end
end
local STAT_NAMES = { damage = "Attack", health = "Health", range = "Range", attack_cooldown = "Cooldown", active_attack_cooldown = "Active Cooldown", physical_crit_chance = "Phys Crit Chance", magic_crit_chance = "Magic Crit Chance" }
local ROMAN = { "I", "II", "III", "IV" }
local function signed(amount, percent, decimals)
	local value = math.abs(amount) * (percent and 100 or 1)
	local text = decimals and string.format("%.1f", value) or tostring(math.floor(value + 0.5))
	return (amount < 0 and "-" or "+") .. text .. (percent and "%" or "")
end
local function damageName(id)
	local service = CardBrain.damageNames
	if service == nil then
		service = findData("DamageTypeServiceCore", "get_damage_type_name") or false
		CardBrain.damageNames = service
	end
	local name = service and gameCall(service.get_damage_type_name, id)
	if type(name) == "string" and name ~= "" then
		return name
	end
	local plain = tostring(id):gsub("_damage$", "")
	return plain:sub(1, 1):upper() .. plain:sub(2)
end
---One effect as the card window words it: the changing part and what it applies to.
function CardBrain.effectText(effect)
	local kind, amount = effect.type, tonumber(effect.amount) or 0
	local stat = STAT_NAMES[effect.stat] or tostring(effect.stat or "")
	if kind == "stat_mul" or kind == "stat_add" or kind == "stat_attr_add" then
		return signed(amount, true), stat
	elseif kind == "stat_mul_real" then
		return tostring(effect.text or ("x" .. amount)), stat
	elseif kind == "resource_gain" then
		return "+" .. math.floor(math.abs(amount) + 0.5), "yen"
	elseif kind == "boss_damage" then
		return signed(amount, true), "Boss Damage"
	elseif kind == "enemy_speedup" then
		return signed(amount, true), "Enemy Speed"
	elseif kind == "enemy_regen" then
		return signed(amount, true, true), "Enemy Regen"
	elseif kind == "enemy_bomb" then
		return signed(amount, false), "Explosive Deaths Range"
	elseif kind == "enemy_resistance_specific" then
		return signed(amount, false), "Enemy " .. damageName(effect.damage_type) .. " Resist"
	elseif kind == "enemy_amp_specific" then
		return signed(amount, true), damageName(effect.damage_type) .. " Damage Taken"
	elseif kind == "weather_flying_chance" then
		return signed(amount, true), "Enemy Flying Chance"
	elseif kind == "weather_soaring_share" then
		return signed(amount, true), "Flyers Soaring"
	elseif kind == "flying_damage" then
		return signed(amount, true), "Damage vs Flying"
	elseif kind == "burst_speed" then
		return signed(amount, true), "Burst Enemy Speed"
	elseif kind == "lightning_strikes" then
		return signed(amount, true), "Lightning Strikes"
	elseif kind == "golem_chance" then
		return signed(amount, true), "Star Golem Chance"
	elseif kind == "enemy_passive_chance" then
		return signed(amount, true), "Enemy " .. tostring(effect.passive) .. " Chance"
	elseif kind == "enemy_stat_mul" then
		return signed(amount, true), "Enemy " .. stat
	elseif kind == "enemy_shield" then
		return signed(amount, false), "Enemy Shield"
	elseif kind == "candy_multiplier" then
		return signed(amount, true), "Pearls"
	elseif kind == "secret_drop" then
		return signed(amount, true), "Secret Drop Rate"
	elseif kind == "unit_cost" then
		return signed(amount, true), "Placement/Upgrade Cost"
	elseif kind == "random_effects" then
		return "Gain " .. math.floor(math.abs(amount) + 0.5) .. " Tier " .. tostring(effect.tier or "?"), effect._type == "Good" and "Random Blessings" or "Random Curses"
	elseif kind == "new_path" then
		return "+" .. (type(effect.new_lanes) == "table" and #effect.new_lanes or 1), "New Paths"
	elseif kind == "add_reward" then
		return "Adds", "a bonus reward"
	end
	return signed(amount, false), tostring(kind)
end
---Every card seen so far, by name: { [family] = { tiers = { [tier] = option }, order = { tier, ... } } }.
---Tier 0 is a card that has no tiers.
function CardBrain.catalog()
	if CardBrain.catalogCache then
		return CardBrain.catalogCache
	end
	if not CardBrain.logged then
		local logged = {}
		pcall(function()
			local file = SETTINGS_FOLDER .. "/cards.json"
			if isfile(file) then
				for _, vote in ipairs(httpService:JSONDecode(readfile(file))) do
					for _, option in pairs(type(vote) == "table" and type(vote.options) == "table" and vote.options or {}) do
						if type(option) == "table" and type(option.title) == "string" and type(option.effects) == "table" then
							logged[option.title] = option
						end
					end
				end
			end
		end)
		CardBrain.logged = logged
	end
	local catalog = {}
	for _, source in ipairs({ CardBrain.logged, CardBrain.shown }) do
		for title, option in pairs(source) do
			local family = CardBrain.family(title)
			local entry = catalog[family] or { tiers = {}, order = {} }
			catalog[family] = entry
			local tier = CardBrain.tier(option) or 0
			if not entry.tiers[tier] then
				table.insert(entry.order, tier)
			end
			entry.tiers[tier] = option
		end
	end
	for _, entry in pairs(catalog) do
		table.sort(entry.order)
	end
	CardBrain.catalogCache = catalog
	return catalog
end
---A card by name: kind ("Curse" | "Blessing"), text (what it does), known (a vote has shown it).
---A card with tiers lists each figure tier by tier: "+50 / +100 / +200 Enemy Magic Resist".
function CardBrain.describe(name)
	local _, good = CardBrain.families()
	local entry = CardBrain.catalog()[name]
	local kind = good[name] == false and "Curse" or "Blessing"
	if not entry or #entry.order == 0 then
		return { kind = kind, known = false, text = "No vote has offered this card yet, so what it does is not known here." }
	end
	for _, tier in ipairs(entry.order) do
		local option = entry.tiers[tier]
		if option.option_type == "Bad" then
			kind = "Curse"
		elseif option.option_type == "Good" then
			kind = "Blessing"
		end
	end
	-- One phrase per thing the card changes, with its figure on every tier that has it.
	local phrases, byLabel = {}, {}
	for _, tier in ipairs(entry.order) do
		local effects = entry.tiers[tier].effects
		local keys = {}
		for key in pairs(effects) do
			table.insert(keys, key)
		end
		table.sort(keys, function(a, b)
			return (tonumber(a) or 0) < (tonumber(b) or 0)
		end)
		for _, key in ipairs(keys) do
			local effect = effects[key]
			if type(effect) == "table" then
				local value, label = CardBrain.effectText(effect)
				local phrase = byLabel[label]
				if not phrase then
					phrase = { label = label, values = {} }
					byLabel[label] = phrase
					table.insert(phrases, phrase)
				end
				phrase.values[tier] = value
			end
		end
	end
	-- What the card does to the fight first, what it pays after.
	local LAST = { ["Pearls"] = 1, ["Secret Drop Rate"] = 2, ["a bonus reward"] = 3 }
	for index, phrase in ipairs(phrases) do
		phrase.rank = (LAST[phrase.label] or 0) * 100 + index
	end
	table.sort(phrases, function(a, b)
		return a.rank < b.rank
	end)
	local parts = {}
	for _, phrase in ipairs(phrases) do
		local values, tiers, same = {}, {}, true
		for _, tier in ipairs(entry.order) do
			local value = phrase.values[tier]
			if value then
				table.insert(values, value)
				table.insert(tiers, ROMAN[tier] or "")
				same = same and value == values[1]
			end
		end
		local text = (same and values[1] or table.concat(values, " / ")) .. " " .. phrase.label
		if #tiers < #entry.order then
			text = text .. " (" .. table.concat(tiers, ", ") .. " only)"
		end
		table.insert(parts, text)
	end
	local text = table.concat(parts, ", ") .. "."
	if #entry.order > 1 or entry.order[1] ~= 0 then
		local tiers = {}
		for _, tier in ipairs(entry.order) do
			table.insert(tiers, ROMAN[tier] or "?")
		end
		text = (#tiers > 1 and ("Tiers " .. table.concat(tiers, " / ") .. ": ") or ("Tier " .. tiers[1] .. ": ")) .. text
	end
	return { kind = kind, known = true, text = text }
end
-- The names the menus offer: the built-in list, this session's votes, and every card the log
-- has seen (weather cards come and go with the map, random-effect cards are not in the pool).
do
	local families = CardBrain.families
	function CardBrain.families()
		local names, good = families()
		local seen, extra = {}, {}
		for _, name in ipairs(names) do
			seen[name] = true
		end
		for family, entry in pairs(CardBrain.catalog()) do
			if family ~= "" and not seen[family] then
				seen[family] = true
				table.insert(extra, family)
				good[family] = entry.tiers[entry.order[1]].option_type == "Good"
			end
		end
		table.sort(extra)
		for _, family in ipairs(extra) do
			table.insert(names, family)
		end
		return names, good
	end
end
end

---Logs the real damage of my towers while an enemy is within their range, and keeps the pace
---(where on the road enemies die) current.
-- Damage comes from three places: a tower's own counter, its summons' counters (they carry their
-- tower in _stats.parent_unit), and whatever the team total (player damage_dealt) shows on top of
-- those: towers whose counters never move (Elyssia) get that remainder.
local function measureLoop()
	if IS_LOBBY then
		task.wait(60)
		return
	end
	local tracked, dirty, lastTeam = {}, 0, nil
	while AA.alive do
		local now = os.clock()
		local field = scanField()
		local enemies, deepest = {}, 0
		for _, enemy in ipairs(field.enemies) do
			local position = enemy:GetPivot().Position
			table.insert(enemies, position)
			local onRoad = nearestPath(position)
			local reached = onRoad and onRoad.progress or 0
			deepest = math.max(deepest, reached)
			if onRoad and onRoad.lane and (Match.laneCount or 1) > 1 then
				local wave = currentWave()
				Match.laneDepth = Match.laneDepth or {}
				Match.laneDepth[onRoad.lane] = Match.laneDepth[onRoad.lane] or {}
				Match.laneDepth[onRoad.lane][wave] = math.max(Match.laneDepth[onRoad.lane][wave] or 0, reached)
			end
		end
		-- How far down the road enemies get each wave: the kill margin the card picker reads.
		local wave = currentWave()
		Match.depthByWave = Match.depthByWave or {}
		Match.depthByWave[wave] = math.max(Match.depthByWave[wave] or 0, deepest)
		-- Pace: enemies dying in the first stretch of road -> "speed" (damage now, skip slow
		-- farms, don't save up); enemies getting deep or leaks -> "long" (farm and scale).
		-- Speed is the default from the first second: units go to the very front until enemies
		-- actually start getting down the road.
		do
			local recent = math.max(Match.depthByWave[wave - 1] or 0, Match.depthByWave[wave - 2] or 0)
			if wave < 3 then
				recent = math.max(recent, Match.depthByWave[wave] or 0)
				-- A level played before starts the way it ended last time.
				if not Match.paceSeeded then
					Match.paceSeeded = true
					local remembered = type(AA.progress.paces) == "table" and AA.progress.paces[AA.leakKey()]
					if remembered == "long" or remembered == "speed" then
						Match.pace = remembered
					end
				end
				Match.pace = Match.pace or "speed"
			end
			local bleeding = Match.bleedAt and os.clock() - Match.bleedAt < 60
			local pace = Match.pace
			-- Where enemies actually die: damage placed past this point sits idle.
			Match.fightDepth = recent
			-- Enemy strength, read two ways. Before anything has walked far: the toughest enemy
			-- on the road against what the team deals (seconds to kill it). After that: how far
			-- down the road enemies really get. Weak -> everything at the very front of the road
			-- so each one dies as it appears; strong -> placed for the most damage over the road.
			local toughest = 0
			for _, enemy in ipairs(field.enemies) do
				local humanoid = enemy:FindFirstChildOfClass("Humanoid")
				if humanoid then
					toughest = math.max(toughest, humanoid.MaxHealth)
				end
			end
			local teamPower = 0
			for _, unit in ipairs(field.towers) do
				local unitData = Units[unit._stats.id.Value]
				if unitData then
					teamPower += copyPower(unitData, ownedOf(unit), unit._stats.upgrade.Value) * AA.measureFactor(unit._stats.id.Value)
				end
			end
			if toughest > 0 and teamPower > 0 then
				Match.killTime = math.max(Match.killTime or 0, toughest / teamPower)
			end
			if wave ~= Match.killWave then
				Match.killWave, Match.lastKillTime, Match.killTime = wave, Match.killTime, nil
			end
			local slowKill = (Match.lastKillTime or 0) > 10 or ((Match.killTime or 0) > 14 and #field.towers >= 3)
			if Config.PlaceStyle == "Front" or AA.killsMode() or AA.frontForced() or AA.Order.front() then
				pace = "speed"
			elseif Config.PlaceStyle == "Normal" then
				pace = "long"
			elseif Match.longHaul or bleeding or recent >= 0.5 or slowKill then
				pace = "long"
			elseif recent < 0.3 then
				pace = "speed"
			end
			if pace == "long" then
				Match.everLong = true
			end
			if pace ~= Match.pace then
				Match.pace = pace
				note("pace", { p = pace, depth = math.floor(recent * 100) })
			end
		end
		if not Match.teamIds then
			Match.teamIds = {}
			for _, entry in ipairs(equippedUnits()) do
				Match.teamIds[entry.id] = true
			end
		end
		Match.meas = Match.meas or {}
		local function record(id, damage, seconds, sheetSeconds)
			local entry = Match.meas[id] or { dmg = 0, secs = 0, sheet = 0 }
			entry.dmg += damage
			entry.secs += seconds
			entry.sheet += sheetSeconds or 0
			Match.meas[id] = entry
		end
		local counted = 0
		-- Summons: their damage belongs to the tower that made them.
		for _, unit in ipairs(field.summons) do
			local total = unit._stats:FindFirstChild("total_damage")
			local owner = summonOwner(unit)
			local ownerId = owner and owner:FindFirstChild("_stats") and owner._stats:FindFirstChild("id") and owner._stats.id.Value
			local summonRange = unit._stats:FindFirstChild("range")
			if ownerId and summonRange and AA.rv(summonRange) > 0 then
				AA.progress.summonRange = type(AA.progress.summonRange) == "table" and AA.progress.summonRange or {}
				local known = tonumber(AA.progress.summonRange[ownerId]) or 0
				local seen = math.min(AA.rv(summonRange), 200)
				if seen > known * 1.1 then
					AA.progress.summonRange[ownerId] = math.floor(seen)
					AA.progressDirty = true
				end
			end
			if total and ownerId and Match.teamIds[ownerId] then
				local entry = tracked[unit]
				local gained = math.max(total.Value - (entry and entry.last or 0), 0)
				record(ownerId, gained, 0, 0)
				if owner._stats:FindFirstChild("upgrade") and owner._stats.upgrade.Value <= 1 then
					record(ownerId .. "#lo", gained, 0, 0)
				end
				counted += gained
				Match.extraDamage = Match.extraDamage or {}
				Match.extraDamage[owner] = (Match.extraDamage[owner] or 0) + gained
				Match.summoners = Match.summoners or {}
				if not Match.summoners[ownerId] then
					Match.summoners[ownerId] = true
					AA.progress.summoners = type(AA.progress.summoners) == "table" and AA.progress.summoners or {}
					if not AA.progress.summoners[ownerId] then
						AA.progress.summoners[ownerId] = true
						AA.saveProgress()
					end
				end
				tracked[unit] = { last = total.Value, at = now, level = -1 }
			end
		end
		local silent, silentUnits = {}, {}
		for _, unit in ipairs(field.towers) do
			local unitStats = unit._stats
			local id = unitStats.id.Value
			local total = unitStats:FindFirstChild("total_damage")
			local rangeValue = unitStats:FindFirstChild("range")
			local data = Units[id]
			if data and total and unitStatsAt(data, data.upgrade and #data.upgrade or 0).farm <= 0 and Match.teamIds[id] then
				local level = unitStats.upgrade.Value
				local entry = tracked[unit]
				local busy = false
				if entry and entry.level == level then
					-- One clock for every unit: the seconds enemies are on the map. (Counting only the
					-- seconds an enemy stood in range rated Shadow Sorcerer 3x too high against Elyssia,
					-- whose clock never stopped: a 2 h infinite run showed her doing 10x his damage
					-- while the sheet said to upgrade him first, and the next world was lost without her.)
					busy = #enemies > 0
					local gained = math.max(total.Value - entry.last, 0)
					counted += gained
					if busy or gained > 0 then
						local seconds = now - entry.at
						record(id, gained, seconds, copyPower(data, ownedOf(unit), level) * seconds)
						if level <= 1 then
							record(id .. "#lo", gained, seconds, copyPower(data, ownedOf(unit), level) * seconds)
						end
					end
				end
				-- A tower in the fight whose own counter stays at zero deals its damage where the
				-- counters don't see it.
				if busy and total.Value <= 0 and not AA.buffInfo(data) then
					table.insert(silent, id)
					table.insert(silentUnits, unit)
				end
				tracked[unit] = { last = total.Value, at = now, level = level }
			end
		end
		for unit in pairs(tracked) do
			if not unit.Parent then
				tracked[unit] = nil
			end
		end
		-- Team total minus everything the counters showed = the silent towers' damage.
		local team = stats:FindFirstChild("damage_dealt")
		if team then
			if lastTeam and team.Value >= lastTeam and #silent > 0 then
				local hidden = math.max(team.Value - lastTeam - counted, 0)
				-- It belongs to the units that deal damage the counters can't see (summoners and
				-- game-scripted units), not to every tower that happens to show zero: a fresh or
				-- idle copy of a plain unit used to take an equal share of Elyssia's damage.
				local pool = {}
				for _, unit in ipairs(silentUnits) do
					local id = unit._stats.id.Value
					if AA.isSummoner(id) or AA.scriptedUnit(Units[id]) then
						table.insert(pool, unit)
					end
				end
				if #pool == 0 then
					pool = silentUnits
				end
				Match.extraDamage = Match.extraDamage or {}
				for _, unit in ipairs(pool) do
					local id = unit._stats.id.Value
					record(id, hidden / #pool, 0, 0)
					-- (The low-level sheet gets it as well: without it a level 0-1 Elyssia was rated
					-- on a tenth of her damage once that sheet had filled.)
					if unit._stats.upgrade.Value <= 1 then
						record(id .. "#lo", hidden / #pool, 0, 0)
					end
					Match.extraDamage[unit] = (Match.extraDamage[unit] or 0) + hidden / #pool
				end
			end
			lastTeam = team.Value
		end
		-- Every 30 s: put this match's numbers on the sheet scale using the other units in it.
		if now - (Match.foldAt or now) >= 30 or not Match.foldAt then
			if Match.foldAt then
				-- How each unit did against its own sheet; the match's middle value is "normal".
				local ratios, factor = {}, {}
				for id, entry in pairs(Match.meas) do
					if entry.secs >= 20 and entry.sheet > 0 and entry.dmg > 0 then
						factor[id] = entry.dmg / entry.sheet
						-- (A level 0-1 unit is in the list twice, as id and id#lo: counted once,
						-- or a lone opener was measured against itself and stored as exactly 1.)
						if not id:find("#lo", 1, true) then
							table.insert(ratios, factor[id])
						end
					end
				end
				table.sort(ratios)
				local middle = ratios[math.ceil(#ratios / 2)]
				if middle and middle > 0 and #ratios >= 2 then
					for id, value in pairs(factor) do
						local entry = Match.meas[id]
						local key = Match.pace == "speed" and (id .. "@speed") or id
						local stored = AA.Measured[key] or {}
						stored.g = (stored.g or 0) + math.min(value / middle, 20) * entry.secs
						stored.gsecs = (stored.gsecs or 0) + entry.secs
						-- Old samples fade so a changed team (traits, levels) re-measures itself.
						if stored.gsecs > 3600 then
							stored.g, stored.gsecs = stored.g * 0.5, stored.gsecs * 0.5
						end
						AA.Measured[key] = stored
						dirty += 20
					end
					Match.meas = {}
				end
			end
			Match.foldAt = now
		end
		if dirty >= 20 then
			dirty = 0
			AA.saveMeasured()
		end
		task.wait(2)
	end
end

