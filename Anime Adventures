---The Daily Challenge pays once a day; after two losses in a day it is left alone until tomorrow.
function AA.dailyState()
	local key = "daily_" .. tostring(localPlayer.UserId)
	local day = math.floor(os.time() / (tonumber(Core.Settings.DAILY_CHALLENGE_DURATION) or 86400))
	local state = AA.progress[key]
	if type(state) ~= "table" or state.day ~= day then
		state = { day = day, losses = 0 }
		-- Attempts already in the match log count (earlier versions kept no daily record).
		for _, entry in ipairs(MatchLog) do
			if type(entry) == "table" and entry.level == "__DAILY_CHALLENGE" and (entry.at or 0) >= day * 86400 and (entry.user == nil or entry.user == localPlayer.UserId) then
				if entry.won then
					state.won = true
				else
					state.losses += 1
				end
			end
		end
		AA.progress[key] = state
	end
	return state
end
function AA.dailyOpen()
	local state = AA.dailyState()
	return not state.won and (not Config.DailyGiveUp or (state.losses or 0) < 2)
end

---Damage-type modifiers of what we're about to play: { damage_type = multiplier }. The Daily and
---the tournament announce what the enemies are weak and strong against; raids and legend stages
---write resistances / amplifications on their enemies in the wave data.
function AA.typeMods(id, kind, group)
	local key = tostring(kind) .. ":" .. tostring(group) .. ":" .. tostring(id)
	AA.modCache = AA.modCache or {}
	local cached = AA.modCache[key]
	if cached and os.clock() - cached.at < 600 then
		return cached.mods
	end
	local mods = {}
	local function apply(damageType, factor)
		if type(damageType) == "string" and factor > 0 then
			mods[damageType] = (mods[damageType] or 1) * factor
		end
	end
	local function announced(info)
		for _, entry in pairs(type(info) == "table" and type(info.weak_against) == "table" and info.weak_against or {}) do
			local listed = type(entry) == "table"
			apply(listed and entry.damage_type or entry, 1 + (listed and tonumber(entry.amplification) or 0.5))
		end
		for _, entry in pairs(type(info) == "table" and type(info.strong_against) == "table" and info.strong_against or {}) do
			local listed = type(entry) == "table"
			apply(listed and entry.damage_type or entry, 100 / (100 + (listed and tonumber(entry.resistance) or 100)))
		end
	end
	if kind == "challenge" and group == "DailyChallenge" then
		if IS_LOBBY then
			local ok, info = invoke("get_daily_challenge")
			announced(ok and info)
		end
	elseif kind == "tournament" then
		if IS_LOBBY then
			local ok, info = invoke("get_tournament_info")
			announced(ok and info)
		end
	elseif type(id) == "string" and Core.RawLevels[id] then
		local level = Core.RawLevels[id]
		announced({ weak_against = level._weak_against, strong_against = level._strong_against })
		local waves = gameRequire(replicatedStorage.src.Data.Waves)
		local set = waves and level.waves and waves[level.waves]
		local resist, amplify = {}, {}
		local function walk(node, depth)
			for name, value in pairs(node) do
				if type(value) == "table" then
					if depth < 5 then
						walk(value, depth + 1)
					end
				elseif type(name) == "string" and tonumber(value) then
					local res, amp = name:match("^_dmg_res_(.+)$"), name:match("^_dmg_amp_(.+)$")
					if res then
						resist[res] = math.max(resist[res] or 0, tonumber(value))
					elseif amp then
						amplify[amp] = math.max(amplify[amp] or 0, tonumber(value))
					end
				end
			end
		end
		for _ = 1, 4 do
			if type(set) ~= "table" then
				break
			end
			for name, value in pairs(set) do
				if type(value) == "table" and name ~= "waves" then
					walk(value, 0)
				end
			end
			set = type(set.template) == "string" and waves[set.template] or nil
		end
		for damageType, value in pairs(resist) do
			apply(damageType, 100 / (100 + value))
		end
		for damageType, value in pairs(amplify) do
			apply(damageType, 1 + value)
		end
	end
	AA.modCache[key] = { at = os.clock(), mods = mods }
	return mods
end

---How a unit's damage types fare against the level's modifiers (1 = nothing special).
function AA.typeFactor(data)
	local mods = AA.targetMods
	if not IS_LOBBY or not mods or next(mods) == nil or not data then
		return 1
	end
	local types = gameCall(Core.Unit and Core.Unit.get_all_damage_types, data)
	if type(types) ~= "table" then
		types = { [data._base_damage_type or "physical"] = true }
	end
	local factor = 1
	for damageType in pairs(types) do
		factor *= mods[damageType] or 1
	end
	return factor
end

---Extra damage the level we're heading to gives this copy (event units, matching skins). Only
---in the lobby: inside a match the game's stat multiplier already carries it.
function AA.levelBonus(unit)
	if not IS_LOBBY or type(unit) ~= "table" or not AA.targetLevel then
		return 0
	end
	-- In parentheses: the game function returns nothing at all for some levels, and tonumber()
	-- with no argument is an error (it stopped "Equip best" half way, leaving two units equipped).
	local bonus = gameCall(Core.Level and Core.Level.calculate_level_damage_increase, AA.targetLevel, unit)
	return tonumber(bonus) or 0
end

local function equipBest()
	local data = collectionData()
	local owned = data.owned_units or {}
	local best, bestFarm = {}, nil
	-- What we're about to play: units the level favours get their bonus counted, and damage
	-- types the enemies resist or are weak to shift the ranking.
	do
		local ok, id, _, kind, group = pcall(AA.chooseTarget)
		AA.targetLevel = ok and type(id) == "string" and Core.RawLevels[id] or nil
		AA.targetMods = ok and id and AA.typeMods(id, kind, group) or nil
	end
	local pinned = {}
	for id in tostring(Config.PinnedUnits):gmatch("[^,]+") do
		pinned[id] = true
	end
	for uuid, unit in pairs(owned) do
		local unitData = Units[unit.unit_id]
		if unitData and not unitData._LOCKED_UNIT then
			local top = unitStatsAt(unitData, unitData.upgrade and #unitData.upgrade or 0)
			if top.farm > 0 then
				local income = top.farm * statMul(unit, "farm_amount")
				if not bestFarm or income > bestFarm.power then
					bestFarm = { uuid = uuid, id = unit.unit_id, power = income }
				end
			else
				local power = unitPower(unit.unit_id, unit)
				local current = best[unit.unit_id]
				if (power > 0 or AA.buffInfo(unitData) or AA.synergyInfo(unit.unit_id)) and (not current or power > current.power) then
					best[unit.unit_id] = { uuid = uuid, id = unit.unit_id, power = power }
				end
			end
		end
	end
	local list = {}
	for _, entry in pairs(best) do
		table.insert(list, entry)
	end
	table.sort(list, function(a, b)
		return a.power > b.power
	end)
	-- Buff units are worth what they add to the rest of the team: buff % x the power of the
	-- damage units it boosts (the would-be team without it), if enough copies fit for full uptime.
	do
		local team = {}
		for _, entry in ipairs(list) do
			if #team < (bestFarm and 5 or 6) - 1 and not AA.buffInfo(Units[entry.id]) then
				table.insert(team, entry)
			end
		end
		local changed = false
		for _, entry in ipairs(list) do
			local synergy = AA.synergyInfo(entry.id)
			if synergy then
				local boosted = 0
				for _, member in ipairs(team) do
					if member.id ~= entry.id and synergy.matches(member.id, Units[member.id]) then
						boosted += member.power
					end
				end
				local copies = synergy.stacks and math.min(placeCap(Units[entry.id]), 8) or 1
				local gain = synergy.pct * copies * boosted * synergy.coverage
				if gain > 0 then
					entry.ownPower = entry.ownPower or entry.power
					entry.power = entry.power + gain
					entry.buffer = true
					changed = true
				end
			end
		end
		for _, entry in ipairs(list) do
			local buff = AA.buffInfo(Units[entry.id])
			if buff then
				local boosted = 0
				for _, member in ipairs(team) do
					if AA.buffMatches(buff, Units[member.id]) then
						boosted += member.power
					end
				end
				-- With four copies the chain holds +100% on everything of its type in range
				-- (about 60% of the team's damage ends up standing inside it).
				local copies = math.min(placeCap(Units[entry.id]), AA.buffCopies(buff, Units[entry.id]))
				entry.ownPower = entry.power
				entry.power = entry.power + AA.buffValue(buff, copies) * boosted * 0.6
				entry.buffer = true
				changed = true
			end
		end
		if changed then
			table.sort(list, function(a, b)
				return a.power > b.power
			end)
		end
	end
	-- Wanted order: strongest first (slot 1 is the one shown off next to you, slots 2-3 with the
	-- gamepass), then down by power; the farm unit takes the last slot.
	local slots = bestFarm and 5 or 6
	local picks = {}
	-- Units you pinned always go in; the rest fill by power.
	for _, entry in ipairs(list) do
		if pinned[entry.id] and #picks < slots then
			entry.pinned = true
			table.insert(picks, entry)
		end
	end
	for _, entry in ipairs(list) do
		if #picks >= slots then
			break
		end
		if not entry.pinned then
			table.insert(picks, entry)
		end
	end
	-- Trial: a scripted unit with no real numbers yet gets the last slot until it has been measured,
	-- if its sheet guess is at least a third of the weakest pick's (scripted attacks usually hit more than the sheet shows).
	if Config.TestUnproven and #picks == slots then
		local weakest = picks[#picks]
		for _, entry in ipairs(list) do
			local unitData = Units[entry.id]
			local chosen = false
			for _, pick in ipairs(picks) do
				chosen = chosen or pick.id == entry.id
			end
			if not chosen and AA.scriptedUnit(unitData) and not AA.isMeasured(entry.id) and entry.power >= weakest.power * 0.33 then
				for j = #picks, 1, -1 do
					local pick = picks[j]
					if not pick.pinned and not (AA.scriptedUnit(Units[pick.id]) and not AA.isMeasured(pick.id)) then
						entry.trial = true
						picks[j] = entry
						break
					end
				end
				break
			end
		end
	end
	-- Flying / Soaring enemies need a hill or hybrid unit: keep the best one on the team.
	local function canHill(entry)
		local unitData = Units[entry.id]
		return unitData.hill_unit or unitData.hybrid_placement
	end
	local hasHill = false
	for _, entry in ipairs(picks) do
		hasHill = hasHill or canHill(entry)
	end
	if not hasHill and #picks == slots then
		for i = slots + 1, #list do
			if canHill(list[i]) then
				for j = #picks, 1, -1 do
					if not picks[j].pinned and not picks[j].trial then
						picks[j] = list[i]
						break
					end
				end
				break
			end
		end
	end
	-- Opening: you start with 500 and earn roughly 200+ a wave, and the first waves barely dent the
	-- base, so a unit doesn't have to be placeable at second 0 - just within the first wave or two.
	local hasOpener = false
	for _, entry in ipairs(picks) do
		hasOpener = hasOpener or (Units[entry.id].cost or 0) <= 1000
	end
	if not hasOpener and #picks == slots then
		for i = slots + 1, #list do
			if (Units[list[i].id].cost or 0) <= 1000 then
				-- Replace the weakest pick that isn't the only hill unit.
				for j = #picks, 2, -1 do
					if not canHill(picks[j]) and not picks[j].pinned and not picks[j].trial then
						picks[j] = list[i]
						break
					end
				end
				break
			end
		end
	end
	table.sort(picks, function(x, y)
		return x.power > y.power
	end)
	local order = {}
	AA.teamReport = {}
	for _, entry in ipairs(picks) do
		table.insert(order, entry.uuid)
		table.insert(AA.teamReport, string.format("%s %d%s", tostring(Units[entry.id].name or entry.id), entry.power, entry.pinned and " (pinned)" or entry.trial and " (testing)" or entry.buffer and " (buff)" or AA.isMeasured(entry.id) and " (measured)" or ""))
	end
	if bestFarm then
		table.insert(order, bestFarm.uuid)
	end
	if #order == 0 then
		return 0
	end
	local function slotOf(uuid)
		for slot, other in pairs(collectionData().equipped_units or {}) do
			if other == uuid then
				return tonumber(slot)
			end
		end
		return nil
	end
	-- The server drops requests sent faster than ~1 per 0.7 s ("Sending requests too fast"),
	-- so go one at a time and wait for each change to show up before the next.
	local function change(remote, uuid, want)
		for _ = 1, 3 do
			invoke(remote, uuid)
			local deadline = os.clock() + 1.2
			while os.clock() < deadline and (slotOf(uuid) ~= nil) ~= want do
				task.wait(0.1)
			end
			task.wait(0.7)
			if (slotOf(uuid) ~= nil) == want then
				return true
			end
		end
		return false
	end
	-- Equipping fills the lowest free slot: clear every slot that holds the wrong unit, then
	-- equip the missing ones from slot 1 upward.
	local changed = 0
	local wrong = {}
	for slot, uuid in pairs(data.equipped_units or {}) do
		if order[tonumber(slot)] ~= uuid then
			table.insert(wrong, uuid)
		end
	end
	for _, uuid in ipairs(wrong) do
		if change("unequip_unit", uuid, false) then
			changed += 1
		end
	end
	for _, uuid in ipairs(order) do
		if not slotOf(uuid) and change("equip_unit", uuid, true) then
			changed += 1
		end
	end
	return changed
end

---What to play next: Story finds the first uncleared act you can enter (then keeps farming the last one).
local chooseTarget
function AA.chooseTarget(...)
	return chooseTarget(...)
end
---Quests mode. Every open quest of the profile as a record, sorted into the game's sets:
---Daily (kills, multiplayer waves, the daily mission), Infinite (reach wave N on a world's
---infinite), Story (clear a story act / legend stage / boss portal) and Event (the running
---event's own quests).
AA.Quests = {}
function AA.Quests.list()
	local list = {}
	local handler = profile().quest_handler
	for uuid, quest in pairs(type(handler) == "table" and type(handler.quests) == "table" and handler.quests or {}) do
		local info = type(quest) == "table" and quest.quest_info
		local class = type(info) == "table" and type(info.quest_class) == "table" and info.quest_class or nil
		if class then
			local need = tonumber(class.amount) or 1
			local have = type(quest.quest_progress) == "table" and tonumber(quest.quest_progress.amount) or 0
			local set
			if info._infinite_quest_order then
				set = "Infinite"
			elseif class.class == "finish_level" and not info.expiry_time then
				set = "Story"
			elseif info.unique and info.expiry_time then
				set = "Event"
			elseif info.expiry_time then
				set = "Daily"
			else
				set = "Story"
			end
			local key = info.id and tostring(info.id) or (tostring(class.class) .. ":" .. tostring(class.level_id or "") .. ":" .. tostring(class.wave or class.amount or ""))
			table.insert(list, {
				uuid = uuid, key = key, set = set, class = tostring(class.class), data = class, info = info,
				name = tostring(info.quest_name or key), have = have, need = need,
				done = quest.quest_completed == true or have >= need,
			})
		end
	end
	return list
end
---What to play for a quest: id, difficulty, kind, group (as chooseTarget returns them), or nil and
---the reason it can't be played by the script right now.
function AA.Quests.target(quest, done)
	local class, data = quest.class, quest.data
	if class == "reach_wave" or class == "finish_level" then
		local id = data.level_id
		local level = id and Levels[id]
		if not level then
			return nil, "unknown stage"
		end
		if level._portal_only_level or tostring(id):find("portal", 1, true) then
			for _, item in ipairs(AA.portalItems()) do
				if item.level == id and item.left > 0 then
					return item.uuid, item.name, "portal"
				end
			end
			return nil, "needs its portal"
		end
		if not levelUnlocked(id, done) then
			return nil, "locked"
		end
		if class == "reach_wave" then
			-- (An infinite stage always ends in a loss: only out when the last three runs today
			-- fell short of this wave.)
			local lastWave, count = AA.lostWave(id)
			if (count or 0) >= 3 and (lastWave or 0) <= (tonumber(data.wave) or 0) then
				return nil, "fell short 3 times today"
			end
		elseif AA.tooHard(id) then
			return nil, "lost 3 times today"
		end
		local hard = class == "reach_wave" or tostring(id):find("_legend_", 1, true) or tostring(id):find("infinite", 1, true)
		return id, hard and "Hard" or "Normal", "story"
	elseif class == "kill_unit_multi" then
		-- The daily mission ("Defeat 2500 Curses"): its world's infinite, or its furthest open act.
		local worldId = tostring(quest.info.id or ""):match("^(.-)_daily$")
		local world = worldId and Worlds[worldId]
		local infinite = world and world.infinite and world.infinite.id
		if infinite and Levels[infinite] and levelUnlocked(infinite, done) then
			return infinite, "Hard", "story"
		end
		for act = 6, 1, -1 do
			local entry = world and world.levels and (world.levels[tostring(act)] or world.levels[act])
			if entry and levelUnlocked(entry.id, done) then
				return entry.id, "Normal", "story"
			end
		end
		return nil, "world locked"
	elseif class == "finish_portal_level" then
		for _, item in ipairs(AA.portalItems()) do
			if item.level and type(data.level_ids) == "table" and data.level_ids[item.level] and item.left > 0 and (not data.min_depth or (item.depth or 0) >= data.min_depth) then
				return item.uuid, item.name, "portal"
			end
		end
		return nil, data.min_depth and ("needs a tier " .. tostring(data.min_depth) .. "+ portal") or "needs a portal"
	elseif class == "summer2_hunt_weathers" or (class == "kill_unit" and tostring(data.unit_id):find("^summer")) then
		local id, difficulty, kind, group = chooseTarget("Summer")
		if id then
			return id, difficulty, kind, group
		end
		return nil, "Summer Hunt not open"
	elseif class == "kills" or class == "clear_waves_multiplayer" or class == "daily_complete" then
		return nil, "fills up while playing anything"
	end
	return nil, "not something the script can do"
end
---How hard a quest is, for the automatic order (lower first).
function AA.Quests.difficulty(quest)
	local class, data = quest.class, quest.data
	local left = 1 - math.clamp(quest.have / math.max(quest.need, 1), 0, 1)
	if class == "kill_unit_multi" then
		return 0.5 + left
	elseif class == "reach_wave" then
		return (tonumber(data.wave) or 10) / 10 + (tonumber(quest.info._infinite_quest_order) or 0) * 0.01
	elseif class == "finish_level" then
		local id = tostring(data.level_id)
		local stage = tonumber(id:match("_(%d+)$")) or 1
		if id:find("_legend_", 1, true) then
			return 6 + stage * 0.3
		elseif id:find("portal", 1, true) then
			return 5
		end
		local index = table.find(Order.LEVEL_ORDER or {}, id) or 100
		return 2.5 + index * 0.02
	elseif class == "finish_portal_level" then
		return 4 + (tonumber(data.min_depth) or 0) * 0.3 + math.log(math.max(quest.need - quest.have, 1), 10) * 2
	elseif class == "kill_unit" then
		return 7
	elseif class == "summer2_hunt_weathers" then
		return 9
	end
	return 50
end
---The quests of the picked sets in the order they will be done: the user's priority picks first,
---the rest from easiest to hardest. Each entry gets .target (playable now) or .why.
function AA.Quests.plan()
	local sets = { Daily = Config.QuestDaily, Infinite = Config.QuestInfinite, Story = Config.QuestStory, Event = Config.QuestEvent }
	local rank = {}
	for index, key in ipairs({ Config.QuestFirst, Config.QuestSecond, Config.QuestThird }) do
		if type(key) == "string" and key ~= "" and not rank[key] then
			rank[key] = index
		end
	end
	local done = completedLevels()
	local plan = {}
	for _, quest in ipairs(AA.Quests.list()) do
		if not quest.done and (sets[quest.set] or rank[quest.key]) then
			local id, second, kind, group = AA.Quests.target(quest, done)
			if id then
				quest.target = { id, second, kind, group }
			else
				quest.why = second
			end
			quest.rank = rank[quest.key] or 99
			quest.hard = AA.Quests.difficulty(quest)
			table.insert(plan, quest)
		end
	end
	table.sort(plan, function(a, b)
		if (a.target ~= nil) ~= (b.target ~= nil) then
			return a.target ~= nil
		end
		if a.rank ~= b.rank then
			return a.rank < b.rank
		end
		if a.hard ~= b.hard then
			return a.hard < b.hard
		end
		return a.key < b.key
	end)
	return plan
end
---In a match started for a quest: is that quest finished (so the match can be left)?
function AA.Quests.goalDone()
	local session = AA.progress and AA.progress.session
	local goal = type(session) == "table" and session.job == game.JobId and session.quest or nil
	if type(goal) ~= "table" then
		return false
	end
	if goal.class == "finish_level" or goal.class == "finish_portal_level" or goal.class == "kill_unit" or goal.class == "summer2_hunt_weathers" then
		return false -- these end with the match itself
	end
	if goal.class == "reach_wave" then
		-- Until the highest wave this run is for, or until no "reach wave" quest of this stage
		-- is open any more.
		local wave = workspace:FindFirstChild("_wave_num")
		if goal.wave and (wave and wave.Value or 0) > goal.wave then
			return true
		end
		for _, quest in ipairs(AA.Quests.list()) do
			if quest.class == "reach_wave" and quest.data.level_id == goal.level and not quest.done then
				return false
			end
		end
		return true
	end
	local found
	for _, quest in ipairs(AA.Quests.list()) do
		if quest.key == goal.key then
			found = quest
		end
	end
	return not found or found.done
end

AA.chooseInner = function(modeOverride)
	local mode = modeOverride or Config.Mode
	local done = completedLevels()
	if mode == "Quests" then
		AA.questPick = nil
		for _, quest in ipairs(AA.Quests.plan()) do
			if quest.target then
				AA.questPick = { key = quest.key, class = quest.class, wave = tonumber(quest.data.wave), name = quest.name, level = quest.data.level_id }
				if quest.class == "reach_wave" then
					-- One run does every "reach wave N" of the same stage: stay until the highest
					-- one still open (10 and 20 fall on the way to 40).
					for _, other in ipairs(AA.Quests.plan()) do
						if other.class == "reach_wave" and other.target and other.data.level_id == quest.data.level_id then
							AA.questPick.wave = math.max(AA.questPick.wave or 0, tonumber(other.data.wave) or 0)
						end
					end
				end
				return quest.target[1], quest.target[2], quest.target[3], quest.target[4]
			end
		end
		return nil, nil, "quests"
	end
	-- An act lost three times in a day is too much for the team right now: farm the last act that
	-- is cleared instead (unit XP, gems) and come back to it tomorrow or when the losses expire.
	local function grind()
		local last
		for _, id in ipairs(Order.LEVEL_ORDER or {}) do
			if done[id] and not AA.tooHard(id) then
				last = id
			end
		end
		if last then
			return last, Config.Difficulty, "story"
		end
		return nil
	end
	if mode == "Story" and Config.Difficulty == "Hard" and Config.WorldSkip then
		-- Hard with world skip. The game's rules: the skip clears Acts 1-5 on Normal only, and an
		-- act's Hard opens with its own Normal clear, so Act 6 can't be Hard the first time.
		-- Fastest legal route per world: skip -> Act 6 on Normal -> Act 6 on Hard -> next world.
		-- The Hard clears of Acts 1-5 are picked up below once no new world is left.
		for _, id in ipairs(Order.LEVEL_ORDER or {}) do
			if id:find("_level_6$") and done[id] and not clearedOn(id, "Hard") and not AA.tooHard(id) and not (AA.hardBlocked and AA.hardBlocked[id]) then
				return id, "Hard", "story"
			end
		end
		for _, id in ipairs(Order.LEVEL_ORDER or {}) do
			if not done[id] and levelUnlocked(id, done) then
				local level = Levels[id]
				local world = level and level.world
				local last = world and world .. "_level_6"
				if world and Order.SKIPPABLE_WORLDS and Order.SKIPPABLE_WORLDS[world] and Levels[last] and not done[last] and id ~= last and not (AA.skipFailed and AA.skipFailed[world]) then
					return world, "Normal", "skip"
				end
				if not AA.tooHard(id) then
					return id, "Normal", "story"
				end
				break
			end
		end
	end
	if mode == "Story" and Config.Difficulty == "Hard" then
		-- Hard run from the start: the first act not yet beaten on Hard whose Normal clear opened it.
		-- When every opened act is done on Hard, beat the next new act on Normal to open its Hard.
		for _, id in ipairs(Order.LEVEL_ORDER or {}) do
			if done[id] and not clearedOn(id, "Hard") and not AA.tooHard(id) then
				-- The server said Hard isn't open (its Normal clear didn't count): beat Normal again.
				if AA.hardBlocked and AA.hardBlocked[id] then
					return id, "Normal", "story"
				end
				return id, "Hard", "story"
			end
		end
		for _, id in ipairs(Order.LEVEL_ORDER or {}) do
			if not done[id] and levelUnlocked(id, done) then
				if AA.tooHard(id) then
					local grindId, grindDifficulty, grindKind = grind()
					if grindId then
						return grindId, grindDifficulty, grindKind
					end
				end
				return id, "Normal", "story"
			end
		end
		mode = "Level"
	end
	if mode == "Story" then
		for _, id in ipairs(Order.LEVEL_ORDER or {}) do
			if not done[id] and levelUnlocked(id, done) then
				-- World skip: jump straight to Act 6 (unlocks the next world sooner).
				local level = Levels[id]
				local world = level and level.world
				local last = world and world .. "_level_6"
				if Config.WorldSkip and world and Order.SKIPPABLE_WORLDS and Order.SKIPPABLE_WORLDS[world] and Levels[last] and not done[last] and id ~= last and not (AA.skipFailed and AA.skipFailed[world]) then
					return world, Config.Difficulty, "skip"
				end
				if AA.tooHard(id) then
					local grindId, grindDifficulty, grindKind = grind()
					if grindId then
						return grindId, grindDifficulty, grindKind
					end
				end
				return id, Config.Difficulty, "story"
			end
		end
		mode = "Level"
	end
	if mode == "Level" then
		local world = Worlds[Config.World]
		local level = world and world.levels and (world.levels[tostring(Config.Act)] or world.levels[Config.Act])
		if level and not levelUnlocked(level.id, done) then
			return nil, nil, "locked"
		end
		return level and level.id, Config.Difficulty, "story"
	elseif mode == "Missions" then
		-- Daily kill missions ("Defeat 2500 Curses": 500 gems and that world's evolution items):
		-- the mission world's infinite stage, or its furthest open act while infinite is locked,
		-- played normally. With every mission done, plain infinite on the picked world.
		local questWorld, _, _, level = AA.dailyKillQuest()
		if level and Levels[level] and levelUnlocked(level, done) then
			return level, "Hard", "story"
		end
		local world = questWorld and Worlds[questWorld]
		for act = 6, 1, -1 do
			local entry = world and world.levels and (world.levels[tostring(act)] or world.levels[act])
			if entry and levelUnlocked(entry.id, done) then
				return entry.id, "Normal", "story"
			end
		end
		return chooseTarget("Infinite")
	elseif mode == "Kills" then
		if Config.KillsStage == "Summer" then
			return chooseTarget("Summer")
		end
		-- Walled City (the Titan map) on infinite.
		local world = Worlds.aot
		local id = (world and world.infinite and world.infinite.id) or "aot_infinite"
		if not Levels[id] or not levelUnlocked(id, done) then
			return nil, nil, "locked"
		end
		return id, "Hard", "story"
	elseif mode == "Infinite" then
		local world = Worlds[Config.World]
		local id = world and world.infinite and world.infinite.id
		if id and not levelUnlocked(id, done) then
			return nil, nil, "locked"
		end
		return id, "Hard", "story"
	elseif mode == "Legend" then
		local world = Worlds[Config.Legend]
		local level = world and world.levels and (world.levels[tostring(Config.LegendAct)] or world.levels[Config.LegendAct])
		if level and not levelUnlocked(level.id, done) then
			return nil, nil, "locked"
		end
		return level and level.id, "Hard", "story"
	elseif mode == "Raid" then
		-- Raids rotate: play the open one (or the picked one if it's the open one), else wait on story.
		local data = workspace:FindFirstChild("_LOBBIES") and workspace._LOBBIES:FindFirstChild("_DATA")
		local open = data and data:FindFirstChild("raid_open") and data.raid_open.Value
		local active = data and data:FindFirstChild("current_active_raid") and data.current_active_raid.Value or ""
		if open and active ~= "" then
			local world = Worlds[active]
			local level = world and world.levels and (world.levels["1"] or world.levels[1])
			return level and level.id or active, "Hard", "raid"
		end
		return nil, nil, "raid"
	elseif mode == "Artifact" then
		local world = Worlds[Config.Artifact]
		local level = world and world.levels and (world.levels["1"] or world.levels[1])
		if level and levelUnlocked(level.id, done) then
			return level.id, "Hard", "raid"
		end
		return nil, nil, "artifact"
	elseif mode == "Summer" then
		local lobbies = workspace:FindFirstChild("_EVENT_CHALLENGES") and workspace._EVENT_CHALLENGES:FindFirstChild("Lobbies")
		for _, lobby in ipairs(lobbies and lobbies:GetChildren() or {}) do
			local level = lobby:FindFirstChild("Level")
			if level and level.Value ~= "" then
				return level.Value, "Hard", "event"
			end
		end
		return "summer2_event", "Hard", "event"
	elseif mode == "Portals" then
		-- A portal item from the inventory: the picked kind (or any), one already started first,
		-- then the oldest. use_portal takes the item's uuid.
		local best = AA.portalChoose()
		if best then
			return best.uuid, best.name, "portal"
		end
		return nil, nil, "portal"
	elseif mode == "Cursed Womb" then
		-- Its own lobby (_DUNGEONS), one Cursed Womb Key per run. Keys drop in Haunted Academy
		-- infinite; the Robux ones are never bought.
		local items = (profile().inventory or {}).normal_items or {}
		if (tonumber(items.key_jjk_finger) or 0) <= 0 then
			return nil, nil, "wombkey"
		end
		if not levelUnlocked("jjk_finger", done) then
			return nil, nil, "locked"
		end
		return "jjk_finger", "Hard", "womb"
	elseif mode == "Tournament" then
		return "tournament", nil, "tournament"
	elseif mode == "Castle" then
		local floor = AA.castleNext()
		return floor, AA.castleDifficulty(floor), "castle"
	elseif mode == "Dungeon" then
		return "dungeon", nil, "dungeon"
	elseif mode == "Challenge" or mode == "Daily" then
		local folder = workspace:FindFirstChild("_CHALLENGES")
		-- The Daily first (the biggest prize: gems, wishes, rerolls), then this half hour's
		-- challenge. Each pays once: the Daily per day, a challenge per rotation.
		local groups = {}
		if (mode == "Daily" or Config.DailyWithChallenges) and AA.dailyOpen() then
			table.insert(groups, "DailyChallenge")
		end
		if mode == "Challenge" and AA.challengeOpen() then
			table.insert(groups, "Challenges")
		end
		for _, groupName in ipairs(groups) do
			local group = folder and folder:FindFirstChild(groupName)
			for _, lobby in ipairs(group and group:GetChildren() or {}) do
				local level = lobby:FindFirstChild("Level")
				local id = level and level.Value
				if id and id ~= "" and not (AA.challengeDone and AA.challengeDone[groupName .. id] and os.clock() - AA.challengeDone[groupName .. id] < 180) then
					return id, nil, "challenge", groupName
				end
			end
		end
		-- Nothing new to clear: play the fallback mode until the next rotation.
		if Config.ChallengeFallback ~= "None" and not modeOverride then
			local id, difficulty, kind, group = chooseTarget(Config.ChallengeFallback)
			if id then
				AA.targetMode = Config.ChallengeFallback
				return id, difficulty, kind, group
			end
		end
		return nil, nil, "challenge"
	end
	return nil
end
---What to join: the picked mode; for the challenge modes the mode set for between challenges;
---and when none of that has anything to play (no portal left, a locked stage, no raid open),
---the "Otherwise" mode. AA.targetMode says which of them the target came from.
chooseTarget = function(modeOverride)
	if modeOverride then
		return AA.chooseInner(modeOverride)
	end
	AA.targetMode = Config.Mode
	local id, difficulty, kind, group = AA.chooseInner()
	if not id and Config.Otherwise ~= "None" and Config.Otherwise ~= Config.Mode then
		local otherId, otherDifficulty, otherKind, otherGroup = AA.chooseInner(Config.Otherwise)
		if otherId then
			AA.targetMode = Config.Otherwise
			return otherId, otherDifficulty, otherKind, otherGroup
		end
	end
	return id, difficulty, kind, group
end
---The mode this match is being played in: the one the script started it in (a fallback counts
---as itself), else the picked mode.
function AA.playMode()
	local session = AA.progress and AA.progress.session
	if not IS_LOBBY and type(session) == "table" and session.job == game.JobId and session.mode then
		return session.mode
	end
	return Config.Mode
end
---Playing a fallback while something earlier in the order has become playable (a portal dropped,
---a stage unlocked)? Checked on the result screen, so the next match is the better one.
function AA.betterWaiting()
	local playing = AA.playMode()
	if Config.Otherwise == "None" or playing ~= Config.Otherwise then
		return false
	end
	local earlier = {}
	if Config.Mode == "Challenge" or Config.Mode == "Daily" then
		if Config.ChallengeFallback ~= "None" then
			table.insert(earlier, Config.ChallengeFallback)
		end
	else
		table.insert(earlier, Config.Mode)
	end
	for _, mode in ipairs(earlier) do
		if mode == playing then
			return false
		end
		local ok, id = pcall(AA.chooseInner, mode)
		if ok and id then
			return true
		end
	end
	return false
end

local function lobbyFolder(kind, group)
	local lobbies = workspace:FindFirstChild("_LOBBIES")
	if kind == "raid" then
		local raid = workspace:FindFirstChild("_RAID")
		return raid and (raid:FindFirstChild("Raid") or raid)
	elseif kind == "challenge" then
		local challenges = workspace:FindFirstChild("_CHALLENGES")
		return challenges and challenges:FindFirstChild(group or "Challenges")
	elseif kind == "womb" then
		local dungeons = workspace:FindFirstChild("_DUNGEONS")
		return dungeons and dungeons:FindFirstChild("Lobbies")
	end
	return lobbies and lobbies:FindFirstChild("Story")
end

local function lobbyBusy(lobby)
	local players = lobby:FindFirstChild("Players")
	local locked = lobby:FindFirstChild("Locked")
	local teleporting = lobby:FindFirstChild("Teleporting")
	if players and #players:GetChildren() > 0 then
		return true
	end
	return (locked and locked.Value) or (teleporting and teleporting.Value) or false
end

---Did the server show a popup containing this text in the last `seconds`?
function AA.sawMessage(text, seconds)
	for _, message in ipairs(AA.messages or {}) do
		if os.clock() - message.at <= seconds and message.text:find(text, 1, true) then
			return true
		end
	end
	return false
end

---The start request is in: the teleport takes a few seconds. Lobby chores run in this window.
function AA.waitForTeleport(seconds)
	AA.joining = "waiting"
	AA.joinWaited = true
	local deadline = os.clock() + seconds
	while AA.alive and os.clock() < deadline do
		task.wait(0.5)
	end
end

---The lobby a named player has opened (their user or display name, any letter case).
function AA.friendLobby()
	local want = tostring(Config.JoinFriend):lower():gsub("^%s+", ""):gsub("%s+$", "")
	if want == "" then
		return nil
	end
	local folders = {}
	for _, path in ipairs({ { "_LOBBIES", "Story" }, { "_RAID", "Raid" }, { "_CHALLENGES", "Challenges" }, { "_CHALLENGES", "DailyChallenge" }, { "_EVENT_CHALLENGES", "Lobbies" }, { "_DUNGEONS", "Lobbies" }, { "_PORTALS", "Lobbies" } }) do
		local folder = workspace:FindFirstChild(path[1])
		folder = folder and folder:FindFirstChild(path[2])
		if folder then
			table.insert(folders, folder)
		end
	end
	for _, folder in ipairs(folders) do
		for _, lobby in ipairs(folder:GetChildren()) do
			local owner = lobby:FindFirstChild("Owner")
			local player = owner and owner.Value
			if player and player ~= localPlayer and (player.Name:lower() == want or player.DisplayName:lower() == want) then
				return lobby, player
			end
		end
	end
	return nil
end

-- Instant portal join: the moment another player opens a portal in this lobby, step into it.
-- (Portal lobbies are the children of workspace._PORTALS.Lobbies; "Owner" is set to the player
-- who opened one, and request_join_lobby with the lobby's name is the game's own join.)
if IS_LOBBY then
	task.spawn(function()
		local portals = workspace:WaitForChild("_PORTALS", 30)
		local folder = portals and portals:WaitForChild("Lobbies", 30)
		if not folder then
			return
		end
		local tries = {}
		local function try(lobby)
			if not (AA.alive and Config.PortalInstant) then
				return
			end
			local owner = lobby:FindFirstChild("Owner")
			local player = owner and owner.Value
			local inLobby = localPlayer:FindFirstChild("AlreadyInLobby")
			if not player or player == localPlayer or (inLobby and inLobby.Value) then
				return
			end
			-- Up to three asks for one opening (full, friends only or already started: the
			-- server says no and that is that).
			local key = lobby.Name .. ":" .. tostring(player.UserId)
			local entry = tries[key] or { n = 0, at = 0 }
			if entry.n >= 3 or os.clock() - entry.at < 1 then
				return
			end
			entry.n += 1
			entry.at = os.clock()
			tries[key] = entry
			AA.portalJoinAt = os.clock()
			status = "Joining " .. player.DisplayName .. "'s portal"
			task.spawn(invoke, "request_join_lobby", lobby.Name)
		end
		local function watch(lobby)
			local owner = lobby:FindFirstChild("Owner") or lobby:WaitForChild("Owner", 10)
			if owner then
				table.insert(AA.connections, owner:GetPropertyChangedSignal("Value"):Connect(function()
					try(lobby)
				end))
				try(lobby)
			end
		end
		for _, lobby in ipairs(folder:GetChildren()) do
			task.spawn(watch, lobby)
		end
		table.insert(AA.connections, folder.ChildAdded:Connect(function(lobby)
			task.spawn(watch, lobby)
		end))
		-- (Also looked at twice a second: covers the toggle being switched on with a portal
		-- already open, and a lobby whose owner value was set before the signal was connected.)
		while AA.alive do
			if Config.PortalInstant then
				for _, lobby in ipairs(folder:GetChildren()) do
					try(lobby)
				end
			end
			task.wait(0.5)
		end
	end)
end

local function joinGame()
	if #equippedUnits() == 0 then
		equipBest()
		task.wait(1)
	end
	if Config.PortalInstant and AA.portalJoinAt and os.clock() - AA.portalJoinAt < 180 then
		-- In someone's portal lobby: nothing of our own is opened while its owner gets ready.
		local inLobby = localPlayer:FindFirstChild("AlreadyInLobby")
		if inLobby and inLobby.Value then
			status = "In a portal lobby, waiting for its owner to start"
			return false
		end
	end
	if tostring(Config.JoinFriend) ~= "" then
		-- A friend to play with: step into the lobby they open and let them start it; nothing of
		-- our own is opened while waiting for them.
		local lobby, player = AA.friendLobby()
		local inLobby = localPlayer:FindFirstChild("AlreadyInLobby")
		if lobby and not (inLobby and inLobby.Value) then
			status = "Joining " .. player.DisplayName
			note("friend", { n = player.Name })
			invoke("request_join_lobby", lobby.Name)
			AA.waitForTeleport(60)
		else
			status = lobby and ("In " .. player.DisplayName .. "'s lobby") or ("Waiting for " .. tostring(Config.JoinFriend) .. " to open a lobby")
		end
		return false
	end
	local id, difficulty, kind, group = chooseTarget()
	-- (A match started through a fallback counts as started in that fallback's mode: its rules
	-- apply there, and only there.)
	local startedMode = AA.targetMode or Config.Mode
	if id and (type(AA.progress.started) ~= "table" or AA.progress.started.mode ~= startedMode or os.time() - (AA.progress.started.at or 0) > 20) then
		-- The match about to load was started by the script in this mode (mode rules such as
		-- Farm kills only apply to those, never to a match opened by hand).
		AA.progress.started = { mode = startedMode, at = os.time(), user = localPlayer.UserId, quest = startedMode == "Quests" and AA.questPick or nil }
		AA.saveProgress()
	end
	if not id then
		status = kind == "quests" and "No quest the script can play right now (see the list on the Mode tab)" or kind == "wombkey" and "No Cursed Womb Key (drops in Haunted Academy infinite)" or kind == "portal" and "No portal items" or kind == "raid" and "Waiting for a raid" or (kind == "challenge" and "No challenge left" or ((kind == "artifact" or kind == "locked") and "Locked: clear the story first" or "Nothing to join"))
		return false
	end
	do
		-- The game's own queue (request_matchmaking), switched on per kind of match. Ids, from its lobby code: the Daily and the
		-- half-hour challenge have fixed names, the mansion a room id, and any level whose data has
		-- a _MATCHMAKING table (infinite, legend stages, raids, the Summer Hunt) its own id.
		local queueId, wanted
		if kind == "challenge" then
			queueId = group == "DailyChallenge" and "__DAILY_CHALLENGE" or "__NORMAL_CHALLENGE"
			wanted = group == "DailyChallenge" and Config.MatchDaily or group ~= "DailyChallenge" and Config.MatchChallenge
		elseif kind == "castle" then
			queueId = string.format("__INFINITE_TOWER:%d:%s", id, difficulty or "Normal")
			wanted = Config.MatchCastle
		elseif type(id) == "string" and Levels[id] and Levels[id]._MATCHMAKING then
			queueId = id
			local lower = id:lower()
			if lower:find("summer") then
				wanted = Config.MatchSummer
			elseif Levels[id].is_raid or kind == "raid" then
				wanted = Config.MatchRaid
			elseif lower:find("infinite") then
				wanted = Config.MatchInfinite
			else
				wanted = Config.MatchLegend
			end
		end
		if queueId and wanted and os.clock() - ((AA.queueFailed or {})[queueId] or -1e9) > 600 then
			status = "Finding a match"
			local ok, accepted = invoke("request_matchmaking", queueId)
			note("queue", { id = queueId, ok = ok and accepted ~= false })
			if ok and accepted ~= false then
				-- A found match teleports (and this script starts over in it). Still here after
				-- 45 s: nobody is queueing, so start it alone and don't queue for this again for
				-- ten minutes.
				AA.waitForTeleport(45)
			end
			invoke("leave_matchmaking")
			AA.queueFailed = AA.queueFailed or {}
			AA.queueFailed[queueId] = os.clock()
			task.wait(1)
		end
	end
	if kind == "portal" then
		status = "Opening " .. tostring(difficulty)
		AA.portalTried = AA.portalTried or {}
		AA.portalTried[id] = true
		invoke("use_portal", id, { friends_only = Config.FriendsOnly or nil })
		task.wait(1.5)
		local portals = workspace:FindFirstChild("_PORTALS") and workspace._PORTALS:FindFirstChild("Lobbies")
		for _, lobby in ipairs(portals and portals:GetChildren() or {}) do
			local owner = lobby:FindFirstChild("Owner")
			if owner and owner.Value == localPlayer then
				invoke("request_start_game", lobby.Name)
			end
		end
		AA.waitForTeleport(25)
		return false
	end
	if kind == "event" or kind == "tournament" or kind == "castle" or kind == "dungeon" or kind == "skip" then
		status = "Starting " .. tostring(kind == "castle" and ("castle room " .. id) or id)
		if kind == "event" then
			invoke("open_event_portal", id, { difficulty = difficulty or "Hard", friends_only = Config.FriendsOnly })
			task.wait(1)
			local portals = workspace:FindFirstChild("_PORTALS") and workspace._PORTALS:FindFirstChild("Lobbies")
			for _, lobby in ipairs(portals and portals:GetChildren() or {}) do
				local owner = lobby:FindFirstChild("Owner")
				if owner and owner.Value == localPlayer then
					invoke("request_start_game", lobby.Name)
				end
			end
		elseif kind == "tournament" then
			invoke("request_start_tournament")
		elseif kind == "castle" then
			invoke("request_start_infinite_tower", id, difficulty or "Normal")
		elseif kind == "dungeon" then
			AA.dungeonStep()
			return true
		elseif kind == "skip" then
			-- No teleport: the skip marks Acts 1-5 cleared in the profile. Wait for that to land.
			invoke("lobby_world_skip", id)
			local deadline = os.clock() + 6
			while AA.alive and os.clock() < deadline and not completedLevels()[tostring(id) .. "_level_5"] do
				task.wait(0.25)
			end
			if not completedLevels()[tostring(id) .. "_level_5"] then
				-- Refused: play this world act by act instead of asking again forever.
				AA.skipFailed = AA.skipFailed or {}
				AA.skipFailed[id] = true
			else
				-- The match server's copy of the profile won't know about the skip: remember it,
				-- or the next-act vote after Act 6 thinks Act 1 is still open and goes to the lobby.
				local cleared = AA.myClears()
				for act = 1, 5 do
					local levelId = tostring(id) .. "_level_" .. act
					cleared[levelId] = type(cleared[levelId]) == "table" and cleared[levelId] or {}
					cleared[levelId].Normal = true
				end
				AA.saveProgress()
			end
			return false
		end
		AA.waitForTeleport(25)
		if kind == "castle" and Config.CastleFloor == 0 then
			-- Still here: that room isn't open yet. Step our own record back one.
			for _, key in ipairs({ "CastleNormal", "CastleHard" }) do
				if (AA.progress[key] or 0) >= id - 1 and (AA.progress[key] or 0) > 0 then
					AA.progress[key] -= 1
				end
			end
			AA.saveProgress()
		end
		return false
	end
	local folder = lobbyFolder(kind, group)
	if not folder then
		status = "No " .. kind .. " lobbies"
		return false
	end
	for _, lobby in ipairs(folder:GetChildren()) do
		local lobbyLevel = lobby:FindFirstChild("Level")
		if lobby:IsA("Model") and not lobbyBusy(lobby) and ((kind ~= "challenge" and kind ~= "womb") or (lobbyLevel and lobbyLevel.Value == id)) then
			status = "Joining " .. tostring(id)
			local ok = invoke("request_join_lobby", lobby.Name)
			if ok then
				if kind ~= "challenge" and kind ~= "womb" then
					invoke("request_lock_level", lobby.Name, id, Config.FriendsOnly, difficulty)
				end
				task.wait(0.5)
				invoke("request_start_game", lobby.Name)
				status = "Starting " .. tostring(id)
				-- The teleport takes a few seconds; if it doesn't happen, leave and retry.
				AA.waitForTeleport(25)
				invoke("request_leave_lobby", lobby.Name)
				if difficulty == "Hard" and AA.sawMessage("not unlocked this difficulty", 30) then
					AA.hardBlocked = AA.hardBlocked or {}
					AA.hardBlocked[id] = true
					note("hardBlocked", { id = id })
				end
				if kind == "challenge" then
					-- Still here: the teleport failed or it's locked. Try again in a few minutes.
					AA.challengeDone = AA.challengeDone or {}
					AA.challengeDone[(group or "") .. id] = os.clock()
				end
				return true
			end
		end
	end
	status = "All lobbies busy"
	return false
end

-- Dungeon runs: dungeon_data.next holds the room choices (choice_str -> {_l = level, _t = room types}).
-- Types: 0 curse, 1 shop, 2 money, 3 gold treasure, 4 treasure, 5 final boss, 6 open chests, 7 shrine.
local ROOM_VALUE = { ["3"] = 6, ["4"] = 5, ["6"] = 4, ["2"] = 3, ["5"] = 3, ["7"] = 2, ["1"] = 1, ["0"] = -6 }

-- Shop order (lower buys first): loot and luck, cheaper units, then damage.
local DUNGEON_SHOP_RANK = {}
for rank, id in ipairs({ "gold_shroom", "gold_mask", "genie_lamp", "moon_fragment", "philospher_stone", "gold_branch", "hook2", "hook", "deathcap", "tome", "sword3", "frost_axe", "icebane", "bow_legendary", "stormbringer", "mage_coat", "sword2", "bow3", "bow2", "bow1", "scythe", "boots", "sword1", "belt", "cloak", "hammer_legendary", "fire_axe", "axe", "axe_legendary", "celestial_blade" }) do
	DUNGEON_SHOP_RANK[id] = rank
end
-- Shrine curses: true = leave it.
local DUNGEON_SHRINE_SKIP = { _curse_super_chaos = true, _curse_super_speed = true, _curse_super_regen = true, _curse_super_armored = false, _curse_super_burst = false, _curse_super_explode = false, _curse_super_health = false }

local function dungeonKeys()
	local inventory = profile().inventory
	local items = inventory and inventory.normal_items
	return items and tonumber(items.dungeon_key) or 0
end

local function resourceTotal(data)
	local r = data._resources or {}
	return (r.treasure or 0) + (r.treasure_gold or 0)
end

function AA.dungeonStep()
	local data = profile().dungeon_data or {}
	if not data._started then
		if dungeonKeys() <= 0 then
			status = "No dungeon keys"
			return false
		end
		status = "Starting dungeon"
		invoke("dungeon_start")
		task.wait(2)
		data = profile().dungeon_data or {}
		if not data._started then
			return false
		end
	end
	if data._dead then
		status = "Dungeon: continuing after death"
		invoke("dungeon_continue_death")
		task.wait(2)
		return true
	end
	local room = data.current_shops
	if type(room) == "table" and next(room) ~= nil then
		local kind = tostring(room._t)
		if kind == "6" then
			-- Open every chest: the game's own buttons send no argument for a normal chest and
			-- `true` for a gold one.
			status = "Dungeon: opening chests"
			for _ = 1, 40 do
				local resources = (profile().dungeon_data or {})._resources or {}
				local gold = (tonumber(resources.treasure_gold) or 0) > 0
				if not gold and (tonumber(resources.treasure) or 0) <= 0 then
					break
				end
				local before = resourceTotal(profile().dungeon_data or {})
				if gold then
					invoke("dungeon_open_chest", true)
				else
					invoke("dungeon_open_chest")
				end
				local deadline = os.clock() + 1.5
				while os.clock() < deadline and resourceTotal(profile().dungeon_data or {}) >= before do
					task.wait(0.1)
				end
				if resourceTotal(profile().dungeon_data or {}) >= before then
					break
				end
			end
		elseif kind == "1" then
			-- Shop: buy what the run's money covers, cheapest first (curse items are left alone).
			status = "Dungeon: shop"
			local dungeon = findData("DungeonServiceCore", "sum_item_values")
			local items = dungeon and dungeon.ITEMS or {}
			-- What the team can use: an item that only lifts physical (or magic) damage is skipped
			-- when nobody equipped deals it.
			local deals = {}
			for _, entry in ipairs(equippedUnits()) do
				if unitStatsAt(entry.data, 0).damage > 0 or AA.isSummoner(entry.id) then
					deals[entry.data._base_damage_type == "magic" and "magic" or "physical"] = true
				end
			end
			local offers = {}
			for index, offer in pairs(room) do
				local item = type(offer) == "table" and items[offer.id]
				if item and item.cost and not item.curse_chance and not item.curse_super_chance then
					local useful = true
					for _, effect in pairs(type(item.wave_modifier_effects) == "table" and item.wave_modifier_effects or {}) do
						local stat = type(effect) == "table" and tostring(effect.stat or "") or ""
						if (stat:find("physical") and not deals.physical) or (stat:find("magic") and not deals.magic) or stat:find("true_damage") then
							useful = false
						end
					end
					if useful then
						table.insert(offers, { index = index, cost = item.cost, rank = DUNGEON_SHOP_RANK[offer.id] or 50 })
					end
				end
			end
			-- Best first (rewards and cheaper units, then damage), not cheapest first: the run's
			-- money used to go on tier-1 daggers before a Golden Mushroom could be paid for.
			table.sort(offers, function(x, y)
				if x.rank ~= y.rank then
					return x.rank < y.rank
				end
				return x.cost < y.cost
			end)
			for _, offer in ipairs(offers) do
				local data = profile().dungeon_data or {}
				local scale = math.max(0, (tonumber(gameCall(dungeon.sum_item_values, data, "shop_prices")) or 0) + 1)
				local money = tonumber((data._resources or {}).money) or 0
				if money >= math.ceil(offer.cost * scale) then
					invoke("dungeon_buy_shop", offer.index)
					task.wait(0.4)
				end
			end
		elseif kind == "7" then
			-- A shrine trades a super curse for loot. Faster, regenerating or random-curse enemies
			-- are the ones that end runs: those are walked past.
			local curse
			local function scan(value, depth)
				if type(value) == "string" and DUNGEON_SHRINE_SKIP[value] ~= nil then
					curse = value
				elseif type(value) == "table" and depth < 4 then
					for key, inner in pairs(value) do
						scan(key, depth + 1)
						scan(inner, depth + 1)
					end
				end
			end
			scan(room, 0)
			if curse and DUNGEON_SHRINE_SKIP[curse] then
				status = "Dungeon: shrine skipped"
			else
				status = "Dungeon: shrine"
				invoke("dungeon_shrine_accept")
			end
			pcall(note, "shrine", { c = tostring(curse), took = not (curse and DUNGEON_SHRINE_SKIP[curse]) })
			task.wait(0.6)
		end
		invoke("dungeon_continue_shop")
		task.wait(1.5)
		return true
	end
	local best, bestValue = nil, -math.huge
	for choice, option in pairs(data.next or {}) do
		if type(option) == "table" and option._l then
			local value = 0
			for roomType in pairs(option._t or {}) do
				value += ROOM_VALUE[tostring(roomType)] or 0
			end
			-- Easier rooms first when the rewards tie.
			value -= (option._l._lobby_difficulty_scale or 1)
			if value > bestValue then
				best, bestValue = option._l._dungeon and option._l._dungeon.choice_str or choice, value
			end
		end
	end
	if not best then
		status = "Dungeon: finishing"
		invoke("dungeon_continue_shop")
		return false
	end
	status = "Dungeon: room " .. tostring(best)
	invoke("dungeon_enter_room", tostring(best))
	AA.waitForTeleport(25)
	return true
end

local function playerLevel()
	local service = findData("LevelServiceCore", "calculate_level")
	local xp = stats:FindFirstChild("player_xp") and stats.player_xp.Value or profile().player_xp or 0
	local ok, level = pcall(function()
		return service.calculate_level(service, xp)
	end)
	return ok and tonumber(level) or 1
end

---One try per (thing, state), remembered across lobby visits and per account: a refused claim
---(expired code, NPC-only quest) is not asked again every time we pass through the lobby.
local function alreadyTried(key, stamp)
	local name = "tried_" .. tostring(localPlayer.UserId)
	if type(AA.progress[name]) ~= "table" then
		AA.progress[name] = {}
	end
	local tried = AA.progress[name]
	stamp = tostring(stamp == nil and true or stamp)
	if tried[key] == stamp then
		return true
	end
	tried[key] = stamp
	AA.progressDirty = true
	return false
end

local function claimRewards()
	local pd = profile()
	local level = playerLevel()
	local day = math.floor(os.time() / 86400)
	if Config.AutoCodes then
		-- Codes are level gated (10 / 20): one try per code per player level, so no error spam.
		local redeemed = pd.redeemed_codes or {}
		for _, code in ipairs(CODES) do
			local done = redeemed[code] or redeemed[code:lower()] or table.find(redeemed, code)
			if not done and level >= (CODE_LEVELS[code] or 1) and not alreadyTried("code:" .. code, level) then
				invoke("redeem_code", code)
				task.wait(1)
				local now = profile().redeemed_codes or {}
				if now[code] then
					Stats.codes += 1
				end
			end
		end
	end
	if Config.AutoDaily then
		-- Daily reward: the profile says when the last one was taken.
		local wait = tonumber(Core.Settings.DAILY_REWARD_WAIT) or 82800
		local last = tonumber(pd.last_daily_reward_claimed_time) or 0
		if os.time() - last >= wait and not alreadyTried("daily", math.floor(os.time() / 1800)) then
			invoke("claim_daily_reward")
		end
		local claimed = pd.level_rewards_claimed or {}
		local rewards = gameRequire(replicatedStorage.src.Data.PlayerLevelRewards) or {}
		for _, reward in pairs(rewards) do
			local need = type(reward) == "table" and reward.level
			if need and level >= (tonumber(need) or math.huge) and not (claimed[need] or claimed[tonumber(need)] or claimed[tostring(need)] or table.find(claimed, need) or table.find(claimed, tonumber(need))) and not alreadyTried("level:" .. tostring(need)) then
				invoke("claim_player_level_rewards", need)
			end
		end
		-- Clear-count rewards (raids, artifact stages: "5 clears: +250 Gems").
		local done = pd.level_data and pd.level_data.completed_story_levels or {}
		for id, levelData in pairs(Core.RawLevels) do
			if type(levelData) == "table" and type(levelData.clear_rewards) == "table" then
				local table_ = gameCall(Core.Progress and Core.Progress.get_clear_rewards_table, session(), levelData) or pd.clear_rewards or {}
				local entry = gameCall(Core.Progress and Core.Progress.get_completed_level_data, session(), levelData) or done[id]
				for difficulty, list in pairs(levelData.clear_rewards) do
					local progress = type(entry) == "table" and type(entry.difficulty_completed_data) == "table" and entry.difficulty_completed_data[difficulty]
					local times = type(progress) == "table" and tonumber(progress.times_completed) or 0
					for _, reward in pairs(type(list) == "table" and list or {}) do
						local got = type(table_) == "table" and table_[id] and table_[id][difficulty] and table_[id][difficulty][reward._id]
						if type(reward) == "table" and reward._id and times >= (tonumber(reward.clears) or math.huge) and not got and not alreadyTried("clear:" .. id .. ":" .. tostring(difficulty) .. ":" .. tostring(reward._id)) then
							status = "Claiming " .. tostring(reward._reward_text or "clear reward")
							invoke("claim_first_clear_rewards", id, difficulty, reward._id)
						end
					end
				end
			end
		end
	end
	if Config.AutoPass then
		-- Only when a tier is actually claimable.
		local passes = gameRequire(replicatedStorage.src.Data.BattlePass) or {}
		for passId, progress in pairs(pd.battlepass_data or {}) do
			local pass = passes[passId]
			local claimed = type(progress) == "table" and progress.claimed_tiers and progress.claimed_tiers.normal or {}
			local ready = false
			for tier, info in pairs(pass and pass.tiers or {}) do
				if (progress.xp or 0) >= (info.xp_required or math.huge) and (info._unlock_time or 0) <= os.time() and not (claimed[tostring(tier)] or claimed[tonumber(tier)]) then
					ready = true
				end
			end
			if ready and not alreadyTried("pass:" .. tostring(passId), math.floor(progress.xp or 0)) then
				invoke("claim_battlepass_rewards")
			end
		end
		-- Summer bingo: a line can only complete after a Summer Hunt win, so once per lobby visit.
		local gui = findData("GUIService", "summer2_hunt_maps_ui")
		local board = gui and gui.summer2_hunt_maps_ui
		local ready = board and (board.ready_count or 0) > 0 and not board.completed
		local summerMode = Config.Mode == "Summer" or ((Config.Mode == "Challenge" or Config.Mode == "Daily") and Config.ChallengeFallback == "Summer")
		if ready or (summerMode and not AA.bingoTried and Stats.wins > 0) then
			AA.bingoTried = true
			invoke("claim_summer2_map_board_lines")
		end
	end
	if Config.AutoQuests then
		-- Finished quests (story, daily, event, infinite...) pay out by uuid; NPC-only ones just get refused.
		local handler = pd.quest_handler
		for uuid, quest in pairs(handler and handler.quests or {}) do
			local info = type(quest) == "table" and quest.quest_info
			local need = info and info.quest_class and info.quest_class.amount or 1
			local have = quest.quest_progress and quest.quest_progress.amount or 0
			if info and have >= need and not alreadyTried("quest:" .. tostring(uuid), day) then
				invoke("redeem_quest", uuid)
			end
		end
		pcall(AA.charmStep)
		-- Daily and 1-hour missions: the board lists the interval's missions, and
		-- request_claim_dailymission / request_claim_mission is the board's ACCEPT button (not a
		-- reward claim). An accepted mission becomes a quest in handler.quests ("Kill 3000 X, any
		-- mode") and only counts kills from then on; its reward is paid by redeem_quest above once
		-- it's done. claimed_missions holds the accepted ids and resets when the interval rolls over.
		-- Re-checked every ~30 min and after each finished match, not on every lobby tick.
		local missionStamp = math.floor(os.time() / 1800) .. ":" .. tostring(Stats.wins + Stats.losses)
		for _, kind in ipairs({
			{ key = "dailymissions_data", list = "request_current_dailymissions", claim = "request_claim_dailymission" },
			{ key = "missions_data", list = "request_current_missions", claim = "request_claim_mission" },
		}) do
			if not alreadyTried("missions:" .. kind.key, missionStamp) then
				local ok, ids, interval = invoke(kind.list)
				if ok and type(ids) == "table" then
					local data = type(pd[kind.key]) == "table" and pd[kind.key] or {}
					local fresh = (tonumber(data.highest_claimed_interval) or -1) < (tonumber(interval) or 0)
					local claimed = type(data.claimed_missions) == "table" and data.claimed_missions or {}
					for _, id in pairs(ids) do
						if fresh or not claimed[id] then
							invoke(kind.claim, id)
						end
					end
				end
			end
		end
	end
	if AA.progressDirty then
		AA.progressDirty = nil
		-- Old quest ids pile up (daily quests get new ones every day): drop the stale ones.
		local tried = AA.progress["tried_" .. tostring(localPlayer.UserId)]
		local count = 0
		for _ in pairs(type(tried) == "table" and tried or {}) do
			count += 1
		end
		if count > 300 then
			for key, stamp in pairs(tried) do
				if key:sub(1, 6) == "quest:" and stamp ~= tostring(day) then
					tried[key] = nil
				end
			end
		end
		AA.saveProgress()
	end
	Stats.claims += 1
end

local function itemCount(id)
	local inventory = profile().inventory
	local items = inventory and inventory.normal_items
	return items and tonumber(items[id]) or 0
end

local function currency(id)
	if id == "Gems" or id == nil then
		return stats:FindFirstChild("gem_amount") and stats.gem_amount.Value or profile().gem_amount or 0
	elseif id == "Gold" then
		return stats:FindFirstChild("gold_amount") and stats.gold_amount.Value or profile().gold_amount or 0
	end
	local value = stats:FindFirstChild("_resource" .. id)
	if value then
		return value.Value
	end
	local resources = profile().resources
	return resources and tonumber(resources[id]) or 0
end

-- Summons: gem banners cost gems, the Summer capsule banner costs Summer Pearls; tickets go first.
---Stop on a Mythic. Compares the collection with how it looked before the last pull: any new unit
---rarer than Legendary (Mythic, Secret) switches auto summon off. Works the same for single
---pulls and for 10 at a time (all ten land in the collection together; one Mythic among them
---is enough). True when it stopped.
function AA.summonStop(quiet)
	local owned = collectionData().owned_units or {}
	local seen, hit = {}, nil
	for uuid, unit in pairs(owned) do
		seen[uuid] = true
		if AA.summonSeen and not AA.summonSeen[uuid] then
			local data = Units[unit.unit_id]
			local rarity = data and tostring(data.rarity)
			if rarity and rarity ~= "Rare" and rarity ~= "Epic" and rarity ~= "Legendary" then
				hit = tostring(data.name or unit.unit_id) .. " (" .. rarity .. ")"
			end
		end
	end
	AA.summonSeen = seen
	if hit and Config.SummonStopMythic and not quiet then
		Config.AutoSummon = false
		AA.summonSeen = nil
		AA.lastPull = hit
		status = "Pulled " .. hit .. ": auto summon stopped"
		note("summonStop", { unit = hit })
		for _, refresh in ipairs(AA.toggleRefreshers) do
			pcall(refresh)
		end
		return true
	end
	return false
end
---After a pull: give the new units a moment to land in the collection, then check them, so a
---Mythic stops the summoning before the next pull is paid for.
function AA.summonSettle(count, quiet)
	local before = 0
	for _ in pairs(AA.summonSeen or {}) do
		before += 1
	end
	local deadline = os.clock() + 2.5
	while os.clock() < deadline do
		local now = 0
		for _ in pairs(collectionData().owned_units or {}) do
			now += 1
		end
		if now ~= before then
			-- A batch of ten arrives in one update; one more beat in case it doesn't.
			task.wait(count > 1 and 0.4 or 0.15)
			break
		end
		task.wait(0.1)
	end
	return AA.summonStop(quiet)
end

local function summonStep(snipeBanner)
	if not snipeBanner and not Config.AutoSummon then
		AA.summonSeen = nil
		return
	end
	local bannerId = snipeBanner or Config.Banner
	local banner = Banners[bannerId]
	if not (banner and banner.active) then
		return
	end
	if not snipeBanner and AA.summonStop() then
		return
	end
	setGameSetting("quick_summon", true)
	setGameSetting("autosell_rare", Config.SellRare)
	setGameSetting("autosell_epic", Config.SellEpic)
	if not banner._no_summon_ticket and itemCount("summon_ticket") > 0 then
		status = "Summoning (ticket)"
		if invoke("buy_from_banner", bannerId, "ticket") then
			Stats.summons += 1
		end
		AA.summonSettle(1, snipeBanner ~= nil)
		return
	end
	local costId = banner.resource_cost and banner.resource_cost.id or "Gems"
	local price = banner.resource_cost and banner.resource_cost.amount or banner.gem_cost or 50
	if costId == "GemsLegacy" then
		costId = "GemsLegacy"
	end
	local have = currency(costId)
	local keep = costId == "Gems" and Config.KeepGems or 0
	local count = (Config.SummonTen and have - price * 10 >= keep) and 10 or 1
	if have - price * count < keep then
		return
	end
	status = "Summoning"
	if invoke("buy_from_banner", bannerId, count == 10 and "gems10" or "gems") then
		Stats.summons += count
	end
	AA.summonSettle(count, snipeBanner ~= nil)
end

---What each equipped unit still needs to evolve: one line per unit, with where the missing
---items come from (the game's own "obtained from" text).
function AA.evolveNeeds()
	if not AA.itemInfo then
		AA.itemInfo = {}
		pcall(function()
			for _, module in ipairs(replicatedStorage.src.Data.Items:GetDescendants()) do
				if module:IsA("ModuleScript") then
					local data = gameRequire(module)
					for id, item in pairs(type(data) == "table" and data or {}) do
						if type(item) == "table" and item.name then
							AA.itemInfo[id] = { name = item.name, from = item.obtain_info }
						end
					end
				end
			end
		end)
	end
	local lines = {}
	local data = collectionData()
	local owned = data.owned_units or {}
	for _, uuid in pairs(data.equipped_units or {}) do
		local unit = owned[uuid]
		local unitData = unit and Units[unit.unit_id]
		local evolve = unitData and type(unitData.evolve) == "table" and unitData.evolve
		local recipe = evolve and (evolve[unit.shiny and "shiny" or "normal"] or evolve.normal)
		if type(recipe) == "table" then
			local missing = {}
			local need = tonumber(recipe._takedown_requirement)
			if need and (tonumber(unit.total_takedowns) or 0) < need then
				table.insert(missing, string.format("takedowns %d/%d", unit.total_takedowns or 0, need))
			end
			for _, item in ipairs(recipe.item_requirement or {}) do
				local have, amount = itemCount(item.item_id), item.amount or 1
				if have < amount then
					local info = AA.itemInfo[item.item_id] or {}
					table.insert(missing, string.format("%s %d/%d%s", tostring(info.name or item.item_id), have, amount, info.from and (" (" .. tostring(info.from):gsub("^Obtained from ", ""):gsub("[!%.]$", "") .. ")") or ""))
				end
			end
			local into = evolve.evolve_unit and Units[evolve.evolve_unit] and Units[evolve.evolve_unit].name or "evolved form"
			table.insert(lines, string.format("%s > %s: %s", tostring(unitData.name), tostring(into), #missing == 0 and "ready" or table.concat(missing, ", ")))
		end
	end
	return lines
end

---What every banner features right now: { banner, slots = { { id, name, rarity, chance, top } } },
---the top slot first. (Top = the slot with the banner's highest rate-up chance, the "middle" one
---on the summon screen: 50% of featured Mythic pulls on the rotating banners.) The summon data is
---only loaded in the lobby; in a match the last lobby reading is returned.
function AA.bannerFeatured()
	local service = IS_LOBBY and filtergc("table", { Keys = { "BANNER_UNITS" } }, true) or nil
	if not (service and type(service.BANNER_UNITS) == "table") then
		return type(AA.progress.banners) == "table" and AA.progress.banners.list or {}, type(AA.progress.banners) == "table" and AA.progress.banners.at or nil
	end
	local list = {}
	for bannerId, data in pairs(service.BANNER_UNITS) do
		local banner = Banners[bannerId]
		if type(banner) == "table" and banner.active and type(data) == "table" and type(data.rateup_units) == "table" then
			local slots, best = {}, 0
			for slot, id in pairs(data.rateup_units) do
				local config = type(banner.rateup_units) == "table" and banner.rateup_units[slot] or {}
				local chance = tonumber(config.rateup_chance) or 0
				local unitData = Units[id] or {}
				if (config.rarity or unitData.rarity) == "Mythic" then
					best = math.max(best, chance)
				end
				table.insert(slots, { id = id, name = tostring(unitData.name or id), rarity = tostring(config.rarity or unitData.rarity or "?"), chance = chance })
			end
			for _, slot in ipairs(slots) do
				slot.top = slot.rarity == "Mythic" and slot.chance >= best and best >= 0.5
			end
			table.sort(slots, function(a, b)
				if a.top ~= b.top then
					return a.top
				end
				return a.chance > b.chance
			end)
			table.insert(list, { banner = bannerId, slots = slots })
		end
	end
	table.sort(list, function(a, b)
		return a.banner < b.banner
	end)
	local signature = httpService:JSONEncode(list)
	if type(AA.progress.banners) ~= "table" or AA.progress.banners.signature ~= signature then
		AA.progress.banners = { list = list, at = os.time(), signature = signature }
		AA.progressDirty = true
	end
	return list, os.time()
end

---Summon sniper: a wanted unit is featured on a banner right now and isn't owned yet. Returns the
---banner and the unit (nil when there is nothing to snipe). Mode "Middle": only when the wanted
---unit holds the banner's top slot (the 50% one).
function AA.snipeFind()
	if tostring(Config.SnipeUnits) == "" then
		return nil
	end
	local wanted, owned = {}, {}
	for id in tostring(Config.SnipeUnits):gmatch("[^,]+") do
		wanted[id] = true
	end
	for _, unit in pairs(collectionData().owned_units or {}) do
		owned[unit.unit_id] = true
		local data = Units[unit.unit_id]
		if data and type(data.evolved) == "table" and type(data.evolved.from) == "string" then
			owned[data.evolved.from] = true
		end
	end
	if not IS_LOBBY then
		return nil
	end
	for _, entry in ipairs((AA.bannerFeatured())) do
		for _, slot in ipairs(entry.slots) do
			if wanted[slot.id] and not owned[slot.id] and (Config.SnipeMode ~= "Middle" or slot.top) then
				return entry.banner, slot.id
			end
		end
	end
	return nil
end
function AA.snipeStep()
	if not Config.SnipeOn then
		AA.snipeTarget = nil
		return
	end
	local bannerId, id = AA.snipeFind()
	AA.snipeTarget = id
	if not bannerId then
		return
	end
	-- The normal summon routine, pointed at that banner for one pull (it keeps the gem reserve).
	pcall(summonStep, bannerId)
	status = "Sniping " .. tostring(Units[id] and Units[id].name or id)
end

---One summon right now from the Units tab buttons (1 or 10), on the picked banner.
function AA.summonNow(count)
	if not IS_LOBBY then
		return "Lobby only"
	end
	local banner = Banners[Config.Banner]
	if not (banner and banner.active) then
		return "Banner not active"
	end
	local costId = banner.resource_cost and banner.resource_cost.id or "Gems"
	local price = (banner.resource_cost and banner.resource_cost.amount or banner.gem_cost or 50) * count
	if currency(costId) < price then
		return "Need " .. price .. " " .. costId
	end
	local owned = 0
	for _ in pairs(collectionData().owned_units or {}) do
		owned += 1
	end
	setGameSetting("quick_summon", true)
	AA.lastMessage = nil
	invoke("buy_from_banner", Config.Banner, count == 10 and "gems10" or "gems")
	local deadline = os.clock() + 2
	local now = owned
	while os.clock() < deadline and now <= owned do
		task.wait(0.1)
		now = 0
		for _ in pairs(collectionData().owned_units or {}) do
			now += 1
		end
	end
	now = 0
	for _ in pairs(collectionData().owned_units or {}) do
		now += 1
	end
	if now > owned then
		Stats.summons += count
		return "Got " .. (now - owned) .. " unit" .. (now - owned == 1 and "" or "s")
	end
	return AA.lastMessage and tostring(AA.lastMessage):sub(1, 28) or "Nothing came back"
end

-- Celestial Compass: lock which Mythic the next Special-banner Mythic becomes.
function AA.compassStep()
	if Config.CompassPick == "" or itemCount("celestial_compass_u21") <= 0 then
		return
	end
	local pd = profile()
	if pd._celestial_compass_pick == Config.CompassPick then
		return
	end
	invoke("set_celestial_compass_pick", "celestial_compass_u21", Config.CompassPick)
end

-- Units: feed XP food, evolve when the items are there, reroll traits toward a target.
function AA.unitStep()
	local data = collectionData()
	local owned = data.owned_units or {}
	if Config.AutoFeed then
		local team = equippedUnits()
		local target = nil
		for _, entry in ipairs(team) do
			local unit = owned[entry.uuid]
			if unit and (not target or (unit.xp or 0) < (owned[target].xp or 0)) and unitStatsAt(entry.data, 0).dps > 0 then
				target = entry.uuid
			end
		end
		local food = {}
		local LevelUtil = findData("LevelUtilCore", "xp_items")
		for _, id in ipairs(LevelUtil and LevelUtil.xp_items or {}) do
			local n = itemCount(id)
			if n > 0 then
				food[id] = n
			end
		end
		if target and next(food) then
			invoke("level_up_feed", target, food)
		end
	end
	if Config.AutoEvolve then
		for uuid, unit in pairs(owned) do
			local unitData = Units[unit.unit_id]
			local recipe = unitData and unitData.evolve and unitData.evolve[unit.shiny and "shiny" or "normal"]
			if recipe then
				local ready = true
				for _, need in ipairs(recipe.item_requirement or {}) do
					if itemCount(need.item_id) < (need.amount or 1) then
						ready = false
					end
				end
				if ready and not (AA.evolveTried and AA.evolveTried[uuid] and os.clock() - AA.evolveTried[uuid] < 600) then
					AA.evolveTried = AA.evolveTried or {}
					AA.evolveTried[uuid] = os.clock()
					invoke("evolve_unit", uuid)
				end
			end
		end
	end
	if Config.AutoTrait and Config.TraitTarget ~= "" then
		-- Reroll the strongest equipped unit with trait tokens until it has the target trait.
		local best, bestPower = nil, 0
		for _, entry in ipairs(equippedUnits()) do
			local power = unitPower(entry.id, owned[entry.uuid])
			if power > bestPower then
				best, bestPower = entry.uuid, power
			end
		end
		local unit = best and owned[best]
		local has = unit ~= nil and AA.hasTrait(unit, Config.TraitTarget) or false
		for _, trait in pairs(unit and unit.traits or {}) do
			if trait == Config.TraitTarget then
				has = true
			end
		end
		if unit and not has and (profile().trait_reroll_tokens or 0) > 0 then
			status = "Rerolling traits"
			invoke("request_token_trait_reroll", best)
		end
	end
end

-- Shops: gold shop (XP food / Star Fruit for gold), Summer capsules with pearls, travelling merchant.
function AA.shopStep()
	if Config.BuyGoldShop then
		local ui = findData("GUIService", "gold_shop_ui")
		ui = ui and ui.gold_shop_ui
		local ok, items = pcall(function()
			return ui:_get_items_for_sale()
		end)
		if ok and type(items) == "table" then
			-- Star Fruit first (evolutions), then XP food, cheapest first.
			local list = {}
			for id, item in pairs(items) do
				if type(item) == "table" and item.gold_cost and (item.stock or 0) > 0 then
					table.insert(list, { id = item.id or id, cost = item.gold_cost, star = tostring(item.id):find("StarFruit") ~= nil })
				end
			end
			table.sort(list, function(x, y)
				if x.star ~= y.star then
					return x.star
				end
				return x.cost < y.cost
			end)
			for _, item in ipairs(list) do
				if currency("Gold") >= item.cost + Config.KeepGold then
					local before = currency("Gold")
					invoke("buy_gold_shop_item", item.id, 1)
					task.wait(0.5)
					if currency("Gold") == before then
						invoke("buy_gold_shop_item", item.id, "1")
					end
				end
			end
		end
	end
	-- Travelling merchant: buy the Star Fruits the team still needs for its evolutions, with gems.
	if Config.BuyEvolveFruit then
		local need = {}
		local data = collectionData()
		local owned = data.owned_units or {}
		for _, uuid in pairs(data.equipped_units or {}) do
			local unit = owned[uuid]
			local unitData = unit and Units[unit.unit_id]
			local recipe = unitData and type(unitData.evolve) == "table" and unitData.evolve[unit.shiny and "shiny" or "normal"]
			for _, item in ipairs(recipe and recipe.item_requirement or {}) do
				if tostring(item.item_id):find("StarFruit") then
					need[item.item_id] = math.max(need[item.item_id] or 0, (item.amount or 1) - itemCount(item.item_id))
				end
			end
		end
		local service = filtergc("table", { Keys = { "SELLING_ITEMS" } }, true)
		local bought = profile().bought_items or {}
		for uuid, item in pairs(service and service.SELLING_ITEMS or {}) do
			local id = type(item) == "table" and (item.id or item.item_id)
			local cost = type(item) == "table" and tonumber(item.gem_cost)
			if id and cost and (need[id] or 0) > 0 and not bought[uuid] and currency("Gems") >= cost + Config.KeepGems then
				status = "Buying " .. tostring(id)
				invoke("buy_travelling_merchant_item", uuid, "1")
				need[id] -= 1
				task.wait(0.6)
			end
		end
	end
	-- Merchant sniper: anything on the want list, the moment the merchant stocks it (gems or gold,
	-- both reserves kept). What he has been seen selling is remembered for the list in the menu.
	do
		local service = filtergc("table", { Keys = { "SELLING_ITEMS" } }, true)
		local wanted = {}
		for id in tostring(Config.MerchantWant):gmatch("[^,]+") do
			wanted[id] = true
		end
		local bought = profile().bought_items or {}
		AA.progress.merchantSeen = type(AA.progress.merchantSeen) == "table" and AA.progress.merchantSeen or {}
		for uuid, item in pairs(service and service.SELLING_ITEMS or {}) do
			local id = type(item) == "table" and (item.id or item.item_id)
			if id then
				if not AA.progress.merchantSeen[id] then
					AA.progress.merchantSeen[id] = true
					AA.progressDirty = true
				end
				local gems, gold = tonumber(item.gem_cost), tonumber(item.gold_cost)
				local affordable = (gems and currency("Gems") >= gems + Config.KeepGems) or (gold and currency("Gold") >= gold + Config.KeepGold)
				if wanted[id] and not bought[uuid] and affordable then
					status = "Buying " .. tostring(id)
					note("merchant", { id = id })
					invoke("buy_travelling_merchant_item", uuid, "1")
					task.wait(0.6)
				end
			end
		end
	end
	if Config.BuyCapsules and currency("SummerPearls") >= 150 + Config.KeepPearls then
		local n = math.floor((currency("SummerPearls") - Config.KeepPearls) / 150)
		if n >= 1 then
			status = "Buying Sunny Stars"
			invoke("buy_item_generic", "capsule_summer2", "event", "event_shop", tostring(math.min(n, 10)))
		end
	end
	if Config.OpenCapsules and itemCount("capsule_summer2") > 0 then
		status = "Opening Sunny Stars"
		invoke("use_item", "capsule_summer2")
	end
end

local function lobbyLoop()
	if not IS_LOBBY then
		while AA.alive do
			task.wait(2)
		end
		return
	end
	local lastClaim, lastJoin = -math.huge, -math.huge
	task.wait(1)
	while AA.alive do
		if Config.AutoEquipBest and not AA.joining then
			-- When the collection changes, or the next match favours other damage types.
			local count = 0
			for _ in pairs(collectionData().owned_units or {}) do
				count += 1
			end
			local id, _, kind, group = chooseTarget()
			local mods = id and AA.typeMods(id, kind, group) or {}
			local signature = ""
			for damageType, factor in pairs(mods) do
				signature ..= damageType .. string.format("%.2f", factor)
			end
			if count ~= AA.lastUnitCount or signature ~= AA.lastTeamSignature then
				AA.lastUnitCount, AA.lastTeamSignature = count, signature
				equipBest()
			end
		end
		-- Joining goes first: the teleport countdown starts, and the chores below (claims,
		-- summons, shops) use the seconds it takes instead of delaying it.
		if Config.AutoJoin and not AA.joining and os.clock() - lastJoin > 5 then
			AA.joining = "busy"
			task.spawn(function()
				AA.joinWaited = false
				local ok, err = pcall(joinGame)
				setthreadidentity(8)
				if not ok then
					AA.errors.join = tostring(err)
				end
				-- Still here after a start request: the teleport didn't happen. A lobby server
				-- that keeps refusing gets swapped for a fresh one.
				if AA.joinWaited then
					AA.failedJoins = (AA.failedJoins or 0) + 1
					if AA.failedJoins >= 6 and AA.alive and Config.AutoJoin then
						status = "Lobby stuck: switching server"
						pcall(function()
							game:GetService("TeleportService"):Teleport(LOBBY_PLACE_ID, localPlayer)
						end)
						task.wait(20)
					end
				end
				lastJoin = os.clock()
				AA.joining = nil
			end)
		elseif not Config.AutoJoin and not AA.joining then
			status = "Idle"
		end
		if AA.joining ~= "busy" then
			if os.clock() - lastClaim > 120 then
				lastClaim = os.clock()
				pcall(claimRewards)
			end
			pcall(summonStep)
			pcall(AA.snipeStep)
			if os.clock() - (AA.lastUnitStep or 0) > 30 then
				AA.lastUnitStep = os.clock()
				pcall(AA.compassStep)
				pcall(AA.unitStep)
				pcall(AA.shopStep)
			end
			setthreadidentity(8)
		end
		task.wait(0.5)
	end
end


