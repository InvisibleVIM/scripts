				task.defer(function()
					if child.Parent == page then
						child.Parent = slot(page, child.AbsoluteSize.Y > 0 and child.AbsoluteSize.Y or 24)
					end
				end)
			end
		end)
		pages[name] = page
		table.insert(UI.order, name)
		return page
	end

	function UI.selectTab(name)
		for pageName, page in pairs(pages) do
			page.Visible = pageName == name
		end
		for buttonName, tabButton in pairs(tabButtons) do
			local active = buttonName == name
			tabButton.BackgroundColor3 = UI.roles.Main
			tabButton.BackgroundTransparency = active and 0 or 1
			tabButton.TextColor3 = active and UI.roles.Font or UI.roles.Muted
			tabButton.FontFace = active and CODE_BOLD or CODE_MEDIUM
			tabButton.UIStroke.Color = UI.roles.Outline
			tabButton.UIStroke.Transparency = active and 0 or 1
			local bar = tabButton:FindFirstChild("Bar")
			if bar then
				bar.BackgroundColor3 = UI.roles.Accent
				bar.Visible = active
			end
		end
		UI.activeTab = name
	end

	function UI.makeTab(name, order)
		local tabButton = create("TextButton", {
			Name = name,
			Size = UDim2.new(1, 0, 0, 38),
			BackgroundColor3 = UI.roles.Main,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			FontFace = CODE_MEDIUM,
			Text = name,
			TextSize = 15,
			TextColor3 = UI.roles.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			LayoutOrder = order or 0,
			Parent = tabBar,
		}, { create("UIPadding", { PaddingLeft = UDim.new(0, 18) }) })
		round(tabButton, 7)
		stroke(tabButton, "Outline")
		local bar = create("Frame", { Name = "Bar", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -10, 0.5, 0), Size = UDim2.fromOffset(3, 16), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, Visible = false, Parent = tabButton })
		round(bar, 2)
		tabButtons[name] = tabButton
		tabButton.MouseEnter:Connect(function()
			if UI.activeTab ~= name then
				tabButton.TextColor3 = UI.roles.Font
			end
		end)
		tabButton.MouseLeave:Connect(function()
			if UI.activeTab ~= name then
				tabButton.TextColor3 = UI.roles.Muted
			end
		end)
		tabButton.MouseButton1Click:Connect(function()
			UI.selectTab(name)
		end)
		return tabButton
	end

	-- Help text sits behind a "?" beside the control it explains and shows while the cursor is
	-- on it (a page of always-visible grey paragraphs was most of what made the menu hard to read).
	UI.lastRow = {}
	function UI.showTip(text)
		local tip = UI.tipFrame
		if not tip then
			tip = create("TextLabel", {
				Name = "PotentTip",
				Size = UDim2.fromOffset(280, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = UI.roles.Raised,
				BorderSizePixel = 0,
				FontFace = CODE,
				TextSize = 14,
				LineHeight = 1.15,
				TextColor3 = UI.roles.Font,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				Visible = false,
				ZIndex = 200,
				Parent = screenGui,
			}, {
				create("UICorner", { CornerRadius = UDim.new(0, 8) }),
				create("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
				create("UIStroke", { Color = UI.roles.Outline, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
			})
			UI.tipFrame = tip
		end
		if not text or text == "" then
			tip.Visible = false
			return
		end
		tip.Text = text
		local mouse = userInputService:GetMouseLocation()
		local view = screenGui.AbsoluteSize
		local x = mouse.X + 16
		if x + 290 > view.X then
			x = mouse.X - 296
		end
		tip.Position = UDim2.fromOffset(math.max(x, 4), math.clamp(mouse.Y + 18, 4, math.max(view.Y - math.max(tip.AbsoluteSize.Y, 140) - 4, 4)))
		tip.Visible = true
	end
	---Put a "?" on a row. `spot` = { position (UDim2, anchored at its right edge), row }.
	function UI.attachTip(spot, text)
		if spot.icon then
			spot.text = spot.text .. "\n\n" .. text
			return spot
		end
		spot.text = text
		local caption = spot.caption
		if caption then
			-- Leave room for the "?" at the end of the caption's line.
			caption.Size = UDim2.new(caption.Size.X.Scale, caption.Size.X.Offset - 24, caption.Size.Y.Scale, caption.Size.Y.Offset)
		end
		local icon = create("TextLabel", {
			Name = "Tip",
			AnchorPoint = Vector2.new(1, 0),
			Position = spot.position,
			Size = UDim2.fromOffset(18, 18),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			FontFace = CODE_BOLD,
			Text = "?",
			TextSize = 13,
			TextColor3 = UI.roles.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Active = true,
			ZIndex = 3,
			Parent = spot.row,
		}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		local ring = stroke(icon, "Outline")
		spot.icon = icon
		icon.MouseEnter:Connect(function()
			ring.Color = UI.roles.Accent
			icon.TextColor3 = UI.roles.Font
			UI.showTip(spot.text)
		end)
		icon.MouseMoved:Connect(function()
			UI.showTip(spot.text)
		end)
		icon.MouseLeave:Connect(function()
			ring.Color = UI.roles.Outline
			icon.TextColor3 = UI.roles.Muted
			UI.showTip(nil)
		end)
		return spot
	end
	---Builders call this so the hint that follows knows which row it explains.
	function UI.markRow(page, row, position, captionLabel)
		UI.lastRow[page] = { row = row, position = position, body = row.Parent, caption = captionLabel }
	end

	---A "name ........ value" line; returns the value label.
	function UI.kv(page, name)
