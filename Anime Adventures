---The anime the current map belongs to (nil in the lobby).
function Music.mapAnime()
	local data = Match and Match.levelData or {}
	local key = tostring(data.map or data.world or ""):lower()
	if key == "" then
		return nil
	end
	for _, pair in ipairs(ANIME_BY_MAP) do
		if key:find(pair[1], 1, true) then
			return pair[2]
		end
	end
	return nil
end

---Search Roblox's audio library. Returns { {id, name, artist, dur}, ... } (songs of a minute or more).
function Music.search(query, minLength)
	local list = {}
	local http = request or http_request
	if not http then
		return list
	end
	local ok, response = pcall(http, { Url = "https://apis.roblox.com/toolbox-service/v1/marketplace/3?limit=30&keyword=" .. httpService:UrlEncode(query), Method = "GET" })
	if not (ok and response and response.StatusCode == 200) then
		return list
	end
	local ids = {}
	for _, item in ipairs(httpService:JSONDecode(response.Body).data or {}) do
		table.insert(ids, tostring(item.id))
	end
	if #ids == 0 then
		return list
	end
	local ok2, details = pcall(http, { Url = "https://apis.roblox.com/toolbox-service/v1/items/details?assetIds=" .. table.concat(ids, ","), Method = "GET" })
	if not (ok2 and details and details.StatusCode == 200) then
		return list
	end
	for _, item in ipairs(httpService:JSONDecode(details.Body).data or {}) do
		local asset = item.asset or {}
		local length = tonumber(asset.duration) or 0
		if length >= (minLength or 60) then
			table.insert(list, {
				id = "rbxassetid://" .. tostring(asset.id),
				name = tostring(asset.name),
				artist = asset.audioDetails and asset.audioDetails.artist or (item.creator and item.creator.name) or "",
				dur = length,
				votes = item.voting and tonumber(item.voting.upVotes) or 0,
			})
		end
	end
	return list
end

---Popularity = how many players favorited the track on Roblox (plus up-votes). Fetched once per
-- song and cached; lists are ordered most popular first.
function Music.rank(list)
	local http = request or http_request
	for _, song in ipairs(list) do
		local assetId = tostring(song.id):match("rbxassetid://(%d+)")
		if song.fav == nil and assetId and http then
			local ok, response = pcall(http, { Url = "https://catalog.roblox.com/v1/favorites/assets/" .. assetId .. "/count", Method = "GET" })
			if ok and response and response.StatusCode == 200 then
				song.fav = tonumber(response.Body) or 0
			elseif ok and response and response.StatusCode == 429 then
				task.wait(2)
			end
			task.wait(0.05)
		end
	end
	table.sort(list, function(x, y)
		local a, b = (x.fav or 0) + (x.votes or 0), (y.fav or 0) + (y.votes or 0)
		if a ~= b then
			return a > b
		end
		return tostring(x.name) < tostring(y.name)
	end)
	return list
end

---Songs for an anime: cached library search + your own files in music/<Anime>/.
function Music.localSongs(anime)
	local list = {}
	pcall(function()
		local folder = SETTINGS_FOLDER .. "/music/" .. anime
		if isfolder(folder) and getcustomasset then
			local files = listfiles(folder)
			table.sort(files)
			for _, path in ipairs(files) do
				local name = tostring(path):match("([^/\\]+)%.%w+$")
				if name then
					table.insert(list, { id = getcustomasset(path), name = name, artist = "", dur = 0, own = true })
				end
			end
		end
	end)
	return list
end

function Music.songsFor(anime, refresh)
	if not anime then
		return {}
	end
	if Config.MusicOwnOnly then
		-- Official tracks only: Roblox's library has no official anime songs (only covers and
		-- fan tracks), so in this mode the lists are just the files you put in music/<Anime>/.
		return Music.localSongs(anime)
	end
	if refresh or type(Music.library[anime]) ~= "table" then
		local found = Music.search(anime)
		if #found > 0 or type(Music.library[anime]) ~= "table" then
			Music.library[anime] = found
		end
	end
	local unranked = false
	for _, song in ipairs(Music.library[anime]) do
		unranked = unranked or song.fav == nil
	end
	if unranked or refresh then
		Music.rank(Music.library[anime])
		saveMusic()
	end
	local list = Music.localSongs(anime)
	for _, song in ipairs(Music.library[anime]) do
		table.insert(list, song)
	end
	return list
end

function Music.play(song)
	if not song then
		return
	end
	if not (Music.sound and Music.sound.Parent) then
		Music.sound = Instance.new("Sound")
		Music.sound.Name = "PotentMusic"
		Music.sound.Parent = game:GetService("SoundService")
	end
	Music.current = song
	Music.sound.SoundId = song.id
	Music.sound.Volume = Config.MusicVolume / 100
	Music.sound.TimePosition = 0
	Music.sound:Play()
	Music.startedAt = os.clock()
end

---Silence (or restore) the game's own music without touching its effects.
function Music.muteGame(muted)
	Music.muter = Music.muter or (AA.ui and AA.ui.makeMuter and AA.ui.makeMuter())
	if Music.muter then
		Music.muter(muted)
	end
end

function Music.next(step)
	local list = Music.playlist or {}
	if #list == 0 then
		return
	end
	Music.index = (Music.index - 1 + (step or 1)) % #list + 1
	Music.play(list[Music.index])
end

local function musicLoop()
	task.wait(4)
	local lastAnime, wasOn = false, false
	while AA.alive do
		if not Config.MusicOn then
			if wasOn then
				wasOn = false
				if Music.sound then
					Music.sound:Stop()
				end
				Music.muteGame(false)
			end
			Music.status = "Off"
		else
			wasOn = true
			Music.muteGame(Music.sound ~= nil and Music.sound.IsPlaying)
			local sound = Music.sound
			if sound then
				sound.Volume = Config.MusicVolume / 100
			end
			local ended = sound and sound.IsLoaded and not sound.IsPlaying and os.clock() - (Music.startedAt or 0) > 3
			local stuck = sound and not sound.IsLoaded and os.clock() - (Music.startedAt or 0) > 12
			if Config.MusicDefault then
				local anime = Music.mapAnime()
				if Music.ownMode ~= Config.MusicOwnOnly then
					Music.ownMode = Config.MusicOwnOnly
					lastAnime = false
				end
				if anime ~= lastAnime then
					lastAnime = anime
					if anime then
						Music.playlist = Music.songsFor(anime)
						Music.index = 0
						if #Music.playlist == 0 and Music.sound then
							Music.sound:Stop()
							Music.current = nil
						end
						Music.next(1)
					else
						Music.playlist = nil
					end
				elseif anime and (ended or stuck or not sound) then
					Music.next(1)
				end
				if not anime and Config.MusicSong ~= "" and (not sound or ended or stuck or (Music.current and Music.current.id ~= Config.MusicSong)) then
					Music.play({ id = Config.MusicSong, name = Config.MusicSongName })
				end
			else
				lastAnime = false
				if Config.MusicSong ~= "" and (not sound or ended or stuck or not Music.current or Music.current.id ~= Config.MusicSong) then
					Music.play({ id = Config.MusicSong, name = Config.MusicSongName })
				end
			end
			local current = Music.current
			Music.status = current and (tostring(current.name) .. ((current.artist and current.artist ~= "") and (" - " .. current.artist) or "")) or "Pick a song"
			if not current and Config.MusicOwnOnly and Config.MusicDefault and lastAnime then
				Music.status = "No files in music/" .. tostring(lastAnime)
			end
		end
		task.wait(1)
	end
end

supervise("music", musicLoop)
