				if kind == "castle" then
					return "Infinity Mansion room " .. tostring(id) .. " (" .. tostring(difficulty) .. ")", id
				elseif kind == "skip" then
					return "Skip " .. tostring(worldName(id)) .. " to Act 6", id
				elseif kind == "dungeon" or kind == "tournament" then
					return kind == "dungeon" and "Dungeon run" or "Tournament", id
				elseif not id then
					return kind == "raid" and "Waiting for a raid to open" or ((kind == "artifact" or kind == "locked") and "Locked: clear the story acts before it" or "Nothing open"), id
				end
				return level and (tostring(worldName(level.world) or "Portal") .. " " .. tostring(level.name) .. (difficulty and (" on " .. tostring(difficulty)) or "")) or tostring(id), id
			end
			table.insert(AA.connections, runService.RenderStepped:Connect(function(dt)
				local busy = Config.AutoJoin or (not IS_LOBBY and (Config.AutoPlace or Config.AutoUpgrade))
				if busy then
					mark.Rotation = (mark.Rotation + dt * 180) % 360
				end
				statusLabel.Text = (status == nil or status == "") and (busy and "Working" or "Idle") or status
				statusLabel.TextColor3 = busy and TEXT or MUTED
				elapsed += dt
				if elapsed < 0.5 then
					return
				end
				elapsed = 0
				local upcoming, id = nextText()
				view.target.Text = "Next: " .. upcoming
				local health, maxHealth = 0, 0
				local level = Match.levelId and Levels[Match.levelId]
				local stage = level and ((worldName(level.world) and (worldName(level.world) .. ", ") or "") .. tostring(level.name)) or tostring((Match.levelData or {}).name or matchKind())
				if not IS_LOBBY then
					health, maxHealth = baseHealth()
					local field = scanField()
					local buffers = AA.Conductor.report()
					view.match.Text = string.format("%s (%s%s)\nWave %d%s, cash %d, base %d of %d\n%d towers, %d summons, %d enemies", stage, matchKind(), (Match.levelData or {})._difficulty and (", " .. tostring(Match.levelData._difficulty)) or "", currentWave(), Match.totalWaves and (" of " .. Match.totalWaves) or "", stats.resource.Value, math.floor(health), math.floor(maxHealth), #field.towers, #field.summons, #field.enemies) .. (#buffers > 0 and ("\nBuff chain: " .. table.concat(buffers, ", ")) or "")
				else
					view.match.Text = "No match running. This fills in once one starts."
				end
				local pd = profile()
				local hours = math.max(os.time() - Stats.startedAt, 60) / 3600
				local session = AA.session()
				local cards = AA.CardBrain.view()
				local earned = not IS_LOBBY and AA.runEventCash() or nil
				do
					-- The strip: where it is and how the base is doing, or what comes next.
					local sub, healthFraction = "Next: " .. upcoming, nil
					local figures = { { string.format("%d - %d", session.wins, session.losses), "wins, losses" }, { tostring(Stats.gemRate or math.floor(Stats.gems / hours)), "gems an hour" } }
					if not IS_LOBBY then
						local total = Match.totalWaves
						sub = string.format("%s, wave %d%s, base %d%%", stage, currentWave(), total and (" of " .. total) or "", maxHealth > 0 and math.floor(health / maxHealth * 100 + 0.5) or 0)
						healthFraction = maxHealth > 0 and health / maxHealth or 0
						if cards then
							figures[2] = { string.format("x%.1f", 1 + (cards.mult or 0)), "pearl multiplier" }
						end
					elseif not Config.AutoJoin then
						sub = "Join matches is off. " .. sub
					end
					UI.setNow({ sub = sub, busy = busy, figures = figures, health = healthFraction })
				end
				-- (The game files Summer Hunt and the portals under "Raid": show what was picked.)
				view.mode.Text = Config.Mode == "Kills" and "Farm kills" or tostring(Config.Mode)
				view.map.Text = IS_LOBBY and upcoming or stage
				view.place.Text = IS_LOBBY and "Decided in the match" or (Match.pace == "speed" and "At the front, enemies are weak" or "Spread out, enemies are strong")
				view.tiles["Wins"].Text = tostring(session.wins)
				view.tiles["Losses"].Text = tostring(session.losses)
				view.tiles["Win rate"].Text = (session.wins + session.losses) > 0 and string.format("%d%%", math.floor(session.wins / (session.wins + session.losses) * 100 + 0.5)) or "None yet"
				view.tiles["Runs"].Text = tostring(session.runs)
				view.time.Text = AA.clock(session.seconds)
				view.gems.Text = string.format("%d in %d matches", session.gems, Stats.rateMatches or 0)
				view.rate.Text = tostring(Stats.gemRate or math.floor(Stats.gems / hours))
				local half, daily = AA.challengeTimers()
				view.half.Text = (AA.challengeOpen() and "Open, next in " or "Done, next in ") .. AA.clock(half)
				view.daily.Text = (AA.dailyOpen() and "Open, resets in " or "Done, resets in ") .. AA.clock(daily)
				for _, entry in ipairs(AA.TRACKED) do
					local gained = session.items[entry[2]] or 0
					view.items[entry[1]].Text = (gained > 0 and "+" or "") .. tostring(gained)
				end
				local account = view.account
				account["Gems"].Text = tostring(stats:FindFirstChild("gem_amount") and stats.gem_amount.Value or pd.gem_amount)
				account["Gold"].Text = tostring(stats:FindFirstChild("gold_amount") and stats.gold_amount.Value or pd.gold_amount)
				account["Level XP"].Text = tostring(stats:FindFirstChild("player_xp") and stats.player_xp.Value or pd.player_xp)
				account["Units placed"].Text = tostring(Stats.placed)
				account["Upgrades"].Text = tostring(Stats.upgrades)
				account["Summons"].Text = tostring(Stats.summons)
				account["Codes redeemed"].Text = tostring(Stats.codes)
				do
					local okTeam, problem = pcall(view.teamTick)
					if not okTeam then
						AA.errors.team = tostring(problem)
					end
				end
				do
					local okSnipe, _, target = pcall(AA.snipeFind)
					view.snipe.Text = okSnipe and target and (tostring(Units[target] and Units[target].name or target) .. " is featured right now.") or "None of them is featured right now."
				end
				view.summerMode.Text = Config.Mode == "Summer" and "Summer Hunt is the mode the script queues for." or ("The script queues for " .. (Config.Mode == "Kills" and "Farm kills" or tostring(Config.Mode)) .. " right now.")
				-- Cards.
				local tiles = view.cardTiles
				if cards then
					tiles["Pearl multiplier"].Text = string.format("x%.1f", 1 + (cards.mult or 0))
					tiles["Team strength"].Text = string.format("%d%%", math.floor((cards.stacked or 1) * 100 + 0.5))
					tiles["Clear chance"].Text = string.format("%d%%", math.floor((cards.clear or 0) * 100 + 0.5))
					view.cardLast.Text = cards.picked and cards.picked.title or (cards.why and "No vote" or "None yet")
					if cards.why then
						view.cardWhy.Text = cards.why .. "."
					end
				else
					tiles["Pearl multiplier"].Text, tiles["Team strength"].Text, tiles["Clear chance"].Text = "x1.0", "100%", "n/a"
					view.cardLast.Text = "None yet"
				end
				if earned and earned > 0 then
					local minutes = Match.startedAt and (os.clock() - Match.startedAt) / 60 or 0
					tiles["Pearls this run"].Text = minutes > 1 and string.format("%d", earned) or tostring(earned)
				else
					tiles["Pearls this run"].Text = "0"
				end
				-- Drops of the stage in play (or the next one).
				local dropKey = IS_LOBBY and tostring(id) or tostring(Match.levelId)
				if dropKey ~= UI.dropKey then
					UI.dropKey = dropKey
					local okDrops, text = pcall(AA.dropText, IS_LOBBY and id or Match.levelId, (not IS_LOBBY) and Match.levelData or nil)
					text = okDrops and text or "The drops could not be read."
					-- "Name: value" lines become rows, sentences stay small print.
					local rows = {}
					for line in tostring(text):gmatch("[^\n]+") do
						local name, value = line:match("^(.-): (.+)$")
						if line:sub(1, 2) == "# " then
							if #rows > 0 then
								table.insert(rows, { gap = true })
							end
							table.insert(rows, { title = line:sub(3) })
						elseif name and #name + #value <= 40 then
							table.insert(rows, { name = name, value = value })
						else
							table.insert(rows, { note = line })
						end
					end
					view.drops(rows)
				end
			end))
		end
	end, function(message)
		return tostring(message) .. "\n" .. debug.traceback()
	end)
	if not ok then
		AA.errors.menu = problem
		warn("[Anime Adventures] The menu could not be built: " .. tostring(problem))
		pcall(function()
			UI.screenGui.Parent = UI.guiParent
		end)
	end
end


-- Autosave whenever a setting changes.
do
	local lastSaved = encodeSettings()
	local elapsed = 0
	table.insert(AA.connections, runService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.5 then
			return
		end
		elapsed = 0
		local encoded = encodeSettings()
		if encoded ~= lastSaved then
			lastSaved = encoded
			saveSettings()
		end
	end))
end

function AA.detach()
	AA.alive = false
	saveSettings()
	for _, connection in ipairs(AA.connections) do
		connection:Disconnect()
	end
	if AA.gui then
		AA.gui:Destroy()
	end
	pcall(function()
		AA.Music.muteGame(false)
		if AA.Music.sound then
			AA.Music.sound:Destroy()
		end
	end)
	if shared.AnimeAdventures == AA then
		shared.AnimeAdventures = nil
	end
end

