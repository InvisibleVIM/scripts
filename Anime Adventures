		local function pickMany(page, text, key, options, note, clearText)
			local function picked()
				local set, list = {}, {}
				for id in tostring(Config[key]):gmatch("[^,]+") do
					set[id] = true
					table.insert(list, id)
				end
				return set, list
			end
			return cycler(page, text, function()
				local set = picked()
				local rows = {}
				for _, option in ipairs(options()) do
					table.insert(rows, { id = option.id, sort = tostring(option.name), name = (set[option.id] and "On   " or "       ") .. tostring(option.name), current = set[option.id] })
				end
				table.sort(rows, function(a, b)
					return a.sort < b.sort
				end)
				table.insert(rows, 1, { id = "", name = clearText or "Clear the list" })
				return rows
			end, function()
				local _, list = picked()
				local names = {}
				for _, id in ipairs(list) do
					table.insert(names, tostring(Units[id] and Units[id].name or id))
				end
				return #names == 0 and "None" or table.concat(names, ", ")
			end, function(option)
				if option.id == "" then
					Config[key] = ""
					return
				end
				local _, list = picked()
				local found = table.find(list, option.id)
				if found then
					table.remove(list, found)
