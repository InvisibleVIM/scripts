		-- Teleport page (lobby): every NPC and every place, read from the live lobby so new ones show up.
		if IS_LOBBY then
			local page = makePage("Teleport", "Stand next to any place or character in the lobby.", "Menu")
			-- What each NPC is for (from their dialogue options); unlisted ones are just scenery.
			local ROLES = {
				beerus = "stat reroll", whis = "trait reroll", gogeta = "limit break", alluka = "transfer stats/traits",
				chrollo = "remove shiny", escanor = "storage", gilgamesh = "craft relics", happy = "gift shop",
				netero = "level rewards", all_might = "trophy shop", zoro = "daily missions", missionsnpc = "missions",
				hakari_npc = "treasure trades", frieren_npc = "artifact stage", meliodas_npc = "guild ticket",
				erwin_npc = "guild event", zeno = "tournament", gojo = "training", muzan = "Infinity Mansion door",
				nakime = "enter mansion", kakashi = "banner info", bulma = "summer info", bulma_summer_npc = "summer merchant",
				speedwagon_summer_npc = "summer bingo", sukuna = "token powers", gojo_eyes = "Peerless Eyes",
				aizen = "Soul Orb", hogyoku = "sacrifice units", griffith_npc = "sacrifice units",
			}
			local function standAt(position, lookAt)
				local character = localPlayer.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if not root then
					return "No character"
				end
				if humanoid and humanoid.SeatPart then
					humanoid.Sit = false
					task.wait(0.1)
				end
				local target = position + Vector3.new(0, 3, 0)
				local flat = lookAt and Vector3.new(lookAt.X, target.Y, lookAt.Z)
				character:PivotTo(flat and (flat - target).Magnitude > 0.5 and CFrame.lookAt(target, flat) or CFrame.new(target))
				root.AssemblyLinearVelocity = Vector3.zero
				return "Teleported"
			end
			local function partOf(instance)
				if not instance then
					return nil
				end
				if instance:IsA("BasePart") then
					return instance
				end
				return (instance:IsA("Model") and instance.PrimaryPart) or instance:FindFirstChildWhichIsA("BasePart", true)
			end
			---Next to an NPC, on its front side, facing it.
			local function goToNpc(model)
				local root = model and (model:FindFirstChild("HumanoidRootPart") or partOf(model))
				if not root or not model.Parent then
					return "Not here right now"
				end
				local front = root.CFrame.LookVector
				front = Vector3.new(front.X, 0, front.Z)
				front = front.Magnitude > 0.1 and front.Unit or Vector3.new(0, 0, -1)
				-- Muzo stands in the middle of the mansion's teleport pad: stop short of it.
				local distance = model.Name == "muzan" and 9 or 5
				return standAt(root.Position + front * distance - Vector3.new(0, 2, 0), root.Position)
			end
			local function region(position)
				if math.abs(position.X) < 2000 and math.abs(position.Z) < 1500 and position.Y > 100 then
					return "lobby"
				end
				return "far"
			end

			local npcFolder = workspace:FindFirstChild("_npcs")
			local services, others, away = {}, {}, {}
			for _, model in ipairs(npcFolder and npcFolder:GetChildren() or {}) do
				local root = model:FindFirstChild("HumanoidRootPart") or partOf(model)
				if root then
					local prompt = root:FindFirstChildWhichIsA("ProximityPrompt", true) or model:FindFirstChildWhichIsA("ProximityPrompt", true)
					local name = prompt and prompt.ObjectText ~= "" and prompt.ObjectText or model.Name
					local role = ROLES[model.Name]
					local entry = { model = model, name = name, label = role and (name .. ": " .. role) or name }
					if region(root.Position) == "far" then
						table.insert(away, entry)
					elseif role then
						table.insert(services, entry)
					else
						table.insert(others, entry)
					end
				end
			end
			local function listNpcs(title, list, side)
				if #list == 0 then
					return
				end
				table.sort(list, function(x, y)
					return x.label < y.label
				end)
				heading(page, title, side)
				for _, entry in ipairs(list) do
					button(page, entry.label, function()
						return goToNpc(entry.model)
					end)
				end
			end

			-- Places: the game's own teleport pads where it has them, else the area's landing part.
			local function child(...)
				local node = workspace
				for _, name in ipairs({ ... }) do
					node = node and node:FindFirstChild(name)
				end
				return node
			end
			local PLACES = {
				{ "Play (story / infinite)", { "_teleports", "play" } },
				{ "Raids", { "_teleports", "raid" } },
				{ "Challenges", { "_teleports", "challenges" } },
				{ "Summon banners", { "_teleports", "summon" } },
				{ "Evolve machine", { "evolvemachine" }, 6 },
				{ "Trait reroll", { "_traits", "entrance" } },
				{ "Limit break", { "_limitbreak", "entrance" } },
				{ "Gold shop", { "_goldshop", "area" } },
				{ "Travelling merchant", { "travelling_merchant", "stand" }, 6 },
				{ "Codes", { "_codes", "area" } },
				{ "Missions board", { "_MISSIONS" }, 6 },
				{ "Artifacts", { "_artifacts", "billboard" }, 6 },
				{ "Tournament", { "_teleports", "tournament" } },
				{ "Leaderboards", { "_LEADERBOARDS_", "boards" }, 8 },
				{ "Guild area", { "_guildstuff", "Notice Board - City" }, 6 },
				{ "Dragon (Shenro)", { "_teleports", "shenron" } },
				{ "Time machine", { "_timemachinearea" }, 4 },
				{ "Dungeons", { "_DUNGEONS", "Lobbies" }, 8 },
				{ "Summer event dock", { "_teleports", "event" } },
			}
			local FAR = {
				{ "Summer ship", { "enel_ship", "_teleport" } },
				{ "Event challenges", { "_EVENT_CHALLENGES", "entrance" } },
				{ "Infinity Mansion", { "_infinity_castle", "entrance" } },
				{ "Illusionist's throne", { "_aizenarea", "entrance" } },
				{ "Paradox's domain", { "_gojodomain", "entrance" } },
				{ "Cursed Lord's domain", { "_sukunadomain", "entrance" } },
				{ "Eclipse", { "eclipse", "entrance" } },
			}
			local function listPlaces(title, list, side)
				local any = false
				for _, place in ipairs(list) do
					if partOf(child(table.unpack(place[2]))) then
						if not any then
							heading(page, title, side)
							any = true
						end
						button(page, place[1], function()
							local part = partOf(child(table.unpack(place[2])))
							if not part then
								return "Not here right now"
							end
							local position = part.Position
							if place[3] then
								-- Solid things (machines, boards): stand in front, towards the lobby spawn.
								local spawn = Vector3.new(254, position.Y, -527)
								local offset = spawn - position
								offset = Vector3.new(offset.X, 0, offset.Z)
								position += (offset.Magnitude > 1 and offset.Unit or Vector3.new(0, 0, 1)) * place[3]
							end
							return standAt(position, part.Position)
						end)
					end
				end
			end

			listPlaces("Places", PLACES, "left")
			listNpcs("Shops and services", services, "right")
			listPlaces("Other areas", FAR, "left")
