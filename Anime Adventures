	end
	local CODE = Font.new(Type.family, Enum.FontWeight.Regular)
	local CODE_MEDIUM = Font.new(Type.family, Enum.FontWeight.Medium)
	local CODE_BOLD = Font.new(Type.family, Enum.FontWeight.SemiBold)
