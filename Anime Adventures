---Visuals: show different stat grades on your own units. Display only: the server keeps the real
---stats, nothing here changes how a unit fights, and no other player sees it.
---The game's own rules (TraitServiceCore.calculate_stat_rank): every unit rolls Damage between
----10% and +20%, Cooldown and Range between -5% and +10%; the letter is where the roll sits in
---that span (S- from 90% of it, S 92.5%, S+ 95%, SS 97.5%, SSS only at the very top).
AA.Visual = {
	STATS = {
		-- max = the top of a normal roll (from the game's code). over = how far SSS may be typed
		-- above it: units above the roll cap exist (a user screenshot shows SSS at +27.0% damage
		-- and +10.9% cooldown, and the game calls anything at or over the cap SSS), but the
		-- client holds no rule for how they get there or where it stops. 30% is the figure the
		-- user had heard; 15% for the other two keeps the same 2:1 ratio. Not from game code.
		{ key = "potency_stat", name = "Damage", min = 0.9, max = 1.2, over = 1.3, seen = "+27.0%" },
		{ key = "speed_stat", name = "Cooldown", min = 0.95, max = 1.1, over = 1.15, seen = "+10.9%" },
		{ key = "range_stat", name = "Range", min = 0.95, max = 1.1, over = 1.15, seen = "none above +10%" },
	},
	GRADES = { "C-", "C", "C+", "B-", "B", "B+", "A-", "A", "A+", "S-", "S", "S+", "SS", "SSS" },
	FROM = { 0, 1 / 9, 2 / 9, 1 / 3, 4 / 9, 5 / 9, 2 / 3, 2 / 3 + 0.7 / 9, 2 / 3 + 1.4 / 9, 0.9, 0.925, 0.95, 0.975, 1 },
	FILE = SETTINGS_FOLDER .. "/visuals.json",
	saved = {}, -- [uuid] = { potency_stat = 1.2, ... } what to show
	orig = {}, -- [uuid] = the real trait stats
	wrote = {}, -- [uuid][stat] = the last value this script put into the profile copy
}
do
	local Visual = AA.Visual
	function Visual.stat(key)
		for _, stat in ipairs(Visual.STATS) do
			if stat.key == key then
				return stat
			end
		end
	end
	---The letter for a value of a stat.
	function Visual.grade(stat, value)
		if value >= stat.max - 1e-9 then
			return "SSS", #Visual.GRADES
		end
		local fraction = (value - stat.min) / (stat.max - stat.min)
		local index = 1
		for i = 1, #Visual.GRADES - 1 do
			if fraction >= Visual.FROM[i] - 1e-9 then
				index = i
			end
		end
		return Visual.GRADES[index], index
	end
	---The lowest and highest value a letter covers (SSS is one exact value: the cap).
	function Visual.gradeSpan(stat, grade)
		local index = table.find(Visual.GRADES, grade) or #Visual.GRADES
		if index == #Visual.GRADES then
			return stat.max, stat.over or stat.max
		end
		local span = stat.max - stat.min
		local low = stat.min + span * Visual.FROM[index]
		local high = stat.min + span * Visual.FROM[index + 1] - 0.0001
		return low, math.max(high, low)
	end
	function Visual.percent(value)
		return (value - 1) * 100
	end
	---What a shown number is multiplied by when a stat goes from its real value to the picked
	---one. The game's own formulas (calculate_total_stat_multiplier): damage x potency,
	---range x range stat, cooldown x (1 - (speed - 1)).
	function Visual.ratio(key, real, want)
		if key == "speed_stat" then
			return math.max(2 - want, 0.01) / math.max(2 - real, 0.01)
		end
		return want / math.max(real, 0.01)
	end
	---The unit's lobby companion (the model that follows you; its hover card has the numbers).
	function Visual.pet(uuid)
		local character = workspace:FindFirstChild(localPlayer.Name)
		local folder = character and character:FindFirstChild("_pets_folder")
		return folder and folder:FindFirstChild(uuid) or nil
	end
	Visual.PET = { potency_stat = "_pet_damage", speed_stat = "_pet_cooldown", range_stat = "_pet_range" }
	function Visual.load()
		local ok, data = pcall(function()
			return httpService:JSONDecode(readfile(Visual.FILE))
		end)
		if ok and type(data) == "table" then
			Visual.saved = type(data.saved) == "table" and data.saved or {}
			Visual.orig = type(data.orig) == "table" and data.orig or {}
			-- After a reload the profile copy still holds what the last run wrote. Without this
			-- that shown value was taken for the real one the next time a stat was changed.
			for uuid, shown in pairs(Visual.saved) do
				Visual.wrote[uuid] = type(shown) == "table" and table.clone(shown) or {}
			end
		end
	end
	function Visual.save()
		pcall(function()
			if not isfolder(SETTINGS_FOLDER) then
				makefolder(SETTINGS_FOLDER)
			end
			writefile(Visual.FILE, httpService:JSONEncode({ saved = Visual.saved, orig = Visual.orig }))
		end)
	end
	---Owned units for the picker: equipped first (by slot), then the rest by name.
	function Visual.units()
		local list = {}
		for uuid, unit in pairs(collectionData().owned_units or {}) do
			if type(unit) == "table" and type(unit.trait_stats) == "table" then
				local data = Units[unit.unit_id]
				table.insert(list, { uuid = tostring(unit.uuid or uuid), record = unit, id = unit.unit_id, name = tostring(data and data.name or unit.unit_id), slot = tonumber(unit.equipped_slot), shiny = unit.shiny == true })
			end
		end
		table.sort(list, function(a, b)
			if (a.slot ~= nil) ~= (b.slot ~= nil) then
				return a.slot ~= nil
			end
			if a.slot and b.slot and a.slot ~= b.slot then
				return a.slot < b.slot
			end
			if a.name ~= b.name then
				return a.name < b.name
			end
			return a.uuid < b.uuid
		end)
		local seen = {}
		for _, entry in ipairs(list) do
			local label = (entry.slot and ("[" .. entry.slot .. "] ") or "") .. entry.name .. (entry.shiny and " (shiny)" or "")
			seen[label] = (seen[label] or 0) + 1
			entry.label = seen[label] > 1 and (label .. " #" .. seen[label]) or label
		end
		return list
	end
	---The real value of a unit's stat (what the server has), whatever is being shown.
	function Visual.real(uuid, record, key)
		local orig = Visual.orig[uuid]
		if orig and orig[key] then
			return orig[key]
		end
		return record.trait_stats[key]
	end
	---Shows the picked values: in the profile copy every menu reads (inventory, unit info, trade
	---and reroll windows) and on the unit's copies standing in a match (letters, percent, and
	---damage / range / cooldown scaled by the same ratio). Runs every half second, because the
	---server keeps sending the real numbers.
	---The card over a placed unit: the game writes the letters once, when the unit spawns (with the
	---real rolls), and only keeps the numbers current. Has the game write them again.
	function Visual.restyle(unit, stats)
		local goal = stats:FindFirstChild("formation_goal")
		local over = goal and typeof(goal.Value) == "Instance" and goal.Value:FindFirstChild("_overhead")
		local frames = over and over:FindFirstChild("OverFrame") and over.OverFrame:FindFirstChild("Stats")
		if not (frames and frames:FindFirstChild("Attack") and frames:FindFirstChild("Range") and frames:FindFirstChild("Cooldown")) then
			return false
		end
		if not Visual.styler and os.clock() >= (Visual.stylerRetry or 0) then
			Visual.stylerRetry = os.clock() + 20
			local ok, found = pcall(function()
				return filtergc("function", { Name = "apply_trait_stat_ranking_color" }, false)
			end)
			Visual.styler = ok and type(found) == "table" and found[1] or nil
		end
		local potency, speed, range = unit:GetAttribute("potency_stat"), unit:GetAttribute("speed_stat"), unit:GetAttribute("range_stat")
		if not (Visual.styler and potency and speed and range) then
			return false
		end
		gameCall(Visual.styler, frames, stats.id.Value, potency, speed, range)
		return true
	end
	function Visual.apply()
		local owned = collectionData().owned_units or {}
		for uuid, shown in pairs(Visual.saved) do
			local record
			for key, unit in pairs(owned) do
				if type(unit) == "table" and tostring(unit.uuid or key) == uuid then
					record = unit
				end
			end
			if record and type(record.trait_stats) == "table" then
				Visual.orig[uuid] = Visual.orig[uuid] or {}
				for _, stat in ipairs(Visual.STATS) do
					local want = shown[stat.key]
					if want then
						local now = record.trait_stats[stat.key]
						if now ~= want then
							-- (A value we didn't write ourselves is the real one: the first time,
							-- or after the server sent the profile again, or after a reroll.)
							Visual.wrote[uuid] = Visual.wrote[uuid] or {}
							if now ~= nil and now ~= Visual.wrote[uuid][stat.key] then
								Visual.orig[uuid][stat.key] = now
								Visual.origDirty = true
							end
							record.trait_stats[stat.key] = want
							Visual.wrote[uuid][stat.key] = want
						end
					end
				end
			end
		end
		if Visual.origDirty then
			-- (A real reroll seen while a shown value was on: kept, or the next reload went
			-- back to the old roll.)
			Visual.origDirty = nil
			pcall(Visual.save)
		end
		-- The companions in the lobby carry their own copy of the numbers (hover card).
		for uuid, shown in pairs(Visual.saved) do
			local pet = Visual.pet(uuid)
			local orig = Visual.orig[uuid]
			if pet and orig then
				for _, stat in ipairs(Visual.STATS) do
					local want, real = shown[stat.key], orig[stat.key]
					local attribute = Visual.PET[stat.key]
					local now = pet:GetAttribute(attribute)
					if want and real and type(now) == "number" then
						local actual = pet:GetAttribute("AAReal" .. attribute)
						if actual == nil or now ~= pet:GetAttribute("AAShown" .. attribute) then
							actual = now -- the server's number
							pet:SetAttribute("AAReal" .. attribute, actual)
						end
						local value = actual * Visual.ratio(stat.key, real, want)
						if now ~= value then
							pet:SetAttribute(attribute, value)
						end
						if pet:GetAttribute("AAShown" .. attribute) ~= value then
							pet:SetAttribute("AAShown" .. attribute, value)
						end
						if pet:GetAttribute("_pet_" .. stat.key) ~= want then
							pet:SetAttribute("_pet_" .. stat.key, want)
						end
					end
				end
			end
		end
		if IS_LOBBY then
			return
		end
		local folder = workspace:FindFirstChild("_UNITS")
		for _, unit in ipairs(folder and folder:GetChildren() or {}) do
			local stats = unit:FindFirstChild("_stats")
			local owner, uuidValue = stats and stats:FindFirstChild("player"), stats and stats:FindFirstChild("uuid")
			local shown = owner and owner.Value == localPlayer and uuidValue and Visual.saved[tostring(uuidValue.Value)]
			if shown then
				local orig = Visual.orig[tostring(uuidValue.Value)] or {}
				local function show(object, factor)
					if not object then
						return
					end
					local real = object:GetAttribute("AAReal")
					if real == nil or object.Value ~= object:GetAttribute("AAShown") then
						real = object.Value -- the server sent a new number
						object:SetAttribute("AAReal", real)
					end
					if object.Value ~= real * factor then
						object.Value = real * factor
					end
					if object:GetAttribute("AAShown") ~= object.Value then
						object:SetAttribute("AAShown", object.Value)
					end
				end
				for _, stat in ipairs(Visual.STATS) do
					local want, real = shown[stat.key], orig[stat.key]
					local holder = stats:FindFirstChild(stat.key)
					if want and real and real > 0 then
						if holder and holder.Value ~= want then
							holder.Value = want
						end
						if unit:GetAttribute(stat.key) ~= nil and unit:GetAttribute(stat.key) ~= want then
							unit:SetAttribute(stat.key, want)
						end
						local ratio = Visual.ratio(stat.key, real, want)
						if stat.key == "potency_stat" then
							show(stats:FindFirstChild("damage"), ratio)
							show(stats:FindFirstChild("base_damage"), ratio)
						elseif stat.key == "range_stat" then
							show(stats:FindFirstChild("range"), ratio)
							show(stats:FindFirstChild("base_range"), ratio)
						else
							show(stats:FindFirstChild("attack_cooldown"), ratio)
							show(stats:FindFirstChild("base_attack_cooldown"), ratio)
						end
					end
				end
				local styled = ("%s|%s|%s"):format(tostring(unit:GetAttribute("potency_stat")), tostring(unit:GetAttribute("speed_stat")), tostring(unit:GetAttribute("range_stat")))
				if unit:GetAttribute("AAStyled") ~= styled and Visual.restyle(unit, stats) then
					unit:SetAttribute("AAStyled", styled)
				end
			end
		end
	end
	---Back to the real stats for one unit.
	function Visual.reset(uuid)
		local orig = Visual.orig[uuid]
		for key, unit in pairs(collectionData().owned_units or {}) do
			if type(unit) == "table" and tostring(unit.uuid or key) == uuid and orig and type(unit.trait_stats) == "table" then
				for statKey, value in pairs(orig) do
					unit.trait_stats[statKey] = value
				end
			end
		end
		local pet = Visual.pet(uuid)
		if pet then
			for _, attribute in pairs(Visual.PET) do
				local actual = pet:GetAttribute("AAReal" .. attribute)
				if actual ~= nil then
					pet:SetAttribute(attribute, actual)
				end
				pet:SetAttribute("AAReal" .. attribute, nil)
				pet:SetAttribute("AAShown" .. attribute, nil)
			end
			for statKey, value in pairs(orig or {}) do
				if pet:GetAttribute("_pet_" .. statKey) ~= nil then
					pet:SetAttribute("_pet_" .. statKey, value)
				end
			end
		end
		local folder = workspace:FindFirstChild("_UNITS")
		for _, unit in ipairs(not IS_LOBBY and folder and folder:GetChildren() or {}) do
			local stats = unit:FindFirstChild("_stats")
			local uuidValue = stats and stats:FindFirstChild("uuid")
			if uuidValue and tostring(uuidValue.Value) == uuid then
				for _, object in ipairs(stats:GetChildren()) do
					local real = object:GetAttribute("AAReal")
					if real ~= nil then
						if object.Value == object:GetAttribute("AAShown") then
							object.Value = real
						end
						object:SetAttribute("AAReal", nil)
						object:SetAttribute("AAShown", nil)
					end
				end
				for statKey, value in pairs(orig or {}) do
					local holder = stats:FindFirstChild(statKey)
					if holder then
						holder.Value = value
					end
					if unit:GetAttribute(statKey) ~= nil then
						unit:SetAttribute(statKey, value)
					end
				end
				if unit:GetAttribute("AAStyled") ~= nil then
					Visual.restyle(unit, stats)
					unit:SetAttribute("AAStyled", nil)
				end
			end
		end
		Visual.saved[uuid], Visual.orig[uuid] = nil, nil
		Visual.save()
	end
	Visual.load()
end

-- Visuals page.
do
	local Visual = AA.Visual
	local page = makePage("Visuals")
	local picked -- entry from Visual.units()
	local draft = {} -- [statKey] = { grade = "SSS", percent = 20 }
	local lines, boxes, letterRefresh = {}, {}, {}
	local statusLine
	local function entryFor(labelText)
		for _, entry in ipairs(Visual.units()) do
			if entry.label == labelText then
				return entry
			end
		end
	end
	local function describe(stat, value)
		return ("%s (%+.1f%%)"):format(Visual.grade(stat, value), Visual.percent(value))
	end
	local function showUnit()
		for _, stat in ipairs(Visual.STATS) do
			local line = lines[stat.key]
			if not picked then
				line.Text = stat.name .. ": pick a unit"
			else
				local real = Visual.real(picked.uuid, picked.record, stat.key) or 1
				local shown = Visual.saved[picked.uuid] and Visual.saved[picked.uuid][stat.key]
				local data = Units[picked.id]
				local base = data and unitStatsAt(data, 0) or {}
				local extra = ""
				local pick = draft[stat.key]
				local value = pick and (1 + pick.percent / 100) or shown or real
				-- The unit's own numbers when it is equipped (its companion carries them at its
				-- real level and trait), else the level 0 numbers from the unit sheet.
				local pet = Visual.pet(picked.uuid)
				local attribute = Visual.PET[stat.key]
				local actual = pet and (pet:GetAttribute("AAReal" .. attribute) or pet:GetAttribute(attribute))
				local label = actual and "Now" or "Level 0"
				if not actual then
					actual = stat.key == "potency_stat" and (base.damage or 0) * real or stat.key == "range_stat" and (base.range or 0) * real or (base.cooldown or 0) * (2 - real)
				end
				local after = actual * Visual.ratio(stat.key, real, value)
				if actual > 0 then
					if stat.key == "potency_stat" then
						extra = ("\n%s damage %s -> %s"):format(label, tostring(math.floor(actual + 0.5)), tostring(math.floor(after + 0.5)))
					elseif stat.key == "range_stat" then
						extra = ("\n%s range %.1f -> %.1f"):format(label, actual, after)
					else
						extra = ("\n%s cooldown %.2fs -> %.2fs"):format(label, actual, after)
					end
				end
				line.Text = ("%s: really %s%s%s"):format(stat.name, describe(stat, real), shown and (", showing " .. describe(stat, shown)) or "", extra)
			end
		end
	end
	heading(page, "Unit", "left")
	UI.dropdown(page, "Unit", function()
		local names = {}
		for _, entry in ipairs(Visual.units()) do
			table.insert(names, entry.label)
		end
		return names
	end, function()
		return picked and picked.label or "Pick a unit"
	end, function(option)
		picked = entryFor(option)
		draft = {}
		for _, stat in ipairs(Visual.STATS) do
			if boxes[stat.key] then
				boxes[stat.key].Text = ""
			end
		end
		showUnit()
	end)
	hint(page, "Your equipped units come first, by slot. Display only: this changes the letters and numbers you see on your own screen (inventory, unit info, in a match). The server keeps the real stats, the unit fights exactly as before, and other players, trades included, still see the real ones.")
	for _, stat in ipairs(Visual.STATS) do
		heading(page, stat.name, stat.key == "potency_stat" and "left" or "right")
		lines[stat.key] = infoLine(page, 44)
		lines[stat.key].Text = stat.name .. ": pick a unit"
		letterRefresh[stat.key] = UI.dropdown(page, "Show as", function()
			return Visual.GRADES
		end, function()
			return draft[stat.key] and draft[stat.key].grade or "--"
		end, function(option)
			local low, high = Visual.gradeSpan(stat, option)
			-- A letter starts at the top of its span (SSS at the normal roll cap).
			local start = option == "SSS" and stat.max or high
			draft[stat.key] = { grade = option, percent = math.floor(Visual.percent(start) * 100 + 0.5) / 100 }
			boxes[stat.key].Text = ("%.2f"):format(draft[stat.key].percent)
			showUnit()
		end)
		boxes[stat.key] = UI.textbox(page, "Exact %", "any number, e.g. 1000000")
		boxes[stat.key].FocusLost:Connect(function()
			local typed = tonumber((boxes[stat.key].Text:gsub("[%%+,%s]", "")))
			if typed and typed == typed then
				-- Any number goes (the user asked for no cap). Only held to what a number box can
				-- carry, and not under -100%: a stat can't go below nothing. The game works the
				-- letter out from the number, so the letter follows what was typed.
				typed = math.clamp(typed, -100, 1e12)
				draft[stat.key] = { grade = Visual.grade(stat, 1 + typed / 100), percent = typed }
				boxes[stat.key].Text = ("%.2f"):format(typed)
				letterRefresh[stat.key]()
				showUnit()
			end
		end)
		hint(page, ("Type any %% you like, a million included. In the real game a normal roll of %s stops at %+.0f%% (that is where SSS starts); the few units above it top out around %+.0f%% (highest seen: %s). Anything past that is for show only, and the letter always follows the number: at or above %+.0f%% reads SSS."):format(stat.name, Visual.percent(stat.max), Visual.percent(stat.over), stat.seen, Visual.percent(stat.max)))
	end
	heading(page, "Apply", "right")
	UI.buttonPair(page, "Apply", function()
		if not picked then
			statusLine.Text = "Pick a unit first"
			return
		end
		local any = false
		Visual.saved[picked.uuid] = Visual.saved[picked.uuid] or {}
		Visual.orig[picked.uuid] = Visual.orig[picked.uuid] or {}
		for _, stat in ipairs(Visual.STATS) do
			local pick = draft[stat.key]
			if pick then
				local value = 1 + pick.percent / 100
				if Visual.orig[picked.uuid][stat.key] == nil then
					Visual.orig[picked.uuid][stat.key] = Visual.real(picked.uuid, picked.record, stat.key)
				end
				Visual.saved[picked.uuid][stat.key] = value
				any = true
			end
		end
		if not any then
			statusLine.Text = "Pick a letter for at least one stat"
			return
		end
		Visual.save()
		pcall(Visual.apply)
		draft = {}
		for _, stat in ipairs(Visual.STATS) do
			if boxes[stat.key] then
				boxes[stat.key].Text = ""
			end
			if letterRefresh[stat.key] then
				letterRefresh[stat.key]()
			end
		end
		showUnit()
		statusLine.Text = "Showing the new stats on " .. picked.label .. ". Reopen a game window to see it there."
	end, "Reset unit", function()
		if not picked then
			statusLine.Text = "Pick a unit first"
			return
		end
		Visual.reset(picked.uuid)
		draft = {}
		for _, stat in ipairs(Visual.STATS) do
			if boxes[stat.key] then
				boxes[stat.key].Text = ""
			end
			if letterRefresh[stat.key] then
				letterRefresh[stat.key]()
			end
		end
		showUnit()
		statusLine.Text = picked.label .. " shows its real stats again."
	end)
	statusLine = infoLine(page, 40)
	statusLine.Text = "Nothing changed yet."
	task.spawn(function()
		while AA.alive do
			if next(Visual.saved) then
				pcall(Visual.apply)
			end
			task.wait(0.5)
		end
	end)
end

-- Macro page.
do
	local page = makePage("Macro")
	-- Build order: a list of steps made here, followed instead of the script's own choice.
	do
		local function nameOf(id)
			return tostring(Units[id] and Units[id].name or id)
		end
		local function teamIds()
			local ids = {}
			for _, entry in ipairs(equippedUnits()) do
				table.insert(ids, entry.id)
			end
			return ids
		end
		local listLine, setupLine
		local function showList()
			if not listLine then
				return
			end
			local steps = AA.Order.steps()
			local lines = {}
			local current = not IS_LOBBY and Config.OrderOn and Match.orderStep or nil
			for index, step in ipairs(steps) do
				if index > #steps - 14 then
					local text = step.kind == "place" and ("Place " .. nameOf(step.unit)) or ("Upgrade " .. nameOf(step.unit) .. " x" .. step.times)
					table.insert(lines, (index == current and "> " or "") .. index .. ". " .. text)
				end
			end
			if #steps > 14 then
				table.insert(lines, 1, "(" .. (#steps - 14) .. " earlier steps)")
			end
			listLine.Text = #steps == 0 and "No steps yet. The first step is always a placement." or table.concat(lines, "\n")
		end
		heading(page, "Build order", "left")
		toggle(page, "Follow my build order", "OrderOn")
		hint(page, "The script does exactly the next step on your list, saving up for it when it has to, and picks the spot itself. When the list is finished it carries on by its own judgement. Farm kills mode and a playing macro keep their own order.")
		segmented(page, "Placement", "OrderPlacement", { "Smart", "Front" })
		hint(page, "Smart: every unit on the best spot the script can find. Front: everything at the very start of the road. Saved with the setup.")
		segmented(page, "Next step", "OrderAddKind", { "Place", "Upgrade" })
		UI.dropdown(page, "Unit", function()
			local names = {}
			for _, id in ipairs(teamIds()) do
				table.insert(names, nameOf(id))
			end
			return names
		end, function()
			local ids = teamIds()
			if not table.find(ids, Config.OrderAddUnit) then
				Config.OrderAddUnit = ids[1] or ""
			end
			return Config.OrderAddUnit ~= "" and nameOf(Config.OrderAddUnit) or "--"
		end, function(option)
			for _, id in ipairs(teamIds()) do
				if nameOf(id) == option then
					Config.OrderAddUnit = id
				end
			end
		end)
		slider(page, "Upgrade how many times", "OrderAddTimes", 1, 10, 1, function(v)
			return tostring(v)
		end)
		button(page, "Add step", function()
			local steps = table.clone(AA.Order.steps())
			local unit = Config.OrderAddUnit
			if unit == "" then
				return "Pick a unit"
			end
			local kind = (#steps == 0 or Config.OrderAddKind ~= "Upgrade") and "place" or "upgrade"
			if kind == "upgrade" then
				local placed = false
				for _, step in ipairs(steps) do
					placed = placed or (step.kind == "place" and step.unit == unit)
				end
				if not placed then
					return "Place it first"
				end
			end
			table.insert(steps, { kind = kind, unit = unit, times = kind == "upgrade" and Config.OrderAddTimes or 1 })
			AA.Order.set(steps)
			showList()
			return "Added"
		end)
		UI.buttonPair(page, "Remove last", function()
			local steps = table.clone(AA.Order.steps())
			table.remove(steps)
			AA.Order.set(steps)
			showList()
		end, "Clear list", function()
			AA.Order.set({})
			showList()
		end)
		listLine = infoLine(page, 230)
		listLine.TextYAlignment = Enum.TextYAlignment.Top
		heading(page, "Saved setups", "left")
		local setupBox = UI.textbox(page, "Setup name", "e.g. daily front")
		setupBox.Text = tostring(Config.OrderName or "")
		UI.buttonPair(page, "Save setup", function()
			local name = setupBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
			if name == "" then
				setupLine.Text = "Name it first"
				return
			end
			local ok = AA.Order.save(name)
			Config.OrderName = ok and name or Config.OrderName
			setupLine.Text = ok and ("Saved " .. name .. " (" .. #AA.Order.steps() .. " steps, " .. Config.OrderPlacement .. " placement)") or "Could not save"
		end, "Delete setup", function()
			if Config.OrderName == "" then
				setupLine.Text = "Load one first"
				return
			end
			pcall(delfile, AA.Order.file(Config.OrderName))
			setupLine.Text = "Deleted " .. Config.OrderName
			Config.OrderName = ""
		end)
		UI.dropdown(page, "Load a setup", function()
			return AA.Order.list()
		end, function()
			return Config.OrderName ~= "" and Config.OrderName or "--"
		end, function(option)
			local ok = AA.Order.load(option)
			setupBox.Text = ok and option or setupBox.Text
			setupLine.Text = ok and ("Loaded " .. option .. " (" .. #AA.Order.steps() .. " steps, " .. Config.OrderPlacement .. " placement)") or "Could not load " .. tostring(option)
			showList()
			for _, refresh in ipairs(AA.segmentRefreshers) do
				pcall(refresh)
			end
		end)
		hint(page, "A setup is the whole list plus its placement style. Loading one replaces the list above.")
		setupLine = infoLine(page, 22)
		setupLine.Text = Config.OrderName ~= "" and ("Current: " .. Config.OrderName) or "Not saved yet"
		showList()
		task.spawn(function()
			while AA.alive do
				pcall(showList)
				task.wait(1)
			end
		end)
	end
	heading(page, "Record a macro", "right")
	local nameBox = UI.textbox(page, "Macro name", "e.g. daily shield")
	local recordLine
	button(page, "Start / stop recording", function()
		if AA.Macro.recording then
			local ok, count = AA.Macro.stop()
			if recordLine then
				recordLine.Text = ok and ("Saved " .. count .. " steps as " .. tostring(AA.Macro.recordName)) or "Nothing recorded"
			end
			return ok and "Saved" or "Empty"
		end
		local name = nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
		if name == "" then
			return "Name it first"
		end
		if IS_LOBBY then
			return "Start in a match"
		end
		AA.Macro.start(name)
		return "Recording"
	end)
	hint(page, "Records every placement, upgrade and sale in this match with its wave and exact spot, whoever makes it: you by hand or the script's own play. Units already out are saved as the opening. It saves by itself when the match ends.")
	recordLine = infoLine(page, 22)
	recordLine.Text = "Not recording"
	heading(page, "Play a macro", "right")
	UI.dropdown(page, "Macro", function()
		local names = AA.Macro.list()
		table.insert(names, 1, "None")
		return names
	end, function()
		return Config.MacroName ~= "" and Config.MacroName or "None"
	end, function(option)
		Config.MacroName = option == "None" and "" or option
	end)
	toggle(page, "Play this macro", "MacroPlay")
	hint(page, "Replaces the script's own placing and upgrading with the recorded steps, each waiting for its wave and for the cash. Buffs, targeting and cards still run. On other maps the script plays normally.")
	toggle(page, "Play it on any map", "MacroAnyMap")
	hint(page, "Spots are map positions: a macro from another map will mostly fail to place.")
	button(page, "Delete this macro", function()
		if Config.MacroName == "" then
			return "Pick one"
		end
		AA.Macro.delete(Config.MacroName)
		Config.MacroName = ""
		return "Deleted"
	end)
	task.spawn(function()
		while AA.alive do
			if recordLine and recordLine.Parent then
				if AA.Macro.recording then
					recordLine.Text = "Recording " .. tostring(AA.Macro.recordName) .. ": " .. #AA.Macro.steps .. " steps"
				elseif recordLine.Text:find("^Recording") then
					recordLine.Text = "Saved " .. #AA.Macro.steps .. " steps as " .. tostring(AA.Macro.recordName)
				end
			end
			task.wait(1)
		end
	end)
end

