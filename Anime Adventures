	---Pick-one drop-down for lists of option tables ({ ..., name =, current = }).
	function UI.cycler(page, text, getOptions, getLabel, onPick)
		local row = UI.rowBase(page, 54, false)
		UI.markRow(page, row, UDim2.new(1, 0, 0, 1), label({ Size = UDim2.new(1, 0, 0, 20), Text = text, Parent = row }))
		local box, value = valueBox(row, 24)
		local function refresh()
			value.Text = tostring(getLabel())
		end
		local list, fill = optionList(row, function(option)
			onPick(option)
			refresh()
		end)
		box.MouseButton1Click:Connect(function()
			list.Visible = not list.Visible
			if list.Visible then
				local entries = {}
				for _, option in ipairs(getOptions()) do
					local name = option.name or option.label or option.id or option.uid or option.slot
					table.insert(entries, { text = (name == "" or name == nil) and "--" or name, value = option, current = option.current })
				end
				fill(entries)
			end
		end)
		table.insert(UI.refreshers, refresh)
		refresh()
		return refresh
	end

	---Shared look and press feedback of every push button.
	local function pushButton(props, text, action)
		props.BackgroundColor3 = UI.roles.Control
		props.BorderSizePixel = 0
		props.FontFace = CODE_MEDIUM
		props.Text = text
		props.TextSize = TEXT_SIZE
		props.TextColor3 = UI.roles.Font
		props.AutoButtonColor = false
		local buttonFrame = create("TextButton", props)
		round(buttonFrame, 7)
		local outline = stroke(buttonFrame, "Outline")
		buttonFrame.MouseEnter:Connect(function()
			buttonFrame.BackgroundColor3 = UI.roles.Raised
			outline.Color = UI.roles.Muted
		end)
		buttonFrame.MouseLeave:Connect(function()
			buttonFrame.BackgroundColor3 = UI.roles.Control
			outline.Color = UI.roles.Outline
		end)
		buttonFrame.MouseButton1Click:Connect(function()
			if not action then
				return
			end
			task.spawn(function()
				buttonFrame.Text = "Working"
				local ok, message = pcall(action)
				pcall(function()
					buttonFrame.Text = (ok and message) and tostring(message) or text
				end)
				task.wait(1.5)
				pcall(function()
					buttonFrame.Text = text
				end)
			end)
		end)
		return buttonFrame
	end

	function UI.button(page, text, action)
		local made = pushButton({ Size = UDim2.new(1, 0, 0, 32), LayoutOrder = UI.nextOrder(), Parent = slot(page, 32) }, text, action)
		UI.lastRow[page] = nil
		return made
