-- Reachable from here on (the full detach near the end replaces this one): if anything further
-- down fails, the next load can still switch this copy off instead of running beside it.
function AA.detach()
	AA.alive = false
	for _, connection in ipairs(AA.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	if AA.gui then
		AA.gui:Destroy()
	end
	if shared.AnimeAdventures == AA then
		shared.AnimeAdventures = nil
	end
end
