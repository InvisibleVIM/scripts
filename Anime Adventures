		-- Visuals: show different stat grades on your own units. Display only.
		do
			local Visual = AA.Visual
			local page = makePage("Visuals", "Shows different stat letters and numbers on your own units. Only your screen changes: the server keeps the real stats, the unit fights as before, and other players and trades see the real ones.", "Account")
			local picked -- entry from Visual.units()
			local draft = {} -- [statKey] = { grade = "SSS", percent = 20 }
			local lines, boxes, letterRefresh = {}, {}, {}
			local statusLine
			local function entryFor(labelText)
				for _, entry in ipairs(Visual.units()) do
					if entry.label == labelText then
						return entry
					end
				end
			end
			local function describe(stat, value)
				return ("%s (%+.1f%%)"):format(Visual.grade(stat, value), Visual.percent(value))
			end
			local function showUnit()
				for _, stat in ipairs(Visual.STATS) do
					local line = lines[stat.key]
					if not picked then
						line.Text = "Pick a unit first."
					else
						local real = Visual.real(picked.uuid, picked.record, stat.key) or 1
						local shown = Visual.saved[picked.uuid] and Visual.saved[picked.uuid][stat.key]
						local data = Units[picked.id]
						local base = data and unitStatsAt(data, 0) or {}
						local extra = ""
						local pick = draft[stat.key]
						local value = pick and (1 + pick.percent / 100) or shown or real
						-- The unit's own numbers when it is equipped (its companion carries them at its
						-- real level and trait), else the level 0 numbers from the unit sheet.
						local pet = Visual.pet(picked.uuid)
						local attribute = Visual.PET[stat.key]
						local actual = pet and (pet:GetAttribute("AAReal" .. attribute) or pet:GetAttribute(attribute))
						local label = actual and "Now" or "At level 0"
						if not actual then
							actual = stat.key == "potency_stat" and (base.damage or 0) * real or stat.key == "range_stat" and (base.range or 0) * real or (base.cooldown or 0) * (2 - real)
						end
						local after = actual * Visual.ratio(stat.key, real, value)
						if actual > 0 then
							if stat.key == "potency_stat" then
								extra = ("\n%s: damage %s, shown as %s"):format(label, tostring(math.floor(actual + 0.5)), tostring(math.floor(after + 0.5)))
							elseif stat.key == "range_stat" then
								extra = ("\n%s: range %.1f, shown as %.1f"):format(label, actual, after)
							else
								extra = ("\n%s: cooldown %.2f s, shown as %.2f s"):format(label, actual, after)
							end
						end
						line.Text = ("Real roll: %s%s%s"):format(describe(stat, real), shown and ("\nShowing: " .. describe(stat, shown)) or "", extra)
					end
				end
			end
			local function clearDraft()
				draft = {}
				for _, stat in ipairs(Visual.STATS) do
					if boxes[stat.key] then
						boxes[stat.key].Text = ""
					end
					if letterRefresh[stat.key] then
						letterRefresh[stat.key]()
					end
				end
				showUnit()
			end
			heading(page, "Unit", "left")
			UI.dropdown(page, "Unit", function()
				local names = {}
				for _, entry in ipairs(Visual.units()) do
					table.insert(names, entry.label)
				end
				return names
			end, function()
				return picked and picked.label or "Pick a unit"
			end, function(option)
				picked = entryFor(option)
				draft = {}
				for _, stat in ipairs(Visual.STATS) do
					if boxes[stat.key] then
						boxes[stat.key].Text = ""
					end
				end
				showUnit()
			end, "Equipped units come first, by slot.")
			UI.buttonPair(page, "Show these stats", function()
				if not picked then
					statusLine.Text = "Pick a unit first."
					return
				end
				local any = false
				Visual.saved[picked.uuid] = Visual.saved[picked.uuid] or {}
				Visual.orig[picked.uuid] = Visual.orig[picked.uuid] or {}
				for _, stat in ipairs(Visual.STATS) do
					local pick = draft[stat.key]
					if pick then
						local value = 1 + pick.percent / 100
						if Visual.orig[picked.uuid][stat.key] == nil then
							Visual.orig[picked.uuid][stat.key] = Visual.real(picked.uuid, picked.record, stat.key)
						end
						Visual.saved[picked.uuid][stat.key] = value
						any = true
					end
				end
				if not any then
					statusLine.Text = "Pick a letter or type a number for at least one stat."
					return
				end
				Visual.save()
				pcall(Visual.apply)
				clearDraft()
				statusLine.Text = "Showing the new stats on " .. picked.label .. ". Reopen a game window to see them there."
			end, "Back to the real stats", function()
				if not picked then
					statusLine.Text = "Pick a unit first."
					return
				end
				Visual.reset(picked.uuid)
				clearDraft()
				statusLine.Text = picked.label .. " shows its real stats again."
			end)
			statusLine = UI.note(page, "Nothing changed yet.")
			for index, stat in ipairs(Visual.STATS) do
				heading(page, stat.name, index == 3 and "left" or "right")
				lines[stat.key] = infoLine(page, 44)
				lines[stat.key].Text = "Pick a unit first."
				letterRefresh[stat.key] = UI.dropdown(page, "Show as", function()
					return Visual.GRADES
				end, function()
					return draft[stat.key] and draft[stat.key].grade or "No change"
				end, function(option)
					local low, high = Visual.gradeSpan(stat, option)
					-- A letter starts at the top of its span (SSS at the normal roll cap).
					local start = option == "SSS" and stat.max or high
					draft[stat.key] = { grade = option, percent = math.floor(Visual.percent(start) * 100 + 0.5) / 100 }
					boxes[stat.key].Text = ("%.2f"):format(draft[stat.key].percent)
					showUnit()
				end)
				boxes[stat.key] = UI.textbox(page, "Or an exact %", "Any number")
				boxes[stat.key].FocusLost:Connect(function()
					local typed = tonumber((boxes[stat.key].Text:gsub("[%%+,%s]", "")))
					if typed and typed == typed then
						-- Any number goes (the user asked for no cap). Only held to what a number box can
						-- carry, and not under -100%: a stat can't go below nothing. The game works the
						-- letter out from the number, so the letter follows what was typed.
						typed = math.clamp(typed, -100, 1e12)
						draft[stat.key] = { grade = Visual.grade(stat, 1 + typed / 100), percent = typed }
						boxes[stat.key].Text = ("%.2f"):format(typed)
						letterRefresh[stat.key]()
						showUnit()
					end
				end)
				hint(page, ("In the real game a normal %s roll stops at %+.0f%%, which is where SSS starts; the few units above it top out around %+.0f%% (highest seen: %s). Anything past that is for show, and the letter always follows the number."):format(stat.name, Visual.percent(stat.max), Visual.percent(stat.over), stat.seen))
			end
			task.spawn(function()
				while AA.alive do
