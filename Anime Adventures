-- Card votes (Summer Hunt and the other roguelike events). Every few waves the server offers
-- cards: blessings ("Good") and curses ("Bad": something that hurts, plus a bigger pearl
-- multiplier for every wave still to come).
--
-- What the game pays (read from the level's own table and from the per-wave balance in 24 logged
-- Summer Hunt runs): a wave pays step(wave) x (1 + multiplier), where step is the level's
-- "infinite_resource_rewards" row (Summer Hunt: nothing for waves 1-3, 5 a wave to wave 10, 10
-- after) and the multiplier is the sum of the curses taken. Clearing the last wave paid four
-- more waves' worth at the final multiplier in each of the four clears it could be measured on.
--
-- Every card gets two numbers: its power (what it does to my team's killing power, from my real
-- damage split and the effects already in play) and its pearls (what it adds to the multiplier).
-- From those the script projects the rest of the run: the chance to still be standing at each
-- wave and the pearls that pays. The three strategies read that projection differently:
--   Win       the card that keeps the clear most likely; a curse only when it costs next to nothing
--   Balanced  the most pearls among the cards that keep the clear likely
--   Pearls    a curse at every vote, the one worth the most pearls, unless it would end the run
-- The user's never list is applied before any of this and nothing overrides it.
do
local CardBrain = {}
AA.CardBrain = CardBrain
function CardBrain.state()
	local state = { share = {}, antiAir = false, spent = 0 }
	local total = 0
	for _, unit in ipairs(myUnits()) do
		local spent = unit._stats:FindFirstChild("total_spent")
		state.spent += spent and spent.Value or 0
		local id = unit._stats.id.Value
		local data = Units[id]
		state.buffer = state.buffer or (data ~= nil and AA.buffInfo(data) ~= nil)
		if data and (data.damage or 0) > 0 then
			-- Weight by what the tower is worth right now (damage counters miss summoners).
			local amount = math.max(copyPower(data, ownedOf(unit), unit._stats.upgrade.Value) * AA.measureFactor(id), 1)
			local types = gameCall(Core.Unit and Core.Unit.get_all_damage_types, data)
			if type(types) ~= "table" then
				types = { [data._base_damage_type or "physical"] = true }
			end
			for kind in pairs(types) do
				state.share[kind] = (state.share[kind] or 0) + amount
			end
			total += amount
			state.antiAir = state.antiAir or unit:GetAttribute("_on_hill") == true or false
		end
	end
	for kind, amount in pairs(state.share) do
		state.share[kind] = amount / math.max(total, 1)
	end
	-- Early in a match the field is not yet the team that carries the late waves: the first unit
	-- to be maxed owns most of the damage for a while (at wave 17 a maxed Zombie made the split
	-- 89% physical and Plated Enemies read as a heavy curse; with both Elyssias upgraded it is
	-- five sixths magic). The split is taken from the equipped team at full strength too, and the
	-- field takes over as its power grows towards that.
	local planned, plannedTotal = {}, 0
	for _, entry in ipairs(equippedUnits()) do
		-- (The same measure as the towers above, at max level and with every copy down.)
		local amount = (entry.data.damage or 0) > 0 and copyPower(entry.data, entry.unit, entry.data.upgrade and #entry.data.upgrade or 0) * AA.measureFactor(entry.id) * placeCap(entry.data) or 0
		state.buffer = state.buffer or AA.buffInfo(entry.data) ~= nil
		if amount > 0 then
			state.antiAir = state.antiAir or entry.data.hill_unit == true or entry.data.hybrid_placement == true
			local types = gameCall(Core.Unit and Core.Unit.get_all_damage_types, entry.data)
			if type(types) ~= "table" then
				types = { [entry.data._base_damage_type or "physical"] = true }
			end
			for kind in pairs(types) do
				planned[kind] = (planned[kind] or 0) + amount
			end
			plannedTotal += amount
		end
	end
	if plannedTotal > 0 then
		local onField = math.clamp(total / plannedTotal, 0, 1)
		for kind in pairs(planned) do
			state.share[kind] = state.share[kind] or 0
		end
		for kind, amount in pairs(state.share) do
			state.share[kind] = amount * onField + (planned[kind] or 0) / plannedTotal * (1 - onField)
		end
	elseif total == 0 then
		state.share.physical, state.share.magic = 0.5, 0.5
	end
	-- The server keeps one running total per effect (its list after every vote is keyed by
	-- effect and damage type, amounts added up), so that is how the cards in play are read.
	state.totals = {}
	for _, effect in pairs((Match.roguelike and Match.roguelike.persistent_effects) or {}) do
		if type(effect) == "table" then
			local key = CardBrain.key(effect)
			state.totals[key] = (state.totals[key] or 0) + (tonumber(effect.amount) or 0)
		end
	end
	return state
end
function CardBrain.key(effect)
	return tostring(effect.type) .. ":" .. tostring(effect.stat or effect.damage_type or "")
end

-- Every plain card seen (this match and the card log), to rate the random ones.
CardBrain.pool = {}
function CardBrain.learn(options)
	for _, option in pairs(type(options) == "table" and options or {}) do
		local random = type(option) == "table" and option.random_effects
		for _, effect in pairs(type(option) == "table" and type(option.effects) == "table" and option.effects or {}) do
			random = random or (type(effect) == "table" and effect.type == "random_effects")
		end
		if type(option) == "table" and type(option.title) == "string" and type(option.effects) == "table" and not random then
			CardBrain.pool[option.title] = option
		end
	end
end
function CardBrain.tier(option)
	local title = tostring(option.title)
	return title:find(" III$") and 3 or title:find(" II$") and 2 or title:find(" I$") and 1 or nil
end
---The power factor of a typical card of that kind ("Good" / "Bad") and tier.
function CardBrain.typical(kind, tier, state)
	local sum, n = 0, 0
	for _, option in pairs(CardBrain.pool) do
		if option.option_type == kind and CardBrain.tier(option) == tier then
			sum += math.log(math.max((CardBrain.score(option, state)), 0.05))
			n += 1
		end
	end
	if n >= 3 then
		return math.exp(sum / n)
	end
	local fallback = kind == "Good" and { 1.08, 1.15, 1.25 } or { 0.8, 0.65, 0.45 }
	return fallback[math.clamp(tier, 1, 3)]
end
pcall(function()
	local file = SETTINGS_FOLDER .. "/cards.json"
	if not IS_LOBBY and isfile(file) then
		for _, entry in ipairs(httpService:JSONDecode(readfile(file))) do
			CardBrain.learn(entry.options)
		end
	end
end)

---Has this stage ever been finished? (Kept apart from the match log, which only holds 300.)
function AA.stageCleared(id)
	if type(AA.progress.cleared) == "table" and AA.progress.cleared[id] then
		return true
	end
	for _, entry in ipairs(AA.matchLog()) do
		if entry.level == id and entry.won then
			return true
		end
	end
	return false
end
---What a running total of one effect does to my team's kill power (1 = nothing).
function CardBrain.gain(kind, stat, damageType, total, state)
	if kind == "stat_mul" or kind == "stat_add" or kind == "stat_attr_add" then
		if stat == "damage" then
			return math.max(1 + total, 0.05)
		elseif stat == "range" then
			if total < 0 then
				-- Less range costs road in reach one for one, and it pulls the buff group
				-- apart: buffers stop reaching the units and each other. ("Double Attack,
				-- Half Range" scored as +40%: Elfy's reach went from 27 to 13 studs, the
				-- feeders lost the casters, and an Elyssia stood unbuffed for the rest of
				-- the run.)
				return math.max(1 + total, 0.2) * (state.buffer and 0.8 or 1)
			end
			return 1 + total * 0.6
		elseif stat == "attack_cooldown" then
			return 1 / math.max(1 + total, 0.2)
		elseif stat == "active_attack_cooldown" then
			return 1 / math.max(1 + total * 0.3, 0.2)
		end
	elseif kind == "boss_damage" then
		return 1 + total * 0.3
	elseif kind == "enemy_stat_mul" and stat == "health" then
		return 1 / math.max(1 + total, 0.2)
	elseif kind == "enemy_shield" then
		return 1 / math.max(1 + 0.06 * total, 0.2)
	elseif kind == "enemy_speedup" then
		return 1 / math.max(1 + total, 0.2)
	elseif kind == "burst_speed" then
		return 1 / math.max(1 + total * 0.3, 0.2)
	elseif kind == "enemy_regen" then
		-- Share of max health back per second, for as long as the enemy is under fire. The
		-- ones that end a run are under fire for most of a minute (the tank that ended a
		-- wave-49 Summer run walked the kill zone for about 50 s): 0.5%/s is a quarter more
		-- health there, 2%/s is double. (Was x4: Regen I scored 0.98 and was taken freely.)
		return 1 / math.max(1 + total * 50, 0.2)
	elseif kind == "enemy_bomb" then
		-- Explosive deaths (the number is the blast's reach in studs): the blast stuns towers
		-- near the dying enemy. Measured over a 49-wave run with reach 6: 107 tower-seconds
		-- of stun in total with 17 towers on the field, under 2% of their time. Measured again
		-- with reach 12 from wave 29 of a run that reached 49: 130-270 stunned tower-seconds a
		-- wave, a fifth to a third of their time, and a stunned Elfy can't cast. The cost
		-- grows faster than the reach: about 8% at 6, 25% at 12, 57% at 24.
		return 1 / (1 + (math.max(total, 0) / 12) ^ 2 * 0.33)
	elseif kind == "enemy_resistance_specific" then
		-- Resistance is in points, not per cent (enemy sheets carry 100 and 150): damage
		-- taken is 100 / (100 + points). (It was read as "minus that many per cent, at
		-- least 10% left": with Resistant I and II already taken, Resistant III, +200 to
		-- physical and magic, scored as costing nothing and was picked as the cheapest
		-- curse on offer. Two runs ended within a few waves of it.)
		return 1 + (state.share[damageType] or 0) * (100 / (100 + math.max(total, -90)) - 1)
	elseif kind == "enemy_amp_specific" then
		return 1 + (state.share[damageType] or 0) * total
	elseif kind == "weather_flying_chance" or kind == "weather_soaring_share" then
		return 1 / math.max(1 + total * (state.antiAir and 0.2 or 1.5), 0.2)
	elseif kind == "flying_damage" then
		return 1 + total * 0.1
	elseif kind == "unit_cost" then
		return 1 / math.max(1 + total * 0.5, 0.2)
	elseif kind == "enemy_passive_chance" then
		return 1 / math.max(1 + total * 0.5, 0.2)
	elseif kind == "golem_chance" then
		return 1 / math.max(1 + total * 0.3, 0.2)
	end
	return 1
end

---Power factor (x my team's kill power) and extra reward of one card. A card is rated by what
---it adds to the total already in play: a second +100% enemy health on top of the first takes
---a third off the team, not another half.
function CardBrain.score(option, state)
	local power, reward, candy = 1, 0, nil
	local totals = state.totals or {}
	for _, effect in ipairs(option.effects or {}) do
		local kind, amount, stat = effect.type, tonumber(effect.amount) or 0, effect.stat
		if kind == "candy_multiplier" then
			reward += amount
			candy = (candy or 0) + amount
		elseif kind == "secret_drop" then
			-- A better chance at a secret drop, which only exists if the run is cleared. (It was
			-- counted three times as heavily as pearls: Doomsday, enemy health doubled, was taken
			-- twice in one run for its +1 here.)
			reward += amount * 0.3
		elseif kind == "add_reward" then
			reward += 0.25
		elseif kind == "resource_gain" then
			-- Cash is worth what it adds to what's already on the field.
			power *= 1 + amount / math.max(state.spent or 0, 5000)
		elseif kind == "stat_mul_real" then
			if stat == "damage" then
				power *= amount
			elseif stat == "range" then
				power *= amount < 1 and (math.max(amount, 0.2) * (state.buffer and 0.8 or 1)) or (1 + (amount - 1) * 0.6)
			elseif stat == "attack_cooldown" then
				power /= math.max(amount, 0.2)
			end
		elseif kind == "new_path" then
			power *= 0.85
		elseif kind == "random_effects" then
			-- That many random cards of that tier: each counts as the typical card of its kind
			-- among the ones offered so far. (Was 4% per card and tier: Random Curses II scored
			-- 0.86 and beat Enemy Speed II at 0.67 in every forced vote; the two it rolled at
			-- wave 38 came to 0.71, two typical tier-2 curses to about 0.4.)
			power *= CardBrain.typical(effect._type, tonumber(effect.tier) or 1, state) ^ math.abs(amount)
		else
			local current = totals[CardBrain.key(effect)] or 0
			local before = CardBrain.gain(kind, stat, effect.damage_type, current, state)
			power *= CardBrain.gain(kind, stat, effect.damage_type, current + amount, state) / math.max(before, 0.01)
		end
	end
	return power, reward, candy
end

-- The user's own order of cards. A card is known by its name without the tier ("+ Enemy
-- Health III" -> "+ Enemy Health") and without the little picture some names start with.
CardBrain.FAMILIES = {
	{ "+ Attack", true }, { "+ Range", true }, { "- Cooldown", true }, { "- Active Cooldown", true }, { "+ Boss Damage", true },
	{ "+ Double Attack, Double Cooldown", true }, { "+ Yen", true }, { "Leyline", true }, { "Mana Surge", true }, { "Dispel", true },
	{ "Cinders", true }, { "Mud", true }, { "Rain Barrel", true },
	{ "+ Enemy Health", false }, { "+ Enemy Speed", false }, { "+ Enemy Regen", false }, { "+ Enemy Shield", false },
	{ "+ Explosive Deaths", false }, { "+ Plated Enemies", false }, { "+ Resistant Enemies", false }, { "+ Spellproof Enemies", false },
	{ "Arcane Storm", false }, { "Arcane Ward", false }, { "Mana Shield", false }, { "Flash Flood", false }, { "Heatwave", false },
	{ "Phoenix", false }, { "Scorch", false }, { "Torrent", false }, { "Washout", false },
}
function CardBrain.family(title)
	local name = tostring(title):gsub("[\128-\255]+", ""):gsub("%s+I+$", ""):gsub("^%s+", ""):gsub("%s+$", "")
	return name
end
---Every card name the script knows: the list above plus anything a vote has shown since.
function CardBrain.families()
	local names, seen, good = {}, {}, {}
	for _, row in ipairs(CardBrain.FAMILIES) do
		table.insert(names, row[1])
		seen[row[1]], good[row[1]] = true, row[2]
	end
	for title, option in pairs(CardBrain.pool) do
		local name = CardBrain.family(title)
		if name ~= "" and not seen[name] then
			table.insert(names, name)
			seen[name], good[name] = true, option.option_type == "Good"
		end
	end
	return names, good
end
function CardBrain.list()
	if CardBrain.listText ~= Config.CardList then
		local ok, list = pcall(function()
			return httpService:JSONDecode(Config.CardList)
		end)
		local clean = {}
		for _, name in ipairs(ok and type(list) == "table" and list or {}) do
			if type(name) == "string" and not table.find(clean, name) then
				table.insert(clean, name)
			end
		end
		CardBrain.listText, CardBrain.listCache = Config.CardList, clean
	end
	return CardBrain.listCache
end
function CardBrain.setList(list)
	Config.CardList = httpService:JSONEncode(list)
end
---Cards the user never wants voted for (unless every offered card is one of them).
function CardBrain.banned()
	if CardBrain.banText ~= Config.CardBan then
		local ok, list = pcall(function()
			return httpService:JSONDecode(Config.CardBan)
		end)
		local clean = {}
		for _, name in ipairs(ok and type(list) == "table" and list or {}) do
			if type(name) == "string" and not table.find(clean, name) then
				table.insert(clean, name)
			end
		end
		CardBrain.banText, CardBrain.banCache = Config.CardBan, clean
	end
	return CardBrain.banCache
end
---The offered card that stands highest on the user's list (of two tiers of the same card, the
---one the script itself rates higher), or nil when none of them is on it.
function CardBrain.listed(options, values)
	if not Config.CardListOn then
		return nil
	end
	local banned = CardBrain.banned()
	for rank, name in ipairs(CardBrain.list()) do
		local best, bestValue
		for key, option in pairs(options) do
			if type(option) == "table" and CardBrain.family(option.title) == name and not table.find(banned, name) then
				local value = values and values[key] or 0
				if not bestValue or value > bestValue then
					best, bestValue = key, value
				end
			end
		end
		if best ~= nil then
			return best, rank
		end
	end
	return nil
end

---Kill power left with all these effects in play (1 = no cards). `effects` is the server's own
---list, one entry per effect with its running total.
function CardBrain.stack(effects, state)
	return (CardBrain.score({ effects = effects }, { share = state.share, totals = {}, antiAir = state.antiAir, buffer = state.buffer, spent = math.huge }))
end

-- How much harder a wave is than the long middle of the run, for a team that is built. Read off
-- the logged depth of the toughest enemy with the curses unchanged: level from wave 20 to 41 of
-- 50, then climbing to about four times that on the last wave (17% of the road at waves 29-41,
-- 33% at 42, 49% at 48, 65% at 49 in one run; 3%, 21%, 46% over the last three in another).
CardBrain.CURVE = { { 0.4, 0.4 }, { 0.54, 1 }, { 0.82, 1 }, { 0.9, 1.4 }, { 0.94, 1.8 }, { 0.96, 2.4 }, { 0.98, 3.1 }, { 1, 3.8 } }
function CardBrain.difficulty(wave, bound)
	local x = math.clamp(wave / math.max(bound, 1), 0, 1)
	local curve = CardBrain.CURVE
	if x <= curve[1][1] then
		return curve[1][2]
	end
	for index = 2, #curve do
		local from, to = curve[index - 1], curve[index]
		if x <= to[1] then
			return from[2] + (to[2] - from[2]) * (x - from[1]) / (to[1] - from[1])
		end
	end
	return curve[#curve][2]
end

-- LEAK_AT: an enemy that gets this far down the road is as good as through. DEPTH_FLOOR: below
-- this the road tells nothing (everything dies at the door). STEEP: how sharply the chance to
-- hold falls around a margin of 1 (1.5 is 84%, 0.7 is 19%). CLEAR_WAVES: the clear bonus, in
-- waves of pay. M0: the margin an uncursed team has on the last wave, until the stage's own runs
-- have taught a better figure (see learnRun).
CardBrain.LEAK_AT, CardBrain.DEPTH_FLOOR, CardBrain.STEEP, CardBrain.CLEAR_WAVES, CardBrain.M0 = 0.9, 0.1, 4, 4, 5

-- Votes come every 3 waves, and 3 in 8 of them offer nothing but curses (112 of the 300 logged
-- votes). The mildest curse in such a vote costs 15% of the team's power in the first half of a
-- run and 29% in the second. A strategy that spends its whole margin by choice has nothing left
-- for those.
CardBrain.FORCED = { every = 3, share = 0.375, early = 0.85, late = 0.71 }
---What the all-curse votes between now and `wave` are expected to cost.
function CardBrain.forcedCost(sit, wave)
	local forced, factor = CardBrain.FORCED, 1
	local every = math.max(sit.every or forced.every, 1)
	local at = sit.wave + every
	while at < wave do
		factor *= (at / sit.bound < 0.5 and forced.early or forced.late) ^ forced.share
		at += every
	end
	return factor
end

---The margin (1 = just holding) on `wave` if a card of this power is taken now. `reserve`: how
---much of what the all-curse votes on the way there will cost is taken off as well (0 to 1).
function CardBrain.margin(sit, power, wave, reserve)
	local last = CardBrain.difficulty(sit.bound, sit.bound)
	local there = CardBrain.difficulty(wave, sit.bound)
	if reserve and reserve > 0 then
		power *= CardBrain.forcedCost(sit, wave) ^ reserve
	end
	-- From the cards alone: what the stack leaves of the uncursed team's margin.
	local prior = sit.m0 * sit.stacked * power * last / there
	if sit.wave / sit.bound < 0.4 and not sit.danger then
		-- Early: the team is still being built and the road says nothing about wave 50.
		return prior
	end
	-- From the road: how far enemies get now, carried forward to that wave.
	local seen = CardBrain.LEAK_AT / math.max(sit.depth, CardBrain.DEPTH_FLOOR) * power * CardBrain.difficulty(sit.wave, sit.bound) / there
	if sit.depth <= CardBrain.DEPTH_FLOOR then
		-- Everything dies at the door. That says the team is not at its limit yet, not how far
		-- from it: in the runs that fell in the low 40s nothing got past the first tenth of
		-- the road until wave 27.
		return prior
	end
	return seen ^ 0.65 * prior ^ 0.35
end

function CardBrain.holds(margin)
	return 1 / (1 + math.max(margin, 0.01) ^ -CardBrain.STEEP)
end

---Pearls the rest of the run is expected to pay (in the level's own units, before account
---bonuses) and the chance to clear, if a card of this power and this multiplier is taken now.
function CardBrain.expected(sit, power, candy, reserve)
	local total, chance = 0, 1
	local multiplier = 1 + sit.mult + (candy or 0)
	for wave = sit.wave, sit.bound do
		chance = CardBrain.holds(CardBrain.margin(sit, power, wave, reserve))
		total += sit.pay(wave) * multiplier * chance
	end
	total += CardBrain.CLEAR_WAVES * sit.pay(sit.bound) * multiplier * chance
	return total, chance
end

---What a wave pays before the multiplier, from the level's own table.
function CardBrain.paySteps(data)
	local steps
	for _, list in pairs(type(data) == "table" and type(data.infinite_resource_rewards) == "table" and data.infinite_resource_rewards or {}) do
		if type(list) == "table" and #list > 0 then
			steps = list
			break
		end
	end
	if not steps then
		return function()
			return 1
		end
	end
	return function(wave)
		local reward = 0
		for _, step in ipairs(steps) do
			reward = tonumber(step.reward) or 0
			if wave <= (tonumber(step.wave_up_to) or math.huge) then
				break
			end
		end
		return reward
	end
end

function CardBrain.m0(levelId)
	local learned = type(AA.progress.cardM0) == "table" and tonumber(AA.progress.cardM0[tostring(levelId)]) or nil
	return learned and math.clamp(learned, 2, 20) or CardBrain.M0
end

---After a load in the middle of a match the server does not send its list of the cards in play
---again until the next vote. The game keeps its own copy of the last one: read that, once.
function CardBrain.seed()
	if IS_LOBBY or Match.roguelike or AA.cardSeeded or not AA.loadedMid then
		return
	end
	AA.cardSeeded = true
	-- (More than one table carries those two names; the vote result is the one whose effects
	-- are a list. Of several, the latest has the highest multiplier.)
	local ok, found = pcall(filtergc, "table", { Keys = { "persistent_effects", "candy_multiplier" } }, false)
	local best
	for _, candidate in ipairs(ok and type(found) == "table" and found or {}) do
		if type(candidate.persistent_effects) == "table" and type(candidate.candy_multiplier) == "number" and (not best or candidate.candy_multiplier > best.candy_multiplier) then
			best = candidate
		end
	end
	if best then
		Match.roguelike = { persistent_effects = best.persistent_effects, candy_multiplier = best.candy_multiplier }
		note("cardSeed", { mult = best.candy_multiplier })
	end
end

---Everything about the run the decision needs, read once.
function CardBrain.situation(state)
	local health, maxHealth = baseHealth()
	local fraction = maxHealth > 0 and health / maxHealth or 1
	local wave, depth = currentWave(), 0
	-- Deepest any enemy got in the last 3 waves (0 = spawn, 1 = base). Full base health alone
	-- fooled an earlier version: a run sat at full health to wave 47 with enemies already deep.
	for w = wave - 2, wave do
		depth = math.max(depth, (Match.depthByWave or {})[w] or 0)
	end
	local bleeding = Match.bleedAt ~= nil and os.clock() - Match.bleedAt < 90
	local data = Match.levelData or {}
	local bound = tonumber(data._override_infinite_bound_waves) or Match.totalWaves or 50
	local effects = {}
	for _, effect in pairs(Match.roguelike and type(Match.roguelike.persistent_effects) == "table" and Match.roguelike.persistent_effects or {}) do
		table.insert(effects, effect)
	end
	local stacked = CardBrain.stack(effects, state)
	Match.cardPower = stacked
	local sit = {
		wave = math.clamp(wave, 1, bound),
		bound = bound,
		health = fraction,
		stacked = stacked,
		mult = tonumber(Match.roguelike and Match.roguelike.candy_multiplier) or 0,
		pay = CardBrain.paySteps(data),
		m0 = CardBrain.m0(Match.levelId),
		every = Match.voteEvery,
		danger = fraction < 0.6 or (Match.leakRisk or 0) >= 0.4 or depth >= 0.8,
		-- A stage with an end that has never been finished (the clear is what drops its portal).
		unproven = (data._override_infinite_bound_waves ~= nil or data._infinite_bound_level ~= nil) and Match.levelId ~= nil and not AA.stageCleared(Match.levelId),
	}
	-- A base that has just been hit says more than the road does.
	sit.depth = (fraction < 0.6 and 1) or ((bleeding or fraction < 0.95) and math.max(depth, 0.85)) or depth
	return sit
end

CardBrain.STRATEGIES = { "Win", "Balanced", "Pearls" }
-- Win: a curse may cost this share of the team's power at most, and this much clear chance.
-- Balanced: the clear chance it will not go under by choice.
-- Pearls: a curse is passed over when a blessing is expected to pay more pearls (share 1), or,
-- with "never pass on a curse", only when the curse leaves under half of what the blessing would
-- or under a one in four chance of standing three waves from now.
-- reserve: how much of the coming all-curse votes each strategy sets margin aside for.
-- (The logged votes of eleven full runs, replayed through this model: Win kept the clear at 99%
-- for 1209 pearls a run before account bonuses, Balanced 85% for 1604, Pearls 45% for 2130.
-- Never passing on a curse came to 2% and 1726: the run ends in the low 40s, before the big
-- multiplier has paid. 67 of the 166 votes went differently in at least one strategy. A
-- projection, not played matches.)
CardBrain.RULES = { freePower = 0.97, freeClear = 0.01, keepClear = 0.85, pearlsShare = 1, pearlsEvery = 0.5, pearlsSoon = 0.25, reserve = { Win = 0, Balanced = 0.7, Pearls = 1 } }

---The decision itself, from plain values (so it can be tested without a match).
---banned: { [family] = true }. order: the user's list of families, or nil. everyCurse: the
---Pearls option that never passes on a curse.
---Returns the option key (nil = cast no vote), the log lines, and a table for the menu.
function CardBrain.decide(options, sit, state, strategy, banned, order, everyCurse)
	local rules = CardBrain.RULES
	local rows, report = {}, {}
	for key, option in pairs(options) do
		if type(option) == "table" then
			local power, reward, candy = CardBrain.score(option, state)
			-- (Some card names start with a little picture; the menu and the log carry the words.)
			local row = { key = key, title = CardBrain.family(option.title) .. (tostring(option.title):match("%s+I+$") or ""), power = power, candy = candy or 0, extra = reward - (candy or 0), curse = option.option_type == "Bad", family = CardBrain.family(option.title) }
			row.banned = banned[row.family] == true
			row.pearls, row.clear = CardBrain.expected(sit, power, row.candy, rules.reserve[strategy])
			-- Other rewards (a better secret-drop chance, an extra reward) only break ties.
			row.pearls *= 1 + 0.01 * row.extra
			table.insert(rows, row)
		end
	end
	table.sort(rows, function(a, b)
		return tostring(a.key) < tostring(b.key)
	end)
	local open = {}
	for _, row in ipairs(rows) do
		table.insert(report, string.format("%s p%.2f +%.2f clear %d%% pearls %d%s", row.title, row.power, row.candy, row.clear * 100 + 0.5, row.pearls + 0.5, row.banned and " (never)" or ""))
		if not row.banned then
			table.insert(open, row)
		end
	end
	local view = { rows = rows, strategy = strategy }
	local function done(row, why)
		view.pick, view.why = row and row.key or nil, why
		table.insert(report, why)
		return view.pick, report, view
	end
	if #rows == 0 then
		return done(nil, "no cards in the vote")
	end
	if #open == 0 then
		return done(nil, "Every card in this vote is on your never list: no vote cast")
	end
	---Highest `first`, ties by `second`.
	local function top(list, first, second)
		local best
		for _, row in ipairs(list) do
			if not best or row[first] > best[first] + 1e-9 or (math.abs(row[first] - best[first]) <= 1e-9 and row[second] > best[second]) then
				best = row
			end
		end
		return best
	end
	-- The user's own order comes before every strategy (and after the never list).
	for rank, name in ipairs(order or {}) do
		local same = {}
		for _, row in ipairs(open) do
			if row.family == name then
				table.insert(same, row)
			end
		end
		if #same > 0 then
			return done(top(same, "pearls", "power"), "Your order, place " .. rank)
		end
	end
	local strongest = top(open, "power", "candy")
	local curses = {}
	for _, row in ipairs(open) do
		if row.curse then
			table.insert(curses, row)
		end
	end
	if strategy == "Win" then
		-- The clear comes first. A curse is only worth taking when it costs next to nothing
		-- against the best card on offer and by itself.
		local free = {}
		for _, row in ipairs(sit.danger and {} or curses) do
			if row.power >= rules.freePower and row.clear >= strongest.clear - rules.freeClear then
				table.insert(free, row)
			end
		end
		if #free > 0 then
			return done(top(free, "candy", "power"), "Win: this curse costs almost nothing, so its pearls are free")
		end
		return done(strongest, strongest.curse and "Win: only curses on offer, this one hurts least" or "Win: keeps the team strongest")
	elseif strategy == "Balanced" then
		if sit.danger then
			return done(strongest, "Balanced: the base is under pressure, strongest card")
		elseif sit.unproven then
			return done(strongest, "Balanced: this stage has never been cleared, playing it safe until it has")
		end
		local safe = {}
		for _, row in ipairs(open) do
			if row.clear >= rules.keepClear then
				table.insert(safe, row)
			end
		end
		if #safe == 0 then
			return done(strongest, string.format("Balanced: no card keeps the clear likely (best %d%%), strongest card", strongest.clear * 100 + 0.5))
		end
		local pick = top(safe, "pearls", "power")
		return done(pick, string.format("Balanced: most pearls with the clear still likely (%d%%)", pick.clear * 100 + 0.5))
	end
	-- Pearls: a curse whenever one is on offer.
	if #curses == 0 then
		return done(top(open, "pearls", "power"), "Pearls: no curse on offer, best blessing")
	end
	local curse = top(curses, "pearls", "power")
	local others = {}
	for _, row in ipairs(open) do
		if not row.curse then
			table.insert(others, row)
		end
	end
	local other = top(others, "pearls", "power")
	if other then
		local soon = CardBrain.holds(CardBrain.margin(sit, curse.power, math.min(sit.wave + 3, sit.bound), 0))
		if everyCurse then
			if curse.pearls < rules.pearlsEvery * other.pearls or soon < rules.pearlsSoon then
				return done(other, "Pearls: every curse on offer would end the run, blessing instead")
			end
		elseif curse.pearls < rules.pearlsShare * other.pearls then
			return done(other, string.format("Pearls: the blessing is worth more pearls (%d against %d)", other.pearls + 0.5, curse.pearls + 0.5))
		end
	end
	return done(curse, string.format("Pearls: the curse worth the most pearls (+%s to the multiplier)", tostring(curse.candy)))
end

function CardBrain.strategy()
	return table.find(CardBrain.STRATEGIES, Config.CardStrategy) and Config.CardStrategy or "Balanced"
end

function CardBrain.choose(options)
	CardBrain.seed()
	local state = CardBrain.state()
	local sit = CardBrain.situation(state)
	local banned = {}
	for _, name in ipairs(CardBrain.banned()) do
		banned[name] = true
	end
	local pick, report, view = CardBrain.decide(options, sit, state, CardBrain.strategy(), banned, Config.CardListOn and CardBrain.list() or nil, Config.PearlsOnlyCurses)
	view.sit = sit
	return pick, report, view
end

---What the menu shows about the run's cards.
function CardBrain.view()
	CardBrain.seed()
	if IS_LOBBY or not Match.roguelike and not Match.cardOffer then
		return nil
	end
	-- (Read by the menu twice a second; the figures behind it move by the wave.)
	local cached = CardBrain.viewCache
	if cached and os.clock() - cached.at < 2 and cached.offer == Match.cardOffer and cached.info == Match.roguelike then
		return cached.view
	end
	local ok, state = pcall(CardBrain.state)
	local okSit, sit = pcall(CardBrain.situation, ok and state or { share = {}, resist = {} })
	if not okSit then
		return nil
	end
	-- (No reserve here: the figure shown is for holding the stack where it is from now on.)
	local _, clear = CardBrain.expected(sit, 1, 0, 0)
	local offer = Match.cardOffer
	local last = offer and offer.view
	local picked
	for _, row in ipairs(last and last.rows or {}) do
		if row.key == last.pick then
			picked = row
		end
	end
	local result = { wave = sit.wave, bound = sit.bound, mult = sit.mult, stacked = sit.stacked, clear = clear, picked = picked, why = last and last.why, rows = last and last.rows }
	CardBrain.viewCache = { at = os.clock(), offer = Match.cardOffer, info = Match.roguelike, view = result }
	return result
end

---After a run: what the stage's uncursed margin must have been, from how the run ended.
---A loss at wave w with the stack at S means the margin ran out there: M0 x S x last / diff(w)
---was about 1. A clear means it was above 1 on the last wave, so the figure is only raised.
function CardBrain.learnRun(levelId, won, wave)
	local sit = Match.cardSit
	-- (Only runs that took a few curses say anything: a multiplier of 1.5 is three mild ones.)
	if not (levelId and sit and (sit.mult or 0) >= 1.5) then
		return
	end
	local last = CardBrain.difficulty(sit.bound, sit.bound)
	local seen
	if won then
		seen = math.max(1.3 / math.max(sit.stacked, 0.01), CardBrain.m0(levelId))
	elseif wave / sit.bound >= 0.6 then
		seen = CardBrain.difficulty(wave, sit.bound) / (last * math.max(sit.stacked, 0.01))
	end
	if seen then
		AA.progress.cardM0 = type(AA.progress.cardM0) == "table" and AA.progress.cardM0 or {}
		local old = CardBrain.m0(levelId)
		-- A slow average: one odd run (a disconnect, a hand-played one) moves it a quarter.
		AA.progress.cardM0[tostring(levelId)] = math.clamp(math.exp(math.log(old) * 0.75 + math.log(math.clamp(seen, 1, 40)) * 0.25), 2, 20)
		note("cardM0", { was = math.floor(old * 100) / 100, seen = math.floor(seen * 100) / 100, now = math.floor(AA.progress.cardM0[tostring(levelId)] * 100) / 100 })
	end
end

