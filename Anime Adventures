---The client session: profile_data (currencies, progress, quests), collection (units), inventory.
local function session()
	if Session and rawget(Session, "profile_data") then
		return Session
	end
	local ok, found = pcall(filtergc, "table", { Keys = { "profile_data", "collection", "inventory" } }, true)
	Session = ok and found or nil
	return Session
end

local function profile()
	local s = session()
	return s and s.profile_data or {}
end

local function collectionData()
	local s = session()
	local c = s and s.collection
	return c and c.collection_profile_data or {}
end

local function invoke(name, ...)
	local remote = Endpoints:FindFirstChild(name)
	if not remote then
		return false, "missing remote"
	end
	if IS_LOBBY then
		-- The lobby server drops requests sent faster than about one per 0.7 s.
		local wait = (AA.lastInvoke or 0) + 0.75 - os.clock()
		AA.lastInvoke = os.clock() + math.max(wait, 0)
		if wait > 0 then
			task.wait(wait)
		end
	end
	local results = table.pack(pcall(remote.InvokeServer, remote, ...))
	setthreadidentity(8)
	if not results[1] then
		return false, tostring(results[2])
	end
	return true, table.unpack(results, 2, results.n)
end

local function setGameSetting(name, value)
	local setting = settingsFolder:FindFirstChild(name)
	if setting and setting.Value ~= value then
