---Call one of the game's functions; nil when it isn't there or throws.
local function gameCall(fn, ...)
	if type(fn) ~= "function" then
		return nil
	end
	local results = table.pack(pcall(fn, ...))
	setthreadidentity(8)
	if results[1] and results.n >= 2 then
		return table.unpack(results, 2, results.n)
	end
	-- Always one value: a game function that returns nothing must not turn tonumber(gameCall())
	-- into a call with no argument.
	return nil
end

-- Lobby blind spot: newer banner units (Elyssia, Zombie, Shadow Sorcerer (Incident)...) have no
-- upgrade table and no attack in the lobby's copy of the data; the match server's copy has them.
-- In matches those fields are saved to unitdata.json; in the lobby the script reads units
-- through a view that fills the gaps from that file (the game's own table is left untouched).
do
	local file = SETTINGS_FOLDER .. "/unitdata.json"
	local cache = { units = {}, attacks = {} }
	pcall(function()
		if isfile(file) then
			local data = httpService:JSONDecode(readfile(file))
			if type(data) == "table" and type(data.units) == "table" then
				cache = data
				cache.attacks = cache.attacks or {}
			end
		end
	end)
	AA.unitCache = cache
	local NEW_STYLE = { "_rateup_banner_only", "shared_setup_script", "show_custom_unique_info" }
	local FIELDS = { "upgrade", "primary_attack", "primary_attack_no_upgrades", "spawn_cap", "damage", "attack_cooldown", "range", "hill_unit", "hybrid_placement", "_attacks", "death_attack", "active_attack", "on_attack_script", "upgrade_script", "spawn_script", "physical_crit_chance", "physical_crit_damage", "magic_crit_chance", "magic_crit_damage" }
	local function plain(value, depth)
		if type(value) ~= "table" then
			return (type(value) == "number" or type(value) == "string" or type(value) == "boolean") and value or nil
		end
		if depth > 8 then
			return nil
		end
		local out = {}
		for key, item in pairs(value) do
			if key ~= "fx" and key ~= "sfx" and key ~= "effects" and key ~= "ASSETS" and key ~= "initial_fx" and key ~= "particle" and key ~= "projectile" then
				out[key] = plain(item, depth + 1)
			end
		end
		return out
	end
	---In a match: copy the fields the lobby can't see for every new-style unit.
	function AA.saveUnitCache()
		local count = 0
		for id, data in pairs(Units) do
			if type(data) == "table" and type(data.upgrade) == "table" then
				local newStyle = false
				for _, key in ipairs(NEW_STYLE) do
					newStyle = newStyle or data[key] ~= nil
				end
				if newStyle then
					local entry = {}
					for _, key in ipairs(FIELDS) do
						entry[key] = plain(data[key], 0)
					end
					cache.units[id] = entry
					count += 1
					local attackIds = { data.primary_attack or false, data.primary_attack_no_upgrades or false, data.death_attack or false, data.active_attack or false }
					for _, attackId in pairs(type(data._attacks) == "table" and data._attacks or {}) do
						table.insert(attackIds, attackId)
					end
					for _, up in ipairs(data.upgrade) do
						table.insert(attackIds, type(up) == "table" and up.primary_attack or false)
					end
					for _, attackId in ipairs(attackIds) do
						if type(attackId) == "string" and Attacks[attackId] then
							cache.attacks[attackId] = plain(Attacks[attackId], 0)
						end
					end
				end
			end
		end
		pcall(function()
			writefile(file, httpService:JSONEncode(cache))
		end)
		return count
	end
	if IS_LOBBY then
		local RawUnits, RawAttacks, merged = Units, Attacks, {}
		AA.RawUnits = RawUnits -- (the proxy below is empty to pairs)
		Units = setmetatable({}, {
			__index = function(_, id)
				local raw = RawUnits[id]
				local extra = cache.units[id]
				if raw == nil or type(raw) ~= "table" or raw.upgrade or not extra then
					return raw
				end
				if not merged[id] then
					local copy = table.clone(raw)
					for key, value in pairs(extra) do
						if copy[key] == nil then
							copy[key] = value
						end
					end
					copy._fromCache = true
					merged[id] = copy
				end
				return merged[id]
			end,
		})
		Attacks = setmetatable({}, {
			__index = function(_, id)
				local raw = RawAttacks[id]
				if raw ~= nil then
					return raw
				end
				return cache.attacks[id]
			end,
		})
	end
end

local Session
---The client session: profile_data (currencies, progress, quests), collection (units), inventory.
local function session()
	if Session and rawget(Session, "profile_data") then
		return Session
	end
	local ok, found = pcall(filtergc, "table", { Keys = { "profile_data", "collection", "inventory" } }, true)
	Session = ok and found or nil
	return Session
end

local function profile()
	local s = session()
	return s and s.profile_data or {}
end

local function collectionData()
	local s = session()
	local c = s and s.collection
	return c and c.collection_profile_data or {}
end

local function invoke(name, ...)
	local remote = Endpoints:FindFirstChild(name)
	if not remote then
		return false, "missing remote"
	end
	if IS_LOBBY then
		-- The lobby server drops requests sent faster than about one per 0.7 s.
		local wait = (AA.lastInvoke or 0) + 0.75 - os.clock()
		AA.lastInvoke = os.clock() + math.max(wait, 0)
		if wait > 0 then
			task.wait(wait)
		end
	end
	local results = table.pack(pcall(remote.InvokeServer, remote, ...))
	setthreadidentity(8)
	if not results[1] then
		return false, tostring(results[2])
	end
	return true, table.unpack(results, 2, results.n)
end

local function setGameSetting(name, value)
	local setting = settingsFolder:FindFirstChild(name)
	if setting and setting.Value ~= value then
		invoke("toggle_setting", name, value)
	end
end

