	---Two panes side by side inside the open card. Returns left, right and into(pane): controls
	---built after into(pane) land in that pane, into(nil) goes back to the card itself.
	function UI.split(page, share)
		share = share or 0.5
		local body = slot(page, 0)
		local row = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = UI.nextOrder(), Parent = body })
		local function pane(x, width, offset)
			return create("Frame", { Position = UDim2.new(x, offset, 0, 0), Size = UDim2.new(width, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = row }, {
				create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 12) }),
			})
		end
		local left, right = pane(0, share, 0), pane(share, 1 - share, 10)
		local current = UI.current[page]
		return left, right, function(target)
			current.body = target or body
			UI.lastRow[page] = nil
		end
