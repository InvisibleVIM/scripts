	---A list to pick one row from. options: get() -> rows { id, title, sub, tag, section },
	---selected() -> id, pick(id), height, empty. Rows of one section sit under its name. The
	---picked row is filled, ringed in the accent and ticked. Returns refresh().
	function UI.pickList(page, options)
		local frame = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, options.height or 280),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = UI.roles.Outline,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			LayoutOrder = UI.nextOrder(),
			Parent = slot(page, options.height or 280),
		}, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }),
			create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 10) }),
		})
		round(frame, 8)
		stroke(frame, "Outline")
		UI.lastRow[page] = nil
		local signature
		local function refresh()
			local rows = options.get()
			local picked = options.selected()
			local parts = { tostring(picked), UI.roles.Accent:ToHex(), UI.roles.Raised:ToHex() }
			for _, row in ipairs(rows) do
				table.insert(parts, table.concat({ tostring(row.id), tostring(row.title), tostring(row.sub), tostring(row.tag), tostring(row.section), tostring(row.note) }, "~"))
			end
			local now = table.concat(parts, "|")
			if now == signature then
				return
			end
			signature = now
			for _, child in ipairs(frame:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			if #rows == 0 then
				wrapped({ Size = UDim2.new(1, -8, 0, 16), Text = options.empty or "Nothing to show.", TextSize = px(13), TextColor3 = UI.roles.Muted, LayoutOrder = 1, Parent = frame })
				return
			end
			local section
			local order = 0
			for _, row in ipairs(rows) do
				if row.note then
					order += 1
					wrapped({ Size = UDim2.new(1, -8, 0, 16), Text = row.note, TextSize = px(13), TextColor3 = UI.roles.Muted, LayoutOrder = order, Parent = frame })
				else
					if row.section and row.section ~= section then
						section = row.section
						order += 1
						local head = create("Frame", { Size = UDim2.new(1, 0, 0, order == 1 and 22 or 30), BackgroundTransparency = 1, LayoutOrder = order, Parent = frame })
						label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 6, 1, -2), Size = UDim2.new(1, -12, 0, 16), Text = section, FontFace = CODE_BOLD, TextSize = px(12), TextColor3 = UI.roles.Muted, TextTruncate = Enum.TextTruncate.AtEnd, Parent = head })
					end
					order += 1
					local isPicked = row.id == picked
					local item = create("TextButton", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = UI.roles.Raised, BackgroundTransparency = isPicked and 0 or 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = order, Parent = frame })
					item:SetAttribute("NoTheme", true)
					round(item, 7)
					local ring = create("UIStroke", { Color = UI.roles.Accent, Thickness = 1.5, Transparency = isPicked and 0 or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = item })
					ring:SetAttribute("NoTheme", true)
					local reserve = isPicked and 34 or 12
					local hasTag = row.tag ~= nil and row.tag ~= ""
					if hasTag then
						label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -reserve, 0, 7), Size = UDim2.fromOffset(52, 16), Text = row.tag, FontFace = CODE_BOLD, TextSize = px(12), TextColor3 = UI.roles.Accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = item })
					end
					label({ Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -(reserve + 12 + (hasTag and 58 or 0)), 0, 18), Text = tostring(row.title), FontFace = isPicked and CODE_BOLD or CODE_MEDIUM, TextSize = px(15), TextTruncate = Enum.TextTruncate.AtEnd, Parent = item })
					label({ Position = UDim2.fromOffset(12, 25), Size = UDim2.new(1, -24, 0, 16), Text = tostring(row.sub or ""), TextSize = px(13), TextColor3 = UI.roles.Muted, TextTruncate = Enum.TextTruncate.AtEnd, Parent = item })
					if isPicked then
						icon(item, "check", 13, UI.roles.Accent, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8) })
					end
					item.MouseEnter:Connect(function()
						if not isPicked then
							item.BackgroundTransparency = 0.45
						end
					end)
					item.MouseLeave:Connect(function()
						if not isPicked then
							item.BackgroundTransparency = 1
						end
					end)
					item.MouseButton1Click:Connect(function()
						options.pick(row.id)
						UI.refreshAll()
					end)
				end
			end
		end
		table.insert(UI.refreshers, refresh)
		table.insert(UI.colorRefreshers, function()
			signature = nil
			refresh()
		end)
		refresh()
		return refresh
	end

	---Chips to tick any number of options. options: get() -> { { id, name, note } } (read once),
	---isOn(id), toggle(id), perRow. A ticked chip is ringed and its box filled.
	function UI.chips(page, options)
		local entries = options.get()
		local perRow = options.perRow or 2
		local rows = math.max(math.ceil(#entries / perRow), 1)
		local grid = UI.rowBase(page, rows * 34 + (rows - 1) * 6, false)
		grid.AutomaticSize = Enum.AutomaticSize.None
		UI.lastRow[page] = nil
		create("UIGridLayout", { CellSize = UDim2.new(1 / perRow, -6 * (perRow - 1) / perRow, 0, 34), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
		local chips = {}
		local function refresh()
			for id, chip in pairs(chips) do
				local on = options.isOn(id) == true
				chip.frame.BackgroundColor3 = on and UI.roles.Raised or UI.roles.Control
				chip.ring.Color = on and UI.roles.Accent or UI.roles.Outline
				chip.ring.Thickness = on and 1.5 or 1
				chip.box.BackgroundColor3 = UI.roles.Accent
				chip.box.BackgroundTransparency = on and 0 or 1
				chip.boxRing.Color = on and UI.roles.Accent or UI.roles.Muted
				chip.mark.Visible = on
				UI.tint(chip.mark, UI.onAccent())
				chip.name.TextColor3 = UI.roles.Font
				chip.name.FontFace = on and CODE_BOLD or CODE
				chip.note.TextColor3 = UI.roles.Muted
			end
		end
		for index, entry in ipairs(entries) do
			local frame = create("TextButton", { BackgroundColor3 = UI.roles.Control, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = index, Parent = grid })
			frame:SetAttribute("NoTheme", true)
			round(frame, 7)
			local ring = create("UIStroke", { Color = UI.roles.Outline, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame })
			ring:SetAttribute("NoTheme", true)
			local box = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = UI.roles.Accent, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = frame })
			box:SetAttribute("NoTheme", true)
			round(box, 4)
			local boxRing = create("UIStroke", { Color = UI.roles.Muted, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = box })
			local mark = icon(box, "check", 10, UI.onAccent(), { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
			mark:SetAttribute("NoTheme", true)
			local hasNote = entry.note ~= nil and entry.note ~= ""
			local name = label({ Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, hasNote and -96 or -42, 1, 0), Text = tostring(entry.name), TextSize = px(14), TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame })
			local note = label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.new(0, 52, 1, 0), Text = tostring(entry.note or ""), TextSize = px(12), TextColor3 = UI.roles.Muted, TextXAlignment = Enum.TextXAlignment.Right, Parent = frame })
			chips[entry.id] = { frame = frame, ring = ring, box = box, boxRing = boxRing, mark = mark, name = name, note = note }
			frame.MouseEnter:Connect(function()
				if not options.isOn(entry.id) then
					ring.Color = UI.roles.Muted
				end
			end)
			frame.MouseLeave:Connect(refresh)
			frame.MouseButton1Click:Connect(function()
				options.toggle(entry.id)
				UI.refreshAll()
			end)
		end
		table.insert(UI.refreshers, refresh)
		table.insert(UI.colorRefreshers, refresh)
		refresh()
		return refresh
	end

	---A button whose label and look follow a state: state() -> text, primary. Returns refresh().
	function UI.liveButton(page, state, action)
		local button = create("TextButton", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = UI.roles.Control, BorderSizePixel = 0, AutoButtonColor = false, FontFace = CODE_BOLD, Text = "", TextSize = px(15), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = UI.nextOrder(), Parent = slot(page, 38) })
