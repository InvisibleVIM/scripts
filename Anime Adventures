	-- Only with the fallback font (a custom one may be much wider than the design): one-line
	-- text that doesn't fit its box scales down instead of being cut.
	function UI.fitText(object)
		if Type.own or not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
			return
		end
		if object.AutomaticSize ~= Enum.AutomaticSize.None or object.TextScaled or object.TextWrapped or object:FindFirstChildOfClass("UITextSizeConstraint") then
			return
		end
		local designed = object.TextSize
		object.TextScaled = true
		create("UITextSizeConstraint", { MaxTextSize = designed, MinTextSize = 8, Parent = object })
	end

	-- Small marks drawn from bars, so no glyph depends on what a font happens to carry.
	---kind: "down", "up", "cross", "check". Returns the holder; recolor with UI.tint(holder, color).
	local function icon(parent, kind, size, color, props)
		local holder = create("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Parent = parent })
		for key, value in pairs(props or {}) do
			holder[key] = value
		end
		local function bar(length, angle, x, y)
			local line = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(x, y),
				Size = UDim2.fromOffset(math.floor(length * size + 0.5), 2),
				Rotation = angle,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Parent = holder,
			})
			round(line, 1)
		end
		if kind == "cross" then
			bar(0.8, 45, 0.5, 0.5)
			bar(0.8, -45, 0.5, 0.5)
		elseif kind == "down" then
			bar(0.5, 45, 0.34, 0.5)
			bar(0.5, -45, 0.66, 0.5)
		elseif kind == "up" then
			bar(0.5, -45, 0.34, 0.5)
			bar(0.5, 45, 0.66, 0.5)
		elseif kind == "check" then
			bar(0.38, 45, 0.3, 0.62)
			bar(0.7, -50, 0.62, 0.48)
		end
		return holder
	end
	UI.icon = icon
	function UI.tint(holder, color)
		for _, child in ipairs(holder:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = color
			end
		end
	end

