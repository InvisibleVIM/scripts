	local fillAllHolder = songList()
	button(page, "Load every anime's song list", function()
		for _, anime in ipairs(ANIME_LIST) do
			if type(Music.library[anime]) ~= "table" then
				Music.songsFor(anime)
				task.wait(0.4)
			end
		end
		return "Loaded"
	end)

	-- Keep the lists and the now-playing line current.
	task.spawn(function()
		local shownMap = false
		while AA.alive do
			nowLine.Text = "Now: " .. Music.status
			local anime = Music.mapAnime()
			if Music.shownOwn ~= Config.MusicOwnOnly then
				Music.shownOwn = Config.MusicOwnOnly
				shownMap, shownAnime = false, nil
			end
			if anime ~= shownMap and pages.Music.Visible then
				shownMap = anime
				mapTitle.Text = anime and (anime .. " (" .. tostring((Match.levelData or {}).name or "") .. ")") or "Lobby: no map anime"
				fillMap({}, anime and "Loading..." or "Join a match to see its songs", true)
				if anime then
					fillMap(Music.songsFor(anime), Config.MusicOwnOnly and "No files yet in music/" .. anime or "Nothing found", true)
				end
			end
			if Config.MusicAnime ~= shownAnime and pages.Music.Visible then
				shownAnime = Config.MusicAnime
				fillAllHolder({}, "Loading...", true)
				fillAllHolder(Music.songsFor(shownAnime), Config.MusicOwnOnly and "No files yet in music/" .. shownAnime or "Nothing found", true)
			end
			task.wait(0.5)
		end
	end)
end

