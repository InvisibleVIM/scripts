	---A "name ........ value" line; returns the value label.
	function UI.kv(page, name)
		local row = UI.rowBase(page, 20, false)
		label({ Size = UDim2.new(0.44, 0, 0, 20), Text = name, TextColor3 = UI.roles.Muted, TextSize = px(14), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		return label({ Position = UDim2.fromScale(0.44, 0), Size = UDim2.new(0.56, 0, 0, 20), Text = "", FontFace = CODE_MEDIUM, TextSize = px(14), TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
