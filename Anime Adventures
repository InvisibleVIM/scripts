		})
		create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = square })
		local white = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 52, Parent = square }, {
			create("UICorner", { CornerRadius = UDim.new(0, 4) }),
