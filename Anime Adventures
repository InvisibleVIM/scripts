	---A card. side: "left", "right", "full" (above the columns) or "bottom" (under them).
	---note: one muted line under the title.
	local function newBox(page, title, side, note)
		local columns = UI.columns[page]
		if side ~= "left" and side ~= "right" and side ~= "full" and side ~= "bottom" then
			side = columns.height.left <= columns.height.right and "left" or "right"
		end
		local box = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = UI.roles.Main,
			BorderSizePixel = 0,
			LayoutOrder = UI.nextOrder(),
			Parent = columns[side],
		})
		round(box, 10)
		stroke(box, "Outline")
		local body = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Parent = box,
		}, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 12) }),
			create("UIPadding", { PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 16), PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }),
		})
		if columns.height[side] then
			columns.height[side] += 44
		end
		UI.current[page] = { body = body, side = side, box = box }
		if title and title ~= "" then
			-- (No list layout here: a "?" may be put beside the title.)
			local head = create("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = UI.nextOrder(), Parent = body })
			label({ Name = "Title", Size = UDim2.new(1, 0, 0, 20), Text = title, FontFace = CODE_BOLD, TextSize = px(16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = head })
			if note and note ~= "" then
				wrapped({ Position = UDim2.fromOffset(0, 23), Size = UDim2.new(1, 0, 0, 16), Text = note, TextSize = px(13), TextColor3 = UI.roles.Muted, Parent = head })
			end
			if columns.height[side] then
				columns.height[side] += 30
			end
		end
		return body
	end

	---Where the next control on this page goes (a new untitled card if none is open).
	local function slot(page, height)
		local current = UI.current[page] or { body = newBox(page) }
		current = UI.current[page]
		if UI.columns[page].height[current.side] then
			UI.columns[page].height[current.side] += (height or 24) + 12
		end
		return current.body
	end
	UI.slot = slot

	---A page. about: one or two sentences under its title. group: its heading in the page list.
	function UI.makePage(name, about, group)
		local page = create("ScrollingFrame", {
			Name = name,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = UI.roles.Outline,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = false,
			Parent = content,
		}, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 14) }),
			create("UIPadding", { PaddingTop = UDim.new(0, 18), PaddingBottom = UDim.new(0, GUTTER), PaddingLeft = UDim.new(0, GUTTER), PaddingRight = UDim.new(0, GUTTER) }),
		})
		local intro = create("Frame", { Name = "Intro", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = page }, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
		})
		label({ Size = UDim2.new(1, 0, 0, 28), Text = name, FontFace = CODE_BOLD, TextSize = px(22), LayoutOrder = 1, Parent = intro })
		if about and about ~= "" then
			wrapped({ Size = UDim2.new(1, 0, 0, 18), Text = about, TextSize = px(14), TextColor3 = UI.roles.Muted, LayoutOrder = 2, Parent = intro })
		end
		local full = create("Frame", { Name = "Full", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, Visible = false, Parent = page }, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 14) }),
		})
		full.ChildAdded:Connect(function()
			full.Visible = true
		end)
		local holder = create("Frame", { Name = "Columns", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = page })
		local function column(x)
			return create("Frame", {
				Position = UDim2.new(x, x == 0 and 0 or 7, 0, 0),
				Size = UDim2.new(0.5, -7, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Parent = holder,
			}, {
				create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 14) }),
				create("UIPadding", { PaddingBottom = UDim.new(0, 2), PaddingLeft = UDim.new(0, 1), PaddingRight = UDim.new(0, 1), PaddingTop = UDim.new(0, 1) }),
			})
		end
		local left, right = column(0), column(0.5)
		local bottom = create("Frame", { Name = "Bottom", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 4, Visible = false, Parent = page }, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 14) }),
		})
		bottom.ChildAdded:Connect(function()
			bottom.Visible = true
		end)
		UI.columns[page] = { left = left, right = right, full = full, bottom = bottom, intro = intro, height = { left = 0, right = 0 } }
		-- Custom rows that a script parents straight to the page land in the open card.
		page.ChildAdded:Connect(function(child)
			if child ~= intro and child ~= full and child ~= holder and child ~= bottom and child:IsA("GuiObject") then
				task.defer(function()
					if child.Parent == page then
						child.Parent = slot(page, child.AbsoluteSize.Y > 0 and child.AbsoluteSize.Y or 24)
					end
				end)
			end
		end)
		pages[name] = page
		table.insert(UI.order, name)
		UI.groups[name] = group or "More"
		return page
	end

	function UI.selectTab(name)
		if not pages[name] then
			return
		end
		for pageName, page in pairs(pages) do
			page.Visible = pageName == name
		end
		for buttonName, tabButton in pairs(tabButtons) do
			local active = buttonName == name
			tabButton.BackgroundColor3 = UI.roles.Main
			tabButton.BackgroundTransparency = active and 0 or 1
			tabButton.TextColor3 = active and UI.roles.Font or UI.roles.Muted
			tabButton.FontFace = active and CODE_BOLD or CODE_MEDIUM
			local bar = tabButton:FindFirstChild("Bar")
			if bar then
				bar.BackgroundColor3 = UI.roles.Accent
				bar.Visible = active
			end
		end
		UI.activeTab = name
		UI.showTip(nil)
	end

	function UI.makeTab(name, order)
		local tabButton = create("TextButton", {
			Name = name,
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = UI.roles.Main,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			FontFace = CODE_MEDIUM,
			Text = name,
			TextSize = px(15),
			TextColor3 = UI.roles.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			LayoutOrder = order or 0,
			Parent = tabBar,
		}, { create("UIPadding", { PaddingLeft = UDim.new(0, 14) }) })
		round(tabButton, 7)
		local bar = create("Frame", { Name = "Bar", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -8, 0.5, 0), Size = UDim2.fromOffset(3, 14), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, Visible = false, Parent = tabButton })
		round(bar, 2)
		tabButtons[name] = tabButton
		tabButton.MouseEnter:Connect(function()
			if UI.activeTab ~= name then
				tabButton.TextColor3 = UI.roles.Font
			end
		end)
		tabButton.MouseLeave:Connect(function()
			if UI.activeTab ~= name then
				tabButton.TextColor3 = UI.roles.Muted
			end
