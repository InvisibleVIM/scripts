---Leaving a running match for the lobby: logged once, the macro recording saved, and the teleport
---asked again every 10 s until it goes through.
function AA.leaveMatch(summary)
	if not Match.leftLogged then
		Match.leftLogged = true
		logMatch(summary)
		saveDetail(summary)
		pcall(AA.Macro.stop)
	end
	Match.ended = true
	invoke("teleport_back_to_lobby")
	task.wait(10)
end

local function matchLoop()
	if IS_LOBBY then
		while AA.alive do
			task.wait(2)
		end
		return
	end
	workspace:WaitForChild("_MAP_CONFIG", 30)
	do
		local started = AA.progress.started
		if type(started) == "table" then
			if started.user == localPlayer.UserId and os.time() - (started.at or 0) < 300 then
				AA.progress.session = { job = game.JobId, mode = started.mode, quest = started.quest }
			end
			AA.progress.started = nil
			AA.saveProgress()
		end
	end
	readLevelData()
	AA.checkExpected()
	AA.startDetail()
	buildPath()
	-- The server's verdict and rewards for the match.
	if not Match.finishHooked then
		Match.finishHooked = true
		local events = replicatedStorage.endpoints:FindFirstChild("server_to_client")
		local switched = events and events:FindFirstChild("load_level_data_changed")
		if switched then
			table.insert(AA.connections, switched.OnClientEvent:Connect(function(levelData)
				if type(levelData) == "table" and levelData.id then
					Match.levelData, Match.levelId, Match.levelPushedAt = levelData, levelData.id, os.clock()
				end
			end))
		end
		local finished = events and events:FindFirstChild("game_finished")
		if finished then
			table.insert(AA.connections, finished.OnClientEvent:Connect(function(result)
				if type(result) == "table" then
					Match.result, Match.resultAt = result, os.clock()
				end
			end))
		end
	end
	local lastStart, lastLevel = 0, Match.levelId
	while AA.alive do
		if gameFinished() then
			if not Match.ended then
				finishMatch()
			end
			if Match.ended and Config.AutoJoin and matchKind() == "Dungeon" and os.clock() - (Match.dungeonAt or 0) > 6 then
				Match.dungeonAt = os.clock()
				if not AA.dungeonStep() then
					invoke("teleport_back_to_lobby")
				end
			end
			if Match.ended and Config.AutoJoin and matchKind() ~= "Dungeon" then
				-- Still on the result screen a minute later (a vote or teleport that didn't go
				-- through, or the script was reloaded here): the lobby, asked again every 30 s.
				Match.finishedSince = Match.finishedSince or os.clock()
				if os.clock() - Match.finishedSince > (Match.finishedAsked and 30 or 60) then
					Match.finishedSince, Match.finishedAsked = os.clock(), true
					note("stuck", { level = Match.levelId })
					invoke("teleport_back_to_lobby")
				end
			end
			task.wait(0.5)
		else
			Match.finishedSince, Match.finishedAsked = nil, nil
			if Match.ended and Match.leftLogged then
				-- Still here after asking to leave (slow or refused teleport): ask again. This
				-- used to be read as a replay and wiped the match, so the reason for leaving
				-- was forgotten and the run was logged again on every retry.
				invoke("teleport_back_to_lobby")
				task.wait(5)
			elseif Match.ended then
				-- Replayed (or moved to the next act) in the same server: start fresh.
				local want = Match.wantDifficulty
				resetMatch()
				Match.wantDifficulty = want
				readLevelData()
				AA.checkExpected()
				AA.startDetail()
			end
			if Match.levelId ~= lastLevel then
				-- A different act loaded in this server: the road and the placement spots are new.
				lastLevel = Match.levelId
				Match.spots, Match.badSpots, Match.totalWaves, Match.infinite = nil, {}, nil, nil
				buildPath()
				AA.startDetail()
			end
			if Config.AutoSkip then
				local hold = AA.holdSkip()
				if hold ~= Match.skipHeld then
					Match.skipHeld = hold
					note("skip", { on = not hold })
				end
				setGameSetting("autoskip_waves", not hold)
			end
			if Config.SkipCards then
				setGameSetting("skip_card_votes", true)
			end
			if not gameStarted() then
				status = "Waiting to start"
				-- A match that never starts (stuck vote, broken server) is left after 3 minutes.
				Match.idleSince = Match.idleSince or os.clock()
				if Config.AutoJoin and os.clock() - Match.idleSince > 180 then
					Match.idleSince = os.clock()
					note("stuck", {})
					invoke("teleport_back_to_lobby")
				end
				-- Some servers let the players vote the difficulty of a replay / next act.
				local data = mapData()
				local difficulty = data and data:FindFirstChild("Difficulty")
				local decided = difficulty and difficulty:FindFirstChild("DifficultyDecided")
				if decided and decided.Value == false then
					if os.clock() - (Match.difficultyAt or 0) > 2 then
						Match.difficultyAt = os.clock()
						local want = Match.wantDifficulty or Config.Difficulty
						note("difficulty", { d = want })
						invoke("select_difficulty", want)
					end
				elseif Config.AutoStart and os.clock() - lastStart > 3 and os.clock() - (Match.startedAt or 0) >= (Config.StartDelay or 0) then
					lastStart = os.clock()
					readLevelData()
					-- (Spawned: nothing may hold the loop while the server answers.)
					task.spawn(invoke, "vote_start")
					local votes = data and data:FindFirstChild("VoteStart") and data.VoteStart:FindFirstChild("Votes")
					if not Match.voteNoted then
						Match.voteNoted = true
						pcall(function()
							if (Match.laneCount or 1) > 1 then
								local closed = workspace._DATA:GetAttribute("closed_lanes")
								note("lanes", { n = Match.laneCount, names = table.concat(Match.laneNames or {}, ","), closed = tostring(closed or "") })
							end
						end)
						-- Where the player stands on the road at the start (click macros place
						-- around that point): logged to compare with where the units end up.
						pcall(function()
							local root = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
							if root then
								note("standAt", { progress = math.floor(pathProgress(root.Position) * 100), cash = math.floor(stats.resource.Value) })
							end
						end)
						note("vote", { votes = votes and votes.Value, players = #playersService:GetPlayers() })
					end
					if #playersService:GetPlayers() > 1 then
						status = "Voted to start: waiting for the other players"
					end
				end
			else
				Match.idleSince = nil
				local wave = currentWave()
				if Match.missionOpen == nil then
					Match.missionOpen = AA.dailyKillQuest(Match.levelId) ~= nil
				end
				if Config.LeaveAtWave > 0 and wave >= Config.LeaveAtWave and Config.AutoJoin then
					status = "Leaving"
					local summary = { level = Match.levelId, won = true, wave = wave, left = true, at = os.time(), mode = matchKind(), picked = Config.Mode, time = math.floor(os.clock() - Match.startedAt) }
					AA.leaveMatch(summary)
				elseif AA.leaveForChallenge(matchKind()) then
					status = "New challenge: leaving"
					note("leave", { why = "challenge" })
					local summary = { level = Match.levelId, won = false, wave = wave, left = true, at = os.time(), mode = matchKind(), picked = Config.Mode, time = math.floor(os.clock() - Match.startedAt), after = "Challenge" }
					AA.leaveMatch(summary)
				elseif Config.Mode == "Missions" and Config.AutoJoin and Match.missionOpen and not AA.dailyKillQuest(Match.levelId) and os.clock() - Match.startedAt > 30 then
					-- The mission this run was for is complete: claim it and move on.
					status = "Mission complete: leaving"
					note("leave", { why = "mission" })
					local summary = { level = Match.levelId, won = true, wave = wave, left = true, at = os.time(), mode = matchKind(), picked = Config.Mode, time = math.floor(os.clock() - Match.startedAt) }
					AA.leaveMatch(summary)
				elseif Config.AutoJoin and AA.playMode() == "Quests" and os.clock() - Match.startedAt > 20 and AA.Quests.goalDone() then
					-- The quest this match was started for is done: claim it and take the next one.
					status = "Quest done: leaving"
					note("leave", { why = "quest" })
					local summary = { level = Match.levelId, won = true, wave = wave, left = true, at = os.time(), mode = matchKind(), picked = Config.Mode, time = math.floor(os.clock() - Match.startedAt) }
					AA.leaveMatch(summary)
				elseif (Config.LeaveAfterMinutes or 0) > 0 and Config.AutoJoin and os.clock() - Match.startedAt >= Config.LeaveAfterMinutes * 60 then
					status = "Time up: leaving"
					note("leave", { why = "minutes" })
					local summary = { level = Match.levelId, won = true, wave = wave, left = true, at = os.time(), mode = matchKind(), picked = Config.Mode, time = math.floor(os.clock() - Match.startedAt) }
					AA.leaveMatch(summary)
				elseif Config.SellAtWave > 0 and wave >= Config.SellAtWave then
					status = "Sold out"
					sellAll()
				else
					if (Config.SellFarmsAtWave or 0) > 0 and wave >= Config.SellFarmsAtWave and not Match.farmsSold then
						-- Farms have paid what they will: their refund goes back into damage.
						Match.farmsSold = true
						for _, unit in ipairs(myUnits()) do
							local farmData = Units[unit._stats.id.Value]
							if farmData and unitStatsAt(farmData, farmData.upgrade and #farmData.upgrade or 0).farm > 0 then
								note("sell", { u = unit._stats.id.Value, why = "farm wave" })
								invoke("sell_unit_ingame", unit)
							end
						end
					end
					matchStep()
					useAbilities()
					AA.useSpells()
					targetingStep()
					-- Log: one snapshot per wave, and every hit the base takes.
					local health = baseHealth()
					if Detail.lastHealth and health < Detail.lastHealth - 0.01 then
						note("leak", { lost = math.floor((Detail.lastHealth - health) * 10) / 10, hp = math.floor(health) })
						AA.noteLeak(wave)
					end
					Detail.lastHealth = health
					-- Seconds my towers spend stunned, per wave (what Explosive Deaths really costs).
					do
						local nowClock = os.clock()
						local stunned = 0
						for _, unit in ipairs(myUnits()) do
							local flag = unit._stats:FindFirstChild("unit_stunned")
							if flag and tonumber(flag.Value) and flag.Value > 0 then
								stunned += 1
							end
						end
						Detail.stunSecs = (Detail.stunSecs or 0) + stunned * math.min(nowClock - (Detail.stunAt or nowClock), 2)
						Detail.stunAt = nowClock
					end
					if wave ~= Detail.lastWave then
						if (Detail.stunSecs or 0) >= 1 then
							note("stun", { secs = math.floor(Detail.stunSecs) })
						end
						Detail.stunSecs = 0
						Detail.lastWave = wave
						local out = {}
						for _, unit in ipairs(myUnits()) do
							local id = unit._stats.id.Value
							out[id] = (out[id] or "") .. unit._stats.upgrade.Value
						end
						local eventCash = stats:FindFirstChild("_resource" .. tostring((Match.levelData or {}).roguelike_multiplier_resource))
						table.insert(Detail.waves, { w = wave, t = math.floor(os.clock() - Match.startedAt), cash = math.floor(stats.resource.Value), hp = math.floor(health), units = out, pace = Match.pace, top = Match.lastOptions and Match.lastOptions[1] or nil, res = eventCash and eventCash.Value or nil, mult = Match.roguelike and Match.roguelike.candy_multiplier or nil })
					end
				end
			end
			task.wait(0.25)
		end
	end
end

