-- The window: the list of pages down the left side, a strip across the top that says what the
-- script is doing, and the page under it. A page is an introduction, optional full-width blocks,
-- and two columns of cards; every card says on which side it goes, so related settings stay
-- together. Rows read "name, short note, control on the right".
local UI = { order = {}, current = {}, columns = {}, refreshers = {}, capturing = false, groups = {} }
AA.ui = UI

-- (In a function of its own, like the pages: the main chunk has no registers to spare.)
;(function()
	local THEME = {
		-- Dusk: ink-blue night with the gold of the gems the script farms.
		{ role = "Background", key = "ThemeBackground", default = "11141D" },
		{ role = "Main", key = "ThemeMain", default = "191E2B" },
		{ role = "Accent", key = "ThemeAccent", default = "F2B33D" },
		{ role = "Outline", key = "ThemeOutline", default = "2A3145" },
		{ role = "Font", key = "ThemeFont", default = "E8EBF3" },
	}
	UI.THEME = THEME

	-- Type. The menu carries its own typeface instead of using one of Roblox's built-in families:
	-- Fishstrap (and Bloxstrap) replace the font files those families point at, so every
	-- "rbxasset://fonts/families/..." name renders in the user's custom font (measured on this
	-- client: Oswald, Arcade, Source Sans and Builder Sans all came out the same 279 px wide).
	-- Families from the Creator Store are fetched by asset id and are not touched by that
	-- (Barlow 170 px, Inter 194 px for the same line).
	-- Barlow: built for road signs and dashboards, narrow enough that a setting's full name fits
	-- a column, with clear numerals. Inter is the stand-in if Barlow can't be fetched; if neither
	-- loads, the menu falls back to a built-in family and shrinks its text to the same widths.
	local Type = { own = false, scale = 1, name = "Builder Sans", family = "rbxasset://fonts/families/BuilderSans.json" }
	UI.type = Type
