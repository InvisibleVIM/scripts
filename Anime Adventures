	---A grid of figures (big value over its name); returns name -> value label.
	function UI.tiles(page, names, perRow)
		perRow = perRow or 2
		local rows = math.ceil(#names / perRow)
		local grid = UI.rowBase(page, rows * 60 + (rows - 1) * 8, false)
		grid.AutomaticSize = Enum.AutomaticSize.None
		create("UIGridLayout", { CellSize = UDim2.new(1 / perRow, -8 * (perRow - 1) / perRow, 0, 60), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
		local values = {}
		for index, name in ipairs(names) do
			local tile = create("Frame", { BackgroundColor3 = UI.roles.Control, BorderSizePixel = 0, LayoutOrder = index, Parent = grid }, { create("UICorner", { CornerRadius = UDim.new(0, 8) }) })
			values[name] = label({ Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 26), Text = "0", FontFace = CODE_BOLD, TextSize = px(22), TextTruncate = Enum.TextTruncate.AtEnd, Parent = tile })
			label({ Position = UDim2.fromOffset(12, 35), Size = UDim2.new(1, -24, 0, 16), Text = name, TextSize = px(13), TextColor3 = UI.roles.Muted, TextTruncate = Enum.TextTruncate.AtEnd, Parent = tile })
		end
		return values
	end
	---A stack of rows that is rebuilt whenever its content changes (banner odds, drop tables).
	---Returns set(rows). A row is one of:
	---  { title = "Summer 2026", right = "150 Summer Pearls a pull" }   group heading
	---  { name = "Phoenix", value = "0.25%", extra = "1 in 400", accent = true, tick = true }
	---  { note = "..." }                                               wrapped small print
	---  { gap = true }
	function UI.list(page)
		local body = slot(page, 80)
		local holder = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = UI.nextOrder(),
			Parent = body,
		}, { create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }) })
		-- A hint() after the list becomes a "?" at the end of the card's title.
		local head = body:FindFirstChild("Head")
		if head then
			UI.markRow(page, head, UDim2.new(1, 0, 0, 1), head:FindFirstChild("Title"))
		end
		local signature
		return function(rows)
			local now = httpService:JSONEncode(rows)
			if now == signature then
				return
			end
			signature = now
			for _, child in ipairs(holder:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			for index, row in ipairs(rows) do
				if row.gap then
					create("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundTransparency = 1, LayoutOrder = index, Parent = holder })
				elseif row.title then
					local head = create("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = index, Parent = holder }, {
						create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
					})
					label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = row.title, FontFace = CODE_BOLD, TextSize = px(14), LayoutOrder = 1, Parent = head })
					create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = label({ Size = UDim2.new(0, 0, 1, 0), Text = row.right or "", TextSize = px(13), TextColor3 = UI.roles.Muted, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 2, Parent = head }) })
				elseif row.note then
					wrapped({ Size = UDim2.new(1, 0, 0, 16), Text = row.note, TextSize = px(13), TextColor3 = UI.roles.Muted, LayoutOrder = index, Parent = holder })
				else
					local line = create("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = UI.roles.Control, BorderSizePixel = 0, LayoutOrder = index, Parent = holder }, {
						create("UICorner", { CornerRadius = UDim.new(0, 6) }),
						create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
						create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }),
					})
					if row.accent then
						create("Frame", { Size = UDim2.fromOffset(3, 14), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, LayoutOrder = 1, Parent = line }, { create("UICorner", { CornerRadius = UDim.new(0, 2) }) })
					end
					local name = label({ Size = UDim2.new(0, 0, 1, 0), Text = tostring(row.name), TextSize = px(14), FontFace = row.accent and CODE_MEDIUM or CODE, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 2, Parent = line })
					create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = name })
					if row.tick then
						icon(line, "check", 12, WIN, { LayoutOrder = 3 }):SetAttribute("NoTheme", true)
					end
					if row.extra then
						label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = row.extra, TextSize = px(13), TextColor3 = UI.roles.Muted, LayoutOrder = 4, Parent = line })
					end
					if row.value then
						label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = row.value, TextSize = px(14), FontFace = CODE_MEDIUM, TextXAlignment = Enum.TextXAlignment.Right, LayoutOrder = 5, Parent = line })
					end
				end
			end
		end
	end

	---Unfolding option list under a row (scrolls past 8 options).
	local function optionList(row, onChoose)
		local list = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = UI.roles.Outline,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
			LayoutOrder = UI.nextOrder(),
			Parent = row.Parent,
		}, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
			create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 8) }),
		})
		round(list, 7)
		stroke(list, "Outline")
		local function fill(entries)
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("TextButton") then
					child:Destroy()
				end
			end
			for index, entry in ipairs(entries) do
				local item = create("TextButton", {
					Size = UDim2.new(1, 0, 0, 28),
					BackgroundColor3 = UI.roles.Raised,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					FontFace = entry.current and CODE_BOLD or CODE,
					Text = tostring(entry.text),
					TextSize = px(14),
					TextColor3 = entry.current and UI.roles.Accent or UI.roles.Font,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					AutoButtonColor = false,
					LayoutOrder = index,
					Parent = list,
				}, { create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
				round(item, 5)
				item.MouseEnter:Connect(function()
					item.BackgroundTransparency = 0
				end)
				item.MouseLeave:Connect(function()
					item.BackgroundTransparency = 1
				end)
				item.MouseButton1Click:Connect(function()
					list.Visible = false
					onChoose(entry.value)
				end)
			end
			list.Size = UDim2.new(1, 0, 0, math.min(#entries, 8) * 30 + 6)
		end
		return list, fill
	end

	---The box of a drop-down: its value and a mark that it opens.
	local function valueBox(row)
		local box = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = 2,
			Parent = row,
		})
		round(box, 7)
		local outline = stroke(box, "Outline")
		box.MouseEnter:Connect(function()
			outline.Color = UI.roles.Muted
		end)
		box.MouseLeave:Connect(function()
			outline.Color = UI.roles.Outline
		end)
		local value = label({ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -38, 1, 0), Text = "", TextSize = px(14), TextTruncate = Enum.TextTruncate.AtEnd, Parent = box })
		icon(box, "down", 12, UI.roles.Muted, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -11, 0.5, 0) })
		return box, value
	end
	---The shared body of both drop-downs: name (and note) above, the box under it.
	local function dropRow(page, text, note)
		local row = UI.rowBase(page, 56, false)
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = row })
		local top = create("Frame", { Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = row })
		local holder = caption(top, text, note, 0)
		UI.markRow(page, top, UDim2.new(1, 0, 0, 2), holder, row)
		return row
	end

	---Pick-one drop-down for lists of option tables ({ ..., name =, current = }).
	function UI.cycler(page, text, getOptions, getLabel, onPick, note)
		local row = dropRow(page, text, note)
		local box, value = valueBox(row)
		local function refresh()
			value.Text = tostring(getLabel())
		end
		local list, fill = optionList(row, function(option)
			onPick(option)
			UI.refreshAll()
		end)
		box.MouseButton1Click:Connect(function()
			list.Visible = not list.Visible
			if list.Visible then
				local entries = {}
				for _, option in ipairs(getOptions()) do
					local name = option.name or option.label or option.id or option.uid or option.slot
					table.insert(entries, { text = (name == "" or name == nil) and "None" or name, value = option, current = option.current })
				end
				fill(entries)
			end
		end)
		table.insert(UI.refreshers, refresh)
		refresh()
		return refresh
	end

	---Drop-down over plain string options.
	function UI.dropdown(page, text, getOptions, getValue, onPick, note)
		local row = dropRow(page, text, note)
		local box, value = valueBox(row)
		local function refresh()
			value.Text = tostring(getValue() or "None")
		end
		local list, fill = optionList(row, function(option)
			onPick(option)
			UI.refreshAll()
		end)
		box.MouseButton1Click:Connect(function()
			list.Visible = not list.Visible
			if list.Visible then
				local entries = {}
				-- An option is a string, or { text = what the row shows, value = what is picked }.
				for _, option in ipairs(getOptions()) do
					if type(option) == "table" then
						table.insert(entries, { text = option.text, value = option.value, current = option.value == getValue() })
					else
						table.insert(entries, { text = option, value = option, current = option == getValue() })
					end
				end
				fill(entries)
			end
		end)
		table.insert(UI.refreshers, refresh)
		refresh()
		return refresh
	end

	---Shared look and press feedback of every push button. props.Primary fills it with the accent.
	local function pushButton(props, text, action)
		local primary = props.Primary
		props.Primary = nil
		props.BackgroundColor3 = primary and UI.roles.Accent or UI.roles.Control
		props.BorderSizePixel = 0
		props.FontFace = primary and CODE_BOLD or CODE_MEDIUM
		props.Text = text
		props.TextSize = px(15)
		props.TextColor3 = primary and UI.onAccent() or UI.roles.Font
		props.TextTruncate = Enum.TextTruncate.AtEnd
		props.AutoButtonColor = false
		local buttonFrame = create("TextButton", props)
		round(buttonFrame, 7)
		local outline = stroke(buttonFrame, primary and "Accent" or "Outline")
		buttonFrame.MouseEnter:Connect(function()
			if primary then
				buttonFrame.BackgroundTransparency = 0.12
			else
				buttonFrame.BackgroundColor3 = UI.roles.Raised
				outline.Color = UI.roles.Muted
			end
		end)
		buttonFrame.MouseLeave:Connect(function()
			if primary then
				buttonFrame.BackgroundTransparency = 0
			else
				buttonFrame.BackgroundColor3 = UI.roles.Control
				outline.Color = UI.roles.Outline
			end
		end)
		if primary then
			table.insert(UI.colorRefreshers, function()
				buttonFrame.BackgroundColor3, buttonFrame.TextColor3, outline.Color = UI.roles.Accent, UI.onAccent(), UI.roles.Accent
			end)
		end
		buttonFrame.MouseButton1Click:Connect(function()
			if not action then
				return
			end
			task.spawn(function()
				buttonFrame.Text = "Working"
				local ok, message = pcall(action)
				pcall(function()
					buttonFrame.Text = (ok and message) and tostring(message) or text
				end)
				UI.refreshAll()
				task.wait(1.5)
				pcall(function()
					buttonFrame.Text = text
				end)
			end)
		end)
		return buttonFrame
	end
	UI.colorRefreshers = {}

	function UI.button(page, text, action, primary)
		local made = pushButton({ Size = UDim2.new(1, 0, 0, 34), LayoutOrder = UI.nextOrder(), Parent = slot(page, 34), Primary = primary }, text, action)
		UI.lastRow[page] = nil
		return made
	end

	---Two buttons side by side in one row.
	function UI.buttonPair(page, leftText, leftAction, rightText, rightAction)
		local row = UI.rowBase(page, 34, false)
		row.AutomaticSize = Enum.AutomaticSize.None
		UI.lastRow[page] = nil
		pushButton({ Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(0.5, -4, 1, 0), Parent = row }, leftText, leftAction)
		pushButton({ Position = UDim2.new(0.5, 4, 0, 0), Size = UDim2.new(0.5, -4, 1, 0), Parent = row }, rightText, rightAction)
		return row
	end

	local SHORT_KEYS = { RightControl = "Right Ctrl", LeftControl = "Left Ctrl", RightShift = "Right Shift", LeftShift = "Left Shift", RightAlt = "Right Alt", LeftAlt = "Left Alt", Insert = "Insert", Delete = "Delete" }
	function UI.keybind(page, text, key, note)
		local row = UI.rowBase(page, 30, false)
		local holder = caption(row, text, note, 116)
		UI.markRow(page, row, UDim2.new(1, -112, 0, 2), holder)
		local box = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(106, 30),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			FontFace = CODE_MEDIUM,
			TextSize = px(14),
			TextColor3 = UI.roles.Font,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AutoButtonColor = false,
			Parent = row,
		})
		round(box, 7)
		stroke(box, "Outline")
		local function refresh()
			box.Text = SHORT_KEYS[Config[key]] or tostring(Config[key])
			if key == "MenuKey" and UI.keyHint then
				UI.keyHint.Text = box.Text .. " hides the menu"
			end
		end
		box.MouseButton1Click:Connect(function()
			UI.capturing = true
			box.Text = "Press a key"
			local connection
			connection = userInputService.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then
					return
				end
				connection:Disconnect()
				if input.KeyCode ~= Enum.KeyCode.Escape then
					Config[key] = input.KeyCode.Name
				end
				refresh()
				task.defer(function()
					UI.capturing = false
				end)
			end)
		end)
		refresh()
		return row
	end

