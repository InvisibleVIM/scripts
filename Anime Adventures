-- ============================================================
--  Trait rolls
-- ============================================================
-- One unit, a list of traits worth keeping, and a loop that rolls until one of them lands.
-- A roll is one request. The server answers it twice: the request returns, and a
-- unit_traits_changed event carries the new traits. Nothing is sent while an answer is still
-- owed, and nothing is rolled on a reading older than the last roll: a roll that was paid for
-- but never reported stops the run instead of being followed by another.
do
	local Traits = { state = "idle", text = "", serial = 0, recent = {} }
	AA.Traits = Traits
	local store = type(AA.progress.traits) == "table" and AA.progress.traits or {}
	AA.progress.traits = store
	store.want = type(store.want) == "table" and store.want or {}
	store.rolls = type(store.rolls) == "table" and store.rolls or {}
	Traits.store = store
	-- Seconds: how long a request may stay unanswered, how long its event may trail the answer,
	-- and the pause between two rolls (the game's own window refuses a second roll while the
	-- first is in flight; the lobby server drops requests sent faster than one per 0.75 s).
	Traits.TIMEOUT, Traits.SETTLE, Traits.GAP = 45, 6, 1.2
	Traits.MAX_REFUSALS = 3
	local ROMAN = { "I", "II", "III", "IV", "V", "VI" }
	local RANK = { Rare = 1, Epic = 2, Legendary = 3, Mythic = 4, Secret = 5 }
	-- Percent a roll, as the game's own rate panel lists them (they add up to 100). Read again
	-- from the panel whenever it is loaded.
	local ODDS = {
		["superior:1"] = 14.98, ["superior:2"] = 10.48, ["superior:3"] = 4.5,
		["range:1"] = 12.48, ["range:2"] = 8.74, ["range:3"] = 3.75,
		["nimble:1"] = 12.48, ["nimble:2"] = 8.74, ["nimble:3"] = 3.75,
		neuroplasticity = 9.99, culling = 5, sniper = 2.5, godspeed = 1, reaper = 0.8,
		ethereal = 0.36, divine = 0.2, golden = 0.15, unique = 0.1,
	}
	local ITEMS = { limited = "star_remnant_limited", remnants = "star_remnant", legacy = "trait_reroll_legacy" }
	Traits.ITEMS = ITEMS

	local options, byKey
	---Every trait a roll can land, one entry per tier: { key, id, tier, name, rarity, odds }.
	---key is "superior:3" for a tiered trait and the plain id otherwise.
	function Traits.options()
		if options then
			return options, byKey
		end
		local data = gameRequire(replicatedStorage.src.Data.Traits)
		local list, map = {}, {}
		for id, info in pairs(type(data) == "table" and type(data.info) == "table" and data.info or {}) do
			if type(info) == "table" then
				local tiers = math.clamp(tonumber(gameCall(Core.Trait and Core.Trait.get_tier_count, id)) or 1, 1, 6)
				for tier = 1, tiers do
					local key = tiers > 1 and (id .. ":" .. tier) or id
					local entry = {
						key = key,
						id = id,
						tier = tier,
						tiers = tiers,
						name = tostring(info.name or id) .. (tiers > 1 and (" " .. ROMAN[tier]) or ""),
						rarity = type(info.tier_rarity) == "table" and info.tier_rarity[tostring(tier)] or info.rarity or "Rare",
						odds = ODDS[key],
					}
					table.insert(list, entry)
					map[key] = entry
				end
			end
		end
		-- The panel's own numbers, when the game has built it.
		pcall(function()
			local panel = localPlayer.PlayerGui:FindFirstChild("TraitReroll")
			local byName = {}
			for _, object in ipairs(panel and panel:GetDescendants() or {}) do
				if object.Name == "TraitName" and object:IsA("TextLabel") then
					local chance = object.Parent:FindFirstChild("Chance")
					local value = chance and tonumber((tostring(chance.Text):gsub("[^%d%.]", "")))
					if value then
						byName[object.Text:lower()] = value
					end
				end
			end
			local found = 0
			for _, entry in ipairs(list) do
				local value = byName[entry.name:lower()]
				if value then
					entry.odds = value
					found += 1
				end
			end
			Traits.oddsLive = found > 0
		end)
		table.sort(list, function(a, b)
			if (a.odds or 1000) ~= (b.odds or 1000) then
				return (a.odds or 1000) < (b.odds or 1000)
			end
			return a.key < b.key
		end)
		if #list > 0 then
			options, byKey = list, map
		end
		return list, map
	end

	---The traits on an owned copy, in the game's order: { { key, id, tier, name, rarity } }.
	function Traits.of(unit)
		local list = {}
		local _, map = Traits.options()
		local slots = {}
		for slot in pairs(type(unit) == "table" and type(unit.traits) == "table" and unit.traits or {}) do
			table.insert(slots, slot)
		end
		table.sort(slots, function(a, b)
			return tostring(a) < tostring(b)
		end)
		for _, slot in ipairs(slots) do
			local entry = unit.traits[slot]
			local id = type(entry) == "table" and entry.trait or entry
			if type(id) == "string" and id ~= "" then
				local tier = tonumber(type(entry) == "table" and entry.tier) or 1
				local known = map[id .. ":" .. tier] or map[id]
				table.insert(list, known or { key = id, id = id, tier = tier, name = id, rarity = "Rare", unknown = true })
			end
		end
		return list
	end
	function Traits.label(unit)
		local names = {}
		for _, trait in ipairs(Traits.of(unit)) do
			table.insert(names, trait.name)
		end
		return #names == 0 and "No trait" or table.concat(names, " and ")
	end
	---One string per reading: two readings with the same string carry the same traits.
	function Traits.sig(unit)
		local keys = {}
		for _, trait in ipairs(Traits.of(unit)) do
			table.insert(keys, trait.id .. ":" .. trait.tier)
		end
		return table.concat(keys, "|")
	end

	function Traits.wanted(uuid)
		local list = store.want[tostring(uuid)]
		return type(list) == "table" and list or {}
	end
	function Traits.wants(uuid, key)
		return table.find(Traits.wanted(uuid), key) ~= nil
	end
	---Tick or untick a trait for one unit. Takes effect on the very next reading, mid-run too.
	function Traits.toggleWant(uuid, key)
		uuid = tostring(uuid)
		local list = table.clone(Traits.wanted(uuid))
		local found = table.find(list, key)
		if found then
			table.remove(list, found)
		else
			table.insert(list, key)
		end
		store.want[uuid] = #list > 0 and list or nil
		AA.saveProgress()
	end
	---The first trait on the copy that is on its list (its name), or nil.
	function Traits.match(unit, uuid)
		local want = Traits.wanted(uuid)
		for _, trait in ipairs(Traits.of(unit)) do
			if table.find(want, trait.key) then
				return trait.name
			end
		end
		return nil
	end
	---A Mythic trait on the copy that is not on its list: rolling again would throw it away.
	function Traits.rareOffList(unit, uuid)
		local want = Traits.wanted(uuid)
		for _, trait in ipairs(Traits.of(unit)) do
			if (RANK[trait.rarity] or 0) >= RANK.Mythic and not table.find(want, trait.key) then
				return trait.name
			end
		end
		return nil
	end
	---Percent a roll that one roll lands something on the list.
	function Traits.chance(uuid)
		local _, map = Traits.options()
		local total = 0
		for _, key in ipairs(Traits.wanted(uuid)) do
			total += map[key] and map[key].odds or 0
		end
		return total
	end

	---What can pay for a roll on this copy. Star Remnants: the game takes 5 a roll on a Mythic
	---or Secret unit and 1 on anything else (TraitServiceCore.get_reroll_requirements).
	function Traits.resources(unit)
		local unitData = type(unit) == "table" and Units[unit.unit_id] or nil
		local rarity = unitData and unitData.rarity
		local per = tonumber(gameCall(Core.Trait and Core.Trait.get_reroll_requirements, rarity, "reroll_trait", ITEMS.remnants))
		if not per or per < 1 then
			per = (rarity == "Mythic" or rarity == "Secret") and 5 or 1
		end
		local legacyUnits = Core.Unit and Core.Unit.LEGACY_UNITS
		local isLegacy = type(legacyUnits) == "table" and unit ~= nil and legacyUnits[unit.unit_id] ~= nil
		return {
			tokens = tonumber(profile().trait_reroll_tokens) or 0,
			limited = itemCount(ITEMS.limited),
			remnants = itemCount(ITEMS.remnants),
			legacy = isLegacy and itemCount(ITEMS.legacy) or 0,
			per = per,
		}
	end
	---The order things are spent in. Limited remnants go first (they expire), legacy rerolls
	---before tokens (they only work on old units).
	local function spendOrder(use)
		if use == "Remnants" then
			return { "limited", "remnants" }
		elseif use == "Both" then
			return { "limited", "remnants", "legacy", "tokens" }
		end
		return { "legacy", "tokens" }
	end
	local function costOf(res, kind)
		return (kind == "limited" or kind == "remnants") and res.per or 1
	end
	---Rolls the chosen resources still pay for.
	function Traits.rollsLeft(res, use)
		local total = 0
		for _, kind in ipairs(spendOrder(use)) do
			total += math.floor((res[kind] or 0) / costOf(res, kind))
		end
		return total
	end
	---What the next roll is paid with: { kind, cost, item } or nil when nothing is left.
	function Traits.nextPayment(res, use)
		for _, kind in ipairs(spendOrder(use)) do
			local cost = costOf(res, kind)
			if (res[kind] or 0) >= cost then
				return { kind = kind, cost = cost, item = ITEMS[kind] }
			end
		end
		return nil
	end
	---Everything spendable, as one number that only ever goes down when a roll is paid.
	local function purse(res)
		return res.tokens + res.limited + res.remnants + res.legacy
	end
	function Traits.emptyText(use)
		if use == "Remnants" then
			return "Out of Star Remnants."
		elseif use == "Both" then
			return "Out of Star Remnants and reroll tokens."
		end
		return "Out of reroll tokens."
	end

	---The request itself. Trait rerolls bought with Robux are never sent.
	function Traits.send(uuid, payment)
		if payment.kind == "tokens" then
			return invoke("request_token_trait_reroll", uuid)
		end
		return invoke("use_item", payment.item, { unit_uuid = uuid })
	end
	function Traits.unit(uuid)
		local owned = collectionData().owned_units
		return type(owned) == "table" and owned[tostring(uuid)] or nil
	end
	function Traits.unitName(unit)
		local unitData = type(unit) == "table" and Units[unit.unit_id]
		return tostring(unitData and unitData.name or (unit and unit.unit_id) or "The unit")
	end

	-- The server's own word on a roll: the new traits of the unit.
	do
		local events = replicatedStorage.endpoints:FindFirstChild("server_to_client")
		local changed = events and events:FindFirstChild("unit_traits_changed")
		if changed then
			table.insert(AA.connections, changed.OnClientEvent:Connect(function(uuid, traits)
				Traits.serial += 1
				Traits.lastEvent = { uuid = tostring(uuid), traits = traits, serial = Traits.serial, at = os.clock() }
				if AA.Eval then
					AA.Eval.forget(tostring(uuid))
				end
			end))
		end
	end

	local function persist()
		local run = Traits.run
		store.run = run and { uuid = run.uuid, rolls = run.rolls, at = os.time() } or nil
		AA.saveProgress()
	end
	local function finish(state, text, title)
		local run = Traits.run
		Traits.run = nil
		Traits.state, Traits.text = state, text
		Traits.ended = { state = state, text = text, uuid = run and run.uuid, rolls = run and run.rolls or 0, at = os.clock() }
		persist()
		if title and AA.traitNotice then
			pcall(AA.traitNotice, title, text, 12)
		end
	end
	Traits.finish = finish

	---May a run start for this unit? Returns ok, reason. `confirmed`: the user has seen that the
	---copy carries a Mythic trait (or two traits) the roll would replace.
	function Traits.check(uuid, confirmed)
		uuid = tostring(uuid or "")
		if Traits.run then
			return false, "Already rolling for " .. Traits.unitName(Traits.unit(Traits.run.uuid)) .. ". Stop that run first."
		end
		local unit = Traits.unit(uuid)
		if uuid == "" or not unit then
			return false, "Pick a unit first."
		end
		if #Traits.wanted(uuid) == 0 then
			return false, "Tick at least one trait to stop on."
		end
		local hit = Traits.match(unit, uuid)
		if hit then
			return false, Traits.unitName(unit) .. " already has " .. hit .. ". Nothing to roll."
		end
		local res = Traits.resources(unit)
		if not Traits.nextPayment(res, Config.TraitUse) then
			return false, Traits.emptyText(Config.TraitUse)
		end
		if not confirmed then
			local rare = Traits.rareOffList(unit, uuid)
			if rare then
				return false, Traits.unitName(unit) .. " has " .. rare .. ", a Mythic trait that is not on your list. Press Start again to roll it away.", true
			end
			if #Traits.of(unit) > 1 then
				return false, Traits.unitName(unit) .. " carries two traits. A roll replaces both. Press Start again to go ahead.", true
			end
		end
		return true
	end
	function Traits.start(uuid)
		uuid = tostring(uuid or "")
		local confirm = Traits.confirm
		local confirmed = confirm ~= nil and confirm.uuid == uuid and os.clock() - confirm.at < 20
		local ok, reason, needsConfirm = Traits.check(uuid, confirmed)
		if not ok then
			Traits.confirm = needsConfirm and { uuid = uuid, at = os.clock() } or nil
			if not Traits.run then
				Traits.state, Traits.text = needsConfirm and "confirm" or "idle", reason
			end
			return false, reason
		end
		Traits.confirm = nil
		Traits.run = { uuid = uuid, rolls = 0, refusals = 0, startedAt = os.clock(), confirmed = confirmed }
		Traits.recent = {}
		Traits.state, Traits.text = "rolling", "Starting."
		persist()
		return true
	end
	---Ends the run after the request that is in flight (a sent roll cannot be taken back).
	function Traits.stop()
		local run = Traits.run
		if run then
			run.stop = true
			if not run.waiting then
				finish("stopped", "Stopped after " .. run.rolls .. (run.rolls == 1 and " roll." or " rolls."))
			else
				Traits.text = "Stopping once the roll in flight is answered."
			end
		end
	end

	---One pass of the run: read, decide, and at most one request. Returns false when the run ended.
	function Traits.step()
		local run = Traits.run
		if not run then
			return false
		end
		local uuid = run.uuid
		-- 1. The unit, as the collection has it now.
		local unit = Traits.unit(uuid)
		if not unit then
			if next(collectionData().owned_units or {}) == nil then
				-- The collection itself is not loaded (teleport, loading screen): wait, don't judge.
				Traits.state, Traits.text = "waiting", "Waiting for your collection to load."
				task.wait(1)
				return true
			end
			finish("stopped", "The unit is no longer in your collection. Stopped after " .. run.rolls .. " rolls.", "Trait rolls stopped")
			return false
		end
		local name = Traits.unitName(unit)
		-- 2. What it carries. A trait on the list ends the run before anything is sent.
		local hit = Traits.match(unit, uuid)
		if hit then
			finish("done", name .. " has " .. hit .. (run.rolls > 0 and (" after " .. run.rolls .. (run.rolls == 1 and " roll." or " rolls.")) or "."), "Trait landed")
			return false
		end
		if run.stop then
			finish("stopped", "Stopped after " .. run.rolls .. (run.rolls == 1 and " roll." or " rolls."))
			return false
		end
		-- A Mythic trait that is not on the list is not rolled away without a second look. (The
		-- first roll of a run is the one the user confirmed.)
		local rare = Config.TraitStopMythic and run.rolls > 0 and Traits.rareOffList(unit, uuid)
		if rare then
			finish("stopped", name .. " landed " .. rare .. ", a Mythic trait that is not on your list. Stopped so you can decide.", "Mythic trait landed")
			return false
		end
		-- 3. What pays for the roll.
		local res = Traits.resources(unit)
		local payment = Traits.nextPayment(res, Config.TraitUse)
		if not payment then
			finish("stopped", Traits.emptyText(Config.TraitUse) .. " " .. name .. " still has " .. Traits.label(unit) .. " after " .. run.rolls .. " rolls.", "Trait rolls stopped")
			return false
		end
		-- 4. One request. Nothing else leaves until it is answered.
		local before = { sig = Traits.sig(unit), serial = Traits.serial, purse = purse(res) }
		local reply = { done = false, sentAt = os.clock() }
		Traits.pending = reply
		run.waiting = true
		Traits.state, Traits.text = "rolling", "Roll " .. (run.rolls + 1) .. " sent. Waiting for the result."
		task.spawn(function()
			local ok, first = Traits.send(uuid, payment)
			setthreadidentity(8)
			reply.ok, reply.first, reply.at, reply.done = ok, first, os.clock(), true
		end)
		local outcome, event
		while AA.alive do
			task.wait(0.1)
			local seen = Traits.lastEvent
			if seen and seen.serial > before.serial and seen.uuid == uuid then
				outcome, event = "rolled", seen
				break
			end
			local now = Traits.unit(uuid)
			if now and Traits.sig(now) ~= before.sig then
				outcome = "rolled"
				break
			end
			local paid = now ~= nil and purse(Traits.resources(now)) < before.purse
			if reply.done then
				if os.clock() - reply.at >= (paid and Traits.SETTLE or 2.5) then
					outcome = paid and "blind" or "refused"
					break
				end
			elseif os.clock() - reply.sentAt >= Traits.TIMEOUT then
				outcome = paid and "blind" or "silent"
				break
			end
		end
		run.waiting = false
		if not AA.alive then
			return false
		end
		if outcome == "rolled" then
			run.rolls += 1
			run.refusals = 0
			store.rolls[uuid] = (tonumber(store.rolls[uuid]) or 0) + 1
			-- The reading that decides. The event carries the server's own word; the game writes
			-- it into the collection in the same moment, and the next pass reads it from there.
			-- Both have to agree before anything else is sent.
			task.wait(0.15)
			local landed = Traits.unit(uuid) or {}
			local synced = true
			local fromEvent = event and type(event.traits) == "table" and { traits = event.traits } or nil
			local understood = fromEvent ~= nil and #Traits.of(fromEvent) > 0
			for _, trait in ipairs(fromEvent and Traits.of(fromEvent) or {}) do
				understood = understood and trait.unknown ~= true
			end
			if understood then
				local target = Traits.sig(fromEvent)
				local waited = 0
				synced = Traits.sig(landed) == target
				while not synced and waited < 3 do
					waited += task.wait(0.1)
					local now = Traits.unit(uuid)
					synced = now ~= nil and Traits.sig(now) == target
				end
				landed = fromEvent
			end
			local label = Traits.label(landed)
			table.insert(Traits.recent, 1, label)
			Traits.recent[9] = nil
			local count = run.rolls .. (run.rolls == 1 and " roll." or " rolls.")
			local hitNow = Traits.match(landed, uuid)
			if hitNow then
				finish("done", name .. " has " .. hitNow .. " after " .. count, "Trait landed")
				return false
			end
			if not synced then
				finish("stopped", "The game did not show the result of roll " .. run.rolls .. " (" .. label .. "). Stopped so nothing is rolled on an old reading.", "Trait rolls stopped")
				return false
			end
			Traits.text = "Roll " .. run.rolls .. " landed " .. label .. "."
			persist()
			task.wait(Traits.GAP)
			return true
		elseif outcome == "blind" then
			run.rolls += 1
			store.rolls[uuid] = (tonumber(store.rolls[uuid]) or 0) + 1
			finish("stopped", "The server took roll " .. run.rolls .. " but never sent its result. Stopped so nothing is rolled on an old reading. Check " .. name .. " and start again.", "Trait rolls stopped")
			return false
		elseif outcome == "silent" then
			finish("stopped", "The server did not answer roll " .. (run.rolls + 1) .. " within " .. Traits.TIMEOUT .. " seconds. Stopped. Nothing was sent twice.", "Trait rolls stopped")
			return false
		end
		-- Refused: answered, nothing paid, nothing changed.
		run.refusals += 1
		local why = ""
		for index = #(AA.messages or {}), 1, -1 do
			local message = AA.messages[index]
			if os.clock() - message.at < 8 then
				why = ' The game said: "' .. message.text .. '".'
				break
			end
		end
		if reply.ok == false and tostring(reply.first) == "missing remote" then
			finish("stopped", "Trait rolls cannot be reached from this place. Stopped after " .. run.rolls .. " rolls.", "Trait rolls stopped")
			return false
		end
		if reply.ok == false and why == "" then
			why = " (" .. tostring(reply.first) .. ")"
		end
		if run.refusals >= Traits.MAX_REFUSALS then
			finish("stopped", "The game refused the roll " .. run.refusals .. " times in a row." .. why .. " Stopped after " .. run.rolls .. " rolls.", "Trait rolls stopped")
			return false
		end
		Traits.state, Traits.text = "waiting", "The game refused the roll." .. why .. " Trying again shortly (" .. run.refusals .. " of " .. Traits.MAX_REFUSALS .. ")."
		task.wait(2 * run.refusals)
		return true
	end

	-- A run that was going when the game teleported picks up where it stopped.
	if type(store.run) == "table" and type(store.run.uuid) == "string" and os.time() - (tonumber(store.run.at) or 0) < 6 * 3600 then
		Traits.run = { uuid = store.run.uuid, rolls = tonumber(store.run.rolls) or 0, refusals = 0, startedAt = os.clock(), resumed = true, confirmed = true }
		Traits.state, Traits.text = "waiting", "Picking the run back up."
	else
		store.run = nil
	end

	supervise("traits", function()
		while AA.alive do
			if Traits.run then
				-- A request from before a restart of this loop is still owed an answer.
				local pending = Traits.pending
				if pending and not pending.done and os.clock() - pending.sentAt < Traits.TIMEOUT + 15 then
					task.wait(0.5)
				elseif session() == nil then
					task.wait(1)
				else
					Traits.step()
				end
			else
				task.wait(0.3)
			end
		end
	end)
end

