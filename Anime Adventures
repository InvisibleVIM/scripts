		})
		create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 53, Parent = square }, {
			create("UICorner", { CornerRadius = UDim.new(0, 4) }),
			create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }),
		})
		local dot = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 55,
			Parent = square,
		}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }), create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }) })
		local hueKeys = {}
		for i = 0, 6 do
			table.insert(hueKeys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 % 1, 1, 1)))
		end
		local hueBar = create("TextButton", {
			Position = UDim2.fromOffset(196, 24),
			Size = UDim2.fromOffset(16, 150),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 51,
			Parent = frame,
		}, { create("UICorner", { CornerRadius = UDim.new(0, 8) }), create("UIGradient", { Rotation = 90, Color = ColorSequence.new(hueKeys) }) })
		local hueKnob = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BorderSizePixel = 0,
			ZIndex = 55,
			Parent = hueBar,
		}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }), create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }) })
		local preview = create("Frame", { Position = UDim2.fromOffset(8, 182), Size = UDim2.fromOffset(20, 16), BorderSizePixel = 0, ZIndex = 51, Parent = frame })
		create("UIStroke", { Color = UI.roles.Outline, Parent = preview })
		local hexBox = create("TextBox", {
			Position = UDim2.fromOffset(34, 182),
			Size = UDim2.fromOffset(90, 16),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			FontFace = CODE,
			TextSize = 13,
			TextColor3 = UI.roles.Font,
			Text = "",
			ClearTextOnFocus = false,
			ZIndex = 51,
			Parent = frame,
		})
		create("UIStroke", { Color = UI.roles.Outline, Parent = hexBox })
		local done = create("TextButton", {
			Position = UDim2.fromOffset(132, 182),
			Size = UDim2.fromOffset(80, 16),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			FontFace = CODE,
			TextSize = 13,
			TextColor3 = UI.roles.Font,
			Text = "Done",
			AutoButtonColor = false,
			ZIndex = 51,
			Parent = frame,
		})
		create("UIStroke", { Color = UI.roles.Outline, Parent = done })
		picker.frame = frame
		for _, object in ipairs({ square, white, dot, hueBar, hueKnob, preview }) do
			object:SetAttribute("NoTheme", true)
		end
		for _, object in ipairs(square:GetChildren()) do
			object:SetAttribute("NoTheme", true)
		end

		local h, s, v, key, anchor = 0, 0, 1, nil, nil
		local function show()
			local color = Color3.fromHSV(h, s, v)
			square.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			dot.Position = UDim2.fromScale(s, 1 - v)
			dot.BackgroundColor3 = color
			hueKnob.Position = UDim2.fromScale(0.5, h)
			hueKnob.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			preview.BackgroundColor3 = color
			if not hexBox:IsFocused() then
				hexBox.Text = "#" .. color:ToHex():upper()
			end
		end
		local function commit()
			if key then
				Config[key] = Color3.fromHSV(h, s, v):ToHex():upper()
				Config.UseDefaultTheme = false
				UI.applyTheme()
			end
			show()
		end
		local dragging = nil
		local function update(position)
			if dragging == "square" then
				s = math.clamp((position.X - square.AbsolutePosition.X) / square.AbsoluteSize.X, 0, 1)
				v = 1 - math.clamp((position.Y - square.AbsolutePosition.Y) / square.AbsoluteSize.Y, 0, 1)
			elseif dragging == "hue" then
				h = math.clamp((position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 0.999)
			end
			commit()
		end
		for target, name in pairs({ [square] = "square", [hueBar] = "hue" }) do
			target.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = name
					update(input.Position)
				end
			end)
		end
		table.insert(AA.connections, userInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				update(input.Position)
			end
		end))
		table.insert(AA.connections, userInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = nil
			end
		end))
		-- Close when clicking anywhere outside the picker (or on Done).
		table.insert(AA.connections, userInputService.InputBegan:Connect(function(input)
			if frame.Visible and input.UserInputType == Enum.UserInputType.MouseButton1 then
				local p, a, z = input.Position, frame.AbsolutePosition, frame.AbsoluteSize
				local inside = p.X >= a.X and p.X <= a.X + z.X and p.Y >= a.Y and p.Y <= a.Y + z.Y
				local onAnchor = false
				if anchor then
					local b, w = anchor.AbsolutePosition, anchor.AbsoluteSize
					onAnchor = p.X >= b.X and p.X <= b.X + w.X and p.Y >= b.Y and p.Y <= b.Y + w.Y
				end
				if not inside and not onAnchor then
					frame.Visible = false
				end
			end
		end))
		done.MouseButton1Click:Connect(function()
			frame.Visible = false
		end)
		hexBox.FocusLost:Connect(function()
			local ok, color = pcall(Color3.fromHex, (hexBox.Text:gsub("#", "")))
			if ok then
				h, s, v = color:ToHSV()
				commit()
			else
				show()
			end
		end)

		function picker.open(forKey, text, swatch)
			if frame.Visible and key == forKey then
				frame.Visible = false
				return
			end
			key, anchor = forKey, swatch
			local ok, color = pcall(Color3.fromHex, Config[forKey])
			h, s, v = (ok and color or Color3.new(1, 1, 1)):ToHSV()
			title.Text = text
			-- Beside the window (right side if there's room, else left), level with the swatch.
			local at = swatch.AbsolutePosition
			local viewport = screenGui.AbsoluteSize
			local left, width = panel.AbsolutePosition.X, panel.AbsoluteSize.X
			local x = left + width + 6
			if x + 222 > viewport.X then
				x = left - 228
			end
			x = math.clamp(x, 0, math.max(viewport.X - 222, 0))
			local y = math.clamp(at.Y - 90, 0, math.max(viewport.Y - 206, 0))
			frame.Position = UDim2.fromOffset(x, y)
			frame.BackgroundColor3, title.TextColor3 = UI.roles.Background, UI.roles.Font
			frame.Visible = true
			show()
		end
	end

