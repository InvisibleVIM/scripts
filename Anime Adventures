	---What a stage drops. Listed chances come from the game's own data, wherever in the level's
	---table they sit (reward groups, wave-modifier drops, board rewards). Anything the game does
	---not list (the server rolls it: secret portals, units) is measured instead: how many logged
	---clears of that stage gave it.
	function AA.dropText(levelId, liveData)
		local level = liveData or (type(levelId) == "string" and Levels[levelId]) or nil
		if type(level) ~= "table" then
			return "No drop list for this one."
		end
		AA.itemData = AA.itemData or findData("Items", "LuckPotion") or {}
		local function nameOf(id)
			local entry = AA.itemData[id] or Units[id]
			return tostring(entry and entry.name or id)
		end
		local lines, listed = {}, {}
		-- A line that starts with "# " is a group title on the Overview (rows under it are short).
		for resource, steps in pairs(type(level.infinite_resource_rewards) == "table" and level.infinite_resource_rewards or {}) do
			local from, titled = 1, false
			for _, step in ipairs(type(steps) == "table" and steps or {}) do
				local upTo = tonumber(step.wave_up_to) or from
				if (tonumber(step.reward) or 0) > 0 then
					if not titled then
						titled = true
						table.insert(lines, "# " .. AA.spaced(resource) .. " a wave")
					end
					table.insert(lines, string.format("Waves %d to %d: %s", from, upTo, tostring(step.reward)))
				end
				from = upTo + 1
			end
			if titled then
				table.insert(lines, "# Items")
			end
		end
		if (tonumber(level._override_gem_reward) or 0) > 0 then
			table.insert(lines, "Gems: x" .. tostring(level._override_gem_reward))
		end
		local function scan(value, depth)
			if type(value) ~= "table" or depth > 6 then
				return
			end
			local id = rawget(value, "item_id") or rawget(value, "unit_id")
			local chance = tonumber(rawget(value, "chance"))
			if type(id) == "string" and chance then
				local low = rawget(value, "min_amount") or rawget(value, "amount") or 1
				local high = rawget(value, "max_amount") or rawget(value, "amount") or 1
				local percent = chance * 100
				local key = id .. tostring(chance) .. tostring(high)
				if not listed[key] then
					listed[key] = true
					listed[id] = true
					table.insert(lines, string.format("%s: %s%%, %s", nameOf(id), percent >= 10 and tostring(math.floor(percent + 0.5)) or string.format("%.2f", percent), low == high and ("x" .. tostring(low)) or (tostring(low) .. " to " .. tostring(high))))
				end
			end
			if type(rawget(value, "resource_reward")) == "table" then
				for resource, amount in pairs(value.resource_reward) do
					local key = "res" .. tostring(resource) .. tostring(amount)
					if not listed[key] then
						listed[key] = true
						table.insert(lines, AA.spaced(resource) .. ": x" .. tostring(amount))
					end
				end
			end
			for key, inner in pairs(value) do
				-- (map_board_line_reward is the lobby's map board prize, not something the stage drops.)
				if type(inner) == "table" and key ~= "requirements" and key ~= "_MATCHMAKING" and key ~= "map_board_line_reward" then
					scan(inner, depth + 1)
				end
			end
		end
		scan(level, 0)
		local bonus, info = gameCall(Core.Level and Core.Level.calculate_level_drop_increase, level, session())
		bonus = tonumber(bonus)
		if bonus and bonus > 0 then
			table.insert(lines, string.format("%s boost: +%d%%", type(info) == "table" and tostring(info._reward_type or "Drop") or "Drop", math.floor(bonus * 100 + 0.5)))
		end
		-- Measured: everything the logged clears of this stage gave that the game lists no chance for.
		local id = level.id or levelId
		local clears, got = 0, {}
		for _, entry in ipairs(MatchLog) do
			if type(entry) == "table" and entry.level == id and entry.won then
				clears += 1
				for itemId in pairs(type(entry.items) == "table" and entry.items or {}) do
					got[itemId] = (got[itemId] or 0) + 1
				end
				for _, unitId in ipairs(type(entry.units) == "table" and entry.units or {}) do
					got[unitId] = (got[unitId] or 0) + 1
				end
			end
		end
		local measured = {}
		for itemId, count in pairs(got) do
			if not listed[itemId] then
				table.insert(measured, { name = nameOf(itemId), count = count })
			end
		end
		table.sort(measured, function(x, y)
			return x.count > y.count
		end)
		for index, entry in ipairs(measured) do
			if index <= 8 then
				local percent = entry.count / clears * 100
				table.insert(lines, string.format("%s: %d of %d clears", entry.name, entry.count, clears))
			end
		end
		if bonus and bonus > 0 and type(info) == "table" and info._reward_type then
			local seenPortal = false
			for itemId in pairs(got) do
				seenPortal = seenPortal or tostring(itemId):find("portal") ~= nil
			end
			if not seenPortal then
				table.insert(lines, string.format("%s: not listed by the game. None in %d clears logged%s.", tostring(info._reward_type), clears, clears < 20 and ", too few to give a chance yet" or (string.format(", so under about %d%%", math.ceil(300 / clears)))))
			end
		end
		if lines[#lines] == "# Items" then
			table.remove(lines)
		end
		return #lines > 0 and table.concat(lines, "\n") or "The game lists no item drops for this stage (gems and XP only)."
	end
end

