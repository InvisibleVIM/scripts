local function equippedUnits()
	local data = collectionData()
	local owned = data.owned_units or {}
	local list = {}
	for _, uuid in pairs(data.equipped_units or {}) do
		local unit = owned[uuid]
		if unit and Units[unit.unit_id] then
			table.insert(list, { uuid = uuid, id = unit.unit_id, data = Units[unit.unit_id], unit = unit })
			-- Unique trait ("There can only be one..."): the server refuses a second copy.
			AA.uniqueIds = AA.uniqueIds or {}
			AA.uniqueIds[unit.unit_id] = AA.hasTrait(unit, "unique") or nil
		end
	end
	return list
end

local function completedLevels()
	local done = {}
	local levelData = profile().level_data
	for key, value in pairs(levelData and levelData.completed_story_levels or {}) do
		if type(key) == "string" then
			done[key] = true
		elseif type(value) == "string" then
			done[value] = true
		end
	end
	for id in pairs(AA.myClears()) do
		done[id] = true
	end
	return done
end

---Has this act been beaten on a given difficulty? (Hard opens once the act is beaten on Normal.)
local function clearedOn(id, difficulty)
	local levelData = profile().level_data
	local entry = levelData and levelData.completed_story_levels and levelData.completed_story_levels[id]
	local byDifficulty = type(entry) == "table" and entry.difficulty_completed_data
	local mine = AA.myClears()[id]
	return (type(byDifficulty) == "table" and byDifficulty[difficulty] ~= nil) or (type(mine) == "table" and mine[difficulty] == true)
end

local function levelUnlocked(id, done)
	local level = Levels[id]
	if not level then
		return false
	end
	if IS_LOBBY and Core.Progress then
		-- In the lobby the profile is fresh: ask the game's own unlock rule.
		local results = table.pack(pcall(Core.Progress.check_if_unlocked_level, session(), level))
		setthreadidentity(8)
		if results[1] and results[2] ~= nil then
			return results[2] == true
		end
	end
	local req = level.requirements and level.requirements.required_levels
	for _, need in pairs(req or {}) do
		if not done[need] then
			return false
		end
	end
	return true
end

