	-- Longer explanations sit behind a "?" beside the control they explain and show while the
	-- cursor is on it. What a control does in a line is written under its name instead.
	UI.lastRow = {}
	function UI.showTip(text)
		local tip = UI.tipFrame
		if not tip then
			tip = create("TextLabel", {
				Name = "PotentTip",
				Size = UDim2.fromOffset(300, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = UI.roles.Raised,
				BorderSizePixel = 0,
				FontFace = CODE,
				TextSize = px(14),
				LineHeight = 1.2,
				TextColor3 = UI.roles.Font,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				Visible = false,
				ZIndex = 200,
				Parent = screenGui,
			}, {
				create("UICorner", { CornerRadius = UDim.new(0, 8) }),
				create("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
				create("UIStroke", { Color = UI.roles.Outline, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
			})
			UI.tipFrame = tip
		end
		if not text or text == "" then
			tip.Visible = false
			return
		end
		tip.Text = text
		local mouse = userInputService:GetMouseLocation()
		local view = screenGui.AbsoluteSize
		local x = mouse.X + 16
		if x + 310 > view.X then
			x = mouse.X - 316
		end
		tip.Position = UDim2.fromOffset(math.max(x, 4), math.clamp(mouse.Y + 18, 4, math.max(view.Y - math.max(tip.AbsoluteSize.Y, 140) - 4, 4)))
		tip.Visible = true
	end
	---Put a "?" on a row. `spot` = { position (UDim2, anchored at its right edge), row, caption }.
	function UI.attachTip(spot, text)
		if spot.icon then
			spot.text = spot.text .. "\n\n" .. text
			return spot
		end
		spot.text = text
		local caption = spot.caption
		if caption then
			-- Leave room for the "?" beside the name.
			caption.Size = UDim2.new(caption.Size.X.Scale, caption.Size.X.Offset - 26, caption.Size.Y.Scale, caption.Size.Y.Offset)
		end
		local mark = create("TextLabel", {
			Name = "Tip",
			AnchorPoint = Vector2.new(1, 0),
			Position = spot.position,
			Size = UDim2.fromOffset(18, 18),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			FontFace = CODE_BOLD,
			Text = "?",
			TextSize = px(13),
			TextColor3 = UI.roles.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Active = true,
			ZIndex = 3,
			Parent = spot.row,
		}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		local ring = stroke(mark, "Outline")
		spot.icon = mark
		mark.MouseEnter:Connect(function()
			ring.Color = UI.roles.Accent
			mark.TextColor3 = UI.roles.Font
			UI.showTip(spot.text)
		end)
		mark.MouseMoved:Connect(function()
			UI.showTip(spot.text)
		end)
		mark.MouseLeave:Connect(function()
			ring.Color = UI.roles.Outline
			mark.TextColor3 = UI.roles.Muted
			UI.showTip(nil)
		end)
		return spot
	end
	---A "?" beside the title of the open card.
	function UI.cardTip(page, text)
		local current = UI.current[page]
		local head = current and current.body:FindFirstChild("Head")
		if head then
			UI.attachTip({ row = head, position = UDim2.new(1, 0, 0, 1), caption = head:FindFirstChild("Title") }, text)
		end
	end
	---Builders call this so the hint that follows knows which row it explains.
	---`whole`: the full row when `row` is only its top line (so a mode gate can hide all of it).
	function UI.markRow(page, row, position, captionLabel, whole)
		UI.lastRow[page] = { row = row, position = position, body = (whole or row).Parent, caption = captionLabel, whole = whole }
	end

	---The left part of a row: its name and, under it, one short note. `reserve` px stay free on
	---the right for the control. Returns the holder and the note label (nil without a note).
	local function caption(row, text, note, reserve)
		local holder = create("Frame", {
			Name = "Caption",
			Size = UDim2.new(1, -(reserve or 0), 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Parent = row,
		}, { create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }) })
		local name = wrapped({ Name = "Name", Size = UDim2.new(1, 0, 0, 20), Text = text, FontFace = CODE_MEDIUM, LayoutOrder = 1, Parent = holder })
		local noteLabel
		if note and note ~= "" then
			noteLabel = wrapped({ Name = "Note", Size = UDim2.new(1, 0, 0, 16), Text = note, TextSize = px(13), TextColor3 = UI.roles.Muted, LayoutOrder = 2, Parent = holder })
		end
		return holder, noteLabel, name
	end

	-- Controls. Every builder takes the page; heading() opens a new card.
	function UI.heading(page, text, side, note)
		newBox(page, text, side, note)
		UI.lastRow[page] = nil
	end

	---A row in the open card. Grows with its content; `height` is its least height.
	function UI.rowBase(page, height, clickable)
		local row = create(clickable and "TextButton" or "Frame", {
			Size = UDim2.new(1, 0, 0, height),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			LayoutOrder = UI.nextOrder(),
			Parent = slot(page, height),
		})
		if clickable then
			row.Text = ""
			row.AutoButtonColor = false
		end
		return row
	end

	function UI.rowLabel(row, text, y, width)
		return label({
			Position = UDim2.fromOffset(0, y or 0),
			Size = width or UDim2.new(1, -110, 0, y and 20 or row.Size.Y.Offset),
			Text = text,
			Parent = row,
		})
	end

	---On / off switch: the name (and a note) on the left, a pill on the right that slides and
	---fills when on.
	function UI.toggle(page, text, key, note)
		local row = UI.rowBase(page, 22, true)
		local holder, _, name = caption(row, text, note, 50)
		UI.markRow(page, row, UDim2.new(1, -46, 0, 2), holder)
		local track = create("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 1),
			Size = UDim2.fromOffset(36, 20),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			Parent = row,
		})
		round(track, 10)
		local outline = stroke(track, "Outline")
		local knob = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 3, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = UI.roles.Muted,
			BorderSizePixel = 0,
			Parent = track,
		})
		round(knob, 7)
		local shown
		local function refresh()
			local on = Config[key] and true or false
			local quick = (shown == nil or shown == on) and 0 or 0.14
			shown = on
			tween(track, { BackgroundColor3 = on and UI.roles.Accent or UI.roles.Control }, quick)
			tween(knob, { Position = UDim2.new(0, on and 19 or 3, 0.5, 0), BackgroundColor3 = on and UI.onAccent() or UI.roles.Muted }, quick)
			outline.Color = on and UI.roles.Accent or UI.roles.Outline
			name.TextColor3 = on and UI.roles.Font or UI.roles.Font:Lerp(UI.roles.Muted, 0.5)
		end
		row.MouseButton1Click:Connect(function()
			Config[key] = not Config[key]
			UI.refreshAll()
		end)
		table.insert(UI.refreshers, refresh)
		if type(AA.toggleRefreshers) == "table" then
			table.insert(AA.toggleRefreshers, refresh)
		end
		refresh()
		return row
	end

	function UI.slider(page, text, key, minValue, maxValue, step, format, note)
		local row = UI.rowBase(page, 44, false)
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = row })
		local top = create("Frame", { Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = row })
		local holder = caption(top, text, note, 84)
		UI.markRow(page, top, UDim2.new(1, -80, 0, 2), holder, row)
		local valueLabel = label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(78, 20),
			TextXAlignment = Enum.TextXAlignment.Right,
			FontFace = CODE_BOLD,
			TextSize = px(14),
			Text = "",
			Parent = top,
		})
		-- Tall invisible hit area around a thin track: easy to grab, light to look at.
		local hit = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = 2,
			Parent = row,
		})
		local track = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 7, 0.5, 0),
			Size = UDim2.new(1, -14, 0, 4),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			Parent = hit,
		})
		round(track, 2)
		local fill = create("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, Parent = track })
		round(fill, 2)
		local knob = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = UI.roles.Font,
			BorderSizePixel = 0,
			Parent = track,
		})
		round(knob, 7)
		local function refresh()
			local fraction = math.clamp((Config[key] - minValue) / (maxValue - minValue), 0, 1)
			fill.Size = UDim2.new(fraction, 0, 1, 0)
			knob.Position = UDim2.fromScale(fraction, 0.5)
			valueLabel.Text = format(Config[key])
		end
		local dragging = false
		local function setFromX(x)
			local fraction = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			local value = minValue + fraction * (maxValue - minValue)
			Config[key] = math.clamp(math.floor(value / step + 0.5) * step, minValue, maxValue)
			refresh()
		end
		hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				setFromX(input.Position.X)
			end
		end)
		table.insert(AA.connections, userInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				setFromX(input.Position.X)
			end
		end))
		table.insert(AA.connections, userInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
		table.insert(UI.refreshers, refresh)
		refresh()
		return row
	end

	---Pick one of a few: the chosen option is a filled pill, the rest are plain words.
	---`names` maps an option to the word shown for it.
	function UI.segmented(page, text, key, options, note, names)
		local hasLabel = text ~= nil and text ~= ""
		local row = UI.rowBase(page, 32, false)
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = row })
		if hasLabel then
			local top = create("Frame", { Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = row })
			local holder = caption(top, text, note, 0)
			UI.markRow(page, top, UDim2.new(1, 0, 0, 2), holder, row)
		end
		local group = create("Frame", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			LayoutOrder = 2,
			Parent = row,
		}, {
			create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
			create("UIPadding", { PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3) }),
		})
		round(group, 8)
		local buttons = {}
		local function refresh()
			for option, optionButton in pairs(buttons) do
				local active = Config[key] == option
				optionButton.BackgroundColor3 = UI.roles.Accent
				optionButton.BackgroundTransparency = active and 0 or 1
				optionButton.TextColor3 = active and UI.onAccent() or UI.roles.Muted
				optionButton.FontFace = active and CODE_BOLD or CODE_MEDIUM
			end
		end
		for index, option in ipairs(options) do
			local optionButton = create("TextButton", {
				Size = UDim2.new(1 / #options, -2 + 2 / #options, 1, 0),
				BackgroundColor3 = UI.roles.Accent,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				FontFace = CODE_MEDIUM,
				Text = tostring(names and names[option] or option),
				TextSize = px(14),
				TextColor3 = UI.roles.Muted,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				LayoutOrder = index,
				Parent = group,
			})
			round(optionButton, 6)
			buttons[option] = optionButton
			optionButton.MouseEnter:Connect(function()
				if Config[key] ~= option then
					optionButton.TextColor3 = UI.roles.Font
				end
			end)
			optionButton.MouseLeave:Connect(function()
				if Config[key] ~= option then
					optionButton.TextColor3 = UI.roles.Muted
				end
			end)
			optionButton.MouseButton1Click:Connect(function()
				Config[key] = option
				UI.refreshAll()
			end)
		end
		table.insert(UI.refreshers, refresh)
		if type(AA.segmentRefreshers) == "table" then
			table.insert(AA.segmentRefreshers, refresh)
		end
		refresh()
		return row
	end

	---A longer explanation for the row above (a "?" beside it). With no row above, a plain note.
	function UI.hint(page, text)
		local last = UI.lastRow[page]
		if text ~= "" and last and UI.current[page] and last.body == UI.current[page].body and last.row.Parent then
			UI.attachTip(last, text)
			-- Callers may keep the label and rewrite it: the "?" follows.
			local proxy = label({ Size = UDim2.new(), Text = text, Visible = false, Parent = last.row })
			proxy:GetPropertyChangedSignal("Text"):Connect(function()
				last.text = proxy.Text
			end)
			return proxy
		end
		return UI.note(page, text)
	end
	---A muted line of small print in the open card.
	function UI.note(page, text)
		return wrapped({
			Size = UDim2.new(1, 0, 0, 16),
			Text = text,
			TextSize = px(13),
