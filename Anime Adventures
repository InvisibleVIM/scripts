					local steps = table.clone(AA.Order.steps())
					local unit = Config.OrderAddUnit
					if unit == "" then
						return "Pick a unit"
					end
					local kind = (#steps == 0 or Config.OrderAddKind ~= "Upgrade") and "place" or "upgrade"
					if kind == "upgrade" then
						local placed = false
						for _, step in ipairs(steps) do
							placed = placed or (step.kind == "place" and step.unit == unit)
						end
						if not placed then
							return "Place it first"
						end
					end
					table.insert(steps, { kind = kind, unit = unit, times = kind == "upgrade" and Config.OrderAddTimes or 1 })
					AA.Order.set(steps)
					showList()
					return "Added"
				end, true)
				-- The steps, top first: the cross takes a step out, the arrow moves it one place up.
				showList = UI.editList(page, {
					get = stepNames,
					ordered = true,
					maxHeight = 370,
					empty = "No steps yet. The first step is always a placement.",
					-- How many upgrades the step buys (kept out of the name, which may be cut short).
					marks = function(_, index)
						local step = AA.Order.steps()[index]
						return (step and step.kind == "upgrade") and ("x" .. step.times) or ""
					end,
					-- Where the match is in the list.
					tag = function(_, index)
						local current = not IS_LOBBY and Config.OrderOn and Match.orderStep or nil
						if current and index == current then
							return "Now", "accent"
						end
						return (current and index < current) and "Done" or ""
					end,
					remove = function(index)
						local steps = table.clone(AA.Order.steps())
						table.remove(steps, index)
						applySteps(steps)
					end,
					moveUp = function(index)
						local steps = table.clone(AA.Order.steps())
						steps[index - 1], steps[index] = steps[index], steps[index - 1]
						applySteps(steps)
					end,
				})
				button(page, "Clear all steps", function()
