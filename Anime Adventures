		UI.button(page, "Rescan files", function()
			table.clear(Player.cache)
			fillList()
			return #Player.visible() .. " songs"
		end)

		fillList = function()
			for _, row in ipairs(Player.rows) do
				row.button:Destroy()
			end
			table.clear(Player.rows)
			local list = Player.visible()
			countLine.Text = #list .. " songs" .. ((Config.MyMusicPlaylist or "All") ~= "All" and (" in " .. Config.MyMusicPlaylist) or "")
			for index, song in ipairs(list) do
				local button = create("TextButton", {
					Size = UDim2.new(1, 0, 0, 26),
					BackgroundColor3 = UI.roles.Main,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					FontFace = CODE,
					Text = "    " .. song.label,
					TextSize = px(14),
					TextColor3 = UI.roles.Font,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					AutoButtonColor = false,
					LayoutOrder = index,
					Parent = scroller,
				})
				button:SetAttribute("NoTheme", true)
				UI.corner(5).Parent = button
				local bar = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.fromOffset(3, 14), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, Visible = false, Parent = button }, { UI.corner(2) })
				bar:SetAttribute("NoTheme", true)
				local row = { button = button, bar = bar, song = song }
				button.MouseEnter:Connect(function()
					if not (Player.current and Player.current.path == song.path) then
