		local healthFill = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.roles.Accent, BorderSizePixel = 0, Parent = healthTrack })
		---Feed the strip. info: sub, busy, health (base health fraction, nil outside a match),
		---figures = { { value, caption }, { value, caption } }.
		function UI.setNow(info)
			nowSub.Text = info.sub or ""
			nowDot.BackgroundColor3 = info.busy and UI.roles.Accent or UI.roles.Muted
			local figures = info.figures or {}
