						local pity = tonumber(banner._show_mythic_pity) and ("a Mythic is guaranteed within %d pulls"):format(banner._show_mythic_pity) or tonumber(banner._show_featured_pity) and ("featured pity at %d pulls"):format(banner._show_featured_pity) or nil
