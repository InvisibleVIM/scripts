---Serialize Config to JSON; EnumItems are stored as { enum, name }.
---@return string
local function encodeSettings()
	local data = {}
	for key, value in pairs(Config) do
		if typeof(value) == "EnumItem" then
			data[key] = { enum = tostring(value.EnumType), name = value.Name }
		else
			data[key] = value
		end
	end
	return httpService:JSONEncode(data)
end

---Write settings to the workspace folder.
local function saveSettings()
	pcall(function()
		if not isfolder(SETTINGS_FOLDER) then
			makefolder(SETTINGS_FOLDER)
		end
		writefile(SETTINGS_FILE, encodeSettings())
	end)
end

---Apply saved settings over the defaults, ignoring unknown or mistyped keys.
local function loadSettings()
	local ok, data = pcall(function()
		return isfile(SETTINGS_FILE) and httpService:JSONDecode(readfile(SETTINGS_FILE))
	end)
	if not (ok and type(data) == "table") then
		return
	end

	for key, value in pairs(data) do
		local default = Config[key]
		if default == nil then
			continue
		end
		if typeof(default) == "EnumItem" then
			if type(value) == "table" then
				local found, item = pcall(function()
					return Enum[value.enum][value.name]
				end)
				if found and item then
					Config[key] = item
				end
			end
		elseif type(value) == type(default) then
			Config[key] = value
		end
	end
end

