---Undo every hook, connection and drawing.
function GrappleStrike.detach()
	saveSettings()
	for _, connection in ipairs(GrappleStrike.connections) do
		connection:Disconnect()
	end
	if GrappleStrike.gui then
		GrappleStrike.gui:Destroy()
	end
	if shared.GrappleStrike == GrappleStrike then
		shared.GrappleStrike = nil
	end
end

