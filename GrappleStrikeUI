local function makePage(name)
	local page = create("ScrollingFrame", {
		Name = name,
		Position = UDim2.fromOffset(0, 98),
		Size = UDim2.new(1, 0, 1, -98 - 40),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = LINE,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = panel,
	}, {
		create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
	})
	pages[name] = page
	return page
end

local function selectTab(name)
	for pageName, page in pairs(pages) do
		page.Visible = pageName == name
	end
	for buttonName, button in pairs(tabButtons) do
		local active = buttonName == name
		button.TextColor3 = active and TEXT or MUTED
		if active then
			tween(tabUnderline, {
				Position = UDim2.new(0, button.Position.X.Offset, 1, -2),
				Size = UDim2.fromOffset(button.TextBounds.X, 2),
			}, 0.18)
		end
	end
end

local function makeTab(name, x)
	local button = create("TextButton", {
		Name = name,
		Position = UDim2.fromOffset(x, 0),
		Size = UDim2.new(0, 70, 1, -4),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		FontFace = TAB_FONT,
		Text = name,
		TextColor3 = MUTED,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutoButtonColor = false,
		Parent = tabBar,
	})
	button.Size = UDim2.new(0, 0, 1, -4)
	tabButtons[name] = button
	button.MouseButton1Click:Connect(function()
		selectTab(name)
	end)
	return button
end

-- Control builders.
local layoutOrder = 0
local function nextOrder()
	layoutOrder = layoutOrder + 1
	return layoutOrder
end

local function rowBase(page, height, clickable)
	local row = create(clickable and "TextButton" or "Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = RAISED,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(),
		Parent = page,
	}, { corner(6) })
	if clickable then
		row.Text = ""
		row.AutoButtonColor = false
	end
	row.MouseEnter:Connect(function()
		tween(row, { BackgroundTransparency = 0.35 }, 0.1)
	end)
	row.MouseLeave:Connect(function()
		tween(row, { BackgroundTransparency = 1 }, 0.1)
	end)
	return row
end

