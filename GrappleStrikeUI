-- Autosave whenever a setting changes.
do
	local lastSaved = encodeSettings()
	local elapsed = 0
	table.insert(GrappleStrike.connections, runService.Heartbeat:Connect(function(dt)
		elapsed = elapsed + dt
		if elapsed < SAVE_INTERVAL then
			return
		end
		elapsed = 0
		local encoded = encodeSettings()
		if encoded ~= lastSaved then
			lastSaved = encoded
			saveSettings()
		end
	end))
end

-- Live lock status in the header.
table.insert(GrappleStrike.connections, runService.Heartbeat:Connect(function()
	local on = Config.SilentAim or Config.CameraAim
	statusLabel.Text = on and "Aim on" or "Aim off"
	statusLabel.TextColor3 = on and GOLD or MUTED
end))

