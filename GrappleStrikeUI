		BorderSizePixel = 0,
		Parent = row,
	}, { corner(5) })
	local latchStroke = create("UIStroke", { Color = LINE, Thickness = 1.5, Parent = latch })
	local check = create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = BODY_BOLD,
		Text = "✓",
		TextColor3 = PANEL,
		TextSize = 15,
		TextTransparency = 1,
		Parent = latch,
	})

	local function refresh()
		local on = Config[key]
		tween(latch, { BackgroundTransparency = on and 0 or 1 })
		tween(check, { TextTransparency = on and 0 or 1 })
		tween(latchStroke, { Color = on and GOLD or LINE })
	end
	row.MouseButton1Click:Connect(function()
		Config[key] = not Config[key]
		refresh()
	end)
	refresh()
end

---Thin cable-style slider.
local function slider(page, text, key, minValue, maxValue, step, format)
	local row = rowBase(page, 48, false)
	rowLabel(row, text, 4)
	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 4),
		Size = UDim2.fromOffset(90, 20),
		BackgroundTransparency = 1,
		FontFace = BODY_BOLD,
		TextColor3 = GOLD,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
	local track = create("TextButton", {
		Position = UDim2.new(0, 8, 0, 30),
		Size = UDim2.new(1, -16, 0, 12),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = LINE,
		BorderSizePixel = 0,
		Parent = track,
	})
	local fill = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 0, 0, 2),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		Parent = track,
	})
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	}, { corner(6), create("UIStroke", { Color = PANEL, Thickness = 2 }) })

	local function refresh()
		local fraction = (Config[key] - minValue) / (maxValue - minValue)
		fill.Size = UDim2.new(fraction, 0, 0, 2)
		knob.Position = UDim2.fromScale(fraction, 0.5)
		valueLabel.Text = format(Config[key])
	end
	local dragging = false
	local function setFromX(x)
		local fraction = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local value = minValue + fraction * (maxValue - minValue)
		Config[key] = math.clamp(math.floor(value / step + 0.5) * step, minValue, maxValue)
		refresh()
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	table.insert(GrappleStrike.connections, userInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	table.insert(GrappleStrike.connections, userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
	refresh()
end

---Segmented choice for short option sets.
local function segmented(page, text, key, options)
	local row = rowBase(page, 34, false)
	rowLabel(row, text)
	local group = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = STEEL,
		BorderSizePixel = 0,
		Parent = row,
	}, {
		corner(6),
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
		create("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }),
	})
	local buttons = {}
	local function refresh()
		for option, button in pairs(buttons) do
			local active = Config[key] == option
			tween(button, { BackgroundTransparency = active and 0 or 1, TextColor3 = active and GOLD or MUTED }, 0.12)
		end
	end
	for index, option in ipairs(options) do
		local button = create("TextButton", {
			Size = UDim2.fromOffset(0, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = RAISED,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			FontFace = BODY_FONT,
			Text = option,
			TextColor3 = MUTED,
			TextSize = 13,
			AutoButtonColor = false,
			LayoutOrder = index,
			Parent = group,
		}, { corner(4), create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
		buttons[option] = button
		button.MouseButton1Click:Connect(function()
			Config[key] = option
			refresh()
		end)
	end
	refresh()
end

