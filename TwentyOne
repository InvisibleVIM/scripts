	local function currentTheme()
		local theme = {}
		for _, entry in ipairs(THEME) do
			theme[entry.key] = Config[entry.key]
		end
		return theme
	end
	local function useTheme(theme)
		for _, entry in ipairs(THEME) do
			local value = theme[entry.key]
			if type(value) == "string" and pcall(Color3.fromHex, value) then
				Config[entry.key] = value:upper()
			end
		end
		UI.applyTheme()
	end
	UI.useTheme = useTheme
	local function ensureFolder()
		pcall(function()
			if not isfolder("PotentHub") then
				makefolder("PotentHub")
			end
			if not isfolder(THEME_FOLDER) then
				makefolder(THEME_FOLDER)
			end
		end)
	end
	local function customThemes()
		local names = {}
		pcall(function()
			for _, path in ipairs(listfiles(THEME_FOLDER)) do
				local name = tostring(path):match("([^/\\]+)%.json$")
				if name then
					table.insert(names, name)
				end
			end
		end)
		table.sort(names)
		return names
	end
	function UI.themeSection(page)
		UI.heading(page, "Presets", "full", "Click one to wear it.")
		UI.themeGrid(page)
		UI.heading(page, "Your own colors", "left", "Click a swatch to change it.")
		UI.colorRow(page, "Window", "ThemeBackground")
		UI.colorRow(page, "Cards", "ThemeMain")
		UI.colorRow(page, "Accent", "ThemeAccent")
		UI.colorRow(page, "Lines", "ThemeOutline")
		UI.colorRow(page, "Text", "ThemeFont")
		UI.button(page, "Use these colors in every Potent script", function()
			ensureFolder()
			writefile(DEFAULT_FILE, httpService:JSONEncode(currentTheme()))
			Config.UseDefaultTheme = true
			return "Saved as the default"
		end)
