						end
					else
						if wasOn then
							wasOn = false
							if sound then
								sound:Pause()
							end
							Player.muteGame(false)
							Player.highlight()
						end
						nowLine.Text = Player.current and ("Off. Last played: " .. Player.current.title) or "Off."
					end
				end)
				task.wait(0.5)
			end
			Player.muteGame(false)
			if Player.sound then
				Player.sound:Destroy()
			end
		end)
	end
	end)()

