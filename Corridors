---Yield periodically so large scans spread across frames.
local function throttle()
	workCounter += 1

	if workCounter >= YIELD_EVERY then
		workCounter = 0
		task.wait()
	end
end

---Round a number to the nearest half stud.
---@param value number
---@return number
local function roundHalf(value)
	return math.floor(value * 2 + 0.5) / 2
end

---Format a direction vector in 0.05 steps (about 3 degrees).
---@param vector Vector3
---@return string
local function formatDirection(vector)
	local function round(component)
		return math.floor(component * 20 + 0.5) / 20
	end

	return round(vector.X) .. "," .. round(vector.Y) .. "," .. round(vector.Z)
end

---Format a value into a tolerant comparison string.
---@param value any
---@return string
local function formatValue(value)
	local valueType = typeof(value)

	if valueType == "number" then
		return tostring(math.floor(value * 100 + 0.5) / 100)
	end

	if valueType == "Vector3" then
		return roundHalf(value.X) .. "," .. roundHalf(value.Y) .. "," .. roundHalf(value.Z)
	end

	if valueType == "Color3" then
		return math.floor(value.R * 50) .. "," .. math.floor(value.G * 50) .. "," .. math.floor(value.B * 50)
	end

	if valueType == "CFrame" then
		return formatValue(value.Position) .. "/" .. formatValue(value.LookVector) .. "/" .. formatValue(value.UpVector)
	end

	if valueType == "Instance" then
		return value.Name
	end

	return tostring(value)
end

---Resolve which properties exist on a class once, so scans skip pcall per property.
---@param cacheName string
---@param instance Instance
---@param candidates table
---@return table
local function getClassProperties(cacheName, instance, candidates)
	local cache = classProperties[cacheName]
	local existing = cache[instance.ClassName]
	if existing then
		return existing
	end

	local valid = {}

	for _, property in ipairs(candidates) do
		local success = pcall(function()
			return instance[property]
		end)

		if success then
			table.insert(valid, property)
		end
	end

	cache[instance.ClassName] = valid
	return valid
end

---Get the path of an instance below a root, or nil if it left the root.
---@param root Instance
---@param instance Instance
---@return table?
local function getPath(root, instance)
	local path = {}
	local current = instance

	while current and current ~= root do
		table.insert(path, 1, current.Name)
		current = current.Parent
	end

	return current and path or nil
end

---Add a signature entry to a bag.
---@param bag table
---@param id string
---@param group string
---@param fields table
local function addEntry(bag, id, group, fields)
	local parts = { id }

	for _, field in ipairs(fields) do
		table.insert(parts, field[1] .. "=" .. field[2])
	end

	local signature = table.concat(parts, "|")
	local entry = bag[signature]

	if entry then
		entry.count += 1
		return
	end

	bag[signature] = { count = 1, id = id, group = group, fields = fields }
end

---Build signatures for a room's static contents relative to its start.
---@param room Model
---@return table
local function buildRoomBag(room)
	local bag = {}
	local roomStart = room:FindFirstChild("RoomStart")
	if not roomStart then
		return bag
	end

	local origin = roomStart.CFrame
	local level = tostring(room:GetAttribute("Level") or 0)

	for _, descendant in ipairs(room:GetDescendants()) do
		throttle()

		local path = getPath(room, descendant)
		if not path or #path < 2 or IGNORED_FOLDERS[path[1]] then
			continue
		end

		local group = path[1] .. "/" .. path[2]
		local subGroup = SUB_GROUPS[group] and path[3] and SUB_GROUPS[group][path[3]]
		if subGroup then
			group = path[1] .. "/" .. subGroup
		end

		if IGNORED_GROUPS[group] then
			continue
		end

		local fields = {}

		-- Non-part instances inherit the position of their nearest part ancestor.
		if not POSITION_IGNORED_GROUPS[group] then
			local anchor = descendant
			while anchor and anchor ~= room and not anchor:IsA("BasePart") do
				anchor = anchor.Parent
			end

			if anchor and anchor:IsA("BasePart") then
				local relative = origin:ToObjectSpace(anchor.CFrame)
				table.insert(fields, { "pos", formatValue(relative.Position) })
				-- Anchored parts are compared finely so a slight tilt shows; loose parts sway.
				if anchor.Anchored then
					table.insert(fields, { "look", formatDirection(relative.LookVector) })
					table.insert(fields, { "up", formatDirection(relative.UpVector) })
				else
					table.insert(fields, { "lookLoose", formatValue(relative.LookVector) })
					table.insert(fields, { "upLoose", formatValue(relative.UpVector) })
				end
			end
		end

		local isPart = descendant:IsA("BasePart")

		for _, property in ipairs(getClassProperties("room", descendant, ROOM_PROPERTIES)) do
			-- Part rotation is world-space and differs per corridor; it is covered relative to the room above.
			if property == "Rotation" and isPart then
				continue
			end

			local value = descendant[property]

			-- The wall sign legitimately shows the room's own level number.
			if property == "Text" and path[2] == "WallExitSign" and value == level then
				value = "{LEVEL}"
			end

			table.insert(fields, { property, formatValue(value) })
		end

		addEntry(bag, table.concat(path, "/") .. "|" .. descendant.ClassName, group, fields)
	end

	return bag
end

---Build appearance-only signatures for a John model.
---@param john Model
---@return table
local function buildJohnBag(john)
	local bag = {}
	local complete = true

	for _, descendant in ipairs(john:GetDescendants()) do
		throttle()

		if JOHN_IGNORED_CLASSES[descendant.ClassName] then
			continue
		end

		-- Parts can vanish while we yield (he's re-cloned or the corridor is torn down);
		-- a bag missing them would make every lost part look like an anomaly.
		local path = getPath(john, descendant)
		if not path then
			complete = false
			continue
		end

		local fields = {}

		for _, property in ipairs(getClassProperties("john", descendant, JOHN_PROPERTIES)) do
			table.insert(fields, { property, formatValue(descendant[property]) })
		end

		addEntry(bag, table.concat(path, "/") .. "|" .. descendant.ClassName, path[1], fields)
	end

	return bag, complete and john.Parent ~= nil
end

-- Directions of anchored parts, rounded to 0.05 (about 3 degrees).
local FINE_STEP_FIELDS = { look = 0.05, up = 0.05 }
local HUE_CHANGE_MIN = 0.2

-- Values are rounded before comparing; these are compared in half-stud steps.
local HALF_STEP_FIELDS = {
	pos = true, lookLoose = true, upLoose = true, Size = true, C0 = true, C1 = true,
	Scale = true, Offset = true, VertexColor = true,
}

---Split a formatted value back into its numbers.
---@param value string?
---@return table
local function parseNumbers(value)
	local numbers = {}
	if not value then
		return numbers
	end

	for piece in value:gmatch("[^,/]+") do
		local number = tonumber(piece)
		if not number then
			return {}
		end

		table.insert(numbers, number)
	end

	return numbers
end

---Whether two rounded values only differ by one rounding step.
---A part sitting right on a rounding boundary can round either way from float noise.
---@param property string
---@param before string?
---@param after string?
---@return boolean
local function isRoundingNoise(property, before, after)
	local a, b = parseNumbers(before), parseNumbers(after)
	if #a == 0 or #a ~= #b then
		return false
	end

	-- Color3 values are stored in 1/50 steps; plain numbers to 0.01.
	local step = HALF_STEP_FIELDS[property] and 0.5 or FINE_STEP_FIELDS[property] or (#a == 3 and 1 or 0.01)

	for index = 1, #a do
		if math.abs(a[index] - b[index]) > step + 1e-6 then
			return false
		end
	end

	return true
end

---Whether two formatted colors differ in hue, not just in how bright they are.
---@param before string?
---@param after string?
---@return boolean
local function isHueChange(before, after)
	local a, b = parseNumbers(before), parseNumbers(after)
	if #a ~= 3 or #b ~= 3 then
		return false
	end

	local maxA = math.max(a[1], a[2], a[3], 1)
	local maxB = math.max(b[1], b[2], b[3], 1)
	local difference = 0
	for index = 1, 3 do
		difference = math.max(difference, math.abs(a[index] / maxA - b[index] / maxB))
	end

	return difference > HUE_CHANGE_MIN
end

---How many fields differ between two entries beyond rounding noise.
---@param before table
---@param after table
---@return number
local function countRealDifferences(before, after)
	local beforeFields = {}
	for _, field in ipairs(before.fields) do
		beforeFields[field[1]] = field[2]
	end

	local count = 0
	for _, field in ipairs(after.fields) do
		local old = beforeFields[field[1]]
		if old ~= field[2] and not isRoundingNoise(field[1], old, field[2]) then
			count += 1
		end
	end

	return count
end

---Compare two bags and describe what changed per group.
---@param baseBag table
---@param currentBag table
---@return table, table, table
local function diffBags(baseBag, currentBag)
	local baseGroups, currentGroups, changes = {}, {}, {}
	local leftoverBase = {}

	for signature, entry in pairs(baseBag) do
		baseGroups[entry.group] = true

		local surplus = entry.count - (currentBag[signature] and currentBag[signature].count or 0)
		if surplus > 0 then
			leftoverBase[entry.id] = leftoverBase[entry.id] or {}
			table.insert(leftoverBase[entry.id], entry)
		end
	end

	for signature, entry in pairs(currentBag) do
		currentGroups[entry.group] = true

		local surplus = entry.count - (baseBag[signature] and baseBag[signature].count or 0)
		if surplus <= 0 then
			continue
		end

		-- Pair with the closest matching part from the baseline to name the exact change.
		local candidates = leftoverBase[entry.id]
		local original, originalIndex, fewest = nil, nil, math.huge

		for index, candidate in ipairs(candidates or {}) do
			local differences = countRealDifferences(candidate, entry)
			if differences < fewest then
				original, originalIndex, fewest = candidate, index, differences
			end
		end

		if not original then
			changes[entry.group] = changes[entry.group] or {}
			changes[entry.group]["added part"] = true
			continue
		end

		table.remove(candidates, originalIndex)

		local originalFields = {}
		for _, field in ipairs(original.fields) do
			originalFields[field[1]] = field[2]
		end

		-- A dimmed or brightened light also shifts its tint; that is one change, not two.
		local isLight = entry.id:find("Light$") ~= nil
		local brightnessBefore, brightnessAfter, brightnessText
		for _, field in ipairs(entry.fields) do
			if field[1] == "Brightness" then
				brightnessBefore, brightnessAfter, brightnessText = tonumber(originalFields.Brightness), tonumber(field[2]), field[2]
			end
		end

		local brightnessChanged = isLight and brightnessBefore and brightnessAfter
			and brightnessBefore ~= brightnessAfter
			and not isRoundingNoise("Brightness", originalFields.Brightness, brightnessText)

		-- A new hue is a recolor even when the brightness moved with it; only a same-hue
		-- shift counts as dimmed or brighter.
		local hueChanged = false
		if brightnessChanged then
			for _, field in ipairs(entry.fields) do
				if field[1] == "Color" and isHueChange(originalFields.Color, field[2]) then
					brightnessChanged = false
					hueChanged = true
				end
			end
		end

		local labels = {}

		for _, field in ipairs(entry.fields) do
			if brightnessChanged and (field[1] == "Color" or field[1] == "Brightness") then
				if field[1] == "Brightness" then
					labels[brightnessAfter < brightnessBefore and "dimmed" or "brighter"] = true
				end

				continue
			end

			if hueChanged and (field[1] == "Brightness" or field[1] == "Range") then
				continue
			end

			local old = originalFields[field[1]]
			if old ~= field[2] and not isRoundingNoise(field[1], old, field[2]) then
				local label = CHANGE_LABELS[field[1]] or field[1]

				if field[1] == "Text" then
					label = 'text "' .. field[2] .. '"'
				elseif field[1] == "Color" and entry.id:find("Light") and not isHueChange(old, field[2]) then
					-- Flickering lights go white-hot and back, the same hue; only a new hue is a recolor.
					label = "shade"
				elseif field[1] == "look" or field[1] == "up" then
					-- Under about 40 degrees off reads as a tilt rather than a turn.
					local a, b = parseNumbers(old), parseNumbers(field[2])
					if #a == 3 and #b == 3 and a[1] * b[1] + a[2] * b[2] + a[3] * b[3] > 0.76 then
						label = "tilted"
					end
				elseif field[1] == "Rotation" then
					-- Some signs are built at 180 already, so what matters is a half-turn from normal.
					local before = tonumber(old)
					local after = tonumber(field[2])
					if before and after and math.abs((after - before) % 360 - 180) < 5 then
						label = "upside down"
					end
				end

				labels[label] = true
			end
		end

		if labels.rotated then
			labels.tilted = nil
		end

		-- Only rounding noise: the part is unchanged.
		if next(labels) then
			changes[entry.group] = changes[entry.group] or {}

			for label in pairs(labels) do
				changes[entry.group][label] = true
			end
		end
	end

	for _, entries in pairs(leftoverBase) do
		for _, entry in ipairs(entries) do
			changes[entry.group] = changes[entry.group] or {}
			changes[entry.group]["removed part"] = true
		end
	end

	return changes, baseGroups, currentGroups
end

---Turn a CamelCase identifier into readable words.
---@param name string
---@return string
local function splitWords(name)
	local spaced = name:gsub("_", " "):gsub("(%l)(%u)", "%1 %2"):gsub("(%a)(%d)", "%1 %2")
	return spaced
end

---Readable name for a room group.
---@param group string
---@return string
local function roomGroupName(group)
	local folder, name = group:match("^(.-)/(.+)$")

	-- Spawn markers only change when an entity appears at them.
	if folder == "References" then
		local entity = name:gsub("Spawn%d*$", "")
		return (ENTITY_NAMES[entity] or splitWords(entity)) .. " (entity)"
	end

	return OBJECT_NAMES[name] or splitWords(name)
end

---Summarise a set of change labels.
---@param labels table
---@return string
local function describeChanges(labels)
	local list = {}

	for label in pairs(labels) do
		if label ~= "added part" and label ~= "removed part" then
			table.insert(list, label)
		end
	end

	if #list == 0 then
		if labels["added part"] then
			table.insert(list, "something added")
		end

		if labels["removed part"] then
			table.insert(list, "part missing")
		end
	end

	table.sort(list)
	return table.concat(list, ", ")
end

---Whether a room's parts are streamed in enough to read.
---@param room Instance?
---@return boolean
local function isRoomLoaded(room)
	return room ~= nil and room:FindFirstChild("RoomStart") ~= nil and room:FindFirstChild("RoomEnd") ~= nil
end

---Where the clean corridor is cached for this map version.
---@return string
local function getBaselineCachePath()
	return BASELINE_CACHE_FOLDER .. "/baseline_v3_" .. tostring(game.PlaceId) .. "_" .. tostring(game.PlaceVersion) .. ".json"
end

---Load a clean corridor saved earlier on this map version.
---@return table?
local function loadCachedBaseline()
	local success, bag = pcall(function()
		local path = getBaselineCachePath()
		if not isfile(path) then
			return nil
		end

		return httpService:JSONDecode(readfile(path))
	end)

	return success and type(bag) == "table" and next(bag) ~= nil and bag or nil
end

---Save the clean corridor so later runs don't depend on it being streamed in.
---@param bag table
local function saveCachedBaseline(bag)
	pcall(function()
		if not isfolder(BASELINE_CACHE_FOLDER) then
			makefolder(BASELINE_CACHE_FOLDER)
		end

		writefile(getBaselineCachePath(), httpService:JSONEncode(bag))
	end)
end

---Get or build the clean room baseline.
---The first corridor is the clean reference; the Default template can be outdated or streamed out.
---@return table?
local function getRoomBaseline()
	if roomBaseline then
		return roomBaseline
	end

	roomBaseline = loadCachedBaseline()
	if roomBaseline then
		return roomBaseline
	end

	local segments = workspaceService:FindFirstChild("MapSegments")
	local firstRoom = segments and segments:FindFirstChild("Segment000")

	-- Streamed maps only load parts near you; ask for the clean corridor before copying it.
	if firstRoom and workspaceService.StreamingEnabled then
		pcall(function()
			localPlayer:RequestStreamAroundAsync(firstRoom:GetPivot().Position, 5)
		end)
	end

	if isRoomLoaded(firstRoom) then
		roomBaseline = buildRoomBag(firstRoom)
		saveCachedBaseline(roomBaseline)
		return roomBaseline
	end

	local template = workspaceService:FindFirstChild("Default")
	if template and template:FindFirstChild("RoomStart") then
		roomBaseline = buildRoomBag(template)
		return roomBaseline
	end

	return nil
end

---Whether John has been ragdolled (killed); his health stays full when this happens.
---@param john Model
---@return boolean
local function isJohnDead(john)
	local humanoid = john:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health <= 0 then
		return true
	end

	local disabledMotors = 0
	for _, descendant in ipairs(john:GetDescendants()) do
		if descendant:IsA("Motor6D") and not descendant.Enabled then
			disabledMotors += 1
		end
	end

	return disabledMotors >= 3
end

---Find the corridor's guide NPC (John, Jimmy...) in its Debris folder.
---@param room Instance
---@return Model?
local function findNpc(room)
	local debris = room:FindFirstChild("Debris")
	if not debris then
		return nil
	end

	for _, npcName in ipairs(NPC_NAMES) do
		local npc = debris:FindFirstChild(npcName)
		if npc then
			return npc
		end
	end

	return nil
end

---Height reference for an R6 or R15 body.
---@param npc Model
---@return BasePart?
local function getTorso(npc)
	return npc:FindFirstChild("Torso") or npc:FindFirstChild("UpperTorso")
end

---Get the clean John from the first room, falling back to a majority vote across rooms.
---@return table?
local function getJohnBaseline()
	if johnBaseline then
		return johnBaseline
	end

	local segments = workspaceService:FindFirstChild("MapSegments")
	if not segments then
		return nil
	end

	local firstRoom = segments:FindFirstChild("Segment000")
	local firstJohn = firstRoom and findNpc(firstRoom)

	-- Right after joining he can still be streaming in; a half-built John makes every part look new.
	local function isWhole(john)
		return getTorso(john) and john:FindFirstChild("Head") and john:FindFirstChildOfClass("Humanoid")
			and #john:GetDescendants() >= 300 -- a whole one has about 900
	end

	if firstJohn and not isJohnDead(firstJohn) and isWhole(firstJohn) then
		local torso = getTorso(firstJohn)
		johnBaselineHeight = torso and torso.Size.Y
		local neck = torso and torso:FindFirstChild("Neck")
		johnBaselineNeck = neck and neck:IsA("Motor6D") and neck.C0 or nil
		local baseHumanoid = firstJohn:FindFirstChildOfClass("Humanoid")
		AnomalyFinder.johnBaselineWalkSpeed = baseHumanoid and baseHumanoid.WalkSpeed
		johnBaselineCount = #firstJohn:GetDescendants()

		for _, descendant in ipairs(firstJohn:GetDescendants()) do
			if descendant:IsA("ProximityPrompt") then
				johnBaselinePrompts[table.concat(getPath(firstJohn, descendant), "/")] = true
			end
		end

		local bag, complete = buildJohnBag(firstJohn)
		if not complete then
			return nil
		end

		johnBaseline = bag
		return johnBaseline
	end

	-- Anomalies are rare per room, so whatever most Johns share is the clean look.
	local votes, total = {}, 0

	for _, room in ipairs(segments:GetChildren()) do
		local john = findNpc(room)
		if not john or isJohnDead(john) or not isWhole(john) then
			continue
		end

		total += 1

		for signature, entry in pairs(buildJohnBag(john)) do
			votes[signature] = votes[signature] or { entry = entry, seen = 0 }
			votes[signature].seen += 1
		end

		for _, descendant in ipairs(john:GetDescendants()) do
			if descendant:IsA("ProximityPrompt") then
				local key = "prompt:" .. table.concat(getPath(john, descendant), "/")
				votes[key] = votes[key] or { seen = 0, prompt = true }
				votes[key].seen += 1
			end
		end
	end

	if total < 3 then
		return nil
	end

	-- Prompts most Johns have are part of his normal setup.
	for key, vote in pairs(votes) do
		if vote.prompt then
			if vote.seen * 2 > total then
				johnBaselinePrompts[key:sub(8)] = true
			end

			votes[key] = nil
		end
	end

	local bag = {}
	for signature, vote in pairs(votes) do
		if vote.seen * 2 > total then
			bag[signature] = vote.entry
		end
	end

	johnBaseline = bag
	return bag
end

---Scan a room's John against the clean John.
---@param room Model
---@return table
local function scanJohn(room)
	local john = findNpc(room)
	if not john then
		return {}
	end

	local owner = john.Name

	-- A dead John ragdolls every joint; that is one anomaly, not each change.
	if isJohnDead(john) then
		return { { name = owner, kind = "Altered", detail = "died", death = true, npc = true } }
	end

	local baseline = getJohnBaseline()
	if not baseline then
		return {}
	end

	-- John is cloned in when the corridor opens; skip him until he's fully there.
	if johnBaselineCount and #john:GetDescendants() < johnBaselineCount * JOHN_COMPLETE_RATIO then
		return {}
	end

	local currentBag, complete = buildJohnBag(john)
	if not complete then
		return {}
	end

	local changes, baseGroups, currentGroups = diffBags(baseline, currentBag)
	local anomalies, altered = {}, {}
	local hasAttachment = false
	local hasParasite = false

	-- A prompt the clean John doesn't have (the kiss prompt).
	for _, descendant in ipairs(john:GetDescendants()) do
		if not descendant:IsA("ProximityPrompt") then
			continue
		end

		local path = getPath(john, descendant)
		if path and not johnBaselinePrompts[table.concat(path, "/")] then
			local action = descendant.ActionText ~= "" and descendant.ActionText or descendant.ObjectText
			local isKiss = action:lower():find("kiss") ~= nil
			table.insert(anomalies, {
				name = isKiss and owner .. "'s kiss prompt" or owner .. "'s prompt",
				kind = "New",
				detail = isKiss and "" or action,
			})
		end
	end

	for group, labels in pairs(changes) do
		local name = owner .. "'s " .. (JOHN_NAMES[group] or splitWords(group):lower())

		if currentGroups[group] and not baseGroups[group] then
			hasAttachment = true
			hasParasite = hasParasite or name == owner .. PARASITE_SUFFIX
			table.insert(anomalies, { name = name, kind = "New", detail = "attached to " .. owner })
		elseif baseGroups[group] and not currentGroups[group] then
			table.insert(anomalies, { name = name, kind = "Missing", detail = "" })
		else
			altered[group] = labels
		end
	end

	-- Without his body parts he's still streaming in; look again once he's all there.
	if not (getTorso(john) and john:FindFirstChild("Head") and john:FindFirstChild("HumanoidRootPart")) then
		return {}
	end

	-- No anomaly takes more than one or two things off him; a pile of "missing" parts
	-- means this read went wrong (he was being rebuilt), so don't believe it.
	local missingParts, missingNames = 0, {}
	for _, anomaly in ipairs(anomalies) do
		if anomaly.kind == "Missing" or anomaly.kind == "New" then
			missingParts += 1
			table.insert(missingNames, anomaly.kind .. " " .. anomaly.name)
		end
	end
	if missingParts >= 4 then
		if AnomalyFinder.loggedBadJohn ~= john then
			AnomalyFinder.loggedBadJohn = john
			local children = {}
			for _, child in ipairs(john:GetChildren()) do
				table.insert(children, child.Name)
			end
			table.insert(pendingReportLines, string.format(
				"[%s] Ignored a bad read of %s | missing: %s | he has: %s\n",
				os.date("%Y-%m-%d %H:%M:%S"), john:GetFullName(), table.concat(missingNames, ", "), table.concat(children, ", ")
			))
		end
		return {}
	end

	-- Staring: his head turned on the neck joint. An attachment never turns it, so this
	-- survives the attachment clean-up below.
	local torso = getTorso(john)
	local neck = torso and torso:FindFirstChild("Neck")
	if neck and neck:IsA("Motor6D") and johnBaselineNeck then
		local turn = neck.C0.LookVector:Dot(johnBaselineNeck.LookVector)
		if turn < STARE_MIN_DOT then
			table.insert(anomalies, { name = owner .. "'s stare", kind = "Altered", detail = "head turned" })

			if altered[torso.Name] then
				altered[torso.Name].pose = nil
			end
		end
	end

	-- The menacing aura is a particle effect added to him; it's its own anomaly.
	local menacing = john:FindFirstChild("MenacingAttachment", true)
	if menacing then
		table.insert(anomalies, { name = owner .. "'s menacing aura", kind = "New", detail = "" })

		local auraGroup = getPath(john, menacing)[1]
		if altered[auraGroup] then
			altered[auraGroup]["added part"] = nil
		end
	end

	-- Something attached to John reshapes his limbs too; count it once,
	-- but keep changes an attachment can't cause (his clothes, colors, which hand holds the case).
	-- Speed that shows up along with the parasite is the parasite's; speed he already had
	-- before it attached stays listed from the earlier scan.
	-- A scaled John has a different torso; check it before the attachment clean-up hides it.
	local scaledTorso = torso and johnBaselineHeight and math.abs(torso.Size.Y - johnBaselineHeight) > 0.15
	-- The game scales the whole model; its scale factor says so even when parts are hidden.
	local okScale, modelScale = pcall(john.GetScale, john)
	modelScale = okScale and modelScale or 1
	if math.abs(modelScale - 1) > 0.01 then
		scaledTorso = true
	end

	if hasAttachment then
		for _, labels in pairs(altered) do
			-- Colors and speed stay: what the parasite does to him once it turns him is
			-- sorted out by when it happened (see getParasiteSeenTime).
			for label in pairs(labels) do
				if ATTACHMENT_SIDE_EFFECTS[label] then
					labels[label] = nil
				end
			end
		end
	end

	-- Only his body counts toward a whole-body color change; a recolored briefcase or hair
	-- is its own anomaly even when it happens alongside another.
	local bodyNames = {
		head = true, body = true, ["skin color"] = true,
		["left arm"] = true, ["right arm"] = true, ["left leg"] = true, ["right leg"] = true,
	}

	local sizedParts, coloredParts = 0, 0
	for group, labels in pairs(altered) do
		if labels.resized or labels.scale then
			sizedParts += 1
		end

		for label in pairs(bodyNames[JOHN_NAMES[group]] and COLOR_LABELS or {}) do
			if labels[label] then
				coloredParts += 1
				break
			end
		end
	end

	-- A whole-body resize touches every part; report it once as his size.
	if sizedParts >= 3 or scaledTorso then
		local torso = getTorso(john)
		local detail = "resized"

		if math.abs(modelScale - 1) > 0.01 then
			detail = modelScale < 1 and "smaller" or "bigger"
		elseif torso and johnBaselineHeight then
			detail = torso.Size.Y < johnBaselineHeight and "smaller" or "bigger"
		end

		table.insert(anomalies, { name = owner .. "'s size", kind = "Altered", detail = detail })

		for _, labels in pairs(altered) do
			for label in pairs(SIZE_LABELS) do
				labels[label] = nil
			end
		end
	end

	-- A color change spread across several of John's parts is one anomaly.
	if coloredParts >= 2 then
		table.insert(anomalies, { name = owner .. "'s color", kind = "Altered", detail = "changed" })

		for group, labels in pairs(altered) do
			for label in pairs(bodyNames[JOHN_NAMES[group]] and COLOR_LABELS or {}) do
				labels[label] = nil
			end
		end
	end

	-- The briefcase joint lives under an arm; a swapped hand is its own anomaly, apart from a recolored case.
	local swappedHand = false
	for _, labels in pairs(altered) do
		if labels["in the other hand"] then
			swappedHand = true
			labels["in the other hand"] = nil
		end
	end

	if swappedHand then
		table.insert(anomalies, { name = owner .. "'s briefcase hand", kind = "Altered", detail = "in the other hand" })
	end

	-- A walk speed change lives on his Humanoid; report it as his speed.
	local speedChanged = false
	for _, labels in pairs(altered) do
		if labels.speed then
			speedChanged = true
			labels.speed = nil
		end
	end

	if speedChanged then
		local humanoid = john:FindFirstChildOfClass("Humanoid")
		local baseSpeed = AnomalyFinder.johnBaselineWalkSpeed
		local detail = "changed"
		if humanoid and baseSpeed then
			detail = humanoid.WalkSpeed > baseSpeed and "faster" or "slower"
		end

		table.insert(anomalies, { name = owner .. "'s speed", kind = "Altered", detail = detail })
	end

	for group, labels in pairs(altered) do
		if next(labels) then
			local name = owner .. "'s " .. (JOHN_NAMES[group] or splitWords(group):lower())
			table.insert(anomalies, { name = name, kind = "Altered", detail = describeChanges(labels) })
		end
	end

	-- Hair has two parts; keep one entry per name.
	local seen, unique = {}, {}
	for _, anomaly in ipairs(anomalies) do
		local key = anomaly.kind .. anomaly.name
		if not seen[key] then
			seen[key] = true
			table.insert(unique, anomaly)
		end
	end

	return unique
end

---Find entities spawned into a room's Debris folder.
---@param room Model
---@return table, table
local function scanDebrisEntities(room)
	local debris = room:FindFirstChild("Debris")
	local entities, replaced = {}, {}
	if not debris then
		return entities, replaced
	end

	-- Include entities that already left the room.
	local names, instances = {}, {}
	for _, child in ipairs(debris:GetChildren()) do
		names[child.Name] = true
		instances[child.Name] = instances[child.Name] or {}
		table.insert(instances[child.Name], child)
	end

	local seen = roomEntitiesSeen[room]
	for name in pairs(seen and seen.debris or {}) do
		names[name] = true
	end

	for name in pairs(names) do
		local ignored = DEBRIS_IGNORED[name]

		for _, pattern in ipairs(DEBRIS_IGNORED_PATTERNS) do
			if name:match(pattern) then
				ignored = true
			end
		end

		if ignored then
			continue
		end

		-- Exact names first (SCP096), then without a copy number (DebrisShovel2).
		local baseName = DEBRIS_ENTITY_NAMES[name] and name or name:gsub("%d+$", "")
		local replacedGroup = DEBRIS_REPLACES[baseName]
		local detail = "entity"

		if replacedGroup then
			replaced[replacedGroup] = true
			detail = "replaces " .. (OBJECT_NAMES[replacedGroup:match("/(.+)$")] or replacedGroup):lower()
		end

		table.insert(entities, {
			name = DEBRIS_ENTITY_NAMES[baseName] or splitWords(baseName),
			kind = "New",
			detail = detail,
			targets = instances[name],
		})
	end

	return entities, replaced
end

---The anomaly a sound belongs to, if it only plays during one.
---@param instance Instance
---@return string?
local function getSoundAnomaly(instance)
	if not instance:IsA("Sound") then
		return nil
	end

	local parent = instance.Parent
	return SOUND_ANOMALIES[instance.Name] or (parent and SOUND_ANOMALIES[parent.Name .. "/" .. instance.Name])
end

---Name the door a knock sound belongs to.
---@param room Model
---@param sound Sound
---@return string
local function getKnockSource(room, sound)
	local path = getPath(room, sound)
	if not path or #path < 2 then
		return "a door"
	end

	local objectName = path[2]
	if path[1] == "Debris" then
		local entityName = DEBRIS_ENTITY_NAMES[objectName] or DEBRIS_ENTITY_NAMES[(objectName:gsub("%d+$", ""))]
		return (entityName or splitWords(objectName)):lower()
	end

	return (OBJECT_NAMES[objectName] or splitWords(objectName)):lower()
end

---Knocks heard in this room, plus any knock playing right now.
---@param room Model
---@return table
local function scanKnocks(room)
	local knocks = roomKnocks[room] or {}

	for _, descendant in ipairs(room:GetDescendants()) do
		if descendant:IsA("Sound") and descendant.Name == "Knock" and descendant.IsPlaying then
			knocks[getKnockSource(room, descendant)] = true
		end

		-- Sounds that only play during one anomaly, already playing when you walk in.
		local soundAnomaly = getSoundAnomaly(descendant)
		if soundAnomaly and descendant.IsPlaying then
			roomClientAnomalies[room] = roomClientAnomalies[room] or {}
			roomClientAnomalies[room][soundAnomaly] = ""
		end
	end

	roomKnocks[room] = knocks

	local anomalies = {}
	for source in pairs(knocks) do
		table.insert(anomalies, { name = "Knocking", kind = "New", detail = "on " .. source })
	end

	return anomalies
end

---Turn a detail string back into a set of labels.
---@param detail string
---@return table
local function parseLabels(detail)
	local labels = {}
	for label in detail:gmatch("[^,]+") do
		labels[label:match("^%s*(.-)%s*$")] = true
	end
	return labels
end

---Every instance the given anomalies point at, for the ESP boxes.
---@param anomalies table
---@return table
local function collectTargets(anomalies)
	local targets = {}

	for _, anomaly in ipairs(anomalies) do
		for _, target in ipairs(anomaly.targets or {}) do
			table.insert(targets, target)
		end
	end

	return targets
end

---Combine changes shared across one kind of object (paintings, cameras...).
---A change most of them share is one "All ..." anomaly; once that is taken out,
---two that are left only moved have swapped places, which is one more anomaly.
---@param anomalies table
---@return table
local function mergeFamilies(anomalies)
	local result, byFamily = {}, {}

	for _, anomaly in ipairs(anomalies) do
		if anomaly.family then
			byFamily[anomaly.family] = byFamily[anomaly.family] or {}
			table.insert(byFamily[anomaly.family], anomaly)
		else
			table.insert(result, anomaly)
		end
	end

	for family, members in pairs(byFamily) do
		local familyName = family:lower()
		local altered, others = {}, {}

		for _, member in ipairs(members) do
			if member.kind == "Altered" then
				table.insert(altered, { anomaly = member, labels = parseLabels(member.detail) })
			else
				table.insert(others, member)
			end
		end

		-- Missing or added in bulk ("all paintings missing").
		local byKind = {}
		for _, member in ipairs(others) do
			byKind[member.kind] = byKind[member.kind] or {}
			table.insert(byKind[member.kind], member)
		end

		for kind, list in pairs(byKind) do
			if #list >= FAMILY_MERGE_MIN then
				table.insert(result, { name = "All " .. familyName, kind = kind, detail = "", targets = collectTargets(list) })
			else
				for _, member in ipairs(list) do
					table.insert(result, member)
				end
			end
		end

		-- Labels enough of them share become one family-wide anomaly.
		local labelCounts = {}
		for _, entry in ipairs(altered) do
			for label in pairs(entry.labels) do
				labelCounts[label] = (labelCounts[label] or 0) + 1
			end
		end

		local shared = {}
		for label, count in pairs(labelCounts) do
			if count >= FAMILY_MERGE_MIN then
				table.insert(shared, label)
			end
		end

		if #shared > 0 then
			table.sort(shared)
			table.insert(result, {
				name = "All " .. familyName,
				kind = "Altered",
				detail = table.concat(shared, ", "),
				targets = collectTargets(members),
			})

			for _, entry in ipairs(altered) do
				for _, label in ipairs(shared) do
					entry.labels[label] = nil
				end
			end
		end

		-- Two left with nothing but movement have traded places. A new picture on one of them
		-- is its own anomaly and doesn't get in the way.
		local onlyMoved = {}
		for _, entry in ipairs(altered) do
			-- Trading places means its position changed; one that only turned isn't a candidate.
			local moved, movementOnly = entry.labels.moved == true, true
			for label in pairs(entry.labels) do
				if not MOVEMENT_LABELS[label] and LIGHT_CATEGORIES[label] ~= "image" then
					movementOnly = false
				end
			end

			if moved and movementOnly then
				table.insert(onlyMoved, entry)
			end
		end

		if #onlyMoved == 2 then
			table.insert(result, {
				name = family .. " swapped",
				kind = "Altered",
				detail = onlyMoved[1].anomaly.name:lower() .. " ↔ " .. onlyMoved[2].anomaly.name:lower(),
				targets = collectTargets({ onlyMoved[1].anomaly, onlyMoved[2].anomaly }),
			})

			-- A swap moves both; a turn only one of them has is a rotated painting on top.
			for index, entry in ipairs(onlyMoved) do
				local other = onlyMoved[3 - index]
				local kept = {}
				for label in pairs(entry.labels) do
					local turnOnlyHere = (label == "rotated" or label == "tilted") and not other.labels[label]
					if turnOnlyHere or not MOVEMENT_LABELS[label] then
						kept[label] = true
					end
				end
				entry.kept = kept
			end
			onlyMoved[1].labels = onlyMoved[1].kept
			onlyMoved[2].labels = onlyMoved[2].kept
		end

		-- Whatever each one has left is its own anomaly.
		for _, entry in ipairs(altered) do
			if next(entry.labels) then
				local remaining = {}
				for label in pairs(entry.labels) do
					table.insert(remaining, label)
				end

				table.sort(remaining)
				table.insert(result, {
					name = entry.anomaly.name,
					kind = "Altered",
					detail = table.concat(remaining, ", "),
					targets = entry.anomaly.targets,
				})
			end
		end
	end

	return result
end

---Split objects whose movement and appearance change are separate anomalies.
---@param anomalies table
---@return table
local function splitAnomalies(anomalies)
	local result = {}

	for _, anomaly in ipairs(anomalies) do
		if CATEGORY_SPLIT_OBJECTS[anomaly.name] and anomaly.kind == "Altered" then
			local byCategory, order = {}, {}

			-- Switching lights off also changes their glow material and color; that's one change.
			local switched = anomaly.detail:find("toggled", 1, true) ~= nil

			for label in anomaly.detail:gmatch("[^,]+") do
				label = label:match("^%s*(.-)%s*$")
				local category = MOVEMENT_LABELS[label] and "" or LIGHT_CATEGORIES[label]
					or (label:sub(1, 5) == "text " and "text") or label
				if switched and SWITCH_LABELS[label] then
					category = "toggled"
				end

				if not byCategory[category] then
					byCategory[category] = {}
					table.insert(order, category)
				end
				table.insert(byCategory[category], label)
			end

			for _, category in ipairs(order) do
				local name = category == "" and anomaly.name or (anomaly.name .. " " .. category)
				local detail = (category == "" or category == "brightness" or category == "text")
					and table.concat(byCategory[category], ", ") or ""
				table.insert(result, { name = name, kind = "Altered", detail = detail, targets = anomaly.targets })
			end

			continue
		end

		local split = SPLIT_OBJECTS[anomaly.name]
		if not split or anomaly.kind ~= "Altered" then
			table.insert(result, anomaly)
			continue
		end

		local movement, other, named = {}, {}, {}
		for label in anomaly.detail:gmatch("[^,]+") do
			label = label:match("^%s*(.-)%s*$")
			local ownName = split.labelNames and split.labelNames[label]

			if ownName then
				named[ownName] = true
			else
				table.insert(MOVEMENT_LABELS[label] and movement or other, label)
			end
		end

		for name in pairs(named) do
			table.insert(result, { name = name, kind = "Altered", detail = "", targets = anomaly.targets })
		end

		if #movement > 0 then
			table.insert(result, {
				name = anomaly.name,
				kind = "Altered",
				detail = table.concat(movement, ", "),
				targets = anomaly.targets,
			})
		end

		if #other > 0 then
			table.insert(result, { name = split.otherName, kind = "New", detail = "", targets = anomaly.targets })
		end
	end

	return result
end

---The instances in a room that make up one scanned group.
---@param room Model
---@param group string
---@return table
local function getGroupTargets(room, group)
	local folderName, objectName = group:match("^(.-)/(.+)$")
	local folder = folderName and room:FindFirstChild(folderName)
	if not folder then
		return {}
	end

	-- Groups built from pieces of a shared folder (the cameras in Props).
	for parentGroup, pieces in pairs(SUB_GROUPS) do
		local parentFolder, parentName = parentGroup:match("^(.-)/(.+)$")
		if parentFolder == folderName then
			local parent = folder:FindFirstChild(parentName)
			local targets = {}

			for pieceName, subGroup in pairs(pieces) do
				local piece = parent and subGroup == objectName and parent:FindFirstChild(pieceName)
				if piece then
					table.insert(targets, piece)
				end
			end

			if #targets > 0 then
				return targets
			end
		end
	end

	local targets = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child.Name == objectName then
			table.insert(targets, child)
		end
	end

	return targets
end

---The clean corridor instance, when it is loaded, for drawing where missing things belong.
---@return Model?
local function getBaselineRoomInstance()
	local segments = workspaceService:FindFirstChild("MapSegments")
	local firstRoom = segments and segments:FindFirstChild("Segment000")
	if isRoomLoaded(firstRoom) then
		return firstRoom
	end

	local template = workspaceService:FindFirstChild("Default")
	return isRoomLoaded(template) and template or nil
end

---Boxes showing where a missing group sits in the clean corridor, moved into this room.
---@param room Model
---@param group string
---@return table?
local function getGhostBoxes(room, group)
	local baseRoom = getBaselineRoomInstance()
	local roomStart = room:FindFirstChild("RoomStart")
	if not baseRoom or not roomStart then
		return nil
	end

	local ghosts = {}
	for _, target in ipairs(getGroupTargets(baseRoom, group)) do
		local cframe, size

		if target:IsA("BasePart") then
			cframe, size = target.CFrame, target.Size
		elseif target:IsA("Model") then
			cframe, size = target:GetBoundingBox()
		else
			local part = target:FindFirstChildWhichIsA("BasePart", true)
			if part then
				cframe, size = part.CFrame, part.Size
			end
		end

		if cframe then
			local relative = baseRoom.RoomStart.CFrame:ToObjectSpace(cframe)
			table.insert(ghosts, { cframe = roomStart.CFrame * relative, size = size })
		end
	end

	return #ghosts > 0 and ghosts or nil
end

---Scan a room against the clean room and John baselines.
---@param room Model
---@return table
local function scanRoom(room)
	local baseline = getRoomBaseline()
	if not baseline then
		return {}
	end

	local changes, baseGroups, currentGroups = diffBags(baseline, buildRoomBag(room))
	local entities, replaced = scanDebrisEntities(room)
	local anomalies = {}

	for _, entity in ipairs(entities) do
		table.insert(anomalies, entity)
	end

	-- An object an entity stands in for is part of that entity's anomaly.
	for group in pairs(replaced) do
		changes[group] = nil
	end

	-- Entities that appeared at a spawn marker and already despawned.
	local seen = roomEntitiesSeen[room]
	for folder in pairs(seen and seen.references or {}) do
		local group = "References/" .. folder
		changes[group] = changes[group] or { ["added part"] = true }
	end

	for group, labels in pairs(changes) do
		-- Spawn markers only matter when something new appears at them;
		-- a marker that's empty, used up or missing isn't an anomaly.
		if group:match("^References/") and baseGroups[group] and not labels["added part"] then
			continue
		end

		if group == SECURITY_CAMERAS_GROUP then
			if baseGroups[group] and not currentGroups[group] then
				labels = { ["removed part"] = true }
			end

			local added = {}
			for label in pairs(labels) do
				local anomaly = SECURITY_CAMERA_ANOMALIES[label]
				if anomaly and not added[anomaly.name] then
					added[anomaly.name] = true
					table.insert(anomalies, {
						name = anomaly.name,
						kind = anomaly.kind,
						detail = anomaly.detail,
						targets = getGroupTargets(room, group),
						ghosts = anomaly.kind == "Missing" and getGhostBoxes(room, group) or nil,
					})
				end
			end

			if next(added) == nil then
				table.insert(anomalies, {
					name = "Security cameras",
					kind = "Altered",
					detail = describeChanges(labels),
					targets = getGroupTargets(room, group),
				})
			end

			continue
		end

		local kind, detail = "Altered", describeChanges(labels)

		if baseGroups[group] and not currentGroups[group] then
			kind, detail = "Missing", ""
		elseif currentGroups[group] and not baseGroups[group] then
			kind, detail = "New", ""
		elseif group:match("^References/") then
			kind, detail = "New", "appeared"
		end

		local objectName = group:match("^Objects/(.+)$")
		table.insert(anomalies, {
			name = roomGroupName(group),
			kind = kind,
			detail = detail,
			family = objectName and OBJECT_FAMILIES[objectName],
			targets = getGroupTargets(room, group),
			ghosts = kind == "Missing" and getGhostBoxes(room, group) or nil,
		})
	end

	anomalies = mergeFamilies(anomalies)
	anomalies = splitAnomalies(anomalies)

	local npc = findNpc(room)
	for _, anomaly in ipairs(scanJohn(room)) do
		anomaly.targets = anomaly.targets or (npc and { npc })
		table.insert(anomalies, anomaly)
	end

	for _, anomaly in ipairs(scanKnocks(room)) do
		table.insert(anomalies, anomaly)
	end

	for name, detail in pairs(roomClientAnomalies[room] or {}) do
		table.insert(anomalies, { name = name, kind = "New", detail = detail })
	end

	table.sort(anomalies, function(a, b)
		return a.name < b.name
	end)

	return anomalies
end

---Names the clean room keeps inside each spawn marker folder.
---@return table
local function getBaselineReferenceChildren()
	if baselineReferenceChildren then
		return baselineReferenceChildren
	end

	-- The clean first corridor is the reference; Default can be outdated or streamed out.
	local segments = workspaceService:FindFirstChild("MapSegments")
	local firstRoom = segments and segments:FindFirstChild("Segment000")
	local firstLoaded = isRoomLoaded(firstRoom)
	local sources = { workspaceService:FindFirstChild("Default"), firstLoaded and firstRoom or nil }

	local result = {}
	for _, source in pairs(sources) do
		local references = source and source:FindFirstChild("References")

		for _, folder in ipairs(references and references:GetChildren() or {}) do
			result[folder.Name] = result[folder.Name] or {}

			for _, child in ipairs(folder:GetChildren()) do
				result[folder.Name][child.Name] = true
			end
		end
	end

	-- Only keep the list once the clean corridor could actually be read.
	if firstLoaded then
		baselineReferenceChildren = result
	end

	return result
end

---Record an entity spawning into a room as soon as it is parented.
---@param room Instance
---@param instance Instance
local function recordEntitySpawn(room, instance)
	local path = getPath(room, instance)
	if not path or #path < 2 then
		return
	end

	local seen = roomEntitiesSeen[room]
	if not seen then
		seen = { debris = {}, references = {} }
		roomEntitiesSeen[room] = seen
	end

	if path[1] == "Debris" and #path == 2 and not DEBRIS_IGNORED[path[2]] then
		seen.debris[path[2]] = true
		return
	end

	-- Something placed inside a spawn marker that the clean room doesn't have.
	if path[1] == "References" and #path >= 3 then
		local known = getBaselineReferenceChildren()[path[2]]
		if known and not known[path[3]] then
			seen.references[path[2]] = true
		end
	end
end

---Follow a "Folder/Child" path below a root.
---@param root Instance
---@param path string
---@return Instance?
local function resolvePath(root, path)
	local current = root
	for piece in path:gmatch("[^/]+") do
		current = current and current:FindFirstChild(piece)
	end

	return current
end

---Every path any deep check looks at.
---@return table
local function getDeepPaths()
	local paths, seen = {}, {}
	for _, list in pairs(DEEP_CHECKS) do
		for _, path in ipairs(list) do
			if not seen[path] then
				seen[path] = true
				table.insert(paths, path)
			end
		end
	end

	return paths
end

---Detailed state of the deep-checked parts of a corridor, including what the normal scan skips.
---@param room Instance
---@return table
local function deepSnapshot(room)
	local origin = room.RoomStart.CFrame
	local lists = {}

	for _, path in ipairs(getDeepPaths()) do
		local target = resolvePath(room, path)
		if not target then
			lists[path] = { "absent" }
			continue
		end

		local items = target:GetDescendants()
		table.insert(items, 1, target)

		for _, item in ipairs(items) do
			throttle()

			local itemPath = getPath(target, item) or {}
			local key = path .. (#itemPath > 0 and ("/" .. table.concat(itemPath, "/")) or "") .. "|" .. item.ClassName
			local bits = {}

			for name, value in pairs(item:GetAttributes()) do
				table.insert(bits, "@" .. name .. "=" .. tostring(value))
			end

			if item:IsA("BasePart") then
				local relative = origin:ToObjectSpace(item.CFrame)
				table.insert(bits, "pos=" .. formatValue(relative.Position))
				table.insert(bits, "look=" .. formatValue(relative.LookVector))
				table.insert(bits, "up=" .. formatValue(relative.UpVector))
				table.insert(bits, "collide=" .. tostring(item.CanCollide))
				table.insert(bits, "touch=" .. tostring(item.CanTouch))
				table.insert(bits, "transparency=" .. formatValue(item.Transparency))
			elseif item:IsA("Humanoid") then
				table.insert(bits, "state=" .. item:GetState().Name)
				table.insert(bits, "platform=" .. tostring(item.PlatformStand))
				table.insert(bits, "sit=" .. tostring(item.Sit))
				table.insert(bits, "hip=" .. formatValue(item.HipHeight))
			elseif item:IsA("Animator") then
				local playing = {}
				for _, track in ipairs(item:GetPlayingAnimationTracks()) do
					table.insert(playing, track.Animation and track.Animation.AnimationId:match("%d+$") or "?")
				end
				table.sort(playing)
				table.insert(bits, "anims=" .. table.concat(playing, ","))
			elseif item:IsA("ProximityPrompt") then
				table.insert(bits, "enabled=" .. tostring(item.Enabled))
				table.insert(bits, "action=" .. item.ActionText)
			elseif item:IsA("Sound") then
				table.insert(bits, "playing=" .. tostring(item.IsPlaying))
			elseif item:IsA("ValueBase") then
				table.insert(bits, "value=" .. tostring(item.Value))
			elseif item:IsA("Light") or item:IsA("ParticleEmitter") or item:IsA("Beam") then
				table.insert(bits, "enabled=" .. tostring(item.Enabled))
			elseif item:IsA("Decal") then
				table.insert(bits, "face=" .. item.Face.Name)
				table.insert(bits, "texture=" .. item.Texture)
			elseif item:IsA("SurfaceGui") then
				table.insert(bits, "face=" .. item.Face.Name)
			elseif item:IsA("GuiObject") then
				table.insert(bits, "rotation=" .. formatValue(item.Rotation))
				table.insert(bits, "visible=" .. tostring(item.Visible))

				if item:IsA("ImageLabel") or item:IsA("ImageButton") then
					table.insert(bits, "image=" .. item.Image)
					table.insert(bits, "rect=" .. tostring(item.ImageRectOffset) .. "/" .. tostring(item.ImageRectSize))
				end
			end

			table.sort(bits)
			lists[key] = lists[key] or {}
			table.insert(lists[key], table.concat(bits, " "))
		end
	end

	-- Same-named siblings are sorted so their order can't create differences.
	local snapshot = {}
	for key, list in pairs(lists) do
		table.sort(list)
		snapshot[key] = table.concat(list, " | ")
	end

	return snapshot
end

---Snapshot the current corridor every few seconds, keyed by level.
---@param room Instance
local function captureDeepSnapshot(room)
	local level = room:GetAttribute("Level")
	if not level or not isRoomLoaded(room) or os.clock() - lastDeepCapture < DEEP_CAPTURE_INTERVAL then
		return
	end

	lastDeepCapture = os.clock()

	if not deepBaseline then
		local segments = workspaceService:FindFirstChild("MapSegments")
		local firstRoom = segments and segments:FindFirstChild("Segment000")
		if isRoomLoaded(firstRoom) then
			deepBaseline = deepSnapshot(firstRoom)
		end
	end

	deepSnapshotsByLevel[level] = deepSnapshot(room)
end

---Log lines describing how a level's checked parts differed from the clean corridor.
---@param level number
---@param anomalyName string
---@return string
local function describeDeepDiff(level, anomalyName)
	local snapshot = deepSnapshotsByLevel[level]
	if not deepBaseline or not snapshot then
		return string.format("    %s check, level %s: no snapshot taken\n", anomalyName, tostring(level))
	end

	local function isChecked(key)
		for _, path in ipairs(DEEP_CHECKS[anomalyName]) do
			if key:sub(1, #path) == path then
				return true
			end
		end

		return false
	end

	local lines = {}
	for key, value in pairs(snapshot) do
		if isChecked(key) and deepBaseline[key] ~= value then
			table.insert(lines, "      " .. key .. ": " .. tostring(deepBaseline[key]) .. " -> " .. value)
		end
	end

	for key, value in pairs(deepBaseline) do
		if isChecked(key) and snapshot[key] == nil then
			table.insert(lines, "      " .. key .. ": " .. value .. " -> (gone)")
		end
	end

	table.sort(lines)

	local text = string.format("    %s check, level %s: %d differences\n", anomalyName, tostring(level), #lines)
	if #lines > 0 then
		text ..= table.concat(lines, "\n", 1, math.min(#lines, 40)) .. "\n"
	end

	return text
end

---Find which room a descendant of MapSegments belongs to.
---@param segments Folder
---@param instance Instance
---@return Instance?
local function getOwningRoom(segments, instance)
	local current = instance

	while current and current.Parent ~= segments do
		current = current.Parent
	end

	return current
end

---Mark rooms as changed whenever their contents change.
---@param segments Folder
local function watchSegments(segments)
	for _, connection in ipairs(AnomalyFinder.connections) do
		connection:Disconnect()
	end

	table.clear(AnomalyFinder.connections)

	local function bump(instance)
		local room = getOwningRoom(segments, instance)
		if room then
			roomVersions[room] = (roomVersions[room] or 0) + 1
			roomStructureTimes[room] = os.clock()
		end

		return room
	end

	local function onAdded(instance)
		local room = bump(instance)
		if room and room ~= instance then
			recordEntitySpawn(room, instance)
		end
	end

	table.insert(AnomalyFinder.connections, segments.DescendantAdded:Connect(onAdded))
	table.insert(AnomalyFinder.connections, segments.DescendantRemoving:Connect(bump))
	AnomalyFinder.watchedSegments = segments
end

---Find the segment the local player is standing in.
---@param segments Folder
---@return Model?
local function getCurrentRoom(segments)
	local character = localPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return nil
	end

	local position = rootPart.Position
	local bestRoom, bestDistance = nil, math.huge

	for _, room in ipairs(segments:GetChildren()) do
		local roomStart = room:FindFirstChild("RoomStart")
		local roomEnd = room:FindFirstChild("RoomEnd")
		if not (roomStart and roomEnd) then
			continue
		end

		-- Distance from the player to the start-end line segment of the room.
		local axis = roomEnd.Position - roomStart.Position
		local alpha = math.clamp((position - roomStart.Position):Dot(axis) / axis:Dot(axis), 0, 1)
		local distance = (roomStart.Position + axis * alpha - position).Magnitude

		if distance < bestDistance then
			bestRoom, bestDistance = room, distance
		end
	end

	return bestRoom
end

