---Get the game's AnomalyFunctions module table without requiring it ourselves.
---@return table?
local function getAnomalyFunctions()
	local gameGlobals = getrenv()._G
	local module = gameGlobals and gameGlobals.AnomalyFunctions
	return type(module) == "table" and module or nil
end

---Log client-side anomalies into the current room when the server triggers them.
local function wrapAnomalyFunctions()
	local module = getAnomalyFunctions()
	if not module then
		return
	end

	for key, original in pairs(module) do
		if type(original) ~= "function" or CLIENT_IGNORED[key] or wrappedAnomalyFunctions[key] then
			continue
		end

		local info = CLIENT_ANOMALIES[key] or { name = splitWords(key), detail = "" }

		local function record()
			if key == "DontMove" then
				AnomalyFinder.freezeUntil = os.clock() + AUTO.DONT_MOVE_FREEZE
			end

			local segments = workspaceService:FindFirstChild("MapSegments")
			local room = segments and AnomalyFinder.getCurrentRoom(segments)
			if not room then
				return
			end

			-- The spokesman's shadow parade: time to hide behind the counter.
			if key == "ShadowParade" then
				AnomalyFinder.spokesmanRoom = room
			end

			roomClientAnomalies[room] = roomClientAnomalies[room] or {}
			roomClientAnomalies[room][info.name] = info.detail
			roomVersions[room] = (roomVersions[room] or 0) + 1
		end

		wrappedAnomalyFunctions[key] = original
		ourWrappers[key] = function(...)
			if AnomalyFinder.running then
				pcall(record)
			end

			return original(...)
		end
		module[key] = ourWrappers[key]
	end

	-- Log what got us when a jumpscare plays, since those end the run without a report.
	local jumpscares = getrenv()._G.Jumpscares
	if type(jumpscares) == "table" and not AnomalyFinder.jumpscaresWrapped then
		AnomalyFinder.jumpscaresWrapped = true

		for key, original in pairs(jumpscares) do
			if type(original) == "function" then
				jumpscares[key] = function(...)
					if AnomalyFinder.running then
						-- Written straight away: the run ends and the server hops right after.
						local interface = AnomalyFinder.interface
						pcall(appendfile, REPORT_LOG_FILE, string.format(
							"[%s] Jumpscare %s | %s | doing: %s | evading: %s\n",
							os.date("%Y-%m-%d %H:%M:%S"),
							key,
							interface and interface.header.Text or "?",
							interface and interface.status.Text or "?",
							AnomalyFinder.evading and (AnomalyFinder.evading.parasite and "parasite" or "camouflage") or "no"
						))
					end

					return original(...)
				end
			end
		end
	end
end

---Save the game's post-level anomaly report next to what the panel saw in that corridor.
---@param report table
local function logReport(report)
	if type(report) ~= "table" or type(report.Anomalies) ~= "table" then
		return
	end

	local segments = workspaceService:FindFirstChild("MapSegments")
	local panelNames = {}

	for _, room in ipairs(segments and segments:GetChildren() or {}) do
		if room:GetAttribute("Level") ~= report.Level then
			continue
		end

		local seen = roomSeen[room]
		for _, name in ipairs(seen and seen.order or {}) do
			local anomaly = seen.byName[name]
			table.insert(panelNames, name .. ((anomaly.detail or "") ~= "" and " (" .. anomaly.detail .. ")" or ""))
		end
	end

	-- The game calls this from its own thread, which can't write files; the scan loop writes it.
	local line = string.format(
		"[%s] Level %s | real (%d): %s | panel (%d): %s | auto entered %s\n",
		os.date("%Y-%m-%d %H:%M:%S"),
		tostring(report.Level),
		#report.Anomalies,
		table.concat(report.Anomalies, ", "),
		#panelNames,
		table.concat(panelNames, ", "),
		tostring(AnomalyFinder.lastEntered)
	)

	table.insert(pendingReportLines, line)

	-- A known blind spot was missed: log what that corridor's bathroom looked like.
	for _, anomalyName in ipairs(report.Anomalies) do
		if DEEP_CHECKS[anomalyName] then
			table.insert(pendingDeepLevels, { level = report.Level, anomaly = anomalyName })
		end
	end
end

---Write queued report lines from the executor's own thread.
local function flushReportLog()
	for _, pending in ipairs(pendingDeepLevels) do
		table.insert(pendingReportLines, describeDeepDiff(pending.level, pending.anomaly))
	end

	table.clear(pendingDeepLevels)

	if #pendingReportLines == 0 then
		return
	end

	local lines = table.concat(pendingReportLines)
	table.clear(pendingReportLines)

	pcall(function()
		if not isfolder(REPORT_LOG_FOLDER) then
			makefolder(REPORT_LOG_FOLDER)
		end

		-- appendfile doesn't create a missing file on every executor.
		if isfile(REPORT_LOG_FILE) then
			appendfile(REPORT_LOG_FILE, lines)
		else
			writefile(REPORT_LOG_FILE, lines)
		end
	end)
end

---Watch the game's report so real anomaly IDs can be compared with the panel later.
local function wrapReport()
	local utility = getrenv()._G.LocalFunctions
	local original = type(utility) == "table" and utility.WrongCountEffect
	if type(original) ~= "function" or wrappedReport then
		return
	end

	wrappedReport = original
	ourWrappers.WrongCountEffect = function(report, ...)
		if AnomalyFinder.running then
			AnomalyFinder.lastWrongAt = os.clock()
			pcall(logReport, report)
		end

		return original(report, ...)
	end
	utility.WrongCountEffect = ourWrappers.WrongCountEffect
end

---Put the game's own anomaly functions back.
local function unwrapAnomalyFunctions()
	local module = getAnomalyFunctions()

	for key, original in pairs(wrappedAnomalyFunctions) do
		if module and module[key] == ourWrappers[key] then
			module[key] = original
		end
	end

	table.clear(wrappedAnomalyFunctions)

	local utility = getrenv()._G.LocalFunctions
	if wrappedReport and type(utility) == "table" and utility.WrongCountEffect == ourWrappers.WrongCountEffect then
		utility.WrongCountEffect = wrappedReport
	end

	wrappedReport = nil
	table.clear(ourWrappers)
end

---Stop the finder and clean up.
function AnomalyFinder.detach()
	AnomalyFinder.running = false
	unwrapAnomalyFunctions()

	for _, connection in ipairs(AnomalyFinder.connections) do
		connection:Disconnect()
	end

	table.clear(AnomalyFinder.connections)

	for _, connection in ipairs(AnomalyFinder.controlConnections) do
		connection:Disconnect()
	end

	table.clear(AnomalyFinder.controlConnections)

	for _, connection in ipairs(roomConnections) do
		connection:Disconnect()
	end

	table.clear(roomConnections)
	watchedRoom = nil
	AnomalyFinder.autoEnabled = false
	AnomalyFinder.espEnabled = false
	if AnomalyFinder.clearEsp then
		pcall(AnomalyFinder.clearEsp)
	end

	if AnomalyFinder.interface then
		AnomalyFinder.interface.gui:Destroy()
		AnomalyFinder.interface.espGui:Destroy()
		AnomalyFinder.interface = nil
	end
end

---Mark the current room changed whenever any of its parts change a property.
---@param room Model
local function watchRoom(room)
	if watchedRoom == room then
		return
	end

	for _, connection in ipairs(roomConnections) do
		connection:Disconnect()
	end

	table.clear(roomConnections)
	watchedRoom = room

	local function bump()
		roomVersions[room] = (roomVersions[room] or 0) + 1
	end

	-- A knock is only a sound; record it the moment it plays.
	local function onKnock(sound)
		roomKnocks[room] = roomKnocks[room] or {}
		roomKnocks[room][getKnockSource(room, sound)] = true
		bump()
	end

	local function hook(instance)
		table.insert(roomConnections, instance.Changed:Connect(bump))

		-- Record anomaly-only sounds the moment they start.
		local soundAnomaly = getSoundAnomaly(instance)
		if soundAnomaly then
			local function onSound()
				if not instance.Playing then
					return
				end

				roomClientAnomalies[room] = roomClientAnomalies[room] or {}
				roomClientAnomalies[room][soundAnomaly] = ""
				bump()
			end

			table.insert(roomConnections, instance.Played:Connect(onSound))
			table.insert(roomConnections, instance:GetPropertyChangedSignal("Playing"):Connect(onSound))
		end

		if instance:IsA("Sound") and instance.Name == "Knock" then
			table.insert(roomConnections, instance.Played:Connect(function()
				onKnock(instance)
			end))

			table.insert(roomConnections, instance:GetPropertyChangedSignal("Playing"):Connect(function()
				if instance.Playing then
					onKnock(instance)
				end
			end))
		end
	end

	table.insert(roomConnections, room.DescendantAdded:Connect(hook))

	for _, descendant in ipairs(room:GetDescendants()) do
		throttle()

		if watchedRoom ~= room then
			return
		end

		hook(descendant)
	end
end

---Whether a listed anomaly belongs to the corridor's NPC ("John's hair", "Jimmy's size").
---@param name string
---@param suffix string?
---@return boolean
local function isNpcAnomaly(name, suffix)
	for _, npcName in ipairs(NPC_NAMES) do
		local prefix = npcName .. "'s"
		if name:sub(1, #prefix) == prefix and (not suffix or name == npcName .. suffix) then
			return true
		end
	end

	return false
end

---Whether any NPC in this room is listed as having the parasite.
---@param seen table
---@return boolean
local function hasParasiteListed(seen)
	for _, npcName in ipairs(NPC_NAMES) do
		if seen.byName[npcName .. PARASITE_SUFFIX] then
			return true
		end
	end

	return false
end

---When the parasite turned its host (set by the chaser watcher). Speed and color changes
---before that are anomalies of their own.
---@param seen table
---@return number?
local function getParasiteSeenTime(seen)
	return seen.parasiteTurnedAt
end

---Flickering lights change two or more of their glow material, color and brightness at
---once; that's one anomaly (the lights flickering), not one per property.
---@param anomalies table
---@return table
local function mergeFlicker(anomalies)
	local byName = {}
	for _, anomaly in ipairs(anomalies) do
		byName[anomaly.name] = anomaly
	end

	local folded = {}
	for lightName in pairs(CATEGORY_SPLIT_OBJECTS) do
		local present = 0
		for _, suffix in ipairs({ " material", " brightness" }) do
			if byName[lightName .. suffix] then
				present += 1
			end
		end

		-- A new hue (the colored lights anomaly) stays its own entry.
		if present >= 2 then
			-- Flickering also swaps glow parts in and out.
			for _, suffix in ipairs({ " material", " brightness", " something added", " part missing" }) do
				folded[lightName .. suffix] = lightName
			end
		end
	end

	if next(folded) == nil then
		return anomalies
	end

	local result, added = {}, {}
	for _, anomaly in ipairs(anomalies) do
		local lightName = folded[anomaly.name]
		if not lightName then
			table.insert(result, anomaly)
		elseif not added[lightName] then
			added[lightName] = true
			table.insert(result, {
				name = lightName .. " flicker",
				kind = "Altered",
				detail = "",
				targets = anomaly.targets,
				firstSeen = anomaly.firstSeen,
			})
		end
	end

	return result
end

---Whether a change on the NPC is what falling over does to him (limbs posed, parts shifted),
---rather than something like a new color or outfit, which a fall can't cause.
---@param entry table
---@return boolean
local function isRagdollNoise(entry)
	if entry.kind ~= "Altered" then
		return false
	end

	for label in entry.detail:gmatch("[^,]+") do
		if not ATTACHMENT_SIDE_EFFECTS[label:match("^%s*(.-)%s*$")] then
			return false
		end
	end

	return true
end

---Merge a fresh scan into everything seen in this room so brief anomalies stay listed.
---@param room Model
---@param anomalies table
---@return table
local function rememberAnomalies(room, anomalies)
	local seen = roomSeen[room]
	if not seen then
		seen = { byName = {}, order = {} }
		roomSeen[room] = seen
	end

	local now = os.clock()
	local passTargets = {}

	for _, anomaly in ipairs(anomalies) do
		anomaly.name = ANOMALY_ALIASES[anomaly.name] or anomaly.name

		-- An entity can be found at its spawn marker and in Debris; both are one anomaly.
		local entityName = anomaly.name:match("^(.-) %(entity%)$")
		if entityName then
			anomaly.name = ANOMALY_ALIASES[entityName] or entityName

			if anomaly.detail == "" or anomaly.detail == "appeared" then
				anomaly.detail = "entity"
			end
		end

		-- Multi-piece anomalies read the same no matter which piece was seen.
		local fixed = FIXED_ANOMALIES[anomaly.name]
		if fixed then
			anomaly.kind, anomaly.detail = fixed.kind, fixed.detail
		end

		-- Changes picked up while the NPC was being ragdolled belong to his death.
		if anomaly.death then
			for index = #seen.order, 1, -1 do
				local name = seen.order[index]
				local entry = seen.byName[name]

				-- Falling over also switches off his joints and whatever his root part carries.
				local switchedOff = entry.kind == "Altered"
				for label in entry.detail:gmatch("[^,]+") do
					label = label:match("^%s*(.-)%s*$")
					if label ~= "toggled" and not ATTACHMENT_SIDE_EFFECTS[label] then
						switchedOff = false
					end
				end

				if isNpcAnomaly(name) and now - entry.firstSeen < DEATH_GRACE and (isRagdollNoise(entry) or switchedOff) then
					seen.byName[name] = nil
					table.remove(seen.order, index)
				end
			end
		end

		-- A parasite NPC dies as part of that anomaly; his death isn't a separate one.
		if anomaly.death and hasParasiteListed(seen) then
			continue
		end

		local existing = seen.byName[anomaly.name]

		-- Several pieces can land on one name (the spokesman's entities); box all of them.
		if anomaly.targets and #anomaly.targets > 0 then
			passTargets[anomaly.name] = passTargets[anomaly.name] or {}
			for _, target in ipairs(anomaly.targets) do
				table.insert(passTargets[anomaly.name], target)
			end
		end

		if existing then
			existing.kind = anomaly.kind
			existing.detail = anomaly.detail
			existing.ghosts = anomaly.ghosts or existing.ghosts
		else
			anomaly.firstSeen = now
			seen.byName[anomaly.name] = anomaly
			table.insert(seen.order, anomaly.name)
		end
	end

	for name, targets in pairs(passTargets) do
		if seen.byName[name] then
			seen.byName[name].targets = targets
		end
	end

	-- Lights going dark during Don't move belong to that anomaly.
	local dontMove = seen.byName["Don't move"] ~= nil
	local parasiteSeenAt = getParasiteSeenTime(seen)

	local merged = {}
	for _, name in ipairs(seen.order) do
		local anomaly = seen.byName[name]
		local partOfDontMove = dontMove and DONT_MOVE_PARTS[name] == true

		local isCompanion = false
		for _, companionOf in ipairs(DEBRIS_COMPANIONS[name] or {}) do
			local owner = seen.byName[companionOf]
			-- Lights already flickering before the spokesman showed up are their own anomaly.
			local predates = companionOf == "Spokesman" and owner and anomaly.firstSeen
				and owner.firstSeen and anomaly.firstSeen < owner.firstSeen - 1
			if owner and not predates then
				isCompanion = true
			end
		end

		-- Drawing the gun shows/hides his things; a recolored briefcase is still its own anomaly.
		if isCompanion and isNpcAnomaly(name) then
			local kept = {}
			for label in anomaly.detail:gmatch("[^,]+") do
				label = label:match("^%s*(.-)%s*$")
				if label ~= "transparency" and label ~= "toggled" and label ~= "" then
					table.insert(kept, label)
				end
			end
			if #kept > 0 then
				isCompanion = false
				anomaly = table.clone(anomaly)
				anomaly.detail = table.concat(kept, ", ")
			end
		end
		if isCompanion then
			continue
		end

		-- Once the parasite turns him it speeds him up and tints him and what he holds; speed or
		-- colors he had before that are anomalies of their own.
		local parasiteEffect = isNpcAnomaly(name, "'s speed") or isNpcAnomaly(name, "'s color")
		if anomaly.kind == "Altered" and anomaly.detail ~= "" and not parasiteEffect then
			parasiteEffect = true
			for label in anomaly.detail:gmatch("[^,]+") do
				label = label:match("^%s*(.-)%s*$")
				-- On John himself the turn also switches his effects and shifts his limbs.
				local npcSideEffect = isNpcAnomaly(name) and (label == "toggled" or ATTACHMENT_SIDE_EFFECTS[label])
				if not (COLOR_LABELS[label] or npcSideEffect) then
					parasiteEffect = false
				end
			end
		end
		if parasiteSeenAt and parasiteEffect and anomaly.firstSeen >= parasiteSeenAt - PARASITE_SPEED_SLACK then
			continue
		end

		-- Shrinking him slows his walk along with it; that's the size anomaly. Faster is its own.
		if isNpcAnomaly(name, "'s speed") and anomaly.detail == "slower" then
			local npcName = name:sub(1, #name - #"'s speed")
			local size = seen.byName[npcName .. "'s size"]
			if size and size.detail == "smaller" then
				continue
			end
		end

		if dontMove and DONT_MOVE_LIGHTS[name] then
			partOfDontMove = true

			for label in anomaly.detail:gmatch("[^,]+") do
				if not LIGHTS_OFF_LABELS[label:match("^%s*(.-)%s*$")] then
					partOfDontMove = false
				end
			end
		end

		if not partOfDontMove then
			table.insert(merged, anomaly)
		end
	end

	merged = mergeFlicker(merged)

	table.sort(merged, function(a, b)
		return a.name < b.name
	end)

	return merged
end

---Scan a room only when it changed or its periodic re-check is due.
---@param room Model
---@return table?
local function getRoomAnomalies(room)
	local cached = roomCache[room]
	local version = roomVersions[room] or 0

	-- Parts are still streaming in or out; wait for the room to settle, but not forever.
	local now = os.clock()
	if now - (roomStructureTimes[room] or 0) < SETTLE_TIME then
		roomWaitStarts[room] = roomWaitStarts[room] or now

		if now - roomWaitStarts[room] < MAX_SETTLE_WAIT then
			return cached and cached.anomalies
		end
	end

	roomWaitStarts[room] = nil

	if cached then
		local age = os.clock() - cached.time

		-- Flickering or animating parts change constantly; cap the scan rate.
		if age < MIN_SCAN_GAP or (cached.version == version and age < RESCAN_INTERVAL) then
			return cached.anomalies
		end
	end

	local anomalies = rememberAnomalies(room, scanRoom(room))
	roomCache[room] = { version = version, time = os.clock(), anomalies = anomalies }

	return anomalies
end

---A part to hang an ESP label on.
---@param instance Instance
---@return BasePart?
local function getLabelPart(instance)
	if instance:IsA("BasePart") then
		return instance
	end

	if instance:IsA("Model") and instance.PrimaryPart then
		return instance.PrimaryPart
	end

	return instance:FindFirstChildWhichIsA("BasePart", true)
end

---What a box can be drawn around for one target: itself, or the pieces inside a folder.
---@param instance Instance
---@return table
local function getBoxAdornees(instance)
	if instance:IsA("BasePart") or instance:IsA("Model") then
		return { instance }
	end

	local adornees = {}
	for _, child in ipairs(instance:GetChildren()) do
		if child:IsA("BasePart") or child:IsA("Model") then
			table.insert(adornees, child)
		end
	end

	if #adornees == 0 then
		local part = getLabelPart(instance)
		if part then
			table.insert(adornees, part)
		end
	end

	return adornees
end

local espState = { signature = nil, anchors = {} }

---Remove every ESP box and label.
local function clearEsp()
	local interface = AnomalyFinder.interface
	if interface then
		interface.espGui:ClearAllChildren()
	end

	for _, anchor in ipairs(espState.anchors) do
		anchor:Destroy()
	end

	table.clear(espState.anchors)
	espState.signature = nil
end

---Draw a box around everything listed in the current corridor.
---@param anomalies table?
local function updateEsp(anomalies)
	local interface = AnomalyFinder.interface
	if not interface or not anomalies then
		return
	end

	-- Rebuild only when the list or what it points at changes.
	local parts = {}
	for _, anomaly in ipairs(anomalies) do
		local alive = 0
		for _, target in ipairs(anomaly.targets or {}) do
			if target.Parent then
				alive += 1
			end
		end

		table.insert(parts, anomaly.name .. ":" .. anomaly.kind .. ":" .. alive .. ":" .. (anomaly.ghosts and #anomaly.ghosts or 0))
	end

	local signature = table.concat(parts, "|")
	if signature == espState.signature then
		return
	end

	clearEsp()
	espState.signature = signature

	for _, anomaly in ipairs(anomalies) do
		local color = AUTO.ESP_COLORS[anomaly.kind] or AUTO.ESP_COLORS.Altered
		local labelPart = nil
		local boxes = 0

		for _, target in ipairs(anomaly.targets or {}) do
			if not target.Parent then
				continue
			end

			for _, adornee in ipairs(getBoxAdornees(target)) do
				if boxes >= AUTO.ESP_MAX_BOXES then
					break
				end

				local box = Instance.new("SelectionBox")
				box.Adornee = adornee
				box.Color3 = color
				box.SurfaceColor3 = color
				box.SurfaceTransparency = 0.85
				box.LineThickness = 0.04
				box.Parent = interface.espGui
				boxes += 1
			end

			labelPart = labelPart or getLabelPart(target)
		end

		-- Missing things get a see-through box where they should be.
		for _, ghost in ipairs(anomaly.ghosts or {}) do
			local box = Instance.new("BoxHandleAdornment")
			box.Adornee = workspaceService.Terrain
			box.CFrame = ghost.cframe
			box.Size = ghost.size
			box.Color3 = color
			box.Transparency = 0.7
			box.AlwaysOnTop = true
			box.ZIndex = 1
			box.Parent = interface.espGui

			if not labelPart then
				local anchor = Instance.new("Part")
				anchor.Anchored = true
				anchor.CanCollide = false
				anchor.CanQuery = false
				anchor.CanTouch = false
				anchor.Transparency = 1
				anchor.Size = Vector3.one * 0.2
				anchor.CFrame = ghost.cframe
				anchor.Parent = workspaceService.CurrentCamera
				table.insert(espState.anchors, anchor)
				labelPart = anchor
			end
		end

		if labelPart then
			local billboard = Instance.new("BillboardGui")
			billboard.Adornee = labelPart
			billboard.AlwaysOnTop = true
			billboard.Size = UDim2.fromOffset(220, 22)
			billboard.StudsOffset = Vector3.new(0, 2.5, 0)
			billboard.Parent = interface.espGui

			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.GothamBold
			label.TextSize = 13
			label.TextColor3 = color
			label.TextStrokeTransparency = 0.4
			label.Text = anomaly.name .. (anomaly.detail ~= "" and (" (" .. anomaly.detail .. ")") or "")
			label.Parent = billboard
		end
	end
end

---The local character's humanoid and root part.
---@return Humanoid?, BasePart?
local function getCharacterParts()
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not rootPart or humanoid.Health <= 0 then
		return nil, nil
	end

	return humanoid, rootPart
end

---Show what full auto is doing.
---@param text string
local function setAutoStatus(text)
	local interface = AnomalyFinder.interface
	if interface then
		-- Keep the last few steps, so a run that ends without a report shows what led to it.
		if interface.status.Text ~= text and text ~= "" then
			local history = AnomalyFinder.statusHistory or {}
			AnomalyFinder.statusHistory = history
			table.insert(history, string.format("%s %s", os.date("%M:%S"), text))
			if #history > 25 then
				table.remove(history, 1)
			end
		end

		interface.status.Text = text
		interface.status.Visible = AnomalyFinder.autoEnabled == true and text ~= ""
	end
end

---Answer John's "are you an anomaly?" question.
local function answerJohnQuestion()
	local events = localPlayer.PlayerGui:FindFirstChild("Events")
	local question = events and events:FindFirstChild("JohnQuestion")
	local frame = question and question:FindFirstChild("Frame")
	local answer = frame and frame:FindFirstChild("No")

	if not (question and question.Visible and frame.Visible and answer) then
		return
	end

	if AnomalyFinder.lastAnswer and os.clock() - AnomalyFinder.lastAnswer < 3 then
		return
	end

	AnomalyFinder.lastAnswer = os.clock()
	pcall(firesignal, answer.Activated)
end

---Whether standing still is required right now (Don't move, or the game holding the player).
---@param room Model?
---@return boolean
local function mustStandStill(room)
	if os.clock() < (AnomalyFinder.freezeUntil or 0) then
		return true
	end

	local debris = room and room:FindFirstChild("Debris")
	if debris and debris:FindFirstChild("Creature") then
		return true
	end

	local _, rootPart = getCharacterParts()
	return rootPart ~= nil and rootPart.Anchored
end

---Stop walking on the spot.
local function stopWalking()
	local humanoid, rootPart = getCharacterParts()
	if humanoid then
		humanoid:Move(Vector3.zero)
		humanoid:MoveTo(rootPart.Position)
	end
end

---The camouflage entity and a parasite John chase you and kill on contact; the chaser
---watcher pulls you back to the corridor's start the moment one starts. Here the auto
---loop just waits until that's over.
---@param room Model?
local function evadeChaser(room)
	local evading = AnomalyFinder.evading
	if not evading then
		return
	end

	local chaserName = evading.parasite and "the parasite" or evading.target.Name
	if not evading.atStart then
		setAutoStatus("Hiding behind the counter from " .. chaserName)
		return true
	end

	-- Wait at the start until it's gone, then jump straight to the counter.
	setAutoStatus("Waiting at the start for " .. chaserName .. " to give up")
	while AnomalyFinder.autoEnabled and AnomalyFinder.evading == evading do
		task.wait(0.1)
	end

	-- The watcher has put us behind the counter by now; the sweep is over for this corridor.
	AnomalyFinder.skipSweep = evading.room
	return true
end

---Wait out anything that needs the player to stay put.
---@param room Model?
local function waitWhileFrozen(room)
	local _, moved = pcall(evadeChaser, room)
	local froze = false

	while AnomalyFinder.autoEnabled and mustStandStill(room) do
		froze = true
		stopWalking()
		answerJohnQuestion()
		setAutoStatus("Standing still...")
		task.wait(0.1)
	end

	return moved == true or froze
end

---Keep pathfinding away from hazards like the electric puddle.
---@param room Model
local function markHazards(room)
	local debris = room:FindFirstChild("Debris")
	if not debris then
		return
	end

	for _, child in ipairs(debris:GetChildren()) do
		for _, pattern in ipairs(AUTO.HAZARD_PATTERNS) do
			if child.Name:find(pattern) and not child:FindFirstChild("AutoHazard", true) then
				local modifier = Instance.new("PathfindingModifier")
				modifier.Name = "AutoHazard"
				modifier.Label = "Hazard"
				modifier.Parent = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart", true)
			end
		end
	end
end

---Whether a point is on or right next to a hazard (an electric or void puddle).
---@param room Model
---@param position Vector3
---@return boolean
local function isHazardPoint(room, position)
	local debris = room:FindFirstChild("Debris")
	if not debris then
		return false
	end

	for _, child in ipairs(debris:GetChildren()) do
		for _, pattern in ipairs(AUTO.HAZARD_PATTERNS) do
			if child.Name:find(pattern) then
				local parts = child:IsA("BasePart") and { child } or child:GetDescendants()
				for _, part in ipairs(parts) do
					if part:IsA("BasePart") then
						local offset = part.CFrame:PointToObjectSpace(position)
						local half = part.Size / 2
						if math.abs(offset.X) <= half.X + AUTO.HAZARD_MARGIN
							and math.abs(offset.Z) <= half.Z + AUTO.HAZARD_MARGIN
							and math.abs(offset.Y) <= half.Y + 6
						then
							return true
						end
					end
				end
			end
		end
	end

	return false
end

---Horizontal distance between two points, with the height difference.
---@param a Vector3
---@param b Vector3
---@return number, number
local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude, math.abs(a.Y - b.Y)
end

---Whether the end-of-run screen is up.
---@return boolean
local function isRunOver()
	local hud = localPlayer.PlayerGui:FindFirstChild("HUD")
	local ending = hud and hud:FindFirstChild("Ending")
	return ending ~= nil and ending.Visible
end

---Move the character straight to a point, keeping which way it faces.
---@param position Vector3
local function hopTo(position)
	local _, rootPart = getCharacterParts()
	if not rootPart or AnomalyFinder.evading then
		return
	end

	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.CFrame = CFrame.new(position) * rootPart.CFrame.Rotation
end

---Walk to a point with pathfinding, standing still whenever the corridor demands it.
---@param room Model
---@param target Vector3
---@param arriveDistance number
---@return boolean
local function walkTo(room, target, arriveDistance)
	local deadline = os.clock() + AUTO.WALK_TIMEOUT

	while AnomalyFinder.autoEnabled and os.clock() < deadline do
		-- Hiding behind the counter: the corridor's walk is over. Running back to the start:
		-- wait it out, then carry on from wherever that leaves us.
		if AnomalyFinder.evading then
			if not AnomalyFinder.evading.atStart then
				return false
			end
			waitWhileFrozen(room)
			continue
		end

		if isRunOver() then
			return false
		end

		waitWhileFrozen(room)
		answerJohnQuestion()

		local humanoid, rootPart = getCharacterParts()
		if not humanoid then
			task.wait(0.5)
			continue
		end

		local distance, height = flatDistance(rootPart.Position, target)
		if distance <= arriveDistance and height < 8 then
			return true
		end

		markHazards(room)

		local path = pathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
			WaypointSpacing = 4,
			Costs = { Hazard = math.huge },
		})

		local computed = pcall(function()
			path:ComputeAsync(rootPart.Position, target)
		end)

		if not computed or path.Status ~= Enum.PathStatus.Success then
			-- No path (a closed door, a target inside a wall); head straight there and retry.
			if AUTO.TELEPORT then
				hopTo(target)
				task.wait(0.2)
				return true
			end

			humanoid:MoveTo(target)
			task.wait(0.5)
			continue
		end

		-- Something blocking the corridor (the locked counter) can send the path back
		-- through earlier corridors; teleporting straight there is far quicker.
		local waypoints = path:GetWaypoints()
		if AUTO.TELEPORT then
			local pathLength = 0
			for index = 2, #waypoints do
				pathLength += (waypoints[index].Position - waypoints[index - 1].Position).Magnitude
			end

			if pathLength > (target - rootPart.Position).Magnitude * 2 + 30 then
				hopTo(target + Vector3.new(0, 3, 0))
				task.wait(0.2)
				return true
			end
		end

		local lastHop = nil
		local hopped = false
		for index, waypoint in ipairs(waypoints) do
			if index == 1 then
				continue
			end

			if not AnomalyFinder.autoEnabled or mustStandStill(room) then
				break
			end

			-- Never land on a puddle; hopping over it means we never touch it.
			if AUTO.TELEPORT and isHazardPoint(room, waypoint.Position) then
				continue
			end

			if AUTO.TELEPORT then
				local hopTarget = waypoint.Position + Vector3.new(0, 3, 0)
				local from = lastHop or rootPart.Position
				local offset = hopTarget - from
				local steps = math.max(1, math.ceil(offset.Magnitude / AUTO.STEP_SIZE))
				local interrupted = false

				for step = 1, steps do
					local point = from + offset * (step / steps)
					local flat = Vector3.new(offset.X, 0, offset.Z)

					-- Never land on a puddle; stepping over it means we never touch it.
					if AnomalyFinder.evading then
						interrupted = true
						break
					end

					if step == steps or not isHazardPoint(room, point - Vector3.new(0, 3, 0)) then
						local _, stepRoot = getCharacterParts()
						if stepRoot then
							stepRoot.AssemblyLinearVelocity = Vector3.zero
							stepRoot.CFrame = flat.Magnitude > 0.1 and CFrame.lookAt(point, point + flat) or CFrame.new(point) * stepRoot.CFrame.Rotation
						end
					end

					task.wait(AUTO.STEP_DELAY)

					-- The game moved us (a wrong answer, a death); stop following the old path.
					local _, movedRoot = getCharacterParts()
					if movedRoot and (movedRoot.Position - point).Magnitude > AUTO.DOOR_LEASH then
						return false
					end

					-- Ran back from a chaser or froze in place; plan a fresh path from here.
					if waitWhileFrozen(room) or not AnomalyFinder.autoEnabled then
						interrupted = true
						break
					end
				end

				if interrupted then
					hopped = true
					break
				end

				lastHop = hopTarget
				hopped = true
				continue
			end

			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end

			humanoid:MoveTo(waypoint.Position)

			local started = os.clock()
			local stuck = false

			while AnomalyFinder.autoEnabled do
				humanoid, rootPart = getCharacterParts()
				if not humanoid or mustStandStill(room) then
					break
				end

				if flatDistance(rootPart.Position, waypoint.Position) < 2.5 then
					break
				end

				if os.clock() - started > AUTO.STEP_TIMEOUT then
					stuck = true
					break
				end

				task.wait(0.05)
			end

			if stuck or not humanoid then
				break
			end
		end

		-- Every step left lands in a puddle; give up on this spot rather than spin here.
		if AUTO.TELEPORT and not hopped then
			return false
		end
	end

	return false
end

---Points on the floor around the counter's button, within clicking range.
---@param counter Model
---@return table
local function getCounterSpots(counter)
	local button = counter:FindFirstChild("Button")
	if not button then
		return {}
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { localPlayer.Character, counter }

	local spots = {}
	for step = 0, 7 do
		local angle = step * math.pi / 4
		local start = button.Position + Vector3.new(math.cos(angle) * 4, 2, math.sin(angle) * 4)
		local hit = workspaceService:Raycast(start, Vector3.new(0, -15, 0), params)

		if hit and hit.Normal.Y > 0.7 then
			table.insert(spots, hit.Position + Vector3.new(0, 3, 0))
		end
	end

	-- Nearest to the corridor's start first, so the walk ends on the open side.
	table.sort(spots, function(a, b)
		return (a - button.Position).Magnitude < (b - button.Position).Magnitude
	end)

	return spots
end

---Put a number on the corridor's anomaly counter.
---@param counter Model
---@param amount number
---@return boolean
local function setCounter(counter, amount)
	local screen = counter:FindFirstChild("Screen")
	local display = screen and screen:FindFirstChildWhichIsA("TextLabel", true)
	local reset = counter:FindFirstChild("Reset")
	local button = counter:FindFirstChild("Button")

	local resetDetector = reset and reset:FindFirstChildOfClass("ClickDetector")
	local buttonDetector = button and button:FindFirstChildOfClass("ClickDetector")
	if not (display and resetDetector and buttonDetector) then
		return false
	end


	for _ = 1, 3 do
		if tonumber(display.Text) == amount then
			return true
		end

		-- Only top up from what's already on it; reset only when it's over.
		local current = tonumber(display.Text)
		local clicks = amount
		if current and current <= amount then
			clicks = amount - current
		else
			fireclickdetector(resetDetector)
			task.wait(AUTO.CLICK_DELAY + 0.1)
		end

		for _ = 1, clicks do
			fireclickdetector(buttonDetector)
			task.wait(AUTO.CLICK_DELAY)
		end

		task.wait(0.3)
	end

	return tonumber(display.Text) == amount
end

---The corridor with the given level, if it exists.
---@param segments Instance
---@param level number
---@return Model?
local function findRoomByLevel(segments, level)
	for _, room in ipairs(segments:GetChildren()) do
		if room:GetAttribute("Level") == level then
			return room
		end
	end

	return nil
end

---Hover in place while auto runs (like Infinite Yield's fly): no falling or sliding between
---hops, and we can wait outside the corridor's walls.
---@param enabled boolean
local function updateFly(enabled)
	local humanoid, rootPart = getCharacterParts()
	if not (humanoid and rootPart) then
		return
	end

	local gyro = rootPart:FindFirstChild("AnomalyFinderGyro")
	local velocity = rootPart:FindFirstChild("AnomalyFinderVelocity")

	if not enabled then
		if gyro or velocity then
			if gyro then
				gyro:Destroy()
			end
			if velocity then
				velocity:Destroy()
			end
			humanoid.PlatformStand = false
		end
		return
	end

	if not gyro then
		gyro = Instance.new("BodyGyro")
		gyro.Name = "AnomalyFinderGyro"
		gyro.P = 9e4
		gyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		gyro.Parent = rootPart
	end

	if not velocity then
		velocity = Instance.new("BodyVelocity")
		velocity.Name = "AnomalyFinderVelocity"
		velocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		velocity.Parent = rootPart
	end

	-- Stay upright, facing wherever the last hop pointed us. While told not to move, hold
	-- exactly as we are: even turning on the spot could count as moving.
	local look = rootPart.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if os.clock() < (AnomalyFinder.freezeUntil or 0) then
		gyro.CFrame = rootPart.CFrame.Rotation
	elseif flat.Magnitude > 0.1 then
		gyro.CFrame = CFrame.lookAt(Vector3.zero, flat)
	end

	velocity.Velocity = Vector3.zero
	humanoid.PlatformStand = true
end

---The spot just behind the anomaly counter, on the far side of its wall: out of reach of
---anything chasing us, but still close enough to click the counter.
---@param room Model
---@return Vector3?
local function getRefuge(room)
	local objects = room:FindFirstChild("Objects")
	local counter = objects and objects:FindFirstChild("AnomalyCounter")
	local button = counter and counter:FindFirstChild("Button")
	local front = counter and getCounterSpots(counter)[1]
	if not (button and front) then
		return nil
	end

	-- The counter is a thin panel on the wall; its thin side points through the wall.
	local through = button.CFrame.RightVector
	if through:Dot(button.Position - front) < 0 then
		through = -through
	end

	return button.Position + through * AUTO.REFUGE_DEPTH
end

---Every frame: keep fly on, answer John's question, and spot the camouflage entity,
---Carnis or a parasite John starting to chase. Then hide behind the counter until auto
---has put the count in and heads for the door.
local function watchChasers()
	if not AnomalyFinder.autoEnabled then
		AnomalyFinder.evading = nil
		updateFly(false)
	else
		updateFly(true)
		-- John's question (the gun one too) holds us in place until it's answered; always "No".
		answerJohnQuestion()
	end

	local segments = workspaceService:FindFirstChild("MapSegments")
	local gameInfo = workspaceService:FindFirstChild("GameInfo")
	local level = gameInfo and gameInfo:GetAttribute("LatestRoomId")
	local room = segments and level and findRoomByLevel(segments, level)

	local evading = AnomalyFinder.evading
	if evading then
		local over = evading.room ~= room or os.clock() > evading.deadline

		-- Waiting at the start: the camouflage gives up and goes still, a parasite John dies.
		if evading.atStart and not over then
			local target = evading.target
			if not target.Parent or (evading.parasite and isJohnDead(target)) then
				over = true
			elseif not evading.parasite then
				local position = target:GetPivot().Position
				if (position - evading.lastPosition).Magnitude > 0.05 or target:GetAttribute("Walking") then
					evading.lastMoved = os.clock()
				end
				evading.lastPosition = position
				over = os.clock() - evading.lastMoved > AUTO.CHASER_CALM
			end
		end

		if over then
			AnomalyFinder.evading = nil

			-- It gave up. Stay at the start: the counter takes clicks from here, and the trip
			-- to the door keeps an eye on it.
			if evading.atStart and evading.room == room and AnomalyFinder.autoEnabled then
				AnomalyFinder.skipSweep = room
				if not evading.parasite then
					AnomalyFinder.lastChaser = { room = room, target = evading.target }
				end
			end
			return
		end

		local _, rootPart = getCharacterParts()
		if rootPart then
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.CFrame = CFrame.new(evading.refuge) * rootPart.CFrame.Rotation
		end
		return
	end

	-- Already hid in this corridor and the count is in; we're on our way out.
	local debris = room and room ~= AnomalyFinder.hidRoom and room:FindFirstChild("Debris")
	if not debris then
		return
	end

	-- Chasers (the camouflage, Carnis, a parasite John) give up once we're back at the
	-- corridor's start; the spokesman is waited out behind the counter instead.
	local function startEvading(target, parasite, atStart)
		local spawn = room:FindFirstChild("Spawn")
		local refuge = atStart and spawn and spawn.Position + Vector3.new(0, 3, 0) or getRefuge(room)
		if not refuge then
			return
		end

		AnomalyFinder.evading = {
			room = room, refuge = refuge, target = target, parasite = parasite, atStart = atStart,
			deadline = os.clock() + (atStart and AUTO.CHASE_TIMEOUT or AUTO.EVADE_TIMEOUT),
			lastPosition = target:GetPivot().Position, lastMoved = os.clock(),
		}
		table.insert(pendingReportLines, string.format(
			"[%s] %s | corridor %s | from %s\n",
			os.date("%Y-%m-%d %H:%M:%S"), atStart and "Ran back to the start" or "Hid behind the counter",
			tostring(level), target.Name
		))
		watchChasers()
	end

	-- The spokesman: hide as soon as he or one of his attacks is there.
	if AnomalyFinder.autoEnabled and AnomalyFinder.spokesmanRoom == room then
		startEvading(room, false)
		return
	end

	-- The camouflage entity or Carnis: chasing the moment they move at all.
	for _, chaser in ipairs(debris:GetChildren()) do
		for _, name in ipairs(AUTO.HIDE_FROM) do
			if AnomalyFinder.autoEnabled and chaser.Name:find(name, 1, true) then
				startEvading(chaser, false)
				return
			end
		end

		local isChaser = false
		for _, name in ipairs(AUTO.CHASERS) do
			if chaser.Name:find(name) then
				isChaser = true
			end
		end

		if isChaser and AnomalyFinder.autoEnabled and chaser:IsA("Model") then
			local position = chaser:GetPivot().Position
			local lastPositions = AnomalyFinder.chaserPositions or setmetatable({}, { __mode = "k" })
			AnomalyFinder.chaserPositions = lastPositions
			local lastPosition = lastPositions[chaser] or position
			lastPositions[chaser] = position

			-- Where it waits before it ever moves.
			AnomalyFinder.chaserOrigins = AnomalyFinder.chaserOrigins or setmetatable({}, { __mode = "k" })
			AnomalyFinder.chaserOrigins[chaser] = AnomalyFinder.chaserOrigins[chaser] or position

			if (position - lastPosition).Magnitude > 0.05 or chaser:GetAttribute("Walking") then
				startEvading(chaser, false, true)
				return
			end
		end
	end

	-- A parasite John: his walk speed changes the moment he turns (it drops to 0 for the
	-- transformation, then jumps up for the chase).
	local seen = roomSeen[room]
	local npc = findNpc(room)
	local humanoid = npc and npc:FindFirstChildOfClass("Humanoid")
	if not (seen and humanoid and hasParasiteListed(seen)) or AnomalyFinder.parasiteWaitedRoom == room then
		return
	end

	if AnomalyFinder.parasiteSpeedRoom ~= room then
		AnomalyFinder.parasiteSpeedRoom = room
		AnomalyFinder.parasitePreSpeed = humanoid.WalkSpeed
	end

	if humanoid.WalkSpeed ~= AnomalyFinder.parasitePreSpeed and not isJohnDead(npc) then
		AnomalyFinder.parasiteWaitedRoom = room
		-- What changes on him from here on is the parasite's doing.
		seen.parasiteTurnedAt = os.clock()
		if AnomalyFinder.autoEnabled then
			startEvading(npc, true, true)
		end
	end
end

---Sweep the corridor in short hops, passing through every trigger zone on the way, so
---everything in it gets set off.
---@param room Model
local function visitTriggers(room)
	local zones = room:FindFirstChild("Zones")
	if not zones then
		return
	end

	local triggers = {}
	for _, zone in ipairs(zones:GetChildren()) do
		local skipped = false
		for _, pattern in ipairs(AUTO.SKIPPED_TRIGGERS) do
			if zone.Name:find(pattern) then
				skipped = true
			end
		end

		if zone:IsA("BasePart") and not skipped then
			table.insert(triggers, zone)
		end
	end

	-- Visit them in the order a walk down the corridor would.
	local start = room.RoomStart.Position
	table.sort(triggers, function(a, b)
		return (a.Position - start).Magnitude < (b.Position - start).Magnitude
	end)

	for _, trigger in ipairs(triggers) do
		if not AnomalyFinder.autoEnabled or AnomalyFinder.evading or AnomalyFinder.skipSweep == room then
			return
		end

		-- Any spot inside the zone sets it off; pick the closest one clear of puddles.
		local _, rootPart = getCharacterParts()
		local from = rootPart and rootPart.Position or trigger.Position
		local half = trigger.Size / 2
		local inside = trigger.CFrame:PointToObjectSpace(from)
		if math.abs(inside.X) <= half.X and math.abs(inside.Y) <= half.Y and math.abs(inside.Z) <= half.Z then
			continue
		end

		local best, bestDistance = nil, math.huge
		for x = -half.X + 1.5, half.X - 1.5, 3 do
			for z = -half.Z + 1.5, half.Z - 1.5, 3 do
				local point = (trigger.CFrame * CFrame.new(x, 0, z)).Position
				local floor = Vector3.new(point.X, trigger.Position.Y - half.Y + 3, point.Z)
				local distance = (floor - from).Magnitude
				if distance < bestDistance and not isHazardPoint(room, floor) then
					best, bestDistance = floor, distance
				end
			end
		end

		if best then
			walkTo(room, best, 2)
		end
		answerJohnQuestion()
	end

end

---John walks from the far end back toward the corridor's start, and when he faints it's
---somewhere along the way. Hold off on the count until he's past the middle of the
---hallway (or down), so a faint can't happen after the count is in.
---@param room Model
local function waitForJohn(room)
	local npc = findNpc(room)
	local path = room:FindFirstChild("References") and room.References:FindFirstChild("John")
	path = path and path:FindFirstChild("Path")
	local first, last = path and path:FindFirstChild("1"), path and path:FindFirstChild("4")
	if not (npc and first and last) then
		return
	end

	local middle = (first.Position + last.Position) / 2
	local direction = (last.Position - first.Position).Unit
	local deadline = os.clock() + AUTO.JOHN_WALK_TIMEOUT

	-- Some of his anomalies (the stare) only show once someone is near him; pop over for a
	-- moment while there's time to kill anyway, then come back. Stand off to his side: a
	-- head that turns to follow us doesn't turn at all if we're straight ahead.
	local torso = getTorso(npc)
	local _, rootPart = getCharacterParts()

	-- Not right next to something that chases on sight (the camouflage waits by the end).
	local nearChaser = false
	local debris = room:FindFirstChild("Debris")
	for _, child in ipairs(debris and debris:GetChildren() or {}) do
		for _, name in ipairs(AUTO.CHASERS) do
			if torso and child:IsA("Model") and child.Name:find(name)
				and (child:GetPivot().Position - torso.Position).Magnitude < AUTO.CHASER_KEEP_AWAY
			then
				nearChaser = true
			end
		end
	end

	if torso and rootPart and not AnomalyFinder.evading and not nearChaser and not isJohnDead(npc) then
		local back = rootPart.Position
		setAutoStatus("Checking " .. npc.Name)
		hopTo(torso.Position + torso.CFrame.RightVector * 6 + torso.CFrame.LookVector * 2)

		local started = os.clock()
		while AnomalyFinder.autoEnabled and os.clock() - started < AUTO.NPC_LOOK_TIME and not AnomalyFinder.evading do
			-- He keeps walking; stay in front of him.
			hopTo(torso.Position + torso.CFrame.RightVector * 6 + torso.CFrame.LookVector * 2)
			answerJohnQuestion()
			task.wait(0.1)
		end

		if not AnomalyFinder.evading then
			hopTo(back)
		end
	end

	-- Hiding behind the counter still waits for him (he can still faint); running back to
	-- the start is the chaser handling's business.
	while AnomalyFinder.autoEnabled and npc.Parent and os.clock() < deadline
		and not (AnomalyFinder.evading and AnomalyFinder.evading.atStart)
	do
		if isJohnDead(npc) then
			-- Where along the hallway he went down, to learn where fainting happens.
			table.insert(pendingReportLines, string.format(
				"[%s] John fainted | corridor %s | %.0f studs past the middle, %.1fs after we got to the counter\n",
				os.date("%Y-%m-%d %H:%M:%S"), tostring(room:GetAttribute("Level")),
				(npc:GetPivot().Position - middle):Dot(direction), AUTO.JOHN_WALK_TIMEOUT - (deadline - os.clock())
			))
			return
		end

		if (npc:GetPivot().Position - middle):Dot(direction) >= AUTO.JOHN_SAFE_PAST then
			return
		end

		setAutoStatus("Waiting for " .. npc.Name .. " to pass the middle")
		waitWhileFrozen(room)
		task.wait(0.1)
	end
end

---Look around the corridor until the list stops changing, then return it.
---@param room Model
---@return table
local function settleCount(room)
	local started = os.clock()
	local stableSince = os.clock()
	local lastSignature = nil
	local anomalies = {}

	while AnomalyFinder.autoEnabled and os.clock() - started < AUTO.MAX_LOOK_TIME do
		waitWhileFrozen(room)

		local cached = roomCache[room]
		anomalies = cached and cached.anomalies or {}

		local names = {}
		for _, anomaly in ipairs(anomalies) do
			table.insert(names, anomaly.name)
		end

		local signature = table.concat(names, "|")
		if signature ~= lastSignature then
			lastSignature = signature
			stableSince = os.clock()
		end

		setAutoStatus(string.format("Checking corridor %s: %d found", tostring(room:GetAttribute("Level")), #anomalies))

		if os.clock() - started >= AUTO.MIN_LOOK_TIME and os.clock() - stableSince >= AUTO.COUNT_SETTLE then
			break
		end

		task.wait(0.25)
	end

	return anomalies
end

---Which way a closed door faces, taken from the clean template's door, for this door's zone.
---@param zone BasePart
---@return Vector3?
local function getClosedDoorLook(zone)
	local template = workspaceService:FindFirstChild("Default")
	local backdoor = template and template:FindFirstChild("Objects") and template.Objects:FindFirstChild("Backdoor")
	local templateZone = backdoor and backdoor:FindFirstChild("Zone")
	local templateDoor = backdoor and backdoor:FindFirstChild("MovingDoor")
	if not (templateZone and templateDoor) then
		return nil
	end

	local relative = templateZone.CFrame:VectorToObjectSpace(templateDoor:GetPivot().LookVector)
	return zone.CFrame:VectorToWorldSpace(relative)
end

---Go through the door into the next corridor.
---@param segments Instance
---@param room Model
---@return boolean
local function enterNextRoom(segments, room, nextRoom)
	local level = room:GetAttribute("Level") or -1

	-- The count is in; come out from behind the counter and head for the door. Whatever
	-- we hid from is still out there, so wait in the door's far half, behind the door.
	local hiding = AnomalyFinder.evading ~= nil and not AnomalyFinder.evading.atStart
	local chaser = hiding and not AnomalyFinder.evading.parasite and AnomalyFinder.evading.target
	local lastChaser = AnomalyFinder.lastChaser
	if lastChaser and lastChaser.room == room then
		chaser = lastChaser.target
	end
	if hiding then
		AnomalyFinder.hidRoom = AnomalyFinder.evading.room
	end
	nextRoom = nextRoom or findRoomByLevel(segments, level + 1)

	if not nextRoom then
		pcall(function()
			localPlayer:RequestStreamAroundAsync(room.RoomEnd.Position)
		end)

		nextRoom = findRoomByLevel(segments, level + 1)
	end

	if not nextRoom then
		return false
	end

	local backdoor = nextRoom:FindFirstChild("Objects") and nextRoom.Objects:FindFirstChild("Backdoor")
	local zone = backdoor and backdoor:FindFirstChild("Zone")
	local movingDoor = backdoor and backdoor:FindFirstChild("MovingDoor")
	local spawn = nextRoom:FindFirstChild("Spawn")
	local inside = spawn and spawn.Position or nextRoom.RoomStart.Position

	if not (zone and movingDoor) then
		return false
	end

	-- A chaser we hid from hangs around the counter and the door, and comes for us again
	-- if we go near. Wait at the corridor's start (it won't chase us there) until it's back
	-- where it started and still, then make for the door.
	if hiding then
		AnomalyFinder.evading = nil
	end
	local origin = chaser and AnomalyFinder.chaserOrigins and AnomalyFinder.chaserOrigins[chaser]
	local spawnPoint = room:FindFirstChild("Spawn")
	if chaser and chaser ~= room and chaser:IsA("Model") and chaser.Parent and origin and spawnPoint then
		setAutoStatus("Waiting at the start for " .. chaser.Name .. " to settle")
		local deadline = os.clock() + AUTO.DOOR_CLEAR_TIMEOUT
		local lastPosition, stillSince = chaser:GetPivot().Position, os.clock()
		while AnomalyFinder.autoEnabled and chaser.Parent and os.clock() < deadline do
			local _, rootPart = getCharacterParts()
			if rootPart then
				rootPart.AssemblyLinearVelocity = Vector3.zero
				rootPart.CFrame = CFrame.new(spawnPoint.Position + Vector3.new(0, 3, 0)) * rootPart.CFrame.Rotation
			end

			local position = chaser:GetPivot().Position
			if (position - lastPosition).Magnitude > 0.05 then
				stillSince = os.clock()
			end
			lastPosition = position

			-- Only back at its own spot is it far enough from the door not to come for us.
			local settled = (position - origin).Magnitude < 5
			if os.clock() - stillSince > AUTO.CHASER_CALM and settled then
				break
			end
			task.wait(0.1)
		end
	end

	-- The door's zone straddles the doorway; stand in its half on this side.
	local side = zone.CFrame:PointToObjectSpace(inside).X >= 0 and -1 or 1
	if hiding then
		side = -side
	end
	local standPoint = (zone.CFrame * CFrame.new(side * 1.5, -1, 0)).Position

	setAutoStatus("Heading to corridor " .. tostring(level + 1))
	hopTo(standPoint)
	task.wait(0.2)

	-- The door only opens (and the corridor only counts) once the game checks the answer.
	-- Never go through it closed: that skips the check and the game doesn't move on.
	local closedLook = getClosedDoorLook(zone) or movingDoor:GetPivot().LookVector
	local waitStarted = os.clock()
	local deadline = waitStarted + AUTO.DOOR_TIMEOUT
	local opened = false

	local chaserLast = chaser and chaser.Parent and chaser ~= room and chaser:IsA("Model") and chaser:GetPivot().Position
	while AnomalyFinder.autoEnabled and os.clock() < deadline do
		waitWhileFrozen(room)

		-- The chaser came for us at the door: back to the start until it stops, then return.
		if chaserLast and chaser.Parent then
			local position = chaser:GetPivot().Position
			if (position - chaserLast).Magnitude > 0.3 then
				setAutoStatus("Running back from " .. chaser.Name)
				local spawnPart = room:FindFirstChild("Spawn")
				local stillSince, last = os.clock(), position
				local giveUp = os.clock() + AUTO.CHASE_TIMEOUT
				while spawnPart and AnomalyFinder.autoEnabled and chaser.Parent and os.clock() < giveUp do
					local _, rootPart = getCharacterParts()
					if rootPart then
						rootPart.AssemblyLinearVelocity = Vector3.zero
						rootPart.CFrame = CFrame.new(spawnPart.Position + Vector3.new(0, 3, 0)) * rootPart.CFrame.Rotation
					end
					local now = chaser:GetPivot().Position
					if (now - last).Magnitude > 0.05 then
						stillSince = os.clock()
					end
					last = now
					if os.clock() - stillSince > AUTO.CHASER_CALM then
						break
					end
					task.wait(0.05)
				end
				hopTo(standPoint)
				deadline = os.clock() + AUTO.DOOR_TIMEOUT
				position = chaser:GetPivot().Position
			end
			chaserLast = position
		end

		-- A wrong answer sends us back to the checkpoint; don't drag the character back here.
		if isRunOver() or (AnomalyFinder.lastWrongAt or 0) > waitStarted - 1 then
			return false
		end

		-- Something new showed up after the count went in: go back and fix the counter.
		local cached = roomCache[room]
		if AnomalyFinder.lastEntered and cached and #cached.anomalies ~= AnomalyFinder.lastEntered then
			return false
		end

		-- Nudged a little (the door swinging): step back in. Moved far (the game sent us
		-- somewhere): give up and let the main loop look again.
		local _, rootPart = getCharacterParts()
		local away = rootPart and (rootPart.Position - standPoint).Magnitude or 0
		if away > AUTO.DOOR_LEASH then
			return false
		elseif away > 4 then
			hopTo(standPoint)
		end

		if movingDoor:GetPivot().LookVector:Dot(closedLook) < 0.8 then
			opened = true
			break
		end

		setAutoStatus("Waiting for door " .. tostring(level + 1))
		task.wait(chaserLast and 0.05 or 0.25)
	end

	if not opened then
		return false
	end

	-- Step through to the next corridor's spawn point.
	return walkTo(room, inside, 4)
end

---On the end-of-run screen, press Play Again.
---@return boolean
local function replayIfEnded()
	local hud = localPlayer.PlayerGui:FindFirstChild("HUD")
	local ending = hud and hud:FindFirstChild("Ending")
	if not (ending and ending.Visible) then
		return false
	end

	if os.clock() - (AnomalyFinder.lastReplay or 0) > AUTO.REPLAY_INTERVAL then
		-- Note where the run ended; a last-life mistake shows no report to log.
		if not AnomalyFinder.lastReplay then
			local character = localPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			table.insert(pendingReportLines, string.format(
				"[%s] Run ended | last corridor %s | entered %s | health %s | panel: %s\n    steps: %s\n",
				os.date("%Y-%m-%d %H:%M:%S"),
				tostring(AnomalyFinder.lastLevel),
				tostring(AnomalyFinder.lastEntered),
				humanoid and tostring(humanoid.Health) or "no character",
				tostring(AnomalyFinder.lastEnteredNames),
				table.concat(AnomalyFinder.statusHistory or {}, " > ", math.max(1, #(AnomalyFinder.statusHistory or {}) - 12))
			))
		end

		AnomalyFinder.lastReplay = os.clock()
		setAutoStatus("Run over; playing again")

		local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
		local replay = remotes and remotes:FindFirstChild("Replay")
		if replay then
			replay:FireServer()
		end
	end

	return true
end

---Play corridors on its own until switched off.
local function runAuto()
	while AnomalyFinder.autoEnabled and AnomalyFinder.running do
		local success, err = pcall(function()
			if replayIfEnded() then
				task.wait(1)
				return
			end

			local segments = workspaceService:FindFirstChild("MapSegments")
			local room = segments and AnomalyFinder.getCurrentRoom(segments)
			local level = room and room:GetAttribute("Level")

			-- A new run starts in the lobby room; the first door leads into corridor 0.
			local gameInfo = workspaceService:FindFirstChild("GameInfo")
			local lobby = segments and segments:FindFirstChild("Start")
			if lobby and gameInfo and gameInfo:GetAttribute("start") == nil then
				local firstRoom = findRoomByLevel(segments, 0)
				if firstRoom then
					setAutoStatus("Starting the run")
					enterNextRoom(segments, lobby, firstRoom)
					task.wait(0.5)
					return
				end
			end

			if not level then
				setAutoStatus("Waiting for a corridor...")
				task.wait(1)
				return
			end

			-- The game tracks which corridor you're on (a wrong answer resets it to the start).
			-- If that disagrees with where the character is for a few seconds, go there.
			local function getProgress()
				return gameInfo and gameInfo:GetAttribute("LatestRoomId")
			end

			if getProgress() and getProgress() ~= level then
				local waitUntil = os.clock() + AUTO.OFF_TRACK_TIME
				while os.clock() < waitUntil and getProgress() ~= level do
					task.wait(0.25)
				end

				local progress = getProgress()
				local progressRoom = progress ~= level and findRoomByLevel(segments, progress)
				local spawn = progressRoom and progressRoom:FindFirstChild("Spawn")
				if spawn then
					setAutoStatus("Back to corridor " .. progress)
					hopTo(spawn.Position + Vector3.new(0, 3, 0))
					task.wait(0.5)
					return
				end
			end

			local objects = room:FindFirstChild("Objects")
			local counter = objects and objects:FindFirstChild("AnomalyCounter")

			AnomalyFinder.lastEntered = nil
			AnomalyFinder.lastLevel = level

			if counter then
				setAutoStatus("Walking corridor " .. level)
				visitTriggers(room)

				-- The counter takes clicks from anywhere in the corridor, so there's no need to
				-- walk over to it (and right past whatever sits next to it).

				-- Put in what's been found so far while John walks by; only changes are left after.
				local found = roomCache[room]
				if found then
					setAutoStatus(string.format("Entering %d on the counter", #found.anomalies))
					setCounter(counter, #found.anomalies)
				end

				waitForJohn(room)

				local anomalies = settleCount(room)
				if not AnomalyFinder.autoEnabled then
					return
				end

				-- Something can still turn up while the count goes in; keep the counter in step.
				local entered = -1
				local confirmUntil = os.clock() + AUTO.CONFIRM_TIME
				while AnomalyFinder.autoEnabled do
					local cached = roomCache[room]
					local amount = cached and #cached.anomalies or #anomalies

					if amount ~= entered then
						setAutoStatus(string.format("Entering %d on the counter", amount))
						if not setCounter(counter, amount) then
							warn("[AnomalyFinder] auto: the counter didn't take " .. amount)
						end

						entered = amount
						AnomalyFinder.lastEntered = amount
						local names = {}
						for _, anomaly in ipairs(cached and cached.anomalies or anomalies) do
							table.insert(names, anomaly.name .. ((anomaly.detail or "") ~= "" and " (" .. anomaly.detail .. ")" or ""))
						end
						AnomalyFinder.lastEnteredNames = table.concat(names, ", ")
						confirmUntil = os.clock() + AUTO.CONFIRM_TIME
					elseif os.clock() > confirmUntil then
						break
					end

					task.wait(0.1)
				end
			end

			if not enterNextRoom(segments, room) then
				setAutoStatus("No way forward from corridor " .. level .. "; waiting")
				task.wait(2)
			end
		end)

		if not success then
			warn("[AnomalyFinder] auto: " .. tostring(err))
			task.wait(1)
		end
	end

	stopWalking()
	setAutoStatus("")
end

---Turn full auto on or off.
---@param enabled boolean
local function setAutoEnabled(enabled)
	AnomalyFinder.autoEnabled = enabled

	-- Remembered across server hops (Play Again moves you to a new server).
	pcall(writefile, AUTO.STATE_FILE, enabled and "1" or "0")

	local interface = AnomalyFinder.interface
	if interface then
		interface.autoButton.Text = "Full auto [Del]: " .. (enabled and "on" or "off")
		interface.autoButton.BackgroundColor3 = enabled and Color3.fromRGB(60, 120, 80) or Color3.fromRGB(40, 40, 48)
	end

	if enabled and not AnomalyFinder.autoThread then
		AnomalyFinder.autoThread = task.spawn(function()
			runAuto()
			AnomalyFinder.autoThread = nil
		end)
	elseif not enabled then
		stopWalking()
		setAutoStatus("")
	end
end

---Turn the anomaly boxes on or off.
---@param enabled boolean
local function setEspEnabled(enabled)
	AnomalyFinder.espEnabled = enabled

	local interface = AnomalyFinder.interface
	if interface then
		interface.espButton.Text = "ESP [RCtrl]: " .. (enabled and "on" or "off")
		interface.espButton.BackgroundColor3 = enabled and Color3.fromRGB(60, 90, 140) or Color3.fromRGB(40, 40, 48)
	end

	if not enabled then
		clearEsp()
	end
end

---Wire up the toggle buttons and their keys.
local function bindControls()
	local interface = AnomalyFinder.interface

	table.insert(AnomalyFinder.controlConnections, interface.autoButton.Activated:Connect(function()
		setAutoEnabled(not AnomalyFinder.autoEnabled)
	end))

	table.insert(AnomalyFinder.controlConnections, interface.espButton.Activated:Connect(function()
		setEspEnabled(not AnomalyFinder.espEnabled)
	end))

	table.insert(AnomalyFinder.controlConnections, userInputService.InputBegan:Connect(function(input)
		if userInputService:GetFocusedTextBox() then
			return
		end

		if input.KeyCode == AUTO.KEY then
			setAutoEnabled(not AnomalyFinder.autoEnabled)
		elseif input.KeyCode == AUTO.ESP_KEY then
			setEspEnabled(not AnomalyFinder.espEnabled)
		end
	end))
end

---Start scanning and rendering.
function AnomalyFinder.init()
	AnomalyFinder.running = true
	AnomalyFinder.interface = createInterface()
	AnomalyFinder.scanRoom = scanRoom
	AnomalyFinder.getCurrentRoom = getCurrentRoom
	wrapAnomalyFunctions()
	wrapReport()
	bindControls()
	AnomalyFinder.clearEsp = clearEsp

	-- Log every death cutscene (what got us, and what auto was doing), once per server.
	local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
	local cutscenes = remotes and remotes:FindFirstChild("Cutscenes")
	if cutscenes and getcallbackvalue and not cutscenes:GetAttribute("AnomalyFinderHook") then
		local ok, original = pcall(getcallbackvalue, cutscenes, "OnClientInvoke")
		if ok and type(original) == "function" then
			cutscenes:SetAttribute("AnomalyFinderHook", true)
			cutscenes.OnClientInvoke = function(name, ...)
				pcall(function()
					local finder = shared.AnomalyFinder
					appendfile(REPORT_LOG_FILE, string.format(
						"[%s] Cutscene %s | %s | doing: %s\n",
						os.date("%Y-%m-%d %H:%M:%S"), tostring(name),
						finder.interface.header.Text, finder.interface.status.Text
					))
				end)
				return original(name, ...)
			end
		end
	end

	-- Chasers are checked every frame so we're gone the instant one starts coming.
	table.insert(AnomalyFinder.controlConnections, game:GetService("RunService").Heartbeat:Connect(function()
		pcall(watchChasers)
	end))

	-- Come back on the next server, and pick full auto back up if it was on.
	local queueTeleport = queue_on_teleport or queueonteleport
	if queueTeleport then
		pcall(queueTeleport, AUTO.RELOAD_SOURCE)
	end

	-- Log deaths too: they cost lives without the game's report showing up.
	local function watchDeath(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid then
			return
		end

		table.insert(AnomalyFinder.controlConnections, humanoid.Died:Connect(function()
			local interface = AnomalyFinder.interface
			table.insert(pendingReportLines, string.format(
				"[%s] Died | %s | doing: %s | panel: %s\n",
				os.date("%Y-%m-%d %H:%M:%S"),
				interface and interface.header.Text or "?",
				interface and interface.status.Text or "?",
				interface and (interface.list.Text:gsub("<[^>]+>", ""):gsub("\n", "; ")) or "?"
			))
		end))
	end

	if localPlayer.Character then
		task.spawn(watchDeath, localPlayer.Character)
	end
	table.insert(AnomalyFinder.controlConnections, localPlayer.CharacterAdded:Connect(watchDeath))

	local stateOk, state = pcall(readfile, AUTO.STATE_FILE)
	if stateOk and state == "1" then
		setAutoEnabled(true)
	end

	task.spawn(function()
		while AnomalyFinder.running do
			-- Our panel was removed by a newer copy; step aside.
			local interface = AnomalyFinder.interface
			if not interface or not interface.gui.Parent then
				AnomalyFinder.detach()
				break
			end

			pcall(flushReportLog)

			-- After a server hop we can load before the game's own modules; keep trying to hook them.
			if not wrappedReport or next(wrappedAnomalyFunctions) == nil or not AnomalyFinder.jumpscaresWrapped then
				pcall(wrapAnomalyFunctions)
				pcall(wrapReport)
			end

			local success, err = pcall(function()
				local segments = workspaceService:FindFirstChild("MapSegments")
				if not segments then
					render(AnomalyFinder.interface, nil)
					return
				end

				if AnomalyFinder.watchedSegments ~= segments then
					watchSegments(segments)
				end

				local room = getCurrentRoom(segments)
				if not room then
					render(AnomalyFinder.interface, nil)
					return
				end

				task.spawn(watchRoom, room)

				-- Show cached results right away while a fresh scan runs.
				local cached = roomCache[room]
				render(AnomalyFinder.interface, room, cached and cached.anomalies)

				local anomalies = getRoomAnomalies(room)
				pcall(captureDeepSnapshot, room)
				if AnomalyFinder.running and AnomalyFinder.interface then
					render(AnomalyFinder.interface, room, anomalies)

					if AnomalyFinder.espEnabled then
						updateEsp(anomalies)
					end
				end
			end)

			if not success then
				warn("[AnomalyFinder] " .. tostring(err))
			end

			task.wait(SCAN_INTERVAL)
		end
	end)
end

---This is called when initialization errors.
---@param error string
local function onInitializeError(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	AnomalyFinder.detach()
end

-- Replace any previous instance on re-execution.
if shared.AnomalyFinder then
	shared.AnomalyFinder.detach()
end

-- Another script environment may be running its own copy; removing its panel stops it.
pcall(function()
	for _, child in ipairs(gethui():GetChildren()) do
		if child.Name == "AnomalyFinder" or child.Name == "AnomalyFinderESP" then
			child:Destroy()
		end
	end
end)

shared.AnomalyFinder = AnomalyFinder

xpcall(AnomalyFinder.init, onInitializeError)
