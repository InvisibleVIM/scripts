	local SHORT_KEYS = { None = "Not set", RightControl = "Right Ctrl", LeftControl = "Left Ctrl", RightShift = "Right Shift", LeftShift = "Left Shift", RightAlt = "Right Alt", LeftAlt = "Left Alt", Insert = "Insert", Delete = "Delete" }
	function UI.keybind(page, text, key, note)
		local row = UI.rowBase(page, 30, false)
		local holder = caption(row, text, note, 116)
		UI.markRow(page, row, UDim2.new(1, -112, 0, 2), holder)
		local box = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(106, 30),
			BackgroundColor3 = UI.roles.Control,
			BorderSizePixel = 0,
			FontFace = CODE_MEDIUM,
			TextSize = px(14),
			TextColor3 = UI.roles.Font,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AutoButtonColor = false,
			Parent = row,
		})
		round(box, 7)
		stroke(box, "Outline")
		local function refresh()
			box.Text = SHORT_KEYS[Config[key]] or tostring(Config[key])
			if key == "MenuKey" and UI.keyHint then
				UI.keyHint.Text = box.Text .. " hides the menu"
			end
		end
		box.MouseButton1Click:Connect(function()
			UI.capturing = true
			box.Text = "Press a key"
			local connection
			connection = userInputService.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then
					return
				end
				connection:Disconnect()
				if input.KeyCode == Enum.KeyCode.Backspace and key ~= "MenuKey" then
					Config[key] = "None"
				elseif input.KeyCode ~= Enum.KeyCode.Escape then
					Config[key] = input.KeyCode.Name
				end
				refresh()
				task.defer(function()
					UI.capturing = false
				end)
			end)
		end)
		refresh()
		return row
	end

