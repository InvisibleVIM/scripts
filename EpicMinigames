	-- Categories come from the game's own list (ReplicatedStorage.MinigameCategories).
	local Categories = { list = {}, solo = {} }
	pcall(function()
		pcall(setthreadidentity, 2)
		local ok, module = pcall(require, RS:WaitForChild("MinigameCategories", 10))
