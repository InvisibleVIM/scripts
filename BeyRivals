---Fire a join packet the way the game's own buttons do.
local function firePacket(name, ...)
	local packet = Packets and Packets[name]
	if not packet then
		return false, "missing packet " .. name
	end
	local args = table.pack(...)
	setthreadidentity(2)
	local ok, accepted, reason = pcall(function()
		return packet:Fire(table.unpack(args, 1, args.n))
	end)
	setthreadidentity(8)
	if not ok then
		return false, tostring(accepted)
	end
	return accepted == true, reason
end

---Work out how to get back into the same kind of battle.
---@return string label, function attempt -> (accepted, reason, teleports)
local function nextJoin(result)
	pcall(function()
		if isfile(JOIN_FILE) then
			lastJoin = httpService:JSONDecode(readfile(JOIN_FILE))
		end
	end)
	-- 11-07 Challenge mode: each period pays once and Specials once a day, so don't loop them or fall
	-- back to the previous join (that would drop us into ranked). Pick the next challenge by hand.
	-- A remembered join only describes THIS battle if it was sent just before the battle started. Lobby NPC
	-- fights start server-side (no join packet), so a stale boss join kept sending us to Volt after them.
	do
		local latest = BeyRivals.currentMatch or (BeyRivals.matchLog and BeyRivals.matchLog[#BeyRivals.matchLog])
		local startedAt = latest and tonumber(latest.at)
		if lastJoin and lastJoin.packet ~= "RankedQueue" and startedAt and tonumber(lastJoin.at) and lastJoin.at < startedAt - 90 then
			lastJoin = nil
		end
	end
	-- Ranked series finished (1v1/2v2/3v3): queue the same ladder again.
	if BeyRivals.ranked and (BeyRivals.ranked.state == "home" or BeyRivals.ranked.state == "nocontest") then
		local ladder = BeyRivals.rankedMode or "1v1"
		return "Ranked " .. ladder, function()
			local accepted, reason = firePacket("RankedQueue", "again")
			if not accepted then
				accepted, reason = firePacket("RankedQueue", ladder)
			end
			return accepted, reason, true
		end
	end
	-- Evolve bosses (Volt / Rentaro) are the exception: every win rolls the 4% disc/driver drop, so rematch.
	if lastJoin and lastJoin.packet == "ChallengeFight" and type(lastJoin.args) == "table" and lastJoin.args[1] == "boss" then
		local args = lastJoin.args
		return "Boss rematch", function()
			return firePacket("ChallengeFight", "boss", tonumber(args[2]) or 1, tonumber(args[3]) or 0)
		end
	end
	if lastJoin and (lastJoin.packet == "PvpChallenge" or lastJoin.packet == "RankedChallenge") then
		return "Player challenge", function()
			return false, "player challenge done - queue the next one"
		end
	end
	if lastJoin and (lastJoin.packet == "ChallengeFight" or lastJoin.packet == "TrainerChallenge") then
		return "Challenge", function()
			return false, "challenge done - pick the next one"
		end
	end
	if type(result) == "table" then
		if result.mode == "Horseman" and workspace:GetAttribute("Halloween") == true then
			return "Boss fight", function()
				return firePacket("HalloweenAct", "fight", "")
			end
		end
		if result.again == true then
			local mode = Config.QueueMode == "Rematch" and "rematch" or "queue"
			return mode == "queue" and "Queue" or "Rematch", function()
				return firePacket("ArenaAgain", mode)
			end
		end
		if type(result.nextMode) == "table" and type(result.nextMode.mode) == "string" then
			local nextMode = result.nextMode
			return "Next: " .. nextMode.mode, function()
				return firePacket("ModePlay", nextMode.mode, tostring(nextMode.arg or ""))
			end
		end
		if type(result.eloDelta) == "number" then
			-- Ranked: the server sends us to the park and queues us again on arrival.
			return "Ranked", function()
				local accepted, reason = firePacket("RankedQueue", "again")
				return accepted, reason, true
			end
		end
	end
	if lastJoin and lastJoin.packet == "HalloweenAct" and workspace:GetAttribute("Halloween") == true then
		return "Boss fight", function()
			return firePacket("HalloweenAct", "fight", "")
		end
	end
	if lastJoin and lastJoin.packet == "ModePlay" and type(lastJoin.args) == "table" then
		local args = lastJoin.args
		return "Mode: " .. tostring(args[1]), function()
			return firePacket("ModePlay", tostring(args[1] or ""), tostring(args[2] or ""))
		end
	end
	if lastJoin and lastJoin.packet == "RankedQueue" then
		return "Ranked", function()
			local accepted, reason = firePacket("RankedQueue", "again")
			return accepted, reason, true
		end
	end
	local mode = Config.QueueMode == "Rematch" and "rematch" or "queue"
	return "Queue", function()
		return firePacket("ArenaAgain", mode)
	end
end

---Ask for the next battle and keep at it until a *new* one starts.
---The finished battle stays registered while its results/replay play, so we compare battle ids.
local queueRun = 0
local queuedToken = nil
local function joinNextBattle(endedToken)
	if not Packets then
		return
	end
	queueRun = queueRun + 1
	local run = queueRun
	local endedAt = os.clock()

	-- Give the results screen a moment so we know which kind of battle this was.
	status = "Waiting for results"
	repeat
		task.wait(0.25)
	until lastResultAt >= endedAt or os.clock() - endedAt > (20) or run ~= queueRun or not Config.AutoQueue or inNewBattle(endedToken)
	if run ~= queueRun or not Config.AutoQueue or inNewBattle(endedToken) or BeyRivals.detached then
		return
	end

	-- Legit tab: a pause before asking for the next battle.
	do
		local resumeAt = os.clock() + BeyRivals.Tspan("QueueWait")
		while os.clock() < resumeAt do
			if run ~= queueRun or not Config.AutoQueue or inNewBattle(endedToken) or BeyRivals.detached then
				return
			end
			status = string.format("Next battle in %.0f s", math.max(resumeAt - os.clock(), 0))
			task.wait(0.25)
		end
	end

	local result = lastResultAt >= endedAt and lastResult or nil
	local label, attempt = nextJoin(result)
	local giveUp = os.clock() + (90)
	while os.clock() < giveUp and run == queueRun and Config.AutoQueue and not BeyRivals.detached do
		if inNewBattle(endedToken) then
			return
		end
		local accepted, reason, teleports = attempt()
		if accepted then
			status = teleports and (label .. ": heading back, requeues on arrival") or (label .. ": waiting for the battle")
			repeat
				task.wait(0.5)
			until inNewBattle(endedToken) or run ~= queueRun or not Config.AutoQueue or BeyRivals.detached
			return
		end
		if type(reason) == "string" and reason ~= "" then
			status = label .. ": " .. reason
		end
		task.wait(BeyRivals.T("QueueRetry"))
	end
	if run == queueRun and not inNewBattle(endedToken) then
		status = "Couldn't join the next battle"
	end
end

---Start requeuing once per finished battle, as early as the server marks it over.
local function queueAfter(battle)
	if not (Config.AutoQueue and battle) or battle.watch or queuedToken == battle.token then
		return
	end
	queuedToken = battle.token
	-- 2v2/3v3 ranked is a series of duels the server runs back to back: only queue once it's over.
	if BeyRivals.rankedSeriesLive() then
		task.spawn(function()
			local deadline = os.clock() + 120
			while os.clock() < deadline do
				local battleNow = currentBattle()
				if battleNow and battleNow.token ~= battle.token then
					return
				end
				if not BeyRivals.rankedSeriesLive() then
					break
				end
				task.wait(0.5)
			end
			if Config.AutoQueue then
				joinNextBattle(battle.token)
			end
		end)
		return
	end
	task.spawn(joinNextBattle, battle.token)
end

---Ranked state from the server (JSON): queue -> found -> spot pick (order) -> ready -> play ... -> home.
BeyRivals.RANKED_LIVE = { found = true, play = true, waiting = true, here = true, ready = true, wait = true, battle = true, order = true, pick = true, series = true }
function BeyRivals.rankedSeriesLive()
	local r = BeyRivals.ranked
	return r ~= nil and BeyRivals.RANKED_LIVE[r.state] == true and os.clock() - (BeyRivals.rankedAt or 0) < 900
end

function BeyRivals.onRankedState(raw)
	local ok, data = pcall(function()
		return type(raw) == "string" and httpService:JSONDecode(raw) or raw
	end)
	if not ok or type(data) ~= "table" then
		return
	end
	BeyRivals.ranked, BeyRivals.rankedAt = data, os.clock()
	if type(data.mode) == "string" and data.mode:match("^%dv%d$") then
		BeyRivals.rankedMode = data.mode
	end
	-- Pick your spot (2v2/3v3). Server sends a top-level {"state":"order","size":2,"taken":{"2":"name"},
	-- "ends":t} and adds "mine":n once we've picked. Our preferred turn, else the next free one.
	if data.state == "order" and data.mine == nil then
		local size = tonumber(data.size) or (data.mode == "3v3" and 3 or 2)
		local choice = size == 3 and Config.Spot3v3 or Config.Spot2v2
		local want = ({ ["1st"] = 1, ["2nd"] = 2, ["3rd"] = 3 })[tostring(choice)]
		if want then
			want = math.clamp(want, 1, size)
			local taken = type(data.taken) == "table" and data.taken or {}
			local pick = nil
			for offset = 0, size - 1 do
				local spot = (want - 1 + offset) % size + 1
				if not (taken[spot] or taken[tostring(spot)]) then
					pick = spot
					break
				end
			end
			local key = tostring(data.ends or game.JobId) .. ":" .. tostring(pick)
			if pick and BeyRivals.spotKey ~= key then
				BeyRivals.spotKey = key
				task.delay(BeyRivals.Tspan("SpotWait"), function()
					firePacket("RankedOrder", pick)
					status = "Picked spot " .. pick
				end)
			end
		end
	end
	-- Ready check: {"state":"waiting","here":4,"need":4,"ready":n}. Once per arena.
	if Config.AutoReady and data.state == "waiting" and tonumber(data.need) and (tonumber(data.ready) or 0) < tonumber(data.need) then
		local key = "ready:" .. game.JobId
		if BeyRivals.readyKey ~= key then
			BeyRivals.readyKey = key
			task.delay(BeyRivals.Tspan("ReadyWait"), function()
				firePacket("RankedReady")
				status = "Ranked: ready"
			end)
		end
	end
end

