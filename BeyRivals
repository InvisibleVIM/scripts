	})
	local fill = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 0, 0, 2),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		Parent = track,
	})
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	}, { corner(6), create("UIStroke", { Color = PANEL, Thickness = 2 }) })

	local function refresh()
		local fraction = (Config[key] - minValue) / (maxValue - minValue)
		fill.Size = UDim2.new(fraction, 0, 0, 2)
		knob.Position = UDim2.fromScale(fraction, 0.5)
		valueLabel.Text = format(Config[key])
	end
	local dragging = false
	local function setFromX(x)
		local fraction = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local value = minValue + fraction * (maxValue - minValue)
		Config[key] = math.clamp(math.floor(value / step + 0.5) * step, minValue, maxValue)
		refresh()
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	table.insert(BeyRivals.connections, userInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	table.insert(BeyRivals.connections, userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
	refresh()
end

