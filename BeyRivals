---One tuned value.
function BeyRivals.T(key)
	return Config["Tune_" .. key]
end
---A fresh pick between a value's Min and Max (the same number when they are equal).
function BeyRivals.Tspan(key)
	local low, high = Config["Tune_" .. key .. "Min"], Config["Tune_" .. key .. "Max"]
	if high < low then
		low, high = high, low
	end
	return low + (high - low) * math.random()
end
---A yes/no that stays the same for `span` ticks, so one hit is one decision, not sixty.
function BeyRivals.humanRoll(name, tick, span, rate)
	if rate >= 100 then
		return true
	end
	local rolls = BeyRivals.rolls or {}
	BeyRivals.rolls = rolls
	local roll = rolls[name]
	if not roll or tick > roll.untilTick or tick < roll.tick then
		roll = { yes = math.random() * 100 < rate, untilTick = tick + span, tick = tick }
		rolls[name] = roll
	end
	roll.tick = tick
	return roll.yes
end
---Human mode on: remember the values as they stand and set every one to its human figure.
---Off: put the remembered values back.
function BeyRivals.setHuman(on)
	if on then
		local backup = {}
		for _, row in ipairs(BeyRivals.TUNE) do
			backup[row[2]] = Config["Tune_" .. row[2]]
			Config["Tune_" .. row[2]] = row[8]
		end
		Config.TuneBackup = httpService:JSONEncode(backup)
	else
		local ok, backup = pcall(function()
			return httpService:JSONDecode(Config.TuneBackup)
		end)
		for _, row in ipairs(BeyRivals.TUNE) do
			local saved = ok and type(backup) == "table" and tonumber(backup[row[2]]) or nil
			Config["Tune_" .. row[2]] = saved and math.clamp(saved, row[4], row[5]) or row[7]
		end
		Config.TuneBackup = ""
	end
	BeyRivals.humanApplied = on
end
---Every value back to what the script ships with (and Human mode off).
function BeyRivals.resetTune()
	for _, row in ipairs(BeyRivals.TUNE) do
		Config["Tune_" .. row[2]] = row[7]
	end
	Config.Human, Config.TuneBackup, BeyRivals.humanApplied = false, "", false
end

