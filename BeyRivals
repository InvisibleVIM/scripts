---Undo every hook and connection.
function BeyRivals.detach()
	saveSettings()
	if BeyRivals.universal then
		pcall(BeyRivals.universal.stop)
	end
	BeyRivals.detached = true
	if stopTraitRolling then
		stopTraitRolling()
	end
	if stopAllRollers then
		stopAllRollers()
	end
	if BattleInput.sample == sampleHook then
		BattleInput.sample = originalSample
	end
	localPlayer:SetAttribute("AimAssist", hadAimAssist)
	-- Hand the game back its own packet senders and results screen.
	for _, packet in pairs(hookedPackets) do
		rawset(packet, "Fire", nil)
	end
	if originalShow and RivalsResults.show ~= originalShow then
		RivalsResults.show = originalShow
	end
	for _, connection in ipairs(BeyRivals.connections) do
		connection:Disconnect()
	end
	if BeyRivals.gui then
		BeyRivals.gui:Destroy()
	end
	if shared.BeyRivals == BeyRivals then
		shared.BeyRivals = nil
	end
end


