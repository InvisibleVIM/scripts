---Fire a join packet the way the game's own buttons do.
local function firePacket(name, ...)
	local packet = Packets and Packets[name]
	if not packet then
		return false, "missing packet " .. name
	end
	local args = table.pack(...)
	setthreadidentity(2)
	local ok, accepted, reason = pcall(function()
		return packet:Fire(table.unpack(args, 1, args.n))
	end)
	setthreadidentity(8)
	if not ok then
		return false, tostring(accepted)
	end
	return accepted == true, reason
end

---Work out how to get back into the same kind of battle.
---@return string label, function attempt -> (accepted, reason, teleports)
local function nextJoin(result)
	pcall(function()
		if isfile(JOIN_FILE) then
			lastJoin = httpService:JSONDecode(readfile(JOIN_FILE))
		end
	end)
	if type(result) == "table" then
		if result.mode == "Horseman" then
			return "Boss fight", function()
				return firePacket("HalloweenAct", "fight", "")
			end
		end
		if result.again == true then
			local mode = Config.QueueMode == "Rematch" and "rematch" or "queue"
			return mode == "queue" and "Queue" or "Rematch", function()
				return firePacket("ArenaAgain", mode)
			end
		end
		if type(result.nextMode) == "table" and type(result.nextMode.mode) == "string" then
			local nextMode = result.nextMode
			return "Next: " .. nextMode.mode, function()
				return firePacket("ModePlay", nextMode.mode, tostring(nextMode.arg or ""))
			end
		end
		if type(result.eloDelta) == "number" then
			-- Ranked: the server sends us to the park and queues us again on arrival.
			return "Ranked", function()
				local accepted, reason = firePacket("RankedQueue", "again")
				return accepted, reason, true
			end
		end
	end
	if lastJoin and lastJoin.packet == "HalloweenAct" then
		return "Boss fight", function()
			return firePacket("HalloweenAct", "fight", "")
		end
	end
	if lastJoin and lastJoin.packet == "ModePlay" and type(lastJoin.args) == "table" then
		local args = lastJoin.args
		return "Mode: " .. tostring(args[1]), function()
			return firePacket("ModePlay", tostring(args[1] or ""), tostring(args[2] or ""))
		end
	end
	if lastJoin and lastJoin.packet == "RankedQueue" then
		return "Ranked", function()
			local accepted, reason = firePacket("RankedQueue", "again")
			return accepted, reason, true
		end
	end
	local mode = Config.QueueMode == "Rematch" and "rematch" or "queue"
	return "Queue", function()
		return firePacket("ArenaAgain", mode)
	end
end

---Ask for the next battle and keep at it until a *new* one starts.
---The finished battle stays registered while its results/replay play, so we compare battle ids.
local queueRun = 0
local queuedToken = nil
local function joinNextBattle(endedToken)
	if not Packets then
		return
	end
	queueRun = queueRun + 1
	local run = queueRun
	local endedAt = os.clock()

	-- Give the results screen a moment so we know which kind of battle this was.
	status = "Waiting for results"
	repeat
		task.wait(0.25)
	until lastResultAt >= endedAt or os.clock() - endedAt > RESULT_WAIT or run ~= queueRun or not Config.AutoQueue or inNewBattle(endedToken)
	if run ~= queueRun or not Config.AutoQueue or inNewBattle(endedToken) or BeyRivals.detached then
		return
	end

	local result = lastResultAt >= endedAt and lastResult or nil
	local label, attempt = nextJoin(result)
	local giveUp = os.clock() + QUEUE_GIVE_UP
	while os.clock() < giveUp and run == queueRun and Config.AutoQueue and not BeyRivals.detached do
		if inNewBattle(endedToken) then
			return
		end
		local accepted, reason, teleports = attempt()
		if accepted then
			status = teleports and (label .. ": heading back, requeues on arrival") or (label .. ": waiting for the battle")
			repeat
				task.wait(0.5)
			until inNewBattle(endedToken) or run ~= queueRun or not Config.AutoQueue or BeyRivals.detached
			return
		end
		if type(reason) == "string" and reason ~= "" then
			status = label .. ": " .. reason
		end
		task.wait(QUEUE_RETRY_EVERY)
	end
	if run == queueRun and not inNewBattle(endedToken) then
		status = "Couldn't join the next battle"
	end
end

---Start requeuing once per finished battle, as early as the server marks it over.
local function queueAfter(battle)
	if not (Config.AutoQueue and battle) or battle.watch or queuedToken == battle.token then
		return
	end
	queuedToken = battle.token
	task.spawn(joinNextBattle, battle.token)
end

