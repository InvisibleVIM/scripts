---Is the standalone finish replay (FinishReplay.play) running?
local function finishReplayPlaying()
	if not FinishReplay then
		return false
	end
	local ok, handle = pcall(debug.getupvalue, FinishReplay.stop, 1)
	return ok and handle ~= nil
end

local skippedReplay = nil
local skipAt = nil

-- Skip the end-of-round replay the same way a key press does, after the game's 0.5s minimum.
table.insert(BeyRivals.connections, runService.Heartbeat:Connect(function()
	if not Config.AutoSkipReplay then
		skipAt = nil
		return
	end
	local battle = currentBattle()
	local replay = battle and battle.replay
	local active = replay or (finishReplayPlaying() and FinishReplay) or nil
	if not active then
		skipAt = nil
		return
	end
	if skippedReplay == active then
		return
	end
	skipAt = skipAt or (os.clock() + SKIP_DELAY)
	if os.clock() < skipAt then
		return
	end

	skippedReplay, skipAt = active, nil
	setthreadidentity(2)
	local ok, err = pcall(function()
		if replay and endSimReplay then
			endSimReplay(battle, "Skipped")
		elseif FinishReplay then
			FinishReplay.stop()
		end
	end)
	setthreadidentity(8)
	if not ok then
		warn("[Bey Rivals] Replay skip error: " .. tostring(err))
	end
end))

