---Row that shows a value and cycles through options on click (right click goes back).
local function cycler(page, text, getOptions, getLabel, onPick)
	local row = rowBase(page, 34, true)
	rowLabel(row, text)
	local value = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(190, 20),
		BackgroundTransparency = 1,
