-- ============================================================
--  Match log: every battle, round by round, saved to BeyRivals/matches.json
-- ============================================================

local MATCH_FILE = SETTINGS_FOLDER .. "/matches.json"
local MATCH_KEEP = 150
local TIMELINE_KEEP = 220

---JSON-safe copy of a game table (no functions/instances, bounded size).
local function safeCopy(value, depth)
	local kind = type(value)
	if kind == "number" then
		return value == value and math.abs(value) < 1e12 and math.floor(value * 1000 + 0.5) / 1000 or 0
	elseif kind == "string" or kind == "boolean" then
		return value
	elseif kind ~= "table" or (depth or 0) > 3 then
		return nil
	end
	local out, count = {}, 0
	for key, inner in pairs(value) do
		count = count + 1
		if count > 60 then
			break
		end
		local copied = safeCopy(inner, (depth or 0) + 1)
		if copied ~= nil then
			out[tostring(key)] = copied
		end
	end
	return out
end

local MatchLog = {}
pcall(function()
	if isfile(MATCH_FILE) then
		MatchLog = httpService:JSONDecode(readfile(MATCH_FILE))
	end
end)
if type(MatchLog) ~= "table" then
	MatchLog = {}
end
BeyRivals.matchLog = MatchLog

local function saveMatches()
	while #MatchLog > MATCH_KEEP do
		table.remove(MatchLog, 1)
	end
	pcall(function()
		if not isfolder(SETTINGS_FOLDER) then
			makefolder(SETTINGS_FOLDER)
		end
		writefile(MATCH_FILE, httpService:JSONEncode(MatchLog))
	end)
end

local function beySnapshot(bey)
	return {
		slot = bey.slot,
		typ = bey.typ,
		team = bey.team,
		combo = safeCopy(bey.combo, 1),
		spin = safeCopy(bey.spin),
		burst = safeCopy(bey.burst),
		burstMax = safeCopy(bey.burstMax),
		out = bey.out,
		x = safeCopy(bey.x),
		z = safeCopy(bey.z),
		guardN = bey.guardN,
		special = safeCopy(bey.special),
	}
end

local LOGGED_EVENTS = {
	Clash = true, AbilityHit = true, CounterAttack = true, Guard = true, GuardBreak = true, Dodge = true,
	Smash = true, Finisher = true, Burst = true, RingOut = true, SpinOut = true, Out = true, Awaken = true,
	Ability = true, Ultimate = true, Rip = true, FirstStrike = true,
}

-- Everything else is logged, so burst jumps can be tied to whatever caused them.
local QUIET_EVENTS = {
	Land = true, Beat = true, Yaw = true, Click = true, Grind = true, Spinner = true, CoreSpin = true,
	ClashStart = true, ClashEnd = true, AbilityPhase = true, Tip = true, Share = true, Rip = false,
}
local currentMatch, currentRound, lastStatus = nil, nil, nil

-- The game swaps in a fresh sim table every frame, so a round is keyed by the round object.
local function newRound(sim)
	currentRound = {
		startedAt = os.time(),
		stadium = sim.stadium,
		seed = sim.rng,
		beys = {},
		timeline = {},
		counts = {},
		trace = {},
		lastTick = sim.tick,
	}
	for slot, bey in pairs(sim.beys) do
		currentRound.beys[tostring(slot)] = beySnapshot(bey)
	end
	table.insert(currentMatch.rounds, currentRound)
	return currentRound
end

local function note(round, tick, text)
	table.insert(round.timeline, { t = tick, e = text })
	if #round.timeline > TIMELINE_KEEP then
		table.remove(round.timeline, 1)
	end
end

local function openMatch(battle)
	if currentMatch and currentMatch.token == tostring(battle.token) then
		return true
	end
	if battle.over then
		return false
	end
	currentMatch = {
		token = tostring(battle.token),
		at = os.time(),
		mySlot = battle.mySlot,
		mode = lastJoin and lastJoin.packet and (lastJoin.packet .. ":" .. tostring(lastJoin.args and lastJoin.args[1] or "")) or "?",
		auto = Config.AutoBattle,
		aggression = Config.Aggression,
		budget = Config.LookaheadMs,
		rounds = {},
	}
	currentRound = nil
	table.insert(MatchLog, currentMatch)
	return true
end

local lastBurst = {}

---Called once per simulated tick from the input hook (every step, so no events are missed).
logTick = function(battle, sim, slot)
	if not battle or battle.watch or not openMatch(battle) then
		return
	end
	-- A new round starts the tick counter over; nothing is logged between a round's end and that reset.
	if not currentRound or sim.tick < (currentRound.lastTick or 0) - 5 then
		if currentRound and not currentRound.done then
			currentRound.done = true
		end
		newRound(sim)
		lastBurst = {}
	elseif currentRound.done then
		currentRound.lastTick = sim.tick
		return
	end
	local round = currentRound
	if sim.tick == round.lastTick and #round.trace > 0 then
		return
	end
	round.lastTick = sim.tick
	if status ~= lastStatus then
		lastStatus = status
		note(round, sim.tick, "status:" .. tostring(status))
	end
	for _, event in ipairs(sim.events or {}) do
		if not QUIET_EVENTS[event.kind] then
			round.counts[event.kind] = (round.counts[event.kind] or 0) + 1
			local who = event.slot or event.a or event.target
			note(round, sim.tick, string.format("%s s%s->%s%s", event.kind, tostring(who), tostring(event.target or event.b or ""), event.grade and (" " .. tostring(event.grade)) or ""))
		end
	end
	-- Every jump in a burst gauge, and a compact state trace twice a second.
	for beySlot, bey in pairs(sim.beys) do
		local burst = bey.burst or 0
		local before = lastBurst[beySlot] or 0
		if burst - before > 0.25 then
			note(round, sim.tick, string.format("burst s%s +%.2f -> %.0f%%", tostring(beySlot), burst - before, burstRatio(bey) * 100))
		end
		lastBurst[beySlot] = burst
	end
	if sim.tick % 30 == 0 then
		local parts = { tostring(sim.tick) }
		for beySlot, bey in pairs(sim.beys) do
			table.insert(parts, string.format("s%s sp%.2f b%.0f%% r%.2f", tostring(beySlot), bey.spin or 0, burstRatio(bey) * 100, math.sqrt((bey.x or 0) ^ 2 + (bey.z or 0) ^ 2)))
		end
		table.insert(round.trace, table.concat(parts, " "))
	end
	if sim.done or sim.finished then
		round.done = true
		round.ticks = sim.tick
		round.loser = safeCopy(sim.loser)
		round.finish = safeCopy(sim.finish, 1)
		round.endBeys = {}
		for beySlot, bey in pairs(sim.beys) do
			round.endBeys[tostring(beySlot)] = beySnapshot(bey)
		end
		saveMatches()
	end
end

---Close the match record with the result.
function finishMatch(battle, won)
	if currentMatch and battle and currentMatch.token == tostring(battle.token) then
		currentMatch.won = won
		currentMatch.winner = battle.winner
		currentMatch.endedAt = os.time()
		saveMatches()
	end
end
end

