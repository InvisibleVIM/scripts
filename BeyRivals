-- Account: everything the profile holds worth seeing at a glance (read live from the save).
do
	local function commas(n)
		n = math.floor(tonumber(n) or 0)
		local text = tostring(math.abs(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
		return (n < 0 and "-" or "") .. text
	end
	local rows = {
		{ "Wallet" },
		{ "Coins", function(top) return commas(top.Coins) end },
		{ "Trait tokens", function(_, d) return commas(d.Tokens) end },
		{ "Summon tickets", function(_, d) return commas(d.Tickets) end },
		{ "Limit Breakers", function(_, d) return d.Mats and commas(d.Mats.limit_breaker) or "0" end },
		{ "Evolution materials", function(_, d) local n = 0 for _, v in pairs(d.Mats or {}) do n += tonumber(v) or 0 end return commas(n) end },
		{ "Lucky surname spins", function(_, d) return d.Name and commas(d.Name.lucky) or "-" end },
		{ "Burst tokens today", function(_, d) return d.BurstTokens and commas(d.BurstTokens.n) or "-" end },
		{ "Win tokens today", function(_, d) return d.WinTokens and commas(d.WinTokens.n) or "-" end },
		{ "Profile" },
		{ "Level", function(_, d) return commas(d.Level) end },
		{ "Rank", function() return tostring(localPlayer:GetAttribute("RivalsTier") or "-") end },
		{ "1v1 Elo (peak)", function(_, d) return string.format("%s (%s)", commas(d.Elo), commas(d.Peak)) end },
		{ "2v2 Elo (peak)", function(_, d) return string.format("%s (%s)", commas(d.Elo2), commas(d.Peak2)) end },
		{ "3v3 Elo (peak)", function(_, d) return string.format("%s (%s)", commas(d.Elo3), commas(d.Peak3)) end },
		{ "Ranked W-L", function(_, d) return string.format("%s-%s", commas(d.RankedWins), commas(d.RankedLosses)) end },
		{ "Power", function() return commas(localPlayer:GetAttribute("RivalsPower")) end },
		{ "Win streak (best)", function(_, d) return d.Streak and string.format("%s (%s)", commas(d.Streak.now), commas(d.Streak.best)) or "-" end },
		{ "Surname", function(_, d) return d.Name and tostring(d.Name.id) or "-" end },
		{ "Club", function(_, d) return d.Club and d.Club.tag and string.format("[%s] %s", d.Club.tag, tostring(d.Club.name)) or "None" end },
		{ "Lifetime (game)" },
		{ "Matches", function(_, d) return d.Stats and commas(d.Stats.matches) or "-" end },
		{ "Wins-Losses", function(_, d) return d.Stats and string.format("%s-%s", commas(d.Stats.wins), commas(d.Stats.losses)) or "-" end },
		{ "Bursts dealt", function(_, d) return d.Stats and commas(d.Stats.bursts) or "-" end },
		{ "Ring-outs", function(_, d) return d.Stats and commas(d.Stats.ringouts) or "-" end },
		{ "Smashes", function(_, d) return d.Stats and commas(d.Stats.smashes) or "-" end },
		{ "Perfect clashes", function(_, d) return d.Stats and commas(d.Stats.clashPerfect) or "-" end },
		{ "Summon pulls", function(_, d) return d.Stats and commas(d.Stats.pulls) or "-" end },
		{ "Club wins", function(_, d) return d.Stats and commas(d.Stats.clubWins) or "-" end },
	}
	local labels = {}
	for _, entry in ipairs(rows) do
		if not entry[2] then
			heading(statsPage, entry[1])
		else
			local row = rowBase(statsPage, 30, false)
			rowLabel(row, entry[1])
			labels[entry] = create("TextLabel", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(150, 20),
				BackgroundTransparency = 1,
				FontFace = BODY_BOLD,
				Text = "-",
				TextColor3 = TEXT,
				TextSize = 14,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
		end
	end
	task.spawn(function()
		-- GC scans are slow, so find the save once a minute and read the cached table in between.
		local top, scannedAt = nil, -math.huge
		while not BeyRivals.detached and statsPage.Parent do
			if not top or os.clock() - scannedAt > 60 then
				top, scannedAt = filtergc("table", { Keys = { "Coins", "Rivals" } }, true), os.clock()
			end
			local d = type(top) == "table" and type(top.Rivals) == "table" and top.Rivals or nil
			if type(d) == "table" then
				for entry, label in pairs(labels) do
					local ok, text = pcall(entry[2], top or {}, d)
					label.Text = ok and tostring(text) or "-"
				end
			end
			task.wait(3)
		end
	end)
end

