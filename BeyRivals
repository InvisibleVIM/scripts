---The current battle table (BattleController's private u7).
---@return table?
local function currentBattle()
	local ok, battle = pcall(debug.getupvalue, onLaunchAction, 1)
	if ok and type(battle) == "table" and battle.mySlot then
		return battle
	end
	return nil
