local JOIN_FILE = SETTINGS_FOLDER .. "/lastjoin.json"
local RESULT_WAIT = 20

-- The last way the player (or we) entered a battle: { packet = name, args = {...}, at = os.time() }.
local lastJoin = nil
pcall(function()
	if isfile(JOIN_FILE) then
		lastJoin = httpService:JSONDecode(readfile(JOIN_FILE))
	end
end)

local function rememberJoin(packet, args)
	lastJoin = { packet = packet, args = args, at = os.time() }
	pcall(function()
		if not isfolder(SETTINGS_FOLDER) then
			makefolder(SETTINGS_FOLDER)
		end
		writefile(JOIN_FILE, httpService:JSONEncode(lastJoin))
