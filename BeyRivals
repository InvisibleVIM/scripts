	local foes = {}
	for index, bey in ipairs(sim.beys) do
		if index ~= slot and (me.team == nil or bey.team ~= me.team) then
			table.insert(foes, bey)
		end
	end
	return me, foes
end

---How damaged a bey is toward bursting, 0 to 1.
local function burstRatio(bey)
	local burstMax = bey.burstMax
	if type(burstMax) ~= "number" or burstMax <= 0 then
		return 0
	end
	return math.clamp((bey.burst or 0) / burstMax, 0, 1)
end

local stadiumCache = {}

---How exposed a bey is to a ring-out: steep past 55% of the bowl, doubled near an exit pocket.
---@param sim table
---Stadium id -> { base, mods = set, list, wallK, label }. Challenge stadiums are "Infinity|vents|magnet|...":
---the Sim runs those mechanics itself (so every rollout already plays them); this only feeds the hand rules.
function BeyRivals.stadiumInfo(id)
	id = tostring(id or "")
	local cache = BeyRivals.stadiumInfoCache or {}
	BeyRivals.stadiumInfoCache = cache
	if cache[id] then
		return cache[id]
	end
	local parts = string.split(id, "|")
	local info = { base = parts[1], mods = {}, list = {}, wallK = 1 }
	for i = 2, #parts do
		info.mods[parts[i]] = true
		table.insert(info.list, parts[i])
	end
	local data = Stadiums and Stadiums.get(id)
	local base = Stadiums and Stadiums.get(info.base)
	if data and base and data.wallHeight and base.wallHeight and data.wallHeight > 0 then
		-- Open Stadium: walls at 45% height, ring-outs go over the wall anywhere.
		info.wallK = math.clamp(base.wallHeight / data.wallHeight, 1, 2.5)
	end
	local pretty = {}
	for _, m in ipairs(info.list) do
		table.insert(pretty, (m:gsub("_", " ")))
	end
	info.label = #pretty > 0 and (info.base .. ": " .. table.concat(pretty, ", ")) or info.base
	cache[id] = info
	return info
end

---@param bey table
---@return number 0..80
local function edgeRisk(sim, bey)
	local stadium = stadiumCache[sim.stadium]
	if stadium == nil then
		stadium = Stadiums and Stadiums.get(sim.stadium) or false
		stadiumCache[sim.stadium] = stadium
	end
	if not stadium then
		return 0
	end
	local x, z = bey.x or 0, bey.z or 0
	local reach = math.sqrt(x * x + z * z) / stadium.bowlRadius
	-- Both logged ring-out losses were a hit on the ridge followed by a slide into an exit pocket.
	local risk = math.clamp((reach - 0.5) / 0.5, 0, 1) ^ 1.6 * 70
	-- Spike has no exit pockets (ring-outs need an over-wall at speed 32); its walls cost burst instead,
	-- which the rollouts already count, so the rim is far less of a ring-out threat there.
	local info = BeyRivals.stadiumInfo(sim.stadium)
	if #(stadium.pockets or {}) == 0 and info.wallK <= 1 then
		risk = risk * 0.3
	end
	local pocketK = 1.2
	if #info.list > 0 and Config.StadiumAware then
		risk = risk * info.wallK
		if info.mods.rubber_ring or info.mods.rebound_walls then
			risk = risk * 0.6
		end
		-- Pocket drains pull beys out from the rim with no hit at all (probe: 12/48 rim spots went out).
		if info.mods.suction then
			pocketK = 2.6
		end
	end
	if risk <= 0 then
		return 0
	end
	local degrees = math.deg(math.atan2(z, x)) % 360
	for _, pocket in ipairs(stadium.pockets or {}) do
		local off = math.abs((degrees - pocket + 180) % 360 - 180)
		if off < 32 then
			return risk * (1 + pocketK * (1 - off / 32))
		end
	end
	return risk
end

---Burst ratio at which a stunned/exposed hit from `attacker` bursts `victim` outright (Sim: Crit).
---CRUSH_WEAR 0.6 divided by the attacker's crit passive (doubled while it's awakened on crit), floor 0.5.
function BeyRivals.crushAt(attacker)
	local crit = 1
	for _, passive in ipairs(attacker and attacker.pas or {}) do
		if type(passive.crit) == "number" then
			crit = crit * (1 + (passive.crit - 1) * (Tuning.PASSIVE_K or 1))
		end
	end
	if attacker and (attacker.awakeT or 0) > 0 and attacker.awk == "crit" then
		crit = crit * 2
	end
	return math.max((Tuning.CRUSH_WEAR or 0.6) / math.max(crit, 1), Tuning.CRUSH_MIN or 0.5)
end

function BeyRivals.crushable(bey)
	return (bey.stun or 0) > (Tuning.CRUSH_STUN or 0.05) or (bey.expT or 0) > 0
end

---Ticks until a bey tires (math.huge if never). Tired beys sit at burstMax - TIRE_TOOTH, so their
---next solid touch bursts them; each bey tires on its own clock (stamina decides who goes first).
function BeyRivals.tireIn(sim, bey)
	if bey.tired then
		return 0
	end
	if (bey.tireT or 0) <= 0 then
		return math.huge
	end
	return math.max(bey.tireT - sim.tick, 0)
end

---Points we've scored this match from logged rounds (burst 2, other finishes 1).
function BeyRivals.myPoints()
	local match = BeyRivals.currentMatch
	if not match then
		return 0
	end
	local points = 0
	for _, round in ipairs(match.rounds or {}) do
		if round.done and round.loser and round.loser ~= 0 and round.loser ~= match.mySlot then
			points = points + (round.finish == "Burst" and 2 or 1)
		end
	end
	return points
end

---Points the rival side has scored this match.
function BeyRivals.theirPoints()
	local match = BeyRivals.currentMatch
	if not match then
		return 0
	end
	local points = 0
	for _, round in ipairs(match.rounds or {}) do
		if round.done and round.loser == match.mySlot then
			points = points + (round.finish == "Burst" and 2 or 1)
		end
	end
	return points
end

---Score a simulated future from our side: big for knockouts, else spin and burst lead.
---@param sim table
---@param slot number
---@return number
---Play profile by our bey's type (or the PlayStyle override). The game's own pilot already moves by
---type (Attack rides the rim, Stamina/Defense hold the centre); this tunes our scoring and rules on top.
BeyRivals.PROFILES = {
	Attack = { spinK = 1, burstK = 1, aggrK = 1, clock = false },
	Balance = { spinK = 1.3, burstK = 0.95, aggrK = 0.7, clock = true },
	Stamina = { spinK = 1.7, burstK = 0.85, aggrK = 0.35, clock = true },
	Defense = { spinK = 1.3, burstK = 1.05, aggrK = 0.55, clock = false },
}
function BeyRivals.profileOf(bey)
	local pick = Config.PlayStyle
	if pick == "Auto" or not BeyRivals.PROFILES[pick] then
		pick = bey and BeyRivals.PROFILES[bey.typ] and bey.typ or "Attack"
	end
	return BeyRivals.PROFILES[pick], pick
end

local function scoreOf(sim, slot)
	local me, foes = sidesOf(sim, slot)
	-- Ranked scoring: a burst is worth 2 points, a ring-out or spin finish 1.
	if me.out then
		-- Match point against us: any finish ends the match, so a ring-out or spin-out is as fatal as a burst.
		if BeyRivals.theirPoints() >= 2 then
			return -1000 + sim.tick * 0.01
		end
		return (me.out == "Burst" and -1000 or -720) + sim.tick * 0.01
	end

	local foesLeft, foeSpin, foeBurst = 0, 0, 0
	for _, foe in ipairs(foes) do
		if not foe.out then
			foesLeft = foesLeft + 1
			foeSpin = foeSpin + (foe.spin or 0)
			foeBurst = foeBurst + burstRatio(foe)
		end
	end
	if foesLeft == 0 then
		local bursted = false
		for _, foe in ipairs(foes) do
			if foe.out == "Burst" then
				bursted = true
			end
		end
		-- Vs bots: burst once, then ring out. With 2 points banked a ring-out ends the match exactly like
		-- a burst, and ring-outs come much sooner, so value them the same and let speed decide.
		-- Our match point (any mode): a ring-out or spin finish wins just like a burst.
		if not bursted and BeyRivals.myPoints() >= 2 then
			return 1000 - sim.tick * 0.01
		end
		return (bursted and 1000 or 780) - sim.tick * 0.01
	end

	local profile = BeyRivals.profileOf(me)
	local score = ((me.spin or 0) - foeSpin / foesLeft) * 100 * profile.spinK
	score = score + (foeBurst / foesLeft - burstRatio(me)) * 90 * profile.burstK
	-- Near the burst limit any hit ends the round: steep cost for us, bonus for pressing a near-burst rival.
	local function nearBurst(ratio)
		return math.clamp((ratio - 0.4) / 0.55, 0, 1) ^ 1.5 * 160
	end
	score = score - nearBurst(burstRatio(me))
	for _, foe in ipairs(foes) do
		if not foe.out then
			score = score + nearBurst(burstRatio(foe)) * 0.5 / foesLeft
		end
	end
	-- Crush zone: at 60%+ gauge, any solid hit taken while stunned bursts outright (game rule).
	-- Being stunned anywhere near a rival up there is as bad as losing; a stunned rival up there is a kill.
	local myRatio = burstRatio(me)
	for _, foe in ipairs(foes) do
		if not foe.out then
			local line = BeyRivals.crushAt(foe)
			if myRatio >= line - 0.08 then
				score = score - 35
				if BeyRivals.crushable(me) then
					local dx, dz = (foe.x or 0) - (me.x or 0), (foe.z or 0) - (me.z or 0)
					if dx * dx + dz * dz < 16 then
						score = score - 150
					end
				end
			end
			if burstRatio(foe) >= BeyRivals.crushAt(me) and BeyRivals.crushable(foe) then
				score = score + 60 / foesLeft
			end
		end
	end
	score = score + (#foes - foesLeft) * 200
	-- Every logged ring-out went ridge -> hit -> Lip -> Pocket within ~20 ticks. A lip or teeter is
	-- nearly a lost round already; the boss loss was three of these while far ahead on burst.
	if (me.lip or 0) ~= 0 then
		score = score - 260
	end
	if (me.teeter or 0) > 0 then
		score = score - 90
	end
	if me.onRidge then
		for _, foe in ipairs(foes) do
			if not foe.out then
				local dx, dz = (foe.x or 0) - (me.x or 0), (foe.z or 0) - (me.z or 0)
				if dx * dx + dz * dz < 25 then
					-- Worse when they sit inward of us: their hit pushes us over the lip (every 11-06
					-- overfinish was a ridge clash at low gauge, then Lip -> Pocket 10-20 ticks later).
					local r = math.sqrt((me.x or 0) ^ 2 + (me.z or 0) ^ 2)
					local inward = r > 0.01 and (dx * -(me.x or 0) + dz * -(me.z or 0)) / (r * math.max(math.sqrt(dx * dx + dz * dz), 0.01)) or 0
					score = score - 40 - math.max(inward, 0) * 140
				end
			end
		end
	end

	-- Stay off the edge (ring-outs have no rescue here); push the foe toward it.
	-- An awakened rival hits far harder, so the edge is worth more caution meanwhile.
	local caution = 1
	for _, foe in ipairs(foes) do
		if not foe.out and (foe.awakeT or 0) > 0 then
			caution = 1.5
		end
	end
	local myEdge = edgeRisk(sim, me)
	local safety = 1 - math.clamp(myEdge / 60, 0, 1)
	score = score - myEdge * caution
	local aggression = Config.Aggression
	for _, foe in ipairs(foes) do
		if not foe.out then
			-- Pushing a rival toward the rim is worth more the more aggressive we are.
			score = score + edgeRisk(sim, foe) * (0.6 + 0.5 * aggression) / foesLeft
		end
	end
	-- Pressure: stay on top of the closest rival instead of circling.
	if aggression > 0 then
		local stadium = stadiumCache[sim.stadium]
		local radius = stadium and stadium.bowlRadius or 7.56
		local closest = math.huge
		for _, foe in ipairs(foes) do
			if not foe.out then
				local dx, dz = (foe.x or 0) - (me.x or 0), (foe.z or 0) - (me.z or 0)
				closest = math.min(closest, math.sqrt(dx * dx + dz * dz) / radius)
			end
		end
		if closest < math.huge then
			-- Close in only while our gauge has room; near our burst limit, contact is the danger.
			local room = math.clamp(1 - burstRatio(me) / 0.6, 0, 1)
			score = score - math.clamp(closest, 0, 2) * 12 * aggression * room * safety
		end
		-- Burst race: when our gauge is clearly fuller than theirs, the next exchange bursts us first.
		-- Keep distance and win on spin instead (both logged ranked losses were exactly this).
		local mine, theirs = burstRatio(me), foeBurst / foesLeft
		if closest < math.huge and mine > 0.35 and mine > theirs + 0.08 then
			score = score + math.clamp(closest, 0, 2) * 30 * math.clamp((mine - theirs) / 0.4, 0, 1)
		end
		-- Damage dealt counts extra: favour lines that take the rival's spin and burst down.
		score = score + (foeBurst / foesLeft) * 25 * aggression
	end
	-- Vs the game's AI the rollout is exact, so damage dealt is real progress: pay for every bit of
	-- the boss's gauge and spin we take, so the planner keeps pressing instead of waiting for a finish
	-- it can't see yet (rounds are ~1,700 ticks, the look-ahead ~300).
	if BeyRivals.vsAI(sim, slot) then
		-- (Driving the boss to the rim at match point was tried 11-06 and reverted: it's heavy, never
		-- went out in 17 matches, and chasing it to the rim got us smashed into a pocket instead.)
		for _, foe in ipairs(foes) do
			if not foe.out then
				score = score + burstRatio(foe) * 220 + (1 - math.min(foe.spin or 0, 1)) * 120
			end
		end
	end
	-- Cornered by a faster rival: weight the damage we deal so the planner picks the line that
	-- hurts them more than us (counters, angled hits into their gauge, smashes into the wall).
	if BeyRivals.trading then
		for _, foe in ipairs(foes) do
			if not foe.out then
				score = score + burstRatio(foe) * 160 + (1 - math.min(foe.spin or 0, 1)) * 60
			end
		end
	end
	-- Tire: whoever tires first loses the next contact. Hunt a tired rival; never touch one while tired.
	do
		local myTire = BeyRivals.tireIn(sim, me)
		for _, foe in ipairs(foes) do
			if not foe.out then
				local dx, dz = (foe.x or 0) - (me.x or 0), (foe.z or 0) - (me.z or 0)
				local close = math.clamp(1 - math.sqrt(dx * dx + dz * dz) / 6, 0, 1)
				local foeTire = BeyRivals.tireIn(sim, foe)
				if myTire == 0 and foeTire > 0 then
					score = score - 220 * close
				elseif foeTire == 0 and myTire > 0 then
					score = score + 140 * close / foesLeft
				end
			end
		end
		score = score - (foeSpin / foesLeft) * 40 * aggression
	end
	return score
end

-- ============================================================
--  Pilot: the game's own AI, run for our slot on a copy
-- ============================================================

local function freshPilot()
	local state = Sim.pilotAI()
	state.level = Config.PilotLevel
	return state
end

---Human rivals have no AI in the sim, so copies would step them with no input at all (a rival that
---never attacks). Both ranked losses on 11-05 were a human smashing us as we rushed off the ridge
---at 80%+ gauge, a line the planner thought was free. Model every human rival as the game's AI.
function BeyRivals.modelFoes(copy, slot)
	if not Config.ModelHumans then
		return copy
	end
	for index in ipairs(copy.beys) do
		if index ~= slot and not copy.ai[index] then
			copy.ai[index] = freshPilot()
		end
	end
	return copy
end

---Input the game's AI would give for our bey right now (computed on a copy).
---@param sim table
---@param slot number
---@return table
local function pilotInput(sim, slot)
	local scratch = Sim.copy(sim)
	pilot.level = Config.PilotLevel
	scratch.ai[slot] = pilot
	local input = Sim.aiInput(scratch, slot)
	return { sx = input.sx or 0, sz = input.sz or 0, b = input.b or 0, t = 0 }
end

local PLAN_TICKS = 6
local ripBits, clashBits, inClash, counterPress, burstAfterContact
local ABILITY_BITS = { 32, 64, 8 }
local DASH_BIT = 1

---Step a copy with our bey played exactly like live: perfect rip and clash presses, and the AI's
---input computed *outside* the sim's random stream (we are a player, so the real sim never draws
---from it for us; letting our AI draw would shift the rival's random choices away from reality).
---@param copy table
---@param slot number
---@param clone table pilot state for this rollout
---@param override table? fixed input to use instead
local function stepAsPlayer(copy, slot, clone, override)
	local bey = copy.beys[slot]
	local input = override
	if not input then
		if not bey.launched then
			input = { sx = 0, sz = 0, b = bey.ripTick == 0 and ripBits(copy.tick + 1) or 0, t = 0 }
		else
			local rng = copy.rng
			copy.ai[slot] = clone
			local ok, ai = pcall(Sim.aiInput, copy, slot)
			copy.rng = rng
			copy.ai[slot] = nil
			input = ok and { sx = ai.sx or 0, sz = ai.sz or 0, b = ai.b or 0, t = 0 } or { sx = 0, sz = 0, b = 0, t = 0 }
			if Config.PerfectClash and inClash(copy, slot) then
				input.b = bit32.bor(bit32.band(input.b, bit32.bnot(CLASH_BIT)), clashBits(copy, bey, copy.tick + 1))
			end
			-- Live we take every counter window, so the futures we score should too.
			if Config.AutoCounter then
				local press = counterPress(bey)
				if press == true then
					input.b = bit32.bor(input.b, COUNTER_BIT)
				elseif press == false then
					input.b = bit32.band(input.b, bit32.bnot(COUNTER_BIT))
				end
			end
		end
	end
	copy.ai[slot] = nil
	Sim.step(copy, { [slot] = input })
	return input
end

---Try a candidate for PLAN_TICKS, then play on like live, and score the future.
---@param sim table
---@param slot number
---@param candidate table? nil = AI pilot from now on
---@param horizon number
---@return number
---Milliseconds of look-ahead work done this frame vs the cap.
function BeyRivals.overBudget()
	return BeyRivals.frameStart ~= nil and (os.clock() - BeyRivals.frameStart) * 1000 > Config.FrameCapMs
end

local function rollout(sim, slot, candidate, horizon)
	-- Hard per-frame cap on all look-ahead work: past it, report "no change" instead of simulating.
	if BeyRivals.overBudget() then
		return scoreOf(sim, slot)
	end
	local copy = BeyRivals.modelFoes(Sim.copy(sim), slot)
	local clone = table.clone(pilot)
	clone.level = Config.PilotLevel
	local steps = 0

	if candidate then
		local held = { sx = candidate.sx, sz = candidate.sz, b = 0, t = 0 }
		for step = 1, math.min(PLAN_TICKS, horizon) do
			if copy.done then
				break
			end
			-- Button bits are edges: press on the first tick only.
			stepAsPlayer(copy, slot, clone, step == 1 and candidate or held)
			steps = steps + 1
		end
	end

	-- Frozen ticks (awaken / ultimate cinematics, up to 300) don't count toward the horizon: the
	-- 11-05 ring-out came 10 ticks after an awaken freeze the old horizon never saw past.
	local frozen = 0
	local finishedAt = nil
	local speedRun = BeyRivals.vsAI(sim, slot)
	while steps < horizon and not copy.done do
		local wasFrozen = (copy.freeze or 0) > 0
		stepAsPlayer(copy, slot, clone)
		if wasFrozen and frozen < 320 then
			frozen = frozen + 1
		else
			steps = steps + 1
		end
		if speedRun and not finishedAt then
			local _, foes = sidesOf(copy, slot)
			for _, foe in ipairs(foes) do
				if foe.out then
					finishedAt = steps
				end
			end
		end
	end
	local score = scoreOf(copy, slot)
	-- Against the game's AI the copy is an exact replay of what will happen, so a sooner finish is
	-- strictly better: reward every tick saved (never enough to outweigh our own safety terms).
	if finishedAt and not (copy.beys[slot] and copy.beys[slot].out) then
		score = score + (horizon - finishedAt) * 2
	end
	return score
end

---Every rival is the game's own AI (bosses, NPC fights): the sim predicts them exactly.
function BeyRivals.vsAI(sim, slot)
	local _, foes = sidesOf(sim, slot)
	local any = false
	for index, bey in ipairs(sim.beys) do
		if index ~= slot and not bey.out and table.find(foes, bey) then
			if not sim.ai[index] then
				return false
			end
			any = true
		end
	end
	return any
end

---Every option worth comparing this decision.
---@param bey table
---@return table
local function candidateList(bey, sim, slot)
	local list = { false }
	-- Straight at the closest rival: plain push, dash and every ability.
	if sim then
		local _, foes = sidesOf(sim, slot)
		local target, best = nil, math.huge
		for _, foe in ipairs(foes) do
			if not foe.out then
				local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
				local distance = dx * dx + dz * dz
				if distance < best then
					target, best = { dx = dx, dz = dz }, distance
				end
			end
		end
		if target and best > 0 then
			local length = math.sqrt(best)
			local fx, fz = target.dx / length, target.dz / length
			table.insert(list, { sx = fx, sz = fz, b = 0, t = 0 })
			table.insert(list, { sx = fx, sz = fz, b = DASH_BIT, t = 0 })
			for _, bits in ipairs(ABILITY_BITS) do
				table.insert(list, { sx = fx, sz = fz, b = bits, t = 0 })
			end
		end
	end
	for index = 0, DIRECTIONS - 1 do
		local angle = index / DIRECTIONS * math.pi * 2
		local sx, sz = math.cos(angle), math.sin(angle)
		table.insert(list, { sx = sx, sz = sz, b = 0, t = 0 })
		if index % 2 == 0 then
			table.insert(list, { sx = sx, sz = sz, b = DASH_BIT, t = 0 })
		end
	end
	-- Moves aimed the way the bey is already heading.
	local speed = math.sqrt((bey.vx or 0) ^ 2 + (bey.vz or 0) ^ 2)
	local hx, hz = 0, 0
	if speed > 0.01 then
		hx, hz = bey.vx / speed, bey.vz / speed
	end
	for _, bits in ipairs(ABILITY_BITS) do
		table.insert(list, { sx = hx, sz = hz, b = bits, t = 0 })
	end
	return list
end

---Steer away from the closest rival (along the bowl, never out toward the rim) and drop attack
---presses, while our burst gauge is high and fuller than theirs. nil = keep fighting.
local DISENGAGE_AT = 0.5
local function disengageInput(sim, slot, bey, input, force)
	local mine = burstRatio(bey)
	if mine < DISENGAGE_AT - 0.15 and not force then
		return nil
	end
	local _, foes = sidesOf(sim, slot)
	local target, best = nil, math.huge
	for _, foe in ipairs(foes) do
		if not foe.out then
			local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
			local distance = dx * dx + dz * dz
			if distance < best then
				target, best = foe, distance
			end
		end
	end
	if not target then
		return nil
	end
	local theirs = burstRatio(target)
	local spinLead = (bey.spin or 0) - (target.spin or 0)
	-- With a spin lead, there's no reason to trade at all once the gauge is getting full.
	local threshold = spinLead > 0.03 and (DISENGAGE_AT - 0.15) or DISENGAGE_AT
	if not force and (mine < threshold or theirs >= mine) then
		return nil
	end
	local distance = math.sqrt(best)
	-- With a spin lead there's no reason to touch them at all: run the clock to a spin finish.
	if distance > ((force or spinLead > 0.03) and 12 or 6) then
		return nil
	end
	local ax, az = (bey.x or 0) - (target.x or 0), (bey.z or 0) - (target.z or 0)
	local length = math.max(distance, 0.001)
	ax, az = ax / length, az / length
	-- Near the rim, slide around the bowl instead of backing out of it.
	local stadium = stadiumCache[sim.stadium]
	local radius = stadium and stadium.bowlRadius or 10
	local px, pz = bey.x or 0, bey.z or 0
	local reach = math.sqrt(px * px + pz * pz)
	if reach > radius * 0.6 and reach > 0.01 then
		local ox, oz = px / reach, pz / reach
		local outward = ax * ox + az * oz
		if outward > 0 then
			ax, az = ax - ox * outward * 1.4, az - oz * outward * 1.4
			local l2 = math.max(math.sqrt(ax * ax + az * az), 0.001)
			ax, az = ax / l2, az / l2
		end
	end
	-- Keeping away near the rim got us countered into a pocket (11-05): pick the direction that
	-- gains distance from the rival without adding edge risk.
	if reach > radius * 0.55 then
		local bestScore, bx, bz = -math.huge, ax, az
		for index = 0, 15 do
			local angle = index / 16 * math.pi * 2
			local dx, dz = math.cos(angle), math.sin(angle)
			local nx, nz = px + dx * 2, pz + dz * 2
			local fromFoe = math.sqrt((nx - (target.x or 0)) ^ 2 + (nz - (target.z or 0)) ^ 2)
			local edge = edgeRisk(sim, { x = nx, z = nz })
			local value = fromFoe * 4 - edge
			if value > bestScore then
				bestScore, bx, bz = value, dx, dz
			end
		end
		ax, az = bx, bz
	end
	local bits = bit32.band(input.b, force and BRACE_BIT or bit32.bor(BRACE_BIT, COUNTER_BIT))
	return { sx = ax, sz = az, b = bits, t = 0 }
end

---Our burst gauge after holding `input` (dash/attack presses only on the first tick) for `ticks`.
local function burstAfterHold(sim, slot, input, ticks)
	if BeyRivals.overBudget() then
		return math.huge
	end
	local copy = BeyRivals.modelFoes(Sim.copy(sim), slot)
	copy.ai[slot] = nil
	local first = { sx = input.sx, sz = input.sz, b = input.b, t = 0 }
	local held = { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT)), t = 0 }
	for step = 1, ticks do
		Sim.step(copy, { [slot] = step == 1 and first or held })
		if copy.done then
			break
		end
	end
	local bey = copy.beys[slot]
	if bey.out then
		return (bey.burstMax or 1) * 2
	end
	return bey.burst or 0
end

local escapeVerdict = { tick = -math.huge, input = nil }

---Get out of a rival's ability while it is running. Ability waves can't be guarded (a guard only
---halves the knockback) and their damage falls off with distance; in the logged Stamina losses one
---wave took 33-35% of the gauge. Compared on copies: escaping vs. the line we'd otherwise take.
local function waveEscapeInput(sim, slot, bey, input)
	if sim.tick - escapeVerdict.tick < 6 then
		return escapeVerdict.input
	end
	escapeVerdict.tick, escapeVerdict.input = sim.tick, nil
	local _, foes = sidesOf(sim, slot)
	local stadium = stadiumCache[sim.stadium]
	for _, foe in ipairs(foes) do
		if not foe.out and (foe.ab or 0) ~= 0 then
			local dx, dz = (bey.x or 0) - (foe.x or 0), (bey.z or 0) - (foe.z or 0)
			local distance = math.sqrt(dx * dx + dz * dz)
			if distance < 8 then
				local ax, az = dx / math.max(distance, 0.001), dz / math.max(distance, 0.001)
				local px, pz = bey.x or 0, bey.z or 0
				local radius = stadium and stadium.bowlRadius or 10
				local fromCentre = math.sqrt(px * px + pz * pz)
				if fromCentre > radius * 0.6 and fromCentre > 0.01 then
					local ox, oz = px / fromCentre, pz / fromCentre
					local outward = ax * ox + az * oz
					if outward > 0 then
						ax, az = ax - ox * outward * 1.4, az - oz * outward * 1.4
						local l2 = math.max(math.sqrt(ax * ax + az * az), 0.001)
						ax, az = ax / l2, az / l2
					end
				end
				local bits = bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT))
				local escape = { sx = ax, sz = az, b = bit32.bor(bits, DASH_BIT), t = 0 }
				local burstMax = (bey.burstMax and bey.burstMax > 0) and bey.burstMax or 1
				local stay = burstAfterHold(sim, slot, input, 45)
				local run = burstAfterHold(sim, slot, escape, 45)
				if (stay - run) / burstMax > 0.08 then
					escapeVerdict.input = escape
					return escape
				end
			end
		end
	end
	return nil
end

---Pick the best plan for the next few ticks within the frame budget.
---@param sim table
---@param slot number
---Deep finish search (vs the game's AI only). The sim is deterministic, so a whole finishing line can be
---searched ahead of time and replayed input-for-input. While the search runs (spread over frames at
---Config.DeepMs), we play the exact inputs of a pre-advanced copy, so its end state is where we'll be.
---Every tick is checked against the predicted positions; any mismatch drops back to the normal AI.
BeyRivals.deepStats = BeyRivals.deepStats or { found = 0, done = 0, diverged = 0, none = 0 }
function BeyRivals.deepStep(sim, slot, bey)
	local d = BeyRivals.deep
	local t = sim.tick
	-- Ticks restart every round: a cooldown from last round must not block this one.
	if BeyRivals.deepLastTick and t < BeyRivals.deepLastTick then
		BeyRivals.deepCooldown = 0
	end
	BeyRivals.deepLastTick = t
	if d and (t < d.t0 or d.sim ~= sim.stadium or d.slot ~= slot) then
		BeyRivals.deep, d = nil, nil
	end
	if d then
		local cp = d.check[t]
		if cp then
			local me, foe = sim.beys[slot], sim.beys[d.foe]
			-- Live vs copy drift by ~0.05 over 300 ticks (float noise); a real mismatch is metres off.
			-- Tighter near the burst limit, and bail the moment we're taking damage the line didn't predict
			-- (11-08 unevolved Fenrir vs Volt: two replays ate +2.10 / +1.82 hits before positions drifted).
			local tol = Config.DeepTolerance * math.clamp(1 - burstRatio(me), 0.35, 1)
			if cp[5] and (me.burst or 0) - cp[5] > 0.25 then
				BeyRivals.deepStats.diverged += 1
				BeyRivals.deep = nil
				BeyRivals.deepCooldown = t + 30
				return nil
			end
			if math.abs((me.x or 0) - cp[1]) > tol or math.abs((me.z or 0) - cp[2]) > tol
				or (foe and (math.abs((foe.x or 0) - cp[3]) > tol or math.abs((foe.z or 0) - cp[4]) > tol)) then
				BeyRivals.deepStats.diverged += 1
				BeyRivals.deep = nil
				BeyRivals.deepCooldown = t + 30
				return nil
			end
		end
		if d.mode == "search" then
			BeyRivals.deepWork(d, slot)
		end
		local input = d.inputs[t + 1]
		if not input then
			if d.mode == "exec" then
				BeyRivals.deepStats.done += 1
			end
			BeyRivals.deep = nil
			return nil
		end
		return { sx = input.sx, sz = input.sz, b = input.b, t = 0 }, d
	end
	if (BeyRivals.deepCooldown or 0) > t and (BeyRivals.deepCooldown or 0) - t < 2000 then
		return nil
	end
	-- Start: pre-advance a copy by the time the search will take, recording our exact inputs.
	local foeIndex
	for index, other in ipairs(sim.beys) do
		if index ~= slot and not other.out then
			foeIndex = index
		end
	end
	if not foeIndex or not pilot then
		return nil
	end
	local base = Sim.copy(sim)
	local clone = table.clone(pilot)
	clone.level = Config.PilotLevel
	local cands = candidateList(base.beys[slot], base, slot)
	local horizon = Config.DeepHorizon
	local cost = math.max(stepCost or 0.03, 0.005)
	local frames = math.ceil(#cands * horizon * cost / math.max(Config.DeepMs, 1))
	local lead = math.clamp(math.floor(frames * 1.4) + 12, 30, 420)
	d = { t0 = t, sim = sim.stadium, slot = slot, foe = foeIndex, inputs = {}, check = {}, mode = "search" }
	local startBurst = base.beys[slot].burst or 0
	for _ = 1, lead do
		if base.done then
			return nil
		end
		local applied = stepAsPlayer(base, slot, clone)
		local me, foe = base.beys[slot], base.beys[foeIndex]
		d.inputs[base.tick] = applied
		d.check[base.tick] = { me.x or 0, me.z or 0, foe.x or 0, foe.z or 0, me.burst or 0 }
		if me.out then
			BeyRivals.deepCooldown = t + 30
			return nil
		end
		if foe.out then
			-- The plain line already finishes inside the lead: just replay it.
			d.mode = "exec"
			d.finishAt = base.tick
			BeyRivals.deepStats.found += 1
			BeyRivals.deep = d
			return BeyRivals.deepStep(sim, slot, bey)
		end
	end
	if ((base.beys[slot].burst or 0) - startBurst) / math.max(base.beys[slot].burstMax or 1, 1) > 0.25 then
		BeyRivals.deepCooldown = t + 30
		return nil
	end
	d.base, d.clone, d.cands, d.ci, d.lead = base, clone, cands, 1, lead
	d.need = math.max(3 - BeyRivals.myPoints(), 1)
	BeyRivals.deep = d
	return BeyRivals.deepStep(sim, slot, bey)
end

---Advance the candidate search within this frame's budget.
function BeyRivals.deepWork(d, slot)
	local deadline = os.clock() + Config.DeepMs / 1000
	while d.ci <= #d.cands and os.clock() < deadline do
		local run = d.run
		if not run then
			local cand = d.cands[d.ci]
			local clone = table.clone(d.clone)
			run = { copy = Sim.copy(d.base), clone = clone, k = 0, cand = cand, inputs = {}, check = {} }
			d.run = run
		end
		local copy = run.copy
		while run.k < Config.DeepHorizon and not copy.done and os.clock() < deadline do
			run.k += 1
			local override = nil
			if run.cand then
				if run.k == 1 then
					override = run.cand
				elseif run.k <= PLAN_TICKS then
					override = { sx = run.cand.sx, sz = run.cand.sz, b = 0, t = 0 }
				end
			end
			local applied = stepAsPlayer(copy, slot, run.clone, override)
			local me, foe = copy.beys[slot], copy.beys[d.foe]
			run.inputs[copy.tick] = applied
			run.check[copy.tick] = { me.x or 0, me.z or 0, foe.x or 0, foe.z or 0, me.burst or 0 }
			if me.out then
				run.k = math.huge
				break
			end
			if foe.out then
				local gained = math.min(foe.out == "Burst" and 2 or 1, d.need)
				local rate = gained / (copy.tick - d.t0)
				if not d.best or rate > d.best.rate then
					d.best = { rate = rate, inputs = run.inputs, check = run.check, at = copy.tick, kind = tostring(foe.out) }
				end
				run.k = math.huge
				break
			end
		end
		if run.k >= Config.DeepHorizon or copy.done then
			d.run = nil
			d.ci += 1
		end
	end
	if d.ci > #d.cands then
		d.base, d.cands, d.clone, d.run = nil, nil, nil, nil
		if d.best then
			for tick, input in pairs(d.best.inputs) do
				d.inputs[tick] = input
			end
			for tick, cp in pairs(d.best.check) do
				d.check[tick] = cp
			end
			d.finishAt, d.kind, d.mode = d.best.at, d.best.kind, "exec"
			d.best = nil
			BeyRivals.deepStats.found += 1
		else
			-- Nothing finishes inside the horizon: finish the pre-advanced stretch, then let the normal
			-- AI take over and search again a bit later.
			BeyRivals.deepStats.none += 1
			d.mode = "tail"
			BeyRivals.deepCooldown = d.t0 + d.lead + 60
		end
	end
end

local function decide(sim, slot)
	local candidates = candidateList(sim.beys[slot], sim, slot)
	-- See further while a rival's ability is in flight: that is when we get knocked out.
	local danger = false
	local _, foes = sidesOf(sim, slot)
	for _, foe in ipairs(foes) do
		if not foe.out and ((foe.ab or 0) ~= 0 or (foe.awakeT or 0) > 0) then
			danger = true
		end
	end
	local vsAI = BeyRivals.vsAI(sim, slot)
	-- The plan runs inside a frame, so its cost is FPS: never exceed the budget (the 2.5x boss budget
	-- dropped frames hard enough to lose rounds). Danger replans get 2x, capped at 24 ms.
	local budget = math.min(Config.LookaheadMs * ((danger or forceDanger) and 2 or 1), 24, math.max(Config.FrameCapMs - 2, 2))
	local horizon = math.clamp(math.floor(budget / (stepCost * #candidates)), 45, vsAI and 300 or 240)
	local started = os.clock()

	local pilotScore = rollout(sim, slot, nil, horizon)
	local bestScore, best = pilotScore, nil
	for index = 2, #candidates do
		if BeyRivals.overBudget() then
			break
		end
		local score = rollout(sim, slot, candidates[index], horizon)
		if score > bestScore then
			bestScore, best = score, candidates[index]
		end
	end

	local elapsed = (os.clock() - started) * 1000
	stepCost = stepCost * 0.7 + (elapsed / (horizon * #candidates)) * 0.3

	-- Only override the AI when an option is clearly better.
	if best and bestScore - pilotScore < (vsAI and 0.01 or math.max(3 - Config.Aggression * 1.5, 0.5)) then
		best = nil
	end
	plan = best
	lastBestScore = bestScore
	planFirst = true
	planUntil = sim.tick + PLAN_TICKS

	if bestScore >= 650 then
		status = "Winning line found"
	elseif bestScore <= -650 then
		status = "Defending"
	else
		status = bestScore >= 0 and "Ahead" or "Behind"
	end
end

local COUNTER_CHECK_TICKS = 60
local counterVerdict = { tick = -math.huge, safe = false }

---Compare countering now against holding off (both followed by the full-skill AI) on copies.
---@return boolean
local function counterIsSafe(sim, slot, input, window)
	if counterVerdict.window == window and sim.tick - counterVerdict.tick < (4) then
		return counterVerdict.safe
	end
	-- The counter lunges at the rival; the only reason to skip it is that the lunge rings us out.
	local withCounter = { sx = input.sx, sz = input.sz, b = bit32.bor(input.b, COUNTER_BIT), t = 0 }
	local with = rollout(sim, slot, withCounter, COUNTER_CHECK_TICKS)
	counterVerdict.tick = sim.tick
	counterVerdict.window = window
	counterVerdict.safe = with > -650
	return counterVerdict.safe
end

local ATTACK_BITS = bit32.bor(1, 32, 64, 8)
local attackVerdict = { key = nil, safe = true }

---Before starting a dash or move, compare the exact input we'll send against the same input
---without the new press; skip the press if it loses (e.g. dashing into a rival's perfect guard).
---@return table input, possibly with the new attack press removed
---A rival charging a ridge rush / smash near us: anything that roots or exposes us is a gift to them.
function BeyRivals.smashThreat(sim, slot, bey)
	local _, foes = sidesOf(sim, slot)
	for _, foe in ipairs(foes) do
		if not foe.out then
			local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
			-- Humans hold a charged ridge through freezes and rush the moment we're exposed (11-06 loss:
			-- ridge full at 522, our ability ended at 521, rush landed for 34% after a freeze), so any
			-- ridge build counts against a human; the AI only rushes when nearly full.
			local ridgeLine = sim.ai[table.find(sim.beys, foe) or 0] and 0.6 or 0.25
			local charged = (foe.rush or 0) > 0 or (foe.smashC or 0) >= (Tuning.SMASH_CHARGE or 1) or (foe.onRidge and (foe.ridge or 0) >= ridgeLine) or (foe.ridge or 0) >= 0.9
			if charged and dx * dx + dz * dz < 100 then
				return true
			end
		end
	end
	return false
end

---Sweep abilities lift every rival inside their field and slam them (Swept -> AbilityHit, often a
---Crit). The sim skips anyone who dashed in the last DODGE_WIN (0.22 s). Both 11-06 ranked losses
---were repeated sweeps at 75%+ gauge, so check a few ticks ahead on a copy and dash through it.
function BeyRivals.sweepDodge(sim, slot, bey, input)
	if not Config.SweepDodge or BeyRivals.overBudget() then
		return nil
	end
	local _, foes = sidesOf(sim, slot)
	local casting = false
	for _, foe in ipairs(foes) do
		if not foe.out and (foe.ab or 0) ~= 0 then
			casting = true
		end
	end
	if not casting then
		BeyRivals.dodgeCache = nil
		return nil
	end
	-- Re-search every 3 ticks; hold the chosen dodge in between.
	local cache = BeyRivals.dodgeCache
	if cache and sim.tick - cache.tick < 3 then
		return cache.input
	end
	-- Abilities track us (sweeps lift, AoE pulses every few ticks, waves): judge every option on a copy
	-- by the gauge it costs us over the next pulses (11-06: four AoE pulses in a row while we "kept
	-- away" burst us at 74%). Dashing also grants DODGE_WIN immunity to sweeps and chains.
	local function cost(candidate, ticks)
		local copy = BeyRivals.modelFoes(Sim.copy(sim), slot)
		copy.ai[slot] = nil
		local start = copy.beys[slot].burst or 0
		local penalty = 0
		for _ = 1, ticks do
			stepAsPlayer(copy, slot, nil, candidate)
			local me = copy.beys[slot]
			if me.out then
				return math.huge
			end
			if (me.sweptBy or 0) ~= 0 then
				penalty = penalty + 0.5
			end
		end
		local me = copy.beys[slot]
		local edge = edgeRisk(copy, me) * 0.004
		return (me.burst or 0) - start + penalty * (me.burstMax or 1) + edge
	end
	local horizon = 14
	local stay = cost(input, horizon)
	local burstMax = (bey.burstMax and bey.burstMax > 0) and bey.burstMax or 1
	if stay < burstMax * 0.03 then
		BeyRivals.dodgeCache = { tick = sim.tick, input = nil }
		return nil
	end
	local best, bestCost = nil, stay
	local px, pz = bey.x or 0, bey.z or 0
	local r = math.sqrt(px * px + pz * pz)
	for index = 0, 7 do
		local angle = index / 8 * math.pi * 2
		local dx, dz = math.cos(angle), math.sin(angle)
		if not (r > 7 and (dx * px + dz * pz) / math.max(r, 0.01) > 0.3) then
			for _, bits in ipairs({ DASH_BIT, BRACE_BIT, 0 }) do
				if BeyRivals.overBudget() then
					break
				end
				local candidate = { sx = dx, sz = dz, b = bits, t = 0 }
				local value = cost(candidate, horizon)
				if value < bestCost - burstMax * 0.02 then
					best, bestCost = candidate, value
				end
			end
		end
	end
	BeyRivals.dodgeCache = { tick = sim.tick, input = best }
	return best
end

BeyRivals.LONG_GUARD = { StormSpriggan = true }
local function guardAttack(sim, slot, bey, input)
	local fresh = bit32.band(bit32.band(input.b, ATTACK_BITS), bit32.bnot(bey.prevB or 0))
	if fresh == 0 then
		return input
	end
	if BeyRivals.noAttack then
		return { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bnot(fresh)), t = input.t or 0 }
	end
	-- No fresh ability starts on the rim next to a pocket (vs humans the rollout can't see their pushes).
	-- 11-08 Fenrir vs Longinox: abilities at 565/571 on the rim -> Lip 585 -> Pocket 595, self ring-out.
	if Config.RimAbilityGuard and not BeyRivals.vsAI(sim, slot) and bit32.band(fresh, bit32.bor(32, 64, 8)) ~= 0
		and edgeRisk(sim, bey) >= 45 and lastBestScore < 650 then
		status = "No ability at the pocket"
		return { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bnot(bit32.band(fresh, bit32.bor(32, 64, 8)))), t = input.t or 0 }
	end
	local key = tostring(sim.tick) .. ":" .. tostring(input.b)
	if attackVerdict.key ~= key then
		local quiet = { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bnot(fresh)), t = 0 }
		-- Abilities channel for ~100 ticks and leave us exposed when they end; judge them past the end
		-- (11-06: an ability that ended as the rival's ridge rush landed took us 47% -> 100%).
		-- Never swing into a rival with a guard up while one stun would crit us: a perfect guard stuns
		-- the attacker (11-06: our dash at 52% got guarded, their rush crit us to 100%).
		-- Classic keeps this veto off, except vs long-guard beys (Spriggan: 2x perfect-guard window). 11-08 x2:
		-- both Spriggan losses ended on its counter (our dash at ~87% -> countered to 100%).
		local guardVeto = not Config.ClassicAI
		if not guardVeto and Config.LongGuardVeto then
			local _, foes = sidesOf(sim, slot)
			for _, foe in ipairs(foes) do
				if not foe.out and foe.combo and BeyRivals.LONG_GUARD[foe.combo.layer] then
					guardVeto = true
				end
			end
		end
		if guardVeto and not BeyRivals.vsAI(sim, slot) and not BeyRivals.losingSpinRace(sim, slot, bey) then
			local _, foes = sidesOf(sim, slot)
			for _, foe in ipairs(foes) do
				if not foe.out and (foe.guardN or 0) > 0 and (foe.gbT or 0) <= 0 then
					local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
					if dx * dx + dz * dz < 64 and burstRatio(bey) >= BeyRivals.crushAt(foe) - 0.12 then
						attackVerdict.key, attackVerdict.tick, attackVerdict.safe = key, sim.tick, false
						return { sx = input.sx, sz = input.sz, b = quiet.b, t = 0 }
					end
				end
			end
		end
		local isAbility = not Config.ClassicAI and bit32.band(fresh, bit32.bor(32, 64, 8)) ~= 0
		local ticks = isAbility and 170 or COUNTER_CHECK_TICKS
		local with = rollout(sim, slot, input, ticks)
		local without = rollout(sim, slot, quiet, ticks)
		attackVerdict.key = key
		if isAbility and BeyRivals.smashThreat(sim, slot, bey) then
			with = math.min(with, without - 50)
		end
		-- Aggression buys slack only while our gauge has room; at high gauge an ability that ends next to
		-- the rival leaves us exposed (11-05 2v2 loss: 57% -> 100% off one clash right after our ability).
		local room = BeyRivals.trading and 0.25 or math.clamp(1 - burstRatio(bey) / 0.5, 0, 1)
		room = room * BeyRivals.profileOf(bey).aggrK
		if BeyRivals.outspun(sim, slot, bey) then
			-- Projected spin-out loss: holding back is a slow certain loss the short rollout can't see.
			-- 11-07 vs Fafnir/Weight: 2 dashes in a 4388-tick round, then spin-finished. Swing unless it bursts us.
			attackVerdict.safe = with > -650
		elseif BeyRivals.vsAI(sim, slot) then
			-- Exact prediction: attack whenever it's not actually worse.
			attackVerdict.safe = with > -650 and with >= without - 1
		else
			attackVerdict.safe = with > -650 and with >= without - (2 + Config.Aggression * 8) * room
		end
	end
	if attackVerdict.safe then
		return input
	end
	status = "Held back"
	return { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bnot(fresh)), t = 0 }
end

-- ============================================================
--  Timed presses: rip rings, clash notes, rim saves
-- ============================================================

---Rip presses land exactly on each ring (ticks 42, 84, 126) and the rip (168).
---@param nextTick number
---@return number
function ripBits(nextTick)
	if not Config.PerfectRip then
		return 0
	end
	-- Each ring's press is planned once a round: dead on, or off by a few ticks (Legit tab).
	local plan = BeyRivals.ripPlan
	if not plan or nextTick < plan.tick then
		plan = {}
		local perfect, worst = BeyRivals.T("RipPerfect"), BeyRivals.T("RipError")
		for ring = 0, 3 do
			local off = 0
			if worst > 0 then
				if math.random() * 100 < perfect then
					off = math.random(-math.min(2, worst), math.min(2, worst))
				else
					off = math.random(math.min(3, worst), worst) * (math.random() < 0.5 and -1 or 1)
				end
			end
			plan[ring] = RIP_FIRST + ring * RIP_BEAT + off
		end
		BeyRivals.ripPlan = plan
	end
	plan.tick = nextTick
	for ring = 0, 3 do
		if plan[ring] == nextTick then
			local bits = RIP_PRESS
			if ring == 3 and Config.TiltLaunch then
				bits = bit32.bor(bits, BRACE_BIT)
			end
			return bits
		end
	end
	return 0
end

---Press on the exact tick of the next ungraded clash note.
function clashBits(sim, bey, nextTick)
	local worst, miss = BeyRivals.T("ClashError"), BeyRivals.T("ClashMiss")
	for index = 1, CLASH_NOTES do
		if Sim.clashGrade(bey, index) == 0 then
			local note = Sim.clashNote(sim, index)
			if worst <= 0 and miss <= 0 then
				return note == nextTick and CLASH_BIT or 0
			end
			-- Each note of a clash is planned once: dead on, a few ticks off, or let go (Legit tab).
			local first = Sim.clashNote(sim, 1)
			local plan = BeyRivals.clashPlan
			if not plan or plan.first ~= first then
				plan = { first = first }
				BeyRivals.clashPlan = plan
			end
			if plan[index] == nil then
				if math.random() * 100 < miss then
					plan[index] = false
				elseif worst <= 0 or math.random() * 100 < BeyRivals.T("ClashPerfect") then
					plan[index] = math.random(-math.min(1, worst), math.min(1, worst))
				else
					plan[index] = math.random(math.min(2, worst), worst) * (math.random() < 0.5 and -1 or 1)
				end
			end
			if plan[index] == false then
				-- Let go: nothing is pressed until the game has graded this note a miss.
				return 0
			end
			return note + plan[index] == nextTick and CLASH_BIT or 0
		end
	end
	return 0
end

---@param sim table
---@param slot number
---@return boolean
function inClash(sim, slot)
	return sim.clash > 0 and (sim.clashA == slot or sim.clashB == slot or sim.clashAsA == slot or sim.clashAsB == slot)
end

---Ticks until our bey next makes contact (body clash or an ability/counter hit), or nil.
---Runs the opponent's own AI forward on a copy with our input held.
---@param sim table
---@param slot number
---@param input table
---@return number?
local function ticksToContact(sim, slot, input)
	if BeyRivals.overBudget() then
		return nil
	end
	local copy = BeyRivals.modelFoes(Sim.copy(sim), slot)
	copy.ai[slot] = nil
	local held = { [slot] = { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bnot(BRACE_BIT)), t = 0 } }
	for step = 1, (6) do
		Sim.step(copy, held)
		for _, event in ipairs(copy.events) do
			local kind = event.kind
			if kind == "Clash" and (event.a == slot or event.b == slot) then
				return step, kind
			elseif (kind == "AbilityHit" or kind == "CounterAttack") and (event.target == slot or event.slot == slot) then
				return step, kind
			end
		end
		if copy.done then
			return nil
		end
	end
	return nil
end

---Our burst gauge a few ticks after the predicted contact, with or without bracing now.
---@return number
function burstAfterContact(sim, slot, input, contact, brace)
	local copy = BeyRivals.modelFoes(Sim.copy(sim), slot)
	copy.ai[slot] = nil
	local bits = bit32.band(input.b, bit32.bnot(BRACE_BIT))
	for step = 1, contact + 4 do
		local b = (brace and step == 1) and bit32.bor(bits, BRACE_BIT) or bits
		Sim.step(copy, { [slot] = { sx = input.sx, sz = input.sz, b = b, t = 0 } })
		if copy.done then
			break
		end
	end
	local bey = copy.beys[slot]
	if bey.out then
		return (bey.burstMax or 1) * 2
	end
	return bey.burst or 0
end

---Brace control: tap right before contact for a perfect guard (or a harder hit); never waste charges.
---@return number brace bits to OR into the input
function BeyRivals.guardExact(sim, slot, bey, input)
	local GUARD_PRESS_LEAD = BeyRivals.T("GuardLead")
	if (bey.guardN or 0) <= 0 or (bey.gbT or 0) > 0 or (bey.braceT or 99) < GUARD_WINDOW then
		return 0
	end
	-- A fresh edge is needed; if last tick held Brace, release this tick.
	if bit32.band(bey.prevB or 0, BRACE_BIT) ~= 0 then
		return 0
	end
	-- Kinematic fallback vs humans: the rollout plays them as the game AI, which never ridge-rushes, so a
	-- full-ridge rush never shows up as contact. 11-08 Fenrir vs Longinox/Magnum: three unguarded rushes
	-- (+2.90 / +2.48 / +2.90, ~35% each) while "Ahead". Fast, on-target and about to land -> guard.
	if Config.RushGuard and not BeyRivals.vsAI(sim, slot) then
		local _, foes = sidesOf(sim, slot)
		for _, foe in ipairs(foes) do
			if not foe.out then
				local dx, dz = (bey.x or 0) - (foe.x or 0), (bey.z or 0) - (foe.z or 0)
				local vx, vz = (foe.vx or 0) - (bey.vx or 0), (foe.vz or 0) - (bey.vz or 0)
				local dist = math.sqrt(dx * dx + dz * dz)
				local speed = math.sqrt(vx * vx + vz * vz)
				if dist > 1e-3 and speed > Config.RushGuardSpeed then
					local closing = (dx * vx + dz * vz) / dist
					local gap = dist - (bey.radius or 0.5) - (foe.radius or 0.5)
					-- Perpendicular miss distance of the rival's relative path past us.
					local miss = math.abs(dx * vz - dz * vx) / speed
					if closing > Config.RushGuardSpeed * 0.8 and miss < 1.4 and gap / closing * 60 <= GUARD_PRESS_LEAD + 1 then
						BeyRivals.rushGuards = (BeyRivals.rushGuards or 0) + 1
						return BRACE_BIT
					end
				end
			end
		end
	end
	local contact, kind = ticksToContact(sim, slot, input)
	if not (contact and contact <= GUARD_PRESS_LEAD) then
		return 0
	end
	-- Attack types hold a single guard charge. Spend it on a clash only when that clash hurts:
	-- in the logged losses one unguarded clash took 35-50% of our burst gauge and burst us.
	if kind == "Clash" and bey.typ == "Attack" then
		local open = burstAfterContact(sim, slot, input, contact, false)
		local braced = burstAfterContact(sim, slot, input, contact, true)
		local burstMax = (bey.burstMax and bey.burstMax > 0) and bey.burstMax or 1
		local now = bey.burst or 0
		local gain = (open - now) / burstMax
		local saved = (open - braced) / burstMax
		if open >= burstMax * 0.98 or (now + (open - now)) / burstMax > 0.7 or gain > 0.12 or saved > 0.08 then
			return BRACE_BIT
		end
		return 0
	end
	return BRACE_BIT
end

---The guard as the script would press it, then the Legit tab's say: only so many hits get one.
local function guardBits(sim, slot, bey, input)
	local bits = BeyRivals.guardExact(sim, slot, bey, input)
	if bits ~= 0 and not BeyRivals.humanRoll("guard", sim.tick, 24, BeyRivals.T("GuardRate")) then
		return 0
	end
	return bits
end

---Near our burst point a counter into a guard-ready player is a coin flip we can't afford: if they guard
---it we're the one left open. 11-08 Longinox/Six/Reboot: perfect guard at 99%, counter at 2288, they
---guarded it at 2290 -> teeter -> burst. (The Spriggan loss ended the same way.)
function BeyRivals.counterRisky(sim, slot, bey)
	if not Config.SafeCounter or BeyRivals.vsAI(sim, slot) or burstRatio(bey) < 0.85 then
		return false
	end
	local _, foes = sidesOf(sim, slot)
	for _, foe in ipairs(foes) do
		if not foe.out and (foe.guardN or 0) > 0 and (foe.gbT or 0) <= 0 then
			return true
		end
	end
	return false
end

---Legit tab: is this counter window taken, and has the reaction time passed?
function BeyRivals.humanCounter(sim, window)
	if not window then
		return true
	end
	if window.humanAt == nil then
		window.humanAt = window.start + math.floor(BeyRivals.Tspan("CounterDelay") + 0.5)
		window.humanTake = math.random() * 100 < BeyRivals.T("CounterRate")
		if not window.humanTake then
			window.outcome = "let go (Legit tab)"
		end
	end
	return window.humanTake and sim.tick >= window.humanAt
end

---Counter attack: the window opens after a perfect guard (caT > 0); the game's AI only takes it ~40% of the time.
---@param bey table
---@return boolean? true = press, false = release (so the next press is a fresh edge), nil = not our concern
function counterPress(bey)
	if (bey.caT or 0) <= 0 then
		return nil
	end
	local canAct = (bey.down or 0) <= 0 and (bey.heldT or 0) <= 0 and (bey.air or 0) <= 0
	if not canAct then
		return false
	end
	return bit32.band(bey.prevB or 0, COUNTER_BIT) == 0
end

---Read rip grades from the last step's events for the stats tab.
local function recordEvents(sim, slot)
	for _, event in ipairs(sim.events) do
		if event.kind == "Guard" and event.slot == slot then
			Stats.guards = Stats.guards + 1
		elseif event.kind == "CounterAttack" and event.stage == "go" and event.slot == slot then
			Stats.counters = Stats.counters + 1
		end
		if event.kind == "Rip" and event.slot == slot then
			Stats.rips = Stats.rips + 1
			if event.grade == "Perfect" then
				Stats.perfectRips = Stats.perfectRips + 1
			end
		end
	end
end

-- ============================================================
--  Input hook: replaces BattleInput.sample while auto battle is on
-- ============================================================

local originalSample = BattleInput.sample

---Build this tick's input for our bey.
---@param battle table
---@return table?
local function autoInput(battle)
	BeyRivals.trading = false
	BeyRivals.noAttack = false
	BeyRivals.frameStart = os.clock()
	local round = battle.round
	local sim = round and round.sim
	-- Log first, so the final ticks of a round (including the ones where we go out) are kept.
	if sim and sim.beys and logTick and round.phase == "Battle" then
		pcall(logTick, battle, sim, battle.mySlot)
	end
	if not sim or battle.watch or round.phase ~= "Battle" or sim.done then
		return nil
	end
	pcall(BeyRivals.recordSpin, sim)
	do
		local _, name = BeyRivals.profileOf(sim.beys[battle.mySlot])
		BeyRivals.liveProfile = name
	end
	if BeyRivals.liveStadium ~= sim.stadium then
		BeyRivals.liveStadium = sim.stadium
	end
	local slot = battle.mySlot
	local bey = sim.beys[slot]
	if not bey or bey.out then
		return nil
	end

	recordEvents(sim, slot)

	-- A new battle or round gets a fresh pilot.
	if pilotToken ~= battle.token or not pilot then
		pilot, pilotToken, plan = freshPilot(), battle.token, nil
	end

	local nextTick = sim.tick + 1

	if not bey.launched then
		status = bey.ripTick == 0 and "Ripping" or "Launching"
		return { sx = 0, sz = 0, b = bey.ripTick == 0 and ripBits(nextTick) or 0, t = 0 }
	end

	if Config.DeepFinish and not Config.Human and Config.Lookahead and BeyRivals.vsAI(sim, slot) then
		local ok, deepInput, d = pcall(BeyRivals.deepStep, sim, slot, bey)
		if ok and deepInput then
			if d and d.mode == "exec" and d.finishAt then
				status = string.format("Finishing line: %s in %d", tostring(d.kind or "out"), d.finishAt - sim.tick)
			elseif d and d.mode == "search" then
				status = string.format("Searching finish (%d/%d)", (d.ci or 1), d.cands and #d.cands or 0)
			else
				status = "Replaying"
			end
			return deepInput
		elseif not ok then
			BeyRivals.deep = nil
			BeyRivals.deepError = tostring(deepInput)
		end
	end

	local input = pilotInput(sim, slot)

	if Config.PerfectClash and inClash(sim, slot) then
		status = "Clash"
		input.b = bit32.bor(bit32.band(input.b, bit32.bnot(CLASH_BIT)), clashBits(sim, bey, nextTick))
		-- The game AI's input passes through here unfiltered, and it fires abilities mid-clash. At high
		-- gauge the ability's own contact pushes us to 100% (11-07: a Finisher at 90% burst us, an ability
		-- at 94% into a 99% rival teetered both into a draw), so no ability presses from up here.
		if burstRatio(bey) >= 0.6 then
			input.b = bit32.band(input.b, bit32.bnot(bit32.bor(32, 64, 8)))
		end
		return input
	end

	-- Rim hops only exist when the game enables them.
	if Tuning.RIM_ON and (bey.rimT or 0) > 0 then
		status = "Rim save"
		input.b = (bey.rimT + 1 == RIM_CALL) and RIP_PRESS or 0
		return input
	end

	-- Rival ability live: dodge first, before guard/counter checks spend the frame budget
	-- (11-06: the dodge search ran last, ran out of budget, and an ability hit took 71% -> 100%).
	do
		local dodge = BeyRivals.sweepDodge(sim, slot, bey, input)
		if dodge and BeyRivals.humanRoll("dodge", sim.tick, 45, BeyRivals.T("DodgeRate")) then
			status = "Dodging ability"
			planUntil = sim.tick
			return dodge
		end
	end

	-- We own the Brace bit: strip the AI's guesses and tap only before predicted contact.
	if Config.AutoGuard then
		input.b = bit32.band(input.b, bit32.bnot(BRACE_BIT))
		local brace = guardBits(sim, slot, bey, input)
		if brace ~= 0 then
			status = "Guard"
			input.b = bit32.bor(input.b, brace)
		end
	end

	-- Take counter windows the moment they are legal, unless the lunge would cost us (e.g. off the edge).
	if Config.AutoCounter then
		local press = counterPress(bey)
		if (bey.caT or 0) > 0 then
			if not counterWindow or counterWindow.token ~= battle.token or sim.tick - counterWindow.lastTick > 2 then
				counterWindow = { token = battle.token, start = sim.tick, lastTick = sim.tick, outcome = "open", vetoes = 0 }
				table.insert(CounterLog, counterWindow)
				if #CounterLog > 20 then
					table.remove(CounterLog, 1)
				end
			end
			counterWindow.lastTick = sim.tick
		end
		if press == true then
			if not BeyRivals.humanCounter(sim, counterWindow) then
				-- Legit tab: not yet (reaction time), or this window is let go.
				input.b = bit32.band(input.b, bit32.bnot(COUNTER_BIT))
			elseif not BeyRivals.counterRisky(sim, slot, bey) and counterIsSafe(sim, slot, input, counterWindow.start) then
				status = "Counter!"
				counterWindow.outcome = "pressed"
				input.b = bit32.bor(input.b, COUNTER_BIT)
				return input
			else
				counterWindow.vetoes = counterWindow.vetoes + 1
				counterWindow.outcome = "skipped (would ring us out)"
				input.b = bit32.band(input.b, bit32.bnot(COUNTER_BIT))
			end
		elseif press == false then
			if counterWindow.outcome == "open" then
				counterWindow.outcome = "waiting (stunned/airborne)"
			end
			input.b = bit32.band(input.b, bit32.bnot(COUNTER_BIT))
		end
	end

	if Config.Lookahead then
		-- Reflex: an ability/counter hit is coming and the guard can't take it: re-plan right now.
		local guardReady = (bey.guardN or 0) > 0 and (bey.gbT or 0) <= 0
		if not guardReady and sim.tick < planUntil and sim.tick >= reflexAfter then
			local contact, kind = ticksToContact(sim, slot, input)
			-- Re-plan for incoming ability hits, and for any contact once our gauge is past 45%
			-- (a single clash took 25-35% of the gauge in the logged losses).
			if contact and (kind ~= "Clash" or burstRatio(bey) > 0.45) then
				planUntil = sim.tick
				reflexAfter = sim.tick + PLAN_TICKS
				forceDanger = true
			end
		end
		-- Commit to flee-or-fight for a while: flipping every few ticks (11-07: "no contact" and "trading
		-- up" alternated 6 times in 25 ticks) gets the worst of both, half-run then half-hit.
		local danger = BeyRivals.inDanger(sim, slot, bey)
		local escape = Config.ClassicAI or BeyRivals.canEscape(sim, slot, bey)
		if BeyRivals.modeUntil and sim.tick < BeyRivals.modeUntil and BeyRivals.modeTick and sim.tick >= BeyRivals.modeTick then
			escape = BeyRivals.modeEscape
		elseif danger then
			BeyRivals.modeEscape, BeyRivals.modeUntil, BeyRivals.modeTick = escape, sim.tick + 30, sim.tick
		end
		BeyRivals.escapeNow = escape
		local cornered = (danger and not escape) or BeyRivals.losingSpinRace(sim, slot, bey)
		if cornered then
			BeyRivals.trading = true
			if not BeyRivals.wasCornered then
				planUntil = sim.tick
			end
		end
		BeyRivals.wasCornered = cornered
		if sim.tick >= planUntil then
			decide(sim, slot)
			forceDanger = false
		end
		-- No better line than the game's own AI: that AI keeps charging even deep in the crush zone
		-- (the logged Stamina loss: a Rush at 79% gauge). When our gauge is the fuller one, stay off them.
		if lastBestScore < 650 then
			local escape = waveEscapeInput(sim, slot, bey, input)
			if escape then
				status = "Dodging wave"
				return escape
			end
		end
		-- Crush zone hard rule: once one solid hit would burst us and the rival isn't about to burst
		-- itself, no line is worth contact. The model of a human is only a guess, and every 11-05
		-- "winning line" taken from up here (ability at 92%, counter at 100%) ended in our burst.
		-- Vs the AI a found winning line is an exact replay, not a guess: take it over the crush-zone rule.
		-- In the crush zone only an actual winning line is worth trusting over the no-contact rule:
		-- 11-07 Volt (Hard boss): "not losing" plan at 70% gauge, ability + ridge rush into its Spring
		-- dash took 3.35 (70% -> 100%). Boss AIs don't replay exactly, so "not worse" isn't safe up here.
		local inCrush = false
		do
			local _, foes = sidesOf(sim, slot)
			for _, foe in ipairs(foes) do
				if not foe.out and burstRatio(bey) >= BeyRivals.crushAt(foe) - 0.05 then
					inCrush = true
				end
			end
		end
		local trustPlan = BeyRivals.vsAI(sim, slot) and (lastBestScore >= 650 or (lastBestScore > -650 and not (inCrush and Config.BossCrushGuard)))
		if not trustPlan and danger then
			if BeyRivals.escapeNow then
				local away = disengageInput(sim, slot, bey, input, true)
				if away then
					status = "Crush zone: no contact"
					return away
				end
				-- Out of range already: keep it that way. 11-07: from beyond flee range the plan's "winning
				-- line" dashed in at 73%, the rival dodged, and the clash took us to 100%.
				BeyRivals.noAttack = true
			else
				-- A faster rival will land the hit anyway: fight on our terms. Keep perfect guard +
				-- counter (the strongest trade in the game) and take the planner's best-trading line.
				status = "Cornered: trading up"
			end
		end
		-- Clock-run: ahead on spin, behind on gauge, late in the round. All three 11-05 lost rounds
		-- were trades in exactly this spot (we were up on spin and still traded hits into a burst).
		if not trustPlan and not BeyRivals.trading and lastBestScore < 650 and BeyRivals.runClock(sim, slot, bey) then
			local away = disengageInput(sim, slot, bey, input)
			if away then
				status = "Running the clock"
				return away
			end
		end
		if not trustPlan and not BeyRivals.trading and not plan and lastBestScore < 650 then
			local away = disengageInput(sim, slot, bey, input)
			if away then
				status = "Keeping away"
				return away
			end
		end
		if plan then
			-- Take the planned line; its button press goes out once, plus our guard/counter bits.
			local bits = bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT))
			if planFirst then
				bits = bit32.bor(bits, plan.b)
				planFirst = false
			end
			return BeyRivals.ridgeSafe(sim, slot, bey, guardAttack(sim, slot, bey, { sx = plan.sx, sz = plan.sz, b = bits, t = 0 }))
		end
	else
		status = "Fighting"
	end

	return BeyRivals.ridgeSafe(sim, slot, bey, guardAttack(sim, slot, bey, input))
end

---Never rush off the ridge into a rival while our gauge is high and at least as full as theirs:
---the rush exit is predictable, and a smash into it took 1.2-1.6 burst (100%) in both 11-05 losses.
---Can we actually keep away? No if the rival is closing on us faster than we can open the gap.
function BeyRivals.canEscape(sim, slot, bey)
	local _, foes = sidesOf(sim, slot)
	for _, foe in ipairs(foes) do
		if not foe.out then
			local dx, dz = (bey.x or 0) - (foe.x or 0), (bey.z or 0) - (foe.z or 0)
			local distance = math.sqrt(dx * dx + dz * dz)
			if distance > 0.01 and distance < 9 then
				local ux, uz = dx / distance, dz / distance
				local closing = ((foe.vx or 0) - (bey.vx or 0)) * ux + ((foe.vz or 0) - (bey.vz or 0)) * uz
				local foeSpeed = math.sqrt((foe.vx or 0) ^ 2 + (foe.vz or 0) ^ 2)
				local mySpeed = math.sqrt((bey.vx or 0) ^ 2 + (bey.vz or 0) ^ 2)
				if closing > 0.5 and foeSpeed > mySpeed * 1.05 then
					return false
				end
				if (foe.speed or 0) > (bey.speed or 0) + 0.5 and distance < 5 then
					return false
				end
			end
		end
	end
	return true
end

---Behind on spin late in a round: waiting only hands them a spin finish (11-06: two rounds lost at
---0.05 spin vs 0.28 while we kept away in the crush zone). Time to trade for a burst instead.
---Live spin history per slot (the game swaps round.sim objects mid-round, so never key by table identity).
function BeyRivals.recordSpin(sim)
	local hist = BeyRivals.spinHist
	if not hist or (hist.tick and sim.tick < hist.tick - 5) then
		hist = {}
		BeyRivals.spinHist = hist
	end
	if hist.tick and sim.tick - hist.tick < 30 then
		return
	end
	hist.tick = sim.tick
	for i, bey in ipairs(sim.beys) do
		local h = hist[i]
		if not h then
			h = {}
			hist[i] = h
		end
		table.insert(h, { t = sim.tick, s = bey.spin or 0 })
		if #h > 8 then
			table.remove(h, 1)
		end
	end
end

---Ticks until a bey spins out at its recent decay rate (nil while there's too little history).
function BeyRivals.spinTTL(sim, bey)
	local hist = BeyRivals.spinHist
	local i = table.find(sim.beys, bey)
	local h = hist and i and hist[i]
	if not h or #h < 7 then
		return nil
	end
	local a, b = h[1], h[#h]
	if b.t - a.t < 180 then
		return nil
	end
	local rate = (a.s - b.s) / (b.t - a.t)
	if rate <= 1e-5 then
		return math.huge
	end
	return (bey.spin or b.s or 0) / rate
end

---Keep-away only pays if we outlast them. 11-07 vs Fafnir/Weight: crush-zone keep-away from 53% gauge,
---we lost spin 2x faster (0.72->0.42 vs 0.75->0.60) and got spin-finished twice. Projected loss -> fight.
function BeyRivals.outspun(sim, slot, bey)
	if not Config.SpinOutRace then
		return false
	end
	local _, foes = sidesOf(sim, slot)
	local mine = BeyRivals.spinTTL(sim, bey)
	for _, foe in ipairs(foes) do
		if not foe.out then
			local theirs = BeyRivals.spinTTL(sim, foe)
			if mine and theirs and mine < theirs * 0.85 and (bey.spin or 0) < (foe.spin or 0) + 0.05 then
				return true
			end
		end
	end
	return false
end

function BeyRivals.losingSpinRace(sim, slot, bey)
	if BeyRivals.outspun(sim, slot, bey) then
		return true
	end
	if Config.ClassicAI or not Config.SpinRace then
		return false
	end
	local _, foes = sidesOf(sim, slot)
	local mine = bey.spin or 0
	for _, foe in ipairs(foes) do
		if not foe.out and mine < 0.4 and (foe.spin or 0) > mine + 0.08 then
			return true
		end
	end
	return false
end

---Who bursts first: compare burst HP left, not gauge %. 11-07: Omega Horus (10.6 max) vs us (9.6) sat at
---the same % while it had ~0.6 more HP left, so "even" trades were losing ones (2 bursts, 0-4).
function BeyRivals.burstBehind(bey, foe, mine, theirs, slack)
	slack = slack or 0.05
	if not Config.AbsBurst then
		return slack == 0 and mine > theirs or mine >= theirs - slack
	end
	local myMax = (bey.burstMax and bey.burstMax > 0) and bey.burstMax or 1
	local foeMax = (foe.burstMax and foe.burstMax > 0) and foe.burstMax or myMax
	local myLeft, foeLeft = myMax * (1 - mine), foeMax * (1 - theirs)
	if slack == 0 then
		return myLeft < foeLeft
	end
	return myLeft <= foeLeft + slack * myMax
end

function BeyRivals.inDanger(sim, slot, bey)
	if BeyRivals.losingSpinRace(sim, slot, bey) then
		return false
	end
	if not Config.CrushGuard then
		return false
	end
	local _, foes = sidesOf(sim, slot)
	local mine = burstRatio(bey)
	for _, foe in ipairs(foes) do
		if not foe.out then
			local theirs = burstRatio(foe)
			local foeFinished = BeyRivals.tireIn(sim, foe) == 0 or (theirs >= BeyRivals.crushAt(bey) and BeyRivals.crushable(foe)) or (theirs >= 0.97 and mine < 0.85)
			-- Mutual crush zone (both crit-able): fleeing a rival as fast as us just hands them a hit from
			-- behind. 11-07 Longinox mirror x2: "no contact" at 57% vs 52%, rammed 57% -> 94%. Let the planner
			-- strike/guard first unless we're clearly behind on HP or their ability is live (rule above).
			local mutual = Config.MutualCrush and theirs >= BeyRivals.crushAt(bey) - 0.05 and (foe.ab or 0) == 0
			if mutual then
				local myLeft = (bey.burstMax or 1) * (1 - mine)
				local foeLeft = (foe.burstMax or 1) * (1 - theirs)
				local mySpeed = math.sqrt((bey.vx or 0) ^ 2 + (bey.vz or 0) ^ 2)
				mutual = myLeft >= foeLeft * 0.8 and (foe.speed or 0) >= (bey.speed or 0) * 0.9 and mySpeed >= 0
			end
			if not foeFinished and not mutual and mine >= BeyRivals.crushAt(foe) - 0.05 and BeyRivals.burstBehind(bey, foe, mine, theirs) then
				return true
			end
			-- Rival ability in flight while we're crushable: get out regardless of who's ahead. 11-07 Longinox
			-- mirror: guarded its Dragon Crush, stayed in ("Ahead", 1.44 vs 0.84 HP left), the homing slam then
			-- exposed us and the follow-up dash crit 85% -> 100%. Same shape as the Volt R1 burst.
			if Config.AbilityCrushGuard and not foeFinished and (foe.ab or 0) ~= 0 and mine >= BeyRivals.crushAt(foe) - 0.05 then
				local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
				if dx * dx + dz * dz < 144 then
					return true
				end
			end
			-- An armed rival (ability off cooldown / ultimate charged) can crit us from close range no
			-- matter whose gauge is fuller (11-06: we pressed a 91% rival at 60%, their strike crit us).
			if not Config.ClassicAI and not foeFinished and mine >= BeyRivals.crushAt(foe) - 0.05 and not sim.ai[table.find(sim.beys, foe) or 0] then
				local armed = (foe.ab or 0) == 0 and ((foe.cd1 or 1) <= 0 or (foe.cd2 or 1) <= 0 or (foe.special or 0) >= 1)
				local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
				if armed and dx * dx + dz * dz < 100 then
					return true
				end
			end
		end
	end
	return false
end

function BeyRivals.runClock(sim, slot, bey)
	if not Config.RunClock then
		return false
	end
	local _, foes = sidesOf(sim, slot)
	local mine = burstRatio(bey)
	for _, foe in ipairs(foes) do
		if not foe.out then
			local spinLead = (bey.spin or 0) - (foe.spin or 0)
			local myTire, foeTire = BeyRivals.tireIn(sim, bey), BeyRivals.tireIn(sim, foe)
			-- Waiting only pays if they tire first (or nobody does); 11-05 loss: we ran the clock into our own tire.
			if myTire == 0 or (myTire < foeTire) then
				return myTire == 0 and foeTire > 0
			end
			if spinLead > 0.03 and BeyRivals.burstBehind(bey, foe, mine, burstRatio(foe), 0) and mine >= BeyRivals.crushAt(foe) - 0.15 then
				return true
			end
			-- Stamina/Balance profiles win by outlasting: ahead on spin and projected to outlast them, keep away.
			if BeyRivals.profileOf(bey).clock and spinLead > 0.04 then
				local myTTL, foeTTL = BeyRivals.spinTTL(sim, bey), BeyRivals.spinTTL(sim, foe)
				if myTTL and foeTTL and myTTL > foeTTL * 1.1 then
					return true
				end
			end
		end
	end
	return false
end

---Brace for a hit near the rim: a guard halves knockback, which is the difference between
---staying in and getting flung into a pocket.
function BeyRivals.rimBrace(sim, slot, bey, input)
	if Config.ClassicAI or not Config.RimBrace then
		return input
	end
	local stadium = Stadiums and Stadiums.get(sim.stadium)
	if not stadium then
		return input
	end
	local px, pz = bey.x or 0, bey.z or 0
	local r = math.sqrt(px * px + pz * pz)
	if r < stadium.bowlRadius * 0.7 then
		return input
	end
	local _, foes = sidesOf(sim, slot)
	for _, foe in ipairs(foes) do
		if not foe.out then
			local dx, dz = (foe.x or 0) - px, (foe.z or 0) - pz
			local distance = math.sqrt(dx * dx + dz * dz)
			local closing = distance > 0.01 and (((foe.vx or 0) - (bey.vx or 0)) * -dx + ((foe.vz or 0) - (bey.vz or 0)) * -dz) / distance or 0
			local inward = r > 0.01 and distance > 0.01 and (dx * -px + dz * -pz) / (r * distance) or 0
			if distance < 4.5 and closing > 0.2 and inward > 0.2 then
				status = "Bracing at the rim"
				return { sx = input.sx, sz = input.sz, b = bit32.bor(input.b, BRACE_BIT), t = input.t or 0 }
			end
		end
	end
	return input
end

function BeyRivals.ridgeSafe(sim, slot, bey, input)
	input = BeyRivals.rimBrace(sim, slot, bey, input)
	-- Humans hold a charged ridge through a freeze and rush the first tick it ends (11-07: a full-ridge
	-- rush right after the opening freeze knocked us from the centre into a pocket at 0% gauge).
	-- Be braced as the freeze runs out and for the first few ticks after it.
	if (sim.freeze or 0) > 0 then
		BeyRivals.freezeEndedAt = nil
	elseif BeyRivals.freezeEndedAt == nil then
		BeyRivals.freezeEndedAt = sim.tick
	end
	local afterFreeze = (sim.freeze or 0) > 0 and (sim.freeze or 0) <= 4 or (BeyRivals.freezeEndedAt and sim.tick - BeyRivals.freezeEndedAt <= 8)
	if not Config.ClassicAI and afterFreeze and not BeyRivals.vsAI(sim, slot) and BeyRivals.smashThreat(sim, slot, bey) then
		status = "Bracing for the post-freeze rush"
		input = { sx = input.sx, sz = input.sz, b = bit32.bor(bit32.band(input.b, bit32.bnot(ATTACK_BITS)), BRACE_BIT), t = input.t or 0 }
	end
	if not Config.ClassicAI and (bey.expT or 0) > 0 and BeyRivals.smashThreat(sim, slot, bey) then
		status = "Exposed: bracing"
		input = { sx = input.sx, sz = input.sz, b = bit32.bor(bit32.band(input.b, bit32.bnot(ATTACK_BITS)), BRACE_BIT), t = input.t or 0 }
	end
	if not (Config.SafeRidge and bey.onRidge) then
		return input
	end
	local mine = burstRatio(bey)
	local _, foes = sidesOf(sim, slot)
	-- Low gauge is not a free pass against humans: every 11-06 overfinish was our rush (often + dash)
	-- off the ridge straight into a rival who guarded or smashed it back, sending us over the lip.
	local punisher = nil
	for _, foe in ipairs(foes) do
		local index = table.find(sim.beys, foe) or 0
		if not Config.ClassicAI and not foe.out and not sim.ai[index] then
			local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
			local ready = (foe.guardN or 0) > 0 or (foe.smashC or 0) >= (Tuning.SMASH_CHARGE or 1) or (foe.rush or 0) > 0 or (foe.ridge or 0) >= 0.25
			if dx * dx + dz * dz < 64 and ready then
				punisher = foe
			end
		end
	end
	local theirs, line = 0, 1
	for _, foe in ipairs(foes) do
		if not foe.out then
			theirs = math.max(theirs, burstRatio(foe))
			line = math.min(line, BeyRivals.crushAt(foe))
			-- A rival riding the ridge with us chains/steals into us: staying on it is the trap (11-05 loss 2).
			local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
			if foe.onRidge and dx * dx + dz * dz < 36 and not punisher then
				return input
			end
		end
	end
	if not punisher and (mine < line - 0.1 or theirs > mine + 0.1) then
		return input
	end
	local px, pz = bey.x or 0, bey.z or 0
	local r = math.sqrt(px * px + pz * pz)
	local length = math.sqrt(input.sx * input.sx + input.sz * input.sz)
	if r < 0.01 or length < 0.01 then
		return input
	end
	local inward = (input.sx * -px + input.sz * -pz) / (r * length)
	if inward <= (Tuning.RUSH_DOT or 0.3) - 0.1 then
		return input
	end
	-- Keep riding around the bowl instead: away from the rival who'd punish the rush, otherwise in the
	-- direction we're already going.
	local tx, tz = -pz / r, px / r
	if punisher then
		if ((punisher.x or 0) - px) * tx + ((punisher.z or 0) - pz) * tz > 0 then
			tx, tz = -tx, -tz
		end
	elseif (bey.vx or 0) * tx + (bey.vz or 0) * tz < 0 then
		tx, tz = -tx, -tz
	end
	status = "Safe ridge"
	return { sx = tx, sz = tz, b = bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT)), t = 0 }
end

---Assist mode (auto battle off): the player steers and plays; we only add timing help on top of their
---input. Movement is theirs except during an auto-dodge (if they turn that on).
function BeyRivals.assistInput(battle, user)
	local round = battle.round
	local sim = round and round.sim
	if not sim or battle.watch or round.phase ~= "Battle" or sim.done then
		return nil
	end
	local slot = battle.mySlot
	local bey = sim.beys[slot]
	if not bey or bey.out or type(user) ~= "table" then
		return nil
	end
	BeyRivals.frameStart = os.clock()
	local input = { sx = user.sx or 0, sz = user.sz or 0, b = user.b or 0, t = user.t or 0 }
	local nextTick = sim.tick + 1
	if not bey.launched then
		-- Perfect rip: replace the rip timing, keep the player's aim.
		if Config.AssistRip and bey.ripTick == 0 then
			input.b = ripBits(nextTick)
			status = "Assist: rip"
		end
		return input
	end
	if Config.AssistClash and inClash(sim, slot) then
		input.b = bit32.bor(bit32.band(input.b, bit32.bnot(CLASH_BIT)), clashBits(sim, bey, nextTick))
		status = "Assist: clash"
		return input
	end
	if Config.AssistRim and Tuning.RIM_ON and (bey.rimT or 0) > 0 and bey.rimT + 1 == RIM_CALL then
		input.b = bit32.bor(input.b, RIP_PRESS)
		status = "Assist: rim save"
	end
	if Config.AssistDodge then
		local ok, dodge = pcall(BeyRivals.sweepDodge, sim, slot, bey, input)
		if ok and dodge then
			status = "Assist: dodging"
			-- Keep any guard/counter the player is pressing.
			dodge.b = bit32.bor(dodge.b or 0, bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT)))
			return dodge
		end
	end
	if Config.AssistGuard then
		local ok, brace = pcall(guardBits, sim, slot, bey, input)
		if ok and brace and brace ~= 0 then
			input.b = bit32.bor(input.b, brace)
			status = "Assist: guard"
		end
	end
	if Config.AssistCounter then
		local press = counterPress(bey)
		if press == true then
			if not BeyRivals.counterRisky(sim, slot, bey) then
				input.b = bit32.bor(input.b, COUNTER_BIT)
				status = "Assist: counter"
			end
		elseif press == false then
			input.b = bit32.band(input.b, bit32.bnot(COUNTER_BIT))
		end
	end
	return input
end

---Legit tab: steering and ability presses reach the game the way a hand delivers them, a
---little late and not changed every tick. Guard, counter, rip and clash presses are timed by
---their own values and pass through untouched.
function BeyRivals.humanize(battle, input)
	local lag, hold, late = BeyRivals.T("SteerLag"), BeyRivals.T("SteerHold"), BeyRivals.T("AbilityDelay")
	if lag <= 0 and hold <= 1 and late <= 0 then
		return input
	end
	local sim = battle.round and battle.round.sim
	local bey = sim and sim.beys and sim.beys[battle.mySlot]
	if not (bey and bey.launched) or bey.out or inClash(sim, battle.mySlot) or (bey.rimT or 0) > 0 then
		BeyRivals.hand = nil
		return input
	end
	local hand = BeyRivals.hand
	if not hand or hand.token ~= battle.token or sim.tick < hand.tick or sim.tick - hand.tick > 30 then
		hand = { token = battle.token, steer = {}, presses = {}, sx = input.sx or 0, sz = input.sz or 0, dash = 0, changeAt = 0 }
		BeyRivals.hand = hand
	end
	hand.tick = sim.tick
	local DASH, ABILITIES = 1, 232
	-- Steering (and the dash that goes with it), `lag` ticks late.
	table.insert(hand.steer, { input.sx or 0, input.sz or 0, bit32.band(input.b, DASH) })
	while #hand.steer > lag + 1 do
		table.remove(hand.steer, 1)
	end
	local want = hand.steer[1]
	if (want[1] ~= hand.sx or want[2] ~= hand.sz) and sim.tick >= hand.changeAt then
		hand.sx, hand.sz = want[1], want[2]
		hand.changeAt = sim.tick + hold + (hold > 1 and math.random(0, math.floor(hold / 2)) or 0)
	end
	-- Ability presses, `late` ticks late (held presses stay held for as long).
	table.insert(hand.presses, bit32.band(input.b, ABILITIES))
	while #hand.presses > late + 1 do
		table.remove(hand.presses, 1)
	end
	local bits = bit32.band(input.b, bit32.bnot(bit32.bor(DASH, ABILITIES)))
	bits = bit32.bor(bits, want[3], hand.presses[1])
	return { sx = hand.sx, sz = hand.sz, b = bits, t = input.t or 0 }
end

local function sampleHook(origin, ...)
	if not Config.AutoBattle and Config.Assist then
		local user = originalSample(origin, ...)
		local battle = currentBattle()
		if battle then
			local ok, input = pcall(BeyRivals.assistInput, battle, user)
			if ok and input then
				return input
			elseif not ok then
				warn("[Bey Rivals assist] " .. tostring(input))
			end
		end
		return user
	end
	if Config.AutoBattle then
		local battle = currentBattle()
		if battle then
			local ok, input = pcall(autoInput, battle)
			if ok and input then
				local fine, shaped = pcall(BeyRivals.humanize, battle, input)
				return fine and shaped or input
			elseif not ok then
				warn("[Bey Rivals] " .. tostring(input))
			end
		end
	end
	return originalSample(origin, ...)
end

BattleInput.sample = sampleHook

-- Aim assist would bend the AI's steering toward the locked rival.
local hadAimAssist = localPlayer:GetAttribute("AimAssist")
local function syncAimAssist()
	if Config.AutoBattle then
		localPlayer:SetAttribute("AimAssist", false)
	else
		localPlayer:SetAttribute("AimAssist", hadAimAssist)
	end
end

-- ============================================================
--  Launch: simulate a grid of launch spots, lock in the best one
-- ============================================================

---Candidate (angle, distance) pairs, coarse grid first so a cut-off search still spreads out.
---@param defaultAngle number
---@return table
local function launchCandidates(defaultAngle)
	local list = { { a = defaultAngle, d = 0.55, default = true } }
	for pass = 0, 1 do
		for _, distance in ipairs(LAUNCH_DISTANCES) do
			for index = pass, LAUNCH_ANGLES - 1, 2 do
				table.insert(list, { a = index / LAUNCH_ANGLES * math.pi * 2, d = distance })
			end
		end
	end
	return list
end

---Play a round from this launch spot (both sides on the game's AI) and score it.
---@param sim table
---@param slot number
---@param candidate table
---@param foeOffset number rival angle offset from its stance
---@return number
local function scoreLaunchOnce(sim, slot, candidate, foeOffset)
	local copy = Sim.copy(sim)
	local count = #copy.beys
	for index, bey in ipairs(copy.beys) do
		if index == slot then
			Sim.setAim(copy, index, candidate.a, candidate.d, "Power")
		elseif (bey.aimS or 0) == 0 then
			-- Rival aim is unknown until both lock in: model the AI's habit.
			local stand = Stadiums and Stadiums.standAngle(index, count) or 0
			Sim.setAim(copy, index, stand + foeOffset, (0.6), "Power")
		end
		if not copy.ai[index] then
			copy.ai[index] = freshPilot()
		end
	end
	copy.ai[slot] = nil
	local clone = freshPilot()
	for _ = 1, (600) do
		if copy.done then
			break
		end
		stepAsPlayer(copy, slot, clone)
	end
	return scoreOf(copy, slot)
end

local launchFrameStart = os.clock()

---Average a launch spot over the rival's likely angles, so the pick is robust to its randomness.
local function scoreLaunch(sim, slot, candidate)
	local total = 0
	for _, offset in ipairs(FOE_ANGLE_SPREAD) do
		total = total + scoreLaunchOnce(sim, slot, candidate, offset)
		-- Yield between test rounds so planning never stalls a frame for long.
		if (os.clock() - launchFrameStart) * 1000 > LAUNCH_FRAME_MS then
			task.wait()
			launchFrameStart = os.clock()
		end
	end
	return total / #FOE_ANGLE_SPREAD
end

---Search launch spots across frames, then lock in through the game's own launch handler.
---@param battle table
local function planAndLaunch(battle)
	local round = battle.round
	local slot = battle.mySlot
	local radius = battle.stadium and battle.stadium.bowlRadius or 1
	local defaultAim = battle.aim
	local defaultAngle = typeof(defaultAim) == "Vector2" and math.atan2(defaultAim.Y, defaultAim.X) or 0

	local best = { a = defaultAngle, d = 0.55 }
	local openedAt = os.clock()
	local scored = {}
	if Config.PlanLaunch then
		status = "Planning launch"
		local candidates = launchCandidates(defaultAngle)
		local deadline = os.clock() + BeyRivals.T("LaunchThink")
		launchFrameStart = os.clock()
		local bestScore, tried = -math.huge, 0

		for _, candidate in ipairs(candidates) do
			if os.clock() > deadline or currentBattle() ~= battle or battle.ready or round.phase ~= "Launch" then
				break
			end
			local ok, score = pcall(scoreLaunch, round.sim, slot, candidate)
			tried = tried + 1
			-- Prefer the default spot on ties so we only move for a real gain.
			if ok and (score > bestScore + (candidate.default and 0 or 0.5)) then
				bestScore, best = score, candidate
			end
			if ok then
				table.insert(scored, { score = score, spot = candidate })
			end
			if (os.clock() - launchFrameStart) * 1000 > LAUNCH_FRAME_MS then
				task.wait()
				launchFrameStart = os.clock()
			end
		end
		status = string.format("Launch picked (%d spots)", tried)
	end
	-- Legit tab: any of the best few spots, a little off the mark, after a moment's thought.
	do
		local top = BeyRivals.T("LaunchPickTop")
		if top > 1 and #scored > 1 then
			table.sort(scored, function(a, b)
				return a.score > b.score
			end)
			best = scored[math.random(1, math.min(top, #scored))].spot
		end
		local wobble = math.rad(BeyRivals.T("LaunchAimNoise"))
		if wobble > 0 then
			best = { a = best.a + (math.random() * 2 - 1) * wobble, d = math.clamp(best.d + (math.random() * 2 - 1) * wobble * 0.5, 0.1, 0.85) }
		end
		local lockAt = openedAt + BeyRivals.Tspan("LaunchWait")
		while os.clock() < lockAt and currentBattle() == battle and not battle.ready and round.phase == "Launch" do
			status = "Lining up the launch"
			task.wait(0.05)
		end
	end

	if currentBattle() ~= battle or battle.ready or round.phase ~= "Launch" then
		return
	end
	-- Set the aim and lock in on the same frame, before the mouse can move it.
	battle.aim = Vector2.new(math.cos(best.a), math.sin(best.a)) * math.clamp(best.d, 0.1, 0.85) * radius

	-- Run the game's handler at game-script identity: its HUD toasts lazily require
	-- game modules, which errors at executor identity and aborts before the launch is sent.
	setthreadidentity(2)
	local ok, err = pcall(onLaunchAction, "BeyLaunch", Enum.UserInputState.Begin, nil)
	setthreadidentity(8)
	if not ok then
		warn("[Bey Rivals] Launch handler error: " .. tostring(err))
	end
end

-- Start planning when a launch phase opens.
table.insert(BeyRivals.connections, runService.Heartbeat:Connect(function()
	syncAimAssist()
	local battle = currentBattle()
	if battle then
		lastBattle = battle
	end
	if not (Config.AutoBattle and Config.AutoLaunch and battle and battle.round) then
		return
	end
	if battle.watch or battle.round.phase ~= "Launch" or battle.ready then
		return
	end

	local key = tostring(battle.token) .. ":" .. tostring(battle.round.no)
	if launchedRound == key then
		return
	end
	launchedRound = key
	task.spawn(planAndLaunch, battle)
end))

---Did our side win the battle that just ended?
local function weWon(battle)
	local winner = battle and battle.winner
	if type(winner) ~= "number" then
		return nil
	end
	if winner == battle.mySlot then
		return true
	end
	local sim = battle.round and battle.round.sim
	local mine = sim and sim.beys[battle.mySlot]
	local theirs = sim and sim.beys[winner]
	if mine and theirs and mine.team ~= nil then
		return mine.team == theirs.team
	end
	return false
end

---True once a battle other than the one that just ended is running.
---@param endedToken any
local function inNewBattle(endedToken)
	local battle = currentBattle()
	return battle ~= nil and battle.token ~= endedToken and not battle.over
end

