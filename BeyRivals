do
-- ============================================================
--  Trait auto roll: keeps rolling a slot (tokens, then coins) until a wanted trait lands
-- ============================================================

local Catalog = filtergc("table", { Keys = { "trait", "traitSlots", "TRAIT_ROLL_BP" } }, true)
local TRAIT_ROLL_GAP = 0.3

local cachedData, cachedAt = nil, 0
local function playerData()
	if cachedData and type(cachedData.Items) == "table" and os.clock() - cachedAt < 5 then
		return cachedData
	end
	cachedData, cachedAt = filtergc("table", { Keys = { "Items", "Tokens" } }, true), os.clock()
	return cachedData
end

local function traitName(id)
	local trait = Catalog and Catalog.trait(id)
	return trait and trait.name or tostring(id)
end

local function itemName(item)
	local part = Catalog and Catalog.part and Catalog.part(item.kind, item.id)
	local name = part and part.display or item.id
	return string.format("%s %s%s", tostring(name), string.rep("*", item.star or 0), item.kind and (" (" .. item.kind .. ")") or "")
end

local function slotsOf(item)
	local ok, slots = pcall(Catalog.traitSlots, item.kind, item.id, item.star)
	return ok and type(slots) == "number" and slots or 0
end

---Currently equipped parts that can hold traits (layer, disc, driver): { uid, item }.
local function traitItems()
	local list = {}
	local data = playerData()
	if not (data and Catalog) then
		return list
	end
	local equipped = {}
	for _, uid in pairs(type(data.Equip) == "table" and data.Equip or {}) do
		equipped[uid] = true
	end
	for uid, item in pairs(data.Items) do
		if equipped[uid] and type(item) == "table" and slotsOf(item) > 0 then
			table.insert(list, { uid = uid, item = item })
		end
	end
	table.sort(list, function(a, b)
		if a.item.kind ~= b.item.kind then
			return tostring(a.item.kind) < tostring(b.item.kind)
		end
		if (a.item.star or 0) ~= (b.item.star or 0) then
			return (a.item.star or 0) > (b.item.star or 0)
		end
		return itemName(a.item) < itemName(b.item)
	end)
	return list
end

local traitStatus = "Pick an item, a slot and the traits you want"
local rolling = false
stopTraitRolling = function()
	rolling = false
end
local rollRun = 0

local function wanted(id)
	return type(id) == "string" and Config["TraitWant_" .. id] == true
end

local function stopRolling(text)
	rolling = false
	traitStatus = text
end

local function startRolling()
	if rolling then
		stopRolling("Stopped")
		return
	end
	if not (Catalog and Packets and Packets.RivalsTrait) then
		traitStatus = "Trait modules not found"
		return
	end
	rolling = true
	rollRun = rollRun + 1
	local run = rollRun
	task.spawn(function()
		local rolls, coinRolls = 0, 0
		while rolling and run == rollRun do
			local data = playerData()
			local item = data and data.Items[Config.TraitItem]
			if not item then
				return stopRolling("Pick an item first")
			end
			local slots = slotsOf(item)
			if slots <= 0 then
				return stopRolling("That item has no trait slots")
			end
			local slot = math.clamp(math.floor(Config.TraitSlot), 1, slots)
			local current = item.traits and item.traits[slot]
			if wanted(current) then
				return stopRolling(string.format("Done: slot %d is %s (%d rolls)", slot, traitName(current), rolls))
			end
			if Config.TraitMaxRolls > 0 and rolls >= Config.TraitMaxRolls then
				return stopRolling(string.format("Stopped after %d rolls (limit)", rolls))
			end
			local useCoins = (data.Tokens or 0) <= 0
			if useCoins and not Config.TraitUseCoins then
				return stopRolling(string.format("Out of tokens after %d rolls", rolls))
			end

			setthreadidentity(2)
			local ok, accepted, message, rolled = pcall(function()
				return Packets.RivalsTrait:Fire(Config.TraitItem, slot, useCoins)
			end)
			setthreadidentity(8)

			if not ok then
				task.wait(1)
			elseif accepted ~= true then
				local reason = (type(message) == "string" and message ~= "") and message or tostring(rolled)
				return stopRolling(string.format("Stopped: %s (%d rolls)", reason, rolls))
			else
				rolls = rolls + 1
				if useCoins then
					coinRolls = coinRolls + 1
				end
				traitStatus = string.format("Roll %d%s: %s", rolls, useCoins and " (coins)" or "", traitName(rolled))
				if wanted(rolled) then
					return stopRolling(string.format("Got %s on slot %d after %d rolls (%d with coins)", traitName(rolled), slot, rolls, coinRolls))
				end
			end
			task.wait(TRAIT_ROLL_GAP)
		end
	end)
end

