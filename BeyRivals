---Undo every hook and connection.
function BeyRivals.detach()
	saveSettings()
	if BattleInput.sample == sampleHook then
		BattleInput.sample = originalSample
	end
	localPlayer:SetAttribute("AimAssist", hadAimAssist)
	for _, connection in ipairs(BeyRivals.connections) do
		connection:Disconnect()
	end
	if BeyRivals.gui then
		BeyRivals.gui:Destroy()
	end
	if shared.BeyRivals == BeyRivals then
		shared.BeyRivals = nil
	end
end

