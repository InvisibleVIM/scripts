---@param sim table
---@param slot number
---@return table, table
local function sidesOf(sim, slot)
	local me = sim.beys[slot]
	local foes = {}
	for index, bey in ipairs(sim.beys) do
		if index ~= slot and (me.team == nil or bey.team ~= me.team) then
			table.insert(foes, bey)
		end
	end
	return me, foes
end

---How damaged a bey is toward bursting, 0 to 1.
local function burstRatio(bey)
	local burstMax = bey.burstMax
	if type(burstMax) ~= "number" or burstMax <= 0 then
		return 0
	end
	return math.clamp((bey.burst or 0) / burstMax, 0, 1)
end

local stadiumCache = {}

---How exposed a bey is to a ring-out: steep past 55% of the bowl, doubled near an exit pocket.
---@param sim table
---@param bey table
---@return number 0..80
local function edgeRisk(sim, bey)
	local stadium = stadiumCache[sim.stadium]
	if stadium == nil then
		stadium = Stadiums and Stadiums.get(sim.stadium) or false
		stadiumCache[sim.stadium] = stadium
	end
	if not stadium then
		return 0
	end
	local x, z = bey.x or 0, bey.z or 0
	local reach = math.sqrt(x * x + z * z) / stadium.bowlRadius
	-- Both logged ring-out losses were a hit on the ridge followed by a slide into an exit pocket.
	local risk = math.clamp((reach - 0.5) / 0.5, 0, 1) ^ 1.6 * 70
	if risk <= 0 then
		return 0
	end
	local degrees = math.deg(math.atan2(z, x)) % 360
	for _, pocket in ipairs(stadium.pockets or {}) do
		local off = math.abs((degrees - pocket + 180) % 360 - 180)
		if off < 32 then
			return risk * (1 + 1.2 * (1 - off / 32))
		end
	end
	return risk
end

---Score a simulated future from our side: big for knockouts, else spin and burst lead.
---@param sim table
---@param slot number
---@return number
local function scoreOf(sim, slot)
	local me, foes = sidesOf(sim, slot)
	-- Ranked scoring: a burst is worth 2 points, a ring-out or spin finish 1.
	if me.out then
		return (me.out == "Burst" and -1000 or -720) + sim.tick * 0.01
	end

	local foesLeft, foeSpin, foeBurst = 0, 0, 0
	for _, foe in ipairs(foes) do
		if not foe.out then
			foesLeft = foesLeft + 1
			foeSpin = foeSpin + (foe.spin or 0)
			foeBurst = foeBurst + burstRatio(foe)
		end
	end
	if foesLeft == 0 then
		local bursted = false
		for _, foe in ipairs(foes) do
			if foe.out == "Burst" then
				bursted = true
			end
		end
		return (bursted and 1000 or 780) - sim.tick * 0.01
	end

	local score = ((me.spin or 0) - foeSpin / foesLeft) * 100
	score = score + (foeBurst / foesLeft - burstRatio(me)) * 90
	-- Near the burst limit any hit ends the round: steep cost for us, bonus for pressing a near-burst rival.
	local function nearBurst(ratio)
		return math.clamp((ratio - 0.4) / 0.55, 0, 1) ^ 1.5 * 160
	end
	score = score - nearBurst(burstRatio(me))
	for _, foe in ipairs(foes) do
		if not foe.out then
			score = score + nearBurst(burstRatio(foe)) * 0.5 / foesLeft
		end
	end
	-- Crush zone: at 60%+ gauge, any solid hit taken while stunned bursts outright (game rule).
	-- Being stunned anywhere near a rival up there is as bad as losing; a stunned rival up there is a kill.
	local myRatio = burstRatio(me)
	if myRatio >= 0.55 then
		score = score - 35
		if (me.stun or 0) > 0.05 then
			for _, foe in ipairs(foes) do
				if not foe.out then
					local dx, dz = (foe.x or 0) - (me.x or 0), (foe.z or 0) - (me.z or 0)
					if dx * dx + dz * dz < 16 then
						score = score - 150
					end
				end
			end
		end
	end
	for _, foe in ipairs(foes) do
		if not foe.out and burstRatio(foe) >= 0.6 and (foe.stun or 0) > 0.05 then
			score = score + 60 / foesLeft
		end
	end
	score = score + (#foes - foesLeft) * 200
	-- Every logged ring-out went ridge -> hit -> Lip -> Pocket within ~20 ticks. A lip or teeter is
	-- nearly a lost round already; the boss loss was three of these while far ahead on burst.
	if (me.lip or 0) ~= 0 then
		score = score - 260
	end
	if (me.teeter or 0) > 0 then
		score = score - 90
	end
	if me.onRidge then
		for _, foe in ipairs(foes) do
			if not foe.out then
				local dx, dz = (foe.x or 0) - (me.x or 0), (foe.z or 0) - (me.z or 0)
				if dx * dx + dz * dz < 25 then
					score = score - 40
				end
			end
		end
	end

	-- Stay off the edge (ring-outs have no rescue here); push the foe toward it.
	-- An awakened rival hits far harder, so the edge is worth more caution meanwhile.
	local caution = 1
	for _, foe in ipairs(foes) do
		if not foe.out and (foe.awakeT or 0) > 0 then
			caution = 1.5
		end
	end
	local myEdge = edgeRisk(sim, me)
	local safety = 1 - math.clamp(myEdge / 60, 0, 1)
	score = score - myEdge * caution
	local aggression = Config.Aggression
	for _, foe in ipairs(foes) do
		if not foe.out then
			-- Pushing a rival toward the rim is worth more the more aggressive we are.
			score = score + edgeRisk(sim, foe) * (0.6 + 0.5 * aggression) / foesLeft
		end
	end
	-- Pressure: stay on top of the closest rival instead of circling.
	if aggression > 0 then
		local stadium = stadiumCache[sim.stadium]
		local radius = stadium and stadium.bowlRadius or 7.56
		local closest = math.huge
		for _, foe in ipairs(foes) do
			if not foe.out then
				local dx, dz = (foe.x or 0) - (me.x or 0), (foe.z or 0) - (me.z or 0)
				closest = math.min(closest, math.sqrt(dx * dx + dz * dz) / radius)
			end
		end
		if closest < math.huge then
			-- Close in only while our gauge has room; near our burst limit, contact is the danger.
			local room = math.clamp(1 - burstRatio(me) / 0.6, 0, 1)
			score = score - math.clamp(closest, 0, 2) * 12 * aggression * room * safety
		end
		-- Burst race: when our gauge is clearly fuller than theirs, the next exchange bursts us first.
		-- Keep distance and win on spin instead (both logged ranked losses were exactly this).
		local mine, theirs = burstRatio(me), foeBurst / foesLeft
		if closest < math.huge and mine > 0.35 and mine > theirs + 0.08 then
			score = score + math.clamp(closest, 0, 2) * 30 * math.clamp((mine - theirs) / 0.4, 0, 1)
		end
		-- Damage dealt counts extra: favour lines that take the rival's spin and burst down.
		score = score + (foeBurst / foesLeft) * 25 * aggression
		score = score - (foeSpin / foesLeft) * 40 * aggression
	end
	return score
end

-- ============================================================
--  Pilot: the game's own AI, run for our slot on a copy
-- ============================================================

local function freshPilot()
	local state = Sim.pilotAI()
	state.level = Config.PilotLevel
	return state
end

---Human rivals have no AI in the sim, so copies would step them with no input at all (a rival that
---never attacks). Both ranked losses on 11-05 were a human smashing us as we rushed off the ridge
---at 80%+ gauge, a line the planner thought was free. Model every human rival as the game's AI.
function BeyRivals.modelFoes(copy, slot)
	if not Config.ModelHumans then
		return copy
	end
	for index in ipairs(copy.beys) do
		if index ~= slot and not copy.ai[index] then
			copy.ai[index] = freshPilot()
		end
	end
	return copy
end

---Input the game's AI would give for our bey right now (computed on a copy).
---@param sim table
---@param slot number
---@return table
local function pilotInput(sim, slot)
	local scratch = Sim.copy(sim)
	pilot.level = Config.PilotLevel
	scratch.ai[slot] = pilot
	local input = Sim.aiInput(scratch, slot)
	return { sx = input.sx or 0, sz = input.sz or 0, b = input.b or 0, t = 0 }
end

local PLAN_TICKS = 6
local ripBits, clashBits, inClash, counterPress, burstAfterContact
local ABILITY_BITS = { 32, 64, 8 }
local DASH_BIT = 1

---Step a copy with our bey played exactly like live: perfect rip and clash presses, and the AI's
---input computed *outside* the sim's random stream (we are a player, so the real sim never draws
---from it for us; letting our AI draw would shift the rival's random choices away from reality).
---@param copy table
---@param slot number
---@param clone table pilot state for this rollout
---@param override table? fixed input to use instead
local function stepAsPlayer(copy, slot, clone, override)
	local bey = copy.beys[slot]
	local input = override
	if not input then
		if not bey.launched then
			input = { sx = 0, sz = 0, b = bey.ripTick == 0 and ripBits(copy.tick + 1) or 0, t = 0 }
		else
			local rng = copy.rng
			copy.ai[slot] = clone
			local ok, ai = pcall(Sim.aiInput, copy, slot)
			copy.rng = rng
			copy.ai[slot] = nil
			input = ok and { sx = ai.sx or 0, sz = ai.sz or 0, b = ai.b or 0, t = 0 } or { sx = 0, sz = 0, b = 0, t = 0 }
			if Config.PerfectClash and inClash(copy, slot) then
				input.b = bit32.bor(bit32.band(input.b, bit32.bnot(CLASH_BIT)), clashBits(copy, bey, copy.tick + 1))
			end
			-- Live we take every counter window, so the futures we score should too.
			if Config.AutoCounter then
				local press = counterPress(bey)
				if press == true then
					input.b = bit32.bor(input.b, COUNTER_BIT)
				elseif press == false then
					input.b = bit32.band(input.b, bit32.bnot(COUNTER_BIT))
				end
			end
		end
	end
	copy.ai[slot] = nil
	Sim.step(copy, { [slot] = input })
end

---Try a candidate for PLAN_TICKS, then play on like live, and score the future.
---@param sim table
---@param slot number
---@param candidate table? nil = AI pilot from now on
---@param horizon number
---@return number
local function rollout(sim, slot, candidate, horizon)
	local copy = BeyRivals.modelFoes(Sim.copy(sim), slot)
	local clone = table.clone(pilot)
	clone.level = Config.PilotLevel
	local steps = 0

	if candidate then
		local held = { sx = candidate.sx, sz = candidate.sz, b = 0, t = 0 }
		for step = 1, math.min(PLAN_TICKS, horizon) do
			if copy.done then
				break
			end
			-- Button bits are edges: press on the first tick only.
			stepAsPlayer(copy, slot, clone, step == 1 and candidate or held)
			steps = steps + 1
		end
	end

	while steps < horizon and not copy.done do
		stepAsPlayer(copy, slot, clone)
		steps = steps + 1
	end
	return scoreOf(copy, slot)
end

---Every option worth comparing this decision.
---@param bey table
---@return table
local function candidateList(bey, sim, slot)
	local list = { false }
	-- Straight at the closest rival: plain push, dash and every ability.
	if sim then
		local _, foes = sidesOf(sim, slot)
		local target, best = nil, math.huge
		for _, foe in ipairs(foes) do
			if not foe.out then
				local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
				local distance = dx * dx + dz * dz
				if distance < best then
					target, best = { dx = dx, dz = dz }, distance
				end
			end
		end
		if target and best > 0 then
			local length = math.sqrt(best)
			local fx, fz = target.dx / length, target.dz / length
			table.insert(list, { sx = fx, sz = fz, b = 0, t = 0 })
			table.insert(list, { sx = fx, sz = fz, b = DASH_BIT, t = 0 })
			for _, bits in ipairs(ABILITY_BITS) do
				table.insert(list, { sx = fx, sz = fz, b = bits, t = 0 })
			end
		end
	end
	for index = 0, DIRECTIONS - 1 do
		local angle = index / DIRECTIONS * math.pi * 2
		local sx, sz = math.cos(angle), math.sin(angle)
		table.insert(list, { sx = sx, sz = sz, b = 0, t = 0 })
		if index % 2 == 0 then
			table.insert(list, { sx = sx, sz = sz, b = DASH_BIT, t = 0 })
		end
	end
	-- Moves aimed the way the bey is already heading.
	local speed = math.sqrt((bey.vx or 0) ^ 2 + (bey.vz or 0) ^ 2)
	local hx, hz = 0, 0
	if speed > 0.01 then
		hx, hz = bey.vx / speed, bey.vz / speed
	end
	for _, bits in ipairs(ABILITY_BITS) do
		table.insert(list, { sx = hx, sz = hz, b = bits, t = 0 })
	end
	return list
end

---Steer away from the closest rival (along the bowl, never out toward the rim) and drop attack
---presses, while our burst gauge is high and fuller than theirs. nil = keep fighting.
local DISENGAGE_AT = 0.55
local function disengageInput(sim, slot, bey, input)
	local mine = burstRatio(bey)
	if mine < DISENGAGE_AT - 0.15 then
		return nil
	end
	local _, foes = sidesOf(sim, slot)
	local target, best = nil, math.huge
	for _, foe in ipairs(foes) do
		if not foe.out then
			local dx, dz = (foe.x or 0) - (bey.x or 0), (foe.z or 0) - (bey.z or 0)
			local distance = dx * dx + dz * dz
			if distance < best then
				target, best = foe, distance
			end
		end
	end
	if not target then
		return nil
	end
	local theirs = burstRatio(target)
	local spinLead = (bey.spin or 0) - (target.spin or 0)
	-- With a spin lead, there's no reason to trade at all once the gauge is getting full.
	local threshold = spinLead > 0.03 and (DISENGAGE_AT - 0.15) or DISENGAGE_AT
	if mine < threshold or theirs >= mine then
		return nil
	end
	local distance = math.sqrt(best)
	if distance > 6 then
		return nil
	end
	local ax, az = (bey.x or 0) - (target.x or 0), (bey.z or 0) - (target.z or 0)
	local length = math.max(distance, 0.001)
	ax, az = ax / length, az / length
	-- Near the rim, slide around the bowl instead of backing out of it.
	local stadium = stadiumCache[sim.stadium]
	local radius = stadium and stadium.bowlRadius or 10
	local px, pz = bey.x or 0, bey.z or 0
	local reach = math.sqrt(px * px + pz * pz)
	if reach > radius * 0.6 and reach > 0.01 then
		local ox, oz = px / reach, pz / reach
		local outward = ax * ox + az * oz
		if outward > 0 then
			ax, az = ax - ox * outward * 1.4, az - oz * outward * 1.4
			local l2 = math.max(math.sqrt(ax * ax + az * az), 0.001)
			ax, az = ax / l2, az / l2
		end
	end
	local bits = bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT))
	return { sx = ax, sz = az, b = bits, t = 0 }
end

---Our burst gauge after holding `input` (dash/attack presses only on the first tick) for `ticks`.
local function burstAfterHold(sim, slot, input, ticks)
	local copy = BeyRivals.modelFoes(Sim.copy(sim), slot)
	copy.ai[slot] = nil
	local first = { sx = input.sx, sz = input.sz, b = input.b, t = 0 }
	local held = { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT)), t = 0 }
	for step = 1, ticks do
		Sim.step(copy, { [slot] = step == 1 and first or held })
		if copy.done then
			break
		end
	end
	local bey = copy.beys[slot]
	if bey.out then
		return (bey.burstMax or 1) * 2
	end
	return bey.burst or 0
end

local escapeVerdict = { tick = -math.huge, input = nil }

---Get out of a rival's ability while it is running. Ability waves can't be guarded (a guard only
---halves the knockback) and their damage falls off with distance; in the logged Stamina losses one
---wave took 33-35% of the gauge. Compared on copies: escaping vs. the line we'd otherwise take.
local function waveEscapeInput(sim, slot, bey, input)
	if sim.tick - escapeVerdict.tick < 6 then
		return escapeVerdict.input
	end
	escapeVerdict.tick, escapeVerdict.input = sim.tick, nil
	local _, foes = sidesOf(sim, slot)
	local stadium = stadiumCache[sim.stadium]
	for _, foe in ipairs(foes) do
		if not foe.out and (foe.ab or 0) ~= 0 then
			local dx, dz = (bey.x or 0) - (foe.x or 0), (bey.z or 0) - (foe.z or 0)
			local distance = math.sqrt(dx * dx + dz * dz)
			if distance < 8 then
				local ax, az = dx / math.max(distance, 0.001), dz / math.max(distance, 0.001)
				local px, pz = bey.x or 0, bey.z or 0
				local radius = stadium and stadium.bowlRadius or 10
				local fromCentre = math.sqrt(px * px + pz * pz)
				if fromCentre > radius * 0.6 and fromCentre > 0.01 then
					local ox, oz = px / fromCentre, pz / fromCentre
					local outward = ax * ox + az * oz
					if outward > 0 then
						ax, az = ax - ox * outward * 1.4, az - oz * outward * 1.4
						local l2 = math.max(math.sqrt(ax * ax + az * az), 0.001)
						ax, az = ax / l2, az / l2
					end
				end
				local bits = bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT))
				local escape = { sx = ax, sz = az, b = bit32.bor(bits, DASH_BIT), t = 0 }
				local burstMax = (bey.burstMax and bey.burstMax > 0) and bey.burstMax or 1
				local stay = burstAfterHold(sim, slot, input, 45)
				local run = burstAfterHold(sim, slot, escape, 45)
				if (stay - run) / burstMax > 0.08 then
					escapeVerdict.input = escape
					return escape
				end
			end
		end
	end
	return nil
end

---Pick the best plan for the next few ticks within the frame budget.
---@param sim table
---@param slot number
local function decide(sim, slot)
	local candidates = candidateList(sim.beys[slot], sim, slot)
	-- See further while a rival's ability is in flight: that is when we get knocked out.
	local danger = false
	local _, foes = sidesOf(sim, slot)
	for _, foe in ipairs(foes) do
		if not foe.out and ((foe.ab or 0) ~= 0 or (foe.awakeT or 0) > 0) then
			danger = true
		end
	end
	local budget = Config.LookaheadMs * ((danger or forceDanger) and 3 or 1)
	local horizon = math.clamp(math.floor(budget / (stepCost * #candidates)), 45, 240)
	local started = os.clock()

	local pilotScore = rollout(sim, slot, nil, horizon)
	local bestScore, best = pilotScore, nil
	for index = 2, #candidates do
		local score = rollout(sim, slot, candidates[index], horizon)
		if score > bestScore then
			bestScore, best = score, candidates[index]
		end
	end

	local elapsed = (os.clock() - started) * 1000
	stepCost = stepCost * 0.7 + (elapsed / (horizon * #candidates)) * 0.3

	-- Only override the AI when an option is clearly better.
	if best and bestScore - pilotScore < math.max(3 - Config.Aggression * 1.5, 0.5) then
		best = nil
	end
	plan = best
	lastBestScore = bestScore
	planFirst = true
	planUntil = sim.tick + PLAN_TICKS

	if bestScore >= 650 then
		status = "Winning line found"
	elseif bestScore <= -650 then
		status = "Defending"
	else
		status = bestScore >= 0 and "Ahead" or "Behind"
	end
end

local COUNTER_CHECK_TICKS = 60
local COUNTER_CHECK_EVERY = 4
local counterVerdict = { tick = -math.huge, safe = false }

---Compare countering now against holding off (both followed by the full-skill AI) on copies.
---@return boolean
local function counterIsSafe(sim, slot, input, window)
	if counterVerdict.window == window and sim.tick - counterVerdict.tick < COUNTER_CHECK_EVERY then
		return counterVerdict.safe
	end
	-- The counter lunges at the rival; the only reason to skip it is that the lunge rings us out.
	local withCounter = { sx = input.sx, sz = input.sz, b = bit32.bor(input.b, COUNTER_BIT), t = 0 }
	local with = rollout(sim, slot, withCounter, COUNTER_CHECK_TICKS)
	counterVerdict.tick = sim.tick
	counterVerdict.window = window
	counterVerdict.safe = with > -650
	return counterVerdict.safe
end

local ATTACK_BITS = bit32.bor(1, 32, 64, 8)
local attackVerdict = { key = nil, safe = true }

---Before starting a dash or move, compare the exact input we'll send against the same input
---without the new press; skip the press if it loses (e.g. dashing into a rival's perfect guard).
---@return table input, possibly with the new attack press removed
local function guardAttack(sim, slot, bey, input)
	local fresh = bit32.band(bit32.band(input.b, ATTACK_BITS), bit32.bnot(bey.prevB or 0))
	if fresh == 0 then
		return input
	end
	local key = tostring(sim.tick) .. ":" .. tostring(input.b)
	if attackVerdict.key ~= key then
		local quiet = { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bnot(fresh)), t = 0 }
		local with = rollout(sim, slot, input, COUNTER_CHECK_TICKS)
		local without = rollout(sim, slot, quiet, COUNTER_CHECK_TICKS)
		attackVerdict.key = key
		attackVerdict.safe = with > -650 and with >= without - 2 - Config.Aggression * 8
	end
	if attackVerdict.safe then
		return input
	end
	status = "Held back"
	return { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bnot(fresh)), t = 0 }
end

-- ============================================================
--  Timed presses: rip rings, clash notes, rim saves
-- ============================================================

---Rip presses land exactly on each ring (ticks 42, 84, 126) and the rip (168).
---@param nextTick number
---@return number
function ripBits(nextTick)
	if not Config.PerfectRip then
		return 0
	end
	local offset = nextTick - RIP_FIRST
	if offset >= 0 and offset % RIP_BEAT == 0 and offset / RIP_BEAT <= 3 then
		local bits = RIP_PRESS
		if offset / RIP_BEAT == 3 and Config.TiltLaunch then
			bits = bit32.bor(bits, BRACE_BIT)
		end
		return bits
	end
	return 0
end

---Press on the exact tick of the next ungraded clash note.
function clashBits(sim, bey, nextTick)
	for index = 1, CLASH_NOTES do
		if Sim.clashGrade(bey, index) == 0 then
			local note = Sim.clashNote(sim, index)
			return note == nextTick and CLASH_BIT or 0
		end
	end
	return 0
end

---@param sim table
---@param slot number
---@return boolean
function inClash(sim, slot)
	return sim.clash > 0 and (sim.clashA == slot or sim.clashB == slot or sim.clashAsA == slot or sim.clashAsB == slot)
end

---Ticks until our bey next makes contact (body clash or an ability/counter hit), or nil.
---Runs the opponent's own AI forward on a copy with our input held.
---@param sim table
---@param slot number
---@param input table
---@return number?
local function ticksToContact(sim, slot, input)
	local copy = BeyRivals.modelFoes(Sim.copy(sim), slot)
	copy.ai[slot] = nil
	local held = { [slot] = { sx = input.sx, sz = input.sz, b = bit32.band(input.b, bit32.bnot(BRACE_BIT)), t = 0 } }
	for step = 1, GUARD_LOOKAHEAD do
		Sim.step(copy, held)
		for _, event in ipairs(copy.events) do
			local kind = event.kind
			if kind == "Clash" and (event.a == slot or event.b == slot) then
				return step, kind
			elseif (kind == "AbilityHit" or kind == "CounterAttack") and (event.target == slot or event.slot == slot) then
				return step, kind
			end
		end
		if copy.done then
			return nil
		end
	end
	return nil
end

---Our burst gauge a few ticks after the predicted contact, with or without bracing now.
---@return number
function burstAfterContact(sim, slot, input, contact, brace)
	local copy = BeyRivals.modelFoes(Sim.copy(sim), slot)
	copy.ai[slot] = nil
	local bits = bit32.band(input.b, bit32.bnot(BRACE_BIT))
	for step = 1, contact + 4 do
		local b = (brace and step == 1) and bit32.bor(bits, BRACE_BIT) or bits
		Sim.step(copy, { [slot] = { sx = input.sx, sz = input.sz, b = b, t = 0 } })
		if copy.done then
			break
		end
	end
	local bey = copy.beys[slot]
	if bey.out then
		return (bey.burstMax or 1) * 2
	end
	return bey.burst or 0
end

---Brace control: tap right before contact for a perfect guard (or a harder hit); never waste charges.
---@return number brace bits to OR into the input
local function guardBits(sim, slot, bey, input)
	if (bey.guardN or 0) <= 0 or (bey.gbT or 0) > 0 or (bey.braceT or 99) < GUARD_WINDOW then
		return 0
	end
	-- A fresh edge is needed; if last tick held Brace, release this tick.
	if bit32.band(bey.prevB or 0, BRACE_BIT) ~= 0 then
		return 0
	end
	local contact, kind = ticksToContact(sim, slot, input)
	if not (contact and contact <= GUARD_PRESS_LEAD) then
		return 0
	end
	-- Attack types hold a single guard charge. Spend it on a clash only when that clash hurts:
	-- in the logged losses one unguarded clash took 35-50% of our burst gauge and burst us.
	if kind == "Clash" and bey.typ == "Attack" then
		local open = burstAfterContact(sim, slot, input, contact, false)
		local braced = burstAfterContact(sim, slot, input, contact, true)
		local burstMax = (bey.burstMax and bey.burstMax > 0) and bey.burstMax or 1
		local now = bey.burst or 0
		local gain = (open - now) / burstMax
		local saved = (open - braced) / burstMax
		if open >= burstMax * 0.98 or (now + (open - now)) / burstMax > 0.7 or gain > 0.12 or saved > 0.08 then
			return BRACE_BIT
		end
		return 0
	end
	return BRACE_BIT
end

---Counter attack: the window opens after a perfect guard (caT > 0); the game's AI only takes it ~40% of the time.
---@param bey table
---@return boolean? true = press, false = release (so the next press is a fresh edge), nil = not our concern
function counterPress(bey)
	if (bey.caT or 0) <= 0 then
		return nil
	end
	local canAct = (bey.down or 0) <= 0 and (bey.heldT or 0) <= 0 and (bey.air or 0) <= 0
	if not canAct then
		return false
	end
	return bit32.band(bey.prevB or 0, COUNTER_BIT) == 0
end

---Read rip grades from the last step's events for the stats tab.
local function recordEvents(sim, slot)
	for _, event in ipairs(sim.events) do
		if event.kind == "Guard" and event.slot == slot then
			Stats.guards = Stats.guards + 1
		elseif event.kind == "CounterAttack" and event.stage == "go" and event.slot == slot then
			Stats.counters = Stats.counters + 1
		end
		if event.kind == "Rip" and event.slot == slot then
			Stats.rips = Stats.rips + 1
			if event.grade == "Perfect" then
				Stats.perfectRips = Stats.perfectRips + 1
			end
		end
	end
end

-- ============================================================
--  Input hook: replaces BattleInput.sample while auto battle is on
-- ============================================================

local originalSample = BattleInput.sample

---Build this tick's input for our bey.
---@param battle table
---@return table?
local function autoInput(battle)
	local round = battle.round
	local sim = round and round.sim
	-- Log first, so the final ticks of a round (including the ones where we go out) are kept.
	if sim and sim.beys and logTick and round.phase == "Battle" then
		pcall(logTick, battle, sim, battle.mySlot)
	end
	if not sim or battle.watch or round.phase ~= "Battle" or sim.done then
		return nil
	end
	local slot = battle.mySlot
	local bey = sim.beys[slot]
	if not bey or bey.out then
		return nil
	end

	recordEvents(sim, slot)

	-- A new battle or round gets a fresh pilot.
	if pilotToken ~= battle.token or not pilot then
		pilot, pilotToken, plan = freshPilot(), battle.token, nil
	end

	local nextTick = sim.tick + 1

	if not bey.launched then
		status = bey.ripTick == 0 and "Ripping" or "Launching"
		return { sx = 0, sz = 0, b = bey.ripTick == 0 and ripBits(nextTick) or 0, t = 0 }
	end

	local input = pilotInput(sim, slot)

	if Config.PerfectClash and inClash(sim, slot) then
		status = "Clash"
		input.b = bit32.bor(bit32.band(input.b, bit32.bnot(CLASH_BIT)), clashBits(sim, bey, nextTick))
		return input
	end

	-- Rim hops only exist when the game enables them.
	if Tuning.RIM_ON and (bey.rimT or 0) > 0 then
		status = "Rim save"
		input.b = (bey.rimT + 1 == RIM_CALL) and RIP_PRESS or 0
		return input
	end

	-- We own the Brace bit: strip the AI's guesses and tap only before predicted contact.
	if Config.AutoGuard then
		input.b = bit32.band(input.b, bit32.bnot(BRACE_BIT))
		local brace = guardBits(sim, slot, bey, input)
		if brace ~= 0 then
			status = "Guard"
			input.b = bit32.bor(input.b, brace)
		end
	end

	-- Take counter windows the moment they are legal, unless the lunge would cost us (e.g. off the edge).
	if Config.AutoCounter then
		local press = counterPress(bey)
		if (bey.caT or 0) > 0 then
			if not counterWindow or counterWindow.token ~= battle.token or sim.tick - counterWindow.lastTick > 2 then
				counterWindow = { token = battle.token, start = sim.tick, lastTick = sim.tick, outcome = "open", vetoes = 0 }
				table.insert(CounterLog, counterWindow)
				if #CounterLog > 20 then
					table.remove(CounterLog, 1)
				end
			end
			counterWindow.lastTick = sim.tick
		end
		if press == true then
			if counterIsSafe(sim, slot, input, counterWindow.start) then
				status = "Counter!"
				counterWindow.outcome = "pressed"
				input.b = bit32.bor(input.b, COUNTER_BIT)
				return input
			end
			counterWindow.vetoes = counterWindow.vetoes + 1
			counterWindow.outcome = "skipped (would ring us out)"
			input.b = bit32.band(input.b, bit32.bnot(COUNTER_BIT))
		elseif press == false then
			if counterWindow.outcome == "open" then
				counterWindow.outcome = "waiting (stunned/airborne)"
			end
			input.b = bit32.band(input.b, bit32.bnot(COUNTER_BIT))
		end
	end

	if Config.Lookahead then
		-- Reflex: an ability/counter hit is coming and the guard can't take it: re-plan right now.
		local guardReady = (bey.guardN or 0) > 0 and (bey.gbT or 0) <= 0
		if not guardReady and sim.tick < planUntil and sim.tick >= reflexAfter then
			local contact, kind = ticksToContact(sim, slot, input)
			-- Re-plan for incoming ability hits, and for any contact once our gauge is past 45%
			-- (a single clash took 25-35% of the gauge in the logged losses).
			if contact and (kind ~= "Clash" or burstRatio(bey) > 0.45) then
				planUntil = sim.tick
				reflexAfter = sim.tick + PLAN_TICKS
				forceDanger = true
			end
		end
		if sim.tick >= planUntil then
			decide(sim, slot)
			forceDanger = false
		end
		-- No better line than the game's own AI: that AI keeps charging even deep in the crush zone
		-- (the logged Stamina loss: a Rush at 79% gauge). When our gauge is the fuller one, stay off them.
		if lastBestScore < 650 then
			local escape = waveEscapeInput(sim, slot, bey, input)
			if escape then
				status = "Dodging wave"
				return escape
			end
		end
		if not plan and lastBestScore < 650 then
			local away = disengageInput(sim, slot, bey, input)
			if away then
				status = "Keeping away"
				return away
			end
		end
		if plan then
			-- Take the planned line; its button press goes out once, plus our guard/counter bits.
			local bits = bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT))
			if planFirst then
				bits = bit32.bor(bits, plan.b)
				planFirst = false
			end
			return BeyRivals.ridgeSafe(sim, slot, bey, guardAttack(sim, slot, bey, { sx = plan.sx, sz = plan.sz, b = bits, t = 0 }))
		end
	else
		status = "Fighting"
	end

	return BeyRivals.ridgeSafe(sim, slot, bey, guardAttack(sim, slot, bey, input))
end

---Never rush off the ridge into a rival while our gauge is high and at least as full as theirs:
---the rush exit is predictable, and a smash into it took 1.2-1.6 burst (100%) in both 11-05 losses.
function BeyRivals.ridgeSafe(sim, slot, bey, input)
	if not (Config.SafeRidge and bey.onRidge) then
		return input
	end
	local mine = burstRatio(bey)
	if mine < 0.55 then
		return input
	end
	local _, foes = sidesOf(sim, slot)
	local theirs = 0
	for _, foe in ipairs(foes) do
		if not foe.out then
			theirs = math.max(theirs, burstRatio(foe))
		end
	end
	if theirs > mine + 0.1 then
		return input
	end
	local px, pz = bey.x or 0, bey.z or 0
	local r = math.sqrt(px * px + pz * pz)
	local length = math.sqrt(input.sx * input.sx + input.sz * input.sz)
	if r < 0.01 or length < 0.01 then
		return input
	end
	local inward = (input.sx * -px + input.sz * -pz) / (r * length)
	if inward <= (Tuning.RUSH_DOT or 0.3) - 0.1 then
		return input
	end
	-- Keep riding around the bowl instead (tangent in the direction we're already going).
	local tx, tz = -pz / r, px / r
	if (bey.vx or 0) * tx + (bey.vz or 0) * tz < 0 then
		tx, tz = -tx, -tz
	end
	status = "Safe ridge"
	return { sx = tx, sz = tz, b = bit32.band(input.b, bit32.bor(BRACE_BIT, COUNTER_BIT)), t = 0 }
end

local function sampleHook(origin, ...)
	if Config.AutoBattle then
		local battle = currentBattle()
		if battle then
			local ok, input = pcall(autoInput, battle)
			if ok and input then
				return input
			elseif not ok then
				warn("[Bey Rivals] " .. tostring(input))
			end
		end
	end
	return originalSample(origin, ...)
end

BattleInput.sample = sampleHook

-- Aim assist would bend the AI's steering toward the locked rival.
local hadAimAssist = localPlayer:GetAttribute("AimAssist")
local function syncAimAssist()
	if Config.AutoBattle then
		localPlayer:SetAttribute("AimAssist", false)
	else
		localPlayer:SetAttribute("AimAssist", hadAimAssist)
	for _, packet in pairs(hookedPackets) do
		rawset(packet, "Fire", nil)
	end
	if originalShow and RivalsResults.show ~= originalShow then
		RivalsResults.show = originalShow
	end
	end
end

-- ============================================================
--  Launch: simulate a grid of launch spots, lock in the best one
-- ============================================================

---Candidate (angle, distance) pairs, coarse grid first so a cut-off search still spreads out.
---@param defaultAngle number
---@return table
local function launchCandidates(defaultAngle)
	local list = { { a = defaultAngle, d = 0.55, default = true } }
	for pass = 0, 1 do
		for _, distance in ipairs(LAUNCH_DISTANCES) do
			for index = pass, LAUNCH_ANGLES - 1, 2 do
				table.insert(list, { a = index / LAUNCH_ANGLES * math.pi * 2, d = distance })
			end
		end
	end
	return list
end

---Play a round from this launch spot (both sides on the game's AI) and score it.
---@param sim table
---@param slot number
---@param candidate table
---@param foeOffset number rival angle offset from its stance
---@return number
local function scoreLaunchOnce(sim, slot, candidate, foeOffset)
	local copy = Sim.copy(sim)
	local count = #copy.beys
	for index, bey in ipairs(copy.beys) do
		if index == slot then
			Sim.setAim(copy, index, candidate.a, candidate.d, "Power")
		elseif (bey.aimS or 0) == 0 then
			-- Rival aim is unknown until both lock in: model the AI's habit.
			local stand = Stadiums and Stadiums.standAngle(index, count) or 0
			Sim.setAim(copy, index, stand + foeOffset, FOE_LAUNCH_D, "Power")
		end
		if not copy.ai[index] then
			copy.ai[index] = freshPilot()
		end
	end
	copy.ai[slot] = nil
	local clone = freshPilot()
	for _ = 1, LAUNCH_HORIZON do
		if copy.done then
			break
		end
		stepAsPlayer(copy, slot, clone)
	end
	return scoreOf(copy, slot)
end

local launchFrameStart = os.clock()

---Average a launch spot over the rival's likely angles, so the pick is robust to its randomness.
local function scoreLaunch(sim, slot, candidate)
	local total = 0
	for _, offset in ipairs(FOE_ANGLE_SPREAD) do
		total = total + scoreLaunchOnce(sim, slot, candidate, offset)
		-- Yield between test rounds so planning never stalls a frame for long.
		if (os.clock() - launchFrameStart) * 1000 > LAUNCH_FRAME_MS then
			task.wait()
			launchFrameStart = os.clock()
		end
	end
	return total / #FOE_ANGLE_SPREAD
end

---Search launch spots across frames, then lock in through the game's own launch handler.
---@param battle table
local function planAndLaunch(battle)
	local round = battle.round
	local slot = battle.mySlot
	local radius = battle.stadium and battle.stadium.bowlRadius or 1
	local defaultAim = battle.aim
	local defaultAngle = typeof(defaultAim) == "Vector2" and math.atan2(defaultAim.Y, defaultAim.X) or 0

	local best = { a = defaultAngle, d = 0.55 }
	if Config.PlanLaunch then
		status = "Planning launch"
		local candidates = launchCandidates(defaultAngle)
		local deadline = os.clock() + LAUNCH_PLAN_TIME
		launchFrameStart = os.clock()
		local bestScore, tried = -math.huge, 0

		for _, candidate in ipairs(candidates) do
			if os.clock() > deadline or currentBattle() ~= battle or battle.ready or round.phase ~= "Launch" then
				break
			end
			local ok, score = pcall(scoreLaunch, round.sim, slot, candidate)
			tried = tried + 1
			-- Prefer the default spot on ties so we only move for a real gain.
			if ok and (score > bestScore + (candidate.default and 0 or 0.5)) then
				bestScore, best = score, candidate
			end
			if (os.clock() - launchFrameStart) * 1000 > LAUNCH_FRAME_MS then
				task.wait()
				launchFrameStart = os.clock()
			end
		end
		status = string.format("Launch picked (%d spots)", tried)
	end

	if currentBattle() ~= battle or battle.ready or round.phase ~= "Launch" then
		return
	end
	-- Set the aim and lock in on the same frame, before the mouse can move it.
	battle.aim = Vector2.new(math.cos(best.a), math.sin(best.a)) * math.clamp(best.d, 0.1, 0.85) * radius

	-- Run the game's handler at game-script identity: its HUD toasts lazily require
	-- game modules, which errors at executor identity and aborts before the launch is sent.
	setthreadidentity(2)
	local ok, err = pcall(onLaunchAction, "BeyLaunch", Enum.UserInputState.Begin, nil)
	setthreadidentity(8)
	if not ok then
		warn("[Bey Rivals] Launch handler error: " .. tostring(err))
	end
end

-- Start planning when a launch phase opens.
table.insert(BeyRivals.connections, runService.Heartbeat:Connect(function()
	syncAimAssist()
	local battle = currentBattle()
	if battle then
		lastBattle = battle
	end
	if not (Config.AutoBattle and Config.AutoLaunch and battle and battle.round) then
		return
	end
	if battle.watch or battle.round.phase ~= "Launch" or battle.ready then
		return
	end

	local key = tostring(battle.token) .. ":" .. tostring(battle.round.no)
	if launchedRound == key then
		return
	end
	launchedRound = key
	task.spawn(planAndLaunch, battle)
end))

---Did our side win the battle that just ended?
local function weWon(battle)
	local winner = battle and battle.winner
	if type(winner) ~= "number" then
		return nil
	end
	if winner == battle.mySlot then
		return true
	end
	local sim = battle.round and battle.round.sim
	local mine = sim and sim.beys[battle.mySlot]
	local theirs = sim and sim.beys[winner]
	if mine and theirs and mine.team ~= nil then
		return mine.team == theirs.team
	end
	return false
end

---True once a battle other than the one that just ended is running.
---@param endedToken any
local function inNewBattle(endedToken)
	local battle = currentBattle()
	return battle ~= nil and battle.token ~= endedToken and not battle.over
end

