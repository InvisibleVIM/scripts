-- Watch the join packets so we know how to get back in: modes (story, raids, KOTH, trainers...),
-- ranked queue and the Halloween boss fight.
local hookedPackets = {}
if Packets then
	for _, name in ipairs({ "ModePlay", "RankedQueue", "HalloweenAct" }) do
		local packet = Packets[name]
		if type(packet) == "table" and rawget(packet, "Fire") == nil then
			local original = packet.Fire
			rawset(packet, "Fire", function(self, ...)
				local args = { ... }
				local results = table.pack(original(self, ...))
				local remember = results[1] == true
				if name == "HalloweenAct" and args[1] ~= "fight" then
					remember = false
				end
				if name == "RankedQueue" and args[1] == "lobby" then
					remember = false
				end
				if remember then
					rememberJoin(name, args)
				end
				return table.unpack(results, 1, results.n)
			end)
			hookedPackets[name] = packet
		end
	end
end

