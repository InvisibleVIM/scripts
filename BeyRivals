-- Ranked arena: the spot pick and ready check arrive right after the teleport, long before the game
-- finishes loading. Hook RankedState first thing, buffer every message, and let the handler (defined
-- later) catch up on the latest one.
BeyRivals.rankedBuffer = {}
task.spawn(function()
	for _ = 1, 600 do
		local packets = nil
		pcall(function()
			packets = filtergc("table", { Keys = { "ArenaAgain", "BattleLaunch", "BattleSwap" } }, true)
		end)
		local packet = packets and packets.RankedState
		if packet and packet.OnClientEvent then
			table.insert(BeyRivals.connections, packet.OnClientEvent:Connect(function(raw)
				table.insert(BeyRivals.rankedBuffer, raw)
				if #BeyRivals.rankedBuffer > 40 then
					table.remove(BeyRivals.rankedBuffer, 1)
				end
				pcall(function()
					local line = os.date("%H:%M:%S") .. " " .. (type(raw) == "string" and raw or tostring(raw))
					local path = "BeyRivals/ranked_log.txt"
					if isfile(path) and #readfile(path) < 200000 then
						appendfile(path, line:sub(1, 1500) .. "\n")
					else
						writefile(path, line:sub(1, 1500) .. "\n")
					end
				end)
				if BeyRivals.onRankedState then
					pcall(BeyRivals.onRankedState, raw)
				end
			end))
			BeyRivals.rankedHooked = true
			return
		end
		task.wait(0.1)
	end
end)

