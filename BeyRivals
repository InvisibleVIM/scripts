---Did our side win the battle that just ended?
local function weWon(battle)
	local winner = battle and battle.winner
	if type(winner) ~= "number" then
		return nil
	end
	if winner == battle.mySlot then
		return true
	end
	local sim = battle.round and battle.round.sim
	local mine = sim and sim.beys[battle.mySlot]
	local theirs = sim and sim.beys[winner]
	if mine and theirs and mine.team ~= nil then
		return mine.team == theirs.team
	end
	return false
end

---True once a battle other than the one that just ended is running.
---@param endedToken any
local function inNewBattle(endedToken)
	local battle = currentBattle()
	return battle ~= nil and battle.token ~= endedToken and not battle.over
end

---Ask the server for the next battle and keep at it until a *new* one starts.
---The finished battle stays registered while its results/replay play, so we compare battle ids.
local queueRun = 0
local queuedToken = nil
local function joinNextBattle(endedToken)
	if not Packets then
		return
	end
	queueRun = queueRun + 1
	local run = queueRun
	local mode = Config.QueueMode == "Rematch" and "rematch" or "queue"
	local giveUp = os.clock() + QUEUE_GIVE_UP

	while os.clock() < giveUp and run == queueRun and Config.AutoQueue do
		if inNewBattle(endedToken) then
			return
		end
		setthreadidentity(2)
		local ok, accepted, reason = pcall(function()
			return Packets.ArenaAgain:Fire(mode)
		end)
		setthreadidentity(8)

		if ok and accepted == true then
			-- We're in matchmaking now. Re-asking would not help (and the play-again window
			-- closes meanwhile), so just wait for the match however long it takes.
			status = mode == "queue" and "In queue, waiting for a match" or "Rematch requested"
			repeat
				task.wait(0.5)
			until inNewBattle(endedToken) or run ~= queueRun or not Config.AutoQueue
			return
		else
			if ok and type(reason) == "string" and reason ~= "" then
				status = reason
			end
			task.wait(QUEUE_RETRY_EVERY)
		end
	end
	if run == queueRun and not inNewBattle(endedToken) then
		status = "Couldn't join the next battle"
	end
end

---Start requeuing once per finished battle, as early as the server marks it over.
local function queueAfter(battle)
	if not (Config.AutoQueue and battle) or battle.watch or queuedToken == battle.token then
		return
	end
	queuedToken = battle.token
	task.spawn(joinNextBattle, battle.token)
end

