	local function currentTheme()
		local theme = {}
		for _, entry in ipairs(THEME) do
			theme[entry.key] = Config[entry.key]
		end
		return theme
	end
	local function useTheme(theme)
		for _, entry in ipairs(THEME) do
			local value = theme[entry.key]
			if type(value) == "string" and pcall(Color3.fromHex, value) then
				Config[entry.key] = value:upper()
			end
		end
		UI.applyTheme()
	end
	UI.useTheme = useTheme
	local function ensureFolder()
		pcall(function()
			if not isfolder("PotentHub") then
				makefolder("PotentHub")
			end
			if not isfolder(THEME_FOLDER) then
				makefolder(THEME_FOLDER)
			end
		end)
	end
	local function customThemes()
		local names = {}
		pcall(function()
			for _, path in ipairs(listfiles(THEME_FOLDER)) do
				local name = tostring(path):match("([^/\\]+)%.json$")
				if name then
					table.insert(names, name)
				end
			end
		end)
		table.sort(names)
		return names
	end
	function UI.themeSection(page)
		UI.heading(page, "Presets", "full", "Click one to wear it.")
		UI.themeGrid(page)
		UI.heading(page, "Your own colors", "left", "Click a swatch to change it.")
		UI.colorRow(page, "Window", "ThemeBackground")
		UI.colorRow(page, "Cards", "ThemeMain")
		UI.colorRow(page, "Accent", "ThemeAccent")
		UI.colorRow(page, "Lines", "ThemeOutline")
		UI.colorRow(page, "Text", "ThemeFont")
		UI.button(page, "Use these colors in every Potent script", function()
			ensureFolder()
			writefile(DEFAULT_FILE, httpService:JSONEncode(currentTheme()))
			Config.UseDefaultTheme = true
			return "Saved as the default"
		end)
		UI.button(page, "Back to the first preset", function()
			local preset = UI.PRESETS[1]
			Config.ThemeName = preset[1]
			Config.UseDefaultTheme = false
			useTheme({ ThemeBackground = preset[2], ThemeMain = preset[3], ThemeAccent = preset[4], ThemeOutline = preset[5], ThemeFont = preset[6] })
			return "Done"
		end)
		UI.heading(page, "Saved themes", "right", "Kept in PotentHub/themes and shared by every Potent script.")
		local nameBox = UI.textbox(page, "Name", "Name this theme")
		local selected = nil
		UI.dropdown(page, "Saved", customThemes, function()
			return selected or "None picked"
		end, function(name)
			selected = name
			nameBox.Text = name
		end)
		UI.buttonPair(page, "Save", function()
			local name = (nameBox.Text:gsub("[^%w%s%-_]", "")):sub(1, 30)
			if name == "" then
				return "Name it first"
			end
			ensureFolder()
			writefile(THEME_FOLDER .. "/" .. name .. ".json", httpService:JSONEncode(currentTheme()))
			selected = name
			return "Saved"
		end, "Load", function()
			local name = selected or nameBox.Text
			local path = THEME_FOLDER .. "/" .. name .. ".json"
			if name == "" or not isfile(path) then
				return "Pick a theme"
			end
			Config.ThemeName = name
			Config.UseDefaultTheme = false
			useTheme(httpService:JSONDecode(readfile(path)))
			return "Loaded"
		end)
		UI.heading(page, "Typeface", "right")
		UI.segmented(page, "Menu typeface", "MenuFont", { "Own", "Roblox" }, "Own is the same on every client. Roblox uses whatever your client renders, a Fishstrap font included. Applies the next time the script loads.", { Own = "The menu's own", Roblox = "Roblox's" })
		local using = UI.note(page, "")
		using.Text = Type.own and ("Showing " .. Type.name .. ", fetched from Roblox by asset id. Fishstrap's font swap doesn't reach it.")
			or (Config.MenuFont == "Roblox" and "Showing your client's font. Text is sized down to fit where it runs wider."
				or "The menu's own typeface could not be fetched, so this is your client's font, sized down to fit. It is tried again on the next load.")
	end

