		cachedData, cachedAt = filtergc("table", { Keys = { "Items", "Tokens" } }, true), os.clock()
		return cachedData
	end

	local function fire(name, ...)
		local packet = Packets and Packets[name]
		if not packet then
			return false, "missing " .. name
		end
		local args = table.pack(...)
		setthreadidentity(2)
		local results = table.pack(pcall(function()
			return packet:Fire(table.unpack(args, 1, args.n))
		end))
		setthreadidentity(8)
		if not results[1] then
			return false, tostring(results[2])
		end
		return results[2] == true, results[3], results[4]
	end

	local function decode(text)
		local ok, value = pcall(httpService.JSONDecode, httpService, tostring(text or ""))
		return ok and value or nil
	end

	local rollers = {}
	stopAllRollers = function()
		for _, roller in ipairs(rollers) do
			roller.running = false
		end
	end

	---A start/stop button with a status line; `step(roller)` runs once per roll and returns
	---false (with roller.status set) to stop.
	local function roller(page, label, step)
		local state = { running = false, status = "Idle", count = 0 }
		table.insert(rollers, state)
		local row = rowBase(page, 38, true)
		local text = create("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			FontFace = BODY_BOLD,
			Text = "Start " .. label,
			TextColor3 = GOLD,
			TextSize = 15,
			Parent = row,
		})
		local statusLine = create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			FontFace = BODY_FONT,
			Text = state.status,
			TextColor3 = MUTED,
			TextSize = 13,
			TextWrapped = true,
			LayoutOrder = nextOrder(),
			Parent = page,
		})
		row.MouseButton1Click:Connect(function()
			if state.running then
				state.running = false
				state.status = string.format("Stopped after %d", state.count)
				return
			end
			state.running, state.count = true, 0
			state.status = "Starting..."
			task.spawn(function()
				while state.running do
					local ok, keepGoing = pcall(step, state)
					if not ok then
						state.status = "Error: " .. tostring(keepGoing)
						break
					end
					if not keepGoing then
						break
					end
					task.wait(ROLL_GAP)
				end
				state.running = false
			end)
		end)
		table.insert(BeyRivals.connections, runService.Heartbeat:Connect(function()
			text.Text = (state.running and "Stop " or "Start ") .. label
			statusLine.Text = state.status
		end))
		return state
	end

	local rollsPage = makePage("Rolls")

	-- Halloween soul draw.
	if Halloween and Halloween.POOL then
		heading(rollsPage, "Halloween soul draw")
		segmented(rollsPage, "Draw size", "DrawSize", { "x1", "x10" })
		slider(rollsPage, "Keep at least (tickets)", "DrawKeep", 0, 1500, 10, function(v) return tostring(v) end)
		slider(rollsPage, "Stop after (0 = no limit)", "DrawMax", 0, 300, 5, function(v) return v == 0 and "No limit" or (v .. " draws") end)
		hint(rollsPage, "Stops early when any ticked prize drops:")
		for _, prize in ipairs(Halloween.POOL) do
			if prize.rarity == "Epic" or prize.rarity == "Legendary" or prize.rarity == "Divine" then
				toggle(rollsPage, string.format("%s  (%s)", prize.name, prize.rarity), "DrawWant_" .. prize.id)
			end
		end
		roller(rollsPage, "soul draw", function(state)
			local save = data() and data().Event and data().Event[Halloween.SAVE]
			local tickets = type(save) == "table" and tonumber(save.t) or 0
			local size = Config.DrawSize == "x10" and 10 or 1
			if tickets - size < Config.DrawKeep then
				state.status = string.format("Done: %d tickets left (keeping %d). %d draws.", tickets, Config.DrawKeep, state.count)
				return false
			end
			if Config.DrawMax > 0 and state.count >= Config.DrawMax then
				state.status = string.format("Stopped at the %d draw limit", state.count)
				return false
			end
			local accepted, message, payload = fire("HalloweenAct", "draw", tostring(size))
			if not accepted then
				state.status = "Stopped: " .. tostring(message ~= "" and message or "draw refused")
				return false
			end
			state.count = state.count + size
			cachedAt = 0
			local result = decode(payload)
			local got = {}
			for _, row in ipairs(type(result) == "table" and result.rows or {}) do
				local id = type(row) == "table" and (row.id or row.prize) or row
				local prize = Halloween.prize and Halloween.prize(id)
				local name = type(prize) == "table" and prize.name or tostring(id)
				if Config["DrawWant_" .. tostring(id)] then
					state.status = string.format("Got %s after %d draws!", name, state.count)
					return false
				end
				table.insert(got, name)
			end
			state.status = string.format("%d draws, %d tickets left. Last: %s", state.count, tickets - size, table.concat(got, ", "):sub(1, 90))
			return true
		end)
	end

	-- Summons.
	heading(rollsPage, "Summons")
	segmented(rollsPage, "Pull size", "PullSize", { "x1", "x10" })
	segmented(rollsPage, "Stop at", "PullStop", { "Legendary", "Mythic", "Divine" })
	toggle(rollsPage, "Use summon tickets when I have them", "PullTickets")
	slider(rollsPage, "Stop after (0 = no limit)", "PullMax", 0, 500, 10, function(v) return v == 0 and "No limit" or (v .. " pulls") end)
	roller(rollsPage, "summons", function(state)
		if Config.PullMax > 0 and state.count >= Config.PullMax then
			state.status = string.format("Stopped at the %d pull limit", state.count)
			return false
		end
		local size = Config.PullSize == "x10" and 10 or 1
		local tickets = tonumber(data() and data().Tickets) or 0
		local accepted, message, payload = fire("RivalsPull", "std", size, Config.PullTickets and tickets >= size)
		if not accepted then
			state.status = "Stopped: " .. tostring(message ~= "" and message or "pull refused")
			return false
		end
		state.count = state.count + size
		cachedAt = 0
		local want = rarityRank(PART_RARITY, Config.PullStop)
		local best, bestRank = nil, 0
		for _, entry in ipairs(decode(payload) or {}) do
			if type(entry) == "table" then
				local rarity = entry.rarity or (Catalog and Catalog.RARITY and Catalog.RARITY[entry.kind] and Catalog.RARITY[entry.kind][entry.id])
				local rank = rarityRank(PART_RARITY, rarity)
				if rank > bestRank then
					best, bestRank = string.format("%s %s (%s)", tostring(rarity), tostring(entry.id), tostring(entry.kind)), rank
				end
			end
		end
		if bestRank >= want then
			state.status = string.format("Got %s after %d pulls!", best, state.count)
			return false
		end
		state.status = string.format("%d pulls. Best last pull: %s", state.count, tostring(best))
		return true
	end)

	-- Surnames.
	if Names then
		heading(rollsPage, "Surnames")
		segmented(rollsPage, "Stop at", "NameStop", { "Epic", "Legendary", "Mythic" })
		toggle(rollsPage, "Use lucky spins", "NameLucky")
		slider(rollsPage, "Stop after (0 = no limit)", "NameMax", 0, 300, 5, function(v) return v == 0 and "No limit" or (v .. " spins") end)
		hint(rollsPage, "Each spin replaces the surname in your active slot")
		roller(rollsPage, "surname spins", function(state)
			local nameData = data() and data().Name
			local want = Names.rarity(Config.NameStop)
			local wantOrder = type(want) == "table" and want.order or 5
			local current = type(nameData) == "table" and nameData.id ~= "" and Names.get(nameData.id)
			if state.count == 0 and current and Names.rarity(current.rarity).order >= wantOrder then
				state.status = string.format("Your active surname %s is already %s. Switch to an empty slot first.", Names.display(current.id), current.rarity)
				return false
			end
			if Config.NameMax > 0 and state.count >= Config.NameMax then
				state.status = string.format("Stopped at the %d spin limit", state.count)
				return false
			end
			local lucky = Config.NameLucky and type(nameData) == "table" and (nameData.lucky or 0) > 0
			local accepted, message, payload = fire("RivalsNameRoll", lucky == true)
			if not accepted then
				state.status = "Stopped: " .. tostring(message ~= "" and message or "spin refused")
				return false
			end
			state.count = state.count + 1
			cachedAt = 0
			local result = decode(payload)
			local rolled = type(result) == "table" and Names.get(result.id)
			if rolled then
				local order = Names.rarity(rolled.rarity).order
				if order >= wantOrder then
					state.status = string.format("Got %s (%s) after %d spins!", Names.display(rolled.id), rolled.rarity, state.count)
					return false
				end
				state.status = string.format("%d spins. Last: %s (%s)", state.count, Names.display(rolled.id), rolled.rarity)
			else
				state.status = string.format("%d spins", state.count)
			end
			return true
		end)
	end

	-- Freebies.
	heading(rollsPage, "Free stuff")
	local freeState = { status = "Claims the daily gift, level rewards, premium rewards and the Halloween treat" }
	local freeRow = rowBase(rollsPage, 38, true)
	create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = BODY_BOLD,
		Text = "Claim everything free",
		TextColor3 = GOLD,
		TextSize = 15,
		Parent = freeRow,
	})
	local freeLine = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		FontFace = BODY_FONT,
		Text = freeState.status,
		TextColor3 = MUTED,
		TextSize = 13,
		TextWrapped = true,
		LayoutOrder = nextOrder(),
		Parent = rollsPage,
	})
	freeRow.MouseButton1Click:Connect(function()
		task.spawn(function()
			local lines = {}
			local function try(label, name, ...)
				local accepted, message = fire(name, ...)
				table.insert(lines, label .. ": " .. (accepted and "claimed" or tostring(message ~= "" and message or "nothing")))
				freeLine.Text = table.concat(lines, "  |  ")
				task.wait(0.5)
			end
			try("Gift", "RivalsGift")
			try("Levels", "RivalsClaim", "levels", "")
			try("Premium", "RivalsClaim", "premiums", "")
			if Halloween then
				try("Treat", "HalloweenAct", "treat", "")
			end
		end)
	end)
end

