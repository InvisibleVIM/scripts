-- Check for table that is shared between executions.
if not shared then
	return warn("No shared, no script.")
end

-- Initialize Luraph globals if they do not exist.
loadstring("getfenv().LPH_NO_VIRTUALIZE = function(...) return ... end")()

getfenv().PP_SCRAMBLE_NUM = function(...) return ... end
getfenv().PP_SCRAMBLE_STR = function(...) return ... end
getfenv().PP_SCRAMBLE_RE_NUM = function(...) return ... end

local AutoFarm = {
	running = false,
	stats = { rounds = 0, wins = 0, points = 0, blockedReports = 0, clusters = 0, retryWaves = 0 },

	-- Live-tunable: edit shared.PotentAutoFarm.config while it runs.
	config = {
		-- Seconds to hold a new spot before firing, so the server sees the teleport first.
		settleTime = 0.1,
		-- Print a line per round with points and duration.
		verbose = false,
		-- Teleport back into the game if disconnected.
		autoRejoin = true,
		-- Workspace file to re-run after a rejoin teleport (skipped if the file doesn't exist).
		reloadFile = "ColorEscapeAutoFarm.lua",
	},
}

-- Constants.
local REPLICA_TOKEN = "TilesGame"
local POINT_STATE = 2
local SAFE_STATE = 3
local HOVER_OFFSET = Vector3.new(0, 3, 0)
local COLLECT_RADIUS = 14
local MAX_WAVES = 3
local DANGER_LOOKAHEAD_TIME = 0.35
local STAND_DANGER_WINDOW = 0.3
local TARGET_DANGER_BASE = 0.1
local RED_STAND_PENALTY = 0.1
local LEVEL_LOAD_TIMEOUT = 6
local WORLD_RESCAN_INTERVAL = 3
local PREPOSITION_LEAD = 0.5

-- Services.
local playersService = game:GetService("Players")
local replicatedStorage = game:GetService("ReplicatedStorage")
local runService = game:GetService("RunService")
local virtualUser = game:GetService("VirtualUser")
local statsService = game:GetService("Stats")
local guiService = game:GetService("GuiService")
local teleportService = game:GetService("TeleportService")

local localPlayer = playersService.LocalPlayer
local clientModules = localPlayer:WaitForChild("PlayerScripts"):WaitForChild("ClientModules")
local collectRemote = replicatedStorage:WaitForChild("RemoteFunctions"):WaitForChild("RequestCollectPointTile")
local selfReportRemote = replicatedStorage:WaitForChild("Remotes"):WaitForChild("SelfReport")

-- State.
local connections = {}
local replicas = {}
local worldsByModel = setmetatable({}, { __mode = "kv" })
local lastWorldScanAt = -math.huge
local pinnedCFrame = nil
local lastRoundKey = nil
local WorldClass = nil
local ReplicaClient = nil
local NativeRagdoll = nil

---Require a game module at identity 2 so it can't see our environment.
---@param module ModuleScript
---@return any
local function safeRequire(module)
	setthreadidentity(2)
	local ok, result = pcall(require, module)
	setthreadidentity(8)
	return ok and result or nil
end

---Round-trip time in seconds, so timeouts and danger windows scale with lag.
---@return number
local function getPing()
	local ok, milliseconds = pcall(function()
		return statsService.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)

	return ok and type(milliseconds) == "number" and milliseconds / 1000 or 0.1
end

---Seconds to wait for a wave of answers before giving up.
---@return number
local function getWaveTimeout()
	return math.clamp(getPing() * 2.5 + 0.3, 0.5, 8)
end

---How far ahead a target must stay blue: until the request reaches the server.
---@return number
local function getTargetWindow()
	return TARGET_DANGER_BASE + math.min(getPing() * 0.5, 1.5)
end

---@return BasePart?
local function getRoot()
	local character = localPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

---Return the live match replica this player belongs to.
---@return table?
local function getMatchReplica()
	local matchId = localPlayer:GetAttribute("ActiveMatchId")

	for replica in pairs(replicas) do
		if not ReplicaClient.IsActive(replica) then
			replicas[replica] = nil
			continue
		end

		if replica.Tags.MatchId == matchId and replica.Data.Phase ~= "Closing" then
			return replica
		end
	end
end

---Index every live ClientWorldObject by its board model. Heap scans are expensive, so throttle them.
local function scanWorlds()
	if os.clock() - lastWorldScanAt < WORLD_RESCAN_INTERVAL then return end
	lastWorldScanAt = os.clock()

	-- filtergc only returns matches instead of building an array of the whole heap.
	local ok, found = pcall(filtergc, "table", { Metatable = WorldClass })

	if not ok or type(found) ~= "table" then
		found = {}

		for _, value in ipairs(getgc(true)) do
			if type(value) == "table" and getmetatable(value) == WorldClass then
				table.insert(found, value)
			end
		end
	end

	for _, world in ipairs(found) do
		local model = rawget(world, "Model")

		if model and rawget(world, "QuickReferences") then
			worldsByModel[model] = world
		end
	end
end

---The ClientWorldObject for a match board. It persists across levels, so one lookup lasts the match.
---@param replica table
---@return table?
local function getWorld(replica)
	local model = replica.BoundInstance
	local world = worldsByModel[model]
	if world then return world end

	scanWorlds()
	return worldsByModel[model]
end

---Server-confirmed point tile ids for the round.
---@param roundData table
---@return table
local function getCollectedSet(roundData)
	local set = {}

	for _, tileId in ipairs(roundData.CollectedPointTiles) do
		set[tileId] = true
	end

	return set
end

---Is the tile killer now or at any point within `window` seconds?
---@param world table
---@param tileId number
---@param window number?
---@return boolean
local function isDangerous(world, tileId, window)
	local frames = world._Frames
	local count = #frames
	if count == 0 then return false end

	local refreshRate = math.max(world._PlayRefreshRate or 0.2, 0.01)
	local lookahead = math.ceil((window or DANGER_LOOKAHEAD_TIME) / refreshRate)
	local index = math.max(world._CurrentFrameIndex, 1)

	for offset = 0, lookahead do
		local frame = frames[((index - 1 + offset) % count) + 1]
		local state = frame and frame[tileId]

		if state and state ~= POINT_STATE and state ~= SAFE_STATE then
			return true
		end
	end

	return false
end

---Tiles that never appear in any killer frame for this level.
---@param world table
---@return table
local function getNeverKillerSet(world)
	local touched = {}

	for _, frame in ipairs(world._Frames) do
		for tileId in pairs(frame) do
			touched[tileId] = true
		end
	end

	return touched
end

---Pick a static tile that no frame ever turns killer.
---@param world table
---@return number?
local function getParkingTile(world)
	local touched = getNeverKillerSet(world)
	local fallback = nil

	for tileId, state in pairs(world._StaticTiles) do
		if touched[tileId] then continue end
		if state == SAFE_STATE then return tileId end
		if state == POINT_STATE then fallback = tileId end
	end

	return fallback
end

---Any tile that won't be red for the next moment.
---@param world table
---@return number?
local function findSafeTile(world)
	for tileId in pairs(world.QuickReferences.TilePositionByTileId) do
		if not isDangerous(world, tileId, STAND_DANGER_WINDOW) then
			return tileId
		end
	end
end

---Uncollected point tiles, including ones a killer sweep is covering.
---@param world table
---@param roundData table
---@return table
local function getPendingSet(world, roundData)
	local collected = getCollectedSet(roundData)
	local positions = world.QuickReferences.TilePositionByTileId
	local pending = {}

	for tileId, state in pairs(world._StaticTiles) do
		if state == POINT_STATE and not collected[tileId] and positions[tileId] then
			pending[tileId] = true
		end
	end

	return pending
end

---For every tile on the board, the point tiles reachable from standing on it.
---@param world table
---@return table
local function buildCoverage(world)
	local positions = world.QuickReferences.TilePositionByTileId
	local points = {}
	local coverage = {}

	for tileId, state in pairs(world._StaticTiles) do
		if state == POINT_STATE and positions[tileId] then
			table.insert(points, tileId)
		end
	end

	for standId, standPosition in pairs(positions) do
		local reachable = {}

		for _, pointId in ipairs(points) do
			local offset = positions[pointId] - standPosition
			if Vector2.new(offset.X, offset.Z).Magnitude <= COLLECT_RADIUS then
				table.insert(reachable, pointId)
			end
		end

		if #reachable > 0 then
			coverage[standId] = reachable
		end
	end

	return coverage
end

---Greedy set cover: the stand tile that reaches the most pending points.
---@param world table
---@param coverage table
---@param pending table
---@return number?, table?
local function pickStandTile(world, coverage, pending)
	local bestId, bestScore, bestTargets = nil, 0, nil

	-- Only blue points; firing at red ones floods the server queue and stalls every request.
	local targetWindow = getTargetWindow()
	local live = {}
	for pointId in pairs(pending) do
		if not isDangerous(world, pointId, targetWindow) then
			live[pointId] = true
		end
	end

	for standId, reachable in pairs(coverage) do
		local targets = {}

		for _, pointId in ipairs(reachable) do
			if live[pointId] then
				table.insert(targets, pointId)
			end
		end

		local score = #targets

		-- Standing on red is harmless with reports swallowed, but prefer blue footing.
		if isDangerous(world, standId, STAND_DANGER_WINDOW) then
			score -= RED_STAND_PENALTY
		end

		if #targets > 0 and score > bestScore then
			bestId, bestScore, bestTargets = standId, score, targets
		end
	end

	return bestId, bestTargets
end

---Undo a freeze/ragdoll that slipped through, anchored parts stop our position replicating.
local function recoverCharacter()
	local character = localPlayer.Character
	if not character or character:GetAttribute("Ragdolled") ~= true then return end

	if NativeRagdoll and NativeRagdoll.SetEnabled then
		pcall(NativeRagdoll.SetEnabled, character, false)
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Anchored then
			part.Anchored = false
		end
	end
end

---Turn off client tile hit detection; it's what freezes and ragdolls us on red.
---@param world table
local function disableHitDetection(world)
	if rawget(world, "OnHeartbeatFunction") then
		pcall(world.SetRunHitDetectionEnabled, world, false)
	end
end

---Teleport onto a tile and keep the character pinned there.
---@param world table
---@param tileId number
local function pinTo(world, tileId)
	local position = world.QuickReferences.TilePositionByTileId[tileId]
	if not position then return end

	pinnedCFrame = CFrame.new(position + HOVER_OFFSET)

	local root = getRoot()
	if not root then return end

	root.AssemblyLinearVelocity = Vector3.zero
	root.CFrame = pinnedCFrame
end

---Stand on a tile and collect every reachable point at once, in waves until accepted.
---@param world table
---@param standId number
---@param targets table
---@param pending table
---@param confirmed table
---@param matchId string
local function collectCluster(world, standId, targets, pending, confirmed, matchId)
	disableHitDetection(world)
	recoverCharacter()

	-- Already standing here (pre-positioned), no need to wait for the move to replicate.
	local position = world.QuickReferences.TilePositionByTileId[standId]
	local alreadyHere = pinnedCFrame and position and (pinnedCFrame.Position - (position + HOVER_OFFSET)).Magnitude < 0.1

	pinTo(world, standId)

	if alreadyHere then
		task.wait()
	else
		task.wait(AutoFarm.config.settleTime)
	end

	AutoFarm.stats.clusters += 1

	for wave = 1, MAX_WAVES do
		if wave > 1 then AutoFarm.stats.retryWaves += 1 end

		local inFlight = 0
		local deadline = os.clock() + getWaveTimeout()
		local targetWindow = getTargetWindow()

		for _, pointId in ipairs(targets) do
			if not pending[pointId] or isDangerous(world, pointId, targetWindow) then continue end

			inFlight += 1
			task.spawn(function()
				local ok, accepted = pcall(collectRemote.InvokeServer, collectRemote, pointId, matchId)

				if ok and accepted and pending[pointId] then
					pending[pointId] = nil
					confirmed[pointId] = true
					AutoFarm.stats.points += 1
				end

				inFlight -= 1
			end)
		end

		if inFlight == 0 then return end

		-- Stay put until every answer is back; moving early voids the check and queues dead requests.
		while inFlight > 0 and os.clock() < deadline do
			task.wait()
		end

		if inFlight > 0 then return end
	end
end

---Is this still the same round we started farming?
---@param replica table
---@param roundNumber number
---@return boolean
local function isSameRound(replica, roundNumber)
	local current = replica.Data.CurrentRoundData
	return AutoFarm.running and current ~= nil and current.RoundNumber == roundNumber and ReplicaClient.IsActive(replica)
end

---Collect every point tile in the current round as fast as the server allows.
---@param replica table
---@param roundData table
local function farmRound(replica, roundData)
	local matchId = replica.Tags.MatchId
	local roundNumber = roundData.RoundNumber
	local deadline = os.clock() + LEVEL_LOAD_TIMEOUT
	local world = nil

	-- Wait for the client to load the new level layout.
	repeat
		world = getWorld(replica)
		if world and world._LoadedLevelId == roundData.LevelId then break end
		task.wait()
	until os.clock() > deadline or not isSameRound(replica, roundNumber)

	if not world or not isSameRound(replica, roundNumber) then return end

	disableHitDetection(world)

	-- Park on a tile that never turns killer while the level reveals.
	local parkingTile = getParkingTile(world)
	if parkingTile then
		pinTo(world, parkingTile)
	end

	local coverage = buildCoverage(world)
	local confirmed = {}
	local skipped = {}
	local prepositioned = false

	-- Server rejects collections before the round starts, so sit on the best opening spot and wait.
	while isSameRound(replica, roundNumber) and workspace:GetServerTimeNow() < roundData.StartPlayingAtTime do
		if not prepositioned and roundData.StartPlayingAtTime - workspace:GetServerTimeNow() <= PREPOSITION_LEAD then
			prepositioned = true

			local standId = pickStandTile(world, coverage, getPendingSet(world, roundData))
			if standId then pinTo(world, standId) end
		end

		task.wait()
	end

	while isSameRound(replica, roundNumber) do
		local pending = getPendingSet(world, replica.Data.CurrentRoundData)

		-- Replica can lag behind our own confirmations.
		for pointId in pairs(confirmed) do
			pending[pointId] = nil
		end

		-- Tiles the server keeps refusing get a short break so we don't loop on them.
		for pointId, expiresAt in pairs(skipped) do
			if os.clock() < expiresAt then pending[pointId] = nil else skipped[pointId] = nil end
		end

		if next(pending) == nil and next(skipped) == nil then break end

		-- Everything left is red right now, wait somewhere safe for it to clear.
		local standId, targets = pickStandTile(world, coverage, pending)
		if not standId then
			local waitTile = parkingTile or findSafeTile(world)
			if waitTile then pinTo(world, waitTile) end
			task.wait()
			continue
		end

		collectCluster(world, standId, targets, pending, confirmed, matchId)

		-- Refused while blue means something else is wrong with it, back off briefly.
		for _, pointId in ipairs(targets) do
			if pending[pointId] and not isDangerous(world, pointId, getTargetWindow()) then
				skipped[pointId] = os.clock() + 0.3
			end
		end
	end

	if AutoFarm.config.verbose and next(confirmed) then
		local count = 0
		for _ in pairs(confirmed) do count += 1 end
		print(string.format("[Potent] Round %d (%s): %d points in %.1fs", roundNumber, roundData.LevelId, count, workspace:GetServerTimeNow() - roundData.StartPlayingAtTime))
	end

	-- Leave the last tile before the next level reveals.
	local finalTile = parkingTile or findSafeTile(world)
	if finalTile then
		pinTo(world, finalTile)
	end
end

---Main farming loop.
local function farmLoop()
	local userId = tostring(localPlayer.UserId)

	while AutoFarm.running do
		local replica = getMatchReplica()
		local data = replica and replica.Data
		local roundData = data and data.CurrentRoundData
		local me = data and data.PlayingPlayers[userId]

		if roundData and me and me.MatchState == "Playing" and data.Phase == "Playing" then
			local roundKey = tostring(data.MatchRunId) .. ":" .. tostring(roundData.RoundNumber)

			local ok, err = pcall(farmRound, replica, roundData)
			if not ok then
				warn("[Potent] Round error:", err)
			end

			if roundKey ~= lastRoundKey then
				lastRoundKey = roundKey
				AutoFarm.stats.rounds += 1
			end
		else
			pinnedCFrame = nil
		end

		task.wait()
	end
end

---Stop the farm and clean up.
function AutoFarm.detach()
	AutoFarm.running = false
	pinnedCFrame = nil

	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(connections)
end

---Start the farm.
function AutoFarm.init()
	WorldClass = safeRequire(clientModules:WaitForChild("Objects"):WaitForChild("ClientWorldObject"))
	ReplicaClient = safeRequire(clientModules:WaitForChild("ReplicaClient"))
	assert(WorldClass and ReplicaClient, "Failed to load game modules.")

	AutoFarm.running = true

	-- Swallow killer self-reports; the client is the authority on tile deaths.
	if not shared.PotentSelfReportHook then
		local oldNamecall
		local hook = newcclosure(function(self, ...)
			if self == selfReportRemote and not checkcaller() and getnamecallmethod() == "FireServer" then
				local farm = shared.PotentAutoFarm
				if farm and farm.running and (...) == "Killer" then
					farm.stats.blockedReports += 1
					return
				end
			end

			return oldNamecall(self, ...)
		end)

		pcall(setstackhidden, hook, true)
		oldNamecall = hookmetamethod(game, "__namecall", hook)
		shared.PotentSelfReportHook = true
	end

	NativeRagdoll = safeRequire(replicatedStorage:WaitForChild("SharedModules"):WaitForChild("Utils"):WaitForChild("NativeRagdoll"))

	-- Backup: never let the optimistic death presentation anchor our character.
	if not shared.PotentRagdollHook then
		if NativeRagdoll and NativeRagdoll.FreezeThenRagdoll then
			local oldFreeze
			oldFreeze = hookfunction(NativeRagdoll.FreezeThenRagdoll, newcclosure(function(character, ...)
				local farm = shared.PotentAutoFarm
				if farm and farm.running and character == localPlayer.Character then
					return
				end

				return oldFreeze(character, ...)
			end))

			shared.PotentRagdollHook = true
		end
	end

	-- Track every match replica, including ones that already exist.
	table.insert(connections, ReplicaClient.OnNew(REPLICA_TOKEN, function(replica)
		replicas[replica] = true
	end))

	-- Keep the character glued to the target tile so it doesn't fall onto neighbours.
	table.insert(connections, runService.Stepped:Connect(function()
		if not pinnedCFrame then return end

		local root = getRoot()
		if not root then return end

		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = pinnedCFrame
	end))

	-- Prevent the idle kick.
	table.insert(connections, localPlayer.Idled:Connect(function()
		virtualUser:CaptureController()
		virtualUser:ClickButton2(Vector2.zero)
	end))

	-- Disconnect prompt means the session is dead; hop back in and reload the farm.
	table.insert(connections, guiService.ErrorMessageChanged:Connect(function(message)
		if not AutoFarm.config.autoRejoin or message == "" then return end

		local reloadFile = AutoFarm.config.reloadFile
		local hasFile = reloadFile and isfile and pcall(isfile, reloadFile) and isfile(reloadFile)

		if hasFile and queue_on_teleport then
			queue_on_teleport(string.format("if not game:IsLoaded() then game.Loaded:Wait() end loadstring(readfile(%q))()", reloadFile))
		end

		task.wait(3)
		pcall(teleportService.Teleport, teleportService, game.PlaceId, localPlayer)
	end))

	-- Count wins as they land.
	local winsValue = localPlayer:WaitForChild("leaderstats"):WaitForChild("Wins")
	local lastWins = winsValue.Value

	table.insert(connections, winsValue.Changed:Connect(function(value)
		if value > lastWins then
			AutoFarm.stats.wins += value - lastWins
			print(string.format("[Potent] Win! %d this session, %d total.", AutoFarm.stats.wins, value))
		end

		lastWins = value
	end))

	task.spawn(farmLoop)
end

---This is called when initialization errors.
---@param error string
local function onInitializeError(error)
	warn("[Potent] Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	AutoFarm.detach()
end

-- Detach any previous instance before starting a new one.
if shared.PotentAutoFarm then
	shared.PotentAutoFarm.detach()
end

shared.PotentAutoFarm = AutoFarm

xpcall(AutoFarm.init, onInitializeError)
