---Return the live match replica this player belongs to.
---@return table?
local function getMatchReplica()
	local matchId = localPlayer:GetAttribute("ActiveMatchId")

	for replica in pairs(replicas) do
		if not ReplicaClient.IsActive(replica) then
			replicas[replica] = nil
			continue
		end

		if replica.Tags.MatchId == matchId and replica.Data.Phase ~= "Closing" then
			return replica
		end
	end
end

---Index every live ClientWorldObject by its board model. Heap scans are expensive, so throttle them.
local function scanWorlds()
	if os.clock() - lastWorldScanAt < WORLD_RESCAN_INTERVAL then return end
	lastWorldScanAt = os.clock()

	-- filtergc only returns matches instead of building an array of the whole heap.
	local ok, found = pcall(filtergc, "table", { Metatable = WorldClass })

	if not ok or type(found) ~= "table" then
		found = {}

		for _, value in ipairs(getgc(true)) do
			if type(value) == "table" and getmetatable(value) == WorldClass then
				table.insert(found, value)
			end
		end
	end

	for _, world in ipairs(found) do
		local model = rawget(world, "Model")

		if model and rawget(world, "QuickReferences") then
			worldsByModel[model] = world
		end
	end
end

---The ClientWorldObject for a match board. It persists across levels, so one lookup lasts the match.
---@param replica table
---@return table?
local function getWorld(replica)
	local model = replica.BoundInstance
	local world = worldsByModel[model]
	if world then return world end

	scanWorlds()
	return worldsByModel[model]
end

---Server-confirmed point tile ids for the round.
---@param roundData table
---@return table
local function getCollectedSet(roundData)
	local set = {}

	for _, tileId in ipairs(roundData.CollectedPointTiles) do
		set[tileId] = true
	end

	return set
end

---Is the tile killer at any point within `window` seconds, starting `delay` seconds from now?
---@param world table
---@param tileId number
---@param window number?
---@param delay number?
---@return boolean
local function isDangerous(world, tileId, window, delay)
	local frames = world._Frames
	local count = #frames
	if count == 0 then return false end

	local refreshRate = math.max(world._PlayRefreshRate or 0.2, 0.01)
	local lookahead = math.ceil((window or DANGER_LOOKAHEAD_TIME) / refreshRate)
	local first = math.floor((delay or 0) / refreshRate)
	local index = math.max(world._CurrentFrameIndex, 1)

	for offset = first, first + lookahead do
		local frame = frames[((index - 1 + offset) % count) + 1]
		local state = frame and frame[tileId]

		if state and state ~= POINT_STATE and state ~= SAFE_STATE then
			return true
		end
	end

	return false
end

---Pick a static tile that no frame ever turns killer.
---@param world table
---@return number?
local function getParkingTile(world)
	local touched = {}

	for _, frame in ipairs(world._Frames) do
		for tileId in pairs(frame) do
			touched[tileId] = true
		end
	end

	local fallback = nil

	for tileId, state in pairs(world._StaticTiles) do
		if touched[tileId] then continue end
		if state == SAFE_STATE then return tileId end
		if state == POINT_STATE then fallback = tileId end
	end

	return fallback
end

---Any tile that won't be red for the next moment.
---@param world table
---@return number?
local function findSafeTile(world)
	for tileId in pairs(world.QuickReferences.TilePositionByTileId) do
		if not isDangerous(world, tileId, STAND_DANGER_WINDOW) then
			return tileId
		end
	end
end

---Uncollected point tiles, including ones a killer sweep is covering.
---@param world table
---@param roundData table
---@return table
local function getPendingSet(world, roundData)
	local collected = getCollectedSet(roundData)
	local positions = world.QuickReferences.TilePositionByTileId
	local pending = {}

	for tileId, state in pairs(world._StaticTiles) do
		if state == POINT_STATE and not collected[tileId] and positions[tileId] then
			pending[tileId] = true
		end
	end

	return pending
end

---For every tile on the board, the point tiles reachable from standing on it.
---@param world table
---@return table
local function buildCoverage(world)
	local positions = world.QuickReferences.TilePositionByTileId
	local points = {}
	local coverage = {}

	for tileId, state in pairs(world._StaticTiles) do
		if state == POINT_STATE and positions[tileId] then
			table.insert(points, tileId)
		end
	end

	for standId, standPosition in pairs(positions) do
		local reachable = {}

		for _, pointId in ipairs(points) do
			local offset = positions[pointId] - standPosition
			if Vector2.new(offset.X, offset.Z).Magnitude <= COLLECT_RADIUS then
				table.insert(reachable, pointId)
			end
		end

		if #reachable > 0 then
			coverage[standId] = reachable
		end
	end

	return coverage
end

---Greedy set cover: the stand tile that reaches the most pending points that are blue `delay` seconds from now.
---@param world table
---@param coverage table
---@param pending table
---@param delay number?
---@return number?, table?
local function pickStandTile(world, coverage, pending, delay)
	local bestId, bestScore, bestTargets = nil, 0, nil

	-- Only blue points; the server refuses red ones and re-firing floods its queue.
	local targetWindow = getTargetWindow()
	local live = {}
	for pointId in pairs(pending) do
		if not isDangerous(world, pointId, targetWindow, delay) then
			live[pointId] = true
		end
	end

	for standId, reachable in pairs(coverage) do
		local targets = {}

		for _, pointId in ipairs(reachable) do
			if live[pointId] then
				table.insert(targets, pointId)
			end
		end

		-- Cheap count check first; the footing check only matters for real contenders.
		if #targets == 0 or #targets < bestScore then continue end

		local score = #targets

		-- Standing on red is harmless with god mode, but prefer blue footing.
		if isDangerous(world, standId, STAND_DANGER_WINDOW) then
			score -= RED_STAND_PENALTY
		end

		if score > bestScore then
			bestId, bestScore, bestTargets = standId, score, targets
		end
	end

	return bestId, bestTargets
end

---Undo a freeze/ragdoll that slipped through, anchored parts stop our position replicating.
local function recoverCharacter()
	local character = localPlayer.Character
	if not character or character:GetAttribute("Ragdolled") ~= true then return end

	if NativeRagdoll and NativeRagdoll.SetEnabled then
		pcall(NativeRagdoll.SetEnabled, character, false)
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Anchored then
			part.Anchored = false
		end
	end
end

---Turn off client tile hit detection; it's what reports, freezes and ragdolls us on red.
---@param world table
local function disableHitDetection(world)
	if rawget(world, "OnHeartbeatFunction") then
		pcall(world.SetRunHitDetectionEnabled, world, false)
		hitDetectionDisabledOn[world] = true
	end
end

---Give hit detection back to a board we turned it off on, if a round is running there.
---@param world table
local function restoreHitDetection(world)
	if not hitDetectionDisabledOn[world] then return end
	hitDetectionDisabledOn[world] = nil

	if rawget(world, "IsPlaying") and not rawget(world, "OnHeartbeatFunction") then
		pcall(world.SetRunHitDetectionEnabled, world, true)
	end
end

---Teleport onto a tile and keep the character pinned there.
---@param world table
---@param tileId number
local function pinTo(world, tileId)
	local position = world.QuickReferences.TilePositionByTileId[tileId]
	if not position then return end

	pinnedCFrame = CFrame.new(position + HOVER_OFFSET)

	local root = getRoot()
	if not root then return end

	root.AssemblyLinearVelocity = Vector3.zero
	root.CFrame = pinnedCFrame
end

---Greedy set cover over the live points: a route of stand tiles that together reach them.
---@param world table
---@param coverage table
---@param pending table
---@return table
local function planRoute(world, coverage, pending)
	local remaining = table.clone(pending)
	local route = {}

	while #route < ROUTE_MAX_STOPS do
		local standId, targets = pickStandTile(world, coverage, remaining)
		if not standId then break end

		table.insert(route, { standId = standId, targets = targets })

		for _, pointId in ipairs(targets) do
			remaining[pointId] = nil
		end
	end

	return route
end

---Walk the route without waiting on replies. The server checks requests against a short
---history of where we've been, so each stop only needs to be held long enough to be sampled.
---@param world table
---@param route table
---@param pending table
---@param confirmed table
---@param matchId string
local function runRoute(world, route, pending, confirmed, matchId)
	disableHitDetection(world)
	recoverCharacter()

	local inFlight = 0

	for _, stop in ipairs(route) do
		-- Already standing here (pre-positioned), no need to wait for the move to replicate.
		local position = world.QuickReferences.TilePositionByTileId[stop.standId]
		local alreadyHere = pinnedCFrame and position and (pinnedCFrame.Position - (position + HOVER_OFFSET)).Magnitude < 0.1

		pinTo(world, stop.standId)

		if alreadyHere then
			task.wait()
		else
			task.wait(AutoFarm.config.settleTime)
		end

		AutoFarm.stats.clusters += 1

		local targetWindow = getTargetWindow()

		for _, pointId in ipairs(stop.targets) do
			-- The route was planned a moment ago; skip anything a sweep has turned red since.
			if not pending[pointId] or isDangerous(world, pointId, targetWindow) then continue end

			inFlight += 1
			task.spawn(function()
				local ok, accepted = pcall(collectRemote.InvokeServer, collectRemote, pointId, matchId)

				if ok and accepted and pending[pointId] then
					pending[pointId] = nil
					confirmed[pointId] = true
					AutoFarm.stats.points += 1
				elseif pending[pointId] then
					AutoFarm.stats.retryWaves += 1
				end

				inFlight -= 1
			end)
		end
	end

	-- Let the answers land before replanning so we don't re-fire points already taken.
	local deadline = os.clock() + getWaveTimeout()
	while inFlight > 0 and os.clock() < deadline do
		task.wait()
	end
end

---Is this still the same round we started farming?
---@param replica table
---@param roundNumber number
---@return boolean
local function isSameRound(replica, roundNumber)
	local current = replica.Data.CurrentRoundData
	return AutoFarm.alive
		and AutoFarm.config.autoFarm
		and current ~= nil
		and current.RoundNumber == roundNumber
		and ReplicaClient.IsActive(replica)
end

---Collect every point tile in the current round as fast as the server allows.
---@param replica table
---@param roundData table
local function farmRound(replica, roundData)
	local matchId = replica.Tags.MatchId
	local roundNumber = roundData.RoundNumber
	local deadline = os.clock() + LEVEL_LOAD_TIMEOUT
	local world = nil

	-- Wait for the client to load the new level layout.
	repeat
		world = getWorld(replica)
		if world and world._LoadedLevelId == roundData.LevelId then break end
		task.wait()
	until os.clock() > deadline or not isSameRound(replica, roundNumber)

	if not world or not isSameRound(replica, roundNumber) then return end

	disableHitDetection(world)

	-- Park on a tile that never turns killer while the level reveals.
	local parkingTile = getParkingTile(world)
	if parkingTile then
		pinTo(world, parkingTile)
	end

	local coverage = buildCoverage(world)
	local confirmed = {}
	local skipped = {}
	local refusals = {}
	local prepositioned = false

	-- Server rejects collections before the round starts, so sit on the best opening spot and wait.
	while isSameRound(replica, roundNumber) and workspace:GetServerTimeNow() < roundData.StartPlayingAtTime do
		if not prepositioned and roundData.StartPlayingAtTime - workspace:GetServerTimeNow() <= PREPOSITION_LEAD then
			prepositioned = true

			local standId = pickStandTile(world, coverage, getPendingSet(world, roundData))
			if standId then pinTo(world, standId) end
		end

		task.wait()
	end

	while isSameRound(replica, roundNumber) do
		local pending = getPendingSet(world, replica.Data.CurrentRoundData)

		-- Replica can lag behind our own confirmations.
		for pointId in pairs(confirmed) do
			pending[pointId] = nil
		end

		-- Tiles the server keeps refusing get a short break so we don't loop on them.
		for pointId, expiresAt in pairs(skipped) do
			if os.clock() < expiresAt then pending[pointId] = nil else skipped[pointId] = nil end
		end

		if next(pending) == nil and next(skipped) == nil then break end

		-- Everything left is red right now: stand where the most points are about to turn blue,
		-- so the server already has our position when they do.
		local route = planRoute(world, coverage, pending)
		if #route == 0 then
			local waitTile = nil

			for step = 1, ANTICIPATE_STEPS do
				waitTile = pickStandTile(world, coverage, pending, step * ANTICIPATE_STEP_TIME)
				if waitTile then break end
			end

			waitTile = waitTile or parkingTile or findSafeTile(world)
			if waitTile then pinTo(world, waitTile) end
			task.wait()
			continue
		end

		runRoute(world, route, pending, confirmed, matchId)

		-- Refused twice while blue means something else is wrong with it, back off briefly.
		for _, stop in ipairs(route) do
			for _, pointId in ipairs(stop.targets) do
				if pending[pointId] and not isDangerous(world, pointId, getTargetWindow()) then
					refusals[pointId] = (refusals[pointId] or 0) + 1

					if refusals[pointId] >= 2 then
						refusals[pointId] = 0
						skipped[pointId] = os.clock() + 0.3
					end
				end
			end
		end
	end

	if AutoFarm.config.verbose and next(confirmed) then
		local count = 0
		for _ in pairs(confirmed) do count += 1 end
		print(string.format("[Potent] Round %d (%s): %d points in %.1fs", roundNumber, roundData.LevelId, count, workspace:GetServerTimeNow() - roundData.StartPlayingAtTime))
	end

	-- Leave the last tile before the next level reveals.
	local finalTile = parkingTile or findSafeTile(world)
	if finalTile and isSameRound(replica, roundNumber) then
		pinTo(world, finalTile)
	end
end

---AFK players are kept out of matches, so switch it off through the game's own controller.
local function ensureNotAfk()
	if localPlayer:GetAttribute("PlayerAFK") ~= true then return end
	if not AFKController or os.clock() - lastAfkFixAt < 3 then return end
	lastAfkFixAt = os.clock()

	setthreadidentity(2)
	pcall(AFKController.SetAFK, AFKController, false)
	setthreadidentity(8)
end

---Main farming loop. Idles while Auto Farm is toggled off.
local function farmLoop()
	local userId = tostring(localPlayer.UserId)

	while AutoFarm.alive do
		if AutoFarm.config.autoFarm then
			ensureNotAfk()
		end

		local replica = AutoFarm.config.autoFarm and getMatchReplica()
		local data = replica and replica.Data
		local roundData = data and data.CurrentRoundData
		local me = data and data.PlayingPlayers[userId]

		if roundData and me and me.MatchState == "Playing" and data.Phase == "Playing" then
			local roundKey = tostring(data.MatchRunId) .. ":" .. tostring(roundData.RoundNumber)

			local ok, err = pcall(farmRound, replica, roundData)
			if not ok then
				warn("[Potent] Round error:", err)
			end

			if roundKey ~= lastRoundKey then
				lastRoundKey = roundKey
				AutoFarm.stats.rounds += 1
			end
		else
			-- Release the character whenever there's no round to farm (or farming is off).
			pinnedCFrame = nil
		end

		task.wait()
	end
end

---Keep the board's hit detection off while god mode is on, and hand it back when it's turned off.
local function godModeLoop()
	while AutoFarm.alive do
		local replica = getMatchReplica()
		local world = replica and getWorld(replica)

		if world then
			if AutoFarm.config.godMode then
				disableHitDetection(world)
				recoverCharacter()
			else
				restoreHitDetection(world)
			end
		end

		task.wait(0.2)
	end
end

---Do we have a spin to use right now? The daily free spin is a flag, bought spins are tickets.
---@return boolean
local function hasSpin()
	local data = playerDataReplica and playerDataReplica.Data
	local custom = data and data.Custom
	if not custom then return false end

	local wheel = custom.GameSpinWheel
	if wheel and wheel.FreeSpinAvailable == true then return true end

	local currencies = custom.Currencies
	return currencies ~= nil and (currencies.GameSpinTickets or 0) > 0
end

---Use one spin on the active wheel. Guarded so overlapping triggers don't double-fire.
local function trySpin()
	if spinning or not AutoFarm.config.autoSpin or os.clock() < spinBackoffUntil or not hasSpin() then return end
	spinning = true

	local wheelId = LootBoxesConfig and LootBoxesConfig.ACTIVE_SPIN_WHEEL or "Halloween2026SpinWheel"
	local ok, success, reason = pcall(lootBoxRemote.InvokeServer, lootBoxRemote, wheelId)

	if ok and success then
		AutoFarm.stats.spins += 1
		print(string.format("[Potent] Spun the %s.", wheelId))
	else
		-- Data can lag the server for a moment; don't hammer it.
		spinBackoffUntil = os.clock() + SPIN_FAIL_BACKOFF

		if ok and reason ~= "NotEnoughTickets" then
			warn("[Potent] Spin refused:", reason)
		end
	end

	spinning = false
end

---Watch for spins and use them the moment they show up.
local function spinLoop()
	while AutoFarm.alive do
		if AutoFarm.config.autoSpin and hasSpin() then
			trySpin()
		end

		task.wait(SPIN_POLL_INTERVAL)
	end
end

---Buy one egg without waiting on the server, so the button can be spammed.
---@param eggKey string
local function buyEgg(eggKey)
	task.spawn(function()
		local ok, success = pcall(eggRemote.InvokeServer, eggRemote, eggKey)

		if ok and success then
			AutoFarm.stats.eggs += 1
		elseif interface then
			interface.flash("Couldn't buy that egg (coins?)")
		end
	end)
end

---Eggs the shop sells for coins right now, cheapest first.
---@return table
local function getShopEggs()
	local eggs = {}
	local data = EggsData and EggsData.Data or {}

	for eggKey, egg in pairs(data) do
		if egg.OnSale and egg.CurrencyType == "Coins" and (egg.CurrencyCost or 0) > 0 then
			table.insert(eggs, { key = eggKey, name = egg.DisplayName or eggKey, cost = egg.CurrencyCost })
		end
	end

	table.sort(eggs, function(a, b)
		return a.cost < b.cost
	end)

	return eggs
end

---Format big numbers with commas.
---@param value number
---@return string
local function commas(value)
	local text = tostring(math.floor(value))
	local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end

---Build the window. Returns a table with refresh/flash/destroy.
---@return table
local function createInterface()
	local palette = {
		background = Color3.fromRGB(22, 22, 30),
		header = Color3.fromRGB(88, 101, 242),
		row = Color3.fromRGB(32, 32, 43),
		egg = Color3.fromRGB(40, 40, 54),
		eggHover = Color3.fromRGB(52, 52, 70),
		on = Color3.fromRGB(67, 196, 120),
		off = Color3.fromRGB(70, 72, 86),
		text = Color3.fromRGB(236, 238, 245),
		subtle = Color3.fromRGB(150, 153, 168),
		coins = Color3.fromRGB(255, 205, 80),
	}

	local function corner(instance, radius)
		local uiCorner = Instance.new("UICorner")
