	---A row with a switch bound to a config key.
	local function makeToggle(text, configKey, onChanged)
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, 36)
		row.BackgroundColor3 = palette.row
		row.BorderSizePixel = 0
		row.AutoButtonColor = false
		row.Text = ""
		row.LayoutOrder = nextOrder()
		row.Parent = body
		corner(row, 8)

		local rowLabel = label(row, text, 13)
		rowLabel.Position = UDim2.new(0, 12, 0, 0)
		rowLabel.Size = UDim2.new(1, -70, 1, 0)

		local track = Instance.new("Frame")
		track.AnchorPoint = Vector2.new(1, 0.5)
		track.Position = UDim2.new(1, -10, 0.5, 0)
		track.Size = UDim2.new(0, 40, 0, 22)
		track.BorderSizePixel = 0
		track.Parent = row
		corner(track, 11)

		local knob = Instance.new("Frame")
		knob.AnchorPoint = Vector2.new(0, 0.5)
		knob.Size = UDim2.new(0, 16, 0, 16)
		knob.BackgroundColor3 = Color3.fromRGB(245, 245, 250)
		knob.BorderSizePixel = 0
		knob.Parent = track
		corner(knob, 8)

		local function refresh()
			local on = AutoFarm.config[configKey] == true
			local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			tweenService:Create(track, info, { BackgroundColor3 = on and palette.on or palette.off }):Play()
			tweenService:Create(knob, info, { Position = on and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }):Play()
		end

		row.MouseButton1Click:Connect(function()
			AutoFarm.config[configKey] = not AutoFarm.config[configKey]
			if onChanged then onChanged(AutoFarm.config[configKey]) end

			for _, refresher in ipairs(toggleRefreshers) do
				refresher()
			end
		end)

		table.insert(toggleRefreshers, refresh)
		refresh()
	end

	-- The farm dies without god mode, so the two toggles stay linked.
	makeToggle("Auto Farm", "autoFarm", function(on)
		if on then AutoFarm.config.godMode = true end
	end)

	makeToggle("God Mode", "godMode", function(on)
		if not on then AutoFarm.config.autoFarm = false end
	end)

	makeToggle("Auto Spin", "autoSpin", function(on)
		if on then
			spinBackoffUntil = 0
			task.spawn(trySpin)
