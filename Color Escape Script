	local eggs = getShopEggs()

	if #eggs == 0 then
		local none = label(body, "No coin eggs on sale right now.", 12, palette.subtle)
		none.Size = UDim2.new(1, 0, 0, 18)
		none.LayoutOrder = nextOrder()
	end

	for _, egg in ipairs(eggs) do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, 0, 0, 36)
		button.BackgroundColor3 = palette.egg
		button.BorderSizePixel = 0
		button.AutoButtonColor = false
		button.Text = ""
		button.LayoutOrder = nextOrder()
		button.Parent = body
		corner(button, 8)

		local nameLabel = label(button, egg.name, 13, palette.text, Enum.Font.GothamSemibold)
		nameLabel.Position = UDim2.new(0, 12, 0, 0)
		nameLabel.Size = UDim2.new(1, -110, 1, 0)

		local costLabel = label(button, commas(egg.cost) .. " coins", 12, palette.coins, Enum.Font.GothamBold)
		costLabel.AnchorPoint = Vector2.new(1, 0)
		costLabel.Position = UDim2.new(1, -12, 0, 0)
		costLabel.Size = UDim2.new(0, 100, 1, 0)
		costLabel.TextXAlignment = Enum.TextXAlignment.Right

		-- Prices are dynamic server-side; keep the label on the live price.
		if eggPriceRemote then
			task.spawn(function()
				while screenGui.Parent do
					local ok, price = pcall(eggPriceRemote.InvokeServer, eggPriceRemote, egg.key)
					if ok and type(price) == "number" then
						costLabel.Text = commas(price) .. " coins"
					end

					task.wait(60)
				end
			end)
		end

		-- No debounce: every click fires its own purchase immediately.
		button.MouseButton1Down:Connect(function()
			eggCounts[egg.key] = (eggCounts[egg.key] or 0) + 1
			nameLabel.Text = string.format("%s  ×%d", egg.name, eggCounts[egg.key])
			button.BackgroundColor3 = palette.eggHover
			buyEgg(egg.key)
		end)

		button.MouseButton1Up:Connect(function()
			button.BackgroundColor3 = palette.egg
		end)

		button.MouseLeave:Connect(function()
			button.BackgroundColor3 = palette.egg
		end)
	end

	local flashText, flashUntil = nil, 0

	local minimized = false
	minimizeButton.MouseButton1Click:Connect(function()
		minimized = not minimized
		body.Visible = not minimized
		minimizeButton.Text = minimized and "+" or "-"
	end)

	closeButton.MouseButton1Click:Connect(function()
		AutoFarm.detach()
	end)

	local ui = {}

	---Update the status line.
	function ui.refresh()
		local currencies = getCurrencies() or {}
		local custom = playerDataReplica and playerDataReplica.Data and playerDataReplica.Data.Custom
		local freeSpin = custom and custom.GameSpinWheel and custom.GameSpinWheel.FreeSpinAvailable == true
		local text = string.format(
			"Coins %s · Spins %d\nWins +%d · Eggs +%d · Spun %d",
			commas(currencies.Coins or 0),
			(currencies.GameSpinTickets or 0) + (freeSpin and 1 or 0),
			AutoFarm.stats.wins,
			AutoFarm.stats.eggs,
			AutoFarm.stats.spins
		)

		if flashText and os.clock() < flashUntil then
			text = flashText
		end

		statusLabel.Text = text
	end

	---Show a short message in the status line.
	---@param message string
	function ui.flash(message)
		flashText = message
		flashUntil = os.clock() + 2
	end

	function ui.destroy()
		screenGui:Destroy()
	end

	ui.refresh()
	return ui
end

---Stop everything, hand hit detection back and remove the window.
function AutoFarm.detach()
	AutoFarm.alive = false
	pinnedCFrame = nil

	for world in pairs(hitDetectionDisabledOn) do
		restoreHitDetection(world)
	end

	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(connections)

	if interface then
		interface.destroy()
		interface = nil
	end
end

---Hooks are installed once per client and read the live instance through shared, so re-running is safe.
local function installHooks()
	-- Swallow killer reports while god mode is on: the old SelfReport and the newer penalty remote.
	if not shared.PotentGodHookV2 then
		local oldNamecall
		local hook = newcclosure(function(self, ...)
			if not checkcaller() and (self == selfReportRemote or self == penaltyRemote) then
				local farm = shared.PotentAutoFarm
				local method = getnamecallmethod()

				if farm and farm.alive and farm.config.godMode and method == "FireServer" then
					if self == penaltyRemote or (...) == "Killer" then
						farm.stats.blockedReports += 1
						return
					end
				end
			end

			return oldNamecall(self, ...)
		end)

		pcall(setstackhidden, hook, true)
		oldNamecall = hookmetamethod(game, "__namecall", hook)
		shared.PotentGodHookV2 = true
	end

	-- Never let the optimistic death presentation anchor our character while god mode is on.
	if not shared.PotentRagdollHookV2 and NativeRagdoll and NativeRagdoll.FreezeThenRagdoll then
		local oldFreeze
		oldFreeze = hookfunction(NativeRagdoll.FreezeThenRagdoll, newcclosure(function(character, ...)
			local farm = shared.PotentAutoFarm
			if farm and farm.alive and farm.config.godMode and character == localPlayer.Character then
				return
			end

			return oldFreeze(character, ...)
		end))

		shared.PotentRagdollHookV2 = true
	end
end

---Start everything.
function AutoFarm.init()
	WorldClass = safeRequire(clientModules:WaitForChild("Objects"):WaitForChild("ClientWorldObject"))
	ReplicaClient = safeRequire(clientModules:WaitForChild("ReplicaClient"))
	NativeRagdoll = safeRequire(sharedModules:WaitForChild("Utils"):WaitForChild("NativeRagdoll"))
	LootBoxesConfig = safeRequire(sharedModules:WaitForChild("LootBoxesConfig"))
	EggsData = safeRequire(sharedModules:WaitForChild("GameData"):WaitForChild("Eggs"))
	AFKController = safeRequire(clientModules:FindFirstChild("AFKController", true))
	assert(WorldClass and ReplicaClient, "Failed to load game modules.")

	AutoFarm.alive = true
	installHooks()

	-- Track every match replica and our own player data, including ones that already exist.
	table.insert(connections, ReplicaClient.OnNew(REPLICA_TOKEN, function(replica)
		replicas[replica] = true
	end))

	table.insert(connections, ReplicaClient.OnNew(PLAYER_DATA_TOKEN, function(replica)
		local tags = replica.Tags
		if tags and tags.UserId == localPlayer.UserId and replica.Data and replica.Data.Custom then
			playerDataReplica = replica
		end
	end))

	-- Keep the character glued to the target tile so it doesn't fall onto neighbours.
	table.insert(connections, runService.Stepped:Connect(function()
		if not pinnedCFrame then return end

		local root = getRoot()
		if not root then return end

		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = pinnedCFrame
	end))

	-- The server announces the daily free spin; react right away instead of waiting for the poll.
	if dailySpinRemote then
		table.insert(connections, dailySpinRemote.OnClientEvent:Connect(function()
			spinBackoffUntil = 0
			task.delay(0.3, trySpin)
		end))
	end

	-- Infinite Yield anti-AFK: kill the Idled listeners that run the 20 minute kick, then click on every idle.
	if getconnections then
		for _, connection in getconnections(localPlayer.Idled) do
			pcall(function() connection:Disable() end)
			pcall(function() connection:Disconnect() end)
		end
	end

	table.insert(connections, localPlayer.Idled:Connect(function()
		local virtualInputManager = Instance.new("VirtualInputManager")
		virtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		virtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
		virtualInputManager:Destroy()

		pcall(function()
			virtualUser:CaptureController()
			virtualUser:ClickButton2(Vector2.zero)
		end)
	end))

	-- Disconnect prompt means the session is dead; hop back in and reload the farm.
	table.insert(connections, guiService.ErrorMessageChanged:Connect(function(message)
		if not AutoFarm.config.autoRejoin or message == "" then return end

		local reloadFile = AutoFarm.config.reloadFile
		local hasFile = reloadFile and isfile and pcall(isfile, reloadFile) and isfile(reloadFile)

		if hasFile and queue_on_teleport then
			queue_on_teleport(string.format("if not game:IsLoaded() then game.Loaded:Wait() end loadstring(readfile(%q))()", reloadFile))
		end

		task.wait(3)
		pcall(teleportService.Teleport, teleportService, game.PlaceId, localPlayer)
	end))

	-- Count wins as they land.
	local winsValue = localPlayer:WaitForChild("leaderstats"):WaitForChild("Wins")
	local lastWins = winsValue.Value

	table.insert(connections, winsValue.Changed:Connect(function(value)
		if value > lastWins then
			AutoFarm.stats.wins += value - lastWins
		end

		lastWins = value
	end))

	interface = createInterface()

	task.spawn(farmLoop)
	task.spawn(godModeLoop)
	task.spawn(spinLoop)

	-- Status line refresh.
	task.spawn(function()
		while AutoFarm.alive and interface do
			interface.refresh()
			task.wait(UI_REFRESH_INTERVAL)
		end
	end)
end

---This is called when initialization errors.
---@param error string
local function onInitializeError(error)
	warn("[Potent] Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	AutoFarm.detach()
end

-- Detach any previous instance before starting a new one.
if shared.PotentAutoFarm and shared.PotentAutoFarm.detach then
	shared.PotentAutoFarm.detach()
end

shared.PotentAutoFarm = AutoFarm

xpcall(AutoFarm.init, onInitializeError)
