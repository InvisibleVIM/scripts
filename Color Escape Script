---Require a game module at identity 2 so it can't see our environment.
---@param module ModuleScript
---@return any
local function safeRequire(module)
	setthreadidentity(2)
	local ok, result = pcall(require, module)
	setthreadidentity(8)
	return ok and result or nil
end

---Round-trip time in seconds, so timeouts and danger windows scale with lag.
---@return number
local function getPing()
	local ok, milliseconds = pcall(function()
		return statsService.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)

	return ok and type(milliseconds) == "number" and milliseconds / 1000 or 0.1
end

---Seconds to wait for a wave of answers before giving up.
---@return number
local function getWaveTimeout()
	return math.clamp(getPing() * 2.5 + 0.3, 0.5, 8)
end

---How far ahead a target must stay blue: until the request reaches the server.
---@return number
local function getTargetWindow()
	return TARGET_DANGER_BASE + math.min(getPing() * 0.5, 1.5)
end

---@return BasePart?
local function getRoot()
	local character = localPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

---Our currencies table from the player data replica.
