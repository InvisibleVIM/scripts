end

local function makeEsp()
	return {
		tracer = newDrawing("Line", { Thickness = 1, Transparency = 0.8, ZIndex = 1 }),
		outline = newDrawing("Square", { Thickness = 3, Filled = false, Color = STEEL, Transparency = 0.7, ZIndex = 2 }),
		box = newDrawing("Square", { Thickness = 1.25, Filled = false, Transparency = 1, ZIndex = 3 }),
		healthBack = newDrawing("Square", { Filled = true, Color = STEEL, Transparency = 0.8, ZIndex = 2 }),
		healthFill = newDrawing("Square", { Filled = true, Transparency = 1, ZIndex = 3 }),
		name = newDrawing("Text", { Size = 14, Center = true, Outline = true, Font = Drawing.Fonts.Plex, Transparency = 1, ZIndex = 4 }),
		info = newDrawing("Text", { Size = 12, Center = true, Outline = true, Font = Drawing.Fonts.Plex, Color = MUTED, Transparency = 1, ZIndex = 4 }),
	}
end

local function hideEsp(entry)
	for _, drawing in pairs(entry) do
		drawing.Visible = false
	end
end

local function removeEsp(character)
	local entry = GrappleStrike.esp[character]
	if not entry then
		return
	end
	for _, drawing in pairs(entry) do
		pcall(drawing.Remove, drawing)
	end
	GrappleStrike.esp[character] = nil
end

---Each character's in-game color, falling back to gold.
---@param character Model
---@return Color3
local function colorOf(character)
	if not (Config.PlayerColors and characterBuilder and characterBuilder.ColorOf) then
		return GOLD
	end
	local key = character:GetAttribute("Color") or "PlayerCyan"
	if colorCache[key] == nil then
		local ok, color = pcall(characterBuilder.ColorOf, key)
		colorCache[key] = (ok and typeof(color) == "Color3") and color or false
	end
	return colorCache[key] or GOLD
end

---Screen-space bounds of a part's 8 corners, or nil if any is behind us.
---@param camera Camera
---@param part BasePart
---@return Vector2?, Vector2?
local function projectBounds(camera, part)
	local half = part.Size / 2
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, corner in ipairs(BOX_CORNERS) do
		local screen = camera:WorldToViewportPoint(part.CFrame:PointToWorldSpace(half * corner))
		if screen.Z <= 0 then
			return nil
		end
		minX, minY = math.min(minX, screen.X), math.min(minY, screen.Y)
		maxX, maxY = math.max(maxX, screen.X), math.max(maxY, screen.Y)
	end
	return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY)
end

local function healthColor(fraction)
	return Color3.fromHex("E5484D"):Lerp(Color3.fromHex("46C47E"), fraction)
end

local function stepEsp()
	local camera = workspace.CurrentCamera
	local mouse = userInputService:GetMouseLocation()

	fovCircle.Visible = Config.ShowFOV and (Config.SilentAim or Config.CameraAim)
	fovCircle.Position = mouse
	fovCircle.Radius = Config.FOV
	fovCircle.Color = currentTarget and TEXT or GOLD

	local characters = workspace:FindFirstChild("Characters")
	local seen = {}

	for _, character in ipairs(characters and characters:GetChildren() or {}) do
		local hitbox = character:FindFirstChild("Hitbox")
		local relevant, owner = isLiveEnemyLayer(character)
		if not (hitbox and relevant) then
			continue
		end
		seen[character] = true

		local entry = GrappleStrike.esp[character]
		if not entry then
			entry = makeEsp()
			GrappleStrike.esp[character] = entry
		end

		local position, size = projectBounds(camera, hitbox)
		if not Config.ESP or not position or (isTeammate(owner) and not Config.ShowTeammates) then
			hideEsp(entry)
			continue
		end

		local color = colorOf(character)
		local isLocked = character == currentTarget

		entry.box.Visible = Config.Boxes
		entry.box.Position = position
		entry.box.Size = size
		entry.box.Color = isLocked and TEXT or color
		entry.outline.Visible = Config.Boxes
		entry.outline.Position = position
		entry.outline.Size = size

		entry.name.Visible = Config.Names
		entry.name.Text = displayNameOf(owner, character)
		entry.name.Color = isLocked and GOLD or TEXT
		entry.name.Position = Vector2.new(position.X + size.X / 2, position.Y - 18)

		if Config.Health then
			local health = character:GetAttribute("Health") or 0
			local peak = math.max(peakHealth[character] or BASE_MAX_HEALTH, health)
			peakHealth[character] = peak
			local fraction = math.clamp(health / peak, 0, 1)
			entry.healthBack.Visible = true
			entry.healthBack.Position = Vector2.new(position.X - 6, position.Y - 1)
			entry.healthBack.Size = Vector2.new(4, size.Y + 2)
			entry.healthFill.Visible = true
			entry.healthFill.Color = healthColor(fraction)
			entry.healthFill.Position = Vector2.new(position.X - 5, position.Y + size.Y * (1 - fraction))
			entry.healthFill.Size = Vector2.new(2, size.Y * fraction)
		else
			entry.healthBack.Visible = false
			entry.healthFill.Visible = false
		end

		if Config.Info then
			local distance = math.floor((hitbox.Position - camera.CFrame.Position).Magnitude)
			local weapon = character:GetAttribute("Weapon")
			local health = math.floor(character:GetAttribute("Health") or 0)
			local parts = { tostring(health) .. " hp" }
			if type(weapon) == "string" and weapon ~= "" then
				table.insert(parts, weapon)
			end
			table.insert(parts, distance .. "m")
			entry.info.Visible = true
			entry.info.Text = table.concat(parts, "   ")
			entry.info.Position = Vector2.new(position.X + size.X / 2, position.Y + size.Y + 3)
		else
			entry.info.Visible = false
		end

		if Config.Tracers then
			local viewport = camera.ViewportSize
			entry.tracer.Visible = true
			entry.tracer.Color = color
			entry.tracer.From = Vector2.new(viewport.X / 2, viewport.Y - 2)
			entry.tracer.To = Vector2.new(position.X + size.X / 2, position.Y + size.Y)
		else
			entry.tracer.Visible = false
		end
	end

	-- Clean up characters that left, died or changed layer.
	for character, entry in pairs(GrappleStrike.esp) do
		if not seen[character] then
			if character.Parent then
				hideEsp(entry)
			else
				removeEsp(character)
			end
		end
	end
end

table.insert(GrappleStrike.connections, runService.RenderStepped:Connect(stepEsp))

