---Require a game module at identity 2 so it cannot see our environment.
---@param module ModuleScript
---@return any
local function safeRequire(module)
	if not module then
		return nil
	end
	setthreadidentity(2)
	local ok, result = pcall(require, module)
	setthreadidentity(8)
	return ok and result or nil
end

