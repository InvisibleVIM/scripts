local function create(class, props, children)
	local instance = Instance.new(class)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	return instance
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function tween(instance, props, duration)
	tweenService:Create(instance, TweenInfo.new(duration or 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function inputName(input)
	if input == Enum.UserInputType.MouseButton1 then
		return "Mouse 1"
	elseif input == Enum.UserInputType.MouseButton2 then
		return "Mouse 2"
	elseif input == Enum.UserInputType.MouseButton3 then
		return "Mouse 3"
	end
	return input.Name
end

