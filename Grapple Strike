local refreshKeybind = nil

local function inputMatches(input)
	return input.KeyCode == Config.AimKey or input.UserInputType == Config.AimKey
end

table.insert(GrappleStrike.connections, userInputService.InputBegan:Connect(function(input, gameProcessed)
	if rebinding then
		if input.KeyCode == Enum.KeyCode.Escape then
			rebinding = false
		elseif input.KeyCode ~= Enum.KeyCode.Unknown then
			rebinding = false
			Config.AimKey = input.KeyCode
		elseif input.UserInputType.Name:find("MouseButton") then
			rebinding = false
			Config.AimKey = input.UserInputType
		end
		if refreshKeybind and not rebinding then
			refreshKeybind()
		end
		return
	end

	if input.KeyCode == Enum.KeyCode.RightShift and GrappleStrike.panel then
		GrappleStrike.panel.Visible = not GrappleStrike.panel.Visible
		return
	end

	if userInputService:GetFocusedTextBox() or not inputMatches(input) then
		return
	end
	aimHeld = Config.AimMode == "Hold" or not aimHeld
end))

table.insert(GrappleStrike.connections, userInputService.InputEnded:Connect(function(input)
	if Config.AimMode == "Hold" and inputMatches(input) then
		aimHeld = false
	end
end))

