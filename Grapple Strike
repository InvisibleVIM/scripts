---Undo every hook, connection and drawing.
function GrappleStrike.detach()
	if weaponClient and originalAimPoint and weaponClient.AimPoint == silentAimPoint then
		weaponClient.AimPoint = originalAimPoint
	end
	pcall(runService.UnbindFromRenderStep, runService, "GrappleStrikeAim")
	for _, connection in ipairs(GrappleStrike.connections) do
		connection:Disconnect()
	end
	for character in pairs(GrappleStrike.esp) do
		removeEsp(character)
	end
	pcall(fovCircle.Remove, fovCircle)
	if GrappleStrike.gui then
		GrappleStrike.gui:Destroy()
	end
	if shared.GrappleStrike == GrappleStrike then
		shared.GrappleStrike = nil
	end
end

