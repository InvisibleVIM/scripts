---Resolve the Player or bot Folder that owns a character model.
---@param character Model
---@return Instance?
local function ownerOf(character)
	local userId = character:GetAttribute("UserId")
	if type(userId) == "number" then
		if userId > BOT_UID then
			return playersService:GetPlayerByUserId(userId)
		end
		local bots = replicatedStorage:FindFirstChild("Bots")
		for _, bot in ipairs(bots and bots:GetChildren() or {}) do
			if bot:GetAttribute("UserId") == userId then
				return bot
			end
		end
	end
	return playersService:GetPlayerFromCharacter(character)
end

---@param owner Instance?
---@return string
local function displayNameOf(owner, character)
	if owner and owner:IsA("Player") then
		return owner.DisplayName
	end
	return (owner and owner:GetAttribute("DisplayName")) or character.Name
end

local function layerOf(instance)
	return instance:GetAttribute("Layer") or 0
end

---@param owner Instance?
---@return boolean
local function isTeammate(owner)
	if replicatedStorage:GetAttribute("Mode") ~= "TDM" then
		return false
	end
	local myTeam = localPlayer:GetAttribute("Team")
	return owner ~= nil and myTeam ~= nil and myTeam ~= "" and owner:GetAttribute("Team") == myTeam
end

---A character is relevant when it is someone else's, alive and in our layer.
---@param character Model
---@return boolean, Instance?
local function isLiveEnemyLayer(character)
	if character == localPlayer.Character or character:GetAttribute("UserId") == localPlayer.UserId then
		return false
	end
	if character:GetAttribute("Dead") or (character:GetAttribute("Health") or 1) <= 0 then
		return false
	end
	if layerOf(character) ~= layerOf(localPlayer) then
		return false
	end
	return true, ownerOf(character)
end

local fallbackParams = RaycastParams.new()
fallbackParams.FilterType = Enum.RaycastFilterType.Exclude

---Where bullets leave from: the gun tip, else the camera.
---@return Vector3
local function shotOrigin()
	local character = localPlayer.Character
	local visuals = weaponClient and weaponClient.visuals
	if character and visuals and visuals.TipOf then
		local ok, tip = pcall(visuals.TipOf, character)
		if ok and typeof(tip) == "Vector3" then
			return tip
		end
	end
	return workspace.CurrentCamera.CFrame.Position
end

---Line of sight using the game's own world raycast params.
---@param character Model
---@param hitbox BasePart
---@return boolean
local function isVisible(character, hitbox)
	local controller = weaponClient and weaponClient.controller
	local origin = shotOrigin()
	local params = fallbackParams
	if controller and controller.WorldParams then
		local ok, worldParams = pcall(controller.WorldParams)
		if ok and worldParams then
			params = worldParams
		end
	else
		fallbackParams.FilterDescendantsInstances = { localPlayer.Character }
	end

	local result = workspace:Raycast(origin, hitbox.Position - origin, params)
	if not result or result.Instance:IsDescendantOf(character) then
		return true
	end
	if controller and controller.CharacterOf then
		local ok, owner = pcall(controller.CharacterOf, result.Instance)
		return ok and owner == character
	end
	return false
end

---Projectile speed of the equipped weapon, if it is a rocket.
---@return number?
local function equippedProjectileSpeed()
	local character = localPlayer.Character
	local weaponName = character and character:GetAttribute("Weapon")
	local def = weaponName and weaponDefs[weaponName]
	return def and def.Kind == "rocket" and def.Speed or nil
end

---World point to aim at on a target, with optional rocket lead.
---@param character Model
---@param origin Vector3
---@return Vector3
local function aimPointOf(character, origin)
	local hitbox = character.Hitbox
	local offset = AIM_POINT_OFFSETS[Config.AimPoint] or 0
	local point = hitbox.CFrame:PointToWorldSpace(Vector3.new(0, hitbox.Size.Y * offset, 0))

	local speed = Config.LeadRockets and equippedProjectileSpeed()
	if speed then
		local root = character:FindFirstChild("Root") or hitbox
		point = point + root.AssemblyLinearVelocity * ((point - origin).Magnitude / speed)
	end
	return point
end

---Best target inside the FOV circle.
---@return Model?
local function getTarget()
	local characters = workspace:FindFirstChild("Characters")
	if not characters then
		return nil
	end

	local camera = workspace.CurrentCamera
	local mouse = userInputService:GetMouseLocation()
	local best, bestScore = nil, math.huge

	for _, character in ipairs(characters:GetChildren()) do
		local hitbox = character:FindFirstChild("Hitbox")
		if not hitbox then
			continue
		end
		local relevant, owner = isLiveEnemyLayer(character)
		if not relevant or isTeammate(owner) then
			continue
		end
		if Config.SkipProtected and character:GetAttribute("Protected") then
			continue
		end

		local screen, onScreen = camera:WorldToViewportPoint(hitbox.Position)
		if not onScreen then
			continue
		end
		local screenDistance = (Vector2.new(screen.X, screen.Y) - mouse).Magnitude
		if screenDistance > Config.FOV then
			continue
		end
		if Config.WallCheck and not isVisible(character, hitbox) then
			continue
		end

		local score = Config.Priority == "Crosshair" and screenDistance or (hitbox.Position - camera.CFrame.Position).Magnitude
		if score < bestScore then
			best, bestScore = character, score
		end
	end

	return best
end

-- ============================================================
--  Silent aim: replace WeaponClient.AimPoint (feeds every weapon)
-- ============================================================

local originalAimPoint = weaponClient and weaponClient.AimPoint

---Keep the server's replicated Aim direction consistent with the shot.
---@param point Vector3
local function replicateAim(point)
	if not aimRemote then
		return
	end
	local direction = point - workspace.CurrentCamera.CFrame.Position
	if direction.Magnitude > 0.1 then
		aimRemote:FireServer(direction.Unit)
	end
end

---Swap the aim point to the target when silent aim applies.
local function silentAimPoint(range, ...)
	if not Config.SilentAim then
		return originalAimPoint(range, ...)
	end

	local ok, point = pcall(function()
		local target = currentTarget or getTarget()
		if not target or not target.Parent or not target:FindFirstChild("Hitbox") then
			return nil
		end

		-- The 600-range call is the per-frame gun visual; everything else is a shot.
		local isShot = range ~= VISUAL_AIM_RANGE
		if isShot and math.random(1, 100) > Config.HitChance then
			return nil
		end

		local aimPoint = aimPointOf(target, shotOrigin())
		if isShot then
			replicateAim(aimPoint)
		end
		return aimPoint
	end)

	if ok and point then
		return point, nil
	end
	return originalAimPoint(range, ...)
end

if weaponClient and originalAimPoint then
	weaponClient.AimPoint = silentAimPoint
end

-- ============================================================
--  Camera aim: steer CameraRig yaw/pitch (camera is Scriptable)
-- ============================================================

---@param dt number
local function stepCameraAim(dt)
	if not (Config.CameraAim and aimHeld and cameraRig and currentTarget) then
		return
	end
	if not currentTarget:FindFirstChild("Hitbox") then
		return
	end

	local origin = workspace.CurrentCamera.CFrame.Position
	local direction = (aimPointOf(currentTarget, origin) - origin).Unit
	local goalYaw = math.atan2(-direction.X, -direction.Z)
	local goalPitch = math.clamp(math.asin(math.clamp(direction.Y, -1, 1)) + CAMERA_TILT, MIN_PITCH, MAX_PITCH)

	-- Frame-rate independent easing; smoothing 0 snaps.
	local alpha = 1 - math.clamp(Config.Smoothing, 0, 0.97) ^ (dt * 60)
	local yawDelta = (goalYaw - cameraRig.yaw + math.pi) % (2 * math.pi) - math.pi
	cameraRig.yaw = cameraRig.yaw + yawDelta * alpha
	cameraRig.pitch = cameraRig.pitch + (goalPitch - cameraRig.pitch) * alpha
end

runService:BindToRenderStep("GrappleStrikeAim", Enum.RenderPriority.Camera.Value - 1, function(dt)
	if Config.SilentAim or Config.CameraAim then
		currentTarget = getTarget()
	else
		currentTarget = nil
	end
	stepCameraAim(dt)
end)

