		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = STEEL,
		BorderSizePixel = 0,
		Parent = row,
	}, {
		corner(6),
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
		create("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }),
	})
	local buttons = {}
	local function refresh()
		for option, button in pairs(buttons) do
			local active = Config[key] == option
			tween(button, { BackgroundTransparency = active and 0 or 1, TextColor3 = active and GOLD or MUTED }, 0.12)
		end
	end
	for index, option in ipairs(options) do
		local button = create("TextButton", {
			Size = UDim2.fromOffset(0, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = RAISED,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			FontFace = BODY_FONT,
			Text = option,
			TextColor3 = MUTED,
			TextSize = 13,
			AutoButtonColor = false,
			LayoutOrder = index,
			Parent = group,
		}, { corner(4), create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
		buttons[option] = button
		button.MouseButton1Click:Connect(function()
			Config[key] = option
			refresh()
		end)
	end
	refresh()
end

