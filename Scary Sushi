---Force a prompt on client-side. The server re-sends prompt states with ActivatePrompt, and transitions can
---leave a prompt disabled locally even though the server still accepts it.
---@param prompt ProximityPrompt?
---@return ProximityPrompt?
local function enablePrompt(prompt)
	if prompt then
		prompt.Enabled = true
	end
	return prompt
end

---Fire a prompt from on top of it until verify() passes.
---@param prompt ProximityPrompt?
---@param verify function
---@param attempts number?
---@param patience number? Seconds to wait for verify() before firing again (default ~0.18).
---@return boolean
local function firePromptUntil(prompt, verify, attempts, patience)
	if not prompt then
		return false
	end

	for _ = 1, attempts or 6 do
		if verify() then
			return true
		end

		if not prompt.Parent then
			break
		end

		local cframe = promptCFrame(prompt)
		if cframe then
			teleportTo(cframe + Vector3.new(0, WORK_HEIGHT, 0))
		end

		task.wait()
		pcall(fireproximityprompt, prompt)

		-- A re-fire before the server answers counts twice on some prompts (placeboards), so be patient there.
		local deadline = os.clock() + (patience or 0.3)
		repeat
			if verify() then
				return true
			end
			task.wait(0.03)
		until os.clock() >= deadline
	end

	return verify()
end

