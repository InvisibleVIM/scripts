	end
	return nil
end

---Chef loop: one scheduling decision per tick, idles only when nothing can be done.
local function runChef()
	local flushed, flushError = pcall(flushMachines)
	if not flushed then
		logWarn("Flush error: " .. tostring(flushError))
	end

	while ScarySushi.running do
		local success, result = pcall(step)
		if not success then
			logWarn("Step error: " .. tostring(result))
			task.wait(0.25)
		elseif not result then
			task.wait(IDLE_TICK)
		end
	end
end

---Debug snapshot of the scheduler state (orders, items, machine tasks, stash).
---@return table
function ScarySushi.dump()
	local snapshot = { tasks = {}, orders = {}, stash = {}, carried = carriedOrder and carriedOrder.id or nil, course = currentCourse }
	for key, taskData in pairs(activeTasks) do
		table.insert(snapshot.tasks, string.format("%s: %s order=%s held=%s ready=%s age=%.1f", key, taskData.itemName,
			taskData.order and taskData.order.id or "nil", tostring(taskData.held), tostring(taskData.readySeen), os.clock() - taskData.startedAt))
	end
	for _, order in pairs(orders) do
		local items = {}
		for _, item in ipairs(order.items) do
			table.insert(items, item.name .. "=" .. item.state)
		end
		table.insert(snapshot.orders, string.format("%s plate=%s delivered=%s [%s]", order.id, tostring(order.plate), tostring(order.delivered), table.concat(items, ",")))
	end
	for index, entry in pairs(stash) do
		table.insert(snapshot.stash, index .. "=" .. tostring(entry.item))
	end
	return snapshot
end

---Stop the farm (keeps the UI, fly and camera).
function ScarySushi.stopFarm()
	ScarySushi.running = false
	for _, connection in ipairs(farmConnections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(farmConnections)
	setHover(false)
end

---Run the game's SkipCutscene handlers in their own threads. They start with task.wait, which a firesignal
---thread can't do, so firesignal alone errors inside them before the cutscene is ended.
---@param course number
local function runSkipHandlers(course)
	local skip = events and events:FindFirstChild("SkipCutscene")
	if not skip then
		return
	end
	if getconnections then
		local ok, connectionList = pcall(getconnections, skip.OnClientEvent)
		for _, connection in ipairs(ok and connectionList or {}) do
			local handler = connection.Function
			if type(handler) == "function" then
				task.spawn(pcall, handler, course)
			end
		end
	elseif firesignal then
		pcall(firesignal, skip.OnClientEvent, course)
	end
end

---Drop the game's own FinishedCutscene for a course we already reported. The hook is installed once per
---client and reads its block list from getgenv, so re-executing the script doesn't stack hooks.
---@param course number
---@return boolean
local function guardCutsceneReport(course)
	local env = getgenv and getgenv()
	if not (env and hookmetamethod and getnamecallmethod and checkcaller) then
		return false
	end

	env.PotentCutsceneBlocked = env.PotentCutsceneBlocked or {}
	env.PotentCutsceneBlocked[course] = true

	if not env.PotentCutsceneHooked then
		env.PotentCutsceneHooked = true
		local original
		original = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
			if not checkcaller() and getnamecallmethod() == "FireServer" and typeof(self) == "Instance"
				and self.Name == "FinishedCutscene" then
				local blocked = getgenv().PotentCutsceneBlocked
				local reported = tonumber((...))
				if blocked and reported and blocked[reported] then
					blocked[reported] = nil
					return nil
				end
			end
			return original(self, ...)
		end))
	end
	return true
end

---Start the farm for the current chapter.
function ScarySushi.startFarm()
	if ScarySushi.running or not chapter then
		return
	end

	if chapter.startCourse then
		currentCourse = math.max(currentCourse, chapter.startCourse)
	end

	-- Servers keep running after an escape; if we already escaped (or died) here, this server can't give a win.
	if not chapter.noEscapeCheck and hasEscaped() then
		logWarn("Already escaped in this server, hopping to a fresh one.")
		return requeue()
	end

	local killed = localPlayer:FindFirstChild("killed")
	if killed and killed.Value == true then
		logWarn("Already dead in this server, hopping to a fresh one.")
		return requeue()
	end

	ScarySushi.running = true
	endingStarted = false
	lastProgressAt = os.clock()

	-- Watchdog: a server where nothing happens for Tune.STALL_REQUEUE seconds (lost run, unassigned station, a stuck
	-- loop) can't give a win, so move on instead of sitting there.
	task.spawn(function()
		while ScarySushi.running and not ScarySushi.detached do
			task.wait(5)
			if ScarySushi.running and not endingStarted and os.clock() - lastProgressAt > Tune.STALL_REQUEUE then
				logWarn(string.format("No orders or deliveries for %ds, requeueing.", Tune.STALL_REQUEUE))
				ScarySushi.stopFarm()
				requeue()
				break
			end
		end
	end)

	-- Tell the server a course's cutscene is done as soon as it starts (chase cutscenes past the last course excluded).
	table.clear(reportedCutscenes)
	table.clear(courseStartedAt)
	if getgenv and getgenv().PotentCutsceneBlocked then
		table.clear(getgenv().PotentCutsceneBlocked)
	end
	local function reportCutsceneDone(course)
		course = tonumber(course)
		if not CUTSCENE_SKIP or not course or course < 1 or course > Tune.LAST_COURSE or reportedCutscenes[course] then
			return
		end
		-- Some courses need their cutscene: e.g. Chapter 2's beetles spawn on a timer during it.
		if chapter.keepCutscene and chapter.keepCutscene[course] then
			return
		end
		reportedCutscenes[course] = true
		local startedAt = os.clock()
		task.spawn(function()
			-- Courses whose cutscene the game lets you skip right away: replay its skip signal locally, so the
			-- cutscene script ends the cutscene and reports FinishedCutscene itself, once, with camera/UI tidy.
			if chapter.cleanSkip and chapter.cleanSkip[course] then
				for _, at in ipairs(Tune.CUTSCENE_SKIP_TRIES) do
					task.wait(math.max(0, startedAt + at - os.clock()))
					if not ScarySushi.running or courseStartedAt[course] then
						break
					end
					runSkipHandlers(course)
				end
				task.wait(1)
				if courseStartedAt[course] then
					log(string.format("Skipped cutscene %d (course began %.1fs in).", course, courseStartedAt[course] - startedAt))
					return
				end
			else
				task.wait(math.max(0, startedAt + Tune.CUTSCENE_REPORT_DELAY - os.clock()))
			end

			-- Otherwise (the leaderboard part of cutscenes 2-4 can't be skipped) tell the server directly, and drop
			-- the game's own report when its cutscene finishes: a second FinishedCutscene re-runs the course setup
			-- mid-course (plates refuse food, stashes get wiped).
			local remote = events and events:FindFirstChild("FinishedCutscene")
			if remote and ScarySushi.running then
				local guarded = guardCutsceneReport(course)
				remote:FireServer(course)
				log(string.format("Reported cutscene %d as finished%s.", course, guarded and "" or " (no duplicate guard)"))
			end
		end)
	end

	-- The server clears both placeboards when a course ends, so board stash entries from before then are gone.
	local function forgetBoardStash(course)
		courseDeliveries = 0
		if not course or course < 2 then
			return
		end
		local endedAt = os.clock()
		local function forget(late)
			local dropped = 0
			local boards = getPlaceboards()
			for index, entry in pairs(stash) do
				local active = boards[index] and boards[index]:FindFirstChild("isActive")
				local empty = not (active and active.Value)
				if (not late and entry.at <= endedAt) or empty then
					stash[index] = nil
					dropped += 1
				end
			end
			if dropped > 0 then
				log("Course " .. (course - 1) .. " ended: forgot " .. dropped .. " placeboard stash entr" .. (dropped == 1 and "y" or "ies") .. " (wiped).")
			end
		end
		forget(false)
		task.delay(2, forget, true)
	end

	-- Each course's cutscene marks the next course early, so pre-loading and the first sludge use the transition.
	for course = 1, 4 do
		onEvent("PlayCutscene" .. course, function()
			forgetBoardStash(course)
			reportCutsceneDone(course)
			currentCourse = math.max(currentCourse, course)
			cutsceneAt = os.clock()
			if course == SLUDGE_COURSE then
				sludgeRetryAt = 0
			end
			log("Course " .. course .. " cutscene, preparing early.")
		end)
	end

	-- Chapter 2 uses a single PlayCutscene remote; log its argument while mapping.
	onEvent("PlayCutscene", function(...)
		cutsceneAt = os.clock()
		local args = { ... }
		log("PlayCutscene(" .. tostring(args[1]) .. ", " .. tostring(args[2]) .. ")")
		local nextCourse = tonumber(args[1])
		forgetBoardStash(nextCourse)
		reportCutsceneDone(nextCourse)
		if nextCourse and nextCourse > currentCourse then
			currentCourse = nextCourse
		end
	end)

	-- The sludge machine's own start/take echoes: the ground truth for whether a cup is in flight.
	onEvent("RunEggProcessor", function()
		sludgeLeverAt = os.clock()
	end)
	onEvent("SludgeTaken", function()
		sludgeTakenAt = os.clock()
	end)

	onEvent("CourseStart", function(course)
		local courseNumber = tonumber(course)
		if courseNumber and not courseStartedAt[courseNumber] then
			courseStartedAt[courseNumber] = os.clock()
		end
		-- With cutscenes reported early, the client's own (late) course signals can arrive out of order.
		currentCourse = math.max(currentCourse, courseNumber or 0)
		local parts = {}
		for machine in pairs(chapter.memory) do
			local memory = getMemory(machine)
			table.insert(parts, machine .. "=" .. tostring(memory and memory.Value))
		end
		for index, entry in pairs(stash) do
			table.insert(parts, "stash" .. index .. "=" .. tostring(entry.item))
		end
		log("Course " .. tostring(course) .. " started. " .. table.concat(parts, " "))
	end)

	-- Log the server's verdict on every order; a failed order leaves its food on the plate.
	for _, eventName in ipairs({ "CompleteOrder", "FailOrder" }) do
		onEvent(eventName, function(orderId)
			log("Server " .. eventName .. "(" .. tostring(orderId) .. ")")
			lastProgressAt = os.clock()

			if eventName == "FailOrder" then
				for _, order in pairs(orders) do
					if order.id == tostring(orderId) and not order.failed then
						if order.plate then
							dirtyPlates[order.plate] = true
						end
						order.failed = true
						order.plate = nil
					end
				end
			end
		end)
	end

	-- Deaths matter in Chapter 2: a failed order or a monster costs a life; with none left the run is over.
	onEvent("Died", function(...)
		local args = { ... }
		local livesLeft = tonumber(args[2])
		logWarn("Died to " .. tostring(args[1]) .. ", lives left " .. tostring(livesLeft))
		if livesLeft == 0 and ScarySushi.running then
			logWarn("Out of lives, requeueing.")
			ScarySushi.stopFarm()
			task.delay(2, requeue)
		end
	end)

	-- Chapter 1's chase begins with ReleaseTheBlobs.
	if chapter.chaseEvent then
		onEvent(chapter.chaseEvent, function()
			task.spawn(runEnding)
		end)

		local blobs = resolvePath("Chase", "Blobs")
		if blobs then
			table.insert(farmConnections, blobs.ChildAdded:Connect(function()
				task.spawn(runEnding)
			end))
		end
	end

	-- Chapter 2's chase is armed when the kitchen's AlterGeom touch part becomes touchable.
	if chapter.key == "Chapter2" then
		task.spawn(function()
			while ScarySushi.running do
				local touchPartInstance = resolvePath("Kitchen", "AlterGeom", "TouchPart")
				if touchPartInstance and touchPartInstance:FindFirstChildOfClass("TouchTransmitter") and currentCourse >= 4 then
					task.spawn(runEnding)
					break
				end
				task.wait(0.25)
			end
		end)
	end

	-- Reroll the server if someone else is here before our first delivery.
	if SOLO_ONLY then
		local function checkSolo()
			if ScarySushi.running and ScarySushi.delivered == 0 and #playersService:GetPlayers() > 1 then
				logWarn("Not solo, rerolling server.")
				ScarySushi.stopFarm()
				requeue()
			end
		end

		table.insert(farmConnections, playersService.PlayerAdded:Connect(checkSolo))
		checkSolo()
	end

	-- Skip cutscenes as soon as the vote opens.
	task.spawn(function()
		while ScarySushi.running do
			trySkipCutscene()
			task.wait(0.25)
		end
	end)

	setHover(true)
	task.spawn(runChef)
	log("Auto chef running.")
end

---Disconnect everything and stop all loops (used on re-execution).
function ScarySushi.detach()
	ScarySushi.detached = true
	-- Each step on its own, so one failure still lets the rest (connections, UI) clean up.
	pcall(ScarySushi.stopFarm)
	pcall(Fly.stop)

	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)

	if uiInstance then
		uiInstance:Destroy()
		uiInstance = nil
	end
end

---Teleport from the lobby into whichever chapter is toggled on.
local function routeFromLobby()
	if not LOBBY_PLACE_IDS[game.PlaceId] then
		return
	end

	task.delay(Tune.LOBBY_TELEPORT_DELAY, function()
		if ScarySushi.detached or not LOBBY_PLACE_IDS[game.PlaceId] then
			return
		end

		if settings.Chapter1 then
			log("Lobby, teleporting into Chapter 1.")
			teleportService:Teleport(CHAPTER1_PLACE_ID, localPlayer)
		elseif settings.Chapter2 then
			log("Lobby, teleporting into Chapter 2.")
			teleportService:Teleport(CHAPTER2_PLACE_ID, localPlayer)
		elseif settings.Survival then
			log("Lobby, teleporting into Survival.")
			teleportService:Teleport(SURVIVAL_PLACE_ID, localPlayer)
		end
	end)
end

---React to a toggle change: save it, then start/stop the farm, fly, or route from the lobby.
---@param key string
local function onToggleChanged(key)
	saveSettings()

	if key == "Fly" then
		applyFly()
		return
	end

	if inGame() and chapter then
		if settings[chapter.key] then
			ScarySushi.startFarm()
		else
			ScarySushi.stopFarm()
		end
	end

	if settings[key] then
		routeFromLobby()
	end
end

