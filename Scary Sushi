---Build the small toggle panel (Chapter 1, Chapter 2, Fly), draggable by its header.
local function buildUi()
	-- Leftover UI from a copy that couldn't clean up after itself.
	local host = (gethui and gethui()) or coreGui
	for _, child in ipairs(host:GetChildren()) do
		if child.Name == "PotentScarySushi" and child:IsA("ScreenGui") then
			child:Destroy()
		end
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PotentScarySushi"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = (gethui and gethui()) or coreGui
	uiInstance = screenGui

	local mainFrame = Instance.new("Frame")
	mainFrame.BackgroundColor3 = Tune.PANEL_BG
	mainFrame.BorderSizePixel = 0
	mainFrame.Position = UDim2.new(0, 24, 0, 96)
	mainFrame.Size = UDim2.new(0, 220, 0, 218)
	mainFrame.Active = true
	mainFrame.Parent = screenGui
	Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Transparency = 0.5
	stroke.Parent = mainFrame

	local header = Instance.new("Frame")
	header.BackgroundColor3 = Tune.ACCENT
	header.BorderSizePixel = 0
	header.Size = UDim2.new(1, 0, 0, 38)
	header.Parent = mainFrame
	Instance.new("UICorner", header).CornerRadius = UDim.new(0, 10)

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Tune.ACCENT, Tune.ACCENT_DARK)
	gradient.Rotation = 90
	gradient.Parent = header

	-- Square off the header's bottom corners.
	local mask = Instance.new("Frame")
	mask.BackgroundColor3 = Tune.ACCENT_DARK
	mask.BorderSizePixel = 0
	mask.Position = UDim2.new(0, 0, 1, -10)
	mask.Size = UDim2.new(1, 0, 0, 10)
	mask.ZIndex = 0
	mask.Parent = header

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.new(0, 12, 0, 0)
	title.Size = UDim2.new(1, -24, 1, 0)
	title.Font = Enum.Font.GothamBold
	title.Text = "Scary Sushi"
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextSize = 15
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 2
	title.Parent = header

	local body = Instance.new("Frame")
	body.BackgroundTransparency = 1
	body.Position = UDim2.new(0, 0, 0, 38)
	body.Size = UDim2.new(1, 0, 1, -38)
	body.Parent = mainFrame

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = body

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = body

	local toggles = {}

	---One clickable row with a pill switch.
	local function makeToggle(labelText, key, order)
		local row = Instance.new("TextButton")
		row.BackgroundColor3 = Tune.ROW_BG
		row.BorderSizePixel = 0
		row.AutoButtonColor = false
		row.Text = ""
		row.LayoutOrder = order
		row.Size = UDim2.new(1, 0, 0, 34)
		row.Parent = body
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Position = UDim2.new(0, 12, 0, 0)
		label.Size = UDim2.new(1, -70, 1, 0)
		label.Font = Enum.Font.GothamMedium
		label.Text = labelText
		label.TextColor3 = Tune.TEXT_COLOR
		label.TextSize = 14
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = row

		local track = Instance.new("Frame")
		track.AnchorPoint = Vector2.new(1, 0.5)
		track.Position = UDim2.new(1, -10, 0.5, 0)
		track.Size = UDim2.new(0, 40, 0, 20)
		track.BackgroundColor3 = Tune.OFF_COLOR
		track.BorderSizePixel = 0
		track.Parent = row
		Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

		local knob = Instance.new("Frame")
		knob.AnchorPoint = Vector2.new(0, 0.5)
		knob.Position = UDim2.new(0, 3, 0.5, 0)
		knob.Size = UDim2.new(0, 14, 0, 14)
		knob.BackgroundColor3 = Color3.fromRGB(245, 245, 248)
		knob.BorderSizePixel = 0
		knob.Parent = track
		Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

		local function render()
			local on = settings[key]
			local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			tweenService:Create(track, info, { BackgroundColor3 = on and Tune.ON_COLOR or Tune.OFF_COLOR }):Play()
			tweenService:Create(knob, info, { Position = on and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }):Play()
		end

		toggles[key] = render
		row.MouseButton1Click:Connect(function()
			settings[key] = not settings[key]

			-- Only one mode can run at a time.
			if settings[key] and MODE_KEYS[key] then
				for otherKey in pairs(MODE_KEYS) do
					if otherKey ~= key and settings[otherKey] then
						settings[otherKey] = false
						onToggleChanged(otherKey)
					end
				end
			end

			for _, renderToggle in pairs(toggles) do
				renderToggle()
			end
			onToggleChanged(key)
		end)
		render()
	end

	makeToggle("Chapter 1", "Chapter1", 1)
	makeToggle("Chapter 2", "Chapter2", 2)
	makeToggle("Survival", "Survival", 3)
	makeToggle("Fly", "Fly", 4)

	-- Drag by the header.
	local dragging, dragStart, startPosition = false, nil, nil
	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = mainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	table.insert(connections, userInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
		end
	end))
end

---Set up UI, camera, fly and the farm for wherever we are.
function ScarySushi.init()
	loadSettings()
	chapter = buildChapter()
	buildUi()

	-- Anti-AFK.
	table.insert(connections, localPlayer.Idled:Connect(function()
		virtualUser:CaptureController()
		virtualUser:ClickButton2(Vector2.zero)
	end))

	applyThirdPerson()
	applyFly()

	-- Re-apply fly and the farm hover after a respawn.
	table.insert(connections, localPlayer.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart")
		task.wait(0.5)
		applyFly()
		if ScarySushi.running then
			setHover(true)
		end
	end))

	if LOBBY_PLACE_IDS[game.PlaceId] then
		routeFromLobby()
		return
	end

	if chapter and settings[chapter.key] then
		ScarySushi.startFarm()
	end
end

Tune.INIT_RETRIES = 3
Tune.INIT_RETRY_DELAY = 5
local initAttempts = 0

---This is called when initialization errors. A failed start shouldn't cost the whole server, so tear down
---whatever half-started and try again a few times.
---@param error string
local function onInitializeError(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	pcall(logWarn, "Init failed: " .. tostring(error))
	pcall(ScarySushi.detach)

	initAttempts += 1
	if initAttempts > Tune.INIT_RETRIES then
		pcall(logWarn, "Init failed " .. initAttempts .. " times, giving up in this server.")
		return
	end

	task.delay(Tune.INIT_RETRY_DELAY, function()
		-- A newer copy took over in the meantime.
		if shared.PotentScarySushi ~= ScarySushi then
			return
		end
		pcall(log, "Retrying init (attempt " .. (initAttempts + 1) .. ").")
		ScarySushi.detached = false
		xpcall(ScarySushi.init, onInitializeError)
	end)
end

-- A previous copy may be broken (e.g. one that failed to start), so its teardown must not stop this one.
if shared.PotentScarySushi then
	local ok, err = pcall(shared.PotentScarySushi.detach)
	if not ok then
		warn("Previous copy failed to detach: " .. tostring(err))
	end
end

if shared.PotentChapterOne then
	pcall(shared.PotentChapterOne.detach)
	shared.PotentChapterOne = nil
end

shared.PotentScarySushi = ScarySushi

-- Safely initialize the script as well as handle errors.
xpcall(ScarySushi.init, onInitializeError)

return ScarySushi
