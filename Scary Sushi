---Return the player's own assigned workstation model.
---@return Model?
local function getWorkstation()
	local value = localPlayer:FindFirstChild("Workstation")
	local model = value and value.Value
	if model and model.Parent and model:FindFirstChild("RiceCooker", true) then
		lastWorkstation = model
		stationLostAt = nil
		return model
	end

	-- The server can drop ownership at course transitions; keep driving the last station we owned.
	if not stationLostAt then
		stationLostAt = os.clock()
		log("Workstation unassigned by server, falling back to last owned station.")
	end

	if lastWorkstation and lastWorkstation.Parent and lastWorkstation:FindFirstChild("RiceCooker", true) then
		return lastWorkstation
	end

	-- Last resort: our equipped station is the only one not named EmptyWorkstation.
	local kitchen = workspace:FindFirstChild("Kitchen")
	local spawns = kitchen and kitchen:FindFirstChild("WorkstationSpawns")
	for _, slot in ipairs(spawns and spawns:GetChildren() or {}) do
		for _, station in ipairs(slot:GetChildren()) do
			if station.Name ~= "EmptyWorkstation" and station:FindFirstChild("RiceCooker", true) then
				lastWorkstation = station
				return station
			end
		end
	end
	return nil
end

---Find a named part of the station, tolerating stations that nest their machines differently.
---@param workstation Instance
---@param name string
---@return Instance?
local function stationChild(workstation, name)
	return workstation:FindFirstChild(name) or workstation:FindFirstChild(name, true)
end

---Return the insert prompt, finish prompt and isReady value for a station machine.
---@param machine string
---@return ProximityPrompt?, ProximityPrompt?, BoolValue?
local function getStationParts(machine)
	local workstation = getWorkstation()
	if not workstation then
		return nil
	end

	if machine == "Rice" then
		local cooker = stationChild(workstation, "RiceCooker")
		local pot = cooker and cooker:FindFirstChild("Pot")
		return pot and pot:FindFirstChild("RiceProximetyPrompt"), pot and pot:FindFirstChild("FinishedProximetyPrompt"), pot and pot:FindFirstChild("isReady")
	end

	if machine == "Nori" then
		local noriMachine = stationChild(workstation, "NoriMachine")
		local funnel = noriMachine and noriMachine:FindFirstChild("Funnel")
		local noriEnd = noriMachine and noriMachine:FindFirstChild("NoriEnd")
		return funnel and funnel:FindFirstChild("ProximityPrompt"), noriEnd and noriEnd:FindFirstChild("ProximityPrompt"), noriMachine and noriMachine:FindFirstChild("isReady")
	end

	if machine == "Cut" then
		local board = stationChild(workstation, "CuttingBoard")
		return board and board:FindFirstChild("ProximityPrompt"), board and board:FindFirstChild("FinishedProximityPrompt"), board and board:FindFirstChild("isReady")
	end

	return nil
end

---Return the insert prompt, finish prompt and ready value for any machine, including chapter-specific ones.
---@param machine string
---@return ProximityPrompt?, ProximityPrompt?, BoolValue?
local function getMachineParts(machine)
	local custom = chapter.machineParts and chapter.machineParts[machine]
	if custom then
		return custom()
	end
	return getStationParts(machine)
end

---Return the instance (board or pot) that owns a machine's CookedFood / busy flags.
---@param machine string
---@return Instance?
local function getMachineBody(machine)
	local workstation = getWorkstation()
	if not workstation then
		return nil
	end

	if machine == "Cut" then
		return stationChild(workstation, "CuttingBoard")
	end

	if machine == "Rice" then
		local cooker = stationChild(workstation, "RiceCooker")
		return cooker and cooker:FindFirstChild("Pot")
	end

	if machine == "Nori" then
		return stationChild(workstation, "NoriMachine")
	end
	return nil
end

---A machine's remembered output (CookedFood StringValue), if it's a memory machine in this chapter.
---@param machine string
---@return StringValue?
local function getMemory(machine)
	if not chapter.memory[machine] then
		return nil
	end

	local body = getMachineBody(machine)
	return body and body:FindFirstChild("CookedFood")
end

---Whether the server still has a machine busy cooking.
---@param machine string
---@return boolean
local function isMachineBusy(machine)
	local body = getMachineBody(machine)
	if not body then
		return false
	end

	local flag = body:FindFirstChild("isActive") or body:FindFirstChild("isCooking")
	return flag ~= nil and flag.Value == true
end

---Find an enabled prompt among spawner nodes with a given name, under a folder.
---@param folder Instance?
---@param spawnerName string
---@return ProximityPrompt?
local function findSpawnerPrompt(folder, spawnerName)
	if not folder then
		return nil
	end

	for _, node in ipairs(folder:GetChildren()) do
		if node.Name ~= spawnerName then
			continue
		end

		local prompt = node:FindFirstChildWhichIsA("ProximityPrompt", true)
		if prompt and prompt.Enabled then
			return prompt
		end
	end
	return nil
end

---Search a folder for an enabled prompt whose text or ancestry matches all keywords.
---@param folder Instance?
---@param keywords table
---@return ProximityPrompt?
local function findPromptByKeywords(folder, keywords)
	if not folder then
		return nil
	end

	for _, descendant in ipairs(folder:GetDescendants()) do
		if not descendant:IsA("ProximityPrompt") or not descendant.Enabled then
			continue
		end

		local text = (descendant.ActionText .. " " .. descendant.ObjectText .. " " .. descendant.Parent.Name .. " " .. (descendant.Parent.Parent and descendant.Parent.Parent.Name or "")):lower()
		local matches = true
		for _, keyword in ipairs(keywords) do
			if not text:find(keyword, 1, true) then
				matches = false
				break
			end
		end

		if matches then
			return descendant
		end
	end
	return nil
end

---Return a plate on our workstation by side.
---@param side string
---@return BasePart?
local function getPlate(side)
	local workstation = getWorkstation()
	local holder = workstation and stationChild(workstation, side)
	return holder and holder:FindFirstChild("Plate")
end

---Return the station's placeboards (put-down spots) in a stable order.
---@return table
local deadBoards = {}

local function getPlaceboards()
	local workstation = getWorkstation()
	local holder = workstation and stationChild(workstation, "PlaceBoards")
	local boards = {}
	for _, board in ipairs(holder and holder:GetChildren() or {}) do
		if board:FindFirstChild("PlacePrompt") and board:FindFirstChild("PickupPrompt") and not deadBoards[board] then
			table.insert(boards, board)
		end
	end

	table.sort(boards, function(a, b)
		return a:GetPivot().Position.X + a:GetPivot().Position.Z < b:GetPivot().Position.X + b:GetPivot().Position.Z
	end)
	return boards
end

---Return the kitchen trash prompt.
---@return ProximityPrompt?
local function getTrashPrompt()
	local kitchen = workspace:FindFirstChild("Kitchen")
	local cans = kitchen and kitchen:FindFirstChild("Trashcans")
	local can = cans and cans:FindFirstChild("TrashCan")
	local promptPart = can and can:FindFirstChild("PromptPart")
	return promptPart and promptPart:FindFirstChildWhichIsA("ProximityPrompt")
end

---Throw away whatever is in hand.
---@return boolean
local function trashHeld()
	return firePromptUntil(getTrashPrompt(), function()
		return not isHolding()
	end, 6)
end

---Mirror the live order GUI into our order table. Frames are parented only after all
---ingredient icons are cloned in, so a parented frame is always complete.
local function syncOrders()
	local gui = localPlayer.PlayerGui:FindFirstChild("Orders")
	local container = gui and gui:FindFirstChild("Orders")
	if not container then
		return
	end

	local live = {}
	for _, slotName in ipairs({ "Slot1Order", "Slot2Order" }) do
		local slotValue = container:FindFirstChild(slotName)
		local frame = slotValue and slotValue.Value
		if not (frame and frame.Parent and frame:FindFirstChild("Ingredients")) then
			continue
		end

		-- Key by frame instance: the game reuses order names after a failed order.
		live[frame] = true
		if orders[frame] then
			continue
		end

		local items = {}
		for _, child in ipairs(frame.Ingredients:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible and child.Name ~= "IngredientTemplate" then
				table.insert(items, { name = child.Name, state = "pending" })

				if child.Name == "Sludge" then
					sludgeSeen = true
				end

				-- Infer the course from ingredients in case we started mid-run and missed CourseStart.
				local floor = chapter.courseFloor[child.Name]
				if floor then
					currentCourse = math.max(currentCourse, floor)
				end
			end
		end

		orders[frame] = {
			frame = frame,
			id = frame.Name,
			number = tonumber(frame.Name) or math.huge,
			plate = nil,
			items = items,
			delivered = false,
		}

		local names = {}
		for _, item in ipairs(items) do
			table.insert(names, item.name)
		end
		log("Order " .. frame.Name .. ": " .. table.concat(names, ", ") .. " (course " .. currentCourse .. ")")
		lastProgressAt = os.clock()
	end

	for frame, order in pairs(orders) do
		if not live[frame] then
			-- An order can vanish without a verdict (Chapter 2's RedEye trip clears every order). Whatever was
			-- already on its plate would make that plate refuse the next order, so wipe it first.
			if not order.delivered and not order.failed and order.plate then
				for _, item in ipairs(order.items) do
					if item.state == "plated" then
						dirtyPlates[order.plate] = true
						log("Order " .. order.id .. " vanished with food on " .. order.plate .. "; clearing it.")
						break
					end
				end
			end
			orders[frame] = nil
		end
	end
end

---Whether a task still belongs to a live order (pre-cooked tasks have none until adopted).
---@param taskData table
---@return boolean
local function isTaskLive(taskData)
	return taskData.order ~= nil and orders[taskData.order.frame] == taskData.order and not taskData.order.failed
end

---Undelivered orders, oldest first.
---@return table
local function sortedOrders()
	local list = {}
	for _, order in pairs(orders) do
		if not order.delivered and not order.failed then
			table.insert(list, order)
		end
	end

	table.sort(list, function(a, b)
		return a.number < b.number
	end)
	return list
end

---Which plate an order is assembled on, or nil if it has to wait for one.
---@param order table
---@return string?
local function plateSideFor(order)
	-- Orders shift between GUI slots as earlier ones finish, so pin each order to a free plate once.
	if order.plate then
		return order.plate
	end

	local used = {}
	for _, other in pairs(orders) do
		if other.plate and not other.delivered and not other.failed then
			used[other.plate] = true
		end
	end

	if carriedOrder and carriedOrder.plate then
		used[carriedOrder.plate] = true
	end

	for _, side in ipairs(DUAL_PLATE and { "PlateLeft", "PlateRight" } or { "PlateLeft" }) do
		if not used[side] and not dirtyPlates[side] then
			order.plate = side
			return side
		end
	end
	return nil
end

---Whether every item of an order is on its plate.
---@param order table
---@return boolean
local function isOrderPlated(order)
	if #order.items == 0 then
		return false
	end

	for _, item in ipairs(order.items) do
		if item.state ~= "plated" then
			return false
		end
	end
	return true
end

---Hand machine output from an expired/failed order (or a pre-load) to the next order needing the same item.
---@param taskData table
local function adoptTask(taskData)
	for _, order in ipairs(sortedOrders()) do
		for _, item in ipairs(order.items) do
			if item.state == "pending" and item.name == taskData.itemName then
				item.state = "cooking"
				taskData.order = order
				taskData.item = item
				return
			end
		end
	end
end

---Whether a machine has finished processing.
---@param taskData table
---@return boolean
local function isTaskFinished(taskData)
	local elapsed = os.clock() - taskData.startedAt
	if taskData.machine == "Sludge" then
		if SLUDGE_FAST then
			return elapsed > SLUDGE_FAST_FROM and os.clock() >= (taskData.nextTry or 0)
		end

		local _, cupPrompt = getMachineParts("Sludge")
		return (cupPrompt ~= nil and cupPrompt.Enabled and elapsed > READY_SETTLE) or elapsed > SLUDGE_CAP
	end

	local ready = taskData.readyValue
	if ready and ready.Parent and ready.Value == true then
		taskData.readySeen = true
	end

	-- A memory machine is done once the server has switched CookedFood away from what it held before.
	local memory = taskData.memory
	if memory then
		local switched = memory.Value ~= taskData.memoryBefore or memory.Value == cookedNameOf(taskData.itemName)
		if switched and taskData.readySeen and elapsed > READY_SETTLE then
			if memory.Value ~= "" and learnedCooked[taskData.itemName] ~= memory.Value then
				learnedCooked[taskData.itemName] = memory.Value
				log("Learned: " .. taskData.itemName .. " cooks as " .. memory.Value .. " on " .. taskData.machine .. ".")
			end
			return true
		end

		if elapsed > (MACHINE_CAPS[taskData.machine] or 10) then
			-- Still showing what it held before: the load never took, and taking now would hand over the old item
			-- (which the plate then refuses). Load it again instead.
			if memory.Value == taskData.memoryBefore and memory.Value ~= cookedNameOf(taskData.itemName) and not taskData.held then
				logWarn(taskData.machine .. " never switched to " .. taskData.itemName .. " (load didn't take); reloading it.")
				if taskData.item then
					taskData.item.state = "pending"
				end
				activeTasks[taskData.key or taskData.machine] = nil
				return false
			end
			return true
		end
		return false
	end

	-- Measured live: rice 5.2s, nori 5.5s, cutting 7.2s. Caps only matter if isReady is missed.
	return (taskData.readySeen and elapsed > READY_SETTLE) or elapsed > (MACHINE_CAPS[taskData.machine] or 10)
end

---Where an item can be had without cooking: "machine" (its memory) or a stash index.
---@param itemName string
---@return any
local function backpackTools(toolName)
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	local tools = {}
	for _, tool in ipairs(backpack and backpack:GetChildren() or {}) do
		if tool:IsA("Tool") and tool.Name == toolName then
			table.insert(tools, tool)
		end
	end
	return tools
end

---Tool name of a machine's duplicable output, if the chapter dupes it.
---@param machine string
---@return string?
local function dupeToolFor(machine)
	return DUPE and chapter.dupe and chapter.dupe[machine] or nil
end

---Equip a spare copy from the Backpack and wait for the server to count it as held.
---@param toolName string
---@return boolean
local function equipFromBackpack(toolName)
	local tool = backpackTools(toolName)[1]
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (tool and humanoid) then
		return false
	end

	humanoid:EquipTool(tool)
	return waitUntil(function()
		return heldStatus() ~= "None" and heldStatus() ~= ""
	end, 1.5, 0.05)
end

---Put the held tool back into the Backpack.
---@return boolean
local function stowHeld()
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:UnequipTools()
	end
	return waitUntil(function()
		return not isHolding()
	end, 1.5, 0.05)
end

---Every Tool in the Backpack (the server stops handing anything out at 3).
---@return number
local function backpackCount()
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	local count = 0
	for _, tool in ipairs(backpack and backpack:GetChildren() or {}) do
		if tool:IsA("Tool") then
			count += 1
		end
	end
	return count
end

---Drop bag entries whose Tool left the Backpack.
local function pruneBag()
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	for index = #bag, 1, -1 do
		local entry = bag[index]
		if not (entry.tool and entry.tool.Parent == backpack) then
			table.remove(bag, index)
		end
	end
end

---Backpack slots free for stashing. One stays free once sludge is in play, for its dupe copies.
---@return number
local function bagRoom()
	local reserve = (dupeToolFor("Sludge") and currentCourse >= SLUDGE_COURSE) and 1 or 0
	return BACKPACK_LIMIT - backpackCount() - reserve
end

---Return "machine", a stash index or "backpack" when an item can be had without cooking.
---@param itemName string
---@return any
local function freeSource(itemName)
	local machine = machineFor(itemName)
	local memory = getMemory(machine)
	local cooked = cookedNameOf(itemName)
	local inMemory = memory ~= nil and memory.Value ~= "" and memory.Value == cooked

	-- Taking from a memory machine cancels whatever it's cutting, so while it's busy try the other caches first.
	local cooking = activeTasks[machine]
	local busy = cooking ~= nil and not cooking.held and cooking.itemName ~= itemName
	if inMemory and not busy then
		return "machine"
	end

	-- Stashed in the Backpack (survives the board wipe at course ends).
	pruneBag()
	for _, entry in ipairs(bag) do
		if entry.cooked == cooked and entry.machine == machine then
			return "bag"
		end
	end

	-- Duped items: Backpack copies are instant, the seed on a placeboard costs one double pickup.
	local toolName = dupeToolFor(machine)
	if toolName and #backpackTools(toolName) > 0 then
		return "backpack"
	end

	if STASH or toolName then
		local boards = getPlaceboards()
		for index, entry in pairs(stash) do
			if entry.cooked == cooked and entry.machine == machine then
				-- A board that shows empty was wiped (course end) or emptied some other way: forget the entry.
				local active = boards[index] and boards[index]:FindFirstChild("isActive")
				if active and not active.Value then
					stash[index] = nil
				else
					return index
				end
			end
		end
	end

	if inMemory then
		return "machine"
	end
	return nil
end

---Whether an item is already cached (machine memory, stash, or cooking right now).
---@param itemName string
---@return boolean
local function isCached(itemName)
	if freeSource(itemName) then
		return true
	end

	local taskData = activeTasks[machineFor(itemName)]
	return taskData ~= nil and taskData.itemName == itemName
end

---Take an item from a machine's memory or the stash, as a held task in the machine's Free slot.
---@param order table
---@param item table
---@param source any
---@return boolean
local function takeFree(order, item, source)
	if isHolding() then
		return false
	end

	local machine = machineFor(item.name)
	local got = false
	if source == "backpack" or (stash[source] and stash[source].dupeSeed) then
		got = grabDupe(machine)
	elseif source == "bag" then
		local cooked = cookedNameOf(item.name)
		for index, entry in ipairs(bag) do
			if entry.cooked == cooked and entry.machine == machine then
				table.remove(bag, index)
				local character = localPlayer.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if humanoid and entry.tool.Parent then
					humanoid:EquipTool(entry.tool)
					got = waitUntil(function()
						return heldStatus() ~= "None" and heldStatus() ~= ""
					end, 1.5, 0.05)
				end
				log((got and "Used bagged " or "Bagged item missing: ") .. item.name .. ".")
				break
			end
		end
	elseif source == "machine" then
		local _, finishPrompt = getMachineParts(machine)
		local cooking = activeTasks[machine]
		got = firePromptUntil(enablePrompt(finishPrompt), isHolding, 3)
		if got then
			log("Free " .. item.name .. " from the " .. machine .. " machine.")
			-- That take cancelled any cut in progress: requeue it now instead of waiting out its timer.
			if cooking and not cooking.held and cooking.itemName ~= item.name and activeTasks[machine] == cooking then
				log("That cancelled the " .. cooking.itemName .. " cut; requeueing it.")
				if cooking.item then
					cooking.item.state = "pending"
				end
				activeTasks[machine] = nil
			end
		end
	else
		local spot = getPlaceboards()[source]
		stash[source] = nil
		got = spot ~= nil and firePromptUntil(enablePrompt(spot.PickupPrompt), isHolding, 3, Tune.BOARD_PATIENCE)
		if got then
			log("Used stashed " .. item.name .. " from placeboard " .. tostring(source) .. ".")
		else
			log("Stashed " .. item.name .. " was gone from placeboard " .. tostring(source) .. " (wiped).")
		end
	end

	if not got then
		return false
	end

	item.state = "cooking"
	local key = machine .. "Free"
	activeTasks[key] = {
		key = key,
		machine = machine,
		itemName = item.name,
		order = order,
		item = item,
		startedAt = os.clock(),
		readySeen = true,
		held = true,
	}
	return true
end

---Rank an item for the current course (lower is more likely); unknown items rank last.
---@param itemName string?
---@return number
local function rankOf(itemName)
	-- Dupe seeds stay put: copies of them are worth more than any cached cut item.
	if itemName and dupeToolFor(machineFor(itemName)) then
		return 0
	end
	for position, poolName in ipairs(chapter.pools[currentCourse] or chapter.pools[4] or {}) do
		if poolName == itemName then
			return position
		end
	end
	return math.huge
end

---Item name for a machine's cooked name, so stash entries can be ranked.
---@param machine string
---@param cooked string
---@return string
local function itemForCooked(machine, cooked)
	for itemName, cookedName in pairs(learnedCooked) do
		if cookedName == cooked and machineFor(itemName) == machine then
			return itemName
		end
	end

	for itemName, cookedName in pairs(chapter.cookedNames) do
		if cookedName == cooked and machineFor(itemName) == machine then
			return itemName
		end
	end
	return cooked
end

---Before a memory machine switches away from its current item, keep a copy on a placeboard
---(evicting the least likely stashed item when both spots are full).
---@param machine string
---@param nextItemName string
local function stashCurrent(machine, nextItemName)
	if not STASH or isHolding() then
		return
	end

	local memory = getMemory(machine)
	local current = memory and memory.Value or ""
	if current == "" or current == cookedNameOf(nextItemName) then
		return
	end

	for _, entry in pairs(stash) do
		if entry.cooked == current and entry.machine == machine then
			return
		end
	end
	pruneBag()
	for _, entry in ipairs(bag) do
		if entry.cooked == current and entry.machine == machine then
			return
		end
	end

	-- Prefer the Backpack: the server clears both placeboards whenever a course ends but leaves the Backpack alone.
	if bagRoom() > 0 then
		local currentItemName = itemForCooked(machine, current)
		local _, finishPrompt = getMachineParts(machine)
		local backpack = localPlayer:FindFirstChildOfClass("Backpack")
		local before = {}
		for _, tool in ipairs(backpack and backpack:GetChildren() or {}) do
			before[tool] = true
		end
		if not (finishPrompt and firePromptUntil(enablePrompt(finishPrompt), isHolding, 3)) then
			return
		end
		waitUntil(function()
			local character = localPlayer.Character
			return character ~= nil and character:FindFirstChildWhichIsA("Tool") ~= nil
		end, 1, 0.05)
		if stowHeld() then
			for _, tool in ipairs(backpack and backpack:GetChildren() or {}) do
				if tool:IsA("Tool") and not before[tool] then
					table.insert(bag, { tool = tool, cooked = current, item = currentItemName, machine = machine, at = os.clock() })
					log("Bagged " .. currentItemName .. " (" .. #bag .. " in the Backpack).")
					return
				end
			end
		end
		logWarn("Couldn't bag " .. currentItemName .. "; binning it.")
		if isHolding() then
			trashHeld()
		end
		return
	end

	local placeboards = getPlaceboards()
	local currentItem = itemForCooked(machine, current)
	local target = nil
	for index = 1, #placeboards do
		if not stash[index] then
			target = index
			break
		end
	end

	if not target then
		local worst = nil
		for index, entry in pairs(stash) do
			local worse = not worst or rankOf(entry.item) > rankOf(stash[worst].item)
				or (rankOf(entry.item) == rankOf(stash[worst].item) and entry.at < stash[worst].at)
			if worse then
				worst = index
			end
		end

		-- Keep the current item instead if it's less likely than everything stashed.
		if not worst or rankOf(currentItem) > rankOf(stash[worst].item) then
			return
		end

		target = worst
		local evicted = stash[target].item
		stash[target] = nil
		if firePromptUntil(enablePrompt(placeboards[target].PickupPrompt), isHolding, 3, Tune.BOARD_PATIENCE) then
			trashHeld()
			log("Evicted stashed " .. tostring(evicted) .. " from placeboard " .. target .. ".")
		end
	end

	local _, finishPrompt = getMachineParts(machine)
	if not finishPrompt then
		return
	end

	if firePromptUntil(enablePrompt(finishPrompt), isHolding, 3) then
		if firePromptUntil(enablePrompt(placeboards[target].PlacePrompt), function()
			return not isHolding()
		end, 3, Tune.BOARD_PATIENCE) then
			stash[target] = { cooked = current, item = currentItem, machine = machine, at = os.clock() }
			log("Stashed " .. currentItem .. " on placeboard " .. target .. ".")
		else
			trashHeld()
		end
	end
end

local dupeRetryAt = 0

---Fire a placeboard's pickup prompt twice back to back; the second lands a copy in the Backpack.
---@param board BasePart
---@return boolean
local function doublePickup(board)
	local prompt = enablePrompt(board:FindFirstChild("PickupPrompt"))
	local cframe = prompt and promptCFrame(prompt)
	if not cframe then
		return false
	end

	teleportTo(cframe + Vector3.new(0, WORK_HEIGHT, 0))
	task.wait(Tune.DUPE_MOVE_SETTLE)
	-- The game re-disables board prompts after a place, so switch it on right before each fire.
	enablePrompt(prompt)
	pcall(fireproximityprompt, prompt)
	task.wait(Tune.DUPE_GAP)
	enablePrompt(prompt)
	pcall(fireproximityprompt, prompt)
	return waitUntil(isHolding, 1, 0.05)
end

---A placeboard can end up marked occupied with nothing on it (a doubled place). The server then refuses
---both pickup and place there, so drop it from the board list for the rest of the run.
---@param board BasePart
local function markBoardDead(board)
	if deadBoards[board] then
		return
	end
	deadBoards[board] = true
	-- Stash slots are list indexes, so they shift once a board leaves the list.
	table.clear(stash)
	logWarn("Placeboard " .. board:GetFullName():match("[^.]+$") .. " is stuck occupied with nothing on it; skipping it.")
end

---Whether a placeboard currently holds something.
---@param board BasePart
---@return boolean
local function boardFull(board)
	local active = board:FindFirstChild("isActive")
	return active ~= nil and active.Value
end

---Empty a placeboard into the trash. Returns false (and retires the board) if it claims to hold
---something that can't be picked up.
---@param board BasePart
---@return boolean
local function clearBoard(board)
	if not boardFull(board) then
		return true
	end
	if isHolding() then
		return false
	end

	if firePromptUntil(enablePrompt(board.PickupPrompt), isHolding, 3, Tune.BOARD_PATIENCE) then
		trashHeld()
		return not boardFull(board) or clearBoard(board)
	end

	markBoardDead(board)
	return false
end

---Pick a placeboard for duping: an empty one the stash isn't using, else evict the least likely stash entry.
---@return BasePart?
local function dupeBoard()
	local boards = getPlaceboards()
	for index, board in ipairs(boards) do
		if not stash[index] and not boardFull(board) then
			return board
		end
	end

	-- Something untracked on a board: bin it (or find out the board is dead).
	for index, board in ipairs(boards) do
		if not stash[index] and clearBoard(board) then
			return board
		end
	end

	boards = getPlaceboards()
	local worst, worstRank = nil, -1
	for index, entry in pairs(stash) do
		local rank = rankOf(entry.item)
		if boards[index] and rank > worstRank then
			worst, worstRank = index, rank
		end
	end
	if not worst then
		return nil
	end

	local board = boards[worst]
	local entry = stash[worst]
	stash[worst] = nil
	if not clearBoard(board) then
		return nil
	end
	log("Evicted stashed " .. tostring(entry.item) .. " from placeboard " .. worst .. " for duping.")
	return board
end

---Put the held item down on a placeboard; true only once it has actually left the hand.
---@param board BasePart
---@return boolean
local function placeOnBoard(board)
	local placed = firePromptUntil(enablePrompt(board.PlacePrompt), function()
		return not isHolding() and boardFull(board)
	end, 4, Tune.BOARD_PATIENCE)
	if not placed and isHolding() and boardFull(board) then
		-- Shows occupied but won't take the item: the board is dead.
		markBoardDead(board)
	end
	return placed
end

---Stash index of the dupe seed for a machine, if one sits on a placeboard.
---@param machine string
---@return number?
local function seedIndex(machine)
	for index, entry in pairs(stash) do
		if entry.dupeSeed and entry.machine == machine then
			return index
		end
	end
	return nil
end

---Put the held copy (or a Backpack one) down as the machine's seed. Leaves the hands empty.
---@param machine string
---@return number? index
local function plantSeed(machine)
	local toolName = dupeToolFor(machine)

	-- Hands must be free to clear a board; only stow when the Backpack has room for it.
	if isHolding() and backpackCount() < BACKPACK_LIMIT then
		stowHeld()
	end

	local board
	if isHolding() then
		for index, candidate in ipairs(getPlaceboards()) do
			if not stash[index] and not boardFull(candidate) then
				board = candidate
				break
			end
		end
	else
		board = dupeBoard()
	end
	if not board then
		return nil
	end

	if not isHolding() and not equipFromBackpack(toolName) then
		return nil
	end
	if not placeOnBoard(board) then
		if backpackCount() < BACKPACK_LIMIT then
			stowHeld()
		else
			trashHeld()
		end
		return nil
	end

	local index = table.find(getPlaceboards(), board)
	if index then
		stash[index] = { cooked = cookedNameOf(machine), item = machine, machine = machine, at = os.clock(), dupeSeed = true }
		log("Planted a " .. machine .. " seed on placeboard " .. index .. ".")
	end
	return index
end

---Double pickup on the seed: one copy lands in the Backpack, the seed goes back down.
---Returns whether a copy was made; the hands end empty unless the seed couldn't be put back.
---@param machine string
---@param index number
---@return boolean
local function dupeFromSeed(machine, index)
	local toolName = dupeToolFor(machine)
	local board = getPlaceboards()[index]
	if not board or not boardFull(board) then
		stash[index] = nil
		return false
	end

	local count = #backpackTools(toolName)
	task.wait(Tune.DUPE_PLACE_SETTLE)
	if not doublePickup(board) then
		stash[index] = nil
		return false
	end

	local copied = waitUntil(function()
		return #backpackTools(toolName) > count
	end, 1, 0.05)
	if not placeOnBoard(board) then
		stash[index] = nil
	end
	return copied
end

---Get one copy of a duped item into the hand: a Backpack copy, else a fresh copy off the seed.
---@param machine string
---@return boolean
grabDupe = function(machine)
	local toolName = dupeToolFor(machine)
	if not toolName or isHolding() then
		return false
	end

	if #backpackTools(toolName) > 0 then
		if equipFromBackpack(toolName) then
			log("Backpack " .. machine .. " (" .. #backpackTools(toolName) .. " left).")
			return true
		end
		return false
	end

	local index = seedIndex(machine)
	if not index then
		return false
	end

	local copied = dupeFromSeed(machine, index)
	if isHolding() then
		-- The seed couldn't go back down: use it directly.
		log("Used the " .. machine .. " seed itself.")
		return true
	end
	if copied and equipFromBackpack(toolName) then
		log("Duped " .. machine .. " off the seed on placeboard " .. index .. ".")
		return true
	end

	-- No copy this time: take the seed itself rather than leave the order waiting.
	local board = getPlaceboards()[index]
	if board and firePromptUntil(enablePrompt(board.PickupPrompt), isHolding, 3, Tune.BOARD_PATIENCE) then
		stash[index] = nil
		log("Took the " .. machine .. " seed itself (no copy).")
		return true
	end
	return false
end

---Keep a seed planted and the Backpack at its cap of copies.
---@param machine string
---@return boolean
local function refillDupes(machine)
	local toolName = dupeToolFor(machine)
	if not toolName then
		return false
	end

	local before = #backpackTools(toolName)
	local index = seedIndex(machine)
	if not index then
		index = plantSeed(machine)
		if not index then
			logWarn("Dupe: couldn't plant a " .. machine .. " seed.")
			dupeRetryAt = os.clock() + Tune.DUPE_FAIL_RETRY
			return false
		end
	end

	local misses = 0
	while seedIndex(machine) and #backpackTools(toolName) < Tune.DUPE_TARGET and backpackCount() < BACKPACK_LIMIT and misses < 2 do
		if not dupeFromSeed(machine, index) then
			misses += 1
		end
		if isHolding() then
			break
		end
	end

	-- A seed that couldn't go back down is still worth keeping.
	if isHolding() then
		if backpackCount() < BACKPACK_LIMIT then
			stowHeld()
		else
			trashHeld()
		end
	end

	local after = #backpackTools(toolName)
	if after <= before and misses > 0 then
		logWarn("Dupe round missed; trying again shortly.")
		dupeRetryAt = os.clock() + Tune.DUPE_FAIL_RETRY
	end
	log(string.format("Duped %s: Backpack %d -> %d, seed %s.", machine, before, after, seedIndex(machine) and "planted" or "missing"))
	return after > before or seedIndex(machine) ~= nil
end

---Whether the sludge machine is running or holding a cup that no task tracks.
---@return boolean
sludgeCupUntracked = function()
	if sludgeLeverAt and (not sludgeTakenAt or sludgeTakenAt < sludgeLeverAt) then
		return true
	end

	-- No lever seen this session (e.g. a reload mid-cook): a lit last stage means a full cup.
	local sludgeRoom = workspace:FindFirstChild("SludgeRoom")
	local machine = sludgeRoom and sludgeRoom:FindFirstChild("MachineRoom") and sludgeRoom.MachineRoom:FindFirstChild("Machine")
	local stage = machine and machine:FindFirstChild("Stage5")
	local light = stage and stage:FindFirstChild("StatusLight")
	return light ~= nil and light:IsA("BasePart") and light.BrickColor == BrickColor.new("Lime green")
end

---Grab an ingredient and load it into its machine (or run the chapter's special handler).
---@param order table?
---@param item table
---@return boolean
local function startItem(order, item)
	local machine = machineFor(item.name)

	-- Chapter-specific ingredients (spores, placeholders) have their own handlers.
	local special = chapter.special and chapter.special[machine]
	if special then
		return special(order, item)
	end

	local insertPrompt, finishPrompt, readyValue = getMachineParts(machine)

	-- Machines whose finish prompt hands out output even when empty.
	if chapter.freeFinish[machine] and order then
		if not firePromptUntil(enablePrompt(finishPrompt), isHolding, 4) then
			return false
		end

		item.state = "cooking"
		activeTasks[machine] = {
			machine = machine,
			itemName = item.name,
			order = order,
			item = item,
			startedAt = os.clock(),
			readySeen = true,
			held = true,
		}
		return true
	end

	-- Memory machines and the stash can hand some items over right now.
	if order then
		local source = freeSource(item.name)
		if source then
			return takeFree(order, item, source)
		end
	end

	if not insertPrompt then
		return false
	end

	local startedAt = os.clock()
	if machine == "Sludge" then
		-- The lever is the whole input step for sludge; it only works from course 4.
		if not insertPrompt.Enabled then
			-- A cup we lost track of (the server's echo came back late) keeps the lever down forever: adopt it.
			if activeTasks.Sludge or not sludgeCupUntracked() then
				return false
			end
			startedAt = sludgeLeverAt or (os.clock() - SLUDGE_FAST_FROM)
			logWarn(string.format("Adopted an untracked Sludge cup (%.1fs in).", os.clock() - startedAt))
		else
			local pulledAt = os.clock()
			local function leverWent()
				return not insertPrompt.Enabled or (sludgeLeverAt ~= nil and sludgeLeverAt >= pulledAt)
			end
			if not firePromptUntil(insertPrompt, leverWent, 3) then
				-- Under lag the echo can trail the pull by seconds; give it a moment before calling it a miss.
				local deadline = os.clock() + 4
				while not leverWent() and os.clock() < deadline do
					task.wait(0.1)
				end
				if not leverWent() then
					sludgeRetryAt = os.clock() + SLUDGE_LOCKED_RETRY
					return false
				end
			end
			if sludgeLeverAt and sludgeLeverAt >= pulledAt then
				startedAt = sludgeLeverAt
			end
		end
	else
		-- The server keeps a machine busy until its own timer ends.
		if isMachineBusy(machine) then
			return false
		end

		-- About to switch a memory machine to another item: keep its current one on a placeboard.
		if chapter.memory[machine] then
			stashCurrent(machine, item.name)
		end

		-- Untracked output sitting in the machine blocks loading; bin it first.
		if readyValue and readyValue.Value and not isHolding() then
			if firePromptUntil(enablePrompt(finishPrompt), isHolding, 3) then
				log("Cleared untracked " .. machine .. " output before loading.")
				trashHeld()
			end
		end

		local source = chapter.findSource(item.name)
		if not source then
			item.noSource = true
			if order and not item.sourceWarned then
				item.sourceWarned = true
				logWarn("No source found for " .. item.name .. " yet.")
			end
			return false
		end

		if not firePromptUntil(source, isHolding, 6) then
			return false
		end

		if not firePromptUntil(enablePrompt(insertPrompt), function()
			return not isHolding()
		end, 6) then
			-- ItemStatus can lag the insert; one last look before calling it a refusal.
			task.wait(0.3)
			if isHolding() then
				logWarn(machine .. " refused " .. item.name .. " (held " .. heldStatus() .. "), trashing it.")
				trashHeld()
				return false
			end
		end
	end

	item.state = "cooking"
	local memory = getMemory(machine)
	activeTasks[machine] = {
		machine = machine,
		itemName = item.name,
		order = order,
		item = item,
		readyValue = readyValue,
		memory = memory,
		memoryBefore = memory and memory.Value or nil,
		preload = order == nil,
		startedAt = startedAt,
		held = false,
	}
	return true
end

---Take whatever is on a plate and bin it, so a fresh order can be built there.
---@param side string
---@return boolean
local function plateHasFood(side)
	local plate = getPlate(side)
	for _, descendant in ipairs(plate and plate:GetDescendants() or {}) do
		if descendant:IsA("BasePart") and descendant.Transparency < 1 then
			return true
		end
	end
	return false
end

Tune.PLATE_CLEAR_TRIES = 3
local plateClearTries = {}

local function clearPlate(side)
	if isHolding() then
		trashHeld()
	end

	local plate = getPlate(side)
	local takePrompt = plate and plate:FindFirstChild("TakePrompt")
	if firePromptUntil(enablePrompt(takePrompt), isHolding, 4) then
		trashHeld()
		log("Cleared stale food from " .. side .. ".")
	end

	-- The take can miss (food still replicating); keep the plate dirty and retry a few times rather than
	-- hand it to the next order with food still on it.
	if plateHasFood(side) then
		plateClearTries[side] = (plateClearTries[side] or 0) + 1
		if plateClearTries[side] < Tune.PLATE_CLEAR_TRIES then
			return true
		end
		logWarn("Couldn't clear " .. side .. " after " .. Tune.PLATE_CLEAR_TRIES .. " tries; using it anyway.")
	end

	plateClearTries[side] = nil
	dirtyPlates[side] = nil
	return true
end

---Bring the station to a known state on start: bin leftovers, keep machine memory, adopt a ready sludge cup.
local function flushMachines()
	if isHolding() then
		trashHeld()
	end

	-- A non-memory machine's ready output is unknown; memory machines just keep dispensing their item.
	for _, machine in ipairs({ "Cut", "Rice" }) do
		local _, finishPrompt, readyValue = getMachineParts(machine)
		if not chapter.memory[machine] and not chapter.freeFinish[machine] and readyValue and readyValue.Value then
			if firePromptUntil(enablePrompt(finishPrompt), isHolding, 2) then
				log("Flushed leftover " .. machine .. " output.")
				trashHeld()
			end
		end
	end

	-- Placeboards may hold unknown items from a previous run; clear them so the stash starts empty.
	-- Ingredients already in the Backpack (e.g. after a reload) are stash entries we forgot; adopt them so the
	-- stray cleanup doesn't bin them.
	table.clear(bag)
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	for _, tool in ipairs(backpack and backpack:GetChildren() or {}) do
		if tool:IsA("Tool") then
			-- Most ingredients aren't listed in chapter.machines (they default to the cutter), so check the pools too.
			local candidates = {}
			for itemName in pairs(chapter.machines) do
				candidates[itemName] = true
			end
			for _, pool in pairs(chapter.pools) do
				for _, itemName in ipairs(pool) do
					candidates[itemName] = true
				end
			end
			for itemName in pairs(candidates) do
				local machine = machineFor(itemName)
				if chapter.memory[machine] and cookedNameOf(itemName) == tool.Name then
					table.insert(bag, { tool = tool, cooked = tool.Name, item = itemName, machine = machine, at = os.clock() })
					log("Adopted " .. itemName .. " already in the Backpack.")
					break
				end
			end
		end
	end

	-- Boards get destroyed and rebuilt when a course ends, so one may be mid-rebuild here: look things up
	-- defensively, and don't retire a board on this one failed pickup.
	for index, spot in ipairs(getPlaceboards()) do
		local pickup = spot.Parent and spot:FindFirstChild("PickupPrompt")
		if pickup and not isHolding() and firePromptUntil(enablePrompt(pickup), isHolding, 2, Tune.BOARD_PATIENCE) then
			log("Cleared leftover item from placeboard " .. index .. ".")
			trashHeld()
		end
	end
	table.clear(stash)

	-- A filled sludge cup locks the lever until collected, so adopt it as ready sludge.
	if chapter.machineParts and chapter.machineParts.Sludge then
		-- The cup prompt is force-enabled by us, so judge by the machine's ready light instead.
		if sludgeCupUntracked() then
			activeTasks.Sludge = {
				machine = "Sludge",
				itemName = "Sludge",
				item = { name = "", state = "cooking" },
				startedAt = os.clock() - SLUDGE_CAP,
				held = false,
			}
			log("Adopted ready Sludge from previous run.")
		end
	end

	-- A half-built plate from a previous run would block the order assigned to it.
	for _, side in ipairs({ "PlateLeft", "PlateRight" }) do
		local plate = getPlate(side)
		if not plate then
			continue
		end

		local hasFood = false
		for _, descendant in ipairs(plate:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant.Transparency < 1 then
				hasFood = true
				break
			end
		end

		if hasFood and firePromptUntil(enablePrompt(plate:FindFirstChild("TakePrompt")), isHolding, 4) then
			log("Flushed leftover food on " .. side .. ".")
			trashHeld()
		end
	end
end

---Pull finished output from its machine and plate it.
---@param taskData table
---@param side string
---@return boolean
local function plateTask(taskData, side)
	if not taskData.held then
		local _, finishPrompt = getMachineParts(taskData.machine)
		enablePrompt(finishPrompt)

		-- Fast sludge: the cup prompt is only gated client-side, so switch it on and try from ~17s.
		if SLUDGE_FAST and taskData.machine == "Sludge" and finishPrompt then
			local elapsed = os.clock() - taskData.startedAt
			if not firePromptUntil(finishPrompt, isHolding, 1) then
				if elapsed < SLUDGE_CAP then
					taskData.nextTry = os.clock() + SLUDGE_RETRY
					return false
				end
			else
				log(string.format("Sludge taken %.1fs after the lever.", elapsed))
			end
		end

		-- A fresh cup seeds the Backpack: dupe it, then plate one of the copies.
		if isHolding() and dupeToolFor(taskData.machine) and not seedIndex(taskData.machine) then
			-- The held Tool can trail ItemStatus by a moment; stowing needs the Tool itself.
			waitUntil(function()
				local character = localPlayer.Character
				return character ~= nil and character:FindFirstChildWhichIsA("Tool") ~= nil
			end, 1, 0.05)
			refillDupes(taskData.machine)
			if not isHolding() and not grabDupe(taskData.machine) then
				logWarn("Dupe: lost the seeded " .. taskData.machine .. ", re-queueing it.")
				taskData.item.state = "pending"
				activeTasks[taskData.key or taskData.machine] = nil
				return false
			end
			taskData.held = true
		end

		if not isHolding() and not firePromptUntil(finishPrompt, isHolding, 4) then
			-- Course transitions wipe the station, so output we were tracking can vanish. Re-cook it.
			taskData.collectFailures = (taskData.collectFailures or 0) + 1
			if taskData.collectFailures >= 3 then
				logWarn(taskData.machine .. " output for " .. taskData.itemName .. " is gone, re-queueing.")
				if taskData.item then
					taskData.item.state = "pending"
				end
				activeTasks[taskData.key or taskData.machine] = nil
			end
			return false
		end
		taskData.held = true
	end

	local plate = getPlate(side)
	local addPrompt = plate and plate:FindFirstChild("AddIngredientPrompt")
	if not firePromptUntil(enablePrompt(addPrompt), function()
		return not isHolding()
	end, 8) then
		-- The plate keeps refusing, usually stale food from a failed order: wipe it and rebuild this order.
		taskData.failures = (taskData.failures or 0) + 1
		if taskData.failures >= 2 then
			local states = {}
			for _, orderItem in ipairs(taskData.order and taskData.order.items or {}) do
				table.insert(states, orderItem.name .. "=" .. orderItem.state)
			end
			logWarn("Plate " .. side .. " refused " .. taskData.itemName .. " (held " .. heldStatus() .. ") for order "
				.. tostring(taskData.order and taskData.order.id) .. " [" .. table.concat(states, ",") .. "], clearing and rebuilding.")
			trashHeld()
			clearPlate(side)
			for _, item in ipairs(taskData.order and taskData.order.items or {}) do
				if item.state == "plated" then
					item.state = "pending"
				end
			end
			taskData.item.state = "pending"
			activeTasks[taskData.key or taskData.machine] = nil
		end
		return false
	end

	taskData.item.state = "plated"
	activeTasks[taskData.key or taskData.machine] = nil
	return true
end

---Ingredient signature of an order, so identical orders can be told apart from different ones.
---@param order table
---@return string
local function orderSignature(order)
	local names = {}
	for _, item in ipairs(order.items) do
		table.insert(names, item.name)
	end
	table.sort(names)
	return table.concat(names, ",")
end

---The server credits a plate to the oldest open order with the same ingredients. If an older identical order
---is still open, hand this plate (and its build progress) to that one so our tracking matches the server.
---@param order table
---@return table
local function claimOldestTwin(order)
	local signature = orderSignature(order)
	local oldest = order
	for _, other in pairs(orders) do
		if other ~= order and not other.delivered and not other.failed and other.number < oldest.number and orderSignature(other) == signature then
			oldest = other
		end
	end

	if oldest == order then
		return order
	end

	oldest.plate, order.plate = order.plate, oldest.plate
	oldest.items, order.items = order.items, oldest.items
	for _, taskData in pairs(activeTasks) do
		if taskData.order == order then
			taskData.order = oldest
		elseif taskData.order == oldest then
			taskData.order = order
		end
	end
	log("Delivering this plate as order " .. oldest.id .. " (identical to order " .. order.id .. ").")
	return oldest
end

---Pick up a finished plate and deliver it.
---@param order table
---@param side string
---@return boolean
local function deliverOrder(order, side)
	if carriedOrder ~= order then
		order = claimOldestTwin(order)
		side = order.plate or side
		local plate = getPlate(side)
		local takePrompt = plate and plate:FindFirstChild("TakePrompt")
		if not firePromptUntil(enablePrompt(takePrompt), isHolding, 8) then
			return false
		end
		carriedOrder = order
	end

	if not firePromptUntil(chapter.deliveryPrompt(), function()
		return not isHolding()
	end, 8) then
		return false
	end

	carriedOrder = nil
	order.delivered = true
	order.deliveredAt = os.clock()
	lastDeliveryAt = os.clock()
	ScarySushi.delivered += 1
	log("Delivered order " .. order.id .. " (" .. ScarySushi.delivered .. " total)")

	-- Counted on our own delivery (the server's verdict lands a second later, after the next pre-load started).
	courseDeliveries += 1
	if courseDeliveries >= Tune.ORDERS_PER_COURSE then
		courseDoneAt = os.clock()
	end
	return true
end

---Run one scheduling decision. Returns true if an action was taken.
---@return boolean
local function step()
	syncOrders()
	local list = sortedOrders()

	-- The server answers a good delivery with CompleteOrder within ~1s. If the order is still up after
	-- DELIVERY_VERIFY seconds the plate was rejected, so rebuild the whole order.
	for _, order in pairs(orders) do
		if order.delivered and order.deliveredAt and os.clock() - order.deliveredAt > DELIVERY_VERIFY then
			logWarn("Order " .. order.id .. " was not accepted by the server, rebuilding it.")
			courseDeliveries = math.max(0, courseDeliveries - 1)
			if courseDeliveries < Tune.ORDERS_PER_COURSE then
				courseDoneAt = nil
			end
			order.delivered = false
			order.deliveredAt = nil
			order.plate = nil
			for _, item in ipairs(order.items) do
				item.state = "pending"
			end
			ScarySushi.delivered -= 1
		end
	end

	-- Plates left dirty by a failed order get wiped while the hands are free.
	if not carriedOrder and not isHolding() then
		for side in pairs(dirtyPlates) do
			return clearPlate(side)
		end
	end

	-- A plate already in hand must be delivered first.
	if carriedOrder then
		return deliverOrder(carriedOrder, plateSideFor(carriedOrder) or "PlateLeft")
	end

	-- Re-home output whose order expired or failed, and claim pre-cooked output.
	for _, taskData in pairs(activeTasks) do
		if not isTaskLive(taskData) then
			adoptTask(taskData)
		end
	end

	-- Free the hand: an item already pulled from a machine gets plated next.
	for _, taskData in pairs(activeTasks) do
		local side = taskData.held and isTaskLive(taskData) and plateSideFor(taskData.order)
		if side then
			return plateTask(taskData, side)
		end
	end

	-- A held item whose order died and couldn't be re-homed is dead weight: drop the task.
	for key, taskData in pairs(activeTasks) do
		if taskData.held and not isTaskLive(taskData) then
			activeTasks[key] = nil
		end
	end

	-- Nothing we track is in hand, so anything held is a stray; bin it.
	if isHolding() then
		logWarn("Holding untracked " .. heldStatus() .. ", trashing it.")
		return trashHeld()
	end

	-- A full Backpack blocks every pickup, so bin strays (accidental double fires) and copies past the cap.
	if not isHolding() then
		local backpack = localPlayer:FindFirstChildOfClass("Backpack")
		local kept = {}
		for _, tool in ipairs(backpack and backpack:GetChildren() or {}) do
			if tool:IsA("Tool") then
				local isDupe = false
				for _, toolName in pairs(DUPE and chapter.dupe or {}) do
					isDupe = isDupe or tool.Name == toolName
				end
				for _, entry in ipairs(bag) do
					isDupe = isDupe or entry.tool == tool
				end
				kept[tool.Name] = (kept[tool.Name] or 0) + 1
				if not isDupe or kept[tool.Name] > BACKPACK_LIMIT then
					local character = localPlayer.Character
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						humanoid:EquipTool(tool)
						waitUntil(isHolding, 1, 0.05)
						logWarn("Binning stray " .. tool.Name .. " from the Backpack.")
						return trashHeld()
					end
				end
			end
		end
	end


	-- Ship any fully plated order.
	for _, order in ipairs(list) do
		local side = plateSideFor(order)
		if side and isOrderPlated(order) then
			return deliverOrder(order, side)
		end
	end

	-- Plate finished machine output.
	for _, taskData in pairs(activeTasks) do
		local side = isTaskLive(taskData) and plateSideFor(taskData.order)
		if side and isTaskFinished(taskData) and plateTask(taskData, side) then
			return true
		end
	end

	-- Pass 1: anything obtainable instantly (free-finish machines, machine memory, stash), before a load overwrites it.
	local pendingCook = {}
	for _, order in ipairs(list) do
		for _, item in ipairs(order.items) do
			if item.state ~= "pending" then
				continue
			end

			local machine = machineFor(item.name)
			local instant = (chapter.freeFinish[machine] and not activeTasks[machine])
				or (not activeTasks[machine .. "Free"] and freeSource(item.name) ~= nil)
			if chapter.memory[machine] then
				pendingCook[machine] = true
			end

			if instant and startItem(order, item) then
				return true
			end
		end
	end

	-- Pass 2: start real cooking on idle machines, oldest order first.
	for _, order in ipairs(list) do
		for _, item in ipairs(order.items) do
			local machine = machineFor(item.name)
			if item.state == "pending" and not chapter.freeFinish[machine] and not activeTasks[machine] and not freeSource(item.name) then
				if startItem(order, item) then
					return true
				end
			end
		end
	end

	-- Finished memory-machine output nobody needs (a pre-load, or a dead order's item) stays in the
	-- machine's memory anyway; free the slot so it doesn't block the machine.
	for key, taskData in pairs(activeTasks) do
		if not taskData.held and not isTaskLive(taskData) and taskData.memory and isTaskFinished(taskData) then
			if taskData.preload then
				log("Pre-loaded " .. taskData.itemName .. " is ready in the " .. taskData.machine .. " machine.")
			end
			activeTasks[key] = nil
		end
	end

	-- Idle: pre-load a likely item into a memory machine so the next order gets it free.
	local pool = chapter.pools[currentCourse] or chapter.pools[4]
	if PRELOAD and pool and not isHolding() and not carriedOrder then
		local stashCount = 0
		for _ in pairs(stash) do
			stashCount += 1
		end

		-- Only pre-load when the machine has time to finish before the next order: right after a delivery
		-- (orders come 8s later), in the window after a cutscene's station wipe, or before the first order.
		local sinceDelivery = os.clock() - lastDeliveryAt
		local sinceCutscene = os.clock() - cutsceneAt
		local inWindow = (sinceDelivery < Tune.PRELOAD_DELIVERY_WINDOW and #list == 0)
			or (sinceCutscene > Tune.PRELOAD_CUTSCENE_FROM and sinceCutscene < Tune.PRELOAD_CUTSCENE_UNTIL)
			or (ScarySushi.delivered == 0 and #list == 0)

		-- A course just finished: its change-over wipes any cut in progress, so hold off until the next one starts.
		if courseDoneAt and chapter.key ~= "Survival" then
			if cutsceneAt < courseDoneAt or os.clock() < cutsceneAt + Tune.COURSE_START_GRACE then
				inWindow = false
			else
				courseDoneAt = nil
			end
		end

		if inWindow then
			for _, candidate in ipairs(pool) do
				local machine = machineFor(candidate)
				local memory = getMemory(machine)
				if not memory or isCached(candidate) or pendingCook[machine] or activeTasks[machine] or isMachineBusy(machine) then
					continue
				end

				-- Only fill empty cache slots; evicting to pre-load just churns items that orders then miss.
				local hasRoom = stashCount < #getPlaceboards() or memory.Value == "" or bagRoom() > 0
				local candidateItem = { name = candidate, state = "pending" }
				if hasRoom and startItem(nil, candidateItem) then
					log("Pre-loading " .. candidate .. ".")
					return true
				end

				-- Not spawned yet (e.g. beetles before course 2): try the next candidate instead.
				if not candidateItem.noSource then
					break
				end
			end
		end
	end

	-- Chapter 1 sludge: keep a cup cooking whenever the lever is free; the ready cup waits for an order.
	-- Survival unlocks sludge at some difficulty, so it waits for the first sludge order before using the lever.
	local sludgeLive = not chapter.sludgeNeedsSeen or sludgeSeen

	-- Keep the Backpack stocked with duped copies while nothing else needs doing.
	if not isHolding() and os.clock() >= dupeRetryAt then
		for machine, toolName in pairs(DUPE and chapter.dupe or {}) do
			local count = #backpackTools(toolName)
			local seeded = seedIndex(machine) ~= nil
			if (count > 0 or seeded) and ((count < Tune.DUPE_LOW and backpackCount() < BACKPACK_LIMIT) or not seeded) then
				return refillDupes(machine)
			end
		end
	end

	local sludgeStocked = dupeToolFor("Sludge") ~= nil and (#backpackTools(dupeToolFor("Sludge")) > 0 or seedIndex("Sludge") ~= nil)
	if chapter.precookSludge and sludgeLive and not sludgeStocked and not isHolding() and currentCourse >= SLUDGE_COURSE and os.clock() >= sludgeRetryAt then
		if not activeTasks.Sludge then
			if startItem(nil, { name = "Sludge", state = "pending" }) then
				return true
			end
		end
	end

	return false
end

---Vote to skip any active cutscene.
local function trySkipCutscene()
	local skipGui = localPlayer.PlayerGui:FindFirstChild("SkipCutscene")
	local button = skipGui and skipGui:FindFirstChild("TextButton")
	if not (button and button.Visible and button.Active) then
		return
	end

	local vote = events and events:FindFirstChild("VoteSkipCutscene")
	if vote then
		pcall(vote.InvokeServer, vote)
	end
end

---Ask the server whether it has credited our escape. GetResults is what the results screen calls:
---returns (totalEscapes, escapedThisRound, orders, coins).
---@return boolean, number?
local function hasEscaped()
	local getResults = events and events:FindFirstChild("GetResults")
	if not getResults then
		return false, nil
	end

	local success, escapes, escaped = pcall(getResults.InvokeServer, getResults)
	return success and escaped == true, success and tonumber(escapes) or nil
end

---Leave for a fresh server of this chapter. Going via the lobby lets the old server shut down first.
local function requeue()
	if REQUEUE_VIA_LOBBY then
		teleportService:Teleport(PRO_LOBBY_PLACE_ID, localPlayer)
	else
		teleportService:Teleport(game.PlaceId, localPlayer)
	end
end

---Free the root if a cinematic anchored it, so our teleports still replicate.
local function freeRoot()
	local root = getRoot()
	if root and root.Anchored then
		root.Anchored = false
	end
end

---Poll the server's escape flag in the background; returns a getter for the credit time.
---@param chaseStart number
---@return function
local function watchEscape(chaseStart)
	local escapedAt = nil
	task.spawn(function()
		while not escapedAt and os.clock() - chaseStart < Tune.ENDING_CAP and not ScarySushi.detached do
			local escaped, escapes = hasEscaped()
			if escaped then
				escapedAt = os.clock()
				log(string.format("Server credited escape %.1fs after chase start (total escapes %s).", escapedAt - chaseStart, tostring(escapes)))
			end
			task.wait(0.5)
		end
	end)

	return function()
		return escapedAt
	end
end

---Wait for the escape credit, then requeue.
---@param chaseStart number
---@param escapedAt function
local function finishEnding(chaseStart, escapedAt)
	waitUntil(function()
		return escapedAt() ~= nil or ScarySushi.detached
	end, math.max(0, Tune.ENDING_CAP - (os.clock() - chaseStart)))

	if ScarySushi.detached then
		return
	end

	if not escapedAt() then
		logWarn("Escape never credited, requeueing anyway.")
	end

	task.wait(Tune.ESCAPE_GRACE)
	log(string.format("Win done in %.1fs from chase start, requeueing.", os.clock() - chaseStart))
	requeue()
end

---Chapter 1 escape: rush the portal (credited ~49s in), fall back to the elevator ride.
local function runEndingChapter1()
	local chaseStart = os.clock()
	log("Chase started.")

	local chase = workspace:WaitForChild("Chase")
	local elevatorTouch = chase:WaitForChild("ElevatorTouch")
	local elevator = workspace:WaitForChild("ElevatorRoom"):WaitForChild("Elevator")
	local insideTouch = elevator:WaitForChild("InElevatorTouch")
	local screen = elevator:WaitForChild("ElevatorScreenInside"):WaitForChild("SurfaceGui"):WaitForChild("Frame"):WaitForChild("TextLabel")
	local portalTouch = workspace:WaitForChild("SecondFloor"):WaitForChild("PortalRoom"):WaitForChild("PortalTouch")
	local escapedAt = watchEscape(chaseStart)

	-- The client elevator script kills us at countdown end unless ElevatorTouch was touched after activation.
	onEvent("ActivateElevator", function(countdown)
		log(string.format("Elevator activated %.1fs after chase start, %ss countdown.", os.clock() - chaseStart, tostring(countdown)))
		task.delay(0.5, function()
			local root = getRoot()
			if root then
				pcall(firetouchinterest, root, elevatorTouch, 0)
				task.wait()
				pcall(firetouchinterest, root, elevatorTouch, 1)
			end
		end)
	end)

	if PORTAL_RUSH then
		log("Rushing the portal.")
		waitUntil(function()
			if escapedAt() or ScarySushi.detached then
				return true
			end
			freeRoot()
			touchPart(portalTouch)
			return false
		end, Tune.RUSH_CAP, 0.5)
	end

	if ScarySushi.detached then
		return
	end

	if not escapedAt() then
		log(string.format("Not credited after %.1fs, riding the elevator.", os.clock() - chaseStart))
		freeRoot()
		waitUntil(function()
			if escapedAt() then
				return true
			end
			touchPart(elevatorTouch)
			touchPart(insideTouch)
			return screen.Text == "GOING UP" or screen.Text == "WELCOME"
		end, Tune.ELEVATOR_CAP, 0.5)

		waitUntil(function()
			return escapedAt() ~= nil or screen.Text == "WELCOME"
		end, Tune.PORTAL_CAP)

		setHover(false)
		waitUntil(function()
			if escapedAt() then
				return true
			end
			freeRoot()
			touchPart(portalTouch)
			return false
		end, Tune.PORTAL_CAP, 0.5)
	end

	finishEnding(chaseStart, escapedAt)
end

---Resolve a nested path under workspace.
---@param ... string
---@return Instance?
local function resolvePath(...)
	local node = workspace
	for _, name in ipairs({ ... }) do
		node = node and node:FindFirstChild(name)
	end
	return node
end

---Return a BasePart for a path target (a part, or the first part inside a model/folder).
---@param instance Instance?
---@return BasePart?
local function partOf(instance)
	if not instance then
		return nil
	end
	if instance:IsA("BasePart") then
		return instance
	end
	return instance:FindFirstChildWhichIsA("BasePart", true)
end

-- Chapter 2 escape route, in order, per the chase layout.
local CHAPTER2_ESCAPE_ROUTE = {
	{ "Kitchen", "AlterGeom", "TouchPart" },
	{ "Chase", "Ruins", "PortalExit", "TouchPart" },
	{ "Chase", "Forest", "Portals", "Portal_Exit", "TouchPart" },
	{ "Chase", "Ocean", "Portals", "Portal_Exit", "TouchPart" },
	{ "Chase", "Mines", "Portals", "Portal_Exit", "TouchPart" },
	{ "Chase", "Lighthouse", "Exit" },
}

---Chapter 2 escape: walk the chase portals in order and leave once the server credits the escape.
local function runEndingChapter2()
	local chaseStart = os.clock()
	log("Chase started.")
	local escapedAt = watchEscape(chaseStart)

	waitUntil(function()
		if escapedAt() or ScarySushi.detached then
			return true
		end

		freeRoot()
		for index, path in ipairs(CHAPTER2_ESCAPE_ROUTE) do
			local part = partOf(resolvePath(table.unpack(path)))
			if part then
				touchPart(part)
				task.wait(0.15)
			elseif not ScarySushi["routeWarned" .. index] then
				ScarySushi["routeWarned" .. index] = true
				log("Escape route step missing: " .. table.concat(path, "."))
			end
		end
		return escapedAt() ~= nil
	end, Tune.ENDING_CAP, 1)

	finishEnding(chaseStart, escapedAt)
end

---Start the chapter's ending once.
local function runEnding()
	if endingStarted then
		return
	end

	endingStarted = true
	ScarySushi.running = false
	chapter.runEnding()
end

---Chapter 2 spore: open the fungus, take the spore (goes straight onto the plate as CookedSpore).
---@param order table?
---@param item table
---@return boolean
local function startSporeChapter2(order, item)
	if not order or isHolding() then
		return false
	end

	local plant = resolvePath("Mines", "FungusRoom", "fungus_plant_anim")
	local rootPart = plant and plant:FindFirstChild("RootPart")
	local openPrompt = rootPart and rootPart:FindFirstChildWhichIsA("ProximityPrompt")
	local spore = plant and plant:FindFirstChild("Spore")
	local sporePrompt = spore and spore:FindFirstChildWhichIsA("ProximityPrompt")
	if not (openPrompt and sporePrompt) then
		if not item.sourceWarned then
			item.sourceWarned = true
			logWarn("Fungus plant prompts not found.")
		end
		return false
	end

	local startedAt = os.clock()
	if openPrompt.Enabled then
		firePromptUntil(openPrompt, function()
			return sporePrompt.Enabled or not openPrompt.Enabled
		end, 3)
	end

	if not firePromptUntil(enablePrompt(sporePrompt), isHolding, 6) then
		if not item.sporeWarned then
			item.sporeWarned = true
			logWarn("Spore pickup refused (open=" .. tostring(openPrompt.Enabled) .. ").")
		end
		return false
	end

	log(string.format("Spore taken in %.1fs (%s).", os.clock() - startedAt, heldStatus()))
	if heldStatus() == "None" then
		-- Diagnostics: which Tool is in hand / Backpack when the server hasn't caught up.
		task.delay(0.4, function()
			local names = {}
			local character = localPlayer.Character
			for _, child in ipairs(character and character:GetChildren() or {}) do
				if child:IsA("Tool") then
					table.insert(names, "hand:" .. child.Name)
				end
			end
			local backpack = localPlayer:FindFirstChildOfClass("Backpack")
			for _, child in ipairs(backpack and backpack:GetChildren() or {}) do
				table.insert(names, "bp:" .. child.Name)
			end
			log("Spore diag for order " .. tostring(order.id) .. " on " .. tostring(order.plate) .. ": status=" .. heldStatus() .. " [" .. table.concat(names, ",") .. "]")
		end)
	end
	item.state = "cooking"
	activeTasks.SporeFree = {
		key = "SporeFree",
		machine = "Spore",
		itemName = item.name,
		order = order,
		item = item,
		startedAt = os.clock(),
		readySeen = true,
		held = true,
	}
	return true
end

---Chapter 2 RedEye: a story step, not an ingredient. Verified live: touching the kitchen's Tunnels portal sends
---you into the Void (the order clears), and touching the Void's exit portal makes the server issue the real order.
---@param order table?
---@param item table
---@return boolean
local function startRedEyeChapter2(order, item)
	if not order or isHolding() or os.clock() < (item.redEyeRetryAt or 0) then
		return false
	end

	item.redEyeRetryAt = os.clock() + 8
	local room = localPlayer:FindFirstChild("currentRoom")
	local tunnels = resolvePath("Kitchen", "Portals", "Portal_TheTunnels", "TouchPart")
	local exitPortal = resolvePath("NightKeepers", "Void", "Part8", "ExitPortal", "TouchPart")
	if not (tunnels and exitPortal) then
		logWarn("RedEye portals not found.")
		return false
	end

	local startedAt = os.clock()
	freeRoot()
	waitUntil(function()
		touchPart(tunnels)
		return room ~= nil and room.Value == "Nightkeepers"
	end, 4, 0.3)

	waitUntil(function()
		touchPart(exitPortal)
		return room ~= nil and room.Value ~= "Nightkeepers"
	end, 4, 0.3)

	log(string.format("RedEye: went through the Void in %.1fs (room=%s).", os.clock() - startedAt, tostring(room and room.Value)))
	return false
end

---Chapter 1 ingredient sources.
---@param itemName string
---@return ProximityPrompt?
local function findSourceChapter1(itemName)
	local riceRoom = workspace:FindFirstChild("RiceRoom")
	local spawners = riceRoom and riceRoom:FindFirstChild("Spawners")
	if itemName == "RiceIngredient" then
		return findSpawnerPrompt(spawners, "RiceSpawner")
	end

	if itemName == "NoriIngredient" then
		return findSpawnerPrompt(spawners, "NoriSpawner")
	end

	local holders = { Eel = "EelPrompt", Flounder = "Prompt", Salmon = "Part", Tuna = "TunaPrompt" }
	if holders[itemName] then
		local pod = resolvePath("FishFarm", "FishPods", itemName .. "FishPod")
		local holder = pod and pod:FindFirstChild(holders[itemName])
		return holder and holder:FindFirstChildWhichIsA("ProximityPrompt")
	end

	-- Vegetables: scan once, then reuse the cached prompt.
	local cached = promptCache[itemName]
	if cached and cached.Parent then
		return cached
	end

	for _, folderName in ipairs({ "Garden", "ZenGarden" }) do
		local prompt = findPromptByKeywords(workspace:FindFirstChild(folderName), { itemName:lower() })
		if prompt then
			promptCache[itemName] = prompt
			return prompt
		end
	end
	return nil
end

