				BlueBeetle = "Cut",
				GreenBeetle = "Cut",
				PurpleBeetle = "Cut",
				YellowBeetle = "Cut",
				Sludge = "Spore",
				RedEye = "RedEye",
			},
			defaultMachine = "Cut",
			-- Verified live: nori is free from an empty machine; the rice pot and board remember their last item.
			freeFinish = { Nori = true },
			memory = { Cut = true, Rice = true },
			cookedNames = { RiceIngredient = "Rice" },
			courseFloor = {
				BlueBeetle = 2, GreenBeetle = 2, PurpleBeetle = 2, YellowBeetle = 2,
				Rockfish = 3, Clam = 3, Jellyfish = 3,
				Sludge = 4, RedEye = 4,
			},
			-- Ordered by how often each showed up in logged runs. Rice comes first everywhere (nearly every order
			-- needs it); seafood is left out because cooking it pushes rice out of the pot's memory.
			pools = {
				[0] = { "RiceIngredient" },
				[1] = { "RiceIngredient", "GreenBeetle" },
				[2] = { "RiceIngredient", "GreenBeetle", "PurpleBeetle", "YellowBeetle", "BlueBeetle" },
				[3] = { "RiceIngredient", "Rockfish", "PurpleBeetle", "GreenBeetle" },
				[4] = { "RiceIngredient", "PurpleBeetle", "GreenBeetle", "Rockfish" },
			},
			precookSludge = false,
			special = { Spore = startSporeChapter2, RedEye = startRedEyeChapter2 },
			findSource = findSourceChapter2,
