---Hold the character in place between teleports when not flying. Anchoring would drop network ownership.
---@param enabled boolean
local function setHover(enabled)
	local root = getRoot()
	if not root then
		return
	end

	local hover = root:FindFirstChild("PotentHover")
	if not enabled or Fly.flying then
		if hover then
			hover:Destroy()
		end
		return
	end

	if hover then
		return
	end

	hover = Instance.new("BodyVelocity")
	hover.Name = "PotentHover"
	hover.MaxForce = Vector3.one * 9e9
	hover.Velocity = Vector3.zero
	hover.Parent = root
end

---Resolve a world CFrame for whatever hosts a prompt.
---@param prompt ProximityPrompt
---@return CFrame?
local function promptCFrame(prompt)
	local node = prompt.Parent
	while node and node ~= workspace do
		if node:IsA("BasePart") then
			return node.CFrame
		end

		if node:IsA("Attachment") then
			return node.WorldCFrame
		end

		if node:IsA("Model") then
			local part = node:FindFirstChildWhichIsA("BasePart", true)
			return part and part.CFrame
		end

		node = node.Parent
	end
	return nil
end

