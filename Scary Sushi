---Build the per-chapter configuration for the current place.
---@return table?
local function buildChapter()
	if game.PlaceId == CHAPTER1_PLACE_ID then
		return buildChapter1()
	end

	-- Survival is Chapter 1's kitchen without courses or a chase: every ingredient is live from the start
	-- and orders never stop, so it runs the Chapter 1 config at the top course tier, forever.
	if game.PlaceId == SURVIVAL_PLACE_ID then
		local survival = buildChapter1()
		survival.key = "Survival"
		survival.tag = "Surv"
		survival.startCourse = SLUDGE_COURSE
		survival.runEnding = function()
			log("Survival has no chase ending.")
		end
		survival.chaseEvent = nil
		survival.noEscapeCheck = true
		survival.sludgeNeedsSeen = true
		return survival
	end

	if game.PlaceId == CHAPTER2_PLACE_ID then
		return {
			key = "Chapter2",
			tag = "Ch2",
			-- Verified via the game's PromptHandler: RawBeetle -> cutting board, Rice/RawSeafood -> rice pot.
			-- Verified live: the Rockfish's "Catch Fish" prompt hands over a RawBeetle, so it's cut too.
			machines = {
