				local plateInput = resolvePath("Kitchen", "Blob", "PlateInput")
				return plateInput and plateInput:FindFirstChildWhichIsA("ProximityPrompt")
			end,
			runEnding = runEndingChapter2,
			chaseEvent = nil,
			-- Courses whose cutscene must play out (none: beetles spawn on the same timer either way).
			keepCutscene = {},
