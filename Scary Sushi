---Print a tagged line and append it to a log file that survives teleports.
---@param message string
local function log(message)
	local tag = chapter and chapter.tag or "Sushi"
	print("[" .. tag .. "] " .. message)

	-- Potassium's appendfile errors on a missing file, so create it first.
	local line = os.date("%H:%M:%S ") .. tostring(game.JobId):sub(1, 8) .. " [" .. tag .. "] " .. message .. "\n"
	pcall(function()
		if isfile(LOG_FILE) then
			appendfile(LOG_FILE, line)
		else
			writefile(LOG_FILE, line)
		end
	end)
end

-- The log only ever grows; once per server, keep just the recent end of it.
pcall(function()
	if isfile(LOG_FILE) then
		local contents = readfile(LOG_FILE)
		if #contents > 512 * 1024 then
			local keep = contents:sub(-256 * 1024)
			local firstBreak = keep:find("\n", 1, true)
			writefile(LOG_FILE, firstBreak and keep:sub(firstBreak + 1) or keep)
		end
	end
end)

---Warn with the chapter tag and mirror it to the log file.
---@param message string
local function logWarn(message)
	local tag = chapter and chapter.tag or "Sushi"
	warn("[" .. tag .. "] " .. message)
	pcall(function()
		local line = os.date("%H:%M:%S ") .. tostring(game.JobId):sub(1, 8) .. " [" .. tag .. "] WARN " .. message .. "\n"
		if isfile(LOG_FILE) then
			appendfile(LOG_FILE, line)
		else
			writefile(LOG_FILE, line)
		end
	end)
end

---Load saved toggles, falling back to defaults for anything missing.
local function loadSettings()
	for key, value in pairs(DEFAULT_SETTINGS) do
		settings[key] = value
	end

	local success, decoded = pcall(function()
		return httpService:JSONDecode(readfile(SETTINGS_FILE))
	end)

	if success and type(decoded) == "table" then
		for key in pairs(DEFAULT_SETTINGS) do
			if type(decoded[key]) == "boolean" then
				settings[key] = decoded[key]
			end
		end
	end
end

---Persist the toggles so they survive teleports and re-executions.
local function saveSettings()
	pcall(function()
		writefile(SETTINGS_FILE, httpService:JSONEncode(settings))
	end)
end

